{
  "name": "code-circa-1980",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite --config config/vite.config.js --host 127.0.0.1",
    "build": "npm run typecheck && vite build --config config/vite.config.js",
    "preview": "vite --config config/vite.config.js preview --host 127.0.0.1",
    "test": "node --test tests/archive.test.mjs tests/castles-parity.test.mjs tests/castles-timing.test.mjs tests/castles-pointer.test.mjs tests/castles-bricks.test.mjs tests/castles-patterns.test.mjs tests/balancer-engine.test.mjs tests/alien-corrected.test.mjs tests/web-versions.test.mjs tests/plot3d-engine.test.mjs tests/chess-original.test.mjs tests/chess-rust.test.mjs tests/chess-corrected.test.mjs tests/bomb-original.test.mjs tests/life-original.test.mjs tests/life-corrected.test.mjs tests/poker-corrected.test.mjs tests/next-six.test.mjs",
    "release:web": "node scripts/release-web.mjs",
    "verify:web-versions": "node scripts/web-versions.mjs",
    "test:browser": "playwright test --config config/playwright.config.js",
    "build:fall": "node scripts/build-fall.mjs",
    "typecheck": "tsc --noEmit --project config/tsconfig.json",
    "calibrate:castles": "node scripts/calibrate-castles.mjs",
    "test:dev-route": "node scripts/check-dev-route.mjs",
    "build:balancer": "node scripts/build-balancer.mjs",
    "record:balancer": "node scripts/record-balancer-parity.mjs",
    "record:plot3d": "node scripts/record-plot3d-parity.mjs",
    "build:chess": "node scripts/build-chess.mjs",
    "record:chess": "node scripts/record-chess-parity.mjs",
    "build:chess-corrected": "node scripts/build-chess-corrected.mjs",
    "build:life-corrected": "node scripts/build-life-corrected.mjs",
    "build:life": "node scripts/build-life.mjs",
    "build:poker-corrected": "node scripts/build-poker-corrected.mjs",
    "build:learningttt-runtime": "node scripts/build-learningttt-runtime.mjs"
  },
  "dependencies": {
    "trs80-base": "2.3.1",
    "trs80-emulator": "2.3.1",
    "trs80-emulator-web": "2.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "z80-asm": "2.3.0"
  }
}
