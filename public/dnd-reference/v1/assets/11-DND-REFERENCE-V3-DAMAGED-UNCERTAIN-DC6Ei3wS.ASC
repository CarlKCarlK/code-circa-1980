10 CLEAR 300
15 LSET RESET
20 CLS:LINE INPUT"COMMAND (H FOR HELP): ";A$
21 IF LEFT$(A$,1)="["THEN3000ELSEIFA$="H"THEN4000ELSEIFA$="R"THEN A$="[[[[[["ELSEIF A$="M" THEN 5000
25 J=1:I=1
30 J=INSTR(J+1,A$," "):IF J<>0 THEN I=I+1:GOTO30
40 DIM W$(I)
50 L=1:A$=A$+" ":FOR J=1TOI
60 K=INSTR(K+1,A$," "):W$(J)=MID$(A$,L,K-L):L=K+1:NEXTJ
64 FOR J=1TOI
65 IF LEFT$(W$(J),1) <CHR$(96) THEN C9=C9+1:W$(C9)=W$(J)ELSEW$(J)=""
66 NEXT J:I=C9
67 IF RIGHT$(W$(I),1)= "?" OR RIGHT$(W$(I),1)="." THEN W$(I)= LEFT$( W$(I), LEN(W$(I))-1 )
70 READ B$:IFB$="DONE" THEN 200ELSEC1$=LEFT$(B$,1):IFC1$<>"@"AND C1$<>"["THEN90ELSEIFC1$="@"THENS$="":T$=RIGHT$(B$,LEN(B$)-1):B$=T$:T=0:B$=""ELSES$=RIGHT$(B$,LEN(B$)-1):B$="":S=0
90 IF W$(1)="[[[[[[" AND I=1AND RND(30)=1 AND B$<>""THEN 120
100 FOR J=1TOI
110 IFINSTR(B$,W$(J))+INSTR(S$,W$(J))+INSTR(T$,W$(J))=0THEN190ELSENEXTJ
120 IF T<>0THEN130ELSEM8=1
121 L5=62:L4=INSTR(55+M8,T$," "):IF L4<>0 THEN L5=L4-M8
122 PRINTMID$(T$,M8,L5):LG=LG+1:M8=M8+L5:IF M8<LEN(T$)THEN 121 ELSE T=1
130 IF S<>0 OR T$=S$ THEN 135 ELSE M8=1
131 L5=57:L4=INSTR(42+M8,S$," "):IF L4<>0 THEN L5=L4-M8
132 PRINTTAB(5)MID$(S$,M8,L5):LG=LG+1:M8=M8+L5:IFM8<LEN(S$)THEN131ELSES=1
135 IF T$=B$ OR S$=B$THEN140 ELSEM8=1
136 L5=52:L4=INSTR(44+M8,B$," "):IF L4<>0 AND L4<M8+51THEN L5=L4-M8
137 PRINTTAB(10)MID$(B$,M8,L5):LG=LG+1:M8=M8+L5:IF M8<LEN(B$)THEN136 
140 IF LG<12 THEN 190
150 PRINT
"(MORE PRESS ANYTHING)";
160 IFINKEY$=""THEN160ELSECLS:LG=0
190 GOTO 70
200 PRINT"
   *****     DONE     ****   PRESS ANY BUTTON    *****";
210 IF INKEY$=""THEN210ELSE10
1000 DATA@SELECTING CHARACTERS,[TOTAL THE ROLL OF 3 D-6 FOR EACH AREA,STRENGTH,INTELLIGENCE,WISDOM,CONSTITUTION,DEXTERITY,CHARISMA
1010 DATA@DECIDE CLASS,FIGHTINGMEN - STRENTH OF 9 -12 AVERAGE 13+ VERY GOOD,MAGIC USERS - INTELLIGENCE OF 13+,CLERICS - WISDOM 13+,THIEVES - DEXTERITY 13+
1020 DATA@DECIDE RACE,HALFINGS DEXTERITY 9+ OR CONSTITUTION 9+,DWARVES CONSTITUTION 9+
1030 DATA@YOU CAN AJUST YOUR ABILITY SCORES (BUT NEVER BELOW 9),MAGIC USERS & CLERICS -- ADD 1 TO (INTELLIGENCE / WISDOM )FOR EVERY 3 REMOVED FROM STRENGTH,FIGHTINGMEN & CLERICS & HALFLINGS & DWARVES -- ADD 1 FOR EVERY 2 REMOVED FROM INTELLIGENCE
1040 DATA FIGHTINGMEN & HALFLINGS & DWARVES --- ADD 1 POINT FOR EVERY 3   REMOVED FROM WISDOM,MAGIC USERS -- ADD 1 FOR EVERY 2 REMOVED FROM WISDOM,THIEVES -- ADD 1 TO DEXTRITY FOR EACH SET OF 1 REMOVED FROM WISDOM AND 2 REMOVER FROM INTELLIGENCE
1050 DATA@MORE ON RACE,FIGHTINGMEN - HUMAN & HALFLINGS & DWARVES,MAGIC USER - HUMAN & ELVES,CLERICS - HUMAN,THIEVES - HALFLINGS & DAWARVES & ELVES
1060 DATA@ MORE ON CLASSES,[FIGHTINGMEN , CAN USE ANY WEAPON AND ARMOR , NO MAGIC EXCEPT  FOR MAGIC WEAPONS AND ARMOR, EXPERICANCE INCREASES THEIR HIT DIE
1070 DATA [MAGIC USERS , CAN USE NO ARMOR OR WEAPON EXCEPT A DAGGER, CAN USE NO MAGIC WEAPONS AND ARMOR, AT FIRST CAN CAST ONLY ONE SPELL,[THIEVES , CAN USE ALL WEAPONS , WEAR UP TO LEATHER ARMOR
1080 DATA"[CLERICS "," MAY WEAR ANY ARMOR AND NON-EDGED WEAPON (NO SWORDS, DAGGER, ETC.)."," THEY ARE FORBIDDEN TO DRAW BLOOD.","THEY START WITH NO SPELLS"
1090 DATA@MORE ON RACES (DESCRIPTIONS),[DWARVES -, 4 FEET TALL,STACKY,WEIGH 150 LBS, SPEAK DWARVES & COMMON & GNOME & KOBOLD & GOBLIN,[ELVES,5+ FEET TALL, SLIM,120 LBS,CAN USE WEAPONS AND SHIELDS OF FIGHTINGMEN AND CAST MAGIC AS A MAGIC USER
2000 DATACAN SEE 60 FEET IN DARK,NOT PARALYZED BY THE TOUCH OF GHOULS, SPEAKS ORC & HOBGOBLIN & GNOLL & ELVISH & COMMON, EXPERICENCE IS SPLIT BETWEEN MAGIC AND FIGHTINGMEN
2010 DATA[HALFLINGS ,3 FEET TALL,CAN HIDE OUT SIDE,FIRE MISSILES AT +1,CAN USE ALL ARMORR AND WEAPONS
2020 DATA@MORE ON SELECTIONS,PLAYERS DECIDE  CLASS & SEX & NAME AND RECORD ON SEPERATE PIECE OF PAPER WITH ABLITIES SCORES AND  ALIGMENT (GOOD-EVIL & LAWFUL-CHOIC)
2030 DATA@HIT POINTS -,[ EVERYONE ROLLS AS MANY TIME AS ARE EQUAL TO THEIR EXPERIANCE LEVEL TAKING THE HIGHEST ROLL.,[ CONSTITUTION CAN ADD OR SUBTRACT (NOT BELOW ONE),[ CHARACTERS,FIGHTERS 1-8,CLERICS 1-6,MAGIC USER 1-4,THIEVES 1-4,ELVES 1-6,HALFLINGS 1-6
2040 DATA@BUYING,STARTING GOLD IS THE TOTAL OF 3 6-SIDED DIE ROLLS *10,SEE PAGE 7 OR 47 FOR CATALOGE
2050 DATA@HOPELESS CHARACTERS CAN BE SENT HOME (NEW ONE ROLLED),@POSSESSIONS CAN BE WILLED WITH A 10% INHEITANCE TAX
2060 DATA@NON-PLAYER CHARACTERS,ONLY FIRST LEVEL CHARACTER CAN GENERALLY BE HIRED,COST OF ADVERTING IS (1-6) * 100 GP,[COST OF HIRING,HUMAN - 100 GP MIN,DWARVES - 150 GP MIN,MAGIC USERS & ELVES - MAGICAL ITEMS,CLERICS - A PLACE TO WORSHIP
2070 DATA MONSTERS - SAME ALIGNMENT OR CHARMED OR CHARISMA  + SOME REWARD
2080 DATA@LANGUAGES, 20% MONSTER KNOW COMMON TOUNGE,EACH ALIGNMENT CAN COMMUNICATE,ONE MORE LANGUAGE CAN BE LEARNED FOR EVERY INTELLIGENCE OVER 10 (BEFORE GAME)
2090 DATA@TIME,EACH  TURN IS 10 MINUTS,EACH MEELEE ROUND IS 10 SECONDS,10 MEELEE ROUNDS EQUALS 1 TURN
2100 DATA@TRAVEL  - MOVING IS TWICE AS FAST AS MAPPING/EXPLORING (GIVEN),UNARMORED & UNENCOMBERED MAN - 240,FULLY ARMORED OR HEAVY LOAD - 120,FULLY ARMORED & HEAVY LOAD - 60,RUNNING UNARMORED  IS 720,RUNNING ARMORED IS 360
2110 DATA@RESTING 1 TURN IN 6 FOR RESTING  & 2 IF GROUP HAS BEEN RUNNING
2120 DATA@ENCUMBRANCE (WEIGHT & CARRY),BACKPACKS HOLD 300 GP WEIGHT (30 LB),300 GP WEIGHT =LIGHT,600 GP WEIGHT =HEAVY
2130 DATA@LIGHT ,[(SIGHT & SEEING & VISION),ELVES & DWARVES CAN SEE 60 FT IN DARK,MONSTERS CAN SEE 60 FT IN DARK,HUMANS & HALFLINGS CAN SEE 30 FT IN LIGHT
2140 DATA[EFFECTS,ELVES & DWARVES CAN'T SEE 60 FT IF A LIGHT IS WITHIN 30 FT,HUMANS & HALFLINGS TRAVEL AT HALF SPEED IN DARK,MONSTERS CAN SEE ARTIFICAL LIGHT 90 FEET AHEAD
2150 DATA[ARTIFICAL LIGHT,MAGIC SWORDS & STAVES LAST FOREVER,TORCHES LAST 6 TURNS,FLASK OF OIL LAST 24 TURNS
2160 DATA @TRAP DOORS OPEN 1/3 OF THE TIME ROLL D-6 FOR DAMAGE
2170 DATA@LISTENING AT DOORS (ONLY ONE LISTEN!)  -- ,1 OR 2 FOR ELVES &DWARVES &HALFLINGS,     1 FOR HUMANS (ON D-6)  
2180 DATA@SECRET DOORS,ELVES (IN PASSING) 1OR2 ON D-6,ELVES (SEARCHING)1-4 ON D-6,HUMANS & HALFLINGS & DWARVES 1 OR 2 IF SEARCHING
2190 DATA@DOORS -, OPENED USALLY SHUT AUTOMANTICLY UNLESS SPIKED,DOORS OPEN FOR MONSTERS UNLESS HELD OR SPIKED
2200 DATA@SURPRISE THROW D-6 ON ENCOUNTER, ONE (1)MEANS MONSTER WAS SURPRISED,[TWO (2) MEANS PARTY WAS SURPRISED , 1/6 CHANCE HOLDINGS ARE DROPED
2210 DATA@WANDERING MONSTER TURN ROLL D-6 ,IF 6 THEN MONSTER ,IF SOMEONE ON GUARD THEN THEY WILL DEDECT MONSTER AT 120 FT,IF NO  ONE ON QUARD THEN TO KNOW DISTANCE 2(D-6)*10 FEET
2220 DATA LOOK  PAGE 10.  ROLL D-12 TO FIND MONSTER. TO FIND NUMBER ROLL UNTIL A CHOICE APPEARS THEN * SKILL LEVEL,[TO FIND THE FRIENDLY/HOSTLE ATTITUDE OF MONSTER  ADD 2(D-6),2 ATTACKS IMMEDIATELY,3 4 5 HOSTLE,6 7 8 UNCERTAIN,9 10 11 FRIENDLY
2230 DATA 12 ENTHUSASTIC AND HELPFUL
2240 DATA@FLEEING,UNINTELLIGENT MONSTER STOPS TO PICK UP FOOD 50%,INTELLIGENT MONSTER STOPS FOR TREASURE 50%
2250 DATA@EXPERIENCE POINTS,1 POINT * VALUE TREASURE (GP) + MONSTER'S POINT (SEE PAGE 11)   (MONSTER'S POINT=MONSTER'S LEVEL/CHARACTER's LEVEL),EXPERIENCE IS USALLY DIVIDED EVENLY
2260 DATA@LEVELS OF EXPERIENCE (SEE PAGE 11),NO MORE THAN ONE LEVEL PER GAME.,HIT POINT INCREASE
2270 DATA@THIEVES ABILITIES LEVEL 1 ,[ROLL D-20 FOR FIRST PLACE AND D-20 FOR UNITS PLACE,OPEN LOCK 15%,REMOVE TRAP 10%,PICKPOCKET 20%,MOVE SILETLY 20%,CLIMB SHEER WALL 87%,HIDE IN SHADOW 10%,HEAR NOISE 33% 
2280 DATA @MAGIC USER CLERIC SEE CARDS 19& 20
2290 DATA@COMBAT MEELEE,[CHARACTOR VS. MONSTER,NORMAL MAN 11 (20-AC),1ST-3RD LEVEL 10 (19-AC),[MONSTER VS. CHARACTER (9 TO 2)  SEE BACK OF BOOK,[ARMOR CLASS  ( ADD ONE IF SHEILD),NO ARMOR -9,LEATHER-7,CHAIN MAIL-5,PLATE MAIL-3
2300 DATA@POISED WEAPONS  MAKE SAVING THROWING AND TAKE HIT DIE,@FIRE (OIL LAMP) -, ON THROWN TO THE FLOOR OIL WILL BE 5 FT CIRCLULAR , 2D8 DAMAGE TO ANYTHING IN THE FLAMES ,LAST FOR ONE TURN OR 10 MEELEE ROUNDS
2310 DATA @DIFFERENT SPELLING,FIGHTINGMEN NOT FIGHTER FIGHTINGMAN FIGHTING MEN,MAGIC USER  NOT MAGIC-USER MAGICUSER
2999 DATA"DONE"
3000 J=VAL( RIGHT$(A$,LEN(A$)-1)):H=VAL( RIGHT$(A$, LEN(A$)-INSTR(A$,"S")))
3010 T=0:FORI=1TOJ:T=T+RND(H):NEXTI
3020 PRINT@64*6,T
3030 PRINT:PRINT
3040 IFINKEY$=""THEN3040 ELSE RUN
4000 CLS
