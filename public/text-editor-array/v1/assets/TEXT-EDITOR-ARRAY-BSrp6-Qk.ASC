10 CLEAR 1000
20 DIM W$(1000)
30 CLS:PRINTCHR$(14);"     ";
100 A$=INKEY$:IFA$=""THEN100
150 IF (A$>=CHR$(47) AND A$<=CHR$(57) ) OR( A$>="A" AND A$<="Z") THEN W$(CW)=W$(CW)+A$:PRINTA$;ELSE200
160 GOTO 100
200 IFA$>="!" AND A$<="Z" THEN CW=CW+1:W$(CW)=W$(CW)+A$ :PRINTA$;ELSE 300
210 GOTO 100
300 IF A$=CHR$(13) THEN CW=CW+1:W$(CW)=CHR$(13):PRINT"

     ";ELSE 400
310 GOTO 100
400 IFA$=" "THENCW=CW+1:PRINT" ";ELSE500
410 GOTO 100
500 IFA$<>CHR$(8)THEN700ELSE IF LEN( W$(CW))=0 AND CW<>0 THEN CW=CW-1
502 IF(W$(CW)=CHR$(13) )  OR (  LEN(W$(0))=0 AND CW=0 )THEN 100
505 W$(CW)=LEFT$(   W$(CW) , LEN ( W$(CW)) -1 )
507 IF POS(0)=0 THEN PRINTCHR$(27);CHR$(24);" ";CHR$(27);CHR$(24);:GOTO530
510 PRINTCHR$(24);" ";CHR$(24);
530 GOTO100
700 CLS:PRINTCHR$(14);"<<EDIT MODE>>"
710 A$=INKEY$:IFA$=""THEN710ELSEIFA$=CHR$(27)THEN PRINT"<<END EDITING>>":GOTO100
