10 INPUT"HOW MANY CHARGES DO YOU HAVE";N
30 FORI=1TON
32 PRINT"TYPE IN THE X AND Y  POSITIONS OF CHARGE ";I;:INPUT A(I),B(I)
33 B(I)=B(I)*10:A(I)=A(I)*10
34 NEXTI
35 FORI=1TON:A(I)=A(I)*SQR(3)/2:NEXTI
40 PRINT"TYPE IN THE SIZE OF EACH CHARGE/ USE 3 FOR A CHARGE OF 3Q"
50 FORI=1TON:PRINT"CHARGE ";I;:INPUTC(I):NEXTI
60 GOTO130
70 V=0
80 FORI=1TON
85 R=SQR((X-A(I))[2+(Y-B(I))[2)
90 IFR=0THEN100
95 V=V+C(I)/R:GOTO105
100 V=99999:GOTO110
105 NEXTI
110 RETURN
120 STOP
130 FORJ=1TO121STEP2
135 X=J*SQR(3)/2
140 FORY=1TO78
150 GOSUB70
151 LET Z=V
155 Z=(Z+1)*50
156 IFZ<32THENZ=32
158 IFZ>126THENZ=126
160 B$=CHR$(Z)
165 IFZ>INT(Z)+.5THENB$=" "
170 PRINTB$;
250 NEXTY
260 PRINT:NEXTJ
9999 END
