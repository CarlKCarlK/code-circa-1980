10 ' CISAB A COMPUTER CHESS GAME IN BASIC
11 '   BY    CARL MYERS KADIE
12 DEFINTC,R,H
14 PM=120:QQ=1:VA=.5
15 DIM RN(PM),CN(PM),CO(PM),RO(PM),D(PM),R%(PM),V(6)
20 CLS:PRINTCHR$(23)
25 PRINT@398," C I S A B ";
30 FOR R=1TO2:FORC=1TO8:READ B(R,C):NEXTC,R
35 TI=.5
40 RESTORE
50 FOR R=8TO7STEP-1:FORC=1TO8:READ B(R,C):B(R,C)=-B(R,C):NEXTC,R
55 DATA5,4,3,2,1,3,4,5,6,6,6,6,6,6,6,6
56 FOR P=1TO6:READ P$(P):NEXTP:C$(1)=CHR$(143):C$(3)=" ":P$(0)=" -"
57 DATA K,Q,B,N,R,P
58 FOR AA=1TO10:READ A$(AA):NEXTAA:FORV=0TO6:READV(V):NEXTV
59 DATA FOOLISH,DESPERATE,IRREDEEMABLE,LUDICROUS,SERIOCOMIC,DROLL,RIDICULOUS,WHIMSICAL,PREPOSTEROUS,ABSURD
60 CLS
65 DATA .5,100,9,3,3,5,1
70 INPUT"WHAT COLOR ARE WE";A$:CLS:IFLEFT$(A$,1)="W" THEN GOSUB10000:GOTO200
71 C$(3)=C$(1):C$(1)=" ":H=B(8,4):B(8,4)=B(8,5):B(8,5)=H:H=B(1,4):B(1,4)=B(1,5):B(1,5)=H
73 GOSUB10000
80 BA=100:KD=0:C3$="":PRINTCHR$(31);"WHAT WAS THEIR "A$(RND(10))" MOVE (ROW,COLUMB,NEW ROW,COULMB)";:INPUTRO,CO,RN,CN:GOTO90
82 GOTO 200
90 IF B(RO,CO)<=0 THEN FORAA=1TO40:PRINTCHR$(31);"  **** CHEAT ***** ":NEXTAA:CLS:GOSUB10000:GOTO 80
100 IF B(RN,CN)=-1 THEN PRINT"DAMN THEY BEAT YOU!":END
105 C1=CN:C=CO:R1=RO:R2=RN :GOSUB20000
106 IF B(RN,CN)<>0 THEN PRINTCHR$(31);"OH DAMN!"
107 PRINTCHR$(31);:A$="":INPUT"OK?";A$:IFA$="ADD"THEN 110ELSEIFA$<>"OK"THENGOSUB10000:GOTO80
110 B(RN,CN)=B(RO,CO):B(RO,CO)=0:RN=0:CN=0:RO=0:CO=0:IFABS(B(RN,CN))=6AND RN=8THENB(RN,CN)=SGN(B(RN,CN))*2:RN=0:GOSUB10000
120 IF A$="ADD"THEN8000
200 PRINTCHR$(31);"NOW IT IS OUR TURN                   "
210 GOSUB 2000
279 PM=0
280 FOR R=1TO8:FORC=1TO8
290 IF B(R,C)>=0 THEN 1000
300 IF B(R,C)<>-6 THEN 400:' PAWN JUMP
305 IF SW=1THEN4000
310 IF B(R-1,C-1)>0 AND C-1>=1THEN CN=C-1:RN=R-1:GOSUB3000:IFRN=1THEN QQ=9:GOSUB3000
