10 CLS
20 FOR X=0TO127:SET(X,47):NEXTX:'THE GROUND
40 FOR I=1 TO 10 :PRINT@RND(800),".";:NEXTI
50 G(1)=20+RND(15):G(2)=127-(RND(15)+20):RESET( G(1),47):RESET(G(2),47)
55 GOSUB 500
60 A=.01:PI=3.14159
70 FOR T=1 TO 2
71 A$=INKEY$:IF A$<"0"THEN 80 ELSE IF A$<":"THEN VS=VAL(A$)/10ELSE IF A$<="Z"THEN AS=(ASC(A$)-ASC("A"))/26
80 V=RND(0)/10+(VS+.5):AN=(RND(0)/26+AS)*PI/2:VX=V*COS(AN):VY=V*SIN(AN):IFT=2THENVX=-VX
90 X=SGN(VX)
100 Y=VY*X/VX-.5*A*X*X/VX/VX
110 NX=G(T)+X:NY=46-Y:IF  NX>=0 AND NY>=0 AND NX<=127 AND NY<=46 THEN IF POINT(NX,NY)THEN 180ELSERESET(OX,OY):SET(NX,NY):OX=NX:OY=NY ELSE 200
120 X=X+SGN(VX):GOTO 100
180 RESET(OX,OY):CC=0:FOR X1=NX-1TONX+1:FOR Y1=NY-3TONY+1:IF POINT(X1,Y1)THEN RESET(X1,Y1):CC=CC+1:NEXT Y1,X1 ELSE NEXT Y1,X1
190 FOR Y1=NY+1TONY-3STEP-1:FORX1=NX-1TONX+1:IF CC>1 THEN SET(X1,Y1):CC=CC-1:NEXTX1,Y1 ELSENEXTX1,Y1
195 GOSUB 750
200 '
210 NEXT T:GOTO 70
500 X=64:Y=46
510 A$=INKEY$:A=PEEK(14352):IFA$=""AND A=0THEN520ELSEIFA$=" "THEN RETURNELSEIFA$=CHR$(13)THEN IF POINT(X-1,Y+1)OR POINT(X,Y+1)OR POINT(X+1,Y+1)THENSET(X,Y)ELSEELSEIFA=2THENY=Y-1ELSEIFA=4THENY=Y+1ELSEIFA=8THENX=X-1ELSEIFA=16THENX=X+1
520 IF X>0 AND Y>0 AND X<127 AND Y<47 THEN IF POINT(X,Y) THEN RESET(X,Y):SET(X,Y)ELSESET(X,Y):RESET(X,Y)ELSE 500
530 GOTO 510
750 XL=NX-1:XR=NX+1:Y1=NY+1:YT=NY-3
760 X1=XL:NL=120:NR=0
770 IF POINT(X1,Y1) THEN 800 ELSE IF(X1<>XL AND X1<>XR) OR (ABS( NX-X1)<1.5) THEN 850 ELSE IF X1=XL THEN XL=XL+1 ELSE IF X1=XR THEN XR=XR-1
780 GOTO 850
800 IF POINT(X1-1,Y1+1) OR POINT(X1,Y1+1) OR POINT(X1+1,Y1+1) THEN 850ELSE GOSUB 1000:IFX1-1<NL THEN NL=X1-1
810 IF X1+1>NR THEN NR=X1+1
850 IF X1<XR THEN X1=X1+1:GOTO770
860 IF Y1<YT AND NR<NL THEN RETURN ELSE IF Y1<YT THEN YT=YT-1:IFYT<0 THEN YT=0:GOTO900ELSE900 ELSE IF NR<NX+1 THEN NR=NX+11
870 IF NL>NX-1 THEN NL=NX-1
900 XR=NR:XL=NL:Y1 =Y1-1:GOTO 760
1000 OX=G(1):OX=47:X2=X1:Y2=Y1+1
1010 IF NOT(POINT(X2,Y2)) THEN RESET(X2,Y2-1):SET(X2,Y2):Y2=Y2+1:IFY2>47 THEN RETURN ELSE 1010 
1020 IF POINT(X2-1,Y2) AND POINT(X2+1,Y2) THEN RETURN
1030 RESET(X2,Y2-1):IF POINT(X2-1,Y2) THEN X2=X2+1 ELSE X2=X2-1
1040 GOTO 1010
