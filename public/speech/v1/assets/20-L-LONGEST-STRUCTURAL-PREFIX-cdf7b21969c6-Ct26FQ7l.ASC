10 REM life backwards april 27, 1985
90 DEFINT A-Z
100 DX=20:DY=20
110 DIM T6(4,4)
280 PRINT"Setting up"
290 DIM CN(380,1)
300 FOR I = 0 TO 511:IZ=I:TZ=0:			FOR J=0 TO 8:				  CZ(J)=IZ MOD 2:TZ=TZ+CZ(J):		  IZ= IZ/2:				  NEXT J
310 MZ= -((CZ(4)=1 AND (TZ=3 OR TZ=4)) OR(CZ(4)=0 AND TZ=3)):CN(TZ(MZ),MZ)=I:TZ(MZ)=TZ(MZ)+1:NEXTI
320 FOR MZ=0TO1:CN(TZ(MZ),MZ)=-1:NEXTMZ
330 CLS
500 'main program
510 GOSUB 1000:'"egin
520 GOSUB 2000:'reset
530 GOSUB 3000:'first_post
550 GOSUB 5000:IF C5=-1 THEN			OD(PS(0),PS(1))= +1:			GOSUB 4000:				IF PS(0)<0 THEN PRINT"trapped":STOP   :ELSE GOTO 540
570 GOSUB 6000:IF NOT(C6) THEN 540
580 GOSUB 7000:'pos=next pos
590 IF PS(0) <0  THEN 540
600 GOSUB 9000:'new=next_con(old)
610 GOTO 530
1000 'begin - read in life board
1005 GOSUB 1105
1010 READ P1(0),P1(1):				IF P1(0)<0 THEN RETURN
1020 NW(P1(0),P1(1)) =1
1100 'set-up new fields
1110 FOR I1=0TO1:FD(0,I1)=0:FD(1,I1)=0:	NEXTI1:RETURN
1130 GOSUB 1200:GOTO 1010
1200 'ajust field
