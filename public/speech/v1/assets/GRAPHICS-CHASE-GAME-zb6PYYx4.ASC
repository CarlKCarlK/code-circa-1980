10 CLS
20 Y=RND(42)+1:X=RND(118)+2:BX=RND(118)+2:BY=RND(42)+1:OX=X:OY=Y:PX=BX:PY=BY
30 CY=RND(3)-1:CX=RND(3)-1
40 DIM H%(10),C%(10),I%(10),D%(10)
50 PRINT CHR$(172)+CHR$(187)+CHR$(144):PRINT CHR$(130)+" "+CHR$(129)
60 GET@(0,0)-(4,3),G,H%
70 CLS:PRINTCHR$(142)+CHR$(156)+CHR$(172)
80 GET @(0,0)-(5,2),G,C%
90 CLS:PRINTCHR$(160)+CHR$(183)+CHR$(156):PRINTCHR$(130)+" ";CHR$(129)
100 GET@(1,0)-(5,3),G,I%
110 CLS:PRINT CHR$(156)+CHR$(172)+CHR$(141)
120 GET@(0,0)-(5,2),G,D%
130 CLS:LINE(0,0)-(127,47),SET,B:LINE(1,0)-(126,47),SET,B
140 A$=INKEY$:IFA$=" "THEN GOSUB1000ELSEIF A$<>""THENRESTORE: FOR C=1TO9:READM$, XX,YY:IF M$=A$ THEN XX=XX*2:GOTO150  ELSE NEXT
150 DATA Q,-1,-1, W,0,-1, E, 1,-1, A,-1,0, S,0,0, D,1,0, Z,-1,1, X,0,1, C,1,1
160 T=T+1
170 IF XX+X>=2 AND X+XX<=120 AND YY+Y>=1 AND Y+YY<=43 THEN X=X+XX:Y=Y+YY
180 D=SQR((X-BX+1)[2+(Y-BY+1)[2)
200 IF RND(D/2)=1 THEN CX=SGN(BX-X)*3:CY=SGN(BY-Y)
210 IF BX+CX>2 AND BX+CX<=120 AND CY+BY>=1 AND CY+BY<=43 THEN BY=BY+CY:BX=BX+CXELSE CX=RND(7)-4:CY=RND(3)-2:GOTO 210  
220 LINE(OX,OY)-(OX+4,OY+3),RESET,BF
230 IF XX<0 THEN PUT@(X,Y)-(X+4,Y+3),SET,H% ELSE PUT@(X,Y)-(X+4,Y+3),SET,I%
240 LINE(PX,PY)-(PX+5,PY+2),RESET,BF
250 IF CX>0 THEN PUT@ (BX,BY)-(BX+5,BY+2),SET,D%ELSEPUT@(BX,BY)-(BX+5,BY+2),SET,C%
260 OX=X:OY=Y:PX=BX:PY=BY
270 GOTO 140  
280 PRINT@400,"YOU GOT HIM !!!!!!";
290 PRINT@464,"IN "T"SECONDS";
300 FORC=1TO2000:NEXT:RUN
310 FORX=121TO191:PRINTX;CHR$(X),,,:NEXTX:GOTO 310  
1000 IF CX>0 THEN TR=BX+5
1010 LINE(X+3,Y)-((X+3)+5*XX,5*YY+Y),SET
1020 IF SQR(  ((X+3)+5*XX-TR)[2 + (5*YY+Y-BY)[2) <=2 THEN 280 
1030 FORC=1TO100:NEXT:LINE(X+3,Y)-((X+3)+5*XX,5*YY+Y),RESET
1040 RETURN
