10 CLEAR 10
20 PL=20499
30 CLS:PRINT@27,"TEXT EDITOR":PRINT:PRINTCHR$(14);"     ";
100 A$=INKEY$:IFA$=""THEN100
150 IF (A$>=CHR$(47) AND A$<=CHR$(57) ) OR( A$>="A" AND A$<="Z") THEN PL=PL+1:POKE PL,ASC(A$):PRINTA$; ELSE 200
160 GOTO 100
200 IFA$>="!" AND A$<="Z" THEN PL=PL+1:POKE PL,ASC(A$):PL=PL+1:POKE PL,32:PRINTA$;ELSE 300
210 GOTO 100
300 IF A$=CHR$(13) THEN PL=PL+1:POKE PL,13:PRINT"

     ";ELSE 400
310 GOTO 100
400 IFA$=" "THENPL=PL+1:POKEPL,32:PRINT" ";ELSE500
410 GOTO 100
500 IFA$<>CHR$(8)THEN700
502 IFPEEK(PL)=13  OR (  PL=20499 AND CW=0 )THEN 100
505 PL=PL-1
507 IF POS(0)=0 THEN PRINTCHR$(27);CHR$(24);" ";CHR$(27);CHR$(24);:GOTO530
510 PRINTCHR$(24);" ";CHR$(24);
530 GOTO100
700 CLS:PRINTCHR$(14);"<<EDIT MODE>>"
710 A$=INKEY$:IFA$=""THEN710ELSEIFA$=CHR$(27)THEN PRINT"<<END EDITING>>":GOTO100
10000 CLS:FOR J=20500TOPL:PRINTCHR$( PEEK(J));:NEXTJ
