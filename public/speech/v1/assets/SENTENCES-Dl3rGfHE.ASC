5 CLEAR 1000
10 FOR X=1TO10:READ NP$(X):NP$(X)=NP$(X)+" ":NEXTX
20 FOR X=1TO10:READ NR$(X):NR$(X)=NR$(X)+" ":NEXTX
30 FOR X=1TO3:READ AR$(X):AR$(X)=AR$(X)+" ":NEXTX
40 FOR X=1TO6:READ AD$(X):AD$(X)=AD$(X)+" ":AD$(X)="":NEXTX
50 FORX=1TO10:READ AJ$(X):AJ$(X)=AJ$(X)+" ":AJ$(X)="":NEXTX
60 FORX=1TO10:READ V$(X):V$(X)=V$(X)+" ":NEXTX
70 FOR X=1TO6:READ PP$(X):PP$(X)=PP$(X)+" ":NEXTX
80  FOR X=1TO5:READ IT$(X):NEXT X
100 CLS:PRINT"   ";
200 ST$=""
202  IF RND(3)=1 THEN GOSUB 6000:ST$=ST$+", ":GOTO202
210 GOSUB 1000:NT=0:GOSUB2000:IFRND(3)=1THEN ST$=ST$+"AND ":GOSUB2000
220 GOSUB 4000:IF RND(3)=1THEN ST$=ST$+"AND ":GOSUB 4000
230 'GOSUB 1000
235 NT=1
240 GOSUB 2000:IF RND(3)=1 THEN ST$=ST$+"AND ":GOSUB2000
250 GOSUB 1000
270 GOSUB 400:PRINT"  ";:IF RND(3)=1 THEN PRINT:PRINT:PRINT"   ";
280 GOTO 200
400 FOR I=1TOLEN(ST$)-1:PRINTMID$(ST$,I,1);:FORK=1TO15:NEXTK,I:PRINT".";:RETURN
1000 REM PREP. PHASE
1005 PP=7
1010 IF RND (PP)=1 THEN ST$=ST$+PP$(RND(7)) ELSE RETURN
1015  NT=1
1020 GOSUB 2000 :'NOUNS
1030 RETURN
2000 REM NOUNS
2010 R=RND(2):IF NT=0 AND R=1 AND RND(2)=2 THEN R=2
2020 IF R=1 THEN RR=RND(3):ST$=ST$+ AR$(RR)
2030 GOSUB 3000:'ADJECTIVE
2040 IF R=2THEN ST$=ST$+NP$(RND(10))ELSE ST$=ST$+NR$(RND(10))
2050 RETURN
3000 REM ADJ.
3010 IF RND(3)=1 THEN ST$=ST$+AJ$(RND(10)) ELSE RETURN
3020 GOTO 3010
4000 REM  VERB
4010 IF RND(4)=1 THEN ST$=ST$+AD$(RND(10)) ELSE 4030
4020 GOTO 4010
4030 ST$=ST$+V$(RND(10))
4040 RETURN
5000 IF RND(4)=1THEN ST$=ST$+AD$(RND(10))
5010 RETURN
6000 ST$=ST$+IT$(RND(4))+" "
6010 NT=0:GOSUB 2000:IF RND(3)=1 THEN ST$=ST$+"AND ":GOSUB2000
6020 GOSUB 4000:NT=1:GOSUB 2000:IF RND(3)=1 THEN ST$=ST$+"AND ":GOSUB 2000
6030 GOSUB 1000
6040 RETURN
10000 DATA CARL,MARK,JIM,CATHY,LIZ,RICH,RACHEL,BILL,DOUG,DALE
10010 DATA PICKNET,SANDWICH,FRESBIE,QUAD,GRASS,CAMERA,UNION,BIKE PATH,SIDEWALK,ORANGE
10020 DATA THE,THE,THE
10030 DATA SKILLFULLY,QUICKLY,VIOLENTLY,CLUMALY,SLOWLY,EASILY
10040 DATA HARD,FUN,MOIST,LIGHT,WET,DIRTY,BIG,SLEEPY,GOOD-LOOKING,BRIGHT-EYED
10050 DATA HIT,PLAYED WITH,RAN TO,ATE,CAUGHT,PUSHED,TALKED TO,JOKED ABOUT,WISPERED TO,SAT WITH
10055 DATA WITH,TO,UNDER,NEAR,BESIDE,FROM
10060 DATA WHILE,NEXT,BECAUSE,AS,SINCE
