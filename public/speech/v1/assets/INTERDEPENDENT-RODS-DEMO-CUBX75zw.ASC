5 CLS
10 FOR R=1TO10
20 R(R)=RND(40)
30 NEXT R
35 FORR=1TO10:O(R)=R:NEXTR:FORR=1TO10:RN=RND(10):H=O(R):O(R)=O(RN):O(RN)=H:NEXTR
40 GOSUB1000
50 FOR R=1TO10
60 W(R)=RND(10):H(R)=RND(0):IF RND(2)=1THEN H(R)=1/H(R)
70 NEXT R
75 FORQ=1TO10:R=O(Q):IF R<>S THEN LETR(R)=H(R)*R(W(R))
76 NEXTQ
80 GOSUB1000
85 PRINT@14*64,"";
90 INPUT"WHICH ROD DO YOU WHAT CHANGED AND TO WHAT";R,R(R)
95 R(R)=40-R(R)
97 S=R
100 FOR I=1TO40:IFI>=R(R) THEN SET(R*12,I)ELSE RESET(R*12,I)
110 NEXTI
120 GOTO 75
1000 FORX=1TO10:FORR=1TO40:IFR>=R(X)THEN SET(X*12,R)ELSE RESET(X*12,R)
1010 NEXT R,X:RETURN
