5 DIM C$(6,3),V$(4,3)
10 FOR S=1TO6:FOR N=1TO 3:READ C$(S,N):NEXTN,S
20 FOR V=1TO4:FORE=1TO3:READ V$(V,E):NEXTE,V
30 PRINT"VAL. ACIDS =1, VAL. METALS=2":INPUTA:ON A GOTO2000,3000
1000 DATA HYDROGEN OXIDE,WATER,H2O,  HYDROGEN CHLORIDE,HYDROCLORIC ACID,H.CL,  HYRDOGEN SULFATE,SULFURIC ACID,H2(S.O4),        HYDROGEN ACETATE,ACETIC ACID, H(C2H3O2),  HYDROGEN NITRATE, NITRIC ACID,H(N.O3),HYDROGEN PHOSPHATE
1010 DATA PHOSPHORIC ACID,H3(P.O4)
1020 ' OTHER STUFF
1030 DATA NA.BR, K.CL, AG(N.O3)
1040 DATA CA.F2,CU(N.O3)2, BA(S.O4)
1050 DATA AL.CL3, BI(N.O3)3,FE(P.O4)
1060 DATA TI.CL4,C.H4,SI.F4
2000 CLS:PRINT"NAME TO FORUMLA"
2010 S=RND(6):N=RND(2)
2020 PRINT"WHAT IS THE FORUMLA FOR "C$(S,N);
2030 INPUT A$
2040 IF A$=C$(S,3) THEN PRINT"RIGHT!!!!"ELSEPRINT"NOPE. "C$(S,3)"."
2050 PRINT:GOTO 2010
3000 CLS:PRINT"METALS"
3010 PRINT"NAME A COMPOUND WITH ";
3020 A$=V$(2,RND(3)):FOR I=1TOLEN(A$):M$=MID$(A$,I,1):IF M$<>"."ANDM$<>"("AND VAL(M$)=0THENNEXT:GOTO3020
3030 PRINTLEFT$(A$,I-1);:INPUT B$
3040 IF A$=B$THEN PRINT"RIGHT !!!!!"ELSE PRINT"NOPE. "A$"."
3050 GOTO 3010
