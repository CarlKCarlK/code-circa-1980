2 CLS
3 W=127:L=47
4 MB=10
5 DEFINT C:DIM C(1,MB)
10 T=RND(MB/3):B=RND(MB/3):MP=RND(MB/3):IFINT(MB/9*2)<>0THENLL=RND(MB/9*2):R=RND(MB/9*2)
15 FORAA=0TOW:SET(AA,0):SET(AA,L):NEXTAA:FORAA=0TOL:SET(0,AA):SET(W,AA):NEXTAA
20 E=T+B+LL+R+MP
22 IF E>MB THEN GOSUB 6000:GOTO 20
25 FOR AA=1TO4:FORBB=0TO1:READ H(BB,AA):NEXTBB,AA
26 DATA 1,0,-1,0,0,1,0,-1
30 FOR TC=1TOT:C(0,TC)=RND(W-1):C(1,TC)=1:NEXT TC
35 FQ=6
40 FOR BC=1TOB:C(0,T+BC)=RND(W-1):C(1,BC+T)=L-1:NEXT BC
50 FOR LC=1TOLL:C(0,B+T+LC)=1:C(1,B+T+LC)=RND(L-1):NEXTLC
55 FOR YU=1TOMP:C(0,B+T+LL+YU)=RND(W-1):C(1,B+T+LL+YU)=RND(L-1):NEXTYU
60 FOR RC=1TOR:C(0,B+T+LL+RC+MP)=W-1:C(1,B+T+LL+RC+MP)=RND(L-1):NEXTRC
62 FOR CL=1TOE:R1=CL:R2=RND(E):XX=C(0,R1):C(0,R1)=C(0,R2):C(0,R2)=XX:XX=C(1,R1):C(1,R1)=C(1,R2):C(1,R2)=XX:NEXTCL
65 FOR CL=1TOE:SET( C(0,CL), C(1,CL)):NEXTCL
70 CL=0
71 CL=CL+1:IF CL>E THEN 70
75 FOR UL=1TO INT(SQR(W[2+L[2)/7)+1
80 GOSUB 1000
100 FOR PE=1TOD(0,0):CV=0
110 FOR PD=1TO4:IF (POINT( D(0,PE)+H(0,PD), D(1,PE)+H(1,PD) ) )THEN CV=CV+1
120 NEXT PD
125 GOSUB 5000
130 IF CV=1 THEN 131ELSENEXT PE:GOSUB 3000:GOTO 160
131 '
140 C(0,CL)=D(0,PE):C(1,CL)=D(1,PE)
150 IF RND( FQ)<>1THEN 151ELSEIF E<MBTHEN E=E+1:C(0,E)=D(0,PE):C(1,E)=D(1,PE)ELSE R1=RND(E):C(0,R1)=D(0,PE):C(1,R1)=D(1,PE)
151 '
155 SET( C(0,CL),C(1,CL) )
159 NEXTUL
160 GOSUB2000:GOTO 71
1000 D(0,0)=0:IF RND(4)=1 THENGOSUB2000
1010 FOR PD=1TO4:IF NOT(POINT( C(0,CL)+H(0,PD), C(1,CL)+H(1,PD)) )THEN D(0,0)=D(0,0)+1:D(0,D(0,0))=C(0,CL)+H(0,PD):D(1,D(0,0))=C(1,CL)+H(1,PD)
1020 NEXT
1030 RETURN
2000 R1=RND(4):R2=RND(4):XH=H(0,R1):YH=H(1,R1):H(0,R1)=H(0,R2):H(1,R1)=H(1,R2):H(0,R2)=XH:H(1,R2)=YH:RETURN
3000 C(0,CL)=C(0,E):C(1,CL)=C(1,E):C(0,E)=0:C(1,E)=0:E=E-1:IF E=0 THEN 4000ELSE RETURN
4000 LPRINT"DONE"
4010 X=RND(W):Y=RND(W):IF POINT(X,Y) THEN 4010
4020 A$=INKEY$:IFA$=""THEN4030ELSEIFA$=" "THEN4010ELSEIFA$="3"THEN XC=-1:YC=0ELSEIFA$="4"THENXC=1:YC=0ELSEIFA$="1"THEN XC=0:YC=-1ELSEIFA$="2"THENXC=0:YC=1
4030 IF POINT(X+XC,Y+YC)THENXC=0:YC=0ELSERESET(X,Y):SET(X+XC,Y+YC):X=X+XC:Y=Y+YC
4040 GOTO 4020
5000 ' FINDING
5020 XG=D(0,PE)-C(0,CL):YG=D(1,PE)-C(1,CL)
5025 XG=SGN(XG):YG=SGN(YG)
5030 XM=XG+D(0,PE):YM=YG+D(1,PE)
5040 X1=XM+YG:Y1=YM+XG:X2=XM-YG:Y2=YM-XG
5050 IF POINT(X1,Y1) OR POINT(X2,Y2) THEN CV=2
5060 RETURN
6000 IF T>1THEN T=T-1
6005 IF MP>1THEN MP=MP-1
6010 IF LL>1THEN LL=LL-1
6020 IF B>1THENB=B-1
6030 IF R>1THEN R=R-1
6040 RETURN
