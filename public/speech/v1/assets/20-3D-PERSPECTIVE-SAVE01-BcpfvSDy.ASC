50 POKE16553,255
70 CLS
90 READ D:FORDD=1TOD
100 READX1,Y1,Z1,X2,Y2,Z2:Y1=-(Y1):Y2=-(Y2)
110 SY=(Y1-Y2)/100:SX=(X1-X2)/100:SZ=(Z1-Z2)/100
120 FORC=1TO100STEP4
130 Y=SY*C+Y2
140 X=SX*C+X2
150 Z=SZ*C+Z2
200 XG=X/Z
210 YG=Y/Z
300 XG=XG*12+64
310 YG=YG*6+24
500 IFXG<0ORYG<0ORXG>127ORYG>47THEN600
550 SET(XG,YG)
600 NEXT:NEXT
610 PRINT@0,"DONE";
620 GOTO620
9999 DATA9
10000 DATA2,-2,3,6,-2,3,6,-2,3,6,-4,4,6,-4,4,2,-4,4,2,-4,4
