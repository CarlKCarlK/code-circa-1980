5 CLEAR 200
10 CLS
20 PRINT"ORDER OF OPERATIONS"
30 PRINT
40 PRINT"DO  * AND / FIRST    FROM LEFT TO RIGHT
50 PRINT"THEN   TO   + AND -  FROM LEFT TO RIGHT
60 PRINT
70 PRINT
80 PRINT"THE COMPUTER DOES THE SAME THING."
90 PRINT
100 PRINT" LIST"
110 PRINT" 10  LET  Y =  3 + 4 * 5
120 PRINT" 20  PRINT Y
130 PRINT" 30 END
140 PRINT
150 INPUT"WHAT ANSWER WILL THE COMPUTER PRINT ?";A
155 CLS:PRINT"YOU SAID THAT  3 + 4 * 5 ="A
160 IF A=23 THEN PRINT" YES !!!!!!!!!"
170 IF A <> 23 THEN PRINT"  NO. "
180 PRINT@320," 3 + 4 * 5   "
190 PRINT@768, "FIRST DO THE MULTIPLICATION"
195 FOR C=1TO500:NEXTC
200 FOR C=1TO30:PRINT@327," ";:H=134325[.13552:PRINT@327,"*";:H=1343[.456:NEXTC
210 FOR C=1TO20:PRINT@325,"4 * 5";:H=1345[.13433:PRINT@325,"  20 ";:H=11323[.1353:NEXTC
220 PRINT@768,"NOW THE ADDITION                 ";
230 FORC=1TO500:NEXTC
240 FOR C=1TO30:PRINT@323," ";:H=14335[.35412:PRINT@323,"+";:H=35[.531:NEXTC
250 FOR C=1TO20:PRINT@320," 3 +   20 ";:H=551[.34:PRINT@320,"    23    ";:H=13[.334:NEXTC
260 FORC=1TO500:NEXTC
270 CLS
280 PRINT"NOW YOU TRY SOME"
290 O$(1)="*":O$(2)="/":O$(3)="-":O$(4)="+"
295 E$=""
300 PRINT
310 M=RND(5)
315 PRINT@512,"";
320 FORC=1TOM
325 N=RND(3)
330 E$=E$+STR$(N)
335 PRINTN;
337 IF C=M THEN 350
338 N=RND(4)
340 PRINT" ";O$(N);
345 E$=E$+" "+O$(N)
350 NEXT C
360 PRINT"       ";
370 PRINT:INPUT"WHAT DO YOU THINK THE ANSWER IS ";A
380 FORX=1TO500:NEXT
390 PRINT"SORRY I'M NOT THAT SMART!"
400 PRINT"ASK  CARL"
410 INPUT"AGAIN ";A$
420 IF A$<>"NO"THEN CLS:GOTO 290
440 CLS:PRINT"ALL DONE":PRINT:PRINT:END
