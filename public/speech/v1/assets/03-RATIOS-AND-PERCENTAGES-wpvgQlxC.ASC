1 '
10 N1=RND(54)
20 N2=RND(N1)
30 CLS
40 FOR X=1TON1:SET(X,1):NEXTX
50 FOR X=1TON2:SET(X,4):NEXTX
60 PRINT@N1/2+1,N1;
70 PRINT@N2/2+65,N2;
75 N1=N1+N2
80 PRINT:PRINT
90 INPUT"RATIO ";A$
95 A$=" "+A$
100 INPUT"PERCENTAGE";P$
105 PRINT
110 IF ABS( (N2/N1*100)-VAL(P$) )<1.1 THEN PRINT"PERCENTAGE RIGHT":P=P+1 ELSEPRINT"PERCENTAGE WRONG. IT SHOULD BE "N2/N1*100"%"
115 FOR H=2TON1
120 IFN1/H=INT(N1/H) AND N2/H=INT(N2/H) THEN N1=N1/H:N2=N2/H:GOTO120
130 NEXT H
140 IF A$= (STR$(N2)+"/"+STR$(N1) ) THEN PRINT"RATIO RIGHT":R=R+1  ELSE PRINT "THE RATIO SHOULD BE" N2"/"N1
1000 PP=PP+1
1010 PRINT
1020 PRINTP/PP*100"% OF PERCENTS HAVE BEEN CORRECT."
1030 PRINTR"OF"PP" OF THE RATIOS HAVE BEEN CORRECT."
1040 PRINT
1050 A$=INKEY$:IFA$=""THEN1050
1060 GOTO1
2000 CLS:FOR JJ=1TO1000
2010 R=RND(1000)
2020 PRINT@R,"RATIO";
2030 NEXTJJ
2040 RETURN
