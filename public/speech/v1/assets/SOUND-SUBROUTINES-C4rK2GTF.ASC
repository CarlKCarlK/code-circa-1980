10000 REM SUBROUTINE FOR SOUND    DS: DUATION OF SOUND  TS: TYPE OF SOUND
10010 ON TS GOTO 10020,10030, 10040, 10050, 10060, 10070, 10080,10090
10020 FORTS=1TODS:OUT255,0:OUT255,1:NEXT:GOTO 10200
10030 FORTS=1TODS:OUT255,1:OUT255,2:NEXT:GOTO 10200
10040 FORTS=1TODS:OUT255,1:OUT255,2:OUT255,3:NEXT:GOTO 10200
10050 FORTS=1TODS:OUT255,1:OUT255,2:OUT255,0:NEXT:GOTO 10200
10060 FORTS=1TODS:OUT255,1:OUT255,2:OUT255,1:OUT255,2:NEXT:GOTO 10200
10070 FORTS=1TODS:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:OUT255,0:OUT255,2:OUT255,1:OUT255,2:NEXT:GOTO 10200
10080 FORTS=1TODS:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:NEXT:GOTO 10200
10090 FOR TS=1TODS:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:OUT255,2:NEXT:GOTO 10200
10200 RETURN
