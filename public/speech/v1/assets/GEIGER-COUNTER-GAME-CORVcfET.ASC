10 CLS
20 PX=RND(128)-1:TX=RND(128)-1:TY=RND(45)-1+3:PY=RND(48)-1
30 S=1
35 ON ERROR GOTO 3000
40 PRINT"USE OF A GIGER COUNTER"
50 PRINT"RADIOACTIVE WASTE HAS BEEN DUMPED IN THIS AREA. YOUR JOB IS TO  FIND IT.   YOU HAVE ONLY YOUR GIGER COUNTER. WHEN YOU THINK YOU HAVE FOUND IT PUSH THE SPACE BAR.
60 PRINT"YOU HAVE OTHER CONTROLS.  THE (CLEAR) BUTTON WILL CLEAR AWAY    YOUR OLD PATH.  YOU CONTROL YOUR MOVEMENT WITH THE BUTTONS      Q,W,E,  A,S,D, Z,X,C   THE S IS STAND STILL THE W IS UP , D     RIGHT, AND SO ON."
70 PRINT"YOU ALSO CONTROL THE COUNTER WITH THE BUTTONS 1-9.    9 IS THE  MOST SENSEATIVE. 1 IS ONLY EFFECTIVE VERY CLOSE. IF A BUTTON, 8  FOR EXAMPLE CLICKS EVERY SECOND THE WASTE IS WITHIN A 8 YARD    (BLOCK) RADIUS."
80 PRINT"GOOD LUCK"
90 PRINT:PRINT:PRINT"PRESS (SPACE) WHEN READY";
95 IF INKEY$=""THENOUT255,1:OUT255,2:OUT255,3:GOTO95ELSECLS:PRINT@35,"SETTING   ";S:PRINT@0,"tIME (SEC)";
100 A$=INKEY$
110 IF A$=""OR A$=" "THEN 140
115 IF VAL(A$)<>0 THEN S=VAL(A$):PRINT@45,S;:GOTO 140ELSEIFA$=CHR$(31)THEN CLS:PRINT@35,"SETTING   ";S:PRINT@0,"TIME (SEC)";:GOTO 140
120 RESTORE:FORX=1TO9:READ M$,XC,YC:IFM$<>A$THEN NEXT
130 DATA Q,-1,-1,W,0,-1,E,1,-1,A,-1,0,S,0,0,D,1,0,Z,-1,1,X,0,1,C,1,1
140 PX=PX+XC:PY=PY+YC/2
150 SET(PX,PY)
160 R= SQR( (PX-TX)[2+(PY-TY)[2)
170 IFA$=" "THEN 1000
180 IF RND( INT(R/S)+1)=1 THEN OUT255,1:OUT255,2
185 TM=TM+1:PRINT@10,TM;
190 GOTO 100
1000 PRINT@640,"YOU TAKE OUT YOUR KNIFE AND PIKE "
1010 FORX=1TO700:NEXT
1020 PRINT@640,"AND START TO DIG ......             "
1030 FORX=1TO700:NEXT
1040 IF R=0 THEN 1100
1050 PRINT"BUT FIND NOTHING"
1060 FORX=1TO700:NEXT:TM=TM+100:GOTO180
1100 PRINT"AND FIND THE RADIO ACTIVE WASTE"
1110 FORX=1TO700:NEXT
1120 PRINT"GOOD JOB.  IT TOOK YOU "TM"SECONDS."
1130 FORX=1TO1000:NEXT
1140 PRINT
1150 INPUT"DO YOU WISH TO TRY AGAIN";A$
1160 IFA$="YES"OR A$="Y"THEN RUN
1170 END
3000 IF PX>127THENPX=127ELSEIFPX<0THENPX=0ELSEIFPY>47THENPY=47ELSEIFPY<0THENPY=0
3010 XC=0:YC=0:ONERRORGOTO 3000:RESUME
