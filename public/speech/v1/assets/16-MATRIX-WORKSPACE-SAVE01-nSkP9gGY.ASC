11 DIM A(78)
21 PRINT "(WAITING FOR SELECTION)"
31 A$=INKEY$:IFA$=""THEN 31
41 IF A$="N" THEN GOSUB 221:'NEW
43 IF A$="C" THEN GOSUB 311:'CREATE
45 IF A$="V" THEN GOSUB 411:'VALUES IN
47 IF A$="D" THEN GOSUB 511:'DISPLAY
49 IF A$="=" THEN GOSUB 611:'ASSIGNMENT
51 IFA$="S" THEN GOSUB 711:'SET A
61 IF A$="K" THEN GOSUB811 ELSE IF A$="L" THEN GOSUB821 ELSE IF A$="H" THEN GOSUB831 ELSE IF A$="J"  THEN GOSUB841 ELSE IF A$=" " THEN GOSUB851
99 GOTO 31
221 INPUT"ARE YOU SURE (Y)";A$
223 IF A$="Y" THEN A(27)=28
224 RETURN
311 INPUT"HOW LARGE (R,C)";N,M
312 A=A(27):A(A)=M+N/(5+5):A(27)=A+N*M+1
313 PRINT"CALLED ";A
314 I=1:J=1
321 RETURN
411 '
421 FOR I=1 TO (A(A)-INT(A(A)))*(5+5)+.5
431 PRINT "ROW ";I
441 FOR J=1 TO INT(A(A))
451 INPUT A(A+(I-1)*INT(A(A))+J)
461 NEXT J:NEXT I
465 I=1:J=1
471 RETURN
511 '
531 FOR I=1 TO (A(A)-INT(A(A)))*(5+5)+.5
535 FOR J=1 TO INT(A(A))
541 PRINT"R,C";I;J;"  ";A(A+(I-1)*INT(A(A))+J)
551 NEXT J
552 NEXT I
553 I=1:J=1
555 RETURN
611 INPUT"A <-- B (A,B)";A,B
621 T=INT(A(A))*(A(A)-INT(A(A)))
631 S=INT(A(B))*(A(B)-INT(A(B)))
641 IF S>T THEN T=S
651 FOR I=1 TO T*(5+5)+.5
661 A(A+I)=A(B+I)
671 NEXT I
672 I=1:J=1
681 RETURN
711 INPUT "WHICH MATRIX";A
721 I=1:J=1
731 RETURN
811 J=J-1:GOTO 851
821 J=J+1:GOTO 851
831 I=I-1:GOTO 851
841 I=I+1
851 PRINTA;"(";I;J;")="A(A+(I-1)*INT(A(A))+J)
861 INPUT A(A+(I-1)*INT(A(A))+J)
871 RETURN
