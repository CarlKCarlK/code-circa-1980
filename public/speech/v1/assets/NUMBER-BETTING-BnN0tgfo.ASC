10 S=5
15 M=1000
20 DIM F(S,2)
30 FORX=1TOS:F(X,0)=RND(0):F(X,1)=RND(0)
35 NEXTX
40 N=RND(1000)
45 CLS:PRINT:PRINT"$"M:PRINT
50 FORX=1TOS: IF RND(0)<F(X,0) THEN F(X,2)=RND(1000) ELSE F(X,2)=INT(N+SGN(RND(0)-.5)* RND(  F(X,1)*1000 ))
60 IF F(X,2)<0 OR F(X,2)>1000THEN F(X,2)=RND(1000)
70 PRINT"SORCE #"X" SUGGUSTS ";F(X,2)
80 NEXT X
90 PRINT
100 INPUT"YOU GUESS, BET ";G,B
110 IF B<0 OR B>M THEN PRINT"WATCH THAT BET !!!":GOTO100
120 M=B*1000/( 8* ABS(G-N)+1 )+M-B
130 PRINT:PRINT"THE NUMBER WAS "N" YOU NOW HAVE $"M"."
140 A$=INKEY$:IFA$=""THEN140
150 GOTO 40
