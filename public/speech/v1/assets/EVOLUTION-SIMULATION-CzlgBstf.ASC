2 CLEAR 300
3 DEFDBL A,B,D-Z
5 CLS
6 S=1:T=1:F=1:GOTO10
7 INPUT"CHANCE OF SMALL CHANGE,CHANGE OF TOTAL CHANGE,CHANGE IN MATCH UP WINDOW,FLEX OF SPEICES, INTIAL MATCH UP WINDOW";S,T,W,F,I:CLS
10 FOR C=1TO10
17 A(C)=RND(0)
20 E(C)=RND(0)
25 NEXT
30 G=G+1
40 PRINT@896,F;G;
45 M=1
55 FORC=1TO10:LINE(0,C)-(127*E(C),C),SET:LINE(127*E(C),C)-(127,C),RESET:NEXT
70 FORC=1TO10
80 N=VAL(MID$(STR$(OA),C,1))
90 U=RND(0)*F:Q=SGN(RND(2)-1.5)
95 IF N<0 OR N>9THEN N= RND(10)-1 
100 IF A(C)+U*Q>0 AND A(C)+U*Q<1 THEN A(C)=A(C)+U*Q
110 M=M*(1-ABS(E(C)-A(C)))
120 NEXT C
140 FORC=1TO10:LINE(0,C+11)-(127*A(C),C+11),SET:LINE(127*A(C),C+11)-(127,C+11),RESET:NEXT
145 LINE(0,25)-(127*M,25),SET:LINE(127*M+1,25)-(127,25),RESET
160 IF M>=I THEN FORC=1TO10:OA(C)=A(C):NEXT:PRINT@960,"SURVIED";:I=CC:LINE(0,27)-(M*127,27),SET:LINE(M*127+1,27)-(127,27),RESET:I=M:F=F/2
170 IF I>MTHENPRINT@960,"EXCTINT";:FORC=1TO10:A(C)=OA(C):NEXT
180 IF RND(0)*100<L THEN E=RND(0)
190 GOTO30
200 GOTO 30
