5 CLS
10 PRINT:PRINT:PRINT"E.S.P. AND CLARVOIVENCE  TESTER"
18 GOTO25
19 IFD=1THENPRINT"VERY LOW"ELSEIFD=2THENPRINT"LOW"ELSEIFD=3THENPRINT"AVERAGE"ELSEIFD=4THENPRINT"HIGH"ELSEIFD=5THENPRINT"VERY HIGH"ELSEIFD=6THENPRINT"YOU MUST BE PHYIC!"
20 RETURN
25 PRINT:PRINT"YOU WILL TAKE FIRST A ESP TEST THEN A CLARVOILENCE TEST.
30 PRINT:PRINT"THEN YOU WILL BE GRADED VERY LOW,LOW,AVERGE,HIGH,OR VERY HIGH.
40 PRINT:PRINT"ON EACH TEST OF FIFTY QUESTION, YOU SHOULD REPLY WITH A'1' OR'2'
50 PRINT:INPUT"PRESS <ENTER> TO START";C$
100 RANDOM
110 FORC =1TO50
120 X=RND(2)
130 PRINT:PRINT"QUESTION"C;
140 INPUT" IS IT 1 OR 2";G
150 IFG=XTHENR=R+1:PRINT"RIGHT"ELSEPRINT"WRONG"
160 NEXT
170 PRINT"OUT OF FIFTY QUESTIONS, YOU GOT"R*2"% CORRECT.
180 D=1+INT(R/10)
190 PRINT"YOU RANKED ";:GOSUB19
200 PRINT:PRINT:INPUT"PRESS <ENTER> TO CONTINUE";C$:R=0
210 CLS:PRINT:PRINT"IN THIS TEST YOU MUST PREDECT THE NUMBER BEFORE THE COM. PICKS.":PRINT"PRESS <ENTER> WHEN READY";:INPUTC$
220 FORX=1TO50
230 PRINT"NUMBER"X", WHAT WILL IT PICK";:INPUTG
240 IFG=RND(2)THENR=R+1:PRINT"RIGHT"ELSEPRINT"WRONG"
250 NEXT
260 PRINT:PRINT:PRINT"DONE, YOU CORRECTLY PREDECTED "R*2"%"
270 PRINT"YOU RANKED";:D=1+INT(R/10):GOSUB19:PRINT:PRINT"SO LONG"
