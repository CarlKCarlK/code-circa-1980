5 CLEAR 10000
10 DEFINT A-Z
20 DIM Q$(200),Y(200),N(200)
30  C=2
40 Q$(0)="IS IT A GAME"
50 Q$(1)="IS IT POKER"
60 Y(0)=1
70  N(0)=2
80 Q$(2)="IS IT A PUPPY DOG"
90 CC=0
100 CLS
110 PRINTQ$(CC);:INPUT A$
120  Y=Y(CC)
130  N=N(CC)
140  IF LEFT$(A$,1)="Y" THEN AFF=-1 ELSE AFF=0
150 IF Y<>0 AND N<>0 THEN IF AFF THEN CC=Y:GOTO100 ELSE CC=N:GOTO 100
160  IF NOT AFF THEN 200
170  PRINT"DONE !!!"
180  FOR I=1TO400:NEXTI:CC=0:GOTO 110
200  PRINT:PRINT:PRINT"I DON'T KNOW.":INPUT"WHAT IS IT? (E.G. POKER)";N$
205 INPUT"WHAT QUESTION COULD I HAVE ASKED TO DISTINGUISH
";NQ$
210 IF RIGHT$(NQ$,1)="?"THEN NQ$=LEFT$(NQ$,LEN(NQ$)-1)
220 PRINT"WOULD  'YES' TO THIS QUESTION MEAN "N$;:INPUTA$
230  IF LEFT$(A$,1)="Y"THENAFF=-1 ELSE AFF=0
240 Y(CC)=C+1:Q$(Y(CC))=Q$(CC):Q$(CC)=NQ$:N(CC)=C+2:Q$(N(CC))="IS IT "+N$
250 IF AFF THEN T=Y(CC):Y(CC)=N(CC):N(CC)=T
260 C=C+2:CC=0:GOTO 100
