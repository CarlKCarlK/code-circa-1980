10 CLS
20 INPUT"HOW MANY LEVELS";LV
30 FORI=1TOLV:C(I)=RND(100)
40 NEXT
50 L=1
60 CLS
70 FORX=56 TO73:SET(X,3):SET(X,LV*3+8):NEXTX:FORY=3TOLV*3+8:SET(56,Y):SET(73,Y):NEXT
100 A$=INKEY$:IFA$=""THEN130ELSEIFA$=CHR$(8) OR A$=CHR$(24)THEN CN=-1ELSE IFA$=CHR$(9)ORA$=CHR$(25)THEN CN=1ELSEIFA$=" "THEN 400 ELSEIFVAL(A$)<>0 THEN L=VAL(A$)ELSEGOTO 130
130 L(L)=L(L)+CN:PRINT@64*L+64+30,L(L);
140 IF L(L)=C(L) AND CN<>0THEN OUT255,1:OUT255,2
145 IF A$=CHR$(24)ORA$=CHR$(25) THEN CN=0
150 GOTO 100
400 FORX=1TOLV:IF C(X)=L(X) THEN NEXT:GOTO 700ELSEPRINT@770,"NO ":GOTO 100
700 PRINT@770,"YES";
