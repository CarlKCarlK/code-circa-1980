10     DIM A(5,6)
20     DIM R(5)
30     DIM S(6)
40     FOR I=1TO5
50     PRINT "COLUMN ";I
55     FOR J=1TO6
60     PRINT "INPUT NUMBER";J
70 A(I,J)=RND(10000):GOTO85
80     INPUT A(I,J)
85 REM
90     NEXT J
100    NEXT I
110    PRINT "--------------------------------------------------------------"
120    FOR J=1TO6
130    PRINT
140    FOR I=1TO5
150    PRINT A(I,J),
160    NEXT I
170    NEXT J
175    PRINT
180    PRINT "--------------------------------------------------------------"
190    L1=1
200    L2=1
210    S1=1
220    S2=1
230    G=0
240    FOR I=1TO 5
250    R(I)=0
260    FOR J=1TO 6
270    IF I=1 THEN S(J)=0
280    G=G+A(I,J)
290    R(I)=R(I)+A(I,J)
300    S(J)=S(J)+A(I,J)
310    IF A(L1,L2)>A(I,J) GOTO 360
330    REM SAVE LOCATION OF LARGEST NUMBER
340    L1=I
350    L2=J
360    IF A(S1,S2)> A(I,J) GOTO 380
370    GOTO 410
380    REM SAVE LOCATION OF SMALLEST NUMBER
390    S1=I
400    S2=J
410    NEXT J
420    NEXT I
430    FOR I=1TO5
440    PRINT "TOTAL FOR COLUMN";I;" = ";R(I)
450    NEXTI
455    PRINT
460    FOR J=1TO6
470    PRINT "TOTAL FOR ROW";J;" = ";S(J)
490    NEXT J
500    PRINT
510    PRINT "GRAND TOTAL OF THE TABLE";G
520    PRINT
530    PRINT "THE LARGEST NUMBER IN THE TABLE IS";A(L1,L2)
540    PRINT "IT IS LOCATED AT ROW" ;L2;",COLUMN";L1
550    PRINT
560    PRINT "THE SMALLEST NUMBER IN THE TABLE IS";A(S1,S2)
570    PRINT "IT IS LOCATED AT ROW";S2;",COLUMN";S1
