5 DIM C$(11)
10 CLS
20 PRINT"

                BASIC GAMES DISKETTE ONE

"
40 C=0
50 C=C+1:READ N$,C$(C),D$
55 IF N$="DONE"THEN 300
60 PRINT CHR$(C+ASC("A")-1)") "N$" - "D$
70 IF C<10 THEN 50
80 PRINT"
SELECT A LETTER  OR  PRESS ENTER FOR MORE CHOICES ";
90 A$=INKEY$:IFA$=""THEN90 ELSE PRINTA$;
100 IF A$=CHR$(13) THEN 10
110 IF A$<"A" OR A$> CHR$(ASC("A")-1+C) THEN 80
120 RUN C$(ASC(A$)-ASC("A")+1)+"/BAS"
300 PRINT"
SELECT A LETTER OR PRESS ENTER TO SEE CHOICES AGAIN ";
310 A$=INKEY$:IFA$=""THEN310 ELSE PRINT A$;
320 IF A$=CHR$(13) THEN RESTORE:RUN
330 IF A$<"A" OR A$>CHR$(ASC("A")-2+C) THEN 300
340 RUN C$(ASC(A$)-ASC("A")+1)+"/BAS"
1000 DATA  MARKET,MARKET,A SIMULATION OF BUSINESS FOR TWO,
COLDWAR,COLDWAR,A SIMULATION OF INTERNATIONAL TENSIONS,

FOOTBALL,FOOTBALL,A (VERY) SIMPLE FOOTBALL VIDEO GAME,
ILLIAD,ILLIAD,THE ILLNI ADVENTURE GAME
1010 DATA QUORUM-IN-SPACE,QUORUM,A SIMULATION OF HIGH-STAKES GOVERNMENT FOR ONE,
RACE,RACE,A VIDEO GAME FOR TWO,
KING,KING,A SIMULATION FOR ONE,
BLOCKADE ROBOT,BLOCKRB,CLASSIC VIDEO GAME FOR TWO
1020 DATA BLOCKADE IN 3-D,BLOCK3D,A VIDEO GAME FOR TWO IN A CUBE,MAZE,MAZE,A GAME FOR ONE OR TWO
9999 DATA DONE,DONE,DONE
