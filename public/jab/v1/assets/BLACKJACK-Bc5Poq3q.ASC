3 CLS
5 DEFINT R
10 DIM R(21,21),C(13)
11 FOR I=1TO13:C(I)=I:NEXTI:C(1)=11:C(11)=10:C(12)=10:C(13)=10
20 FOR P=1TO10:FORH=1TO21:R(P,H)=100:NEXTH,P:PRINT"DONE"
100 FOR H=1TO11
110 FOR P=11 TO 21
115 PP=P:HH=H
120 DD=R(PP,HH):IFDD=0THENDD=SGN(RND(2)-1.5)
121 IF PP=P AND HH=H THEN D=DD
130 IF DD<0 THEN 200
135 HH=H
140 PP=P+C(RND(13))
145 IF PP>21 THEN L=-1:GOTO600
150 GOTO 120
160 '
170 '
200 IF HH<17 THEN HH=HH+C(RND(13)) ELSE250
210 IF HH>21 THEN L=+1:GOTO600
220 GOTO 200
250 IF HH>=PP THEN L=-1 ELSE L=1
260 GOTO 600
600 R(P,H)=R(P,H)+L*SGN(D)
605 A$=INKEY$:IFA$=" "THEN1000ELSE IFA$="S"THEN2000
610 NEXTP:PRINT@0,"HOUSE=";H+1;:NEXTH
615 W=W+1:PRINT"ROUND="W;
620 GOTO 100
1000 CLS:PRINT"PLAYING.   YOU ARE HOUSE I AM PLAYER
1010 H1=C(RND(13)):P1=C(RND(13))
1020 PRINT"YOUR UP CARD IS "H1"  MINE IS "P1
1030 D1=R(P1,H1):IFD1=0THEND1=SGN(RND(2)-1.5):PRINT"*";
1040 IF D1<0 THEN 1100
1050 PRINT"HIT ME":P1=P1+C(RND(13))
1060 IF P1>21 THEN PRINT"I'M BUSTED":GOTO 1300
1070 GOTO 1030
1100 PRINT"I STICK"
1200 INPUT"(H)IT OR (S)TICK";C$
1210 IF C$="H"THEN H1=H1+C(RND(13)):PRINT"YOUR TOTAL IS NOW";H1:IF H1>21 THEN PRINT"YOUR BUSTED":GOTO1300ELSE 1200
1220 PRINT"MY TOTAL IS"P1", YOURS IS "H1"."
1230 IF H1>=P1 THEN PRINT"YOU WIN"ELSE PRINT"I WIN"
1300 PRINT:INPUT"AGAIN";C$:IFC$="YES"THEN 1000ELSECLS:GOTO610
2000 CLS
2005 FOR H1=1TO11:PRINT@H1*3,H1;:NEXTH1
2010 FOR P1=11TO21:PRINT@(P1-10)*64,P1;:FORH1=1TO11
2020 PRINT@(P1-10)*64+H1*3,"";
2030 D1=R(P1,H1):IFD1<0 THEN PRINT"S";ELSEIFD1>0THENPRINT"H";ELSEPRINT"?";
2040 NEXT H1,P1
2050 A$=INKEY$:IFA$=""THEN2050ELSECLS:GOTO610
