40 GOTO90
50 CLS:PRINT@384,"";:RETURN
90 '
950 LE=72
1000 CLS:PRINT@384,"ARE YOU  <MALE>  OR  <FEMALE>";:INPUTA$
1010 IFA$="MALE"THENLE=LE-3ELSEIFA$="FEMALE"THENLE=LE+4ELSEGOTO1000
1050 GOSUB50:INPUT"WHAT IS THE APPROXITATE POPULATION OF YOUR COMMUNITY";A
1060 IFA>=2E+6THENLE=LE-2ELSEIFA<=10000THENLE=LE+2
2000 GOSUB50:INPUT"DO YOU WORK AT A <DESK>, AT A JOB THAT REQUIRES REGULAR HEAVY   PHYSICAL <LABOR>,  OR AT <NEITHER>";A$
2010 IFA$="DESK"THENLE=LE-3ELSEIFA$="LABOR"THENLE=LE+3ELSEIFA$<>"NEITHER"THEN2000
2050 GOSUB50:INPUT"HOW MANY DAYS A WEEK DO YOU EXERCISE STRENUOUSLY (TENNIS,RUNNINGSWIMMING, ETC.) ";A
2060 IFA>=5THENINPUT"HOW MINUNTES A SESSION";A
2070 IFA>=30THENLE=LE+2
3000 GOSUB50:INPUT"HOW MANY PEOPLE LIVE IN YOUR HOUSEHOLD (COUNT YOURSELF AS ONE)";A
3010 IFA>1THENLE=LE+5:GOTO3050
3020 INPUT"HOW MANY YEARS HAVE YOU LIVED ALONE";A
3030 LE=LE-INT(A/10)
3050 GOSUB50:INPUT"HOW MANY HOURS A NIGHT DO YOU SLEEP";A
3060 IFA>=10THENLE=LE-4
4000 GOSUB50:INPUT"DO OTHER PEOPLE CONSIDER YOU <INTENSE>, AGGRESSIVE, AND EASILY  ANGERED; OR <EASYGOING>, RELAXED, AND A FOLLOWER; OR <NEITHER>";A$
4010 IFA$="INTENSE"THENLE=LE-3ELSEIFA$="EASYGOING"THENLE=LE+3ELSEIFA$<>"NEITHER"THEN4000
4500 GOSUB50:INPUT"HOW DO YOU FEEL ( <HAPPY> OR <UNHAPPY> )";A$
4510 IFA$="HAPPY"THENLE=LE+1ELSEIFA$="UNHAPPY"THENLE=LE-2ELSE4500
5000 GOSUB50:INPUT"HOW MANY SPEEDING TICKETS HAVE YOU HAD IN THELAST YEAR";A
5010 IFA>0THENLE=LE-1
5500 GOSUB50:INPUT"APPROXIMATLY HOW MUCH TO YOU EARN A YEAR";A
5510 IFA>=50000THENLE=LE-2
6600 GOSUB50:INPUT"WHAT WAS THE LAST LEVEL OF EDUCTION YOU PASTED <NONE>, <GRADE-SCHOOL>, <HIGH-SCHOOL>, <COLLEGE>, COLLEGE WITHA PROFESSIONAL OR GRADUATE <DEGREE>";A$
6610 IFA$="COLLEGE"THENLE=LE+1ELSEIFA$="DEGREE"THENLE=LE+2
20000 PRINTLE
