10 CLS
90 GOSUB 100:GOTO110
100 H=9:V=9:RETURN
110 DIM W(H,V),V(H,V)
117 FOR X=0TOH+H+H:SET(X,2):SET(X,V+V+4):NEXTX
120 YS=3
160 Q=0:Z=0:X=INT(RND(0)*H+1)
165 FORI=1TOH
170 IFI=XTHEN173
171 SET(XS,YS):SET(XS+1,YS):SET(XS+2,YS):XS=XS+3:GOTO180
173 SET(XS,YS):RESET(XS+1,YS):RESET(XS+2,YS):XS=XS+3
180 NEXTI
190 SET(XS,YS):XS=0:YS=YS+1
195 C=1:W(X,1)=C:C=C+1
200 R=X:S=1:GOTO260
210 IFR<>HTHEN240
215 IFS<>VTHEN230
220 R=1:S=1:GOTO250
230 R=1:S=S+1:GOTO250
240 R=R+1
250 IFW(R,S)=0THEN210
260 IFR-1=0THEN530
265 IFW(R-1,S)<>0THEN530
270 IFS-1=0THEN390
280 IFW(R,S-1)<>0THEN390
290 IFR=HTHEN330
300 IFW(R+1,S)<>0THEN330
310 X=INT(RND(0)*3+1)
320 ON X GOTO 790,820,860
330 IFS<>VTHEN340
334 IFZ=1THEN370
338 Q=1:GOTO350
340 IFW(R,S+1)<>0THEN370
350 X=INT(RND(0)*3+1)
360 ONXGOTO790,820,910
370 X=INT(RND(0)*2+1)
380 ON X GOTO790,820
390 IFR=H THEN 470
400 IFW(R+1,S)<>0THEN470
405 IFS<>VTHEN420
410 IFZ=1THEN450
415 Q=1:GOTO430
420 IFW(R,S+1)<>0 THEN450
430 X=INT(RND(0)*3+1)
440 ONXGOTO790,860,910
450 X=INT(RND(0)*2+1)
460 ON X GOTO790,860
470 IFS<>VTHEN490
480 IFZ=1THEN520
485 Q=1:GOTO500
490 IF W(R,S+1)<>0THEN520
500 X=INT(RND(0)*2+1)
510 ON X GOTO790,910
520 GOTO790
530 IF S-1=0THEN670
540 IF W(R,S-1)<>0THEN670
545 IFR=HTHEN610
547 IFW(R+1,S)<>0THEN610
550 IFS<>VTHEN560
552 IFZ=1THEN590
554 Q=1:GOTO570
560 IFW(R,S+1)<>0THEN590
570 X=INT(RND(0)*3+1)
580 ON X GOTO820,860,910
590 X=INT(RND(0)*2+1)
600 ON X GOTO 820,860
610 IF S<>VTHEN630
620 IFZ=1THEN660
625 Q=1:GOTO640
630 IF W(R,S+1)<>0THEN660
640 X=INT(RND(0)*2+1)
650 ON X GOTO 820,910
660 GOTO820
670 IFR=HTHEN740
680 IFW(R+1,S)<>0THEN740
685 IFS<>VTHEN700
690 IFZ=1THEN730
695 Q=1:GOTO830
700 IFW(R,S+1)<>0THEN730
710 X=INT(RND(0)*2+1)
720 ON X GOTO860,910
730 GOTO860
740 IFS<>VTHEN760
750 IFZ=1THEN780
755 Q=1:GOTO770
760 IFW(R,S+1)<>0THEN780
770 GOTO910
780 GOTO1000
790 W(R-1,S)=C
800 C=C+1:V(R-1,S)=2:R=R-1
810 IFC=H*V+1 THEN1010
815 Q=0:GOTO260
820 W(R,S-1)=C
830 C=C+1
840 V(R,S-1)=1:S=S-1:IFC=H*V+1THEN1010
850 Q=0:GOTO260
860 W(R+1,S)=C
870 C=C+1:IFV(R,S)=0THEN880
875 V(R,S)=3:GOTO890
880 V(R,S)=2
890 R=R+1
900 IFC=H*V+1THEN1010
905 GOTO530
910 IFQ=1THEN960
920 W(R,S+1)=C:C=C+1:IFV(R,S)=0THEN940
930 V(R,S)=3:GOTO950
940 V(R,S)=1
950 S=S+1:IFC=H*V+1 THEN1010
955 GOTO260
960 Z=1
970 IFV(R,S)=0 THEN980
975 V(R,S)=3:Q=0:GOTO1000
980 V(R,S)=1:Q=0:R=1:S=1:GOTO250
1000 GOTO210
1010 FORJ=1TOV
1011 SET(XS,YS):XS=XS+1
1012 FORI=1TOH
1013 IFV(I,J)<2THEN1030
1020 XS=XS+3
1021 GOTO1040
1030 SET(XS+2,YS):XS=XS+3
1040 NEXTI
1041 XS=0:YS=YS+1
1043 FORI=1TOH
1045 IFV(I,J)=0THEN1060
1050 IFV(I,J)=2THEN1060
1051 SET(XS,YS):XS=XS+3
1052 GOTO1070
1060 SET(XS,YS):SET(XS+1,YS):SET(XS+2,YS):XS=XS+3
1070 NEXTI
1071 SET(XS,YS):XS=0:YS=YS+1
1072 NEXTJ
1150 CLEAR 200:DEFINT A-Z
1200 FOR Y=0TO46:IF POINT(0,Y)AND S=0THENFORX=0TO127:IF NOT POINT(X,Y+1)THEN X(0)=X:Y(0)=Y+1:S=1 ELSE NEXT X:STOP
1230 IF NOT POINT(0,Y) AND S=1 THEN FORX=0TO127:IFNOTPOINT(X,Y-2)THEN X(1)=X:Y(1)=Y-2:S=2ELSENEXTX:STOP
1260 IF S=2 THEN K=RND(2)-1:I=RND(2)-1:S=0 ELSE NEXTY:STOP
1270 FORJ=0TO1:SET(X(J),Y(J)):SET(X(J)+1,Y(J)):A(J)=X(J):B(J)=Y(J):NEXTJ
1280 C(0)=1:C(1)=0:C(2)=-1:C(3)=0:S(0)=0:S(1)=1:S(2)=0:S(3)=-1
1300 I=1-I:M$="":T=T+1
1310 SC=0:FOR A=3TO0STEP-1:X=X(I)+C(A)+(C(A)AND(A=0)):Y=Y(I)+S(A):T(A*2)=-POINT(X,Y):T(A*2+1)=(X=A(0)ANDY=B(0))OR(X=A(1)ANDY=B(1))OR(X=X(1-I)ANDY=Y(1-I)):SC=SC+2*T(A*2+1)+T(A*2):NEXTA
1315 'ON ERROR GOTO 1450
1320 IF I=K THEN GOSUB 5000 ELSE GOSUB 5000
1330 IF 0<=SC AND SC<=3 THEN IF NOT T(SC*2) THEN S=0ELSES=S+1:SC=4  ELSE S=S+1:SC=4
1340 IF S>20 THEN 1500
1350 IF M$<>""THEN M$=M$+STRING$(33," "):FORL=0TO1:PRINT@I*64*4+52+64*L,MID$(M$,L*11+1,11);:NEXTL
1360 IF SC=4 OR T(SC*2) THEN 1400
1365 X=X(I)+C(SC)*3:Y=Y(I)+S(SC)
1370 IF SC=1 OR SC=3 THEN SET(X,Y):RESET(X(I),Y(I)):SET(X+1,Y):RESET(X(I)+1,Y(I)):GOTO1390
1375 IF SC=2THEN SET(X+2,Y):RESET(X+4,Y):SET(X+1,Y):RESET(X+3,Y):SET(X,Y):RESET(X+2,Y)
1380 IF SC=0THENSET(X-1,Y):RESET(X-3,Y):SET(X,Y):RESET(X-2,Y):SET(X+1,Y):RESET(X-1,Y)
1390 X(I)=X:Y(I)=Y
1395 IF Y=B(I) AND X=A(I) AND M(I)=1THEN 1600 ELSE IF Y=B(1-I) AND X=A(1-I)THENM(I)=1
1400 GOTO 1300
1450 SC=4:E(I)=E(I)+1:S=S+1:IF S>20THENRESUME1500 ELSERESUME 1330
1500 'TEN MOVES
1510 PRINT"TEN MOVES":END
5000 M$=STR$(SC):SC=LOG(PEEK(14352)+.001)/LOG(2)-1:IF FT(I)=0THENM$="DUMB":FT(I)=1ELSEM$=CHR$(RND(26)+ASC("A")-1)+STR$(SC)	+M$
5020 RETURN
