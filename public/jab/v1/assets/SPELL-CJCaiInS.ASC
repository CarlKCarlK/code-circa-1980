1 CLEAR 9000:DEFINT B-Z
2 CLS :PRINT "LOADING"
3 DEF FNY(X)=INT(X/120*30)
4 DEF FNS(R,W,T)= ((W/T)*(R/W)*(1-(W/T))+(R/W)*(W/T)+ATN((W+W)*(W+W)/1E4)/10)*100
5 DEF FNV(W,T)=(T-W)/(T+5)*16000
7 FORX=1TO 5:READY,Y1:P$=P$+STRING$(Y,CHR$(Y1)):NEXTX:GOTO1000
8 DATA 2,176,2,188,4,191,2,143,2,131
9 CLS:FORX=316TO950STEP58:PRINT@X,LEFT$(P$,(X-316)/58*6+4);:NEXTX:PRINT@960,RIGHT$(P$,6);
40 PRINT@704+40,"RECORD RUNS";:PRINT@768+40,"ALL-TIME  ";ER;:PRINT@832+40,"TODAY     ";ET;:PRINT@896+40,"CURRENT   ";0;
42 W=0:PA=0:TS=0:R=0:EC=0
45 FOR Y1 = 0 TO 1:SET(RR,43-(FNY(RR)+Y1)):NEXT Y1:RESET(AV,46-FNY(AV)):FOR Y1=0TO1:SET(RT,43-(FNY(RT)+Y1)):NEXTY1
50 W=W+1:GOSUB 2000
65 FOR Y1=0 TO 3:RESET(TS,43-(Y+Y1)):NEXT Y1:SET(PA,46-FNY(PA))
70 TS=FNS(R,W,T):Y=FNY(TS):FOR Y1=0 TO 3:SET(TS,43-(Y+Y1)):NEXT Y1:PA=AV*W/T:RESET(PA,46-FNY(PA)):GOSUB2500
75 IFMSTHEN GOSUB 3000:IF GU$<>W$(J%(W)) OR MSTHEN MS=-1:GOTO75
80 IF W<>T THEN 50
90 FOR I=1 TO TT:I%(I)=ASC(MID$(I$,I,1)):NEXTI
100 CLS:PRINT"LIST COMPLETE":PRINT:PRINT"YOUR SCORE IS";TS"."
110 PRINT"YOU ANSWERED";R/T*100"% RIGHT."
115 PRINT "YOU MISSED";T-R" OF"T" WORDS."
120 IF TS>AV THEN PRINT "YOU BEAT THE AVERAGE."
125 IF TS>RT THEN PRINT"YOU HAVE SET TODAY'S RECORD":RT=TS
130 IF TS>RR  THEN PRINT "YOU HAVE SET A NEW ALL-TIME RECORD":RR=TS
140 AV= (AV*AT+TS)/(AT+1):AT=AT+1
150 PRINT "THE AVERAGE OF";AT" SCORES  IS NOW";AV"."
160 GOTO 1270
1000 DIM W$(500),T%(500),W%(500),V(500),I%(500),J%(500)
1100 OPEN "I",1,"WORDS/DAT"
1110 IF NOT EOF(1) THEN TT=TT+1:INPUT#1,G,W$(TT),T%(TT),W%(TT):GOTO1110
1200 CLOSE 1:OPEN"I",2,"RECORD/DAT":INPUT#2,AV,AT,RR,RT,ER,ET,TI$:CLOSE2:IF TIME$<TI$ THEN RT=0:ET=0
1205 FOR I=0TOTT+1:I%(I)=I:V(I)=FNV(W%(I),T%(I)):NEXTI
1210 CLS
1230 PRINT*"WELCOME"
1240 PRINT@128,"SPELLER II":PRINT:PRINT
1250 PRINT "NUMBER OF KNOWN WORDS IS";TT"."
1260 PRINT "AVERAGE SCORE IS";AV"."
1270 PRINT "HIGH SCORE IS";RR"."
1280 PRINT
1290 INPUT "HOW MANY WORDS WOULD YOU LIKE TO DO? (0 TO QUIT)";T
1300 IF T<>0 THEN 1400
1310 OPEN"O",2,"RECORD/DAT":PRINT#2,AV","AT","RR","RT","ER","ET","CHR$(34);TIME$;CHR$(34):CLOSE2
1320 OPEN"O",1,"WORDS/DAT":FOR T=1TO TT:PRINT#1,MID$(STR$(T*10),2)","W$(I%(T))","T%(I%(T))","W%(I%(T)):NEXT T
1330 CLOSE 1:PRINT*"BYE":CLS:END
1400 CLS:PRINT "GATHERING";
1410 V(0)=-9999:V(TT+1)=9999
1415 FOR J=2 TO TT:I=J-1:T1=I%(J)
1420 IF V(T1)>=V(I%(I)) THEN 1430 ELSE I%(I+1)=I%(I):I=I-1:GOTO 1420
1430 I%(I+1)=T1:NEXTJ:I$="":FORJ=1TOTT:I$=I$+CHR$(I%(J)):NEXTJ
1440 FOR I= 1 TO T:R1=RND(I):J%(I)=J%(R1):J%(R1)=I%(I):NEXT I
1450 GOTO 9
2000 '
2090 MS$=""
2100 GOSUB3000:IF GU$=W$(J%(W))AND NOT MSTHEN R=R+1:EC=EC+1 ELSE W%(J%(W))=W%(J%(W))+1:MS=1:MS$=GU$:EC=0
2105 T%(J%(W))=T%(J%(W))+1:W9=W%(J%(W)):T9=T%(J%(W)):V(J%(W))=FNV(W9,T9)
2106 PRINT @ 896+50,EC;"    ";:IFEC>ET THEN ET=EC:PRINT@832+50,EC;"   ";:IFEC>ER THEN ER=EC:PRINT@768+50,EC;"    ";
2110 RETURN
2500 '
2510 J7=INSTR(I$,CHR$(J%(W))):Z7=V(J%(W))
2520 L7=1:H7=TT
2530 IF L7>H7 THEN 2540ELSE M7=(L7+H7)/2:X7=V(ASC(MID$(I$,M7,1))):IFX7<Z7THENL7=M7+1ELSEH7=M7-1
2535 GOTO 2530
2540 IF L7<J7 THEN MID$(I$,L7,J7-L7+1)=MID$(I$,J7,1)+MID$(I$,L7,J7-L7)ELSEMID$(I$,J7,L7-J7)=MID$(I$,J7+1,ABS(L7-J7-1))+MID$(I$,J7,1)
2550 RETURN
3000 MS=0:PRINT@0,"";
3005 PRINT*W$(J%(W));
3010 PRINT@0,"",:PRINT@0,CHR$(14);:GU$=""
3020 ZZ$=INKEY$:IFZZ$=""THEN3020 ELSE IF "A"<=ZZ$ AND ZZ$<="Z" THEN GU$=GU$+ZZ$:PRINT"X";:GOTO3020 ELSE PRINTCHR$(15);:IF ZZ$<>CHR$(13) THEN PRINT@64,GU$,:IF ZZ$=" " THEN PRINT@64+32,MS$,:GOTO 3010 ELSE 3010
3030 IF GU$="?" OR GU$="HELP" THEN MS=1:PRINT@32,W$(J%(W)),:LINE INPUT GU$:PRINT @32,"",:GOTO 3010 ELSE IF GU$=""THEN3005
3040 PRINT@64,"",:PRINT@64+32,"",:RETURN
7000 CLS:FOR MM=1TOTT:SET(MM,V(ASC(MID$(I$,MM,1)))/500):NEXTMM
7010 FOR MM=1TOTT:SET(MM,V(I(MM))/500+10):NEXTMM
7120 RETURN
