25 DATA 2,0,-1, 4,0,1, 8,-1,0, 16,1,0, 10,-1,-1, 12,-1,1, 18,1,-1,20,1,1
30 X=INT((15+RND(30))/2)*2:Y=15:FOR I=1TOJN:PRINTB$;:X(I)=RND(32)*2-2:Y(I)=0:NX(I)=X:NY(I)=Y:NEXTI
40 PRINT@28+7*64-3,"   +   ";:PRINT@28+6*64-3,"*     *";:PRINT@28+8*64-3,"* --- *";
45 RESET(118,6):SET(112,6):SL=SL/100:RO=-1
50 T=T-1:IFT<-4THEN700ELSEPRINT@250,INT(T);:IFRND(0)>SLTHEN200ELSER=RND(JN):IF ((X(R)<>NX(R)ORY(R)<>NY(R))AND(G=1OROX(R)=1))ORX(R)<-10THEN95
80 OX(R)=0:D=SQR(ABS(X-X(R))):D1=SQR(ABS(Y-Y(R))):T4=INT(T/300*7):IFT4<>T5THENPRINT@27+(14-T5)*64,"---";:PRINT@27+(14-T4)*64,CHR$(140);CHR$(140);CHR$(140);:T5=T4
90 NX(R)=X+INT(DX*D/2)*2:NY(R)=INT(Y+DY*D1):IFNX(R)<0THENNX(R)=0ELSEIFNX(R)>62THENNX(R)=62
95 GOSUB 100:GOTO110
100 X(R)=X(R)+SGN(NX(R)-X(R))*2:XX=28-(X(R)-X):Y(R)=Y(R)+SGN(NY(R)-Y(R)):YY=7-(Y(R)-Y):PRINT@OY(R),O$(R);:IFXX>=0ANDXX<=62ANDYY>=0ANDYY<15THEN L=XX+YY*64ELSERETURN
105 O=PEEK(15360+L):O1=PEEK(L+15361):PRINT@L,D$;:OY(R)=L:IFO<>93ANDO<>94ANDO<>43ANDO1<>93ANDO1<>94ANDO1<>43THEN107 ELSE IF O=43ORO1=43THEN900ELSEIFO=93ORO=94THENO=32
106 IFO1=93ORO1=94THENO1=32
107 O$(R)=CHR$(O)+CHR$(O1):RETURN
110 GOTO 50
200 R=PEEK(14352):IFR=0 AND RO=0THEN DX=0:DY=0:G=1:T=T+.5:GOTO400ELSEIFR=ROTHENG=1:GOTO210ELSERO=R:G=0:IFR<21THENDX=DX(R):DY=DY(R)ELSE300
210 X=X+DX*2:Y=Y+DY:IFX<0THENX=0:GOSUB600ELSEIFX>62THENX=62:GOSUB600
220 IF Y<0THENY=0:GOSUB600ELSEIFY>15THENY=15:GOSUB600
225 FOR R=1TOJN:GOSUB100:NEXTR:RESET(X1,Y1):X1=126-X/4:Y1=5-Y/3:SET(X1,Y1)
240 GOTO 400
300 RO=-1:PRINTB$;B$;:FORII=1TO2:FORJJ=1TOJN:IFMID$(O$(JJ),II,1)<>"*"THENNEXTJJ,II:GOTO400ELSEGOSUB3100:O$(JJ)="":OX(JJ)=1: NX(JJ)=X(JJ)+SGN(X(JJ)-X)*30:NY(JJ)=Y(JJ)+SGN(Y(JJ)-Y)*15:GOTO400
400 GOTO 50
500 FORI=1TO6:PRINT@ 34+RND(10)-5+(7-RND(3)+2)*63,"*";:NEXTI:FORI=1TO60:PRINTB$;:PRINT@RND(1020),CHR$(191-RND(32));:NEXTI:CLS:IFBM=1THEN700ELSEFORI=1TO25:PRINT@RND(510)*2,CHR$(93)+CHR$(94);:NEXTI:PRINT@450,"THE REBELLION IS DOOMED";:A$=INKEY$+INKEY$:GOTO630
520 CLS
