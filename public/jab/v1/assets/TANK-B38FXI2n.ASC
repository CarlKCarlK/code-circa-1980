10 'TANK GAME
20 'COPYRIGHT 1980  CARL KADIE
30 'PLAN OF ACTION
35 '
40 GOSUB 7000:'SET UP DATA STURCTURE
41 '
45 '*** MAIN PROGRAM ***'
50 IF D1=10 OR D2=10 THEN 130 :'DO WHILE EACH SIDE HAS ONE OR MORE WORKING TANKS
60    FOR TA = 0 TO 9
70           FOR TEAM = 0 TO 1
90               IF ENERGY(TEAM,TA)>0 
         		            THEN GOSUB 5500:'SET-UP
                          GOSUB 150:'PROGRAM EXECUTE
	                          GOSUB 5700:'SET-DOWN
100              NEXT TEAM:'END TEAM
110          NEXT TA:'END TANK
120    GOTO 50:'END WORKING?
130 END:'END MAIN PROGRAM
140 '
150 '*** SUBROUTINE TO EXECUTE TANK PROGRAMS ***'
160  FLAG=1   :' FLAG WILL EQUAL 0 WHEN TIME IS UP
165  MP=1  :'    MAIN POINTER
170 IF NOT(FLAG>0) THEN 350
180 GOSUB370:'   GOSUB INSTR    /*  GET NEXT COMMAND  */
185   PE=0
190    IF NOT( IN$<>"RE" AND FLAG>0)THEN230:'FIRST EMERGENCY
200             GOSUB480:'CALL DOIT
210             GOSUB 370:'GOSUB INSTR
220             GOTO190:' END FIRST EMERGENCY
230    IF FLAG <= 0 
                THEN EP=MP:LX(TE,TA,0)=LX:LY(TE,TA,0)=LY
                ELSE MP=EP:LX=LX(TE,TA,0):LY=LY(TE,TA,0):
                     GOSUB370:'GOSUB INSTR
240     IF NOT( IN$<>"RE" AND FLAG>0) THEN 280:'   SEC EMER
250             GOSUB 480:'CALL DOIT
260             GOSUB 370:'GOSUB INSTR
270           GOTO 240:' END SEC EMER
280    IF FLAG<=0
                THEN EP=MP:LX(TE,TA,0)=LX:LY(TE,TA,0)=LY
                ELSE MP=PP:PE=1:LX=LX(TE,TA,1):LY=LY(TE,TA,1):
                     GOSUB 370:'GOSUB INSTR
290 IFNOT(MP<= LEN(PR$) AND FLAG >0) THEN 330:'PRIMARY
300             GOSUB 480:'CALL DOIT
310             GOSUB 370:'GOSUB INSTR
320            GOTO290:'END PRIMARY
330    IF FLAG=<0
                THEN PP=MP
340    IF MP> LEN(PR$)
                MP=RND(LEN(PR$))
345 GOTO 170:' END ROUTINES LOOP
350    RETURN:' EXCUT
360 '
370 '***  INSTR -- PROGRAM TO GET NEXT STUFF FROM PROGRAM ***'
380 IN$=""
385 VA=1
390 NE$=MID$(PROGRAM$,MP,1)
395 MP=MP+1
400 IF NOT(LEN(IN$)<2 AND MP<= LEN( PR$)) THEN 460
410      IF VAL(NE$)=0 AND NE$<>"0" AND NE$<>"." AND NE$<>"
               THEN IN$=IN$+NE$
420      IF VAL(NE$)<>0 OR NE$="0" THEN
            VALUE=VAL(MID$(PR$,MP-1,LEN(PR$)):IN$=""
		             :MP=MP+LEN(STR$(VALUE))-1
430      IF NE$="#" THEN
            MP=MP+LEN(STR$(VAL(MID$(PR$,MP,LEN(PR$)))))-1
440      IF NE$="." OR NE$=" " THEN IN$=""
450 GOTO 400
460 RETURN
480 '*** SUBROUTINE TO EXECUTE THE COMMANDS ***'
500 ON ASC(IN$)-69 GOTO 600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200
600 'FIRE
615 FLAG=0
620 IF ENERGY>=VATHEN ENERGY=ENERGY-VA ELSE VA=ENERGY:ENERGY=0
630  DISTANCE=ABS(X-LX)+ABS(Y-LY):
     DAMAGE=(4-DISTANCE)*ENERGY:
     IF DISTANCE>=4
        THEN DAMAGE=ENERGY/2[(DISTANCE-3)
635 FOR TEMP=1TO20:T2=PEEK(15360+LX+LY*64):POKE 15360+LY*64+LX,ASC("-"):T1=1[1[1[1[1:POKE 15360+LX+LY*64,T2:NEXT TEMP
640 ON  WHO+1 GOTO 641,650,650,710,730,740
641 GOTO 750
649 'LOOP UNTIL FOUND
650  FOR TEMP=0TO9:
          IF XY(WHO-1,TEMP)<> LY*64+LX
              THEN NEXT TEMP:
                   GOTO 680
660 ENERGY(WHO-1,TEMP)=ENERGY(WHO-1,TEMP)-DAMAGE
670 IF ENERGY(WHO-1,TEMP)<=0 THEN GOSUB DESTROYED
680 GOTO 750
710 FOR TEMP =0 TONM:
        IF MXY(TEMP)<> LY*64+LX
            THEN NEXT TEMP:
                 GOTO 725
720 MENERGY(TEMP)=MENERGY(TEMP)-DAMAGE/2
722  IF MENERGY(TEMP)<0 THEN MENERGY(TEMP)=0
725 GOTO 750
730 FOR TEMP=0 TO D1+D2:
        IF DXY(TEMP)<>LY*64+LX
            THEN NEXT TEMP:
                 GOTO 738
733 DENERGY(TEMP)=DENERGY(TEMP)-DAMAGE
735 IF ENERGY<=-5 THEN GOSUB DESTROYED
738 GOTO 750
740 'WALL
750 VA=1
760 GOTO 4000
800 'GOTO
805 FLAG=FLAG-.15
810 FOR TEMP=1 TO LEN(PR$)-1
820   IF MID$(PR$,TEMP,1)="#" THEN IF VAL(MID$(PR$,TEMP+1,LEN(PR$))) = VALUE THEN MP= TEMP+LEN(STR$(VA))+1:GOTO850
830 NEXT TEMP
840 VA=1
850 GOTO 4000
1000 ' HALT  STOPS THE TILL THE NEXT TURN
1010 IF VA>=1 
         THEN FLAG=0:
              VA=VA-1:
              MP=MP-2
1020 GOTO 4000
1200 'IF
1210 GOSUB 370:'GOSUB INSTR
1220 GOSUB 5000:'CALL WHO
1230 IF (IN$="EN" AND WHO=2-TEAM)OR(IN$="CL"ANDWHO=0) OR
        (IN$="AL"AND WHO=TEAM+1)OR (IN$="MI"ANDWHO=3) OR
        (IN$="DE"ANDWHO=4)OR(IN$="WA"AND WHO=5)
        THEN  800 
        ELSE VA=1:
             GOTO4000
1400 'J?
1600 'K?
1800 'LOOK
1810 IN$=RIGHT$(IN$,1)
1820 IFNOT( IN$="N"ORIN$="S"OR IN$="E"ORIN$="W" )THEN 1840 ELSE IF IN$="N"THENTX=0:TY=-1 ELSEIF IN$="S"THENTX=0:TY=1ELSEIFIN$="W"THENTX=-1:TY=0ELSEIFIN$="E"THENTX=1:TY=0
1830 GOTO 1850
1840 IF IN$="F"THENTX=CX:TY=CY ELSEIFIN$="B"THENTX=-CX:TY=-CY ELSE IFIN$="R"THENTEMP=ABS(.5-SGN(CY))*-2:TY=CX*TEMP:TX=CY*TEMP ELSE IFIN$="L"THENTEMP=ABS(.5-SGN(CX))*-2:TY=CX*TEMP:TX=CY*TEMP ELSE TY=0:TX=0
1850 LX=X+TX*VA:LY=Y+TY*VA
1860 VA=1
1880 GOTO 4000
2000 'MOVE
2010 IF LX=X AND LY=Y 
         THEN 2100
         ELSE IF VA>=1 
              THEN FLAG=0
                   MP=MP-2
2020 CX=SGN(LX-X):
     CY=SGN(LY-Y):
     IF VA<1
         THEN 2100
         ELSE TEMP=LY*64+LX:
              LX=X+CX:
              LY=Y+CY :
              VA=VA-1
2030 GOSUB 5000:'WHAT,WHO
2040 IF WHO=0 OR WHO=4 
        THEN X=LX:
             Y=LY
2045 LY=INT(TEMP/64):
      LX=TEMP-LY*64
2050 IF WHO<>4 THEN 2100
2060 FOR TEMP=0 TO NM:
          IF MXY(TEMP)<>LY*64+LX
2070 ENERGY=ENERGY-MENERGY(TEMP)*4:
     MXY(TEMP)=MXY(NM):ME(TEMP)=ME(NM):
     MN=MN-1:
     IF MN<0
        THEN MN=0
2080 IF ENERGY<0 THEN GOSUB DESTROYED
2100 GOTO 4000
2200 'N?
2400 'O?
2600 'P?
2800 'Q?
3000 REM    RE  THE  COMMAND TO SET EP=1 AND PP TO START
3010 MP=1
3020 GOSUB 370
3030 IF IN$<>"BE" AND MP<LEN(PROGRAM$)+1 THEN 3020
3040 IF MP>LEN(PROGRAM$) THEN MP=RND( LEN(PROGRAM$))
3050 VA=VA(TEAM,TA,1):LY=INT(LXY(TEAM,TA,1)/64):LX=LXY(TEAM,TA,1)-LY*64
3100 RETURN
3115 GOSUB 5000:'WHO
3200 'SET MINE
3210 IF ENERGY>=VA 
         THEN ENERGY=ENGRGY-VA 
         ELSE VA=ENERGY:
              ENERGY=0:
              GOSUB DESTROYED
3240 LX=X+SGN(LX-X):LY=Y+SGN(LY-Y)
3250 GOSUB 370:' WHOPRINT
3255 IF WHO>3 THEN 3300
3260 IF MN>=50 THEN 3390
3270 NM=NM+1:
      MENERGY(NM)=VA:
      MXY(NM)=LY*64+LX
3290 POKE 15360+LX+LY*64,ASC("#"):'PUT A MINE DOWN
3300 FLAG=0
3390 VA=1:
      GOTO4000
4000 RETURN
5000 ' SUB TO RETURN WHAT THE ASC OF THE CHAR AT LX,LY
        AND WHO 0 FOR FREE,1 TEAM0, 2TEAM0,3MINE,4 DEST,5WALL
5005 IFLX<0 OR LX>63 OR LY<0 OR LY>15 THEN WHAT=191:WHO=5:GOTO5100
5010 WHAT=PEEK(15360+LX+LY*64)
5020 IF WHAT<=32 THEN WHO=0 ELSEIFWHAT<=47 THEN WHO=3 ELSE IF WHAT<=57 THEN WHAT=1 ELSEIFWHAT<=75 THEN WHO=2 ELSE IF WHAT<=95 THEN WHO=4 ELSE WHO=5
5100 RETURN
5500 REM SET-UP    GETS ENERGY,PROGRAM,PP,EP,X,Y,LX,LY,CX,CY,VA
5510 ENERGY=ENERGY(TEAM,TA)
5520 PROGRAM$=PROGRAM$(TEAM,TA)
5530 PP=PP(TEAM,TA)
5540 EP=EP(TEAM,TA)
5550    Y=INT( XY(TEAM,TA)/64 )
5560    X=XY(TEAM,TA)-Y*64
5570    LY=INT( LXY(TEAM,TA,1)/64)
5580    LX= LXY(TEAM,TA,1)-LY*64
5590    CY=INT( CXY(TEAM,TA)/64)
5600    CX= CXY(TEAM,TA)-CY*64
5605 GOSUB 5000:'FIND WHO
5610 VA=VA(TEAM,TA)
5620 FOR TEMP=1TO10:T2=PEEK(15360+X+Y*64):POKE 15360+X+Y*64,ASC(" "):T1=1[1[1[1[1:POKE(15360+X+Y*64,T2):NEXT TEMP
5630 RETURN
5700 ENERGY(TEAM,TA)=ENERGY
5710 PROGRAM$(TEAM,TA)=PROGRAM$
5720 PP(TEAM,TA)=PP
5730 EP(TEAM,TA)=EP
5740 XY(TEAM,TA)=Y*64+X
5750 LXY(TEAM,TA,PE)=LY*64+LX
5760 CXY(TEAM,TA)=CY*64+CX
5770 VA(TEAM,TA)=VA
5780 RETURN
7000 REM   SET UP DATA STUCTURE
7010 DIM PROGRAM(1,9),ENERGY(1,9),VA(1,9),LXY(1,9),CXY(1,9),       XY(1,9),PP(1,9),EP(1,9)
7020 DIM MXY(50),MENERGY(50)
7040 D1=0:D2=0
      :NM=0
7100 RETURN
20000 SUB DESTROYED  GIVEN WHO,AND TEMP IT PUTS THEM
        ON THE LIST OF DESTROYED AND MARKS WITH AN X
