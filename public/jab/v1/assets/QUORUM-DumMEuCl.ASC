1 CLS:PRINTTAB(20)"QUORUM IN SPACE":PRINT:PRINT
10 DEFINTM,C,F,N,Y,X,O,K
20 DIMV(5),M(2),T(2),C(5),F(2)
30 PRINT"WELCOME TO ARGYLE 88!!":PRINT
40 PRINT"YOU ARE ABOUT TO JOIN THE ARGYLE 88 PLANETARY COUNCIL."
45 PRINT"YOUR MISSION IS GAIN WEALTH"
50 PRINT"THERE ARE FOUR OTHER MEMBERS - YOU ARE #5."
60 RANDOM
70 FORI=1TO5:V(I)=1000*RND(0)+50:NEXT
80 M(1)=2:M(2)=2:N=0
90 F(1)=1:F(2)=3:P2=.2:R2=.3
100 T(1)=V(1)+V(2):T(2)=V(3)+V(4)
110 C(1)=1:C(2)=1:C(3)=2:C(4)=2
120 C(5)=0
130 PRINT:PRINT"YOU ARE WORTH"V(5)
135 GOSUB2000
140 GOSUB930
150 PRINT:INPUT"WHICH COALITION DO YOUR WISH TO JOIN: 1 OR 2";Y
160 IFY=1THENO=2:GOTO 190
170 IFY<>2THENINPUT"REPLY 1 OR 2";Y:GOTO160
180 O=1
190 INPUT"AS CHIEF (C) OR MEMBER (M)";A$
200 IFA$="C"THEN F(Y)=5:GOTO220
210 IFA$<>"M"THENINPUT"REPLY C OR M";A$:GOTO220
220 IF T(O)=T(Y)+V(5)THENV(5)=1000*RND(0)+50:GOTO220
230 T(Y)=T(Y)+V(5):M(Y)=M(Y)+1
240 C(5)=Y
250 X=X+1
255 IFX>15THENPRINT"CONGRATULATIONS, YOU HAVE SURVIVED 15 CONFRONTATIONS." :PRINT"YOU MAY NOW RETIRE.:PRINT:GOTO880
258 CLS
259 IFT(Y)>T(O)THEN270
260 PRINT"YOU LOST THE GAMBLE. OTHER SIDE NOW CONTROLS WEALTH.":R=R2:W=O:L=Y:P=P2:GOTO330
270 PRINT"SUCCESS! YOUR SIDE NOW CONTROLE THE MAJORITY OF WEALTH.":W=Y:L=O
280 IFF(Y)<>5THENR=R2:P=P2:GOTO330
290 INPUT"WHAT % DO YOU DEMAND FOR PAYMENT FROM LOSING COALITION";R
300 IFR<10ORR>90THENINPUT"RANGE IS 10 TO 90";R:GOTO300
310 INPUT"WHAT BONUS % TO YOU AS CHIEF";P
320 IFP<10 ORP>50THENINPUT"RANGE IS 10 TO 50";P:GOTO320
322 R=R/100:P=P/100
330 R1=R*T(L):B=P*R1
335 PRINT"TOTAL PAYMENY:"R1" BOUNUS TO CHIEF:  ";B
340 IFM(W)=1THENB2=R1:B=0:GOTO380
350 B1=R1/M(W)
360 B2=B/(M(W)-1):B=.1*R1:B3=B1-B2
370 FORI=1TO5:IFC(I)=WTHEN V(I)=V(I)+B3:NEXTIELSENEXTI
380 I=F(W):V(I)=V(I)+B2+B
390 IFM(L)=1THENI=F(L):V(I)=V(I)-R1:GOTO530
400 B1=R1/M(L):B=.1*R1
410 B2=B/(M(L)-1):B3=B1+B2
420 FORI=1TO5:IFC(I)<>LTHENGOTO530
430 V(I)=V(I)-B3
440 IFV(I)>0THENGOTO510
450 IFI=5THENPRINT"YOU HAVE LOST ALL WEALTH AND MUST LEAVE COUNCIL":GOTO870
460 M(L)=M(L)-1:C(I)=0
470 PRINTI"HAS LOST ALL WEALTH AND MUST LEAVE THE COUNCIL."
480 IFV(I)=0THENGOTO510
485 IF M(L)=0THEN510
490 V1=-V(I)/M(L)
500 FORJ=1TO5:IFC(J)=LTHENV(J)=V(J)-V1:NEXTELSENEXT
510 NEXTI
520 I=F(L):V(I)=V(I)+B2+B
530 T(W)=T(W)+R1:T(L)=T(L)-R1
540 GOSUB930
545 PRINT@384,"CONFRONTATION";:PRINT@448,"NUMBER"X;:PRINT@0,"";:GOSUB2010
550 K=0
560 IFW=YTHENGOTO700
570 'LOST
580 INPUT"SPECIFY # OF OPPOSITION MEMBER YOU WANT";J
590 IFJ<1 OR J>5THEN INPUT "RANGE IS 1 TO 5";J:GOTO590
600 IFC(J)=0THENINPUT"OUT OF COUNCIL -- CHOSE AGAIN";J:GOTO590
610 IFC(J)=YTHENPRINT"ALREAD IN YOUR COALITION":GOTO580
620 INPUT"WILL YOU MAKE HIM CHIEF";A$
630 IFLEFT$(A$,1)="Y"THEN790
640 IFLEFT$(A$,1)<>"N"THENINPUT"REPLY YES OR NO";A$:GOTO620
650 IFT(W)-V(J)<T(L)+V(J)THENGOTO800
660 INPUT"HE WILL ONLY COME AS CHIEF - WILL YOU MAKE HIM CHIEF";A$
670 IFLEFT$(A$,1)="Y"THENGOTO790
680 IFLEFT$(A$,1)<>"N"THENINPUT"REPLY YES OR NO";A$:GOTO670
690 GOTO580
700 'WON
710 GOSUB1070:IFJ=0THENGOTO870
720 PRINT"OPPOSITION WOULD LIKE"J"TO JOIN THEM."
730 IFK<>0THENGOSUB2000:GOTO790
740 INPUT"WILL YOU MAKE HIM CHIEF TO KEEP HIM";A$
750 IFLEFT$(A$,1)="N"THEN790
760 IFLEFT$(A$,1)<>"Y"THENINPUT"REPLY YES OR NO";A$:GOTO750
770 IFK=0THENK=J:F(W)=J:GOTO710
780 'STATS
790 F(L)=J
800 IFF(W)=JTHENGOSUB1120
810 IFJ=5THENY=L:O=W
820 C(J)=L
830 M(W)=M(W)-1:T(W)=T(W)-V(J)
840 M(L)=M(L)+1:T(L)=T(L)+V(J)
850 IFM(1)>0ANDM(2)>0THENGOTO250
860 PRINT"ALL MEMBERS ARE IN ONE COALITION!"
870 PRINT"SO LONG":PRINT:PRINT
880 INPUT"WOULD YOU LIKE TO PLAY AGAIN";A$
890 IFLEFT$(A$,1)="Y"THENRUN1
900 IFLEFT$(A$,1)<>"N"THENINPUT"REPLY YES OR NO";A$:GOTO890
910 GOTO1180
920 'TABLE
930 X$=" "
940 FORI=1TO2
950 PRINT:PRINT,"      COALITION       #"I
960 C1=F(I)
970 PRINT,"MEMBER","VALUE"
980 FORJ=1TO5
990 IFC(J)<>ITHENGOTO1030
1000 IFJ=C1THENX$="CHIEF"
1010 PRINT,J,V(J),X$
1020 X$=" "
1030 NEXTJ
1040 PRINT,"TOTAL VALUE=" T(I): J=J+1:NEXTI
1050 RETURN
1060 'CHANGE
1070 IFM(W)>1THEN1090
1080 PRINT"WINNING COALITION ONLY HAS ONE MEMBER -- GAME MUST END"
1081 J=0:RETURN
1090 N=N+1:IFN=6THENN=1
1100 IFC(N)<>W OR F(W)=N THEN1090
1110 J=N:RETURN
1120 'NEW CHIEF
1130 V1=0:I1=0:FORI=1TO5
1140 IFC(I)<>W ORJ=I THEN 1160
1150 IFV(I)>V1 THEN I1=I:V1=V(I)
1160 NEXTI:F(W)=I1
1170 RETURN
1180 END
2000 PRINT@15*64,"    PRESS (ENTER) TO CONTINUE";
2010 IFINKEY$=""THEN2010ELSECLS:RETURN
