10 '            GETTAPE
20 '            -------
30 'PROGRAM TO COPY TAPE FILES BACK ONTO DISK
40 '
50 CLEAR 1500
60 DEFSTR D-F: DEFINT I: DIM D(4)
70 CLS
80 FV=""
90 FOR I=24003 TO 24005: FV=FV+CHR$(PEEK(I)):NEXT
100 IF FV="1.1" THEN IV=26228 ELSE IV=0
110 PRINT@6*64,"THIS PROGRAM COPIES A TAPE DATA FILE TO DISK.
120 PRINT"THE TAPE MUST BE CREATED BY THE 'GETDISK' PROGRAM.
130 PRINT"PREPARE THE RECORDER TO PLAY THE TAPE.
140 INPUT"PRESS <ENTER> WHEN READY";F
150 CMD"T": INPUT #-1,F,I1,I5: CMD"R"
160 CLS: PRINT@6*64,"FILE WILL BE NAMED "F
170 PRINT"THIS TAPE CONTAINS RECORDS"I1"THROUGH"I5
180 OPEN"R",1,F
190 IF IV=26228 THEN FIELD 1, 255 AS D
    ELSE FIELD 1, 255 AS D, 1 AS DE
200 FOR I2=I1 TO I5
210   PRINT@655,"READING RECORD #"I2
220   CMD"T"
230   FOR I3=1 TO 4
240     INPUT#-1,D(I3)
250   NEXT I3
260   CMD"R"
270   PRINT@655,"PROCESSING REC #"I2
280   IP=1: DT=""
290   FOR I3=1 TO 255
300     IS=INT((I3-1)/64)+1
310     DB=CHR$(VAL(MID$(D(IS),IP,3)))
320     DT=DT+DB: IP=IP+3: IF IP=193 THEN IP=1
330     IF LEN(DT)=255 THEN I3=255
340   NEXT I3
360   PRINT@655,"WRITING RECORD #"I2
370   LSET D=DT
375   IF IV=26228 THEN POKE IV,VAL(RIGHT$(D(4),3))
       ELSE LSET DE=CHR$(VAL(RIGHT$(D(4),3)))
380   PUT 1,I2
390 NEXT I2
400 CLOSE
410 PRINT"ALL DONE--RECORDS"I1"THROUGH"I5"ARE WRITTEN."
420 PRINT"LOAD ANOTHER TAPE (IF ANY) AND RUN AGAIN."
430 END
