1 GOTO1000
40 PI=3.14159
50 INPUT"WEIGHT OF BODY";C
60 INPUT"ANGLE A AND B";S,T
80 S=S/180*PI:T=T/180*PI
90 A=SIN(S):B=SIN(T)
100 D=COS(S):E=COS(T)
110 BB=C/(A+B*D/-E)
120 AA=-D/E*BB
130 PRINT"TENSION ON ROPE A=";BB
140 PRINT"TENSION ON ROPE B=";AA
150 END
1000 PRINT"FIND ANGLE FROM SIDES    ----A----"
1010 PRINT"                         !       /
1020 PRINT"                         C     B
1030 PRINT"                         1   /
1040 PRINT"                         1/
1044 DEF FNA(X)=-ANT(X/SQR(-X*X+1))+1.5708
1045 DEF FNC(B,A,C)=FNA(B[2-A[2-C[2/-2*C*A)
1050 INPUT"LENGTH OF A,B,C";A,B,C
1060 SA=FNC(A,B,C)
1070 SB=FNC(B,A,C)
1080 SB=FNC(C,A,B)
1090 PRINTSA,SB,SC
