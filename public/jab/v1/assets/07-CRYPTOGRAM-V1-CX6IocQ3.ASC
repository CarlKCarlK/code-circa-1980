5 CLEAR 5000:CLS
7 DIM E(26):READ C$:FORI=1TO26:E(I)=ASC( MID$(C$,I,1) )-64 :NEXT I
10 READ C$
15 DIM C(26),D(26)
20 FOR T=ASC("A") TO ASC("Z")
25 Z$=" "+CHR$(T)+" "
30 FOR I=1TOLEN(C$)
40 IF MID$(C$,I,1)=CHR$(T) THEN C(T-64)=C(T-64)+1
45 PRINT@I,MID$(C$,I,1);Z$;
50 NEXT I
65 D(T-64)=T-64:PRINTC(T-64);
70 NEXT T
80 CLS
90 PRINT"SORTING"
100 FOR I=1TO 26
110 FOR P=ITO26
120 IF C(I)< C(P) THEN H=C(P):C(P)=C(I):C(I)=H:H=D(P):D(P)=D(I):D(I)=H
130 NEXT P,I
150 CLS:PRINT"MORE SORTING"
160 FOR I = 1 TO 26 : FOR P = I TO 26
170 IF D(I) > D(P) THEN H=D(P):D(P)=D(I):D(I)=H:H=E(P):E(P)=E(I):E(I)=H
180 NEXTP:C(I)=0:NEXT I
185 CLS:D$="":FOR I=1TOLEN(C$):CC$=MID$(C$,I,1):IF C(ASC(CC$)-64)>99 THEN D$=D$+CHR$( 64+C(ASC(CC$)-64)/100 ):GOTO 200
190 IFCC$<"A" OR CC$> "Z" THEN D$=D$+CC$ ELSE D$=D$+CHR$( E( ASC(CC$)-64+C(ASC(CC$)-64))+64)
200 PRINT@0,D$;
210 NEXT I
300 PRINT:INPUT "COMMAND ";H$
310 IF H$="HELP"THEN CLS:PRINT"YOU MAY  'FIX', 'UNFIX', 'LIST' OR 'HELP'":PRINT:PRINT:INPUT"PRESS ENTER";H$:GOTO185
320 IF H$<>"FIX" THEN 400
330 PRINT:INPUT" TURN ALL THE A'S INTO B'S. GIVE ME A & B ";A$,B$
990 DATA "EAOIDHNRSTUYCFGLMWBKPQXZJV"
995 DATA"ZYZYZYWWY"
1000 DATA "KP UPRK ULW, LFXLYDLWAL DR QDVL KML RKLYW QDBMKR PT J RMDX, EMDAM DQQGUDWL PWQC KML KYJAVR DK MJR XJRRLN"
