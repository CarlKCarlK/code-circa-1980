5 CLS:INPUT"SPEED";S:A=24:B=64
6 S=S*10:A$="3":GOTO15
7 POKE16553,255
10 FORC=1TOS:NEXT:A$=INKEY$:IFA$=""THEN23
15 IFA$="C"THENCLS
20 FORX=1TOVAL(A$):READZ,Y:NEXTX
23 B=B+Z*2:A=A+Y
25 GOTO110
30 IFPOINT(B,A)ORPOINT(B+1,A)THEN200ELSESET(B,A):SET(B+1,A):RESTORE:GOTO10
40 DATA0,-1,0,1,-1,0,1,0
100 REM
110 IFB>126 THEN B=0
120 IFB<0THENB=B+128
130 IFA>47THENA=A-48
140 IFA<0THENA=A+48
145 G=G+1:PRINT@0,G
150 GOTO30
200 CLS:PRINTCHR$(23):PRINT"BANG - YOU CRASHED!!!!!!"
210 INPUT"DO YOU WANT PLAY AGIAN";S$:IFS$="NO"THENENDELSECLS:RESTORE:G=0:GOTO15
