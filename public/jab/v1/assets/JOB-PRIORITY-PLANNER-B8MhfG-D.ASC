2 CLEAR 1000
5 CLS:PRINT:PRINT:PRINT:PRINT
10 INPUT"HOW MANY JOBS TO YOU HAVE";NJ
15 DIM J$(NJ),P(NJ),TP(NJ)
20 FOR C=1TONJ
30 PRINT"WHAT IS JOB NUMBER"C;
40 INPUT J$(C)
50 INPUT "WHAT PRIORITY IS IT";P(C)
60 NEXT C
70 CLS
80 FOR C=1TO NJ
90 FOR I=1TO NJ
100 IF P(I)>R THEN R=P(I):TR=I
110  NEXT I
120 TP(C)=TR:R=0:P(TR)=-1
130 NEXT C
140 FOR C=1TO NJ
142 CLS
145 PRINT:PRINT:PRINT:PRINT:PRINT:PRINT:PRINT
150 PRINT J$(TP(C))
160 PRINT@960,"                 	     (PRESS ENTER FOR NEXT)";
170 IFINKEY$=""THEN170
180 NEXT C
190  CLS:PRINT"GO PLAY!!!!!!!!"
