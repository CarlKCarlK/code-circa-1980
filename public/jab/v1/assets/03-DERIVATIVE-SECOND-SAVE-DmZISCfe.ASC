10 CLEAR 150:CLS
20 PRINT:PRINT"THIS FINDS THE DERIVATIVE OF A FUNCTION OF THE FORM : "
25 PRINT
30 PRINT"        3X[4+ 0X[3 +2X[2+ -6X[1 +5X[0
40 PRINT"F(X)=  -------------------------------------"
50 PRINT"      6X[3+ -8X[2 + 0X[2+ 1X[1 +4X[0
60 PRINT
65 NP=2:DP=1
70 INPUT"WHAT IS THE HIGHEST POWER OF THE VARIABLE IN THE TOP";NP
80 INPUT"WHAT IS THE HIGHEST POWER OF THE VARIABLE IN THE BOTTON";DP
90 PRINT
94 GP=NP:IF DP>GP THEN GP=DP
95 DIM N(NP),D(DP),F(GP,GP),S(GP,GP),T(2*GP,2*GP),A(NP,NP),C(NP,NP),E(DP,DP),B(DP,DP),G(2*GP,2*GP+1),H(NP+DP,DP+NP),J(2*GP,GP*2)
100 PRINT@448,STRING$(128," ")
110 PRINT@448,"FIRST THE TOP....":FORXX=1TO4:NEXTXX
120 FOR P=NPTO0 STEP -1
125 PRINT@512,STRING$(64," ")
130 PRINT@512,"WHAT IS THE COEFFICENT ON THE X["P" TERM ";
140 INPUT N(P)
150 NEXT P
160 PRINT@448,"NOW THE BOTTON....":FORXX=1TO4:NEXTXX
170 FOR P=DP TO 0 STEP -1
180 PRINT@512,STRING$(64," ")
190 PRINT@512,"WHAT IS THE COEFFCENT ON THE X["P" TERM";
200 INPUT D(P)
210 NEXTP
220 CLS:PRINT
235 F$="X":M$="F(X) =":L$="":L2$="	":GOSUB 240:GOTO360
240 PRINTSTRING$(LEN(L$+M$)," ");:FOR P=NPTO0 STEP-1
245 IF P=0 AND N(P)=0 THEN PRINTSTRING$(3,CHR$(24));"   ":GOTO280
250 IF N(P)=0 THEN 280
255 IF P=0 THEN PRINTN(P):GOTO280
260 PRINTN(P)F$"["P" + ";
280 NEXT P
290 PRINTM$;" "L$;STRING$((NP+1)*11,"-")
300 PRINTSTRING$(LEN(M$)," ");L2$" "; 
310 FOR P=DP TO 0 STEP -1
320 IF P=0 AND D(P)=0 THEN PRINTSTRING$(3,CHR$(24));"   ":GOTO 350
330 IF D(P)=0 THEN 250
335 IF P=0 THEN PRINTD(P):GOTO 350
340 PRINTD(P)F$"["P" + ";
350 NEXT P
355 RETURN
360 PRINT
365 A$="-"+CHR$(94)
370  PRINT"              F(X+H) + F(X)"
380 PRINT"F'(X)=  LIM  ---------------"
390 PRINT"       X"A$"0        H"
400 PRINT
410 F$="(X+H)":M$="F'(X) =":L$=" LIM ":L2$="H -"+CHR$(94)+"0":GOSUB240
420 PRINT" - (MINUS)"
430 F$="X":M$="":L$="":L2$="":GOSUB240
440 PRINTSTRING$(63,"="):PRINTTAB(32)"H"
450 PRINT
460 REM NOW PRINT OUT #4
465 PRINT:PRINT"F'(X) = LIM":PRINT"       H-"CHR$(94)"0":PRINT
470 REM C THEN D THEN A, THEN B
480 FOR POWER=0TONP:C(POWER,0)=N(POWER):NEXT POWER
490 FOR POWER=0TODP:E(POWER,0)=D(POWER):NEXT POWER
495 FOR POWER=NPTO0STEP-1
500 FOR XI=POWER TO 0 STEP -1:HI=POWER-XI
510 R=POWER:C=XI:GOSUB2000:' GOING TO BINOMIAL COEFFICENT SUB
520 A(XI,HI)=N(POWER)*A
530 NEXT XI,POWER
540 FOR POWER =DPTO0STEP-1
550 FOR XI=POWER TO 0 STEP -1:HI=POWER-XI
560 R=DP:C=XI:GOSUB2000
570 B(XI,HI)=D(POWER)*A
580 NEXT XI,POWER
630 FOR POWER=NPTO0 STEP -1:  FOR P2=NP TO 0 STEP -1
635 IF A(POWER,P2)=0 THEN 680
640 IF POWER=0 AND P2=0 THEN PRINTA(POWER,P2)" +";:GOTO680
650 IF POWER=0 THEN PRINTA(POWER,P2);" (H["P2") +";
660 IF P2=0    THEN PRINTA(POWER,P2);" (X["POWER") +";
670 IF P2<>0 AND POWER<>0 THEN PRINTA(POWER,P2);" (X["POWER"H["P2") +";
680 NEXTP2,POWER:PRINTCHR$(24);" "
690 PRINTSTRING$(60,"-")
700 FOR POWER=DPTO0 STEP-1: FOR P2=DP TO 0 STEP -1
705 IF B(POWER,P2)=0 THEN 800
710 IF POWER=0 AND P2=0 THEN PRINTB(POWER,P2)" +";:GOTO800
720 IF POWER=0 THENPRINTB(POWER,P2);" (H["P2") +";
730 IF P2=0  THEN PRINTB(POWER,P2);" (X["POWER") +";
750 IF P2<>0 AND POWER <>0 THENPRINTB(POWER,P2);" (X["POWER"H["P2") +";
800 NEXT P2,POWER:PRINTCHR$(24);" "
810 PRINT" -  (MINUS)"
820 F$="X":M$="":L$="":L2$="":GOSUB240
830 PRINTSTRING$(63,"="):PRINTTAB(30);" H"
840 REM
850 REM NOW PART # 5
860 PRINT:PRINT:PRINT"F'(X) = LIM":PRINT"        H-"CHR$(94)"0":PRINT
870 FOR XF=0TO NP:FORHF=0TONP:FORXS=0TODP:FORHS=0TODP
880 G(XF+XS,HF+HS)=G(XF+XS,HF+HS)+A(XF,HF)*E(XS,HS)
890 H(XF+XS,HF+HS)=H(XF+XS,HF+HS)+C(XF,HF)*B(XS,HS)
900 NEXT HS,XS,HF,XF
910 FOR XF=0TODP:FORHF=0TODP:FORXS=0TODP:FORHS=0TODP
920 J(XF+XS,HF+HS)=J(XF+XS,HF+HS)+B(XS,HS)*E(XF,HF):NEXTHS,XS,HF,XF
925 KK=1:GOSUB930:PRINT:PRINT" - (MINUS)":PRINTCHR$(183);:KK=2:GOSUB930:PRINTCHR$(187):GOTO1000
930 FOR POWER = NP+DP TO 0 STEP-1:FOR P2=NP+DPTO0STEP-1
940 IF KK=1 THEN KS= G(POWER,P2) ELSE KS=H(POWER,P2)
950 IF KS=0 THEN 990
960 IF POWER=0 AND P2=0 THENPRINTKS" +";:GOTO990
965 IF POWER=0 THENPRINT KS;" (H["P2") +";
970 IF P2=0 THEN PRINTKS;" (X["POWER") +";
975 IF P2<>0 AND POWER<>0 THEN PRINTKS;" (X["POWER"H["P2") +";
990 NEXTP2,POWER:PRINTCHR$(24);" ";
995 RETURN
1000 PRINTSTRING$(60,"-")
1010 FOR POWER=DP*2TO0STEP-1:FORP2=DP*2TO0STEP-1
1015 IF P2>0 AND K3=2THEN 1080
1020 KS=J(POWER,J2)
1030 IF KS=0 THEN 1080
1040 IF POWER=0 AND P2=00 THEN PRINTKS" +";:GOTO1080
1050 IFPOWER=0 THEN PRINTKS;" (H["P2") +";
1060 IF P2=0 THEN PRINTKS;" (X["POWER") +";
1070 IF P2<>00 AND POWER<>0 THEN PRINTKS;" (X["POWER"H["P2") +";
1080 NEXTP2,POWER:PRINTCHR$(24);" "
1085 IF K3=1 THEN 1220ELSE IF K3=2 GOTO 1240
1090 PRINTSTRING$(63,"=")
1100 PRINTTAB(30)"H"
1102 PRINT:PRINT
1105 IF KK=1 THEN1200
1110 REM
1120 REM NOW PART # 6
1130 REM ADD H TO G
1140 FOR POWER=0TONP+DP:FORP2=0TONP+DP:G(POWER,P2)=G(POWER,P2)-H(POWER,P2):NEXTP2,POWER
1150 PRINT:PRINT"F'(X) =  LIM":PRINT"        H-"CHR$(94)"0":PRINT
1160 KK=1:GOSUB930:PRINT:GOTO1000
1200 FOR POWER=0TONP+DP:FORP2=0TONP+DP-1:G(POWER,P2)=G(POWER,P2+1):NEXTP2:G(POWER,NP+DP)=0:NEXTPOWER
1205 PRINT:PRINT
1210 K3=1:KK=1:GOSUB930:PRINT:GOTO1000
1220 FORPOWER=0TONP+DP:FORP2=1TOGP*2:G(POWER,P2)=0:NEXTP2,POWER
1230 K3=2:KK=1:GOSUB930:PRINT:GOTO1000
1240 STOP
2000 REM SUBROUTINE TO FIND     BINOMAL COEFFICINETS
2010 REM        IN GOES     ROW AND COLLUM
2030 REM       OUT GOES     BINOMAL COEFFICINT       
2040 REM     (R,C)   >>>>>  A
2050 A=1:D=R-C:IFD>C THEN H=C:C=D:D=H
2060 Y=D+1:X=R-D
2070 X=X+1:Y=Y-1:IF Y>=1 THEN A=A/Y
2080 IF X<=R THEN A=A*X
2090 IF Y>=1 AND X<=R THEN 2070
2100 REM   A COMES OUT
2110 RETURN
