10 CLS
20 XX=127:YY=47
30 P=1
40 DX=30:DY=15:DZ=.5
50 PI=ATN(1)*4:E=EXP(1)
60 S=1/3
80 FOR A=1TO 2:IFA=1THEN FOR Z=1TO-1STEP -S:FORX=1TO-1STEP -S
             ELSE     FOR X=1TO-1STEP -S:FORZ=1TO-1STEP -S
90 Y=0
100 GX=XX/2+X*DX-Z*DX*DZ
110 GY=YY/2-Y*DY+Z*DY*DZ
120 IF GX<0 OR GX>XX OR GY<0 OR GY>YY THEN 180  
130 IF P=1 THEN OX=GX:OY=GY
150 GOSUB 1000
160 OX=GX:OY=GY
170 P=0:GOTO190  
180 P=1
190 IF A=1THEN NEXTX:P=1:NEXTZ
200 IF A=2THEN NEXTZ:P=1:NEXTX
210 NEXTA
220 PRINT@0,"D";
230 GOTO 230  
1000 D=SQR( (GX-OX)[2+(GY-OY)[2)
1002 IF D=0 THEN SET(GX,GY):GOTO1040
1005 SX=(GX-OX)/D:SY=(GY-OY)/D
1010 FOR DD=1TOD
1020 SET(  DD*SX+OX+.5,DD*SY+OY+.5)
1030 NEXTDD
1040 RETURN
