2 CLEAR 1000
5 GOTO120
10 CLS
20 FORY=1TO4:CLS
40 PRINT@448,"BEST TEAM ??????"
50 FORX=1TO500:NEXTX
60 CLS
70 PRINT@448+32,"SPEECH TEAM !!!!!!!"
80 FORX=1TO500:NEXTX
90 NEXT Y
92 CLS
95 PRINT@1000,"";
110 FORY=1TO1000:PRINT"YA!  ";:NEXT
120 CLS
130 PRINT@448,"HOW MANY COACHES (PLAYERS) WILL PARTICAPATE";
140 INPUT P
145 DIM T$(P,1)
150 CLS
160 PRINT@448,"NOW I WILL GO THOUGH ALL THE TEAMS PLEASE TELL ME THE SCHOOL    NAME AND COACHES NAME (MAKE'EM  UP IF YOU WISH!)"
165 FORX=1TO3000:NEXT
170 FOR I=1TO P
180 CLS
190 PRINT@448,"COACH #"I", WHAT IS YOUR NAME";
200 INPUT T$(I,0)
210 CLS:PRINT@448,"COACH "T$(I,0)", WHAT IS THE NAME OF YOUR SCHOOL";
220 INPUT T$(I,1)
230 NEXT I
240 CLS
250 FOR X=1 TO 3
255 EV$(X)=""
260 RESTORE
270 DATA"EXTEMPORANCE","DUET","HUMOROUS","DRAMATIC","RADIO",   "ORGINAL","VERSE","PROSE","ORITORICAL"
280 DATA"SPEAKING","ACTING","READING"
290 L=RND(4)
300 FORY=1TOL
310 RESTORE
320 R=RND(9)
330 FOR K=1TOR:READ TM$:NEXTK
610 IF INKEY$=""THEN610
936 IF INSTR(EV$(X),TM$)=0THENEV$(X)=EV$(X)+" "+TM$
350 NEXT Y
360 RESTORE:R=RND(3):FORY=1TO9+R:READTM$:NEXTY
370 EV$(X)=EV$(X)+" "+TM$
380 NEXT X
390 PRINT:PRINT:PRINT:PRINT:PRINT:PRINT"THE EVENTS ARE :"
400 FORX=1TO3:PRINT"  "EV$(X):NEXTX
410 PRINT:PRINT:PRINT
420 FORX=1TO3000:NEXTX
425 DIM Q(3,4)
430 FORX=1TO3
440 FORY=1TO4
450 Q(X,Y)=RND(0)
460 NEXT Y,X
470 CLS:PRINT"NOW WILL GO THOUGH THE EVENTS ONE AT A TIME."
480 FORX=1TO1000:NEXT
490 FORX=1TO3
500 CLS:PRINT:PRINT:PRINT"EVENT:  "EV$(X):PRINT:PRINT
502 PRINT"EVENT","AMOUNT OF TALENT NEEDED"
504 PRINT"-----","-----------------------"
510 PRINT"EMPATHY           ",
520 Q=Q(X,1):GOSUB800
530 PRINT"VOCAL QUAILITY     ",
540 Q=Q(X,2):GOSUB800
550 PRINT"INTELLIGENCE       ",
560 Q=Q(X,3):GOSUB800
570 PRINT"LACK OF INHIBITION ",
580 Q=Q(X,4):GOSUB800
600 PRINT@960,"PRESS ENTER WHEN READY";
610 IFINKEY$=""THEN610
700 NEXT X:GOTO900
800 'REM 
820 IF Q>.8THENPRINT"EXCELLENT":GOTO890
830 IF Q>.7THENPRINT"VERY GOOD":GOTO890
840 IFQ>.6THENPRINT"PRETTY GOOD":GOTO890
850 IFQ>.5THENPRINT"GOOD":GOTO890
860 IFQ>.4THENPRINT"FAIR":GOTO890
870 IF Q>.3THENPRINT"POOR":GOTO890
880 IF Q>.2THENPRINT"BAD":GOTO890
882 IF Q>.1THENPRINT"VERY BAD":GOTO890
884 PRINT"TERRIBLE"
890 RETURN
