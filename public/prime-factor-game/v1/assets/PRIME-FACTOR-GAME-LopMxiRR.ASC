2 CLS:PRINT"I'M GETTING READY"
5 DIM P(25)
7 P=1:P(P)=2
10 FOR I=2TO100
20 FOR N=2 TO SQR(I)
30 IF INT(I/N)<>I/N AND N<>I THEN NEXT N:P=P+1:P(P)=I
40 NEXTI
50 CLS
60 INPUT"GIVE ME A NUMBER";N
65 GOSUB2000
70 IF N=1 THEN 60
75 GOSUB2000
80 FOR I=1TO25:R=RND(24):H=P(R):P(R)=P(I):P(I)=H:NEXTI
85 GOSUB2000
90 FOR I=1TO25:IF N/P(I) <> INT( N/P(I)) THEN NEXT I:PRINT"TOO BIG FOR ME":END
95 GOSUB2000
100 PRINT"I TAKE OUT "P(I)"."
105 GOSUB2000
110 PRINTN " / "P(I)" = "N/P(I):N=N/P(I)
115 GOSUB2000
117 IF N=1THENPRINT"I WIN !!!!":GOSUB2000:GOSUB2000:GOTO1000
120 PRINT
125 GOSUB2000
133 PRINT"THAT LEAVES "N"."
135 GOSUB2000
140 PRINT
145 GOSUB2000
150 INPUT"WHAT DO YOU TAKE OUT";P
155 GOSUB2000
160 FOR I=1TO25:IF P<>P(I) THEN NEXTI:PRINT"SORRY THAT'S NOT PRIME.":FORX=1TO500:NEXTX:PRINT:GOTO150
165 GOSUB2000
170 IF N/P <>INT(N/P) THEN PRINT"SORRY "P" DOES NOT GO INTO "N".":FORX=1TO500:NEXTX:PRINT:GOTO150
175 GOSUB2000
180 PRINT
185 GOSUB2000
190 PRINTN " / "P" = "N/P:N=N/P
195 GOSUB2000
200 PRINT
205 IF N=1 THEN CLS:FORX=1TO60:CLS:PRINTCHR$(23):PRINTTAB(X)"YOU WIN !!!!":H=24315356[(.355):PRINTCHR$(28):PRINTTAB(X)"YOU WIN !!!!":NEXT X:GOTO1000
210 PRINT"THAT LEAVES "N" FOR ME"
220 GOTO 80
1000 CLS:INPUT"WOULD YOU LIKE TO PLAY AGAIN";A$:IFA$="NO"THEN EEND ELSE 50
2000 FORX=1TO300:NEXTX:RETURN
