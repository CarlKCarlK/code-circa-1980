10 ' CISAB A COMPUTER CHESS GAME IN BASIC
12 DEFINTC,R,B,H
14 PM=120:QQ=1
15 DIM RN(PM),CN(PM),CO(PM),RO(PM),D(PM),R%(PM),V(6)
20 CLS:PRINTCHR$(23)
25 PRINT@398," C I S A B ";
30 FOR R=1TO2:FORC=1TO8:READ B(R,C):NEXTC,R
35 TI=.5
40 RESTORE
50 FOR R=8TO7STEP-1:FORC=1TO8:READ B(R,C):B(R,C)=-B(R,C):NEXTC,R
55 DATA5,4,3,2,1,3,4,5,6,6,6,6,6,6,6,6
56 FOR P=1TO6:READ P$(P):NEXTP:C$(1)=CHR$(143):C$(3)=" ":P$(0)=" -"
57 DATA K,Q,B,N,R,P
58 FOR AA=1TO10:READ A$(AA):NEXTAA:FORV=0TO6:READV(V):NEXTV
59 DATA FOOLISH,DESPERATE,IRRDEEMABLE,LUDICROUS,SERIOCOMIC,DROLL,RIDICULOUS,WHIMSICAL,PREPOSTEROUS,ABSURD
60 CLS
65 DATA .5,100,9,3,3,5,1
70 INPUT"WHAT COLOR ARE WE";A$:CLS:IFLEFT$(A$,1)="W" THEN GOSUB10000:GOTO200
71 C$(3)=C$(1):C$(1)=" ":H=B(8,4):B(8,4)=B(8,5):B(8,5)=H:H=B(1,4):B(1,4)=B(1,5):B(1,5)=H
73 GOSUB10000
80 PRINTCHR$(31);"WHAT WAS THEIR "A$(RND(10))" MOVE (ROW,COLUMB,NEW ROW,COULMB)";:INPUTRO,CO,RN,CN:GOTO90
82 GOSUB10000:GOTO200
90 IF B(RO,CO)<=0 THEN FORAA=1TO40:PRINTCHR$(31);"  **** CHEAT ***** ":NEXTAA:CLS:GOSUB10000:GOTO 80
100 IF B(RN,CN)=-1 THEN PRINT"DAMN THEY BEAT YOU!":END
105 C1=CN:C=CO:R1=RO:R2=RN :GOSUB20000
106 IF B(RN,CN)<>0 THEN PRINTCHR$(31);"OH DAMN!"
107 PRINTCHR$(31);:A$="":INPUT"OK?";A$:IFA$="ADD"THEN 110ELSEIFA$<>"OK"THENGOSUB10000:GOTO80
110 B(RN,CN)=B(RO,CO):B(RO,CO)=0:RN=0:CN=0:RO=0:CO=0:IFABS(B(RN,CN))=6AND RN=8THENB(RN,CN)=SGN(B(RN,CN))*2:RN=0:GOSUB10000
120 IF A$="ADD"THEN8000
200 PRINTCHR$(31);"NOW IT IS OUR TURN                   "
210 GOSUB 2000
279 PM=0
280 FOR R=1TO8:FORC=1TO8
290 IF B(R,C)>=0 THEN 1000
300 IF B(R,C)<>-6 THEN 400:' PAWN JUMP
305 IF SW=1THEN4000
310 IF B(R-1,C-1)>0 AND C-1>=1THEN CN=C-1:RN=R-1:GOSUB3000:IFRN=1THEN QQ=9:GOSUB3000
320 IF B(R-1,C+1)>0 AND C+1<=8THENRN=R-1:CN=C+1:GOSUB3000:IF R=2 THEN QQ=9:GOSUB3000
330 IF B(R-1,C)=0 THEN RN=R-1:CN=C:GOSUB3000:IF R=2 THEN QQ=9:GOSUB3000
335 IF B(R-2,C)=0 AND B(R-1,C)=0 THEN RN=R-2:CN=C:GOSUB3000
340 REM END PAWN
400 PI=3.14159
410 IF B(R,C)=-5THENSP=PI/2:SI=0 ELSE IF B(R,C)=-3 THENSP=PI/2:SI=PI/4ELSEIF B(R,C)=-2 THEN SP=PI/4:SI=0ELSE550
415 FOR A=SITO2*PI-.01 STEP SP
420 FOR M=1TO8
430 RN=INT(COS(A)*M+.5)+R:CN=INT(.5+SIN(A)*M)+C:IF RN<1 OR CN<1 OR CN>8ORRN>8 THEN 500
440 IF B(RN,CN)>0 THEN GOSUB3000:GOTO 500
450 IF B(RN,CN)=0 THEN GOSUB3000
460 IF B(RN,CN)<0 AND SW=0 THEN 500 ELSE GOSUB3000:GOTO500
490 NEXTM
500 NEXT A
550 IF B(R,C)<>-4 THEN 700
560 FOR A=PI/2 TO 2*PISTEP PI/2
570 FOR AF=-1TO1STEP2
580 RN=R+INT(.5+COS(A)*2+AF*SIN(A)):CN=C+INT(.5+SIN(A)*2+AF*COS(A))
590 IF(RN>=1 AND CN>=1 AND RN<=8 AND CN<=8) AND( B(ABS(RN),ABS(CN))>=0 OR SW<>0 )THEN GOSUB3000
650 NEXT AF,A
700 IF B(R,C)<>-1 THEN 900
710 FOR CN=C-1TOC+1:FORRN=R-1TOR+1
715 IF( CN=CAND RN=R ) OR CN<1 OR RN<1 OR CN>8 OR RN>8 THEN 800
720 IF B(RN,CN)<0AND SW=0 THEN 800
730 GOSUB3000
800 NEXT RN,CN
900 '
1000 NEXT C,R
1002 IF SW=1THEN2020
1005 VA=0:IF PM=00THENPRINTCHR$(31)"i CAN'T MOVE.  STALEMATE":END
1010 B=0
1020 FOR I=1TOPM:IF ABS(D(R%(I)))>D(R%(1)) OR I=1THENB=0
1030 IF ABS(D(R%(I)))=>D(R%(1)) THEN B=B+1:R%(B)=I
1040 NEXT I
1050 FOR J=1TOB:RQ=RND(B):H=R%(J):R%(J)=R%(RQ):R%(RQ)=H:NEXTJ
1060 FOR J=1TOB
1070 H=R%(J):C7=CO(H):C8=CN(H):R7=RO(H):R8=RN(H):B(R8,C8)=B(R7,C7):CR=B(R7,C7):B(R7,C7)=0
1080 IF VA<>200 AND (INKEY$=CHR$(31) OR D(R%(H))<0 )THEN 1300
1090 SW=1:QT=1:GOTO2000
1200 PRINT"FIRST1200--";:QT=0:B(R7,C7)=B(R8,C8):B(R8,C8)=CR:IFVA=.5THEN1300ELSED(R%(H))=-ABS(D(R%(H))
1210 NEXT J:GOTO1010
1300 IFB(R8,C8)=-6 AND R8=1 THEN B(R8,C8)=-2
1310 R1=R7:R2=R8:C=C7:C1=C8:GOSUB20000
1320 B(R8,C8)=B(R7,C7):B(R7,C7)=0
1330 IF ABS(R-200)<.1THENPRINT"CHECKMATE.....i WON!,  i WON,  i WON !!!!!!!!!!!":END
1340 GOTO 80
2000 SW=1:FORR=1TO8:FORC=1TO8:B(R,C)=-B(R,C):J(R,C)=0:NEXTC,R
2010 GOTO 279
2020 CV=9:RV=9:FV=0:SW=0:FORR=1TO8:FORC=1TO8:B(R,C)=-B(R,C):NEXTC,R
2025 IF QT=1 THEN 1200
2030 FOR M=1TOPM:J( RN(M),CN(M) )=1
2035 IF (FV=0 AND B(RN(M),CN(M))<0) OR (B(RN(M),CN(M)) >B(RV,CV)ANDFV=1 AND B(RN(M),CN(M))<0) THEN FV=1:CV=CN(M):RV=RN(M):R1=RV:C1=CV:C=CV:R2=RV:GOSUB20000
2040 NEXT M
2050 GOTO 279
3000 IFSW=1THEN3500ELSEP1=V(B(RN,CN)):IFJ(RN,CN)=1THENP2=V(-B(R,C))ELSE P2=.5
3010 IF C<>CV OR R<>RV THEN P2=P2+V( -B(RV,CV) )*FV
3015 IFQQ<>9 THENPM=PM+1:RN(PM)=RN:CN(PM)=CN:RO(PM)=R:CO(PM)=C
3020 IF P1=100 THEN P2=.5
3030 D(PM)=P1*QQ/P2:QQ=1:RETURN
3500 IF QT <>1THEN D(PM)=1:RETURN ELSE IF V( ABS( B(RN,CN) ) )>VA AND B(RN,CN)>=0 THEN VA=V( B( RN,CN) ):RETURN
4000 IFC+1<=8 AND B(R+1,C+1)>=0THENCN=C+1:RN=R+1:GOSUB3000
4010 IF B(R+1,C-1)>=0 AND C-1>=1 THEN CN=C-1:RN=R+1:GOSUB3000
4020 GOTO 340
8000 PRINTCHR$(31);"K=1,Q=2,B=3,N=4,R=5,P=6  WE ARE NEG. GIVE R,C,V":INPUT R,C,V:B(R,C)=V:GOSUB10000:GOTO 107
10000 FORR1=1TO8:FORC=1TO8:PRINT@(R1-1)*64+C*6,P$(ABS(B(R1,C)))" "C$(SGN(B(R1,C))+2);"    ";:NEXTC,R1:PRINT
10020 PRINT@576,"";:RETURN
20000 FOR FL=1TO10:PRINT@(R1-1)*64+C*6,P$(ABS(B(R1,C)));" "C$(SGN(B(R1,C))+2);:J3=3[.344:PRINT@(R1-1)*64+C*6," - ";:NEXTFL:FORFL=1TO20:PRINT@(R2-1)*64+C1*6,"   ";:Y3=3[.344:PRINT@(R2-1)*64+C1*6,P$(ABS(B(R1,C)));" ";C$(SGN(B(R1,C))+2);:NEXTFL
20010 PRINT@576,"";:RETURN
