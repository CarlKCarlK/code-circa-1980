    5 T=0:W=1:Y=1983:P=1:N=100:L=52
   20 PRINT "YR";Y;",WP";W;",RS";N:Y=Y+1: INPUT "# NEW WEAPONS?";I:I=I*(I>=0)*(I<101)
   40 W=W+I:T=(T=0): IF T=P GOTO 300
   50 INPUT "WAR? (Y/N) ";A$(L): PRINT "ENTER, AFTER BEEP": PRINT #"A";A$(L)
   60 IF A$(L)="Y"LET T=(T=0): GOTO 345
   70 PAUSE "DECISION PENDING": INPUT #"B";A(L)
   80 A=A(L): IF A<>1 GOTO 120
   90 PAUSE "PEACE!!!": GOSUB "D":I=INT (W*D/100)+1: IF P=T BEEP I
  100 W=W-I: PAUSE "WE LOSE ";I: IF P<>T BEEP I
  110 GOTO 20
  120 IF A<>2 GOTO 170
  130 PAUSE "TRADE!!!": GOSUB "D":I=INT (N*D/100)+1:N=N-I: PAUSE "WE GIVE ";I
  140 IF P=T INPUT #"C";A(L): PAUSE "WE GET ";A(L):N=N+A(L)
  150 A(L)=I: PRINT #"C";A(L): IF P<>T INPUT #"C";A(L): PAUSE "WE GET ";A(L):N=N+A(L)
  160 GOTO 20
  170 IF A<>3 PAUSE "NO ACTION": GOTO 20
  180 PAUSE "WAR!!! ":B=0:H=0
  185 IF B INPUT "EST TOT WEP(OR 0)";G:A(L)=G: PRINT #"A";A(L)
  190 IF B=0 INPUT #"A";A(L):G=A(L)
  195 IF (G=0)*(H>0) GOTO 210
  200 H=ABS G+(G<=H)*H:B=(B=0): IF B PRINT "ENEMY ESTS ";H: GOTO 185
  205 GOTO 185
  210 IF B INPUT #"A";A(L):E=A(L): PAUSE "ENEMY WEP=";E
  215 A(L)=W: PRINT #"A";A(L): IF B=0 INPUT #"A";A(L):E=A(L): PAUSE "ENEMY WEP=";E
  220 F=W+E:G=ABS (H-F)*E*W: IF G>1[E]6 BEEP 10: PRINT "HOLOCAUST ";G: END 
  230 IF H>F PRINT "TOO BIG":W=INT (W*.75): GOTO 20
  235 IF B=0 INPUT #"A";A(L):N=N+A(L): PRINT "WE WIN ";A(L): GOTO 20
  240 GOSUB "D":I=N*D/100:A(L)=I: PRINT #"A";A(L):N=N-I: PRINT "WE LOSE ";I: GOTO 20
  300 PAUSE "(WAITING)": BEEP 2: INPUT #"A";A$(L): IF A$(L)="Y"LET T=(T=0): GOTO 180
  310 INPUT "1:PCE 2:TRD 3:WAR 4:NIL";A:A(L)=A
  320 PRINT #"B";A(L): IF A=1 GOTO 90
  330 IF A=2 GOTO 130
  340 IF A<>3 GOTO 170
  345 B=1:H=0: GOTO 185
  910 "D"GOSUB 920:D=1+INT 6R: GOSUB 920:D=D+1+INT 6R: RETURN 
  920 R=[PI]+983R:R=R-INT R: RETURN 
