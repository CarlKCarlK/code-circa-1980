30 LINE(61,27)-(80,27),SET:SET(61,28):SET(61,29):SET(80,28):SET(80,29)
40 DIM A%(100),B%(100),C%(100)
50 AL=60:BL=26
100 A$= INKEY$
110 IF ABS(AF)+ABS(CF)+ABS(BF)=0 AND A$=""THEN100
120 IF A$=""THEN 200
125 IF VAL(A$)<3.5 THEN GET@(AL,17)-(AL+34,47),G,A% ELSE IF VAL(A$)<6.5 THEN GET @(AL,BL)-(AL+20,BL+4),G,B% 
130 IF A$="1" THEN AF=-1ELSEIFA$="2" THEN AF=0 ELSE IF A$="3" THEN AF=1ELSE IFA$="4" THEN BF=-1ELSEIFA$="5" THEN BF=0 ELSE IF A$="6" THEN BF=1ELSE IF A$="7"THENCF=-1ELSEIFA$="8"THENCF=0ELSEIFA$="9"THENCF=1 ELSE A$="" :GOTO120
140 A$="":GOTO 110
200 IF AF=0 THEN 300
210 AL=AL+AF:IFAL<43 OR AL>92 THEN AL=AL-AF:AF=0:GOTO100 ELSEPUT@(AL,17)-(AL+34,47),SET,A%:GOTO100
