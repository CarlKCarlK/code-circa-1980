400 IF CL+CF<=0OR CL+CF>10 THEN CF=0:GOTO100ELSERESET(AL+CL+1,BL+2):RESET(AL+CL+1,BL+3):RESET(AL+20-CL+1,BL+2):RESET(AL+20-CL+1,BL+3):CL=CL+CF*.3:SET(AL+CL+1,BL+2):SET(AL+CL+1,BL+3):SET(AL+20-CL+1,BL+2):SET(AL+20-CL+1,BL+3)
