10 CLEAR 1000
20 'FORMAT B* BOOK TITLE,A* AUTHOR,PLAY TITLE
30 CLS
40 PRINT"DO YOU WISH TO SEARCH BY"
50 PRINT
60 PRINT"AUTHOR"
70 PRINT"BOOK TITLE"
80 PRINT"PLAY TITLE"
90 PRINT
100 INPUT"CHOICE";C$
110 PRINT"WHAT IS "C$"'S NAME";:INPUT N$
120 L$=LEFT$(C$,1)
130 IFL$="P"THEN170  
140 IF L$="B"THEN260  
150 IFL$="A"THEN350  
160 GOTO30   
170 READ D$
180 IFD$="DONE"THEN450  
190 IFLEFT$(D$,2)="B*" THEN B$=RIGHT$(D$,LEN(D$)-3):B=0
200 IFLEFT$(D$,2)="A*" THEN A$=RIGHT$(D$,LEN(D$)-3):A=0
210 IF INSTR(D$,N$)=0 OR MID$(D$,2,1)="*"THEN250  
220 IFB=0THENB=1:PRINT:PRINTB$
230 IFA=0THENA=1:PRINT"    "A$
240 PRINT"          "D$
250 GOTO170  
260 READ D$
270 IFD$="DONE"THEN450  
280 IF INSTR(D$,N$)=0 OR LEFT$(D$,2)<>"B*"THEN260  
290 PRINT:PRINTRIGHT$(D$,LEN(D$)-3)
300 READ D$
310 IF D$="DONE" OR LEFT$(D$,2)="B*"THEN270  
320 IF LEFT$(D$,2)="A*"THENPRINT"     ";RIGHT$(D$,LEN(D$)-3):GOTO340  
330 PRINT"          "D$
340 GOTO300  
350 READD$
360 IF D$="DONE"THEN450  
370 IF LEFT$(D$,2)="B*"THENB$=RIGHT$(D$,LEN(D$)-3):GOTO350  
380 IF LEFT$(D$,2)<>"A*" OR INSTR(D$,N$)=0THEN350  
390 PRINT:PRINTB$
400 PRINT"     "RIGHT$(D$,LEN(D$)-3)
410 READ D$
420 IFMID$(D$,2,1)="*" OR D$="DONE"THEN360  
430 PRINT"          "D$
440 GOTO410  
450 RESTORE:PRINT:PRINT"(PRESS ANY BUTTON)"
460 IF INKEY$=""THEN460  ELSERUN
470 DATAB* TWENTIETH CENTURY DRAMA,A* SHAW,MAJOR BARBARA,A* SYNGE,THE PLAYBOY OF THE WESTERN WORLD,A* YEATS,ONLY JEALOUSY OF EMER,A* ODETS,AWAKE AND SING!,A* WILDER,OUR TOWN,A* WILLIAMS,GLASS MENAGERIE,A* O'NEILL,THE ICEMAN COMETH
480 DATAA* OSBORNE,LOOK BACK IN ANGER,A* PINTER,DUMB WAITER,A* ALBEE,THE ZOO STORY,A* BECKETT,EMBERS,B* SEVEN PLAYS OF THE MODERN THEATER,A* BECKETT,WAITING FOR GODOT,A* BEHAN,QUARE FELLOW,A* DELANEY,A TASTE OF HONEY,A* GELBER,CONNACTION
490 DATAA* GENET,BALCONY,A* IONESCO,RHINOCEROS,A* PINTER,BIRTHDAY PARTY,B* THE TWENTIETH CENTURY,A* SHAW,HEARTBREAK HOUSE
500 DATA"DONE"
