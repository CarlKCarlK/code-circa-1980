10 PI=3.14159
20 CLS:PRINT:PRINT:PRINT:PRINT
30 TI=1
50 C=100
60 CLS
65 INPUT"DO YOU WANT TO PUT IN YOU OWN SITUATION";A$
67 IF A$="NO"THEN 2000 ELSEIFA$<>"YES" THEN 65
70 INPUT"HOW MANY METERS WIDE IS THE SCREEN";AM
72 IF AM=-2 THEN AM=8E11:SF=127/AM:NO=1:X=1:DIMP(NO,2):            P(X,0)=1.991 E30:P(X,1)=2E11:P(X,2)=14 E10:MS=5.979 E24 :XS=.4793E11:YS=1.40001E11:GOTO 160
75 SF=127/AM
80 PRINT"ALL MASSES ARE IN KG., ALL COORIANTES ARE IN METERS FROM BOTTOM LEFT HAND CORNER, ALL VEOLCITY IN M/SEC
100 INPUT"HOW MANY OBJECTS";NO
105 DIM P(NO,2)
110 FORX=1TONO
120 INPUT"MASS,X,Y";P(X,0),P(X,1),P(X,2)
130 NEXT X
140 INPUT"MASS SPACE SHIP";MS
150 INPUT"X,Y OF SPACE SHIP";XS,YS
160 INPUT"HEADING (DEG.), AND INITAL VOCLICY OF SHIP";AS,VS
165 AS=AS/180*PI
180 FORI=1TONO:SET ( P(I,1)*SF, 47-P(I,2)/2*SF ) :NEXTI
190 SET(XS*SF,47-YS/2*SF)
200 VY=SIN(AS)*VS:VX=COS(AS)*VS
300 '
310 NB=0
315 YP=0:XP=0
320 FORI=1TO NO
330 A=ATN( (YS-P(I,2))/(XS-P(I,1)) )
332 IF P(I,1) > XS THEN A=A+PI
340 P= 6.670 E-11*-P(I,0)/ (   (  XS-P(I,1)  )[2+    (  YS-P(I,2)  )[2  )
350 YP=YP+P*SIN(A)
360 XP=XP+P*COS(A)
366 IF INT(XS)=INT( P(I,1)) AND INT(YS/2+.5)=INT(P(I,2)) THEN 1000
370 NEXT I
380 X=1/2* XP*TI[2 +VX*TI
385 Y=1/2* YP*TI[2 +VY*TI
390 Z=ABS(X):IFABS(Y)>Z THEN Z=ABS(Y)
400 IF Z*SF>2 THEN TI=TI/2:NB=1:GOTO315ELSEIFNB=0 AND Z*SF<.6 THEN TI=TI*2:GOTO 315
405 VX=X/TI:VY=Y/TI
410 XS=XS+X:YS=YS+Y
420 SET(XS*SF,47-YS/2*SF+.5)
425 PRINT @ 965,"VELOCITY="SQR(VX[2+VY[2)"  ELASE TIME="YK":"DK":"HK":"MK":"TM;
427 TM=TM+TI:IFTM>=60THENMK=MK+INT(TM/60):TM=INT(((TM/60-INT(TM/60))*60)+.5):IF MK>=60 THEN HK=INT(MK/60)+HK:MK=INT(((MK/60-INT(MK/60))*60)+.5):IF HK>=24THEN DK=DK+INT(HK/24):HK=INT(((HK/24-INT(HK/24))*24)+.5)
428 IF DK>=365 THEN YK=INT(DK/365)+YK:DK=INT(((DK/365-INT(DK/365))*365)+.5)
430 GOTO 300
1000 A$=INKEY$
1010 A$=INKEY$
1020 IFA$=""THEN1010 ELSE 140
2000 CLS:PRINT"THESE ARE THE OPTIONS AVILIBLE:":PRINT
2005 NU=4: 'NU IS NUMBER OF QUESTIONS
2010 PRINT" 1) SPACESHIP  THOUGH THE SOLAR SYSTEM"
2020 PRINT" 2) EARTH (TERRA)  AROUND THE SUN (SOL)"
2030 PRINT" 3) SPACESHIP  IN THE EARTH (TERRA)/ MOON (LUNA)"
2040 PRINT" 4) RANDOM INTER STELLER SPACE"
2190 PRINT
2200 INPUT"WHICH OPTION DO YOU PREFER";OT
2210 IF OT<0 OR OT>NU THEN 2200
2220 IF OT<>1 THEN 2500
2222 AM=2E13
2225 P(1,0)=1.991 E30:P(1,1)=AM/2:P(1,2)=.75*P(1,1)
2230 SF=127/AM
2235 NO=10
2240 FORI=2TO10
2250 READ P(I,0),DS,N$
2260 PRINT"AT WHAT ANGLE IS "N$;
2265 INPUTAL
2267 AL=AL/180*PI
2270 P(I,1)=P(1,1)+DS*COS(AL):P(I,2)=P(1,2)+DS*SIN(AL)
2280 NEXT I
2290 DATA 3.181 E23,5.795E10,"MERCURY",4.883 E24,1.0811E11,"VENUS",6.052 E24,1.4957 E11,"EARTH",  6.418E23,2.2784E11,"MARS",   1.901E27,7.7814 E11,"JUPITER",5.684E26,1.4270 E12,"SATURN",     8.685E25,2.8703E12,URANUS,1.02846E26,4.4999E12
2300 DATA NEPTUNE,1.08 E24,5.909E12,PLUTO
2305 CLS
2310 GOTO 140
