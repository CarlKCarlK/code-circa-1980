10 'TANK GAME
20 'COPYRIGHT 1980  CARL KADIE
30 'PLAN OF ACTION
40 '
45 '*** MAIN PROGRAM ***'
50 IF D1=10 OR D2=10 THEN 130 :'DO WHILE EACH SIDE HAS ONE OR MORE WORKING TANKS
60    FOR TA = 0 TO 9
70           FOR TEAM = 0 TO 2
80               PROGRAM=PROGRAM(TEAM,TA):'GET PROGRAM
90               GOSUB 150:'PROGRAM EXECUTE
100              NEXT TEAM:'END TEAM
110          NEXT TEAM:'END TANK
120    GOTO 50:'END WORKING?
130 END:'END MAIN PROGRAM
140 '
150 '*** SUBROUTINE TO EXECUTE TANK PROGRAMS ***'
160  FLAG=1   :' FLAG WILL EQUAL 0 WHEN TIME IS UP
165  MP=1  :'    MAIN POINTER
170 IF NOT(FLAG=1) THEN 350
180 '   GOSUB INSTR    /*  GET NEXT COMMAND  */
190    IF NOT( IN$<>"RE" AND FLAG=1)THEN230:'FIRST EMERGENCY
200 '           CALL DOIT
210 '           GOSUB INSTR
220           GOTO190:' END FIRST EMERGENCY
230    IF FLAG = 0 
                THEN EP=MP
                ELSE MP=EP: GOSUB INSTR
240     IF NOT( IN$<>"RE" AND FLAG=1) THEN 280:'   SEC EMER
250 '           CALL DOIT
260 '           GOSUB INSTR
270           GOTO 240:' END SEC EMER
280    IF FLAG=0
                THEN EP=MP
                ELSE MP=PP:GOSUB INSRT
290 IFNOT(MP<= LEN(PR$) AND FLAG = 1) THEN 330:'PRIMARY
300 '           CALL DOIT
310 '           GOSUB INSTR
320            GOTO290:'END PRIMARY
330    IF FLAG=0
                THEN PP=MP
340    IF MP> LEN(PR$)
                MP=RND(LEN(PR$))
345 GOTO 170:' END ROUTINES LOOP
350    RETURN:' EXCUT
360 '
370 '*** PROGRAM TO GET NEXT STUFF FROM PROGRAM ***'
380 IN$=""
385 VALUE=1
390 NE$=MID$(PROGRAM,MP,1)
395 MP=MP+1
400 IF NOT(LEN(IN$)<2 AND MP<= LEN( PR$)) THEN 460
410      IF VAL(NE$)=0 AND NE$<>"0" AND NE$<>"." AND NE$<>" "
        THEN IN$=IN$+NE$
420      IF VAL(NE$)<>0 OR NE$="0" THEN
            VALUE=VAL(MID$(PR$,MP-1,LEN(PR$)):IN$=""
		             :MP=MP+LEN(STR$(VALUE))-1
430      IF NE$="#" THEN
            MP=MP+LEN(STR$(VAL(MID$(PR$,MP,LEN(PR$)))))-1
440      IF NE$="." OR NE$=" "THEN IN$=""
450 GOTO 400
460 RETURN
480 '*** SUBROUTINE TO EXECUTE THE COMMANDS ***'
500 ON ASC(IN$)-69 GOTO 600,800,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200
600 'FIRE
610 GOSUB 5000:' WHOPRINT  /* RETURNS WHO */
615 FLAG=0
620 IF ENERGY>=VATHEN ENERGY=ENERGY-VA ELSE VA=ENERGY:ENERGY=0
630 ' DAMAGE=(4-DISTANCE)*ENERGY:IF DISTANCE>=4 THEN DAMAGE=ENERGY/2[(DISTANCE-3)
640 ON  WHO GOTO 650,650,710,730,740
650 LOOP UNTIL TEMP IS FOUND
660 ENERGY(WHO,TEMP)=ENERGY(WHO,TEMP)-DAMAGE
670 IF ENERGY<=0 THEN GOSUB DESTROYED
680 GOTO 750
710 LOOP UNTIL TEMP IS FOUND
720 ENERGY(TEMP)=ENERGY(TEMP)-DAMAGE/2
725 GOTO 750
730 LOOP UNTIL DESTROYED IS FOUND
733 ENERGY(TEMP)=ENERGY(TEMP)-DAMAGE
735 IF ENERGY<=7 THEN GOSUB DESTROYED
738 GOTO 750
740 'WALL
750 GOTO 4000
800 'GOTO
810 FOR TEMP=1 TO LEN(PR$)-1
820   IF MID$(PR$,TEMP,1)="#" THEN IF VAL(MID$(PR$,TEMP+1,LEN(PR$))) = VALUE THEN MP= TEMP+LEN(STR$(VA))+1:GOTO850
830 NEXT TEMP
840 GOTO 4000
1000 'WHO RETURNS THE CHARACTER FROM THE SQUARE
1010 FLAG=0
1020 GOTO 4000
1200 'IF
1210 GOSUB INSTR
1230 IF (IN$="EN" AND WHO=3-TEAM)OR(IN$="CL"ANDWHO=0)OR(IN$="AL"AND WHO=TEAM)OR        (IN$="MI"ANDWHO=3)OR(IN$="DE"ANDWHO=4)OR(IN$="WA"AND        WHO=5) THEN GOTO 800 ELSE 4000
1400 'J?
1600 'K?
1800 'LOOK
1810 IN$=RIGHT$(IN$,1)
1820 IFNOT( IN$="N"ORIN$="S"OR IN$="E"ORIN$="W" )THEN 1840 ELSE IF IN$="N"THENTX=0:TY=-1 ELSEIF IN$="S"THENTX=0:TY=1ELSEIFIN$="W"THENTX=-1:TY=0ELSEIFIN$="E"THENTX=1:TY=0
1830 GOTO 1850
1840 IF IN$="F"THENTX=CX:TY=CY ELSEIFIN$="B"THENTX=-CX:TY=-CY ELSE IFIN$="R"THENTEMP=ABS(.5-SGN(CY))*-2:TY=CX*TEMP:TX=CY*TEMP ELSE IFIN$="L"THENTEMP=ABS(.5-SGN(CX))*-2:TY=CX*TEMP:TX=CY*TEMP ELSE TY=0:TX=0
1850 LX=X+TX*VA:LY=Y+TY*VA
1860 GOSUB 5000:'WHO'S THERE?
1880 GOTO 4000
2000 'MOVE
2010 FLAG=0
2020 CX=SGN(LX-X):CY=SGN(LY-Y):LX=X+CX:LY=Y+CY
2030 GOSUB 5000:'WHAT,WHO
2040 IF WHO=0 OR WHO=4 THEN X=LX:Y=LY
2050 IF WHO<>4 THEN 2100
2060 LOOP INTIL MINE IS FOUND
2070 ENERGY=ENERGY-MINES ENERGY*4
2080 IF ENERGY<0 THEN GOSUB DESTROYED
2090 DESTROY MINE
2100 GOTO 4000
2200 'N?
2400 'O?
2600 'P?
2800 'Q?
3000 GOTO 4000
3010 GOTO 4000
3200 'SET MINE
3210 IF ENERGY>=VALUE THEN ENERGY=ENGRGY-VALUE ELSE VALUE=ENERGY:ENERGY=0:GOSUB DESTROYED
3220 IF WHO>0 THEN 3260
3230 FLAG=0
3240 LX=X+SGN(LX-X):LY=Y+SGN(LY-Y)
3250 GOSUB WHOPRINT
3260 GOTO4000
3270 ADD ONE TO THE MINES
3290 PUT A MINE DOWN
4000 RETURN
5000 ' SUB TO RETURN WHAT THE ASC OF THE CHAR AT LX,LY
        AND WHO 0 FOR FREE,1 TEAM1, 2TEAM2,3MINE,4 DEST,5WALL
5005 IFLX<0 OR LX>63 OR LY<0 OR LY>15 THEN WHAT=191:WHO=5:GOTO5100
5010 WHAT=PEEK(15360+LX+LY*64)
5020 IF WHAT<=32 THEN WHO=0 ELSEIFWHAT<=47 THEN WHO=3 ELSE IF WHAT<=57 THEN WHAT=1 ELSEIFWHAT<=75 THEN WHO=2 ELSE IF WHAT<=95 THEN WHO=4 ELSE WHO=5
5100 RETURN
20000 SUB DESTROYED  GIVEN WHO,AND TEMP IT PUTS THEM
        ON THE LIST OF DESTROYED AND MARKS WITH AN X
