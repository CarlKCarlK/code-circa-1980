10 '
20 T$="AIR"
90 CLS
100 PRINT"THIS IS RUSSIAN RULLETTE":PRINT
110 INPUT"DO YOU KNOW HOW TO PLAY RUSSIAN RULLETTE";A$
120 IFA$="YES" THEN300
125 CLS
130 PRINT"YOU PLAY RUSSIAN RULLETTE THIS WAY"
135 PRINT
140 PRINT"YOU <TAKE> GUN - <LOAD> BULLETS - <SPIN> CHAMBER - <COCK> GUN - <AIM> AT YOUR HEAD - <FIRE> TRIGGER - IF YOU LIVE, YOU <PLACE>  GUN ON TABLE.
150 GOTO310
300 CLS
310 '
320 PRINT
330 INPUT"WHAT DO YOU WANT TO DO NOW";A$
340 IFA$<>"TAKE"THEN500
350 '  T=0 FOR TABLE   T=1 FOR HAND 1
360 IF T=0 THEN T=1:PRINT"YOU NOW HAVE THE GUN IN YOUR HAND":GOTO310
370 IFT=1THENPRINT"SORRY, THE GUN IS NOT ON THE TABLE.":GOTO310
400 PRINT"SORRY, THE GUN IS ON THE TABLE; NOT IN YOUR HAND.":GOTO310
500 IFA$<>"LOAD"THEN600
510 IFT<>1THEN400
520 PRINT:INPUT"HOW MANY BULLETS DO YOU WISH TO ADD";N
530 IFN+B>6THENPRINT"THE CHAMBER WILL NOT HOLD"N+B"BULLETS.":GOTO310
540 B=N+B
550 FORR=0TOB-1:C(R)=1:NEXT
560 PRINT"THE GUN NOW HAS"B"BULLETS IN ITS CHAMBER"
570 GOTO310
600 IFA$<>"SPIN"THEN800
610 IFT<>1THEN400
620 R=RND(6)-1
630 FORH=0TO5
640 IFH+R>5THENR=R-6:GOTO640
650 T(H+R)=C(H)
660 NEXT
670 FORH=0TO5
680 C(H)=T(H)
690 T(H)=0
700 NEXT
710 PRINT"THE GUN HAS BEEN SPUN.":GOTO310
800 IFA$<>"COCK"THEN900
810 IFT<>1THEN400
815 IFCL=1THENPRINT"THE GUN HAS ALREADY BEEN COCKED":GOTO310
820 C=C+1
830 IFC>5THENC=C-6
840 CL=C(C):IFC(C)=1THENB=B-1
850 PRINT"THE GUN IS COCKED.":GOTO310
900 IFA$<>"AIM"THEN1000
910 IFT<>1THEN400
920 INPUT"WHERE WOULD YOU LIKE TO AIM IT (RESPOND  AT <MYSELF>, AT <COMPUTER>, IN THE <AIR>, OR AT <OTHER> GUY";T$
930 PRINT:PRINT"IT IS AIMED.":GOTO310
1000 IFA$<>"FIRE"THEN1200
1010 IFT<>1THEN400
1015 CLS
1020 PRINTSTRING$(20,CHR$(191)):PRINTSTRING$(4,CHR$(191));"  ( ";CHR$(191):PRINTSTRING$(4,CHR$(191));"===='"
1030 PRINT@384,"PRESS (SPACE BAR) WHEN READY TO FIRE."
1040 IFINKEY$=""THEN1040
1050 PRINT@21,"";
1060 IFCL=1THENPRINT"BANG!"; ELSEPRINT"CLICK.";
1070 FORX=1TO1500:NEXT
1080 PRINT@384,"";
1090 IFCL=0THENPRINT"BOY! THAT WAS CLOSE. WELL LET'S KEEP GOING.":GOTO310
1100 IFT$="MYSELF"THENPRINT"YOU ARE DEAD. THE GUN FELL ON THE TABLE.";:T$="AIR":T=0ELSEIFT$="COMPUTER"THENNEWELSEIFT$="AIR"THENPRINT"SHOT FIRED INTO AIR, NO ONE HURT.";ELSEIFT$="OTHER"THENPRINT"YOU HAVE JUST KILLED THE OTHER GUY.";ELSEPRINTT$;" IS NOW DEAD.";
1105 PRINT"           "
1110 CL=0
1130 INPUT"DO YOU WISH TO CONTINUE THE SAME GAME";G$
1140 IFG$="YES"THEN310
1150 INPUT"DO YOU WANT TO START OVER";G$
1160 IFG$="YES"THENRUN10ELSEPRINT:PRINT"GOOD-BYE"
1170 END
1200 IFA$<>"PLACE"THENPRINT"I DO NOT UNDERSTAND WHAT YOU WANT.":GOTO310
1210 IFT<>1THEN400
1220 T=0:T$="AIR":PRINT"THE GUN IS NOW ON THE TABLE.":GOTO310
