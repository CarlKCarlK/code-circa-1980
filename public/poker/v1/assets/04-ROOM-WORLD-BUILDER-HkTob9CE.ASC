10 CLEAR 10000
20 CLS:PRINT:PRINT:PRINT
100 DIM   N$(50),D$(50),L(50,5),W$(5),S$(2)
110 R=1
115 R3=1
120 FOR X=0TO5
130 READ W$(X)
140 NEXT X
150 DATA N,E,U,D,W,S
160 FOR X=0TO2
170 READ S$(X)
180 NEXT X
190 DATA *,L,R
200 PRINT"I'VE NEVER BEEN HERE BEFORE.  wHAT IS THIS PLACE?"
210 INPUT N$(R)
220 PRINT"WHAT DOES IT LOOK LIKE?"
230 INPUT D$(R)
240 GOTO 300
300 PRINT
305 PRINT"WHICH WAY DO YOU WISH TO GO (N,S,E,W,U,D)?"
310 INPUT A$
315 PRINT
320 D1=7
330 FOR X=0 TO 5 
340 IF MID$(A$,1,1)=W$(X) THEN D1=X
350 NEXT X
355 D1=D1+1
360 IF D1<> 8 THEN 395
370 PRINT"SORRY. THAT IS NOT A DIRECTION. PLEASE USE N,S,E,W,U,D"
380 PRINT
390 GOTO 300
395 D2=3
400 FOR X=0TO2
410 IF MID$(A$,LEN(A$),1)=S$(X) THEN D2=X
420 NEXT X
430 IF D2<>3 THEN 550
440 R1=L(R,D1-1)
450 IF R1<>0 THEN 500
460 PRINT"YOU CANNOT GO THAT WAY"
470 GOTO 300
500 R=R1
510 PRINT" THIS IS ";N$(R)
520 PRINT
530 PRINT D$(R)
540 GOTO 300
550 IF D2<>0 THEN 730
560 IF L(R,D1-1)=0 THEN 630
565 GOSUB 570
567 GOTO 630
570 PRINT"THAT DIRECTION HAS ALREADY BEEN DESCRIBED."
580 PRINT"DO YOU STILL WANT TO GO THAT WAY";
590 INPUT A$
600 IF A$="PIRHO" THEN RETURN
610 PRINT"CHOOSE A NEW DIRECTION"
620 GOTO 300
630 R3=R3+1
640 PRINT"I'VE NEVER BEEN HERE BEFORE. WHAT IS THIS PLACE?"
650 INPUT N$(R3)
660 PRINT"WHAT DOES IT LOOK LIKE?"
670 INPUT D$(R3)
680 L(R,D1-1)=R3
685 A$="N"
688 PRINT"ONE-WAY? (Y/N)
690 INPUTA$
695 IF A$="Y"THEN 710
700 L(R3,(7-D1)-1)=R
705 GOTO 715
710 IF L(R3,(7-D1)-1)<>R THEN 715
712 L(R3,(7-D1)-1)=0
715 R=R3
720 GOTO 300
730 IF D2<>1 THEN 900
740 IF L(R,D1-1)=0 THEN 760
750 GOSUB 570
760 PRINT"FIND THE NUMBER OF THE ROOM YOU WISH TO JOIN TO"
770 PRINT
780 FOR X=1TOR3
790 PRINT X,N$(X)
800 NEXT X
810 PRINT
820 PRINT"WHICH ROOM (0 TO EXIT)"
830 INPUT R1
840 IF R1<1 OR R1>R3THEN 300
845 A$="N"
850 INPUT"ONE-WAY? (Y/N)";A$
860 L(R,D1-1)=R1
870 IF A$="Y"THEN890
880 L(R1,(7-D1)-1)=R
885 GOTO 895
890 IFL(R1,(7-D1)-1)<>R THEN 895
892 L(R1,(7-D1)-1)=0
895 R=R1
897 GOTO 300
900 REM REWRITE
920 PRINT "tHIS IS ";N$(R)
930 PRINT
940 PRINT D$(R)
950 PRINT
960 PRINT"ARE YOU FINISHED";
970 INPUT A$
980 GOSUB 600
990 PRINT"WHAT IS THIS PLACE CALLED?"
1000 INPUT N$(R)
1010 PRINT
1020 PRINT"WHAT IS IT LIKE?"
1030 INPUT D$(R)
1040 GOTO 300
