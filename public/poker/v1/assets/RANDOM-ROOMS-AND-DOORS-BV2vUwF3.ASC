5 CLS:DEFINT A-Z
7 DIM B(119,47),R(100)
15 FOR I=2TO 100
20 XL=INT( RND(0)*20)+2
30 YL=INT( RND(0)*10)+2
40 X=RND(119-XL):Y=RND(47-YL)
50 FORXI=XTOX+XL:SET(XI,Y):SET(XI,Y+YL):B(XI,Y)=1:B(XI,Y+YL)=1:NEXTXI:FOR YI=YTOY+YL:SET(X,YI):SET(X+XL,YI):B(X,YI)=1:B(X+XL,YI)=1:NEXTYI
60 FOR XI=X+1TOX+XL-1:FORYI=Y+1TOY+YL-1:RESET(XI,YI):B(XI,YI)=I:NEXTYI,XI
70 NEXT I
80 FOR X=0TO119:FORY=0TO47:GOSUB 100
90 IF POINT(X,Y) THEN RESET (X,Y):SET(X,Y) ELSE SET(X,Y):RESET(X,Y)
95 NEXT Y,X:R(1)=2:GOTO130
100 IF B(X,Y)=0 THEN B(X,Y)=1 ELSE IF B(X,Y)=1 THEN B(X,Y)=0
110 RETURN
130 REMARK    MAKEING DOORS
140 ND=0:FOR I=2TO 100:IF R(I)<>0 THEN R(I)=2:GOTO145 ELSE NEXTI:PRINT"BOOM !!!!!!":RUN
145 T=99:FORI=2TO100:IFR(I)=0THENR(I)=2:T=T-1:PRINT@60,T;ELSER(I)=I
147 NEXT I
150 X=RND(118):Y=RND(46):IF B(X,Y)<>0 THEN 150
160 M1=-INT(.5+SGN(B(X-1,Y))/2):M2=-INT(.5+SGN(B(X+1,Y))/2):M3=-INT(.5+SGN(B(X,Y-1))/2):M4=-INT(.5+SGN(B(X,Y+1))/2):IF (M1 AND M2 AND NOT M3 AND NOT M4) OR (NOT M1 AND NOT M2 AND M3 AND M4) THEN 165 ELSE 150
165 IF M1=0 THEN N1=R(B(X,Y+1)):N2=R(B(X,Y-1))ELSE N1=R(B(X+1,Y)):N2=R(B(X-1,Y))
167 IF N1=N2 THEN 150
170 B(X,Y)=-RND(2):RESET(X,Y):IF N1=1 OR N2=1 THEN 250
180 IF N1<N2 THEN N3=N1:N4=N2 ELSE N3=N2:N4=N1
190 FOR I=2TO100:IFR(I)=N4 THEN R(I)=N3:T=T-1:PRINT@60,T;
250 ND=ND+1:GOTO150
1000 IF INKEY$=""THEN 1000
2000 INPUT X1,Y1:IFX1>119-63 OR Y1>47-16 THEN 2000 ELSE IF X1<0 THEN 2500 ELSE160
2500 FOR I=1TO 100:X=RND(120)-1:Y=RND(48)-1:IFB(X,Y)=1 THEN B(X,Y)=-1
2510 NEXT I
3000 FOR X=0TO119:FORY=0TO47:IF B(X,Y)=1 THEN SET(X,Y) ELSE RESET(X,Y)
3010 NEXT Y,X:GOTO 1000
