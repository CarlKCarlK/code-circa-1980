5 PRINT"JUST A MINUTE.... SETTING UP DECK"
10 DIMD(105)
15 DIM PH(7):DIM CH(7)
20 FOR X=0TO105
30 S=RND(X+1)-1
40 D(X)=D(S)
50 D(S)=X
60 NEXTX
70 PH(0)=6:CH(0)=6
75 FOR P=0TO5:PH(P+1)=D(P):NEXTP
80 FOR C=6TO11:CH(C-5)=D(C):NEXTC
90 PC=12
100 REM   ***   ACTUAL PLAY  ***
103 DC=D(PC)
105 PH(0)=PH(0)+1
107 PH(PH(0))=DC
109 CLS
110 PRINT"THIS IS YOUR HAND------"
115 FOR RP=1TOPH(0)
120 CN=PH(RP):GOSUB 700
125 PRINT RP;"     ";CD$
130 NEXT RP
140 INPUT"WHAT DO YOU WANT TO DO";OP$
150 IF OP$="PD" THEN 1000
160 IF OP$="PH" THEN 2000
170 IF OP$="DI" THEN 3000
180 IF OP$="SH" THEN 3100
185 PRINT"THAT'S NOT AN OPTION---CHOOSE AGAIN":GOTO140
700 REM SUBROUTINE TO DISCODE CARDS
710 REM CN IS CARD NO., CL$ IS CLASS, CC$ IS CARD DESCRIPTION
720 RESTORE
730 READ N,CC$,CD$
740 CN=CN-N
750 IF CN>=0 THEN 730
760 RETURN
1000 REM  ** PUT DOWN OPTION **
2000 REM  ** PLAY HAZARD OPTION **
2010 IF CH=1 THEN PRINT"SORRY, THE COMPTER ALREADY HAS A HAZARD ON IT":GOTO 140
2020 INPUT"WHAT HAZARD (BY CARD NUMBER)";N
2030 CN=PH(N):GOSUB700:IF CC$<>"H" THEN PRINT"WHO ARE YOU TRYING TO FOOL; THAT'S NO HAZARD CARD!":GOTO 110
2040 CH=1:CH$=CD$
2045 PH(N)=PH(PH(0))
2050 PH(0)=PH(0)-1
2060 PRINT"END HAZARD (?)  COMPUTER'S TURN":GOTO 5000
3000 REM  ** DISCARD OPTION  **
3010 INPUT"WHAT CARD (BY NUMBER)";DN
3020 PH(DN)=PH(PH(0))
3030 PH(0)=PH(0)-1
3040 PRINT"THE COMPUTER'S TURN"
3050 END
3100 REM  **  A LOOK AT THE HANDS  **
3110 CLS
3115 IF CL=1 THEN CL$="YES" ELSE CL$="NO"
3116 IF PL=1 THEN PL$="YES" ELSE PL$="NO"
3120 PRINT"","COMPUTER","PLAYER"
3130 PRINT
3135 PRINT
3140 PRINT"MILEAGE",CM,PM
3155 PRINT
3160 PRINT"SPEED LIMIT",CL$,PL$
3165 PRINT
3166 PRINT
3170 PRINT"THE COMPUTER HAS THESE SAFETIES:"
3173 IF CS(0)=0 THEN PRINT " NONE":GOTO 3180
3175 FOR X=1TO CS(0):CN=CS(X):GOSUB700:PRINTCD$:NEXTX
3180 PRINT"THE PERSON HAS THESE SAFETIES:"
3183 IF PS(0)=0 THEN PRINT" NONE":GOTO 3190
3185 FOR X=1TOPS(0):CN=PS(X):GOSUB700:PRINTCD$:NEXTX
3190 PRINT@1024-49,"PRESS 'D' WHEN DONE";
3191 IF INKEY$<>"D" THEN 3191
3195 GOTO 109
5000  REM  ***   FROM HERE ON IS COMPUTER'S TURN    *****
5010 PC=PC+1
5020 FORX=1TO750:NEXTX:PC=PC+1:GOTO 100
5999 END
50000 DATA 3,H,OUT OF GAS, 3,H,FLAT TIRE, 3,H,ACCIDENT, 4,H,SPEED LIMIT, 5,H,STOP,   6,R,GASOLINE, 6,R,SPARE TIRE, 6,R,REPAIRS,6,R,END OF LIMIT, 14,R,ROLL,    1,S,EXTRA TANK, 1,S,PUNCTURE PROOF, 1,S,DRIVING ACE, 1,S,RIGHT OF WAY
50010 DATA 4,D,200, 12,D,100, 10,D,75, 10,D,50, 10,D,25
