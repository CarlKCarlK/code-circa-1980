OUTCH	JP	SKIP1	;SUBROUTINE TO PRINT ON SCREE1
			; INPUT  A,ZERO   B,CHARACTER
CURS1	DEFW	$	;LOCATION OF SCREE1
SCREE1	EQU	15360	;BEGINING OF SCREE1 MEM
SKIP1	PUSH	HL	;SAVE HL
	LD	HL,(CURS1) ; PUT LOCATION IN HL
	PUSH	DE	;SAVE DE
	PUSH	BC
	LD	DE,1022
	SBC	HL,DE
	JP	M,GOOD1
SCROL1	PUSH	HL 
	PUSH	DE
	PUSH	BC
	LD	DE,SCREE1;      MOVE SCREE1 UP
	LD	HL,SCREE1+64
	LD	BC,1024-64
	LDIR
	LD	HL,SCREE1+1024-64
	LD	(HL),32 ; LOAD CORNER WITH A BLANK
	LD	DE,SCREE1+1024-64+1
	LD	BC,63		;CLEAR LAST LINE
	LDIR
	LD	HL,1024-64
	LD	(CURS1),HL	  ;MOVE TO LAST PLACE
	POP	BC
	POP	DE
	POP	HL
GOOD1	LD	HL,(CURS1) ; PUT B ON THE SCREE1 
	LD	DE,SCREE1
	ADD	HL,DE
	POP	BC
	LD	(HL),B
	LD	A,B
	LD	HL,(CURS1)
	INC	HL
	LD	(CURS1),HL
	POP	DE
	POP	HL
	RET		;THATS ALL FOLKS
INCH	PUSH	BC	; NEXT GROUP SETS FOR SUBROUTINE
	PUSH	DE
	PUSH	HL
	PUSH	IX
	PUSH	IY
KEYSCN	LD	C,0		;FOR FIRST ROW
	LD	A,(3801H)	;FIRST ROW ADDRESS
	OR	A		;TEST ZERO OR NON-ZERO
	JP	NZ,KEY10	;GO IF KEY PRESSED
	LD	C,8		;REPEAT FOR OTHER ROWS
	LD	A,(3802H)
	OR	A
	JP	NZ,KEY10
	LD	C,16
	LD	A,(3804H)
	OR	A
	JP	NZ,KEY10
	LD	C,24
	LD	A,(3810H)
	OR	A
	JP	NZ,KEY10
	LD	C,32
	LD	A,(3820H)
	OR	A
	JP	NZ,KEY10
	LD	C,40
	LD	A,(3840H)
	OR	A
	JP	NZ,KEY10
	LD	C,48
	LD	A,(3808H)
	OR	A
	JP	NZ,KEY10	;PROCESS IF KEYPRESSED
	LD	A,255
	LD	(STAT2),A
	JP	KEYSCN		; IF NO KEY TRY AGAIN
KEY10	PUSH	AF
	LD	A,(3880H)	; CHECK FOR SHIFT
	OR	A
	JP	Z,KEY15
	LD	A,51  ; 51 IS THE NON SHIFT CHAR SET
	ADD	A,C
	LD	C,A
KEY15	POP	AF
	LD	B,0FFH	; INDEX
KEY20	INC	B	; DECREMENT (?) INDEX
	SRL	A	; SHIFT 'TIL NON-ZERO
	JP	NZ,KEY20	; GO IF NOT ZERO
	LD	A,B	; GET # 0-7
	ADD	A,C	; ADD ROW #
	LD	C,A	; INDEX 0-15 TO C
	LD	B,0	; ZERO B FOR ADDR
	LD	HL,TABL1	; TABL1 OF CHARACTERS
	ADD	HL,BC	; COMPUTE DISPLACEMENT
	LD	C,10	;PAUSE 10 COUNT
LOO2	LD	B,0
LOO21	DJNZ	LOO21
	DEC	C
	JP	NZ,LOO2
	LD	A,(HL)	; GET CHARACTER
	LD	B,A
	LD	A,(STAT2)
	SUB	B
	JP	Z,KEYSCN
	LD	A,(HL)
	LD	(STAT2),A
	POP 	IY
	POP	IX
	POP	HL
	POP	DE
	POP	BC
	RET		;GO ON BACK
STAT2	DEFB	255
TABL1	DEFM	'@ABCDEFGHIJKLMNOPQRSTUVW0123456789:;,-./'
	DEFB	13
	DEFB	31
	DEFB	03
	DEFB	91
	DEFB	26
	DEFB	08
	DEFB	25
	DEFB	32
	DEFM	'XYZ:ABCDEFGHIJKLMNOPQRSTUVW*!"#$%&'
	DEFB	39
	DEFM	'()*+<=>?'
	DEFB	13
	DEFB	31
	DEFB	03
	DEFB	91
	DEFB	92
	DEFB	29
	DEFB	94
	DEFB	32
	DEFM	'XYZ'
	END
