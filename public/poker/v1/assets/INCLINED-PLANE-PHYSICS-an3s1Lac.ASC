10 CLS
20 PRINT"ON AN INCLINE PLANE AN OBJECT WITH A WEIGHT (W1) IS "
30 PRINT"CONNECTED BY A LINE OVER A FRICTIONLESS PULLEY TO A "
40 PRINT"SECOND WEIGHT (W2). WITH A CERTAIN COEFFEICNT OF "
50 PRINT"FRICTION BETWEEN THE PLANE AND WEIGHT ONE (U),"
60 PRINT    "AT WHAT TWO ANGLES WILL THE BLOCK MOVE AT A CONSTANT"
70 PRINT    "SPEED."
80 PRINT
90 INPUT"WHAT IS W1,W2, AND U";W,W2,U
100 C=W2[2/4-1
110 B=-2*W2/(U[2*W)+1
120 A=1/U[2
130 IF B[2-4*A*C<0 THEN 230  
140 T1=(-B+SQR(B[2-4*A*C))/2/A
150 T2=(-B-SQR(B[2-4*A*C))/2/A
160 DEF FNC(X)=-ATN(X/SQR(-X*X+1))+1.5708
170 DEF FNA(X)=X/3.14159*180
180 O1=FNA(FNC(T1)):O2=FNA(FNC(T2))
190 PRINT
200 PRINT "THE TWO ANGLES ARE "O1"AND"O2
210 PRINT
220 GOTO 260  
230 PRINT"NO ANGLES WILL MAINTIAN A CONSANT SPEED"
240 PRINT
250 GOTO 260  
260 END
