10 CLEAR 50:DEFINT A-Z
20 XM=41:YM=21:PN= (XM/2)*(YM/2):DN=XM*YM:CM=XM*YM/2
40 DIM B(XM,YM),PS(PN),PE(PN),DP(DN),DX(DN),DY(DN),CX(CM),CY(CM),C1(CM),C2(CM)
50 RM = XM*YM/21
55 B$(1)="S"+CHR$(191)+"S":B$(0)=CHR$(140)+"S"+CHR$(140):B$(3)=" "+CHR$(191)+" ":B$(2)=STRING$(3,CHR$(140)):B$(4)=CHR$(149)+" "+CHR$(170):B$(5)=STRING$(3,CHR$(176)):B$(6)=STRING$(3,CHR$(191)):B$(8)="   "
60 'CLS
70 FOR RC=1TO RM
80 XD=RND(5)*2-1:YD=RND(5)*2-1
90 XS= RND(  (XM-XD-2+1)/2)*2:YS=RND( (YM-YD-2+1)/2)*2
100 FOR XC=XS+1 TO XS+XD:FOR YC=YS+1 TO YS+YD:B(XC,YC)=0:NEXTYC,XC
110 FOR XC=XS TO XS+XD+1:B( XC,YS)=-1:B(XC,YS+YD+1)=-1:NEXTXC
120 FOR YC=YS TO YS+YD+1:B( XS,YC)=-1:B(XS+XD+1,YC)=-1:NEXTYC
130 NEXT RC
150 FOR XC=1 TO XM:FOR YC=1 TO YM:IF B(XC,YC)<0 THEN 400
160 FS=1:IF YC=1 THEN 200 ELSE IF B(XC,YC-1) <=0 THEN 200ELSE FS=0
170 DM=DM+1:DX(DM)=XC:DY(DM)=YC:DP(DM)=0:B(XC,YC)=B(XC,YC-1):PT=PE(B(XC,YC)):PE(B(XC,YC))=DM:DP(PT)=DM:DP(PE(B(XC,YC-1)))=0
200 IF XC=1 THEN 300 ELSE IF B(XC-1,YC)<=0 THEN 300 ELSE IF B(XC,YC)=B(XC-1,YC) THEN 300 ELSE FS=0
210 IF B(XC,YC)>0 THEN 240
220 DM=DM+1:DX(DM)=XC:DY(DM)=YC:DP(DM)=0:B(XC,YC)=B(XC-1,YC):PT=PE(B(XC,YC)):PE(B(XC,YC))=DM:DP(PT)=DM:DP(PE(B(XC-1,YC)))=0
230 GOTO 300
240 PH=B(XC,YC):PL=B(XC-1,YC):IF PH<PL THEN T=PL:PL=PH:PH=T
245 DP=PS(PH)
250 IF DP<>0 THEN B( DX(DP),DY(DP))=PL:DP=DP(DP):GOTO 250
260 DP( PE( PL ))=PS(PH):PE(PL)=PE(PH):PM=PM-1
270 IF PH=PM+1 THEN 300 ELSE PS(PH)=PS(PM+1):PE(PH)=PE(PM+1):DP=PS(PM+1)
280 IF DP<>0 THEN B( DX(DP),DY(DP))=PH:DP=DP(DP):GOTO 280
300 IF FS=0 THEN 400 
310 DM=DM+1:DX(DM)=XC:DY(DM)=YC:DP(DM)=0:PM=PM+1:B(XC,YC)=PM:PS(PM)=DM:PE(PM)=DM:DP(DM)=0
400 NEXT YC,XC
410 FOR XC=1TO XM:FOR YC=1 TO YM:IF B(XC,YC)>=0 THEN 440 ELSE NT=B(XC,YC-1)<0:ST=B(XC,YC+1)<0:WT=B(XC-1,YC)<0:ET=B(XC+1,YC)<0:IF (NT AND ST AND NOT(WT) AND NOT(ET)) THEN WT=-1:NT=B(XC-1,YC):ST=B(XC+1,YC):GOTO 430
420 IF NOT(NT) AND NOT(ST) AND ET AND WT THEN NT=B(XC,YC-1):ST=B(XC,YC+1):WT=1ELSE 440
430 CN=CN+1:CR=RND(CN):CX(CN)=CX(CR):CX(CR)=WT*XC:CY(CN)=CY(CR):CY(CR)=YC:C1(CN)=C1(CR):C1(CR)=NT:C2(CN)=C2(CR):C2(CR)=ST
440 NEXT YC,XC
450 CC=0:FOR T=1TO PM:PE(T)=T:NEXT T:FT=PM-1:FO=0
460 CC=CC+1:IF CC>CM THEN PRINT"FAILURE",PM:GOTO999ELSEC1=C1(CC):C2=C2(CC)
470 IF PE(C1)<>C1 THEN C1=PE(C1):GOTO 470
480 IF PE(C2)<>C2 THEN C2=PE(C2):GOTO 480
490 IF (C1=C2) OR (FO=1 AND (C1=1 OR C2=1)) THEN 600
500 B( ABS(CX(CC)),CY(CC))=-(RND(2)*2+SGN(SGN(CX(CC))+1)):CY(CC)=-CY(CC):IF C1<C2 THEN C5=C1 ELSE C5=C2
505 IF C5=1 THEN FT=FT-1:FO=1:GOTO 600
507 C3=C1(CC):C4=C2(CC):PE(C1)=C5:PE(C2)=C5
509 IF PE(C3)<>C3 THEN T=C3:C3=PE(C3):PE(T)=C5:GOTO 509
511 IF PE(C4)<>C4 THEN T=C4:C4=PE(C4):PE(T)=C5:GOTO 511
513 FT=FT-1
600 IF FT>0 THEN  460
605 GOSUB 610:GOTO640
610 CLS:FOR XC=1TO XM:FOR YC=1 TO YM:IF B(XC,YC)=-1 THEN SET(XC*2,YC):SET(XC*2+1,YC)ELSE IF B(XC,YC)<-1 THEN SET(XC*2,YC)
620 NEXT YC,XC:RETURN
640 FOR RC=2TO PM
650 PT=PS(RC):XL=DX(PT):XB=XL:YL=DY(PT):YB=YL:PT=DP(PT):BB=B(XL,YL)
660 IF PT=0 THEN 690 ELSE IF DX(PT)<XL THEN XL=DX(PT) ELSE IF DX(PT)>XB THEN XB=DX(PT)
670 IF DY(PT)<YL THEN YL=DY(PT) ELSE IF DY(PT)>YB THEN YB=DY(PT)
675 PT=DP(PT):GOTO 660
690 IF  XB-XL>19 OR YB-YL>13 THEN BF=1 ELSE BF=0
700 CLS:FOR XC=XL-1TOXB+1:FOR YC=YL-1TO YB+1:BT=B(XC,YC):IF BF=0 THEN 730
710 IF BT<>BB THEN SET( (XC-XL+1)*2,YC-YL+1):IF BT=-1 OR BT<=-6 OR BT>0THEN SET ((XC-XL+1)*2+1,YC-YL+1)
720 GOTO 750
730 IF BT=-1 OR (BT>0 AND BT<>BB) OR BT<=-6THEN PT$=B$(6)ELSE IF BT=BB THEN PT$="   "ELSE PT$=B$(BT+7)
740 PRINT@ (XC-XL+1)*3+(YC-YL+1)*64,PT$;
750 NEXT YC,XC
770 NEXT RC
999 GOSUB 610:RUN
1000 FOR X1=1 TO XM:FOR Y1=1 TO YM:IF B(X1,Y1)=0 THEN PRINT@(X1-1)*3+Y1*64-1," . "; ELSE IF B(X1,Y1)=-1 THEN PRINT@(X1-1)*3+Y1*64-1,CHR$(191)+CHR$(191)+CHR$(191);ELSE PRINT@(X1-1)*3+Y1*64-1,B(X1,Y1);
1010 NEXT Y1,X1:RETURN
2000 IF B(XC,YC)=-1 THEN PRINT@XC*3+YC*64-1,STRING$(3,CHR$(191));ELSE PRINT@(XC-1)*3+YC*64-1,B(XC,YC);
2010 RETURN
3000 FOR X1=1TOXM:FORY1=1TOYM:BT=B(X1,Y1):IF BT>1 THEN BT=1
3010 PRINT@(X1-1)*3+Y1*64-1,B$(BT+7);:NEXTY1,X1:RETURN
