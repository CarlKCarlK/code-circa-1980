335 PRINT
340 PRINT
345 FORJ=1TO5
350 E(J)=0
355 NEXT J
360 P4=0
365 GOSUB875
370 FORJ=1TO2
375 W(J)=0
380 D(J)=0
385 T(J)=0
390 B(J)=U*I(J)+C(J)
395 GOSUB900
400 NEXTJ
405 PRINT
410 Q=Q+1
415 GOSUB1060
420 GOSUB675
425 GOSUB865
435 FORJ=1TO2
440 D(J)=(1-E(5))*.5*(K2+2*V(J)*D1)/(P(J)/50)[N
445 NEXTJ
450 GOSUB1000
455 FORJ=1TO2
460 IFD(J)>I(J)THEN475
465 T(J)=D(J)
470 GOTO480
475 T(J)=I(J)
480 LETT(J)=INT(T(J))
485 C(J)=C(J)+T(J)*P(J)
490 I(J)=I(J)-T(J)
495 NEXTJ
500 FORJ=1TO2
505 C(J)=C(J)-R*I(J)*U-K3*C(J)*(SGN(C(J))-SGN(C(J))[2)/2
510 C(J)=INT(C(J))
515 IFE(5)=0THEN530
520 W(J)=0
525 GOTO540
530 IFT(1)+T(2)=0THEN520
535 W(J)=INT(10000*T(J)/(T(1)+T(2)))/100
540 NEXTJ
545 FORJ=1TO2
550 GOSUB900
555 B(J)=C(J)+U*I(J)
560 IFB(J)>0THEN580
565 PRINT
570 GOSUB975
575 PRINT
580 IFB(J)<M1THEN620
585 IFB(J)<=C(3-J)+U*I(3-J)THEN620
590 P4=17
595 PRINT
600 PRINTTAB(14);"********************"
605 PRINTN$(J)",YOU HAVE REACHED ".001*M1"MILLION AND WON"
610 PRINTTAB(14)"********************"
615 PRINT
