1150 CLEAR 200:DEFINT A-Z
1160 DIM M(1),E(1),A(1),B(1),X(1),Y(1)
1200 FOR Y=0TO46:IF POINT(0,Y)AND S=0THENFORX=0TO127:IF NOT POINT(X,Y+1)THEN X(0)=X:Y(0)=Y+1:S=1 ELSE NEXT X:STOP
1230 IF NOT POINT(0,Y) AND S=1 THEN FORX=0TO127:IFNOTPOINT(X,Y-2)THEN X(1)=X:Y(1)=Y-2:S=2ELSENEXTX:STOP
1260 IF S=2 THEN K=RND(2)-1:I=RND(2)-1:S=0 ELSE NEXTY:STOP
1270 FORJ=0TO1:SET(X(J),Y(J)):SET(X(J)+1,Y(J)):A(J)=X(J):B(J)=Y(J):NEXTJ
1280 C(0)=1:C(1)=0:C(2)=-1:C(3)=0:S(0)=0:S(1)=1:S(2)=0:S(3)=-1:     C1(0)=3:C1(1)=0:C1(2)=-3:C1(3)=0:C2(0)=2:C2(1)=0:C2(2)=-1:        C2(3)=0
1300 I=1-I:M$="":T=T+1
1302 SC=0:F2=1:FORA=3TO0STEP-1:X1=X(I)+C1(A):X2=X(I)+C2(A):Y=Y(I)+S(A):IF X1>=0 AND X2>=0 THEN T(A*2+1)= POINT(X1,Y)ORPOINT(X2,Y)ELSE T(A*2+1)=-1
1304 T(A*2)= (X1=A(0)ANDY=B(0)) OR (X1=A(1)ANDY=B(1)) 
1306 IF X1=X(1-I) AND Y=Y(1-I) AND (NOT POINT(X2,Y)ORC(A)=0)THEN IF T(A*2) THEN F2=-1 ELSE T(A*2)=-1
1308 SC=SC*4-T(A*2+1)*2-T(A*2):NEXTA:SC=SC*F2
1315 'ON ERROR GOTO 1450
1320 IF I=K THEN GOSUB 6000 ELSE GOSUB 5000
1330 IF 0<=SC AND SC<=3 THEN IF NOT T(SC*2+1) THEN S=0ELSES=S+1:SC=4  ELSE S=S+1:SC=4
1340 IF S>20 THEN 1500
1350 IF M$<>""THEN M$=M$+STRING$(33," "):FORL=0TO2:PRINT@I*64*4+52+64*L,MID$(M$,L*11+1,11);:NEXTL
1360 IF SC=4 OR T(SC*2+1) THEN 1400
1365 X=X(I)+C(SC)*3:Y=Y(I)+S(SC)
1370 IF SC=1 OR SC=3 THEN SET(X,Y):RESET(X(I),Y(I)):SET(X+1,Y):RESET(X(I)+1,Y(I)):GOTO1390
1375 IF SC=2THEN SET(X+2,Y):RESET(X+4,Y):SET(X+1,Y):RESET(X+3,Y):SET(X,Y):RESET(X+2,Y)
1380 IF SC=0THENSET(X-1,Y):RESET(X-3,Y):SET(X,Y):RESET(X-2,Y):SET(X+1,Y):RESET(X-1,Y)
1390 X(I)=X:Y(I)=Y
1395 IF Y=B(I) AND X=A(I) AND M(I)=1THEN 1600 ELSE IF Y=B(1-I) AND X=A(1-I)THENM(I)=1
1400 GOTO 1300
1450 SC=4:M$="":E(I)=E(I)+1:RESUME 1330
1500 PRINT@960,"";:PRINT"TEN MOVES -- ";:FORI=0TO1:D(I)=M(I)*SQR( (A(0)-A(1))[2+(B(0)-B(1))[2)+SQR( (X(I)-A(ABS(M(I)-I)))[2+(Y(I)-B(ABS(M(I)-I)))[2):GOSUB 1550:PRINTI")";D(I);:GOSUB1550:D(I)=RND(D(I)):PRINT" ->";D(I)"  ";:NEXTI
1510  IF D(0)=D(1) THEN D(RND(2)-1)=-1
1515 IF E(0)=E(1) AND E(0)<>0  THEN D(RND(2)-1)=-1
1520 GOSUB1550:PRINT"THE WINNER IS ";:IF D(0)>D(1)ORE(0)<E(1)THENPRINT"THE TOP STARTING RAT!!!!!(BREAK)";ELSEPRINT"THE BOTTOM STARTING RAT (BREAK)";  
1525 IF E(0)+E(1)>0 THEN PRINT"WON BY ERROR COUNT"
1530 GOTO 1530
1550 FOR K=1TO500:NEXTK:RETURN
1600 PRINT@960,"";:IF I=0THENPRINT"THE RAT THAT STARTED AND THE TOP WINS !!!!!!!!!!!!!! (BREAK)";ELSE PRINT"THE WINNER IS THE RAT THAT STARTED AT THE BOTTOM!!!!!! (BREAK)";
1610 GOTO 1610
5000 SC=ABS(SC):M$="RDL"+STR$(SC):GOSUB 5010:SC=LOG(PEEK(14352)+.001)/LOG(2)-1:IF FT(I)=0THENFT(I)=1
5005 RETURN
5010 SZ(I,3)=SC/64:SZ(I,2)=(SC-SZ(I,3)*64)/16:SZ(I,1)=(SC-SZ(I,3)*64-SZ(I,2)*16)/4:SZ(I,0)=(SC-SZ(I,3)*64-SZ(I,2)*16-SZ(I,1)*4):CZ$(I,0)="":CZ$(I,1)="":CZ$(I,2)=CHR$(191):CZ$(I,3)="R":CZ$(I,4)=CHR$(128-3*(SZ(I,3)>1)-4*(SZ(I,0)>1)-8*(SZ(I,2)>1)-48*(SZ(I,1)>1))
5020 M$=M$+"..."+CZ$(I,4)+"..."+STR$(SZ(I,3))+STR$(SZ(I,2))+STR$(SZ(I,0))+STR$(SZ(I,1))+STR$(SC):RETURN
5312 IF CK<=1 AND EK THEN AK(I)=SC+2AND3:SC=4:EK(I)=3:RETURN
6000 'RICKY RAT  BY CARL KADIE   6 AUG 82   K
6010 IF FKTHEN6020ELSE FK=-1:DIM SK(1,4),CK(1,4),GK(1,4,100),MK(3),XK(1),YK(1),AK(1),OK(1),TK(1),HK(1),EK(1),NK(1),DK(1),LK(1):ZK(0)=100:ZK(1)=100
6020 'MAIN
6030 IF SC<0 THEN SC=-SC:RK=-1ELSERK=0
6040 SK=SC:FORIK=0TO3:MK(IK)=SK-INT(SK/4)*4:SK=SK/4:NEXTIK
6045 FOR IK=0TO3:IFMK(IK)=1THEN GK=-1ELSENEXTIK:GK=RK
6050 FOR IK=0TO3:IF MK(IK)=3THENEK=-1ELSENEXTIK:EK=0
6060 IF RKTHENFORIK=0TO3:IF MK(IK)<>3 THEN NEXTIKELSE MK(IK)=3
6065 CK=0:FOR IK=0TO3:IFMK(IK)<>2THENCK=CK+1
6066 NEXT IK
6070 ON OK(I)+1  GOSUB 6150,6200,6350,6400
6080 IF 0<=SC AND SC<=3 THEN IF MK(SC)>2 THEN M$="ERROR"+STR$(SC)+"-"+M$:SC=4ELSE DK(I)=DK(I)+WK(I):RK(I)=RK(I)+WK(I)ELSESC=4
6090 XK(I)=XK(I)+CK(I,SC):YK(I)=YK(I)+SK(I,SC)
6100  TK(I)=TK(I)+1:IF SC=4 THEN HK(I)=HK(I)+1ELSE HK(I)=0
6110  RETURN :'MAIN
6150 ' OPS 0
6160 M$="RICKY RAT A RODENT TO BE PROUD OF"
6170 FOR IK=0TO4:CK(I,IK)=VAL(MID$(" 1 0-1 0 0",IK+IK+1,2)):SK(I,IK)=VAL(MID$(" 0 1 0-1 0",IK+IK+1,2)):NEXTIK
6180 OK(I)=1:LK(I)= SGN(RND(0)-.5):FORIK=0TO3:IFMK(IK)=0THENSC=IKELSE NEXT IK
6185 AK(I)=SC:WK(I)=1
6190 RETURN
6200 'OPS 1  ASCENT
6205 IF CK<=1 AND NOT EKTHEN WK(I)=-1
6210 IF XK(I)=0 AND ABS(YK(I))=1 AND GK AND NOT RK THEN ELSE 6240
6220 FOR IK=0TO3:IF MK(IK)<>1OR XK(I)=0 OR ABS(YK(I))<=1THEN NEXTIK:GOTO6240
6230 OK(I)=2:EK(I)=0:RETURN
6240 AK=AK(I):IF EK(I)>0 OR RKTHEN6300 ELSE FOR IK=0TO3:IFMK(LK(I)*IK+AK(I)-LK(I)AND3)<>2THENSC=LK(I)*IK+AK(I)-LK(I)AND3ELSE NEXTIK
6250 AK(I)=SC:IFMK(SC)=3 THEN AK(I)=AK:GOTO6300 ELSE IF CK<=2 THEN 6280
6255 JK=NK(I):IFJK>=1THENIFGK(I,0,JK-1)=XK(I)ANDGK(I,1,JK-1)=YK(I)THENJK=JK-1:GOTO 6270
6260  JK=NK(I):IF GK(I,0,JK)=XK(I)AND GK(I,1,JK)=YK(I) THEN6270 ELSEJK=JK+1:IF JK> ZK(I)THENM$="OVER"+M$:G(I,3,2)=G(I,3,2)+G(I,3,1):FORIK=2TOZK(I):FORLK=0TO4:G(I,LK,IK-1)=G(I,LK,IK):NEXTLK,IK:JK=ZK(I)
6265 NK(I)=JK:GK(I,0,JK)=XK(I):GK(I,1,JK)=YK(I):GK(I,2,JK)=SC+2AND3:GK(I,3,JK)=DK(I):GK(I,4,JK)=RK(I)
6270 NK(I)=JK:DK(I)=0:RK(I)=GK(I,4,JK):WK(I)=1
6280 M$=M$+STR$(DK(I))+STR$(RK(I))+STR$(NK(I))+STR$(CK) :RETURN: 'NO ERROR RETURN
6300 IF  (EK(I)=3ANDEK)OR RK OR ((NK(I)<=2ANDWK(I)=1) AND EK(I)=0)OR (EK(I)=0 AND HK(I)<10)OR (CK<=1ANDEK)THEN SC=4 :RETURN
6310 IF EK(I)=0 THEN EK(I)=1:AK(I)=2+AK(I)AND3
6315 JK=NK(I):IF GK(I,0,JK)=XK(I)AND GK(I,1,JK)=YK(I)THENSC=GK(I,2,JK):AK(I)=SC+2AND3:EK(I)=3:RETURN
6320 IF EK(I)=1 AND EK THEN FOR IK=-1TO1:IFMK(IK+AK(I)AND3)=0THENSC=IK+AK(I):AK(I)=SCELSENEXTIK:M$="ERROR IN ERROR ROUTINE"+M$
6330 IF EK(I)=3 THEN AK(I)=AK(I)+2AND3:EK(I)=0:M$="VICKY VOCKY VICA"+M$:GOTO6200
6340 RETURN
