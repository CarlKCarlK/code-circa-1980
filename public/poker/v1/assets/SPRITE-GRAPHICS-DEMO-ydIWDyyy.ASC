10 CLS
20 LINE(6,0)-(18,2),SET,BF
30 RESET(6,2):RESET(7,2):RESET(14,0):RESET(17,0):RESET(18,0):RESET(18,2):LINE(10,2)-(15,2),RESET
40 DIM T%(30),A%(30),B%(30),C%(30),D%(30),E%(30)
50 GET@(0,0)-(18,2),G,T%
60 CLS
70 TM=53
75 DA=0:RN=RND(20)
80 CLS
90 LINE(0,15)-(35,25),SET,BF
100 LINE(127,15)-(82,25),SET,BF
110 LINE(35,15)-(82,15),SET:'CROSS
120 LINE(51,15)-(52,25),SET,B:'LEFT SUPPORT
130 LINE(67,15)-(68,25),SET,B:'RIGHT SUPPORT
140 A$=INKEY$:IFA$=""THEN 1000 
145 IF A$=" "THEN SV=0:GOTO1000
150 SV=SV+1:IFSV/2=INT(SV/2) THEN G=VAL(O$)*10+VAL(A$)ELSEO$=A$:GOTO 1000
160 PRINT@960,G;"      ";
170 IF G=RN THEN 500ELSEIFG>RNTHENPRINT"TOO BIG!";ELSEPRINT"TOO SMALL!";
180 GOTO 1000
500 PRINT"EXPLOSIVE DIVICE DEACTIVEATED.";
510 DA=1
1000 IF DA=0THENTM=TM-1:IFTM<0 THEN1050 
1010 PRINT@900,"TIME LEFT";TM;
1020 X=X+1:IFX>108 THEN LINE(0,12)-(127,14),RESET,BF:PRINT@800,"GOOD JOB!"
1030 PUT@(X,12)-(X+18,14),SET,T%
1040 GOTO 140  
1050 GET@(49,12)-(53,14),G,A%:GET@(49,15)-(53,17),G,B%
1060 GET@(54,12)-(71,13),G,C%:GET@(54,14)-(68,17),G,D%
1070 GET@(69,14)-(71,17),G,E%
1080 LINE(49,12)-(71,17),RESET,BF
1090 Y=0
1100 FORX=0TO-2STEP-.1
1110 RX=X
1120 IF X<-1 THEN RX=-2-X
1130 AX=RX*7:BX=RX*10:DX=RX*14:CX=RX*8:EX=RX*8
1140 Y=Y+.1
1150 AY=-Y*14:BY=-Y*10:DY=Y*3:CY=Y*20:EY=Y*15
1160 FORSC=1TO2
1170 PUT@(49+AY,12+AX)-(53+AY,14+AX),XOR,A%:GOTO 1180 :PUT@(49+BY,15+BX)-(53+BY,17+BX),XOR,B%
1180 PUT@(54+CY     ,12+CX     )-(71 +CY   ,13 +CX    ),XOR,C%:PUT@(54 +DY    ,14 +DX   )-(68 +DY   ,17 +DX   ),XOR,D%
1190 PUT@(69+EY    ,14 +EX   )-(71  +EY ,17  +EX  ),XOR,E%
1200 NEXT SC
1210 NEXTX
1220 X=0:FORT=1TO1000:NEXT:GOTO60   
