10 ' THE WORLD
20 CLEAR 500
30 L=RND(8):FORX=1TOL:W$=CHR$(RND(26)+64)+W$:NEXT
40 CLS
50 PRINT:PRINT:PRINT:PRINT"WELCOME TO THE PLANET OF";W$:L$="ARGON'S CITY GATES":GOTO70   
60 CLS:RESTORE
70 READD$:IFD$="DONE"THEN100  ELSEIF INSTR(D$,L$)=0OR INSTR(D$,"*")<>0THEN70   
80 IFRIGHT$(D$,1)="&"THENPRINTLEFT$(D$,LEN(D$)-1);:READD$:GOTO80   ELSEPRINTD$
90 GOTO110  
100 PRINT:PRINT:PRINT:PRINT"I'M SORRY BUT AT THE PRESENT TIME ";L$;" IS OFF LIMITS TO YOU."
110 PRINT:INPUT"WHAT ARE YOUR ORDERS";O$
120 IFO$="HELP"THEN270  
130 RESTORE
140 READ D$:IFD$="DONE"THEN200  
150 W=INSTR(D$,L$)
160 IFW=0 OR INSTR(D$,"*")=0THEN140
170 IFW=1 AND INSTR(D$,O$) > INSTR(D$,"*")THENL$ = MID$( D$,INSTR(D$,"1")+1,INSTR(D$,"2")-INSTR(D$,"1")-1):GOTO60
180 IFW>1 AND INSTR(D$,O$) < INSTR(D$,"*")THEN L$=LEFT$(D$,INSTR(D$,"1")-1):GOTO60
190 GOTO140
200 L=RND(5): ON L GOTO 210  ,220  ,230  ,240  ,250  
210 PRINT"YOU WANT TO DO THE IMMPOSIBLE.":GOTO260  
220 PRINT"YOU CAN'T DO THAT.":GOTO260  
230 PRINT"IT IS IMMPOSIBLE DO TO THAT.":GOTO260  
240 PRINT"THAT IS NOT A CHOICE.":GOTO260  
250 PRINT"SORRY, YOU CAN'T DO THAT."
260 GOTO110  
270 CLS:RESTORE
280 PRINT"FROM ";L$". YOU MAY COMMAND:"
290 READ D$:IFD$="DONE" THEN 110
300 W=INSTR(D$,L$):IFW=0ORINSTR(D$,"*")=0THEN290
302 IFW>1THENPRINT MID$(D$,INSTR(D$,"2")+1,INSTR(D$,"*")-INSTR(D$,"2")-1)
304 IFW=1 THEN PRINT RIGHT$(D$,LEN(D$)-INSTR(D$,"*"))
306 GOTO290
310 DATA"YOU ARE NOW STANDING AT A BREATH-TAKING GATE KNOW AS 'ARGON'S CITY GATES' THE GATES ARE MADE OF SOLID GOLD AT THEIR BEUTIFUL BARS REACH 30 METERS INTO THE SKY. ON THE CITY SIDE OF THE GATES IS ARGON AN ARCHTECITS DREAM AND ON THE&"
320 DATA" FOREST SIDE IS THIS PLANETS LARGEST WILD LIFE AREA.","ARGON WILD LIFE AREA1ARGON'S CITY GATES2FOREST WILD SOUTH*GATE NORTH CITY LEAVE","THE ARGON WILD LIFE AREA IS THE LARGEST IN THE WORL&"
330 DATA"D. YOU ARE STANDING ON A VAST LOOK OUT PLATFORM, 100 METERS ABOVE THE ANIMALS. IN THE DISTANCE YOU SEE AN AFRICAN ELIPHANT SPRAYING WATER ON IT'S YOUNG AND TWO BEAR CUBS PLAYING."
340 DATA"YOU ARE NOW ON THE ARGON GUARD TOWER. FROM THIS OUTPOST YOU CAN SEE THE CITY OF ARGON. THE TOWER ITSELF IS ONLY 100 FEET HIGH BUT YOU CAN SEE ALL COMINGS AND GOINGS THOUGH THE THICK STONE WALLS."
350 DATA"ARGON GUARD TOWER1ARGON'S CITY GATES2DOWN STAIRS GATES*UP STAIRS TOWER
10000 DATA"DONE"
