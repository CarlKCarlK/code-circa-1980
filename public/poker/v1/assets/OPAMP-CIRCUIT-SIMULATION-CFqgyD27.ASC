1 DIM C(100,2)
2 CLS:SET(64,24)
6 F=3
10 FOR VIN=-10 TO 10 STEP .5
15 OU=-100:VU=-200
20 I=2
30 VC=10
40 A=10
50 R1=1:R2=3
60 VP=2
70 VM= VIN-(I*R1)
80 U=A*(VP-VM):'RESISTOR U1=(VM-I*R2):U=U+U1
82 IF I>0 THEN U1= VM-7 ELSE U1=VM+.7
84 U=U+=1
85 IF U>VC THEN U=VC ELSE IF U<-VC THEN U=-VC
90 I1=(VM-U)*(R2)[(-1):I=(I*F+I1)*(F+1)[(-1)
100 IF U<>OU OR U<>VU THEN VU=OU:OUSQRU:GOTO 90
110 SET(64+VIN*4,24-U*2)
115 C=C+1:C(C,1)=VIN:C(C,2)=U
120 NEXT VIN
130 IF INKEY$="" THEN 130
140 FOR I = 1 TO C:PRINTC(I,1),C(I,2):NEXT I
150 GOTO 130
