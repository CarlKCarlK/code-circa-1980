10 REM life backwards april 27, 1985
90 DEFINT A-Z
100 DX=20:DY=20
110 DIM CN(375,1),NW(DX,DY),OD(DX,DY)
330 CLS
340 OPEN "lifed.do" FOR INPUT AS #1
350 FOR I=0TO1:TZ=0
360 INPUT #1,CN(TZ,I):IF CN(TZ,I)=-1 THEN NEXT I :ELSE TZ=TZ+1:GOTO 360
370 FOR I=1 TO 9:MK(I)=2^(I-1):NEXT I
500 'main program
510 GOSUB 1000:'begin
520 GOSUB 2000:'reset
530 GOSUB 3000:'first_post
550 GOSUB 6000:IF NOT(C6) THEN	GOSUB 7000: GOTO 550
580 GOSUB 4000  :'go in
590 IF PS(0) >=0  THEN 550
600 GOSUB 9000:'new=next_con(old)
610 GOTO 520
1000 'begin - read in life board
1005 GOSUB 1100
1010 READ P1(0),P1(1):				IF P1(0)<0 THEN GOSUB 8300:RETURN
1020 NW(P1(0),P1(1)) =1
1030 GOSUB 1200:GOTO 1010
1100 'set-up new fields
1110 FOR I1=0TO1:FD(0,I1)=0:FD(1,I1)=0:	NEXTI1:RETURN
1200 'ajust field
1210 IF NW(P1(0),P1(1))=0 THEN RETURN
1230 FOR I1 =0TO 1:				IF FD(1,I1)=0				 THEN FD(0,I1)=P1(I1):				FD(1,I1)=1			:ELSE IF P1(I1)<FD(0,I1)				THEN FD(1,I1)=FD(1,I1)+			FD(0,I1)-P1(I1):			FD(0,I1)=P1(I1)			:ELSE IF P1(I1)> FD(0,I1)+			FD(1,I1) THEN FD(1,I1)=			P1(I1)-FD(0,I1)+1
1240 NEXT I1
1250 RETURN
2000 'reset
2010 FOR I1=0TO DX:FORJ1=0TODY:OD(I1,J1)=0:NEXTJ1,I1
2020 FOR I1=0 TO FD(1,0)-1:FORJ1=1TOFD(1,1):OD(FD(0,0)+I1,FD(0,1)+J1)=-1:NEXTJ1,I1
2030 GOSUB 8000
2040 RETURN
3000 'first position
3010 S3= -NOT(FD(1,0)<FD(1,1))
3020 W3=FD(1,S3)/2
3030 PS(0)=FD(0,0)-2:PS(1)=FD(0,1)-1
3040 C3(S3)=0
3050 C3(1-S3)=FD(1,1-S3)-FD(1,S3)
3060 D3(0)=1:D3(1)=0
3065 GOSUB 8100
3070 RETURN
4000 'toward inside
4005 IF PS(0)=FD(0,0) AND PS(1)=FD(0,1) THEN PS(0)=-1:RETURN
4010 FORI4=0TO1:F4(I4)=PS(I4)-FD(0,I4)+1:		NEXT I4
4030 IF F4(0)=F4(1) AND F4(0)^=W3 THEN 		PS(0)=PS(0)+1:PS(1)=PS(1)+1
4040 FOR I4=0 TO 1:				T4!(I4)=INT(C3(I4)/2)+W3+.5:		G4(I4)=T4!(I4)-ABS(T4!(I4)-F4(I4)):		NEXTI4
4050 IF G4(0)=G4(1) AND G4(0)<=W3 		THEN :ELSE 4070
4060        FORI4=0TO1:IF D3(I4)<>0			THEN D3(I4)=0 :ELSE			D3(I4)=SGN(F4(0)-T4!(0))
4065 		NEXT I4
4070 FOR I4=0TO1:PS(I4)=PS(I4)-D3(I4):		NEXT I4
4080 GOSUB 8200
4090 RETURN
5000 'debug
5005 PRINT"i,j,nw,od,cn"
5010 FOR I5=8TO12:FOR J5=12TO8STEP-1
5020 PRINTI5;J5;NW(I5,J5);OD(I5,J5);:IF OD(I5,J5) <> -1 THEN PRINTCN(OD(I5,J5),NW(I5,J5));
5030 PRINT:NEXTJ5,I5
5035 PRINT"i,j,t"
5040 FOR I5=0TO4:FORJ5=4TO0STEP-1
5050 PRINTI5+PS(0)-2;J5+PS(1)-2;T6(I5,J5)
5060 NEXTJ5,I5
5070 PRINT"x,y=";PS(0);PS(1)
5080 STOP
5090 RETURN
6000 'check compatibility return c6
6010 FOR I6=0TO6:FORJ6=0TO6:T6(I6,J6)=-1	:NEXT J6,I6
6020 FOR I6=-3TO3:FORJ6=-3TO3
6030 	H6=OD(I6+PS(0),J6+PS(1))
6040 	IF H6=-1 OR (I6=0 AND J\x12]0) 		THEN 6110
6050 	H6=CN(H6,NW(I6+PS(0),			J6+PS(1)))
6060 	FOR K6=-1TO1:FORL6=-1TO1
6070 	  B6(0)=I6+K6:B6(1)=J6+L6
6080 	  N6=(H6 AND 1):H0MENUWIDTHlLLISTLCOPY
