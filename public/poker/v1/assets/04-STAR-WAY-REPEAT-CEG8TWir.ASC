5 CLEAR1000
7 CLS:GOTO1000
8 '
10 S$=CHR$(183)+" "+CHR$(140)+" "+CHR$(187)
15 D$="<=O=>"
20 CLS
30 EX=.9:EY=2
40 XG=EX:YG=EY
50 PRINT@967,"ESCAPED  0";
60 ET=50000:PRINT@1003,"ENERGY ";ET;:PRINT@980,"DESTROYED  0";
70 F=1
90 FORG=1TO9:X=RND(29)+15:Y=RND(7)+3:IFG=9THENS$=D$:F=2
200 X=X+(RND(3)-2)*2*F:Y=Y+(RND(3)-2)*F
205 A$=INKEY$:IFA$="D"ORA$="L"THENXX=1:YY=0ELSEIFA$="F"ORA$=";"THENXX=-1:YY=0ELSEIFA$="A"ORA$="J"THENXX=0:YY=1ELSEIFA$="S"ORA$="K"THENXX=0:YY=-1ELSEIFA$="G"ORA$="H"THENXX=0:YY=0
206 XG=XG*2:YG=YG*1.4:IFXG>63ORYG>23THENXG=EX:YG=EYELSERESET(XH+64,24+YH):SET(XG+64,24+YG):RESET(64-XH,24-YH):SET(64-XG,24-YG):RESET(64+XH,24-YH):SET(64+XG,24-YG):RESET(64-XH,24+YH):SET(64-XG,24+YG):XH=XG:YH=YG
208 X=X+XX*F:Y=Y+YY*F
210 IFX<0ORX>58ORY<0ORY>14THEN ES=ES+F:PRINT@975,ES;:GOTO250
215 IFA$<>" "THEN220ELSEET=ET-1000*F:IFET<=0THEN253ELSEPRINT@1010,ET;:PRINT@448,STRING$(30,94):PRINT@482,STRING$(30,93);:IFABS(480-O-2)<3THENPRINT@480,"*";:HH=HH+F:PRINT@990,HH;:GOTO250
220 R=X+Y*64
225 PRINT@448,STRING$(63,32);:PRINT@470,CHR$(94);:PRINT@490,CHR$(93);:PRINT@352,CHR$(92);:PRINT@607,CHR$(91);
230 PRINT@O,"     ";:PRINT@R,S$;:O=R
240 GOTO200
250 NEXT
251 GOTO255
253 PRINT:PRINT"YOU HAVE RUN OUT OF ENERGY. IF YOU HAD LIVED YOU WOULD HAVE      RECEIVED THIS MESSAGE :"
255 PRINT:FORX=1TO500:NEXT
260 FORJ=1TOHH+1:READA$:NEXT:PRINTA$:PRINT:PRINT:PRINT"GOOD-BYE AND MAY THE FORCE BE WITH YOU!"
270 PRINT:PRINT:PRINT:PRINT
999 END
1000 READA$:IFA$="DONE"THENFORCC=10TO1STEP-1:FORCB=1TO500:NEXT:PRINTCC:NEXT:GOTO8  ELSEIFA$="PAUSE"THEN2000ELSEPRINTTAB(32-LEN(A$)/2)A$:GOTO1000
2000 IFINKEY$=""THEN2000ELSECLS:GOTO1000
9999 END
