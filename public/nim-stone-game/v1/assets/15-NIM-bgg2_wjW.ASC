2 DEFINT A-Z
5 CLS
10 PRINT "NIM"
20 FORX=1 TO 1000:NEXT X
30 CLS
40 PRINT "YOU GO FIRST"
50 INPUT X
60 IF X<>1 AND X<>2 THEN PRINT "CHEAT!!!"
70 Y=Y+X
80 GOSUB 1000
90 Z=3-X
100 Y=Y+Z
105 FORX=1 TO 500:NEXT X
107 PRINT"I ADD"Z
110 GOSUB 1000
120 IF Y>20.5 THEN PRINT "I WIN!!!":END
130 PRINT
140 GOTO 50
1000 PRINT"NUMBER OF STONES IN PILE"Y
1010 RETURN
