10 CLS:PRINT"PENDULUM  --  A COMPUTERIZED PHYSICS EXPERIMENT.":PRINT
60 INPUT"HOW MANY TIMES SHOUD THE PENDULUM SWING";SS
65 IFINT(SS*2)<>SS*2THENPRINT"SORRY BUT FOR ACCURATE MEASUREMENT THE NUMBER OF SWINGS MUST BE A FULL OR HALF SWING.":GOTO60ELSEPRINT
70 R=1
80 PI=3.14159265359
90 G=9.79783
100 INPUT"WHERE IS THE PENDULUM";L$
110 IF L$ <>"EARTH"ANDL$<>"E" THEN PRINT"WHAT IS THE ACCELERATION DUE TO GAVITY ON "L$" (METER/SEC[2)";:INPUTG
120 PRINT
130 INPUT"HOW LONG IS THE STRING (METERS)";L
200 T=2*PI*SQR(L/G)
400 CLS
410 FORYU=0TO4:SET(64,YU):NEXT
420 TI=T/60
470 H=1
490 FORSI=1TOSS*2:H=H*-1
500 FORX=H*.75TOH*-1*.75STEP.05*H*-1
510 Y=SQR(R*R-X*X)
520 YG=Y*36+11
530 XG=(.75+X)*84
535 RESET(XO,YO):RESET(XO+1,YO)
540 SET(XG,YG):SET(XG+1,YG)
550 XO=XG:YO=YG
555 PRINT@412,TT;
556 PRINT@476,"ELASED TIME"
560 TT=TT+TI
570 NEXT:NEXT
580 LL=402:PRINT@LL,"TIME/PERIOD";T;"SEC":PRINT@LL+64,"TOTAL TIME";T*SS"SEC":PRINT@LL+128,"FREQUENCY";1/T"CYCLES/SEC"
650 A$=INKEY$:IFA$=""THEN650ELSERUN10
