1 LOOK AT 120
10 CLS:CLEAR50:DEFINT A-Z:DIMB(2,2),R(600,10):F(0)=600:C$=".XO":G=0
20 G=G+1:T=0:FORX=0TO2:FORY=0TO2:B(X,Y)=0:NEXTY,X:FORI=0TO9:T(I,0)=0:T(I,1)=0:NEXTI
30 T=T+1:IFT=10THEN****ELSEIFT=1THENR=0:GOTO50ELSERESTORE:R=30000:FORI=1TO4:READSO,SI:N1=0:N2=0:FOROU=SOTO2-SOSTEPSGN(1-SO):FORIN=SITO2-SISTEPSGN(1-SI):N1=B(IN,OU)+N1*3:N2=B(OU,IN)+N2*3:NEXTIN,OU:IFN1<RORN2<RTHENR=N1:IFN2<N1THENR=N2
31 DATA0,0,0,2,2,0,2,2,0
50 N2=R:FORY=0TO2:FORX=0TO2:I=Y*3+X:N1=INT(N2/INT(3[(8-I)+.5)):N2=N2-N1*INT(3[(8-I)+.5):B(X,Y)=N1:PRINT@X*4+Y*64,MID$(C$,N1+1,1);:NEXTX,Y
60 IFP(T,0)=0 THEN P(T,0)=ND+1:I=0:GOTO80ELSEI=D(P(T,0),9):GOTO80
70 I=D(I,9)
80 IFI<>0THEN100ELSEND=ND+1:D(ND,10)=R:I=ND:D(P(T,0),9)=ND:D(ND,9)=0:P(T,1)=ND:FORX=0TO2:FORY=0TO2:B=B(X,Y):IFB(X,Y)=0THENB=INT(T/2+.5)ELSEB=-1
90 D(ND,Y*3+X)=B:NEXTY,X
100 IFD(I,10)<>RTHEN70ELSEIFF(1)=1THEN200ELSEFORJ=0TO8:IFD(I,0)>0THENR1=R1+D(I,0)
110 NEXTJ:IFR1=0THENGOSUB400R1=RND(R1):J=-1
120 J=J+1:R1=R1-D(I,J):IFR1>0THEN120
130 T(T,0)=I:T(T,1)=J:Y=INT(J/3):X=J-Y*3:B(X,Y)=(INT(T/2)<>T/2)+2:PRINT@X*4+Y*64,MID$(C$,B(X,Y)+1,1);
200 PRINT:PRINT:PRINT:INPUT"X,Y";X,Y:J=(X-1)+(Y-1)*3:IFD(I,J)<0 THEN 200 ELSE130
400 FORJ=0TO8:IFD(I,J)=0THEND(I,J)=INT(T/2+.5)
410 NEXTJ:RETURN
