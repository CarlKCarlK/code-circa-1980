10 DIMDBLP,Q
20 VF=1:HF=1
200 G=G+1:INPUT"WHO GOES FIRST (TYPE 'YOU' , 'ME' , OR 'RANDOM'";F$
210 IFF$="YOU"THENP=-1ELSEIFF$="ME"THENP=1ELSEP=(RND(2)-1.5)*2
250 FORM=1TO9
260 P=-P
270 IFP<0THENPRINT"7 8 9":"4 5 6":"1 2 3":INPUT"WHERE DO YOU MOVE";Z:GOSUB8000:GOSUB10000:
1000 'H
1010 FORC=1TO3
1020 X$=B$(C,1):B$(C,1)=B$(C,3):B$(C,3)=X$:X$=""
2000 'V
2010 FORC=1TO3
2020 X$=B$(1,C):B$(1,C)=B$(3,C):B$(3,C)=X$:X$=""
2030 NEXT:RETURN
3000 'PRINT BOARD
3010 IFVF=-1THENGOSUB2000
3015 IFHF=-1THENGOSUB1000
3020 PRINT@0,"";
3030 FORC=3TO1STEP-1
3040 FORD=1TO3
3050 IFB$(D,C)=""THENPRINT"  ";ELSEPRINTB$(D,C);
3060 NEXT
3070 PRINT:NEXT
3090 PRINT:PRINT:PRINT
3100 IFVF=-1THENGOSUB2000
3110 IFHF=-1THENGOSUB2000
3120 RETURN
4000 ' CHECKS FOR WINNER
4010 RESTORE
4015 FORJ=1TO8
4020 DATA1,3,2,3,3,3,1,2,2,2,3,2,1,1,2,1,3,1,1,3,1,2,1,1,2,3,2,2,2,1,3,3,3,2,3,1,1,1,2,2,3,3,1,3,2,2,3,1
4025 W=1
4028 FORF=1TO3
4030 READC,D
4035 PRINTC;D
4040 IFB$(C,D)=""THENW=0:GOTO4070
4050 IFF=1THENC$=B$(C,D)
4055 PRINTC$,B$(C,D)
4060 IFC$<>B$(C,D)THENW=0:GOTO4070
4065 PRINTF
4070 NEXTF
4080 IFW=1THEN5000ELSE4100
4100 C$="":NEXTJ:RETURN
5000 PRINT:PRINT:PRINT:IF(C$="X"ANDP=-1)OR(C$="O"ANDP=1)THENPRINT"HA, HA I HAVE WON!!!!!"ELSEPRINT"CONGRATULATIONS YOU HAVE WON."
5010 INPUT"WOULD YOU LIKE TO PLAY AGAIN";A$:IFA$="YES"THENNEXTGELSEEND
6000 '
6100 FORH=1TO G-1
6110 IFABS(P)<>ABS(VAL(LEFT$(STR$(P(H)),LEN(STR$(P)))))THEN6140
6120 L=VAL(MID$(STR$(P(H)),LEN(STR$(P))+1,1))
6130 T(L)=SGN(P(H))+T(L)
6140 NEXT
6150 FORH=1TO9
6170 IFT(H)>RTHENR=T(H)
6180 NEXT
6190 FORH=1TO9
6200 IFT(H)=RTHENQ=Q*10+H
6210 NEXT
6220 S=RND(LEN(STR$(Q))-1)
6230 V=VAL(MID$(STR$(Q),S+1,1))
6240 Z=V:GOSUB8000
6250 IFB$(X,Y)<>""THEN 6220ELSERETURN
7000 'FLIP?
7005 F1=0:F2=0:F4=0:F3=0
7010 FORCC=1TO3
7020 IFB$(CC,1)<>""THENF1=F1+1
7030 IFB$(CC,3)<>""THENF2=F2+1
7040 IFB$(1,CC)<>""THENF3=F3+1
7050 IFB$(3,CC)<>""THENF4=F4+1
7055 PRINTF1,F2,F3,F4:STOP
7060 IFF1<F2THENGOSUB1000:HF=-HF
7070 IFF3<F4THENGOSUB2000:VF=-VF
7080 RETURN
8000 Y=INT(Z/3):X=Z-Y*3:RETURN
10000 DEFDBL Q,P,Q:G=3:P(1)=123456:P(2)=123476:P=1234:GOSUB6000:PRINTV
10010 RUN10000
13000 B$(1,3)="X":GOSUB7000
