10 L=36
30 DIMA$(100)
40 RESTORE
50 Q=Q-1
60 Q=Q*4
70 S=S*2
80 CLEAR(1000)
90 POKE16553,255
95 'PLACE NUMBER QUESTION *2 HERE
100 FORI=1TOL
110 READA$(I)
120 NEXTI
180 C=0:U=0
190 K=-1
200 FORI=1TOQ STEP2
205 I=I+S
210 PRINT A$(I);"  ";
215 U=U+1
220 INPUTB$
230 IFB$=A$(I+1)THEN400
240 PRINT"THE CORRECT ANSWER IS ";A$(I+1)
250 K=K+2
260 A$(K)=A$(I):A$(K+1)=A$(I+1)
270 GOTO420
400 PRINT"THAT'S RIGHT !"
410 C=C+1
420 IFI*2>=QTHEN520
500 '
505 I=I-S
510 NEXTI
520 Q=U-C+1
590 IFU=OTHEN610
600 PRINT"OUT OF";U;" QUESTIONS, YOU GOT";C;" RIGHT.  THAT IS";100*C/U;"% RIGHT."
610 PRINT"WOULD YOU LIKE TO TRY THOSE YOU MISSED";:INPUTZ$:IF Z$="YES"THEN180
620 END
999 'PUT DATA HERE /
1000 DATA
