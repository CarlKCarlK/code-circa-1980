2 X=40:XO=X:Y=30:YO=Y
5 SE=1
10 CLS:LINE(0,0)-(15,0),SET:LINE(0,1)-(15,1),SET:LINE(1,2)-(14,2),SET:LINE(1,0)-(4,0),RESET:LINE(7,0)-(13,0),RESET
15 DIMS%(20),M%(20)
20 GET@(0,0)-(15,2),G,S%:CLS:LINE@(1,0)-(1,2),SET:SET(0,1):SET(2,3):SET(0,3):SET(2,1):GET@(0,0)-(2,3),G,M%
30 CLS
40 FORI=0TO383:PRINTCHR$(191);:NEXT
50 A$=INKEY$:IFA$="2"THENYY=1ELSEIFA$="1"THENYY=-1ELSEIFA$="3"THENXX=-1ELSEIFA$="4"THENXX=1ELSEIFA$=" "ANDF=0THENF=1:CM=XX:MX=X+7:MY=Y-1:NX=MX:NY=MY:MS=1
60 X=X+XX:Y=Y+YY*.1
64 IFY<17THENYY=0
70 PUT@(XO,YO)-(XO+15,YO+2),XOR,S%:IFSE<>1THENPUT@(X,Y)-(X+15,Y+2),XOR,S%:XO=X:YO=Y
75 SE=0
80 IFF<>1THEN150ELSEMX=MX+CM:MY=MY-3:IFMY<-3THENF=0
90 PUT@(NX,NY)-(NX+2,NY+3),XOR,M%:IFMS<>1THENPUT@(MX,MY)-(MX+2,MY+3),XOR,M%:NX=MX:NY=MY
95 MS=0
100 IFMX>130THENF=0
150 GOTO50
1000 GOTO1000
