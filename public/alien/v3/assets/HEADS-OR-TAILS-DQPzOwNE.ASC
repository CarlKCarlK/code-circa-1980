10 CLS
20 PRINT "HEADS OR TAILS ?"
30 INPUT A$
40 PRINT : PRINT : PRINT
50 FOR T=1 TO 1000 : NEXT T
60 R=RND (2)
70 IF R=1 THEN PRINT "HEADS" ELSE PRINT"TAILS"
80 FOR T=1 TO 500 :NEXT T
90 IF (R=1 AND A$="HEADS") OR (R=2 AND A$="TAILS")THEN PRINT "VICTORY" ELSE PRINT "DEFEAT"
100 IF INKEY$=""THEN 100  ELSE RUN
