10 DY=7:SG=3
20 CLS:PRINT:PRINT:PRINT:PRINT"BEWARE OF THE JABERWOCKY MY SON,"
25 PRINT"THE CLAWS THAT SCRACH,"
30 PRINT"THE JAWS THAT BITE."
100 DIM C(50,4)
110 FORX=1TO43:R=RND(2)
115 FORY=1TOR
120 T=RND(43)
130 O=C(X,0):W=C(T,0)
140 C(X,0)=O+1:C(T,0)=W+1
150 IF O>3 OR W>3THEN 200
160 C(X,O+1)=T:C(T,W+1)=X
200 NEXTY
210 FOR M=1TO4
220 R1=RND(4):R2=RND(4)
230 H=C(X,R1):C(X,R1)=C(X,R2):C(X,R2)=H
240 NEXTM
250 NEXTX
300 M=RND(43)
310 H=RND(43)
320 IF M=H THEN 310
330 CLS
340 J=H:GOSUB8000
360 FOR Y=1TO4:IFC(M,Y)=0 THEN NEXT:PRINT"THE JABERWOCKY IS TRAPPED.  YOU WIN!!!!!!!!!!":GOTO 1000
370 R=RND(4)
380 IF C(M,R)=0 THEN 370 ELSE LET C(M,R)= -ABS(C(M,R)):M=ABS(C(M,R))
390 PRINT:RESTORE:FORY=1TO4:READ D$:IFC(H,Y)<0 THEN PRINT"THE JABERWOCKY'S TRIAL LEADS TO THE ";D$
400 NEXT Y
410 DATA"NORTH","EAST","SOUTH","WEST"
420 PRINT
422 PRINT"YOU HAVE"SG"STINGERS LEFT FOR YOU CROSS BOW ALONG WITH"DY:PRINT"STICKS OF DYNOMITE."
425 INPUT"WHAT WOULD YOU LIKE TO DO";R$:R$=LEFT$(R$,1):IFR$<>"M" AND R$<>"E" AND R$<>"S"THEN PRINT"PLEASE RESPOND 'MOVE','EXPLODE', OR 'SHOOT'.":PRINT:GOTO425
427 IF R$<>"M"THEN500
430 INPUT"WHICH DIRECTION WOULD YOU LIKE TO GO";E$
440 RESTORE:FORY=1TO4:READD$:IFLEFT$(D$,1)<>LEFT$(E$,1)THEN NEXT:PRINT"PLEASE ANSWER WITH A DIRECTION.":GOTO430
450 IF C(H,Y)<>0THEN 455ELSE IF EX=1 THEN PRINT"BOOM":PRINT:PRINT"YOU TRYED TO GO AN UNPASSABLE DIRECTION AND WERE BLOWN UP BY ":PRINT"YOUR EXPLOSIVE CHARGE":GOTO1000ELSEPRINT"THAT DIRECTION IS NOT PASS ABLE.":PRINT:GOTO 430
455 IF EX=0THEN460ELSEEX=0:PRINT"BOOM ... THE CARVERN IS SEALED FOREVER.":FORZ=1TO4:FORX=1TO4:IF C(ABS(C(H,Z)),X)=H THEN C(ABS(C(H,Z)),X)=0
456 NEXT X,Z
460 H=ABS(C(H,Y))
470 GOTO 900
500 IF R$<>"E"THEN 600
510 CLS
515 DY=DY-1:IFDY<0THENPRINT"I'M SORRY BUT YOUR OUT OF DYNOMITE.":FORX=1TO500:NEXT:GOTO900
520 PRINT"PUSH ANY BUTTON TO START THE CHARGE THAT WILL EXPLODE AS"
525 PRINT"LEAVE THE CAVERN."
530 PRINT
540 EX=1
550 IFINKEY$=""THEN550ELSE900
600 SG=SG-1
700 PRINT:INPUT"WHICH DIRECTION WOULD LIKE TO SHOOT IN";D$
710 RESTORE:FORY=1TO4:READ E$:IFLEFT$(E$,1)<>LEFT$(D$,1)THENNEXT:PRINT"PLEASE ANSWER WITH A DIRECTION.":GOTO 700
720 IF C(H,Y)=0 THEN PRINT"YOU FIRED IN TO A SOLID WALL. THE GLASS STINGER RICHOCHTED OFF":PRINT"AND PLUNGED INTO YOUR HEART.":GOTO1000
730 IF C(H,Y)=MTHENPRINT"YOU'VE DONE IT, YOU HAVE PUT THE JABERWOCKY TO SLEEP WITH THE   GLASS STINGER OF YOUR CROSS-BOW !!!!!!":GOTO1000
740 PRINT"YOU MISSED THE JABERWOCKY."
745 FORX=1TO500:NEXT
750 IFSG=0THENPRINT"YOU ARE ALSO OUT OF STINGERS, TO BAD MAYBE NEXT TIME YOU GET IT.":GOTO1000
760 GOTO 900
900 IFM=HTHENPRINT"OHHH! .... EEEH! .... AAAAH!, GOBBLE-SLIRP.":PRINT"THE JABERWOCKY GOT YOU!":GOTO1000
910 FORK=1TO4:IF C(H,K)=0THENNEXT:PRINT"TOO, BAD.  YOU'VE TRAPED YOU'RE SELF IN THE CAVES":GOTO1000
920 GOTO 320
8000 REM
8090 I=INT((J-1)/5)
8095 J=J-I*5
8100 ON I+1 GOTO 8200,8210,8220,8230,8240,8250,8260,8270,8280,8290
8200  ON J GOTO 9000,9010,9020,9030,9040
8210  ON J GOTO 9050,9060,9070,9080,9090
8220  ON J GOTO 9100,9110,9120,9130,9140
8230  ON J GOTO 9150,9160,9170,9180,9190
8240  ON J GOTO 9200,9210,9220,9230,9240
8250  ON J GOTO 9250,9260,9270,9280,9290
8260  ON J GOTO 9300,9310,9320,9330,9340
8270  ON J GOTO 9350,9360,9370,9380,9390
8280  ON J GOTO 9400,9410,9420,9430,9440
8290  ON J GOTO 9450,9460,9470,9480,9490
8400 RETURN
