1 REM STAR TREK REVISED BY ANTHONY D'AGOSTA FOR THE TRS-80
5 P."THE PLAYER, AS CAPTAIN OF THE ENTERPRISE ALTERNATES"
10 P."MOVES WITH THE KLINGON BATTLE CRUISER. AFTER A READOUT"
15 P."OF THE RANGE AND BEARING TO THE ENEMY VESSEL, THE PLAY-"
20 P."ER IS QUIERIED FOR HIS COMMAND.":P." "
25 P."PHASORS HAVE RANGE FROM 0 TO 5 MILLION KILOMETERS"
26 P."(5E+06 KM). PHOTON TORPEDOES MAY BE USED FOR RANGES"
27 P."2E+06 KM AND GREATER.":P." "
30 P."FOWARD PHASORS AND PHOTON TORPEDOES MAY BE USED FOR "
35 P."BEARINGS 0 THRU 90 DEGREES. REAR PHASORS MAY BE USED"
40 P."FOR BEARINGS 90 THRU 180 DEGREES.":P." ":P." "
50 F.I=1TO13:A(I)=1:N.I:A(7)=0:A(14)=0:P."ENTER STARDATE"
60 IN.A:R=1E+07*RND(0):B=RND(180):P."KLINGON APPROACHING"
260 P."RANGE=";T.(7);R;T.(20);"KM";T.(24);"BEARING=";
261 P.T.(33);INT(B);T.(37);"DEG"
265 P." "
270 P."1=FWD PHASOR. 2=REAR PHASOR. 3=FWD PHOTON TORPEDO."
271 P."4=MANUVER TO ATTACK. 5=BREAK OFF. 6=SUICIDE. 7=SURRENDER."
275 P."COMMAND":IN.C:I=0:J=7:H=0
330 ON C GOSUB 790,920,1040,1140,1180,1250,1310
335 G.1360
360 I=7:W=A(8)+A(9):J=0:IF (A(10)=1)*(R>3E+06)*(B<100) T.710
410 IF (W>0)*(R<3E+06) T.540
415 IF W<>0 T.480
440 P."KLINGON TRYS TO BREAK CONTACT":C=5:GOSUB1180:G.1920
480 P."KLINGON ATTACKS":C=4:GOSUB1140:B=0:H=0:G.1920
540 P."KLINGON FIRES PHASOR":C=1:IF B<90 T.640
570 IF A(9)=0 T.600
575 GOSUB 920:G.1360
600 B=B-90:GOSUB790:B=B+90:G.1360
640 IF A(8)=0 T.670
645 GOSUB 790:G.1360
670 B=B+90:GOSUB 920:B=B-90:G.1360
710 P."KLINGON FIRES PHOTON TORPEDO":C=3:E=B:B=40:GOSUB 1040
760 B=E:G.1360
790 H=0:IF A(I+1)<>0 T.830
795 P."FWD PHASORS INOP":IF I=0 T.260
830 F=1-.2*(R/1E+06):G=(90-B)/90:IF (G<0)+(R>5E+06)T.900
870 IF F<RND(0) T.900
875 H=1:P=4
900 RETURN
920 IF A (I+2)>0 T.960
925 P."REAR PHASORS INOP":IF I=0 T.260
960 H=0:F=1-.2*R*1E-06:IF (R>5E+06)+(B<90)T.1030
1000 IF F<RND(0) T.1030
1005 H=1:P=2
1030 RETURN
1040 H=0:IF A(I+3)>0 T.1080
1045 P."PHOTON TORPEDO INOP"
1070 IF I=0 T.260
1080 IF (R<2E+06)+(B>90) T.1130
1090 M=(1-B/90)*(1-2*R/1E+08):IF M<RND(0) T.1130:H=1:P=8
1095 H=1:P=8
1130 RETURN
1140 R=R*(1-.5*A(I+4)):B=0:H=0:RETURN
1180 R=R*(1+A(I+4)+.05*A(I+6)):IF R>1E+08 T.1230
1200 P."CONTACT NOT BROKEN":H=0:RETURN
1230 P."CONTACT LOST":G.2020
1250 P."SELF DESTRUCT ACTIVATED":F.I=1TO10:F.J=1TO1000:N.J
1270 P.11-I:N.I:P."FLASH":G.2020
1310 P."MESSAGE FROM KLINGON ** I ACCEPT YOUR SURRENDER"
1320 P."PREPARE TO BE BOARDED":P."MESSAGE FROM STAR FLEET"
1340 P."YOU DIRTY COWARD":G.2020
1360 P." ":J=7-I:IF C>3 T.1920
1370 IF H>0 T.1440
1380 P."MISS":G.1920
1440 P."HIT":D=P*(1-A(J+5)):IF D<=2 T.1480:D=2
1450 D=2
1480 A(J+7)=A(J+7)+D:A(J+5)=A(J+5)-P/100:Z=10-INT(A(J+7))
1510 IF J=0 T.1580:P."SCANNER REPORT KLINGON"
1520 P."SCANNER REPORT KLINGON"
1540 IF Z>1 T.1610
1545 P."KLINGON DESTROYED":G.2020
1580 P."ENTERPRISE DAMAGE REPORT":IF Z>0 T.1610
1590 Z=1
1610 ON Z G.1620,1640,1850,1730,1730,1780,1780,1780,1830,1830
1620 P."ENTERPRISE DESTROYED":G.2020
1640 P."WEAPON SYSTEM DESTROYED":P."WARP DRIVE DESTROYED"
1660 P."MAJOR STRUCTURAL DAMAGE"
1680 A(J+4)=0
1690 A(J+3)=0
1700 A(J+2)=0
1710 A(J+1)=0:P."SHIELDS WEAKENiNG":G.1920
1730 P."PHASORS DESTROYED":P."MINOR DAMAGE AMIDSHIPS":G.1700
1780 P."FWD PHASORS DESTROYED":P."MINOR DAMAGE AMIDSHIPS"
1790 G.1710
1830 P."SHIELDS HOLDING NO DAMAGE":G.1920
1850 P."WEAPON SYSTEMS DEACTIVATED"
1860 P."DILITHIUM CRYSTALS OVERHEATING":G.1690
1920 L=.5*(A(4)+A(11)+.05*(A(6)+A(13)))
1930 R=R+L*(RND(0)-.5)*1E+06:R=ABS(R)
1950 B=ABS(B-150+RND(20)):B=INT(B):IF B>180 T.2000
1990 I=J:J=7-I
1995 IF I=0 T.260:G.360
1996 G.360
2000 B=ABS(360-B):G.1990
2020 P."TO PLAY AGAIN TYPE RUN AND DEPRESS THE 'ENTER' KEY":STOP
