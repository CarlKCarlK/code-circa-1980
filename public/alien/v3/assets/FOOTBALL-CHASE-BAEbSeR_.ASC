5 CLS
7 PL=5:'   # OF OTHERS
15 Y=5:X=5:OX=5:OY=5
20 CLS:PRINT:PRINT"===================================="
23 PRINT@Y*64+X,"O";
25 FOR P=1TOPL:Y(P)=RND(5)+1:X(P)=RND(10)*2+15:PRINT@Y(P)*64+X(P),"X";:NEXTP
26 FORP=1TO7
30 FORP=1TO7:PRINT@(P+1)*64,"!";:PRINT@35+(P+1)*64,"!";:NEXT
35 PRINT
40            PRINT"===================================="
50 PRINT@704,"YARDS    "INT(FT/3+.5)
80 A$=INKEY$:IFA$=""THEN80ELSE100
90 A$=INKEY$
100 IFA$=""THEN 110 ELSEIFA$="["THENY=Y-1ELSEIFA$=CHR$(10)THENY=Y+1ELSEIFA$=CHR$(8) THEN X=X-2:FT=FT-2ELSE IFA$=CHR$(9) THEN X=X+2:FT=FT+2
102 IF FT>300 THEN 700
105 IF Y<2ORY>8 ORX<1ORX>32   THEN 500
110 PRINT@OY*64+OX," ";:PRINT @Y*64+X,"O";:OX=X:OY=Y
120 P=RND(PL)
125 PRINT@( X(P)+Y(P)*64)," ";
130 Y(P)=Y(P)+SGN( Y-Y(P)):X(P)=X(P)+2*SGN(X-X(P))
135 PRINT@( X(P)+Y(P)*64),"X";
140 IF Y(P)=Y AND X(P)=X THEN 600
150 PRINT@714,INT(FT/3+.5);
300 GOTO 90
500 IFX>32 THENX=3:GOTO 90
510 IF X<1 THEN X=31 :GOTO 90
600 PRINT@ Y*64+X,"D";
610 FORP=1TO1000:NEXT:A$=INKEY$:X=5:Y=5:OX=5:OY=5:GOTO 20
700 PRINT@896,"     T O U C H - D O W N  !!!!!!!!!"
