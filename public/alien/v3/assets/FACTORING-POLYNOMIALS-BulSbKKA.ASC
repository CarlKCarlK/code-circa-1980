10 ' FRACTORING POLYNOMIALS          BY C.M. KADIE
90 PRINT:PRINT
100 INPUT"WHAT ARE THE VALUES OF A,B,&C IN AX[2 + BX + C";A,B,C
110 FORA1=ATO-(A)STEP-1*SGN(A)
115 IFA1=0THENNEXT
120 A2=A/A1
130 IFINT(A2)<>A2THENNEXT
140 FORC1=-(C)TOCSTEPSGN(C)
145 IFC1=0THEN NEXT
150 C2=C/C1
160 IFC2<>INT(C2)THEN190
180 IF B =(A1*C2)+(A2*C1) THEN250
190 NEXT:NEXT
200 PRINT"SORRY, THE POLYNOMIAL "A"X[2 + "B"X + "C" HAS NO FACTORS IN I.
210 GOTO270
250 PRINT"YES, THE POLYNOMIAL "A"X[2 + "B"X + "C" IS FACTORABLE INTO"
260 PRINT"("A1"X  + "C1") * ("A2"X + "C2")"
270 PRINT:PRINT"(PUSH ENTER TO CONTINUE)"
280 A$=INKEY$:IFA$=""THEN280ELSE10
