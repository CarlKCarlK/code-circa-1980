90 POKE16553,255
100 INPUT"HOW IS IT SPELLED";S$:S1$=S$:S$=LEFT$(S$,3):L=LEN(S$)
110 READF$:LF=LEN(F$):IFF$="DONE"THEN1000ELSEIFLEFT$(F$,3)=S$THEN1000
120 GOTO110
1000 READA$:IFF$=S1$ORS1$=A$THENPRINT"THAT'S CORRECT!"ELSEIFF$="DONE"THENPRINT"NOT IN MY DICTIONARY"ELSEPRINT"SORRY IT IS SPELLED "F$
1010 RESTORE:PRINT:GOTO100
10000 DATA"ACQUAINTANCE","AFFLENT","AMENDMENT","ANALYZE","ANTICIPATE","APPREHENSIVE","ARTIFICAL","BEHAVIOR","CAMPAIGN","CATALOG(UE)","CHRISTIAN","CLICHE'","COLLOQUIAL","COMMUNICATE","COMPEL","CONGRATULATE"
10010 DATA"CONSCIENTIOUS","COONSTITUTION","CRITICISM","DECENT","DISTRIBUTE","ECONOMICAL","ESSENTIAL","FIGURATIVE","FRAUDULENT","GUARANTEE","INVITATION","INDIGENT","INFALLIBLE","INQUIRY","INTELLIGENCE","MORTGAGE","PARADOX","PARTIAL"
10020 DATA"PLAINTIFF","PREPARATION","PREVALENT","QUANTITY","RECIPIENT","RECOLLECT","SACRIFICE","SENSIBLE","SOLILOQUUY","SUBSIDIZE","SYMPATHIZE","THOROUGHTLY","ULTERIOR"
10100 DATA"DONE","DONE1"
11000 DATA"DONE"
