10 DIM D(10,5,2),D$(10)
20 FOR C=1TO7
30 READ D$(C)
35 READ TM,DY$
40 FOR D=1TO5
50 IF VAL(LEFT$(DY$,1))<>(D) THEN 80 ELSE DY$=RIGHT$(DY$,LEN(DY$)-1)
60 D(C,D,1)=TM
75 IFC<>2THEND(C,D,2)=D(C,D,1)+1ELSE D(C,D,2)=D(C,D,1)+3
77 IF D(C,D,2)>15 THEN D(C,D,2)=15
80 NEXTD,C
90 CLS
100 PRINT"         MONDAY    TUESDAY   WENSDAY   THURSDAY  FRIDAY";
110 PRINT@0,D$(C);
120 FORT=1TO15:PRINT@T*64,((T-1)/2+8);:NEXTT
125 FOR C=1TO7
127 H$= LEFT$(D$(C),1)
130 FOR D=1TO5:S=D(C,D,1):L=D(C,D,2)-D(C,D,1)-.1
135 IF S=0THEN150
140 FOR B=STOS+LSTEP.5:PRINT@D*10+128*(B-7.5),STRING$(9,H$);:NEXT B
150 NEXT D
900 FOR X=1TO500:NEXTX
1000 NEXTC
1010 RUN
2000 DATA CHEM LED,8,2345,CHEM LAB,11,3, ENG,15,2, D LECT,9,24,DCS DISC, 9,5,  MATH,14,12345,  RHET,10,135
4100 DATA MONDAY,TUESDAY,WENDSDAY,THURSDAY,FRIDAY
