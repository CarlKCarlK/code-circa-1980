5 CLS
10 DEFINT A-Z
15 INPUT"HOW MANY FURIES";NM
20 DIM TM(NM),XM(NM),YM(NM)
25 CLS
30 P(0)=15430+64:P(1)=16020+64*3+30:SC=43:S1(0)=2:S2(0)=2:S1(1)=2:S2(1)=2:HD(0)=10:HD(1)=10:POKE P(0),94:POKE P(1),93:A(0)=3
40 FOR X=2TO126:SET(X,2):SET(127-X,45):NEXTX:FORY=2TO45:SET(1,47-Y):SET(127,Y):NEXTY
50 FOR X=1TO3:PRINT@RND(1022),CHR$(191);CHR$(191);:NEXTX
60 FORI=1TONM:TM(I)=RND(2)-1:XM(I)=TM(I)*50+4:YM(I)=RND(10)+3:PRINT@XM(I)+YM(I)*64,".";:NEXTI
100 FOR I=0TO8:READ S(I):NEXTI
110 FOR I=0TO8:READ C(I):NEXTI
112 FOR I=0TO8:T(I)=64*S(I)+2*C(I):NEXTI
115 FOR I=8TO0STEP-1:READ W(I):NEXTI
120 DATA 0,1,1,1,0,-1,-1,-1,0
130 DATA 1,1,0,-1,-1,-1,0,1,1
135 DATA 94,91,91,93,93,92,92,94,94
139 GOTO 200
140 PRINT@400,"X";
150 GOTO 170
160 L=400+T:PRINT@OL," ";:PRINT@L,W$;:OL=L
170 A= PEEK(14352):IF A=0 THEN 170 ELSE IF A<3 THEN AN=AN-1:IFAN<0THENAN=7ELSEELSE AN=AN+1:IFAN>7THENAN=0
180 T=T(AN):W$=W$(AN):GOTO160
200 IF PEEK(14463)THENIF PEEK(14383)THENELSE400ELSE600
210 A(0)=A(0)+(PEEK(14344)OR PEEK(14344)=4)AND7:A(1)=A(1)-SGN(PEEK(14368)AND16)+SGN(PEEK(14368)AND64)AND7:POKEP(0),W(A(0)):POKEP(1),W(A(1))
220 IF PEEK(14342)=0THEN400ELSE IF PEEK(14340)AND8THENELSE260
240 POKE P(0),32:P(0)=P(0)+(T(A(0))ANDPEEK(P(0)+T(A(0)) )=32ANDPEEK(R1(0,0)+T(A(0)))=32ANDPEEK(R2(0,0)+T(A(0)))=32):POKE P(0),W(A(0))
245 IF PEEK(14338)AND16THENELSE400
260 POKE P(1),32:P(1)=P(1)+(T(A(1))ANDPEEK(P(1)+T(A(1)))=32ANDPEEK(R1(1,0)+T(A(1)))=32ANDPEEK(R2(1,0)+T(A(1)))=32):POKE P(1),W(A(1))
400 H=PEEK(14352):I=PEEK(14368):S1(0)=S1(0)+SGN(H=4ANDS1(0)>0)-SGN(H=2ANDS1(0)<3):S2(0)=S2(0)+SGN(H=8ANDS2(0)>0)-SGN(H=16ANDS2(0)<3):S1(1)=S1(1)+SGN(I=2ANDS1(1)>0)-SGN(I=1ANDS1(1)<3):S2(1)=S2(1)+SGN(H=1ANDS2(1)>0)-SGN(I=4ANDS2(1)<3)
410 R1(0,1)=T(A(0)-S1(0)+1AND7)+P(0):R1(1,1)=T(A(1)-S1(1)+1AND7)+P(1):R2(0,1)=T(A(0)+S2(0)-1AND7)+P(0):R2(1,1)=T(A(1)+S2(1)-1AND7)+P(1)
430 POKE R1(0,0),32:R1(0,0)= R1(0,-(PEEK(R1(0,1))<>SC ANDPEEK(R1(0,1))<128)):POKE R1(0,0),SC:POKE R1(1,0),32:R1(1,0)=R1(1,-(PEEK(R1(1,1))<>SC ANDPEEK(R1(1,1))<128)):POKE R1(1,0),SC
440 POKE R2(1,0),32:R2(1,0)= R2(1,-(PEEK(R2(1,1))<>SC ANDPEEK(R2(1,1))<128)):POKE R2(1,0),SC:POKE R2(0,0),32:R2(0,0)=R2(0,-(PEEK(R2(0,1))<>SCANDPEEK(R2(0,1))<128)):POKE R2(0,0),SC
450 IF PEEK(P(0))>90 AND PEEK(P(1))>90 THEN 600
460 FOR X=1TO500:NEXTX
470 F(0)=0:F(1)=0
480 IF PEEK(P(0))<90 THEN HD(0)=HD(0)-1:POKE P(0),HD(0)+48:F(0)=-1
490 IF PEEK(P(1))<90 THEN HD(1)=HD(1)-1:POKE P(1),HD(1)+48:F(1)=-1
500 FOR X=1TO1000:NEXTX
510 IF F(0) THEN POKE P(0),W(A(0))
520 IF F(1) THEN POKE P(1),W(A(1))
525 IF HD(0)=0 OR HD(1)=0 THEN 550
530 GOTO 200
550 PRINT@0,"";:IF HD(0)=0 THEN PRINT"LEFT FIGHTER DIES."
560 IF HD(1)=0THENPRINT"RIGHT FIGHTER DIES."
570 FOR X=1TO2000:NEXTX :RUN
600 M=RND(NM)
605 IF M=0 THEN NM=NM+RND(2)-1:XM(1)=RND(30)*2+2:YM(1)=RND(10)+2:TM(NM)=RND(2)-1:PRINT@XM(NM)+YM(NM)*64,".";:GOTO200 ELSE IF PEEK(15360+XM(M)+YM(M)*64)<>46 THEN TM(M)=TM(NM):XM(M)=XM(NM):YM(M)=YM(NM):NM=NM-1:GOTO200
610 Y=(P(TM(M))-15360)/64:X=(P(TM(M))-15360)-Y*64+RND(2)-2:Y=Y+RND(3)-2:NX=XM(M)+SGN(X-XM(M))*2:NY=(YM(M)+SGN(Y-YM(M)))*64:P=PEEK(15360+NX+NY):IF P=32 OR (P>90 AND P<95)THEN PRINT@XM(M)+YM(M)*64," ";:POKE 15360+NX+NY,46:XM(M)=NX:YM(M)=NY/64ELSETM(M)=1-TM(M)
620 IF P>90 AND P<95 THEN 450  ELSE 200
