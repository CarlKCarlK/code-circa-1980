20 CLEAR1000
30 INPUT"HOW MANY SETS OF PROBLEMS";SP
40 INPUT"AND HOW MANY PROBLEMS PER SET";PS
50 CLS:'CALL PRINTER
60 FOR SE=1TOSP
65 PRINT"PROBLEM SET";SE:PRINT:PRINT
70 FOR PR=1TOPS
75 PRINT"("PR")  FIND :"
80 I1=RND(RND(90))
90 I2=RND(RND(90))
100 D=RND(RND(RND(100)))
110 N=RND(RND(100))
130 R=RND(RND(13))
140 D=D*R:IFD>100THEN100
150 N=N*R
160 N1=RND(N)
170 N2=N-N1
175 D1=D:D2=D
