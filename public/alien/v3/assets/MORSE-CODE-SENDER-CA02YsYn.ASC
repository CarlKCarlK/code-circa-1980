5 CLEAR1000
6 GOSUB2000
10 CLS
20 PRINT"THIS IS A MORSE CODE SENDER"
30 PRINT:INPUT"HOW FAST DO YOU WANT IT (0=SUPER FAST - 100 VERY SLOW)";SP
40 INPUT"DO YOU WANT IT TO SEND ONE LETTER AT A TIME";A$
50 IFA$="YES"THEN 200
60 CLS:INPUT"WHAT IS YOUR MESSAGE";M$
70 FORX1=1TOLEN(M$):A$=MID$(M$,X1,1)
75 FOR R3=1TOSP
80 GOSUB1000
90 NEXTX1
95 PRINT
100 FORX=1TO200:NEXT:IFINKEY$=""THEN 70ELSE30
200 CLS:PRINT"TYPE IN THE LETTERS"
210 A$=INKEY$
215 IFA$=""THEN210
217 IF A$=CHR$(13) THEN GOTO 30
230 GOSUB 1000
240 GOTO 210
1000 'A$ TO MORSE
1010  L=LEN( C$(ASC(A$)))
1015 FORR3=1TO3*SP:NEXT:PRINTA$;
1020 FORX=1TOL:FORR3=1TOSP:NEXT:B$=MID$(C$(ASC(A$)),X,1):PRINTB$;:IFB$="."THENOUT255,1:OUT255,2 ELSE IFB$="-"THEN FOR R1=1TO4:OUT255,1:OUT255,2:NEXTR1ELSEIFB$=" "THEN FORI=1TO5:NEXT
1030 NEXT
1040 PRINT"   ";
1100 RETURN
2000 'SET UP
2010 DIM C$(90)
2020 FOR X=32 TO 90
2030 READ C$(X)
2040 NEXTX
2050 DATA" ",,,,,,,,-.--.-,-.--.-,,--..--,..--.-,-..-.,-.-.-.,-..-.,-----,.----,..---,...--,....-,.....,-....,--...,---..,----.,---...,-.-.-.,,,,..--..,,.-,-...,-.-.,-..,.,..-.,--.,....,..,.---,-.-,.-..,--,-.,---
2060 DATA.--.,--.-,.-.,...,-,..-,...-,.--,-..-,-.--,--..
2070 C$(8)="........"
2999 RETURN
