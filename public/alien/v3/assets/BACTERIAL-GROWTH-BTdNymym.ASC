10 PRINT"COMPUTER SIMULATION OF BACTERIAL GROWTH"
20 READ X,NUT,WASTE
25 SAM=SAM+1
30 IF X=-1 AND NUT=-1 AND WASTE=-1 THEN 600
40 DAY=0
60 RATE =0
65 PRINT:PRINT"SIMULATION ";SAM
70 PRINT"INITIAL BACTERIA COUNT (MILLIONS)",X
80 PRINT"INITIAL NUTRIENT CONCENTRATION (PERCENT)",NUT
90 PRINT"INITIAL WASTE CONSENTRATION (PERCENT)",WASTE
100 RATE = (NUT/10)-(WASTE/10)+1
110 IF RATE < 1 THEN 160 ELSE DAYS=DAYS +1
115 IF RATE>2 THEN RATE=2
120 WASTE=WASTE+X/10
130 IF WASTE>100 THEN WASTE=100:'MIN(WASTE,100)
140 NUT=NUT-X/10
150 IF NUT  <0   THEN NUT =0:'MAX(NUT,0)
153 X=X*RATE
155 IF X<=0 THEN 160
156 GOTO 100
160 PRINT"FINAL BACTERIA COUNT (MILLION)",X
170 PRINT"FINAL NUTRIENT CONCENTRATION (PERCENT)",NUT
180 PRINT"FINAL WASTE CONCENTRATION (PERCENT)",WASTE
190 PRINT"THE NUMBER OF 24 HOUR PERIODS IN WHICH THE POPULATION GREW";DAYS
200 GOTO 20
600 PRINT:PRINT"SIMULATION OVER"
700 DATA 1,15,0,   1,5,5,  50,10,4,  80,50,0,  80,10,0, 500,1.1,1, 1,0,10, -1,-1,-1
