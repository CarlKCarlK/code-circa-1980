0 'GOTO 8100
1 'LIST  8100-8999
3 'GOTO 2990
5 GOTO 1000
10 REM 'PROGRAM TO SUM WORDS TO S
15 CLEAR 500
20 AC=ASC("A")
30 REM A=65 SO SUB 64 TO GET VALUE
40 V=98
100 W$="UZZZ" +STRING$(41," ")
110 I=1
120 CH$=MID$(W$,I,1)
121  V=V+1
130 IF CH$<"Z" THEN 290
140 W$=LEFT$(W$,I-1)+"A"+MID$(W$,I+1)
150 I=I+1:GOTO 120
290 IF CH$<>" " THEN N$=CHR$(ASC(CH$)+1) ELSE N$="A"
300 W$=LEFT$(W$,I-1)+N$+MID$(W$,I+1)
305 IF I=1 THEN GOTO 110
310 V=-1:FOR II=1TOI:V=V+ASC(MID$(W$,II,1))-AC+1:NEXTII
390 GOTO 110
1000 REM SECOND PROGRAM
1003 CLEAR 6000:'USED TO BE  6000
1005 DIM RW$(1500):Z=0:'USED TO BE DIM TO 1500
1010 W$="@"
1020 I=1:AC=ASC("A"):ZC=ASC("Z")
1030 'PUT GOSUB HERE TO SKIP TO A GOOD ORDERING
1033 GOSUB 1500:'       VALUE SUB
1035 'pRINTV;TAB(10);W$;TAB(30);Z
1037 M$=INKEY$:IFM$<>"" THEN IF ASC(M$)=112 THEN CLS:QQ=INT(Z/64):FOR QC=0TOQQ:FOR U=0TO62:PRINTRW$(QC*63+U),:NEXTU:GOSUB 1380:CLS:NEXTQC
1040 CH$=RIGHT$(W$,1):AS=ASC(CH$)
1050 W$=LEFT$(W$,I-1)+CHR$(AS+1)
1060 IF AS>=ZC THEN GOSUB 1080
1065 GOTO 1030
1070 'PART TO FLIP OVER NUMBERS
1080 TI=I
1090 IF MID$(W$,TI,1)=>"Z" THEN IF TI=1 THEN W$="A"+STRING$(I,"A"):I=I+1:GOSUB 1200:RETURN   ELSE TI=TI-1:GOTO 1090    ELSE SC$=CHR$(ASC(MID$(W$,TI,1))+1):W$=LEFT$(W$,TI-1)+ SC$+ STRING$(I-TI,SC$):GOSUB 1200:RETURN
1200 'SUB TO FIND A STRING THAT WILL GIVE 100 
1210 IF I<4 THEN I=4:W$="VZZA":RETURN
1220 A$=W$:A=I:B=I:'TEMPORARY STORAGE.
1230 A=A-1:C$=LEFT$(A$,A)
1240 W$=C$:I=A:GOSUB 1500:W$=A$:I=B
1245 TV=V+26*(I-A)
1250 IF TV<100 THEN 1230
1259 ' AFTER THIS POINT V HAS PASSED 100
1260 W$=C$+CHR$(ZC+100-TV):IF I-A>1 THEN W$=W$+STRING$(I-A-2,"Z")+"A"
1270 RETURN
1300 'SUB TO TEST IF LETTERS ARE IN ALPHBETICAL ORDER
1305 N$=W$+"["
1307 PRINTW$
1310 G=1
1320 IF MID$(N$,G,1)>MID$(N$,G+1,1) THEN 1350
1330 G=G+1:IFG<LEN(N$) THEN 1320
1340 FL=1:RETURN:'LETTERS IN ORDER
1350 FL=0:RETURN:'NOT IN ALPHABETICAL ORDER
1380 M$=INKEY$:IFM$=""THEN 1380 ELSE RETURN
1500 'SUB TO PRINT VALUE OF NUMBER
1505 V=0
1510 FOR II=1 TO I
1520 V=V+ASC(MID$(W$,II,1))-64
1530 NEXT II
1540 IF V=100 THEN PRINTSTRING$(15,"!"):GOSUB 1300:IF FL=1 THEN RW$(Z)=W$:Z=Z+1:PRINTSTRING$(15,"*")
1550 RETURN
2990 DEFDBL S
3000 FOR J=8 TO 32
3010 READ N
3020 SUM=SUM+J*N
3030 NEXT J
3040 SAV=SUM/300
3045 RESTORE
3050 FOR K=8TO32
3060 READ N
3070 SD=SD + N*(K-SAV)*(K-SAV)/300
3080 NEXT K
3997 '
3998 '
3999 '
4000 CLS:PRINT"AVERAGE --  ";SUM/300:PRINT "STANDARD DEVIATION ([2) -- ";SD:PRINT"STANDARD DEVIATION -- ";SQR(SD):PRINT"SQRT OF AVERAGE --- "; SQR(SUM/300)
5000 DATA 1,2,6,6,6,7,12,15,28,19,28,26,25,27,26,15,15,11,11,5,3,2,1,2,1
6950 SS=SU/300
6999 STOP
7000 FOR M=1TO 33
7010 GOSUB 8000
7020 P=300*EXP(M-SS)
7030 PRINT P,
7040 NEXT M
7050 END
8000 REM
8010 F=1
8020 FOR JJ=1TOM
8030 F=F*JJ
8040 NEXT JJ
8050 RETURN
8100 DIM R(11),M(5,1)
8110 MI$="10000":MA$="10101":MM$="01011"
8120 FOR I=1TO5
8130    M(I,0)=VAL(MID$(MA$,I,1))
8140   M(I,1)=VAL(MID$(MM$,I,1))
8150   R(I+5)=VAL(MID$(MI$,I,1))
8160 NEXT I
8165   FOR J=1TO11:PRINTR(J);:NEXTJ:PRINT
8170 FOR I=0TO 4
8180   IF R(10)=0 AND R(11)=1 THEN S=0:GOSUB8300
8190   IF R(10)=1 AND R(11)=0 THEN S=1:GOSUB8300
8200 FOR J=11TO2STEP-1:R(J)=R(J-1):NEXTJ
8210   FOR J=1TO11:PRINTR(J);:NEXTJ:PRINT
8220 NEXT  I
8225 IF R(1)=1 THENFOR I=2TO10:R(I)=1-R(I):NEXTI:SM=1:FORI=2TO10:SM=SM+R(I)*2[(10-I):NEXT:PRINT-SM
8226 IF R(1)=0 THEN SM=0:FORI=2TO10:SM=SM+R(I)*2[(10-I):NEXT:PRINT SM
8230 END
8300 CT=0:CY=0:FORJ=5TO1STEP-1:SM=CY+M(J,S)+R(J)
8305 PRINT"```"SM"```";
8310 IF SM>=2 THEN CY=1:SM=SM-2ELSE CY=0
8312 CT=CY
8315 PRINTR(J);M(J,S);CT;"=";CY;SM;" @@@@@@"
8320 R(J)=SM
8330 NEXT J:RETURN
9000 INPUT X
9003 PRINTTAB(25);EXP(X)
9004 E=1
9005 FOR ZZ=1 TO 100
9020 M=ZZ:GOSUB 8000
9030 E=E+X[M/F
9040 PRINTE,
9050 NEXT ZZ
10000 M$=INKEY$:IFM$=""THEN10000 ELSE PRINTASC(M$)
