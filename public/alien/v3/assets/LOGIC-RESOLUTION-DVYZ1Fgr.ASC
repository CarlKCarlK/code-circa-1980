2 CLS
5 CLEAR 2000
7 DEFINT A-Y
10 DIM P(200,1),W$(200),F(200,1)
14 DEF FNX(X,Y)=B
15 DEF FNM(A,B)= ((A>=B)ANDA)+((B>A)ANDB)
16 Z2=1/LOG(2)
17 'DATA #A,B,,#B,C,,#C,D,,#D,E,,A,,#E,DONE
20 DATA  #A,B,  ,#A,C,  ,#D,E,F,G, ,#C,D, ,#F,#B, ,A, ,#G, ,#E, DONE
25 DIM S$(10,1):FORI=1TO10:S$=CHR$(I+ASC("A")-1):FORJ=0TO1:IF J=1 THEN S$="#"+S$
27 S$(I,J)=S$:NEXTJ,I
28 R=1
30 READ P$:IF P$="DONE" THEN 50 ELSE IF P$="" THEN R=R+1:P(R,0)=0:P(R,1)=0 ELSE  L=ASC(RIGHT$(P$,1))-ASC("A"):P(R,0)=P(R,0)OR2[L:IF LEFT$(P$,1)="#" THEN P(R,1)=P(R,1)OR2[L
40 GOTO 30
50 '
55 SS=R
60 B=R:FORI=1TOB-1:FORJ=FNM(SS,I+1)TOB
70 AB= (P(I,0)ANDP(J,0)):IF AB THEN AC=AB AND P(I,1):AD=AB AND P(J,1):CD= (ACANDNOT(AD))OR(NOT(AC)ANDAD) :IF CDTHEN GOSUB900
80 NEXT J,I:SS=B+1:GOTO 60
900 IFCD=0 THEN RETURN ELSEPS=LOG(CD)*Z2:MA=2[PS:CD=CD AND NOT(MA)
1000 R=R+1:PRINT@0,R,:FORL=0TO1:P(R,L)=(P(I,L)ORP(J,L))AND NOT(MA):NEXTL
1005 F(R,0)=I:F(R,1)=J
1010 IF P(R,0)=0 THEN 2000
1015 IF P(R,0)=P(R-1,0) AND P(R,1)=P(R-1,1) THEN R=R-1
1018 GOTO 900
1020 IFW$(T)=""THENFOR L=0TOLOG(P(T,0))*Z2:W$(T)=W$(T)+S$((L+1) AND (2[L AND P(T,0))<>0, ((2[LANDP(T,1))=0)+1 ):NEXTL
1030 RETURN
2000 PRINT:PRINT"SOLUTION FOUND"
2010 T=R:W$(T)="CONTRODICTION"
2020 FOR K=R TO 1 STEP -1:IF W$(K)<>"" AND F(K,0)<>0THEN T=F(K,0):GOSUB1020:T=F(K,1):GOSUB1020
2030 NEXTK
2040 FOR K=1TO R:IF W$(K)<>"" THEN IF F(K,0)=0 THEN PRINT"GIVEN: ";W$(K) ELSE PRINTW$(F(K,0))" * "W$(F(K,1))" -> "W$(K)
2050 NEXT K
