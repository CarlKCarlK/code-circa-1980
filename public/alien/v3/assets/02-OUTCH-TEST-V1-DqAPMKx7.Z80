TEST	LD	B,40
NEXT	INC	B
	CALL	OUTCH
	JP	NZ,NEXT
STOP	JP	TEST
OUTCH	JP	SKIPP	;SUBROUTINE TO PRINT ON SCREEN
			; INPUT  A,ZERO   B,CHARACTER
CURS	DEFW	$	;LOCATION OF SCREEN
SCREEN	EQU	15360	;BEGINING OF SCREEN MEM
SKIPP	PUSH	HL	;SAVE HL
	LD	HL,(CURS) ; PUT LOCATION IN HL
	PUSH	DE	;SAVE DE
	PUSH	BC
	LD	DE,1024
	SBC	HL,DE
	JP	M,GOOD
SCROLL	PUSH	HL 
	PUSH	DE
	PUSH	BC
	LD	DE,SCREEN;      MOVE SCREEN UP
	LD	HL,SCREEN+64
	LD	BC,1024-64
	LDIR
	LD	HL,SCREEN+1024-64
	LD	(HL),32 ; LOAD CORNER WITH A BLANK
	LD	DE,SCREEN+1024-64+1
	LD	BC,64		;CLEAR LAST LINE
	LDIR
	LD	HL,1024-64
	LD	(CURS),HL	  ;MOVE TO LAST PLACE
	POP	BC
	POP	DE
	POP	HL
GOOD	EQU	$
	LD	HL,(CURS) ; PUT B ON THE SCREEN 
	LD	DE,SCREEN
	ADD	HL,DE
	POP	BC
	LD	(HL),B
	LD	A,B
	LD	HL,(CURS)
	INC	HL
	LD	(CURS),HL
	POP	DE
	POP	HL
	RET		;THATS ALL FOLKS
	END
