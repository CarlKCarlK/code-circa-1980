5 '***** GAVE UP JULY 1979 BECAUSE OF DIFFICULTIES IN SIMMULATION *****
1000 REM     PROGRAMMER
1010 '
1020 REM     DEFINE CONSTANTS
1030     PI = 3.14159
1040     E  = 2.7179766
1050 '
1060 REM     DEFINE NEW FUCTIONS
1070     DEF FNS(X) = ATN( X/ SQR( -X * X +1 ) ):'  ARC-SINE
1080     DEF FNC(X) = - FNS( X ) + PI/2         :'  ARC-COSINE
1090     DEF FNL(X) = E [ X                     :'  ANTI-LOG
1100     DEF FNR(X) = X / PI *180               :'  RAD TO DEG
1110     DEF FND(X) = X/180 *PI                 :'  DEG TO RAD
1120 '
1130 REM     DEFINE VARIABLES
1140 REM   DISPLAY (DI) = NUMBER ON DISPLAY
1150 REM   STORED  (ST) = NUMBER STORED IN MEMORY
1160 REM   PARENTH.(PA) = VALUE STORED IN PARENTHESES
1170 REM   PHASE EE(PE) = PHASE OF ./EE/- KEY (1=. 2=EE 3= -)
1180 REM   PA.PHASE(PH) = PHASE OF PARENTHESES (0=OPEN 1=CLOSED)
1190 REM   SHIFT   (SH) = SHIFT POSITION 0=UP 1=KEY FACE 2=DOWN
1200 REM   P$(ARRAY)    = PROGRAM STEPS FROM P(0) TO P(34)+ MORE
1210 REM   HOLDER  (HO) = VARIABLE USED TO HOLD VALUE IN EXCHANGE
1220 REM     RUNNING THE PROGRAM
1230     SH = 0                                   'SHIFT ON KEY
1240     PRINT "ON WHICH STATMENT LINE WOULD YOU LIKE TO START";
1250     INPUT A$ 
1260   X=VAL(A$)
1270    B$= S$(X)
1280     IF SH <> 0 THEN      
1290            IF B$ = "E" THEN SH = 2  :GOTO10000
1300            IF B$ = "7" THEN DI = SIN(DI)  :GOTO10000
1310            IF B$ = "8" THEN DI = COS(DI)  :GOTO10000
1320            IF B$ = "9" THEN DI = TAN(DI)  :GOTO10000
1330            IF B$ = "4" THEN DI = LOG(DI)  :GOTO10000
1340            IF B$ = "5" THEN DI = ST  :GOTO10000
1350            IF B$<> "6" THEN 1400
1360                    IF PH=1 THEN 1380
1370                        PO$=SO$ : PA=SN : PH=1  :GOTO10000
1380                        GOSUB 4000
4000 REM     SUBROUTINE FOR BIANARY OPERATIONS
4010    IF SO$ = "+" THEN DI = SN + DI
4020    IF SO$ = "-" THEN DI = SN - DI
4030    IF SO$ = "/" THEN DI = SN / DI
4040    IF SO$ = "*" THEN DI = SN * DI
4050   SN=0  : SO$ = "" 
4060 RETRUN
