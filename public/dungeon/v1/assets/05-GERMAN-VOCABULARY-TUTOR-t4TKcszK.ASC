10 'LANGUAGE
20 CLEAR1000
30 DEFINT W
40 DEFSTR I,L,G,M,A,Q,E
50 READ INFO
60 IF INFO <> "DONE" THEN NUMBER = NUMBER+1 : GOTO 50   
70 RESTORE:CLS
80 PRINT "I KNOW "; NUMBER ;"GERMAN WORDS."
90 PRINT "WHICH ONE WOULD YOU LIKE TO START WITH (1 -"; NUMBER ;")";:INPUT START
100 IF START<1 OR START>NUMBER THEN 90   
110 PRINT "AND WHICH WORD WOULD YOU LIKE TO END WITH ("; START ;"-"; NUMBER ;")";:INPUT FINAL
120 IF FINAL<START OR FINAL>NUMBER THEN 110  
130 PRINT"WOULD YOU LIKE A TIME LIMIT ON YOUR ANSWERS";:INPUT LIMIT
140 IF LIMIT = "YES" THEN QICK="NO": INPUT"HOW MANY SECONDS (1-8000)";TIME  ELSE IF LIMIT = "NO" THEN TIME=1000 ELSE PRINT"PLEASE ANSWER 'YES' OR 'NO'.":GOTO130  
150 IFTIME<0 OR TIME>8000 THEN 140  
160 INPUT"DO YOU WISH TO TRANSLATE GERMAN TO ENGLISH";GERMAN
170 IF GERMAN <> "NO"   AND GERMAN <>"YES"  THEN 160  
180 INPUT"DO YOU WISH FOR A CONSTANT PERCENTAGE SCORE";ERCENT
190 IF ERCENT<>"NO" AND ERCENT<>"YES"THEN180  
200 INPUT"DO YOU WISH FOR A CONSTANT LETTER GRADE"; GRADE
210 IF GRADE<>"NO"   AND GRADE<>"YES"  THEN200  
220 INPUT"DO YOU WANT THE WORD ORDER RANDOM";MIXED
230 IF MIXED<>"YES" AND  MIXED <>"NO" THEN 220  
240 IFLIMIT="NO"THENINPUT"WOULD YOU LIKE TO USE THE QUICK OPTION";QICK
250 IF QICK="YES"THENPRINT"THEN PRESS <BAR> IN ANSWER TO THE QUESTION, AND TO ADVANCE":PRINT"PRESS 'X' IF YOU WERE WRONG AND '/' IF YOU WERE WRONG."ELSEIFQICK<>"NO"THEN240  
260 PRINT"                 (PRESS THE <BAR> )";
270 IFINKEY$=""THEN270  
280 DIM WO(FINAL-START+1)
290 FOR COUNT=1TO FINAL-START+1
300 WO(COUNT)=START+COUNT-1
310 NEXT COUNT:COUNT=COUNT-1
320 IF MIXED="YES"THEN GOSUB 680  
330 FOR TURN=1TO COUNT
340 CLS
350 IF WO(TURN)>PO+1THEN PRESENT = PO:FOR PO=PRESENT TO WO(TURN)-2:READ INFO:NEXT PO
360 IF WO(TURN)<=PO THEN RESTORE:PO=0:GOTO350  
370 READ INFO :    PO=PO+1
380 QUESTI=LEFT$(INFO,INSTR(INFO,"*")-1):ANSWER=RIGHT$(INFO,LEN(INFO)-INSTR(INFO,"*"))
390 IF GERMAN="NO"THEN INFO=ANSWER:ANSWER=QUESTI:QUEST=INFO
395 IF QICK="NO"THEN440
400 IF QICK="YES"THENPRINT@385,QUEST;" : ";
410 IF QICK="YES" AND INKEY$=""THEN400ELSEPRINT:PRINT"DAS RICHTIG ANWART IST":PRINTANSWER:PRINT:PRINT"(PRESS 'X' IF WRONG.... '/' IF RIGHT)
420 IFQICK="YES" THEN A$=INKEY$:IFA$<>"X"ANDA$<>"/"THEN420  ELSEIFA$="X"THENPRINT"DAS TUT MEIR LEIT.":WR=WR+1:WO(WR)=WO(TURN)ELSEPRINT"GUT!":RI=RI+1
430 GOTO490  
440 PRINT@385,QUEST;" : ";:LINE INPUT#LEN TIME,460  ;GUESS
450 GOTO 470  
460 PRINT:PRINT"I'M SORRY YOU HAVE RUN OUT OF TIME":GUESS="":GOTO480  
470 IF ANSWER=GUESS THEN PRINT "DAS IST RICHTIG!":RIGHT=RIGHT+1 ELSE PRINT"DAS IST FALSCH."
480 IFANSWER<>GUESSPRINT"DAS RICHTIG ANTWORT IST :":PRINTANSWER:WR=WR+1:WO(WR)=WO(TURN)
490 IF ERCENT = "YES" THEN PRINT@10,"PERCENTAGE=";100*RIGHT/TURN;
500 IFGRADE="NO"THEN520  ELSE PRINT@46,"GRADE = ";:IFRI/TU=>.925THENPRINT"A";ELSEIFRI/TU=>.865THENPRINT"B";ELSEIFRI/TU=>.765THENPRINT"C";ELSEIFRI/TU=>.685THENPRINT"D";ELSEPRINT"F";
510 IFQICK="YES"THEN 540  
520 PRINT@960+21,"(PRESS ANY BUTTON)";
530 IF INKEY$=""THEN530  
540 NEXT TURN
550 CLS
560 PRINT"YOU HAVE NOW COMPLETED THE LIST."
570 PRINT"WOULD YOU LIKE TO KNOW YOUR PERCENTAGE";:INPUT INFO
580 IF INFO="YES" THEN PRINT:PRINT"PERCENTAGE RIGHT =";RIGHT/COUNT*100:PRINT
590 INPUT"WOULD YOU LIKE TO KNOW YOUR LETTER GRADE";INFO
600 IF INFO<>"YES"THEN620  ELSE PRINT:PRINT"LETTER GRADE = ";:IF RI/CO>=.925THENPRINT"A"ELSEIFRI/CO=>.865THENPRINT"B"ELSEIFRI/CO=>.765THENPRINT"C"ELSEIFRI/CO=>.685 THEN PRINT"D"ELSEPRINT"F"
610 IFWRG =0THEN640  
620 PRINT:INPUT"YOU WOULD YOU LIKE TO TRY THOSE YOU MISSED";INFO
630 IFINFO="YES"THEN COUNT=WRG  :RIGHT=0:WRNG=0: GOTO 320  
640 INPUT"WOULD YOU LIKE TO START OVER";INFO
650 IF INFO="YES"THEN RUN
660 PRINT:PRINT:PRINT"GUTEN TAG!"
670 END
680 FOR CIRCLE=1 TO COUNT
690 R1=RND(COUNT):R2=RND(COUNT)
700 HOLD=WO(R1):WO(R1)=WO(R2):WO(R2)=HOLD
710 NEXT CIRCLE
720 RETURN
730 DATA"ES BRINGT*IT BRINGS",ER GIBT*HE GIVES,SIE HAT*SHE HAS,WIR KOMMEN*WE COME,SIE LIEBEN*YOU(F) LOVE,ICH SAGE*I SAY,WIR SCHREIBEN*WE WRITE,ICH SINGE*I SING,IHR SPRECHT*YOU(P) SPEAK,SIE STUDIEREN*THEY STUDY,SIE FRAGEN*THEY ASK
740 DATA "ES GEHT*IT GOES",ER KAUFT*HE BUYS,SIE LESEN*THEY READ,ER MACHT*HE MAKES;DOES,SIE SCHLAFEN*THEY SLEEP,WIR SIND*WE ARE,ES SPIELT*IT PLAYS,ICH STEHE*I STAND,SIE VERSTEHEN*YOU(F) UNDERSTAND
750 DATA YOU(P) BEGIN*IHR BEGINNT,SHE THINKS*SIE DENKT,YOU(F) EAT*SIE ESSEN,YOU(P) ASK*IHR FRAGT,SHE GOES*SIE GEHT
760 DATA "WIR MU:SSEN*WE MUST",SIE SAGEN*YOU(F) SAY,ES SCHREIBT*IT WRITES,SIE SIEHT*SHE SEES,SIE SINGEN*YOU(F) SING,HE BRINGS*ER BRINGT,IT IS PERMITTED*ES DARF,I TRAVAL*ICH FAHRE,YOU(S) GIVE*DU GIBST,THEY BELIEVE*SIE GLAUBEN
770 DATA "IHR NEHMT*YOU(P) TAKE",IHR SCHLAFT*YOU(P) SLEEP,SIE SCHWIMMEN*YOU(F) SWIN,ES IST*IT IS,ER SOLL*HE SHOULD
20000 DATA "DONE"
