1 CLS
2 POKE16553,255
5 READB$:IFB$="DONE"THENRESTORE:GOTO10ELSEREADR$:PRINTTAB(35)CHR$(191);" ";B$TAB(50)R$:GOTO5
9 CLS
10 '
100 A$=INKEY$:IFA$=""THEN100
105 IFA$=" "THENA$="="
110 PRINTA$;
120 IFVAL(A$)<>0ORA$="0"ORA$="."ORA$="-"THEN T$=T$+A$:F=1:GOTO140ELSEM=VAL(T$):T$="":IFA$="="THEN300ELSEO$=A$:IFF<>1THENM=P
130 M1=M:M=0
140 GOTO100
300 IFO$="+"THENP=M1+M
305 IFO$="B"THENGOTO9999
310 IFO$="M"THENP=M1-M
320 IFO$="*"THENP=M1*M
330 IFO$="/"THENP=M1/M
340 IFO$="["THENP=M1[M
350 IFO$="S"THENP=SIN(M1)
360 IFO$="C"THENP=COS(M1)
370 IFO$="T"THENP=TAN(M1)
380 IFO$="t"THENPRINT"@";:P=ATN(M1)
390 IFO$="E"THENP=EXP(M1)
400 IFO$="L"THENP=LOG(M1)
410 IFO$="N"THENP=RND(M1)
420 IFO$="D"THENP=M1*57.29578
430 IFO$="R"THENP=M1/57.29578
440 IFO$="K"THENM(M)=P
450 IFO$="G"THENP=M(M)
460 IFO$="s"THENPRINT"@";:P=ATN(M1/SQR(-M1*M1+1))
470 IFO$="c"THENPRINT"@";:P=-ATN(M1/SQR(-M1*M1+1))+1.5708
480 IFO$="Q"THENP=SQR(M1)
490 IFO$="A"THENP=ABS(M1)
500 PRINTP;:M1=0:M=0:F=0
510 READB$:IFB$="DONE"THENRESTORE:GOTO510ELSEREADR$:PRINTTAB(35)CHR$(191)" "B$TAB(50)R$
550 GOTO100
700 DATA"+","PLUS","M","MINIS","*","TIMES","/","DIVIDED BY","[","RASED TO THE","S","SINE","C","COSINE","T","TANGENT","<SHIFT>T","ARC-TANGENT","E","E[X","L","LOGARITHM","N","RANDOM NUMBER"
800 DATA"=","EQUALS?","<SPACE BAR>","EQUALS?"
810 DATA"D","DEG FROM RAD","R","RAD FROM DEG"
820 DATA"G<X>","GET MEM <X>","K<X>","KEEP MEM <X>"
830 DATA"<SHIFT>C","ARC-COSINE","<SHIFT>S","ARC-SINE"
840 DATA"A","ABSOLUTE VAL","B","BREAK PROGRAM","Q","SQUARE ROOT"
1000 DATA"DONE"
9999 END
