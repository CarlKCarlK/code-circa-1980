10 CLS:CLEAR 100
20 PRINT"SWORDS"
30 PRINT:PRINT
40 INPUT"HOW MANY";NS
45 PRINT:PRINT"ANSWER 1ST QUESTION:  A-AUTOMATIC   L-LEFT KEYS    R-RIGHT KEYS"
46 PRINT"ANSWER 2ND QUESTION:  0 TO 1, HIGH SLOWS PLAYER DOWN ":PRINT"(MAKE AT LEAST ONE HANDICAP 0)":PRINT
47 DIM T(NS),H(NS),C$(NS),X(NS),Y(NS):LF=0:RF=0
50 FOR I=1 TO NS
60 PRINT"SWORDS ";I;")  ";
70 INPUT T$
80 IF T$="A"THEN ELSE IF T$="L" AND LF=0THEN LF=I ELSE IF T$="R" AND RF=0 THEN RF=I ELSE PRINT:PRINT"TRY AGAIN":GOTO60
85 H(I)=0:INPUT"HANDICAP";H(I)
90 NEXT I
100 IF LF<>0 THEN INPUT"CHARACTER FOR LEFT PLAYER";L$:L$=LEFT$(L$+"L",1)
110 IF RF<>0 THEN INPUT"CHARACTER FOR RIGHT PLAYER";R$:R$=LEFT$(R$+"R",1):IF R$=L$ THEN PRINT:GOTO100
125 CT=ASC("A")-1
130 FOR I=1 TO NS
140 CT=CT+1:C$=CHR$(CT):IF C$=R$ OR C$=L$THEN 140
150 C$(I)=C$
160 NEXT I
170 C$(LF)=L$:C$(RF)=R$
200 CLS:FORI=1TO 30:PRINT@RND(1022),CHR$(191);CHR$(191);:NEXTI:FOR I=1TONS:X(I)=RND(30)*2:Y(I)=RND(14):PRINT@X(I)+Y(I)*64,C$(I);:C$(I)=" ":NEXT I
210 FOR J=1TO4:P(J)=RND(4):READ DX(J),DY(J):NEXTJ
220 DATA -2,-1,  2,-1, -2,1, 2,1
225 AL$=CHR$(94):AR$=CHR$(93)
230 IF LF<>0 THENFOR J=1 TO 2: LT=X( LF)+DX(P(J))+(Y(LF)+DY(P(J)))*64:PRINT@LT-1,AL$;:PRINT@LT+1,AR$;:NEXTJ
240 IF RF<>0 THEN FOR J=3TO4: PRINT@ X(RF)+DX(P(J))+(Y(RF)+DY(P(J)))*64,"*";:NEXTJ
300 C=RND(NS):IF H(C)>RND(0) THEN 300ELSEIFC=LFTHEN GOSUB1000ELSEIFC=RFTHENGOSUB2000 ELSE GOSUB 310
305 GOTO 300
310 IF T(C)<>0 AND RND(20)<>1 THEN 330
320 IF LF<>0 AND RF<>0 THEN IF RND(2)=1 THEN T(C)=RFELSE T(C)=LF ELSE IF LF<>0 THEN T(C)=LF ELSE IF RF<>0 THEN T(C)=RF ELSE 900 ELSE 900
330 DX=SGN( X(T(C))-X(C)+RND(3)-2)*2:DY=SGN( Y(T(C))-Y(C)+RND(3)-1)
340 IF DX=0ANDDY=0THEN RETURNELSET$=C$(C):NP =X(C)+DX+( Y(C)+DY)*64:TT$=CHR$(PEEK(15360+NP)):GOSUB 800:IFTT=0THEN360ELSEOP=X(C)+Y(C)*64:C$(C)=TT$:PRINT@NP,CHR$(PEEK(OP+15360));:PRINT@OP,T$;:X(C)=X(C)+DX:Y(C)=Y(C)+DY
350 IF C$(C)=" "THENRETURNELSE IF C$(C)=L$ THEN 500ELSE IFC$(C)=R$THEN600
360 DX=(RND(3)-2)*2:DY=RND(3)-2:IF DX+X(C)>=0 AND DX+X(C)<127 AND DY+Y(C)>=0 AND DY+Y(C)<=15 THEN IFPEEK(15360 + X(C)+DX + (Y(C)+DY)*64)=32 THEN 340 ELSE RETURN
370 RETURN
500 'LEFTOUT
600 'RIGHT OUT
699 GOTO 10000
800 TL$=CHR$(PEEK(15360+NP-1)):TR$=CHR$(PEEK(15360+NP+1)):IF TT$=" "AND TL$<>AL$AND TR$<>AR$THEN TT=1:RETURNELSE IF TT$=L$ORTT$=R$THENTT=1:RETURNELSETT=0:RETURN
900 'MONSTERS WIN
10000 GOTO 10000
