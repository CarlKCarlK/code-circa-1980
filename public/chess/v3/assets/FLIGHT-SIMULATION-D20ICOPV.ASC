30 DIM D(100),V(100)
40 PI=3.14159:T=1:E=5
50 CLS:FORI=13TO45:SET(0,I):SET(4,I):NEXTI:FOR I=0TO4:SET(I,13):SET(I,45):NEXTI:FOR I=1000TO10000STEP1000:PRINT@(10000-I)*.0641+3+384-64,I;:NEXTI
60 PRINT@55+64,"N";:PRINT@55+128+64,"S";:PRINT@51+64+64,"W";:PRINT@59+64+64,"E";:FORI=99TO121:SET(I,12):SET(I,2):NEXTI:FORI=2TO12:SET(99,I):SET(121,I):NEXTI
70 PRINT@18+384,"SAND";:PRINT@18+448,"HE  ";:PRINT@18+640,"tIME";:PRINT@45+256+64,"AIR SPEED";:PRINT@640+18,"V SPD";:PRINT@704+18,"V ACL";:PRINT@768+18,"ALTD";
100 FOR A=1TO100
110 D(A)=RND(0)*2*PI
115 V(A)=ABS(ABS(RND(0)-RND(0))-ABS(RND(0)-RND(0)))*50
120 NEXTA
130 X=0:Y=0
140 H=2000:S=1000:G=1000
200 A$=INKEY$:IFA$=""THEN210ELSEIFA$="["THEN SS=-1 ELSEIFA$=CHR$(10) THEN HH=-1ELSEIFA$=" "THENSS=0:HH=0ELSEIFVAL(A$)<>0THEN E=VAL(A$):PRINT@832+18,"DIS R   ";E;
210 H=H+HH*E:S=S+SS*E:IF S=<0 THEN SS=0:PRINT@0,"SAND ALL GONE";
220 AC=(H-G-S)
230 A=V*T+.5*AC*T[2
235 IF A< 0 OR A>=10000 THEN 500
240 V=V+AC*T
250 L2=INT(A/100):L1=L2+1
260 F1=L2-A/100:F2=1-F1
270 XX=(COS( D(L1) )*F1*V(L1)+COS( D(L2) ) *F2*V(L2))+RND(0)/2
280 YY=(SIN( D(L1))*F1*V(L1)+SIN(D(L2))*F2*V(L2))+RND(00)/2
285 X=X+XX*T:Y=Y+YY*T
290 VV=SQR(XX[2+YY[2)
300 D=ATN(YY/XX)
310 PRINT@18+512,"";:PRINTUSING"###.###";ABS(X)/60;:IFX<0THENPRINT" WEST ";ELSEPRINT" EAST ";
320 PRINT@18+576,"";:PRINTUSING"###.###";ABS(Y)/60;:IFY<0 THEN PRINT" NORTH";ELSEPRINT" SOUTH";
330 RESET(X1+.5,Y1+.5):X1=COS(D)*4+111:Y1=SIN(D)*1+7:SET(X1+.5,Y1+.5)
340 RESET(1,Y2):RESET(2,Y2):RESET(3,Y2):Y2= 44-A/333:SET(1,Y2):SET(2,Y2):SET(2,Y2):PRINT@25+768,A;
350 PRINT@384+25,S;:PRINT@448+25,H;:PRINT@640+25,V;:PRINT@704+25,AC;:PRINT@54+320,VV;
400 GOTO 200
500 IF A<0 THEN PRINT@0,"YOU HAVE LANDED";
510 IF A>10000 THEN PRINT@0,"YOU HAVE RISEN TOO HIGH. NO OXAGIN";
520 FORX=1TO15000:NEXTX:END
