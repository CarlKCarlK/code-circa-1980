1 '
100 INPUT"WHAT ORDER";D
110 DIMA(D,D+1)
115 DIMB(D+1)
120 FORX=1TOD:FORY=1TOD+1
130 PRINT"WHAT IS A("X","Y")";:INPUTA$:IFA$="H"THEN4000ELSEA(X,Y)=VAL(A$)
140 NEXT
160 NEXT
170 FORR=1TOD
180 GOSUB3000:PRINT
200 F=1/A(R,R):RX=R:GOSUB1000
210 FORB=1TOD+1:P(B)=A(R,B):NEXT
220 FORW=1TOD
240 F=-A(W,R)/A(R,R):RX=R:GOSUB1000
250 GOSUB2000
260 FORB=1TOD+1:A(R,B)=P(B):NEXT
270 NEXT
500 NEXT
600 PRINT"THE INTERSETION IS AT THE POINT (";
610 FORB=1TOD:PRINTA(B,D+1)",";:NEXT:PRINT")"
700 RUN1
1000 FORB=1TOD+1:A(RX,B)=A(RX,B)*F:NEXT:RETURN
2000 FORB=1TOD+1:A(W,B)=A(W,B)+A(R,B):NEXT:RETURN
3000 FORX=1TOD:FORY=1TOD+1:PRINTA(X,Y);:NEXT:PRINT:NEXT:RETURN
4000 INPUT"LOC. X,Y AND CORRECT VALUE 'A'";G,H,J:A(G,H)=J:GOTO130
