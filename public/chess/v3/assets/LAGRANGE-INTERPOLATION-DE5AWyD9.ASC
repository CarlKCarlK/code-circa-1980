100 CLS
130 DIMX(12),Y(12)
140 INPUT"NUMBER OF KNOOWN POINTS";P
160 FORI=1TOP
170 PRINT"X,Y OF POINT"I;
180 INPUTX(I),Y(I)
190 NEXTI
200 ONERROR GOTO 1000:CLS
210 FORA=1TO63
330 B=0:FORJ%=1TOP:T=1:FORI%=1TOP:IFI%=J%THENNEXTI%ELSET=T*(A-X(I%))/(X(J%)-X(I%)):NEXTI%
400 B=B+T*Y(J%):NEXTJ%:SET(A*2,48-B):SET(A*2+1.5,48-B+.5):NEXTA
1000 GOTO1000
