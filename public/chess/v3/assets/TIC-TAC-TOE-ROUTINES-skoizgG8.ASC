1000 ' FLIP ON HORZ
1010 FORC=1TO3STEP2
1020 X$=B$(C,1):B$(C,1)=B$(C,2):B$(C,2)=X$:X$=""
1030 NEXT
2000 ' FLIP ON VERT
2010 FORC=1TO3STEP3
2020 X$=B$(1,C):B$(1,C)=B$(2,C):B$(C,2)=X$:X$=""
2028 FORF=1TO3
2030 NEXT:RETURN
3000 'PRINT BOARD
3010 IFM=1THENGOSUB1000ELSE IFM=2THENGOSUB2000ELSEIFM=3THENGOSUB1000:GOSUB2000
3020 PRINT@0,"";
3030 FORC=3TO1STEP-1
3040 FORD=1TO3
3050 IFB$(D,C)=""THENPRINT"  ";ELSEPRINTB$(D,C);
3060 NEXT
3070 PRINT:NEXT
3090 PRINT:PRINT:PRINT
3100 IFM=1THENGOSUB1000:ELSEIFM=2THENGOSUB2000ELSEIFM=3THENGOSUB1000:GOSUB2000
3110 RETURN
4000 ' CHECKS FOR WINNER
4010 RESTORE
4015 FORJ=1TO8
4020 DATA1,3,2,3,3,3,1,2,2,2,3,2,1,1,2,1,3,1,1,3,1,2,1,1,2,3,2,2,2,1,3,3,3,2,3,1,1,1,2,2,3,3,1,3,2,2,3,1
4025 W=1
4028 FORF=1TO3
4030 READC,D
4035 PRINTC;D
4040 IFB$(C,D)=""THENW=0:GOTO4070
4050 IFF=1THENC$=B$(C,D)
4055 PRINTC$,B$(C,D)
4060 IFC$<>B$(C,D)THENW=0:GOTO4070
4065 PRINTF
4070 NEXTF
4080 IFW=1THEN5000ELSE4100
4100 C$="":NEXTJ:RETURN
5000 PRINT:PRINT:PRINT:IF(C$="X"ANDP=2)OR(C$="O"ANDP=1)THENPRINT"HA, HA I HAVE WON!!!!!"ELSEPRINT"CONGRATULATIONS YOU HAVE WON."
5010 INPUT"WOULD YOU LIKE TO PLAY AGAIN";A$:IFA$="YES"THENNEXTGELSEEND
6000 '
6100 FORH=1TO G-1
6110 IFSTR$(P)<>LEFT$(STR$(P(H)),LEN(STR$(P)))THEN6140
6120 L=VAL(MID$(STR$(P(H)),LEN(STR$(P)),1))
6130 T(L)=SGN(P(H))+T(L)
6140 NEXT
6150 FORH=1TO9
6170 IFT(H)>RTHENR=T(H)
6180 NEXT
6190 FORH=1TO9
6200 IFT(H)=RTHENQ=Q*10+H
6210 NEXT
6220 S=RND(INT(LOG(Q)))
6230 V=VAL(MID$(STR$(Q),S+1,1))
6236 PRINTV;
6238 STOP
6240 Z=V:GOSUB8000
6250 IFB$(X,Y)<>""THEN 6220ELSERETURN
8000 Y=INT(Z/3):X=Z-Y*3:RETURN
10000 G=2:P(1)=-123456:P=1234:GOSUB6000:PRINTV
10010 RUN10000
