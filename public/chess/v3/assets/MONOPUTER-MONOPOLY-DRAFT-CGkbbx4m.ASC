10 CLS
20 PRINT"HELLO, PEOPLE!"
25 PRINT"MY NAME IS MONOPUTER"
30 PRINT
40 PRINT
50 INPUT"HOW MANY WILL BE PLAYING (INCLUDING ME)";NP
60 CLS
70 PRINT"NOW LETS SEE WHO GOES FIRST, SOMEONE PLEASE ROLL THE"
80 PRINT"DIE FOR ME.  (PRESS ANYTHING WHEN THOUGH)"
90 IF INKEY$=""THEN 90
95 CLS:PRINT:PRINT
100 FOR I=1TO NP
110 PRINT"WHAT IS THE NAME OF THE PLAYER WHO GOES NUMBER";I;
120 INPUT N$(I)
125 N(I)=1
130 NEXTI
140 I=0
150 I=I+1:IFI>NP THEN I=1
160 CLS:PRINT:PRINT:PRINT
170 IF N$(I)="MONOPUTER"THEN500
180 PRINT"WELL IT LOOKS LIKE IT'S "N$(I)"'S TURN."
190 FORX=1TO500:NEXTX
200 PRINT"WHAT DID "N$(I)" ROLL";
210 INPUT R
220 IF R<1ORR>12THEN 200
230 N(I)=N(I)+R:IF N(I)>40 THEN N(I)=N(I)-40
240 RESTORE:FORX=1TON(I):READ P$:NEXTX
250 PRINT:PRINT"THAT PUTS "N$(I)" ON "P$","
