10 READ D:IF D>=0THEN N=N+1:GOTO10
20 RESTORE
30 FOR C=1TO N
40 READ D
50 T=C/3000
60 A=2*D/T[2
70 AV=A/N
80 NEXT C
90 PRINT"AVERAGE ACELLERATION";AV"FT/SEC
100 RESTORE
110 FORC=1TON
120 READ D
130 T=C/3000
140 A=2*D/T[2
150 NV=(A-AV)[2
160 NEXT C
170 SD=SQR(NV/N)
180 PRINT "STANDARD DEVIATION"SD"FT/SEC
2000 FOR T=1TO1000
2010 PRINT .5*32*(T/3000)[2;
2020 NEXT T
