10 PRINT" BOND AMORTIZATON"
20 PRINT"  (C) 1979 CARL KADIE
30 PRINT
40 INPUT"PRICIPAL";PR
50 INPUT"INTEREST";IN
60 INPUT"NUMBER OF YEARS";NY
70 INPUT"YEAR";YR
80 INPUT"ANNUAL MATURITY";AM
85 DIMT(6,NY),M(NY)
86 FOR AD=1 TO NY:M(AD)=-1:NEXT AD
90 OPEN1,4:OPEN2,4,1:OPEN3,4,2:OPEN4,4,4
94 PRINT#1,"YEAR         ";
95 PRINT#1,"PRINCIPAL{PETSCII-A0}{PETSCII-A0}{PETSCII-A0}       INTEREST{PETSCII-A0}{PETSCII-A0}{PETSCII-A0}   PR RETIRED{PETSCII-A0}{PETSCII-A0}{PETSCII-A0}          T.D.S"
96 PRINT#1,"            "
100 REM HEADING
120 E=2.7179766
130 T(2,0)=PR:T(4,0)=0
190 FOR YE=1TO NY
200 T(2,YE)=T(2,YE-1)-T(4,YE-1)
210 T(3,YE)=T(2,YE)*IN/100
220 EX=LOG((IN/100)+1)*(NY-YE+1)
230 T(6,YE)=(IN/100)*T(2,YE)/(1-1/E^EX)
240 T(6,YE)=INT(T(6,YE)*100+.5)/100
242 IF M(YE)<>-1 THEN T(4,YE)=M(YE):GOTO260
245 IF YE=NY THEN T(4,YE)=T(2,YE):GOTO 260
250 T(4,YE)=AM*INT((T(6,YE)-T(3,YE))/AM+.5)
260 T(5,YE)=T(4,YE)+T(3,YE)
270 T(1,YE)=YE+YR-1
280 NEXT YE
390 PRINT
400 FOR YE=1 TO NY
410 A1=T(1,YE):B1=T(2,YE):C1=T(3,YE):D1=T(4,YE):E1=T(5,YE):GOSUB1000
450 IF INT (YE/5) = YE/5 THEN PRINT
460 NEXT YE
470 PRINT#1,"{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-A0}{PETSCII-A0}{PETSCII-A0}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}";
480 PRINT#1,"{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-A0}{PETSCII-A0}{PETSCII-A0}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-A0}{PETSCII-A0}{PETSCII-A0}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-A0}{PETSCII-A0}{PETSCII-A0}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}{PETSCII-C3}"
510 FOR C=2TO5
520 TT=0
530 FOR YE=1TO NY
540 TT=T(C,YE)+TT
550 NEXT YE
560 S(C)=TT
570 IF C=2 THEN TS=TT
580 NEXT C
585 F$="AAAAA    9999999999.99     9999999999.99"
586 G$="    999999999.99     9999999999.99":F$=F$+G$
587 PRINT#3,F$:PRINT#2,"TOTAL",CHR$(29),S(2),S(3),S(4),S(5)
590 PRINT
690 PRINT#1:CLOSE 1
700 INPUT"HOW MANY PR. RETIRE'S DO YOU WISH TO    CHANGE (0 FOR NONE)";CO
710 IF CO=0 THEN 2000
715 FOR YE=1 TO NY:M(YE)=T(4,YE):NEXT YE
720 FOR AD=1 TO CO
730 INPUT"YEAR,NEW PR.RETIRED";YA,PD
740 M(YA-YR+1)=PD
750 NEXT AD
760 INPUT"DID YOU MAKE ANY MISTAKES";A$
770 IF A$="YES"OR A$="Y" THEN 700
780 GOTO 90
1000 REM
1050 PRINT#4
1060 F$="9999     9999999999.99     9999999999.99"
1065 G$="    999999999.99     9999999999.99":F$=F$+G$
1070 PRINT#3,F$
1090 PRINT#2,A1,B1,C1,D1,E1;
1110 CMD1
1120 RETURN
1500 A1=1000000000:B1=1400000:C1=70000:D1=80000:E1=85000:GOSUB1000:STOP
2000 REM OTHER STUFF
2005 T(6,0)=0
2010 FOR YE=1 TO NY
2020 T(5,YE)=YE*T(4,YE)/1000
2030 T(6,YE)=T(6,YE-1)+T(5,YE)
2040 NEXT YE
2050 OPEN 1,4:CMD1
2060 PRINT
2070 PRINT"YEAR         BOND YEARS      CUM. YEARS"
2075 F$="9999      9999999999.99     99999999.99":PRINT#3,F$
2080 FOR YE=1 TO NY
2090 PRINT#2, T(1,YE),T(5,YE),T(6,YE)
2100 NEXT YE
2105 PRINT#1:CLOSE 1
2110 END
