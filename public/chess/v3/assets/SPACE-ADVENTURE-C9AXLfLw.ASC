5 CLEAR 260:CLS:PRINT"SPACE ADVENTURE"
7 X=50:Y=50:X2=.001:Y2=.001:T=1
10 DIM P(20,6,2)
20 FOR S=1TO20: P(S,0,0)=RND(0)*100:P(S,0,1)=RND(0)*100:P(S,0,2)=RND(0)*100:FORP=1TO6:P(S,P,0)=P(S,0,0)+RND(0)-.5:P(S,P,1)=P(S,0,1)+RND(0)-.5:P(S,P,2)=RND(0):NEXTP,S
30 CLS:PRINT@960,"";
90 M$="":PRINT@960,STRING$(52," ");:PRINT@960,"";
100 PRINTCHR$(14);:A$=INKEY$:IFA$=""THEN150ELSE IF A$=CHR$(13) THEN 1000 ELSEIFA$=CHR$(8)THEN M$=LEFT$(M$,LEN(M$)-1):PRINT@960,M$;"  ";CHR$(24);CHR$(24);ELSEIFLEN(M$)>60 THEN 150 ELSEM$=M$+A$:PRINT@960+LEN(M$)-1,A$;
150 '
160 Y=Y+VY*T+.5*AY*T[2:X=X+VX*T+.5*AX*T[2:IF X>X1 AND X<X2 AND Y>Y1 AND Y<Y2 THEN RESET(OX,OY):SET( (X-X1)/(X2-X1)*105, (Y-Y1)/(Y2-Y1)*41):OX= (X-X1)/(X2-X1)*105:OY=(Y-Y1)/(Y2-Y1)*41ELSERESET(OX,OY):PRINT@896,"OFF SCREEN";
165 IFS$="Y"ANDSGN(VX)<>X7THEN AX=0
166 IFS$="Y"ANDSGN(VY)<>Y7THEN AY=0
170 VX=VX+AX*T:VY=VY+AY*T:PRINT@54,SQR(VX[2+VY[2);CHR$(14);:GOTO100
180 PRINTCHR$(14);:GOTO100
1000 PRINTCHR$(15);:IF LEFT$(M$,4)<>"SCAN"THEN1500ELSEX1=-999:X2=X1:Y1=X1:Y2=X1:IFMID$(M$,6,1)="A"THENX3=0:Y3=0ELSEX3=X:Y3=Y
1005 FORY4=0TO13:PRINT@Y4*64,STRING$(52," ");:NEXTY4
1010 I1=6:FORI=1TOLEN(M$)+1:MM$=MID$(M$,I,1):IFMM$=","ORMM$="O"OR I=LEN(M$)+1THEN N=VAL(MID$(M$,I1+1,LEN(M$))):I1=I:IFX1=-999THENX1=N+X3ELSEIFX2=-999THENX2=N+X3ELSEIFY1=-999THENY1=N+Y3ELSEIFY2=-999THENY2=N+Y3
1020 NEXTI
1025 C$(1)="*":C$(2)="."
1030 FORS=1TO20:P=0:C$="*":GOSUB1200:IFR1=1 AND X2-X1<20 AND Y2 -Y1<20 THEN FORP=6TO0 STEP-1:C$=C$(SGN(P)+1):GOSUB1200:NEXTP
1040 NEXTS
1050 GOTO 90
1200 X3=P(S,P,0):Y3=P(S,P,1):PRINT@960-64,X3,Y3;:IFX3>X1ANDX3<X2ANDY3>Y1ANDY3<Y2THENPRINT@(X3-X1)/(X2-X1)*52+INT((Y3-Y1)/(Y2-Y1)*13)*64,C$;:R1=1:RETURNELSER1=0:RETURN
1500 IFLEFT$(M$,3)<>"ACC"THEN1600ELSEA=VAL(MID$(M$,4,LEN(M$)-3)):FORI=4TOLEN(M$):IFMID$(M$,I,1)<>"T"THENNEXTIELSEAN=VAL(MID$(M$,I+1,LEN(M$)))/180*3.14159
1510 AX=COS(AN)*A:AY=SIN(AN)*A:GOTO 90
1600 IF M$="STOP"THENS$="Y":X7=SGN(VX):Y7=SGN(VY):GOTO90ELSEIFM$="GO"THENS$="":GOTO90ELSE1700
1700 GOTO90
