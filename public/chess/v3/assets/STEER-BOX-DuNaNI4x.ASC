10 PRINT"USE "CHR$(92)" AND "CHR$(91)" TO STEER BOX"
20 PRINT"PRESS ANY BUTTON"
30 IFINKEY$=""THEN30   
40 CLS
50 FORZ=1TO5:XX=RND(120):YY=RND(43):LINE(XX,YY)-(XX+7,YY+4),SET,BF:NEXT
60 LINE(0,0)-(127,47),SET,B
70 AA=.01
80 X=60:Y=20
90 PI=3.14159
100 A$=INKEY$:IFA$=""THEN110  ELSEIFASC(A$)=10ANDAA=.01THENA=A+PI:AA=-.25ELSEIFASC(A$)=91ANDAA=-.25THENAA=.01:A=A+PIELSEIFA$="4"THENQ=1ELSEIFA$="5"THENQ=0
110 A=A+AA
120 X=X+COS(A)*2:Y=Y+SIN(A)
130 IFQ=1THENLINE(0,0)-(127,47),SET,B
140 IFPOINT(X-4,Y+4)ORPOINT(X-4,Y-2)ORPOINT(X+7,Y-2)ORPOINT(X+7,Y+4)THENY=Y0:X=X0:GOTO170  
150 LINE(X0,Y0)-(X0+5,Y0+2),RESET,BF:LINE(X,Y)-(X+5,Y+2),SET,B:X0=X:Y0=Y
160 GOTO100  
170 LINE(X,Y)-(X+5,Y+2),SET,BF:GOTO100  
