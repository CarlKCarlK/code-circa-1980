10 CLS
20 X=15:Y=2
30 DIM M%(10),T(60,10)
40 GET@(X,Y)-(X+1,Y+1),G,M%
200 RESTORE:READ X1,Y1,X2,Y2:T(1,1)=X1:T(1,2)=Y1:T(1,3)=X2:T(1,4)=Y2:I=1:T(1,0)=1
210 READ X1,Y1,X2,Y2:IFX1=0THEN 500
215 LINE@(X1*3,Y1*2)-(X2*3,Y2*2),SET
220 FORS=1TOI
230 IF (T(S,1)=X1 AND T(S,2)=Y1) THEN T(S,0)=T(S,0)+1:T( S,T(S,0)*2+1)=X2:T(S, T(S,0)*2+2 )=Y2:M=1
240 IF T(S,1)=X2 AND T(S,2)=Y2  THEN T(S,0)=T(S,0)+1:T(S, T(S,0)*2+1)=X1:T( S,T(S,0)*2+2 )=Y1:M=M+2
260 NEXT S
270 IF M=0 OR M=2 THEN I=I+1:T(I,1)=X1:T(I,2)=Y1:T(I,3)=X2:T(I,4)=Y2
280 IF M=0 OR M=1 THEN I=I+1:T(I,1)=X2:T(I,2)=Y2:T(I,3)=X1:T(I,4)=Y1
290 M=0
300 GOTO 210
500 FOR S=1TOI
510 FOR B=3TO T(S,0)*2+1STEP2:K(B-3)=T(S,B):K(B-2)=T(S,B+1):T(S,B)=0:T(S,B+1)=0:NEXTB:FORB=0TOT(S,0)*2-2:B(1)=K(B):B(2)=K(B+1)
520 IF T(S,1)=B(1) AND T(S,2)>B(2) THEN T(S,3)=B(1):T(S,4)=B(2)
530 IF T(S,1)=B(1) AND T(S,2)<B(2) THEN T(S,5)=B(1):T(S,6)=B(2)
540 IF T(S,1)>B(1) AND T(S,2)=B(2) THEN T(S,7)=B(1):T(S,8)=B(2)
550 IF T(S,1)<B(1) AND T(S,2)=B(2) THEN T(S,9)=B(2):T(S,10)=B(2)
560 FORS=1TOI:FORB=0TO10:PRINTT(S,1),:NEXTB,S
1000 DATA 5,1,5,2, 5,2,4,2, 5,2,5,3, 5,3,4,3, 5,3,5,4, 5,4,6,4,           5,4,5,5, 5,5,1,5, 5,5,13,5, 5,5,5,6, 5,6,1,6, 5,6,22,           6, 5,6,5,7, 5,7,5,10, 5,7,4,7, 5,7,21,7, 21,7,22,7
1010 DATA 21,7,21,8, 21,8,25,8, 25,8,25,9, 24,9,25,9, 25,9,25,            10, 25,10,24,10, 25,10,25,11, 25,11,24,11, 25,11,25,            12, 25,12,24,12, 25,12,25,13, 25,13,26,13, 25,13,25,            14
1020 DATA 25,14,26,14, 25,14,25,15, 25,15,24,15, 25,15,25,16,             25,16,24,16, 25,16,25,19, 25,19,24,19, 25,19,28,19,             25,19,25,20, 25,20,26,20, 25,20,25,24, 25,16,36,16
1030 DATA 36,16,37,16, 36,16,36,17, 36,17,34,17, 36,17,40,17,             36,17,36,19, 36,19,35,19, 36,19,39,19, 36,19,36,20,             36,20,40,20, 36,20,36,22, 36,22,37,22, 36,22,36,23
1040 DATA 36,23,37,23
1050 DATA 0,0,0,0
10000 A$=INKEY$:IFA$<>""THENPRINTASC(A$);:GOTO10000ELSE10000
