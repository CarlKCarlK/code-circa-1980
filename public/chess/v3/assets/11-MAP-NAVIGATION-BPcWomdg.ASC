10 CLS
20 X=15:Y=2
30 DIM M%(10)
40 GET@(X,Y)-(X+1,Y+1),G,M%
100 READ X1,Y1,X2,Y2:IFX1=0 THEN 300
110 LINE(X1*3,Y1*2)-(X2*3,Y2*2),SET
120 GOTO 100
300 A$=INKEY$:IFA$=""THEN400
310 IFA$=CHR$(8) THEN XC=-1:YC=0ELSEIFA$=CHR$(9)THENXC=1:YC=0ELSEIFA$=CHR$(91)THENYC=-1:XC=0ELSEIFA$=CHR$(10)THEN YC=1:XC=0
400 PRINT@60,POINT(X+XC*3,Y+YC*3);:FORZ=1TO20:NEXT:IF NOT(POINT(X+XC*3,Y+YC*3))THENXC=0:YC=0:GOTO 300
410 X=X+XC*3:Y=Y+YC*3:PUT@(OX,OY)-(OX+1,OY+1),SET,M%:GET@(X,Y)-(X+1,Y+1),G,M%:LINE(X,Y)-(X+1,Y+1),SET,BF:OX=X:OY=Y
420 GOTO 300
1000 DATA 5,1,5,2, 5,2,4,2, 5,2,5,3, 5,3,4,3, 5,3,5,4, 5,4,6,4,           5,4,5,5, 5,5,1,5, 5,5,13,5, 5,5,5,6, 5,6,1,6, 5,6,22,           6, 5,6,5,7, 5,7,5,10, 5,7,4,7, 5,7,21,7, 21,7,22,7
