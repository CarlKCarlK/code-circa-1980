5 REMARK VECTOR RESULTANTS
6 REM          PLACE MAG,ANG IN DATA.   LINE 1000 END PROGRAM
10 READ MAGNITUDE
12 IF MAGNITUDE=0 THEN 100
14 READ ANGLE
20 ANGLE=ANGLE/180*3.14159
30 X=X+COS(ANGLE)*MAGNITUDE
40 Y=Y+SIN(ANGLE)*MAGNITUDE
50 GOTO 10
100 MAGNITUDE = SQR( X[2 + Y[2 )
110 ANGLE = ATN ( Y / X )
120 PRINT"TOTAL X=";X
130 PRINT"TOTAL Y=";Y
140 PRINT"MAGNITUDE OF VECTOR=";MAGNITUDE
150 PRINT"C.C.W. ANGLE FROM X-AXIS=";ANGLE*180/3.14159
200 DATA 120,0,  200,60,  150,225
1000 DATA 0
