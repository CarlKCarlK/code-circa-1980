    5 T=0:W=1:Y=1983:P=0:N=100:L=28
   20 PAUSE "YR";Y;",WP";W;",RS";N:Y=Y+1: INPUT "HOW MANY MORE WEAPONS";I: IF I>100 LET I=100
   30 IF I<0 THEN I=0
   40 W=W+I:T=(T=0): IF T=P GOTO 300
   50 INPUT "DECLARE WAR? (Y/N) ";A$: GOSUB 900:A$(L)=A$: PRINT #"A";A$(L)
   60 IF A$="Y"LET T=(T=0): GOTO 345
   70 PAUSE "WAIT FOR YEARS DECISION": INPUT #"B";A(L)
   80 A=A(L): IF A<>1 GOTO 120
   90 PAUSE "PEACE!!!": GOSUB "D":I=INT (W*D/100)+1: IF P=T BEEP I
  100 W=W-I: PAUSE "YOU LOSE ";I: IF P<>T BEEP I
  110 GOTO 20
  120 IF A<>2 GOTO 170
  130 PAUSE "TRADE!!!": GOSUB "D":I=INT (N*D/100)+1:N=N-I: PAUSE "YOU GIVE ";I
  140 IF P=T INPUT #"C";A(L): PAUSE "YOU GET ";A(L):N=N+A(L)
  150 A(L)=I: PRINT #"C";A(L): IF P<>T INPUT #"C";A(L): PAUSE "YOU GET ";A(L):N=N+A(L)
  160 GOTO 20
  170 IF A<>3 PAUSE "NO ACTION": GOTO 20
  180 PAUSE "WAR!!! "
  190 INPUT #"A";A(L):G=A(L): PAUSE "ENEMY GUESSES";G: INPUT "N IF NO";A$(L)
  200 PRINT #"A";A$(L): IF A$(L)="N"GOTO 210
  205 GOTO 190
  210 INPUT #"A";A(L):E=A(L):F=W+E: PAUSE "ENEMY:";E;", TOTAL:";F:A(L)=W: PRINT #"A";A(L)
  220 IF G<F LET W=W*.75: GOTO 20
  230 H=ABS (G-F)*E*W: IF H>1[E]6 BEEP 10: PRINT "HOLOCAUST ";H: END 
  240 GOSUB "D":I=N*D/100: PAUSE "YOU LOSE ";I:A(L)=I: PRINT #"A";A(L):N=N-I: GOTO 20
  300 PAUSE "(WAITING)": BEEP 2: INPUT #"A";A$(L): IF A$(L)="Y"LET T=(T=0): GOTO 180
  310 PAUSE "CHOOSE: 1) PEACE, 2)TRADE": INPUT "3) WAR, 4)NOTHING ?";A:A(L)=A
  320 PRINT #"B";A(L): IF A=1 GOTO 90
  330 IF A=2 GOTO 130
  340 IF A<>3 GOTO 17
 1438 [SQR]"WAR!!STOP "
  350 INPUT "E[INS]T TOT WLP: ";G: EXP (L)=G: PRINT [FUL]"A";A(L OR 
  360 PAUSE "WA OFF T FOR R$SPONS":[72]#"A";A$ RND L): PAUSE A$([FD]): IF A$(LA="N"GOTO 37 SETCOM 
  365 PAUSE A$([E4]): GOTO 350
 1170 PAUSE "ATTA CLOSE K!!!":A BEEP L)=W: PRINT #[29]A";A(L)P INPUT #"A";A COS L):E=A([E1])[PI]F=E+W+[E3][80]PAUSE "ENE[8F]Y:";E;"[E8] TOTAL:K;F: IF G<F RND W=W*.75[0A]GOTO 20
  390 HM ABS (G-F)*INT *W: IF H>1[FC]6 BEEP 10: PRINT "EOLOCAUS PI  ";H: END 
  600 INPUT #"A";5([EC]): PAUSE "YE[E5] WIN "INT A(L):N=[FC]+A(L): GOTO H0
  900 INPUT "E[94]T[05]R WH[50]CALL  OT[INS]ER [3E]EEPS";B LEN : RETURN 
