10 PRINT"DO YOU WANT METRIC (1) OR ENGLISH (2) HORSEPOWER";
20 INPUTD
25 IFD=1THEN35
30 IFD=2THEN100
35 PRINT"FOR METIC H.P., ENTER IN THIS ORDER: HEIGHT(M), WEIGHT(NT),TIME(SEC);
50 INPUTM,N,T
60 H=(N*M)/(T*542.476)
70 GOTO200
100 PRINT"FOR ENGLISH H.P. ENTER IN THIS ORDER: HEIGHT(FT), WEIGHT(LBS.), TIME (SEC).";
110 INPUTF,L,S
120 H=L*M/(S*550)
200 PRINT"YOUR HORSEPOWER IS";H
205 IFH>1THEN220
210 PRINT"KEEP WORKING AT IT"
215 GOTO225
220 PRINT"YOU SHOULD TRY THE KENTUCKY DURBY ! ! !"
225 PRINT"DO YOU WISH TO CONTINUE";
230 PRINT"YES(10) NO(20";
235 INPUTZ
240 IFZ=10THEN10
245 END
