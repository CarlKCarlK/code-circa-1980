20 MK=2
30 DIM P(1000,1)
80 G=G+1
90 LU=0
100 INPUT"DO YOU WISH TO GO FIRST";A$
110 IF A$="YES"THEN500
120 IF MK=1THEN MK=2 ELSE MK=1
130 GOSUB7000
140 LU=LU+1
145 IF P(LU,1)=20000 THEN200
150 IF TI=P(LU,1) THEN C( ABS( P(LU+1,0)))=C(ABS(P(LU+1,0)))+SGN(P(LU+1,0)
160 GOTO140
200 RH=-10:TL=0
210 FOR CH=1TO9
220 IF C(CH)>RH THEN RH=C(CH):TL=0 ELSE IF C(CH)=RH THEN TL=TL+1
230 NEXT
240 OP=RND(TL)
245 RU=0
250 FOR CH=1TO9
260 IF C(CH)=RH THEN RU=RU+1:IFRU=OP THEN 300
270  NEXT CH
280 PRINT"ERROR AT 280":STOP
1000 DEF FNM(N,M)=INT((N/M-INT(N/M))*M)
1005 L=1:FF=2
1010 FORK=1TO8:R=1
1020 IF K=5THENGOSUB2000 
1030 GOSUB4000 
1040 FORC=1TO3:FF=2:L=1:IFB(1,C)=L THEN T=T+100
1050 IFB(1,C)=FF THEN T=T+1
1060 IF B(3,C)=L THEN T=T-100
1070 IF B(3,C)=FF THEN T=T-1
1080 IFB(C,1)=LTHENT=T+1000
1090 IF B(C,1)=FF THEN T=T+10
1100 IFB(C,3)=LTHEN T=T-1000
1110 IFB(C,3)=FF THEN T=T-10
1120 IF C<>1THEN 1150 
1130 IF B(1,1)=L THEN T=T+.1ELSEIFB(1,1)=FF THEN T=T+.001
1140 IF B(2,1)=L THEN T=T+.01 ELSE IF B(2,1)=FF THEN T=T+.0001
1150 NEXTC
1160 GOSUB5060 
1170 T(R)=T:T=0:NEXT
1180 GOSUB2000 
1190 TR=-999999
1200 FOR IT=1TO8
1210 IFT(IT)>TR THEN TR=T(TR)
1220 NEXT IT
1230 RETURN
2000 'FLIP ON X-AXIS
2010 FOR A=1TO3
2020 H=B(A,3):B(A,3)=B(A,1):B(A,1)=H
2030 NEXT A
2040 RETURN
3000 'FLIP ON Y-AXIS
3010 FOR A=1TO3
3020 H=B(3,A):B(3,A)=B(1,A):B(1,A)=H
3030 NEXT A
3040 RETURN
4000 ' ROTATE TO C-W 45 DEG. FOR EACH R
4010 R=FNM(R,4):IFR=0THENR=4
4020 FOR B=1TOR
4030 FOR N=1TO3
4040 FOR M=1TO3
4050 H(M,N)=B(M,N)
4060 NEXTM,N
4070 FOR N=1TO3
4080 FOR M=1TO3
4090 B(N,4-M)=H(M,N)
4100 NEXTM,N,B
4110 RETURN
5000 FORN=1TO3
5010 FORM=1TO3
5020 PRINTM;N;:INPUTB(M,N)
5030 IF B(1,1)=-2THEN  6000 XT:RETURN
5040 NEXT M,N
5050 RETURN
5060 FORN=1TO3:FORM=1TO3
5070 PRINTB(M,N);
5080 NEXT M
5090 PRINT:NEXTN
5100 RETURN
6000 B(1,1)=0:N1=RND(5):M1=RND(2)+N1-2:IFM1=5THENM1=4
6010 FOR NI=1TON1
6020 NX=RND(3):NY=RND(3)
6030 IF B(NX,NY)=0THENB(NX,NY)=1ELSEGOTO6020 
6040 NEXT
6050 FOR MI=1TOM1
6060 MX=RND(3):MY=RND(3)
6070 IFB(MX,MY)=0THENB(MX,MY)=2ELSE6060 
6080 NEXT
6090 RETURN
7000 TI=0
7005 ST=0
7010 FORN=1TO3
7020 FORM=1TO3
7030 TI=TI*3+B(M,N)
7040 NEXTM,N
7050 PRINT TI
7070 RETURN
8000 FORN=1TO3
8010 FORM=1TO3
8015 FQ=3[(12-(N*3)-M)
8018 IF M=3ANDN=3 THEN B(3,3)=INT(TI+.5):GOTO8030
8020 B(M,N)=INT(TI/FQ+.01)
8025 TI=TI-B(M,N)*FQ
8030 NEXT M,N
8040 RETURN
