0 CLS
1 INPUT "RANDOM";S
2 FORE=2TO124:SET(E,1):SET(E,46):NEXT:FORE=1TO46:SET(2,E):SET(124,E):NEXT
4 Z2=1
5 A1=20:A2=30:B1=50:B2=60:A3=A1:B3=B1:A4=A2:B4=B2
6 GOTO18
7 POKE16553,255
10 A$=INKEY$:IFA$=""THEN25
11 IF A$=CH$THEN   A6=A1:A1=A2:A2=A6   :A6=A4:A4=A3:A3=A6:       B6=B1:B1=B2:B2=B6:   B6=B4:B4=B3:B3=B6: B6=Z:Z=Z2:Z2=B6: B6=Y:Y=Y2:Y2=B6:GOTO25
12 RESTORE:IFA$="P"ORA$="Q"THENCH$="5"ELSEIFA$="A"ORA$=";"THENCH$="0":' RESTORE                                                     
13 IF A$=" " THEN CH$=""
18 IF(VAL(A$)>5)AND(VAL(A$)<10)THEN750
20 FORX=1TOVAL(A$):READZ,Y:NEXTX
25 A=A1:B=B1:GOSUB110
26 B1=B:A1=A:GOSUB150
28 GOTO10
30 IF  RND(S) = 1 THEN  SS=1  ELSE SS=0
31 IF(POINT(B1,A1)AND (PEEK(14464) <>1 OR CH$<>"5"))OR(POINT(B2,A2)AND(PEEK(14464)<>1 OR CH$<>"0"))OR SS=1THEN500 ELSESET(B1,A1):SET(B1+1,A1):SET(B2,A2):SET(B2+1,A2):B3=B1:A3=A1:B4=B2:A4=A2:RESTORE:RETURN
40 DATA0,-1,0,1,-1,0,1,0
100 REM
110 IFB>126 THEN B=0
120 IFB<0THENB=B+128
130 IFA>47THENA=A-48
140 IFA<0THENA=A+48
145 RETURN
150 B1=B1+Z*2:A1=A1+Y:A2=A2+Y2:B2=B2+Z2*2:GOTO30
200 PRINTCHR$(23):IFB5=B4ANDA5=A4THENPRINT"PLAYER ON THE RIGHT CRASHED":RS=RS+1ELSEPRINT"PLAYER ON THE LEFT CRASHED":LS=LS+1
205 PRINT"         SCORE":PRINTRS,LS
210 CLS:GOTO2:PRINT"DO YOU WANT TO PLAY AGAIN";:INPUTS$:IFS$="NO"THEN END 
220 CLS:RESTORE:GOTO 2
500 IF NOT(POINT(B1,A1))AND (SS=0 OR (GO=4ANDCH$="5"))THEN ELSEB5=B3:A5=A3:GOSUB900:B1=B3:A1=A3 :RN=SGN(RND(2)-1.5):IF Z=0 THEN Z=RN :Y=0  ELSE Y=RN:Z=0
510 IFNOT( POINT(B2,A2)) AND (SS=0 OR (GO=4ANDCH$="0"))THENELSEB5=B4:A5=A4:GOSUB900:B2=B4:A2=A4:RN=SGN(RND(2)-1.5):IFZ2=0 THEN Z2=RN:Y2=0 ELSE Y2=RN:Z2=0
515 SET(B1,A1):SET(B1+1,A1):SET(B2,A2):SET(B2+1,A2):B3=B1:A3=A1:A4=A2:B4=B2
520 RESTORE:RETURN
750 FORX=1TOVAL(A$)-5:READZ2,Y2:NEXTX
770 A=A2:B=B2:GOSUB110
780 B2=B:A2=A:GOSUB150
790 GOTO10
900 IFPOINT(B5+2,A5)ANDPOINT(B5-2,A5)ANDPOINT(B5,A5-1)ANDPOINT(B5,A5+1)THEN200ELSERETURN
1000 B$="BETTY A. QUILLEN"
1010 R$="RICHARD W. LOSEY"
