10 DIMA#(20)
15 GOTO3000
20 FORX=1TO20
25 D=5:B1=-1:RANDOM
30 A#(X)=RND(20)*10000+RND(20)*100+RND(20)
40 NEXT
50 L=RND(20):G=RND(20):IFG=LTHEN50
60 T=T+1:PRINT:PRINT:PRINT"TURN #"T"   "D" DARTS  AND "4-B1" DINIMITE STICKS LEFT.":PRINT:PRINT"YOU ARE IN CAVE #"L"THE BEAST WAS IN CAVE #"G",BUT JUST MOVED"
70 R=A#(G):GOSUB1000:S=RND(3):IFC(S)=LORC(S)=0THEN70ELSEG=C(S)
90 R=A#(L):GOSUB1000:
100 PRINT"FROM CAVE#"L"YOU CAN MOVE TO CAVES"C(1);","C(2);",""OR";C(3)"."
110 INPUT"WHICH ONE SHALL IT BE";C:IFC=0THENB1=1+B1:IFB1>4THENPRINT:PRINT"OUT OF DINOMITE":GOTO110ELSEB(B1)=L:C=LELSEIFC>99THENGOTO2000
115 IFC=C(1)ORC=C(2)ORC=C(3)THEN120ELSE100
120 L=C:IFC=GTHEN500ELSE60
500 PRINT"YOU DID YOU FOULD THE BEAST. AND IN ONLY"T"TURNS!.":INPUT"WOULD YOU LIKE TO TRY AGAIN WITH THE SAME MAP";A$:T=0:IFA$="NO"THENENDELSEGOTO50
1000 C(1)=INT(R/10000):R=R-C(1)*10000:C(2)=INT(R/100):R=R-C(2)*100:C(3)=R:FORA=1TO3:FORB=0TO4:IFC(A)=B(B)THENC(A)=0
1010 NEXT:NEXT:IFC(1)=0ANDC(2)=0ANDC(3)=0THENPRINT"SOMEONE IN THE CAVERNS IS TRAPPED":ENDELSERETURN
2000 C=C/100:D=D-1:IFD<1THENPRINT"MISS, AND BECAUSE YOU'RE OUT OF DARTS, THE BEAST GOT YOU!":ENDELSEGOTO115
3000 CLS:PRINT"WELCOME GREAT HUNTER TO THE WORLD FAMOUS CARLSGOOD CAVERNS.":PRINT"WHAT'S THAT?  YOU THOUGHT YOU WERE AT THE CARLSBAD CAVERN?":PRINT"TOO BAD. HAVE YOU HUNTED FOR THE BEAST HERE BEFORE";:INPUTA$:IFA$="YES"THEN20
3010 CLS:PRINT"WELL THERE'S A FIRST TIME FOR EVERYTHING (AND SOMETIMES ":PRINT"AT LAST). YOU WILL BE RANDOMLY PLACED IN ONE OF OUR TWENTY":PRINT"CAVERNS, AS WILL A BEAST.  ON EACH TURN YOU WILL BE TOLD WHERE"
3020 PRINT"YOU ARE, WHAT CAVERNS YOU MAY GO TO, AND WHERE THE BEAST WAS":PRINT"LAST.  EACH CAVERN HAS THREE, ONE-WAY TUNNELS LEADING FROM":PRINT"IT.  THESE TUNNELS CAN CONNECT TO ANY CAVERN, EVEN, SOMETIMES"
3030 PRINT"THE ONE YOUR PRESENTLYY IN.":INPUT"('ENTER')";A$:PRINT"THE OBJECT OF YOUR EXPEDITION IS TO SHOOT THE BEAST WITH A":PRINT"TRANQUILIZER DART FROM YOUR BLOWGUN.  IF YOU THINK YOUR NEXT":PRINT"MOVE WILL BRING YOU TO THE BEAST, TYPE THE ROOM NUMBER 
3035 PRINT"THAT YOU SUSPECT TIMES 100.(YOU HAVE ONLY THREE DARTS).
3040 PRINT"TO AID IN YOUR ENDENVOR, YOU ARE SUPPIED WITH 5 STICKS OF":PRINT"DYNOMITE, WITH WHICH YOU MAY PREVENT ANYONE FROM ENTERING THE CAVERN YOUR NOW IN (YOU CAN STILL LEAVE). TO USE THE DYMOMITE"
3050 PRINT"JUST TYPE ZER0 ('0'). GOOD LUCK AND TAKE A COAT IT GETS":PRINT"COLD IN THOSE DAMP CAVES."
3060 INPUT"ENTER";A$:GOTO20
10000 END
