3 ON ERROR GOTO 10001
5 REM THE BEST OF THE MONSTER GAMES ---- JAB
10 CLEAR 100:DEFINT C,N
20 CLS:PRINT"WORKING"
30 W=70:L=40:Z2=.3
40 IF W/2<>INT(W/2) THEN W=W-1
50 IF L/2<>INT(L/2) THEN L=L-1
60 DIM C(W,L),NS(30,3)
70 FOR X=1 TO W-1 STEP 2:FOR Y=1 TO L-1 STEP 2:C(X,Y)=2:NEXTY,X
71 GOSUB 1000:' ************
80 X=RND(W-1):[=RND(L/2-1-*2:IF XLEFT$3=LEFT$(X/2) THEN;CINT~ÿþ_USINGÿÿÿÿûÿÿLOGCHR$ýERRORÿÿASCýMKS$:IFZZ/W/L<Z2 THEN 80
91 GOSUB1000:'********
100 FOR X=2 TO W-2 STEP 2:FOR Y=1TOL-1:GOSUB 200:NEXT Y,X
101 GOSUB1000:' ************
110 FOR Y=2 TO L-2 STEP 2:FOR X=1TOW-1STEP 2:GOSUB 230:NEXTX,Y
111 GOSUB1000:' ************
130 FOR IV=1TO (W*L/4):X=RND(W-1):Y=RND(L-1):GOSUB300:NEXTIV
131 GOSUB1000' *************
150 GOTO 1530
200 IF X<>1 THEN IF C(X,Y)+C(X-1,Y-1)+C(X-2,Y)+C(X-1,Y+1) =0 THEN C(X,Y)=2
230 IF C(X,Y-1)+C(X,Y+1)+C(X-1,Y)+C(X+1,Y)>= 6 THEN C(X,Y)=2
240 RETURN
300 T4=C(X,Y-1)+C(X,Y+1):T5=C(X-1,Y)+C(X+1,Y):IF ((T4=0 AND T5=4 )OR (T4=4 AND T5=0)) THEN C(X,Y)=1
310 RETURN
1000 RETURN:CLS:FOR X0=0TOW:FORY0=0TOL:IFC(X0,Y0)=0 THEN SET(X0,Y0)
1010 NEXT Y0,X0
1020 RETURN
1530 H=0:V=0:TD=1000:'TOTAL DROPS
1535 FORI=1TO4:READ X(I),Y(I):NEXTI:WS(1)=0:WS(2)=1:WS(3)=2:WS(4)=2
1570 PX=RND(W-4)+2:PY=RND(L-2)+1:C(PX-1,PY)=2:C(PX+1,PY)=2
1642 PRINT@896,"";:INPUT"HOW MANY JABBERWOCKIES";JB
1643 IF JB>20 THEN PRINT"NO MORE THAN 15 PLEASE":GOTO1642
1644 J9=JB
1645 IF JB=0 THEN 1642
1647 NS=JB
1648 FOR I=1TOJB:NS(I,0)=RND(W-2)+1:NS(I,1)=RND(L-2)+1:NS(I,2)=RND(2):C(NS(I,0),NS(I,1))=3:NEXTI:SC=1
1650 SS$=STRING$(4,CHR$(191))
1660 S3$=CHR$(140)+CHR$(170)+CHR$(149)+CHR$(140)  :C$(0)=SS$:C$(1)=S3$:C$(3)="    "
1680 IFMA=6 THEN SC=1:GOTO1720 ELSE FORLU=0TO768STEP64:PRINT@LU,"? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? ? "CHR$(170)" "CHR$(170)" ";:NEXTLU
1682 FOR X=1 TO 6:IF C(PX+X,PY)>1 THEN NEXT X
1683 IF X=7 THEN X1=6 ELSE X1=X
1684 FOR X=-1 TO -6 STEP -1:IF C(PX+X,PY)>1 THEN NEXTX
1685 IF X=-7 THEN X2=-6 ELSE X2=X
1686 FOR Y=1 TO 6:IF C(PX,PY+Y)>1 THEN NEXTY
1687 IF Y=7 THEN Y1=6 ELSE Y1=Y
1688 FOR Y=1 TO 6:IF C(PX,PY-Y)>1 THEN NEXTY
1689 IF Y=7 THEN Y2=-6 ELSE Y2=-Y
1690 FORX=1TO1:NEXTX:FORY=1TO1:NEXTY:QX=PX:QY=PY
1695 GOSUB1840:FORX=X2TOX1:FORY=Y2TOY1
