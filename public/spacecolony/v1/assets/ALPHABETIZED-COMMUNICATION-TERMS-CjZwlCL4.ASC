1 CLS:PRINT"THIS PROGRAM  ALPHABETIZES THE WORD IN DATA AND DESPLAYS THEM ONE AT A TIME ON SCREEN ON THE PUSH OF ANY BUTTON."
2 INPUT"PRESS ENTER";A$
4 CLS
5 CLEAR1000:DIMW$(70)
6 R$="ZZZZZ"
10 READ W$
20 IFW$="DONE"THEN100
30 A=A+1:W$(A)=W$
40 GOTO10
100 FORX=1TOA
110 FORY=1TOA
120 IFW$(Y)<R$THENR$=W$(Y):S=Y
140 NEXT
143 IFINKEY$=""THEN143ELSECLS:PRINT@6*64,"";
145 PRINTR$
150 R$="ZZZZZ":W$(S)="ZZZZZ"
160 NEXT
1000 DATA NEUROLOGICAL I.,SYNAPSE,RELEASER CON.,SELEXTIVE PER.,PSYCHOLOGICAL SET,FILTERING,COMPLETING,SENSORY-INTAKING,SENSORY DEPR.,PERSON PERCEPTION,SYMBOLIZATION,SYMBOL,REFERENT,MEMORY
1010 DATA SELF-CON.,SELF-AS-OB.,REFLEXIVITY,SIGNIFICANT OTHERS,REFERENCE GROUP,ROLE PLAYING,ROLE TAKING,SELF-FULFILLING PRO.,NEGATIVE SELF-CON.,SELF-DISCLOSURE,RITALIZED COMMU.
1020 DATA PRIMARY GROUP,CASUAL GROUP,EDUCATIONAL G.,THERAPEUTIC G.,PROBLEM-SOLVING G.,BELONGING,SOCIOEMOTIONAL C.,TASK MAIN.,DEMOCRATIC LEADERSHIP,SHARED LEADERSHIP,CONSENSUS,LOGICAL PROBLEM SOLVING
10000 DATA DONE
