20 CLEAR1000
30 INPUT"HOW MANY SETS OF PROBLEMS";SP
40 INPUT"AND HOW MANY PROBLEMS PER SET";PS
50 CLS:'CALL PRINTER
60 FOR SE=1TOSP
65 PRINT"PROBLEM SET";SE:PRINT:PRINT
70 FOR PR=1TOPS
75 PRINT"("PR")  FIND :"
80 I1=RND(RND(90))
90 I2=RND(RND(90))
100 D=RND(RND(RND(100)))
110 N=RND(RND(100))
130 R=RND(RND(13))
140 D=D*R:IFD>100THEN100
150 N=N*R
160 N1=RND(N)
170 N2=N-N1
175 D1=D:D2=D
177 IFN1>=D1ORN2>=D2ORN1=0ORN2=5þPOKE00
180 DD=D1:NN=N1:GOSUB1000
190 D1=DD:N1=NN
200 DD=D2:NN=N2
210 GOSUB1000:D2=DD:N2=NN
230 IFRND(2)=1THENR=RND(RND(13)):N1=N1*R:D1=D1*R
240 IFRND(2)=1THENR=RND(RND(13)):N2=N2*R:D2=D2*R
260 IFD1>49ORD2>49ORD1=D2THEN100
300 PRINT"    ";I1;N1"/"D1" + "I2;N2"/"D2"="
310 PRINT
320 GOSUB700
330 A$(1)=STR$(I):IFN<>0THENA$(1)=A$(1)+STR$(N)+"/"+STR$(D)
340 FORAA=2TO5
350 ONRND(10)GOSUB1100,1200,1300,1400,1500,1600,1700,1800,1900,2000
355 IFN=DTHENN=0:I=I+1
360 A$(AA)=STR$(I):IFN<>0THENA$(AA)=A$(AA)+STR$(N)+"/"+STR$(D)
370 FORCH=1TOAA-1
380 IFA$(CH)=A$(AA)THEN350
390 NEXTCH
400 NEXTAA
410 R=RND(5):H$=A$(1):A$(1)=A$(R):A$(R)=H$
420 PRINT
430 FORL=1TO5
440 PRINTCHR$(64+L);")  "A$(L);"   ";
450 NEXT
460 PRINT
470 PRINT:PRINTTAB(45),CHR$(64+R)") ";A$(R)
480 PRINT:NEXTPR
490 PRINT:PRINT"- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -"
500 NEXTSE
510 END:'UNCALL AND PRINT "DONE"
700 REM CORRECT ANSWER
710 N=N1*D2+N2*D1
720 D=D1*D2
730 I=I1+I2
740 IFN>=DTHENN=N-D:I=I+1:GOTO740
750 NN=N:DD=D:GOSUB1000
760 N=NN:D=DD:RETURN
1000 REM REDUCER
1005 L=NN:IFDD>NNTHENL=DD
1007 IFNN/2=INT(NN/2)ANDDD/2=INT(DD/2)THENNN=NN/2:DD=DD/2:GOTO1007
1010 FORII=3TOLSTEP2
1020 IFII>NNORII>DDTHENII=L
1030 IFNN/II=INT(NN/II)ANDDD/II=INT(DD/II)THENNN=NN/II:DD=DD/II:GOTO1030
1040 NEXTII
1050 RETURN
1100 'REMMULT I'S
1110 GOSUB700
1120 I=I1*I2
1130 RETURN
1200 REM ADD ALL AND REDUCE
1210 I=I1+I2
1220 N=N1+N2
1230 D=D1+D2
1240 NN=N:DD=D:GOSUB1000
1250 N=NN:D=DD
1260 RETURN
1300 'NO REDUCING
1310 N=N1*D2+N2*D1
1320 D=D2*D1
1330 I=I1+I2
1340 RETURN
1400 REM  RANDOM ANSWER
1410 I=RND(100)
1420 D=RND(50)
1430 N=RND(D)
1440 RETURN
1500 REM RANDOM FRACTION
1510 I=I1+I2
1520 D=RND(50)
1530 N=RND(D)
1540 NN=N:DD=D:GOSUB1000
1550 N=NN:D=DD
1560 RETURN
1600 'REMADDING COMMMON D
1610 GOSUB700
1620 D=2*D
1630 RETURN
1700 GOSUB700
1710 I=I1*I2
1720 D=D1*D2
1730 N=N1*N2
1740 RETURN
1800 REM SUB. ALL PARTS
1810 I=ABS(I1-I2)
1820 N=ABS(N1-N2)
1830 D=ABS(D1-D2)
1840 RETURN
1900 REM  ADD N   MULT D
1910 N=N1*N2
1920 D=D1*D2
1930 I=I1*I2
1940 NN=N:DD=D:GOSUB1000
1950 N=NN:D=DD
1960 RETURN
2000 'REM JUST RANDOM INTERGER
2010 N=0:I=RND(100)
2020 RETURN
