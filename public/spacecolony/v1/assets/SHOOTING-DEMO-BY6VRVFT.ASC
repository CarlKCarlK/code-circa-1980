5 CLEAR200
10 CLS
20 FORX=3TO60 STEP 10
30 PRINT@X,"*";
35 L=L+1:L(L)=X
40 NEXT
50 B=L (RND(6))
60 A$=INKEY$
65 OUT255,1:OUT255,2:OUT255,3
70 IF A$="" THEN 100
80 IF VAL(A$) <>0THENS=960+L(VAL(A$)):PRINT@960,STRING$(62," ");:PRINT@S,">=<";
90 IF A$="L"THEN GOSUB1000ELSE IF A$="S"THEN GOSUB2000
100 '
200 GOTO 60
1000 FOR LP=STO64 STEP-64:PRINT@LP,"()";:OUT255,1:OUT255,2:OUT255,1:OUT255,2:NEXTLP
1010 IF B=S-960 THEN FOR X=1TO500:OUT255,1:OUT255,2:PRINT"TOMMY ";:NEXTXELSE PRINT@B,CHR$(191);:FORX=1TO500:PRINTCHR$(23);:OUT255,1:OUT255,2:OUT255,3:NEXT:CLS
1020 END
2000 IF B=S-960THEN FORX=1TO100:OUT255,1:OUT255,2:PRINT@B,"@";:NEXTX:PRINT@B,"*";ELSE FORX=1TO25:OUT255,1:OUT255,2:OUT255,1:OUT255,2:OUT255,1:OUT255,2:NEXT
2010 RETURN
