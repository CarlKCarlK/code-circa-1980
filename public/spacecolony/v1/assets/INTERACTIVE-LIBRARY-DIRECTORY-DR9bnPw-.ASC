20 L=0
30 DIM E(10):'MAX # OF SHELFS THAT A (SUB)SECTION CAN BE ON
90 CLS:RESTORE:R=0
95 CLS:PRINT"PRESS THE LETTER OF THE AREA YOU WISH TO INVESTIGATE":PRINT
100 READ A$:IF A$="U"  THEN R=R+1ELSEIFA$="D"THEN R=R-1
110 IF R>L THEN200
120 IF L=R AND A$<>"U" AND A$<>"D"THEN LZ=LZ+1:PRINTCHR$(LZ+64)" ) ";:IF RIGHT$(A$,1)=")"THENGOSUB260:PRINT A$ELSEPRINTA$
130 GOTO 100
200 PRINT:PRINT"YOUR CHOICE ? ";
202 C$=INKEY$:IFC$=""THEN202
203 IFC$<"A"OR ASC(C$)>LZ+64 THEN 202ELSEPRINTC$;
205 C=ASC(C$)-64
210 R=0:RESTORE:CN=0:IF PN<>0 THEN FORH=1TOPNELSE220
212 READ A$:IFA$="U"THEN R=R+1:GOTO212ELSEIFA$="D"THEN R=R-1:GOTO212 ELSE NEXT
220 READ A$:IF A$="U" THEN R=R+1 ELSEIF A$="D"THEN R=R-1ELSEPN=PN+1
230 IF L=R AND A$<>"U"AND A$<>"D"THEN CN=CN+1ELSE220
240 IF CN<>C OR L<> RTHEN 220
250 IF RIGHT$(A$,1)<>")" THEN L=L-1:CLS:LZ=0:GOTO95
255 GOSUB260:GOTO 270
260 FORX=1TOLEN(A$):IFMID$(A$,X,1)<>"("THEN NEXTELSE L$=RIGHT$(A$,LEN(A$)-X+1):A$=LEFT$(A$,X-1)
265 RETURN
270 FORX=1TOLEN(L$):IF MID$(L$,X,1)="("THEN E=E+1:E(E)=X
280 NEXT:E(E+1)=LEN(L$)+1
285 CLS:PRINT@640,"YOUR BOOKS HAVE BEEN LOCATED ";
286 FORX=0TO120STEP30:FORY=0TO27:SET(X,Y):NEXTY,X:FORY=0TO27STEP3:FORX=0TO60:SET(X,Y):NEXTX,Y:FORX=90TO120:FORY=0TO21STEP3:SET(X,Y):NEXTY,X:FORX=0TO29:SET(X+60,0):SET(X+60,3):SET(X+60,27):SET(X+60,24):SET(X+90,27):SET(X+90,0):NEXTX
287 FORY=24TO27:SET(75,Y):NEXT
290 FORX=1TOE
300 LT$=MID$(L$,E(X),E(X+1)-E(X))
310 CS=VAL(MID$(LT$,2,1)):RW=VAL(MID$(LT$,4,1)):IFLEN(LT$)>6 THEN LC$=MID$(LT$,6,1)ELSE LC$=" "
330 XS=(CS-1)*15:YS=9-RW:IF CS=3 AND YS=7 THEN YS=0ELSEIFCS=4 THEN YS=YS-1
335 IF LC$=" "THEN B$=STRING$(15,CHR$(191))ELSEIFLC$="L"THENLC$="LEFT SIDE":B$=STRING$(8,CHR$(191))+STRING$(7,CHR$(131))ELSEIFLC$="R"THEN LC$="RIGHT SIDE":B$=CHR$(151)+STRING$(7,CHR$(131))+STRING$(7,CHR$(191))
340 PRINT@XS+YS*64,B$;:IFCS=4 AND RW=1 AND LEFT$(LC$,1)="L"THEN PRINT@45+512,STRING$(8,CHR$(191));ELSEIF CS=4 AND RW=1 AND LEFT$(LC$,1)="R"THEN PRINT@45+8+512,STRING$(7,CHR$(191));
350 PRINT@640+X*64,"SECTION"CS" (FROM LEFT), SHELF"RW"(FROM FLOOR)";:IF LC$=" "THENPRINT"."ELSEPRINT", "LC$"."
360 NEXT
370 PRINT:PRINT"PRESS 'C ' TO CONTINE WITH A NEW SEARCH, 'E ' TO END.";
380 A$=INKEY$:IFA$="C"THENRUNELSEIFA$="E"THENCLS:ENDELSE380
1000 DATA"FICTION",D,SOFTBOUND,D,A-CLEVELAND(1.8),COCTEAU-HAILEY(1.7),HAMILTON-KYLE(1.6),LAGERKVIST-RUBIN(1.5),RUSSIAN-WEST(1.4)
1010 DATA"U",HARDBOUND,D,ADAMS-MICHENER(1.3),MORGEN-YERBY(1.2)
1020 DATA"U","U",NON-FICTION,D,SCIENCE,D,PHYSICAL,D,PHYSICS(4.1.R),CHEMISTRY(4.1.L),U,NATURAL(4.2),GENERAL(4.1.L),MATHMATICS(4.3.R)
1033 DATACOMPUTER(4.4)(4.5),SOCIAL,D,HISTORY(3.2.L),ECONOMICS(3.2.R),POLICAL(4.8)(4.7)(4.6)
1040 DATAU,U,BIOGRAPHY(2.9.R),ARTS,D,THEATRE,D,SINGLE PLAYS(2.4.L)(2.5.R),EUGENE O'NEILL(2.4.R),COLLECTIONS(2.3.L)(2.5.R),SPEECH(2.3.R),U,CRAFTS(2.1),POETRY(2.6),U,GENERAL,D,REFERENCE(2.7)(2.1.R),RECREATION,D,GOLF(1.1.R)(2.5.R),GAMES(2.7.L),FISHING(1.1)
1050 DATAU,FORIEGN LANGUAGE(2.9.L),HEALTH(2.8),OCCULT(2.6.R),ANCEINT CIVILATIONS(2.3.R)(2.5.L),HOME REPAIR(1.1.L),NATIONAL GEOGRAPHIC BOOKS(2.1.L)(2.2.L),COMPLETE WORKS OF A. LINCOLN(2.2),OVERSIZE BOOKS(2.1)(3.1.L),PHOTOS(3.1.R)
1060 DATA"ANTIQUE BOOKS(1.9)",U,U,U,U
1100 DATA"DONE"
9999 GOTO 9999
20010 K=PEEK(P)
20020 IF K=32 THEN A$="A"
20030 IF K-128=3 THEN A$="D"
20040 IF K-128=1 THEN A$="G"
20050 IF K-128+65 =86 THEN A$="F"
20060 IF K-128+65= 88 THEN A$="S"
20070 IF  K=OK THEN HH=HH+1ELSE IF HH=0 THENLPRINTA$"J ";:OK=KELSEHH=0:LPRINTA$"K  ";:OK=K
20080 NEXT
