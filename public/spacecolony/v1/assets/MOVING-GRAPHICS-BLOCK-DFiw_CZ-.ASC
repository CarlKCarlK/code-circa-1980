10 CLS
20 FORX=1TO100:SET(RND(127),RND(47)):NEXT
25 X=0
30 DIMA%(512)
40 GET@(0,0)-(63,15),A%
50 A$=INKEY$:IFA$="1"THENYY=-1:XX=0ELSEIFA$="2"THENYY=1:XX=0:ELSEIFA$="3"THENXX=-1:YY=0ELSEIFA$="4"THENXX=1:YY=0ELSEIFA$="5"THENXX=0:YY=0ELSEIFA$="6"THENRUN10   
60 X=X+XX:Y=Y+YY
70 PUT@(X,Y)-(X+62,Y+15),A%
75 PRINT@0,X,Y;
80 GOTO50   
