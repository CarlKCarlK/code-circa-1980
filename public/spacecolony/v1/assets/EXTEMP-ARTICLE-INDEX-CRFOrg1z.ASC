10160 IFC$(I)<=C$(J)THEN10200
10165 S1=S1+1:PRINT@0,S1;
10170 T$=C$(I):C$(I)=C$(J)
10175 R$=T$:C$(J)=R$+""+""+""
10180 S=SGN(-S)
10200 IFS=1THENI=I+1ELSEJ=J-1
10240 IFI<JTHEN10150
10260 IFI+1>=J1THEN10300
