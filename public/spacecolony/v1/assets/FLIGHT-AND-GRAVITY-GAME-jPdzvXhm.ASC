90 CLS:FORX=0TO127:SET(X,47):NEXT:SET(9,46):SET(9,45):FORX=9TO15:SET(X,44):NEXT:X=6:Y=46:FORQ=0TO47:SET(0,Q):SET(127,Q):NEXT:B=46
100 A$=INKEY$
120 IFA$="L"THENS=S+.2
130 IFA$="K"THENS=S-.2
140 IFA$="P"THENA=A+.2
150 IFA$=";"THENA=A-.2
180 X=X+COS(A)*S:Y=Y+SIN(A)*S
185 Y=Y+.25:IF Y>B AND X<25 THENY=B
190 X=X*2:RESET(OX,OY):RESET(OX+1,OY):IF POINT(X,Y)THEN500 ELSESET(X,Y):SET(X+1,Y):OX=X:OY=Y:X=X/2:GOTO100
500 PRINT@400,CHR$(23);"BANG":X=6:Y=46:S=0
510 B$=INKEY$:IFB$=""THEN510ELSE90
