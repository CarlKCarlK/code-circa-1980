10 CLS:DEFINTA-Z
15 G$=CHR$(34)
20 PRINT"


AIR TRAFFIC CONTROLER SIMULATION"
30 PRINT"

IN THIS GAME YOU WILL SIMULATE THE JOB OF AN AIR TRAFFIC
CONTROLLER.  YOUR FOUR DIRECTIONARIES ARE THE ARROW BUTTONS;
AS LONG AS YOU HOLD THEM DOWN THEY WILL TRANSMIT THE
INSTRUCTIONS. THE SHIFT WILL OVERRIDE THE STANDARD CIRCULAR
HOLDING PATTERN.
40 GOSUB1000
50 PRINT"


THE DISPLAY SCREEN WILL USE THE FOLLOWING ABBREVATIONS:

AIRP.           -- AIRPORT
CONT.           -- CONTROL TOWER
TAXI.           -- THE TAXING AREA
.		               -- OTHER TRAFFIC
O               -- THE ONE YOU ARE CONTROLING"
60 PRINTG$;"               -- GRASS"
65 SL=5:PRINT"
";:INPUT"SKILL LEVEL  1(VERY EASY) - 100(VERY HARD)";HD
70 CLS
80 FOR Y=0TO47:SET(30,Y):SET(31,Y):NEXTY:FORY=2TO45STEP10:FORY1=YTOY+4:SET(11,Y1):NEXTY1,Y
90 FOR Y=3TO41:SET(70,Y):SET(71,Y):SET(102,Y):SET(103,Y):NEXTY:FORY=3TO11:SET(125,Y):SET(126,Y):NEXTY:FORX=72TO124:SET(X,3):IFX<102 THEN SET(X,41)ELSESET(X,11)
100 NEXTX:PRINT@10+128,"TAXI";:PRINT@10+384,"TAXI";:PRINT@10+640,"TAXI";:PRINT@10+832,"TAXI";
110 PRINT@40+448,"AIRP";:PRINT@128+54,"CONT";
120 PRINT@896+35,STRING$(23,G$);:PRINT@960+35,STRING$(23,G$);:PRINT@35,STRING$(23,G$);
130 DIM P(SL):FORI=0TOSL:P(I)=(RND(16)-1)*64+RND(6)*2+18:PRINT@P(I),".";:NEXTI:PRINT@P(0),"O";:SP=SP+1
140 GOTO 180
150 R=RND(SL)
160 MM=1:PP=P(R):OP=PP:XX=PP-INT(PP/64)*64:IFXX<27THENIFPP<255THENIFXX<20THENPP=PP+64ELSEPP=PP-2ELSEIFPP>768THENPP=PP+2ELSEPP=PP+64 ELSE IFPP<255THENPP=PP-2ELSEIFPP>768THENIFXX<30THENPP=PP+2ELSEPP=PP-64ELSEPP=PP-64
170 PE= PEEK(15360+PP):IFPE=46ORPE=79 THEN PP=OP:IFR=0THENGOSUB300ELSEIFPE=ASC("O")THENGOSUB310ELSEELSE PRINT@OP," ";:IFR<>0THENPRINT@PP,".";ELSEPRINT@PP,"O";:IFMM=1THENSP=SP+1:GOSUB950
175 P(R)=PP
180 M=M-1:IFM=0THENPRINT@500,"         ";:GOTO180ELSEIF RND(0)<HD/100 THEN 150ELSEIFPEEK(14400)=0THENFORII=1TO1:NEXTII:GOTO180ELSEIFPEEK(14464)=0THENR=0:GOTO160ELSEGOSUB500:GOTO180
300 REM WALKING TOO FAST
301 PRINT@500,"SLOW DOWN";:SP=SP-RND(0)[2*25:M=25:IFSP<0THENSP=0
302 GOTO960
310 REM WALKING TOO SLOW
320 PRINT@500,"COME ON! ";:SP=SP-RND(0)[2*25:M=25:IFSP<0THENSP=0
330 GOTO960
500 PE=PEEK(14400):OP=P(0):PP=OP:IFPE=8THENPP=PP-64ELSEIFPE=16THENPP=PP+64ELSEIFPE=32THENPP=PP-2ELSEIFPE=64THENPP=PP+2
510 X=PP-INT(PP/64)*64:IFX<14 THEN 800 ELSE IF X>50 ANDPP<191THEN600ELSEIF X>35 AND X<50 AND PP>64 ANDPP<895 THEN 700 ELSE IF PP<0 OR PP>1023 THEN 900 ELSE R=0:MM=2:GOTO170
600 PRINT@500,"SCAB!!!!!";:FORI=1TO2000:NEXTI:RUN
700 M3=M3+1:IFM3>=10THEN PRINT@500,"YOU HAVE ";:PRINT@560,"BEEN ARRESTED";:PRINT@620,"FOR TRESPASSING";:FORI=1TO2000:NEXTI:RUN ELSE R=0:MM=2:GOTO170
730 RETURN
800 PRINT@500,"BAM !!!!!!";:PRINT@560,"YOU HAVE BEEN";:PRINT@620,"HIT BY A TAXI";:FORI=1TO2000:NEXTI:RUN
830 RETURN
900 IF SP<100 THEN PRINT@500,"MARCH.   ";:GOTO180 ELSE PRINT@500,"SEE YA";:PRINT@560,"TOMORROW";:FORI=1TO2000:NEXTI:RUN
910 RETURN
950 REM TIME
960 PRINT@630,SP;:RETURN
999 GOTO 999
1000 PRINT@960+20,"PRESS ANY BUTTON";:A$=INKEY$+INKEY$:A$=""
1010 IFINKEY$=""THEN1010ELSECLS:RETURN
