5 CLEAR1000
10 B1$=STRING$(64,CHR$(176))
20 B$=CHR$(191)
900 CLS
950 PRINT@128,B1$
990 S=.1
1000 FORX!=1TO13:IFX*S1+32>63THEN1100ELSEL3=64*X+S1*X+160.5:L4=64*X-S1*X+159.5:PRINT@L4," ";:PRINT@L3," ";
1100 IFX*S+32>63THEN1200ELSEL=64*X+S*X+160.5:L2=64*X-S*X+159.5:PRINT@L,B$;:PRINT@L2,B$;
1200 NEXT:S1=S:S=S*:GOTO1000
