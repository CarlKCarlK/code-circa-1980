1 CLS
5 I=7:O=4:P=1962:J=1:K=7:L=1979
10 INPUT"WHAT IS BIRTH DAY (M,DD,YYYY)";I,O,P
20 INPUT"WHEN SHOULD I START CHART";J,K,L
30 PI=3.14159
40 CLS
70 M=I:D=O:Y=P
100  GOSUB230
110 N=A
120 M=J:D=K:Y=L
150 GOSUB230
160 N=A-N
170 PRINT"DIFFERENCE=";N;" DAYS":PRINT
190 GOTO600
230 ONMGOTO260,280,260,340,260,340,260,260,340,260,340,260
240 PRINT"UNREAL DATE":RETURN
260 IFD>31THEN240
270 GOTO350
280 IFY/4=INT(Y/4)THEN290
290  IFY/400=INT(Y/400)THEN320
300 IFY/100=INT(Y/100)THEN310
310 IFD>28THEN240
320 IFD>29THEN240
330 GOTO350
340 IFD>30THEN240
350 DATA0,31,59,90,120,151,181,212,243,273,304,334
360  RESTORE
370 FORV=1TOM:READA:NEXTV
380 A=A+Y*365+INT(Y/4)+D+1-INT(Y/100)+INT(Y/400)
390 IFINT(Y/4)=Y/4THEN410
400 GOTO450
410 IFY/400=INT(Y/400)THEN430
420 IFY/100=INT(Y/100)THEN440
430  IFM>2THEN450
440 A=A-1
450 RETURN
460 END
600 '
750 FORX=0TO127:SET(X,24):NEXT
760 PRINT@448,"";
770 FORX=0TO30STEP2:PRINTTAB(X*2);STR$(X+K);:NEXT
1000 PS=N/23-INT(N/23):SS=N/28-INT(N/28):CS=N/33-INT(N/33)
1005 PS=PS*23:SS=SS*28:CS=CS*33
1010 FORXX=0TO127:X=XX/4:PY=20*SIN(1/11.5*PI*(X+PS))
1020 SY=20*SIN(1/14*PI*(X+SS))
1030 CY=20*SIN(1/16.5*PI*(X+PS))
1035 YS=-24
1040 SET(XX,47-PY+YS):SET(XX,47-SY+YS):SET(XX,47-CY+YS)
1050 IFABS(PY+2.5)=<3THENPRINT@INT(XX/2)+510," P ";
1060 IFABS(SY+2)=<3THENPRINT@INT(XX/2)+510," S ";
1070 IFABS(CY+2)=<3THENPRINT@INT(XX/2)+510," I ";
1100 NEXT
1110 A$=INKEY$:IFA$=""THEN1110ELSE1
