30 CLS
40 LINE(6,0)-(18,2),SET,BF
50 RESET(6,2):RESET(7,2):RESET(14,0):RESET(17,0):RESET(18,0):RESET(18,2):LINE(10,2)-(15,2),RESET
55 DIM T%(30),A%(30),B%(30),C%(30),D%(30),E%(30)
60 GET@(0,0)-(18,2),G,T%
100 CLS
105 INPUT"SET TIME :";TM
107 CLS
110 LINE(0,15)-(35,25),SET,BF
120 LINE(127,15)-(82,25),SET,BF
130 LINE(35,15)-(82,15),SET:'CROSS
140 LINE(51,15)-(52,25),SET,B:'LEFT SUPPORT
150 LINE(67,15)-(68,25),SET,B:'RIGHT SUPPORT
200 A$=INKEY$:IFA$="B"THEN 500
205 TM=TM-1:IFTM<1 THEN500
207 PRINT@900,TM;
210 X=X+1:IFX>108 THEN X=0:LINE(0,12)-(127,14),RESET,BF
220 PUT@(X,12)-(X+18,14),SET,T%
230 GOTO 200
500 GET@(49,12)-(53,14),G,A%:GET@(49,15)-(53,17),G,B%
510 GET@(54,12)-(71,13),G,C%:GET@(54,14)-(68,17),G,D%
520 GET@(69,14)-(71,17),G,E%
540 Y=0
550 FORX=0TO-2STEP-.1
555 RX=X
560 IF X<-1 THEN RX=-2-X
570 AX=RX*7:BX=RX*10:DX=RX*14:CX=RX*8:EX=RX*8
580 Y=Y+.1
590 AY=-Y*14:BY=-Y*10:DY=Y*3:CY=Y*20:EY=Y*15
600 LINE(0,0)-(63,4)," ",BF
610 PUT@(49+AY,12+AX)-(53+AY,14+AX),SET,A%:GOTO 620:PUT@(49+BY,15+BX)-(53+BY,17+BX),SET,B%
620 PUT@(54+CY     ,12+CX     )-(71 +CY   ,13 +CX    ),SET,C%:PUT@(54 +DY    ,14 +DX   )-(68 +DY   ,17 +DX   ),SET,D%
630 PUT@(69+EY    ,14 +EX   )-(71  +EY ,17  +EX  ),SET,E%
640 NEXTX
700 X=0:FORT=1TO1000:NEXT:GOTO100
