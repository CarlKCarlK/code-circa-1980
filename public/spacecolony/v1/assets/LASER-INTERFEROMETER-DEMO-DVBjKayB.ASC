1 CLEAR2000
5 SS=2:MN=1
10 L$=CHR$(191)+CHR$(191)+CHR$(191)+CHR$(191)+CHR$(140)
15 CLS
20 M$=CHR$(140)
25 S$=CHR$(176)+CHR$(140)+CHR$(131)
30 F$=STRING$(5,CHR$(176))
40 PRINT@64,L$;TAB(12)S$TAB(37)CHR$(140);
45 FORX=0TO66:SET(X,14):NEXT:FORY=14TO47:SET(66,Y):NEXT
50 PRINT@32,"ROTATING MIRROR";:PRINT@128,"LASER";TAB(15)"SPLITER"
60 PRINT@11+192,F$;"   GRATING";:PRINT@35+384,F$;"   LENS";:PRINT@35+896,F$;"   MIRROR";
90 X=10:Y=4:A=0:RA=2*3.14159:RESTORE
100 X=X+COS(A)*2*SS:Y=Y+SIN(A)*SS
105 MN=-MN:IFMN<0THENPRINT@37+64,"<";ELSEPRINT@37+64,">";
110 IF NOT POINT(X,Y)THENOG=X:OH=Y
115 IFX=30ANDABS(A)<.01THENGOSUB500
120 IFX=>73ANDABS(A)<.01THENA=.25*RA:GOSUB500
125 IFABS(Y-20)<.01ANDABS(A-.25*RA)<.01THENGOSUB500
130 IFY=>44ANDABS(A-.25*RA)<.01THENA=.75*RA:GOSUB500
140 IFY<=4ANDABS(A-.75*RA)<.01THENA=.5*RA:GOSUB500
150 IFX<=27ANDABS(A-.5*RA)<.01THENA=.25*RA:GOSUB500
160 IFX<35ANDY>=12ANDABS(A-.25*RA)<.01THENRESET(25,10):GOSUB500:FORX=1TO1000:NEXT:GOSUB500:FORX=1TO500:NEXT:GOTO90
170 RESET(OX,OY):SET(X,Y):OX=OG:OY=OH
180 GOTO100
195 PRINT@640,X;
500 PRINT@512,STRING$(31," ");:PRINT@576,STRING$(31," ");:READS$
520 IFLEN(S$)>31THENL=31:L2=LEN(S$)-31ELSEL=LEN(S$)
530 PRINT@512,TAB(16-L/2)LEFT$(S$,31);:IFLEN(S$)<32THENRETURNELSEPRINT@576,TAB(16-L2/2)RIGHT$(S$,LEN(S$)-31);:RETURN
600 DATA"BEAM IS SPLIT. HALF GOES       FORWARD","BEAM HITS MOVING MIRROR BOUNCESAT 45 DEG.","LENS FOCASES BEAM","MIRROR SENTS IT BACK AS IT CAME","MIRROR HAS CHANGED ANGLE","HALF OF BEAM REFLECTS OFF      SPLITER"
610 DATA"HITS GRATING CHART. COMPARED TOSTILL MIRROR."
620 DATA"LET'S GO AGAIN!"
999 GOTO999
1000 T=0:INPUT"CODE";C$:FORR=1TO6:IFMID$(C$,R,1)="1"THENT=T+2[(R-1)
1010 NEXT:T=T+128:PRINTT;CHR$(T):PRINT:PRINT:GOTO1000
