1 REM
10 CLS
20 DIM A%(1000)
100 FORX=1TO100:PRINT@RND(1000),"*";:NEXT
200 A$=INKEY$:IFA$="1"THENYF=1ELSEIFA$="2"THENYF=0ELSEIFA$="3"THENYF=-1ELSEIFA$="8"THENXF=-1ELSEIFA$="9"THENXF=0ELSEIFA$="0"THENXF=1
210 IFXF=1:GET@(1,0)-(63,15),A%:PUT@(0,0)-(62,15),A%:LINE@(63,0)-(63,15)," ":FORC=1TORND(3):R=RND(16)-1:LINE@(63,R)-(63,R),"*":NEXTC
220 IF XF=-1:GET@(0,0)-(62,15),A%:PUT@(1,0)-(63,15),A%:LINE@(0,0)-(0,15)," ":FORC=1TORND(3):R=RND(16)-1:LINE@(0,R)-(0,R),"*":NEXTC
230 IF YF=1THENGET@(0,0)-(63,14),A%:PUT@(0,1)-(63,15),A%:LINE@(0,0)-(63,0)," ":FORC=1TORND(9):R=RND(64)-1:LINE@(R,0)-(R,0),"*":NEXTC
240 IF YF=-1THENGET@(0,1)-(63,15),A%:PUT@(0,0)-(63,14),A%:LINE@(0,15)-(63,15)," ":FORC=1TORND(9):R=RND(64)-1:LINE@(R,15)-(R,15),"*":NEXTC
250 IF PEEK (480+15360)=ASC("*") THEN E=1
270 IF PEEK(480+15360)=ASC("$") THEN 2000
300 PRINT@ 480+64*YF-XF," ";:PRINT@480,"#";
310 IFE=1THEN FORC=1TO100:PRINT@480,CHR$(RND(60)+32);:NEXTC:E=0:CH=CH+1
500 IFRND(37)=37 THEN PRINT@RND(1000),"$";
980 TM=TM+1
990 IF XF<>0ORYF<>0 THEN T=T+1
1000 GOTO200
2000 PRINT@64,"VERY GOOD, YOU HAVE FOULD A HABITABLE PLANET."
2100 PRINT"YOU HAD"CH"CHASHES, TRAVELED"T"PARSECTS ALL IN"TM"ROTS."
2105 A$=INKEY$
2110 PRINT"WHAT TO TRY AGAIN (Y/N)";
2120 A$=INKEY$:IFA$=""THEN2120 ELSEIFA$="N"THENENDELSERUN1
