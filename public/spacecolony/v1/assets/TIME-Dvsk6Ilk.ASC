10 '    TIME
20 PI=3.14159
30 CLS
40 INPUT"WHAT IS THE NEXT MAJOR TIME (HH:MM:SS)";HZ,MZ,SZ
50 H=HZ/6*PI-PI/2:M=MZ/30*PI-PI/2:S=SZ/30*PI-PI/2
60 G=64:HH=24
70 SE=3.14159/60
80 Q=.0345
90 PRINT"PRESS ANY BUTTON TO START CLOCK"
100 IFINKEY$="" THEN100  
110 CLS
120 XS=COS(S)*40:YS=SIN(S)*20:XM=COS(M)*30:YM=SIN(M)*15:XH=COS(H)*20:YH=SIN(H)*10
130 S=S+Q:M=M+Q/60:H=H+Q/3600
140 CLS:LINE(G,HH)-(XS+G,YS+HH),SET:LINE(G,HH)-(XM+G,YM+HH),SET:LINE(G,HH)-(XH+G,YH+HH),SET:RESET(G,HH)
150 GOTO120  
