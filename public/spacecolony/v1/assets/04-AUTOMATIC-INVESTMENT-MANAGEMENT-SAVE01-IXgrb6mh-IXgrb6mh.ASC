10 REM            AUTOMATIC INVESTMENT MANAGEMENT
20 REM            BOOK: ROBERT LICHELLO
30 REM            PROGRAM: CARL KADIE
40 REM            COPYRIGHT (C) 1977
50 '
60 REM            CLEAR MEMORY FOR WORDS
70         CLEAR 200
80 '
90 REM            SET UP CONTITIONS
100 '
110 REM            INTITAL INVESTMENT (II)   
120        II= 10000
150 REM            TOTAL SHARES (TS)
160 REM            INTEREST FROM BANK
170        IR=.0525
180 REM            TOTAL INVESTMENT (TI)
190 REM            PRICE PER SHARE (PS)
200 REM            COST  PER SHARE (CS)
210 REM            TABLE OF RECORDS T(M,C) M=MONTH C=COLUMN
220        DIM T(60,8)
230 REM            TABLE HEADING  (TT$) & (TB$) TOP AND BOTTOM
240        TB$="DATE  VALUE  SAFE     CASH  CONTROL   ADVICE"+              "   ORDER    VALUE"
245                IF T(M,2)=-999 THEN 400
250        TT$="      STOCK               PORTFOLIO BUY/-SELL"+            "  MARKET PORTFOLIO"
260 '
270 '
280 '
290 REM            MAIN PROGRAM
300 '
310        T(1,3)=T(M,4)*T(M,2)
320 REM            PUT DATA IN TABLE ARRAY
330        FOR M= 1 TO 60                       'LOOP MONTHS
340               READ T(M,2)
350               IF T(M,2) <0 AND T(M,2)<>-999 THEN T(M,4)=                      -T(M,2):GOTO340
355             IF T(M,2)=-999 THEN 400
360               T(M,1)=INT(M/12)+(M/12-INT(M/12))*12/100
370        NEXT M
380 '
390 REM            SET UP FIRST MONTHS TABLE
400        T(1,3)=II/20
410        T(1,4)=II/2
430        T(1,5)= II/2
440        T(1,6)= 0
450        T(1,7)= 0
460        T(1,8)= II
470 '
480 REM            DO REST OF MONTHS
490        NM = M  -1           :' NUMBER OF MONTHS =OLD MONTH
500        FOR M= 2 TO NM
560             T(M,3)=INT(T(M,2)/10+.5)
570             T(M,4)=T(M,4)+ T(M-1,4)*(1+IR/365.25)[12
575             T(M,4)=T(M,4)-T(M-1,7)
600             T(M,6) = T(M-1,5)-T(M,2)
602             T(M,7) = 0
605             IF ABS(T(M,6)) >= 100 + T(M,3)  THEN T(M,7) =                   T(M,6)-T(M,3)*SGN(T(M,6))
610             T(M,5) = T(M-1,5)
620             IF T(M,7) > 0 THEN T(M,5)=T(M,5)+T(M,7)/2
630             T(M,8) = T(M,2)+T(M,4)
635        NEXT M
636        '
640 REM            PRINT RESULTS
650        PRINT TT$
660        PRINT TB$
670        FORM=1TO NM
680        PRINTT(M,1);TAB(5) T(M,2) TAB(13) T(M,3);
690       PRINT TAB(21) T(M,4) TAB(30) T(M,5) TAB(38) T(M,6);
700       PRINT TAB(48) INT(T(M,7)+.5) TAB(54) T(M,8)
710       IF INT(M/12)=M/12 AND M<>NM THEN PRINTTT$:PRINTTB$
720       NEXT
730       PRINT
740       PRINT"PROFIT =";
750       PRINTT(NM,8)-II
760       END
1000 '
1010 '
1020 REM            PRICES
1030 REM            EACH MOUTH PLACE THE PRICE IN DATA
1040 REM            LIKE THIS : "1030 DATA 54"
1050 REM            BE SURE THAT THE DATES ARE IN ORDER
1060 DATA 5000,4000,2875,4008,7460,11936,10680,6736,4210,5544,10195,16312
1070 DATA 14550,9176,5735,7552,13890,22224,19830,12504,7815,10288,18925,30280
1080 'DATA 58,55,57,58,58,54,51,53,52,54,52,52
1090 'DATA 49,50,50,45,42,40,42,44,46,45,47,50
1100 'DATA 53,53,55,57,55,55,53,55,54,52,52,56
9998 '
9999 '
10000 REM            THIS TELLS COMPUTER THERE'S NO MORE DATA
10010       DATA -999
20000 CLS
20010 PRINT"DO YOU WANT 1) COST/SHARE & PRICE/SHARE"
20012 PRINT"            2) DIFFERENCE BETWEEN COST/ AND PRICE/"
20014 PRINT"            3) PROFIT"
20020 INPUTC
20050 CLS:FOR M= 1 TO 60
20060 Y1=T(M,2):Y2=T(M,7)
20070 IF C=2 THENY2=52:Y1=Y1-Y2+52
20075 IF C=3 THEN G1=24:G2=(Y2-Y1)*T(M,5)/2000*22+24:G3=2*M:GOTO20090
20080 G1=47-2*Y1+80:G2=47-2*Y2+80:G3=2*M
20090 IF G3=2 THEN 20110
20100 LINE(G6,G4)-(G3,G1),SET:LINE(G6,G5)-(G3,G2),SET
20110 G6=G3:G4=G1:G5=G2
20120 A=A+Y1-Y2
20130 NEXT M:PRINT@0,"AREA";A;
20140 GOTO 20140
