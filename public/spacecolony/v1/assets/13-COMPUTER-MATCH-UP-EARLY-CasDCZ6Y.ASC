10 REMARK    TITLE: COMPUTER MATCH-UP
20 REMARK    PROGRAMED: CARL KADIE  SENATOR, WOODRUFF HIGH
30 REMARK               SCHOOL COMPUTER CLUB
40 REMARK    FOR: WOODRUFF HIGH SCHOOL STUDENT COUNSIL
50 REMARK    DATE: JANUARY 6TH, 1980 
60 REMARK
70 REMARK NQ IS THE NUMBER OF QUESTIONS
80 LET NQ = 10
90 REMARK SS IS THE SCALE SIZE
100 LET SS = 4
110 REMARK NM IS THE NUMBER OF MATCHES FOR EACH PERSOM
120 LET NM = 1
130 REMARK SF: AIDS COUNTER , FC: FEMALE COUNT, MC: MALE COUNT
140 SF=0:FC=0:MC=0
160 READ A$:IFA$="STOP"THEN 210
170 IF A$="F"THEN SF=1:GOTO 200
180 IF SF=1 THEN FC=FC+1
190 IF SF=0 THEN MC=MC+1
200 GOTO 160
210 DIM M%(MC,NQ),F%(FC,NQ),D$(MC+FC)
220 RESTORE:SF=0
230 FOR I=1TO MC:READ D$(I)
240 GOSUB 2000
250 NEXT I:READ F$
260 FOR I= MC+1 TO MC+FC:READ D$(I)
270 GOSUB2000
280 NEXT I 
300 FOR I=1TO MC
310 PRINTD$(I)
320 FOR C=1TO FC
330 TT=0:FOR G=1TONQ:TT=TT+SQR( M%(I,G)-F%(C,G)):NEXT G
999 PRINT"FINSHED":END
1000 DATA CARL KADIES6859324 1212121467,JOHN JORGENSENS6883546 5434532134,F,PEGGY GERKINF6851234 2333123243,TUNJA TUSOF8671235 1234123412,STOP
2000 REMARK SUBROUTINE TO CHANGE D$(I) TO M(,)OR F(,)
2010 FOR C=1TO NQ:CH=VAL(MID$(D$(I),LEN(D$(I))-C+1,1))
2020 IF I>MC THEN F%(I-MC,C)=CH
2030 IF I<=MC THEN M%(I,C)=CH
2040 NEXT C:RETURN
