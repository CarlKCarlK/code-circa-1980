10 'LANGUAGE
20 CLEAR1000
25 DEFINT W
30 DEFSTR I,L,G,P,M,A,Q
40 READ INFO
50 IF INFO <> "DONE" THEN NUMBER = NUMBER+1 : GOTO 40   
60 CLS
70 PRINT "I KNOW "; NUMBER ;"GERMAN WORDS."
80 PRINT "WHICH ONE WOULD YOU LIKE TO START WITH (1 -"; NUMBER ;")";:INPUT START
90 IF START<1 OR START>NUMBER THEN 80   
100 PRINT "AND WHICH WORD WOULD YOU LIKE TO END WITH ("; START ;"-"; NUMBER ;")";:INPUT FINAL
110 IF FINAL<START OR FINAL>NUMBER THEN 100  
120 PRINT"WOULD YOU LIKE A TIME LIMIT ON YOUR ANSWERS";:INPUT LIMIT
130 IF LIMIT = "YES" THEN  INPUT"HOW MANY SECONDS (1-8000)";TIME  ELSE IF LIMIT = "NO" THEN TIME=8000 ELSE PRINT"PLEASE ANSWER 'YES' OR 'NO'.":GOTO120  
140 IFTIME<0 OR TIME>8000 THEN 130  
150 INPUT"DO YOU WISH TO TRANSLATE GERMAN TO ENGLISH";GERMAN
160 IF GERMAN <> "NO"   AND GERMAN <>"YES"  THEN 150  
170 INPUT"DO YOU WISH FOR A CONSTANT PERCENTAGE SCORE";PERCENT
180 IF PERCENT<>"NO" AND PRECENT<>"YES"THEN170  
190 INPUT"DO YOU WISH FOR A CONSTANT LETTER GRADE"; GRADE
200 IF GRADE<>"NO"   AND GRADE<>"YES"  THEN190  
210 INPUT"DO YOU WANT THE WORD ORDER RANDOM";MIXED
220 IF MIXED<>"YES" AND  MIXED <>"NO" THEN 210
230 DIM WORDS(FINAL-START+1)
240 FOR COUNT=1TO FINAL-START+1
250 WORDS(COUNT)=START+COUNT-1
260 NEXT COUNT
270 IF MIXED="YES"THEN GOSUB 1000
280 FOR TURN=1TO COUNT
290 IF WORDS(TURN)<POSITION THEN PRESENT=POSITION:FOR POSITION =PRESENTTO WORDS(TURN)-1:READ INFO:NEXT POSITION
300 IF WORDS(TURN)>POSITON THEN RESTORE:POSITION=0:GOTO290
310 READ INFO :    POSITION=POSITION+1
320 QUESTION=LEFT$(INFO,INSTR(INFO,"*")-1):ANSWER=RIGHT$(INFO,INSTR(,"*"+1)
330 IF GERMAN="NO"THEN INFO=ANSWER:ANSWER=QUESTION:QUESTION=INFO
340 PRINT@385,QUESTION;" : ";:LINE INPUT#TIME,400;GUESS
350 GOTO 410
400 PRINT"I'M SORRY YOU RAN OUT OF TIME":GUESS=""
410 IF ANSWER=GUESS THEN PRINT "DAS IST RICHTIG!":RIGHT=RIGHT+1
420 IFANSWER<>GUESS THEN PRINT "DAS IST FALSCH.":PRINT"DAS RICHTIG ANTWORT IST :":PRINTANSWER
1000 FOR CIRCLE=1 TO COUNT/2
1010 R1=RND(COUNT):R2=RND(COUNT)
1020 HOLD=WORDS(R1):WORDS(R1)=WORDS(R2):WORDS(R2)=HOLD
1030 NEXT CIRCLE
1040 RETURN
10000 DATA"HUT*HAT","GUT*GOOD","DONE"
