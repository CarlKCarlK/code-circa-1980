10 CLS:GOTO60
15 DIMP(5)
20 PRINT:PRINT"DO YOU NEED BACKGROUND INFORMATION";
30 INPUTI$
35 CLS
40 IFI$="NO"THENCLS:PRINT"PLEASE WAIT A MOMENT":GOTO130
50 GOSUB1000
55 GOTO130
60 'SET UP AIR VENTS
70 DIMS(20,3)
80 FORJ=1TO20
90 FORK=1TO3
100 READS(J,K)
110 NEXTK
120 NEXTJ
125 GOTO5000
130 DATA2,5,8,1,3,10,2,4,12,3,5,14,1,4,6
140 DATA5,7,15,6,8,17,1,7,9,8,10,18,2,9,11
150 DATA10,12,19,3,11,13,12,14,20,4,13,15,6,14,16
160 DATA15,17,20,7,16,18,9,17,19,11,18,20,13,16,19
165 DIMN(20)
170 FORG=1TO20
180 R=RND(20):FORH=1TOG:IFR=N(H)THEN180ELSENEXT:N(G)=R:NEXT
190 'FNC=RND(4)
200 '                   LOCATE L ARRY ITEMS
210 ' 1-YOU     2 WAMPUS        3&4     PITS    5&6BATS
220 DIML(6)
230 DIMM(6)
240 FORJ=1TO6
250 L(J)=RND(20)
260 M(J)=L(J)
270 NEXTJ
280 '                   CHECK FOR CROSS-OVERS
290 FORJ=1TO6
300 FORK=JTO6
310 IFJ=KTHEN330
320 IFL(J)=L(K)THEN240
330 NEXTK
340 NEXTJ
350 '                           # OF POISON GAS BLASTS
360 A=5
365 L=L(1)
370 '                                START GAME
375 PRINT"HUNT THE ALIEN"
380 '                           HAZARD WARNING & LOCATION
385 IFRND(2)=1THENGOSUB3380
390 GOSUB2000
400 '                           MOVE OR SHOOT?
410 GOSUB2500
420 ON O GOTO 440,480,492
430                             'SHOOT
440 GOSUB3000
450 IFF=0THEN410
460 GOTO500
470 '                           MOVE
480 GOSUB4000
490 IFF=0 THEN390ELSE500
492 GOSUB6000
494 IFF=0THEN410
500 IFF>0THEN550
510 '                           LOSE
520 PRINT"YOU HAVE FAILED. THE EARTH IS DOOMED."
530 GOTO560
540 '                           WIN
550 PRINT"BOY, THAT WAS CLOSE.  BUT YOU WON!"
560 FORJ=1TO6
570 L(J)=M(J)
580 NEXTJ
590 PRINT"SAME SET-UP"
600 INPUTI$
610 IFI$<>"YES"THEN240
620 GOTO360
1000 '                  INSTRUCTIONS
1010 CLS:PRINT:PRINT:PRINT:PRINT:PRINT"IN ANSWER TO WHAT YOU THOUGHT MIGHT BE AN S.O.S YOU LANDED ON A":PRINT"PLANET. THE MESSAGE WAS REALLY A WARNING TO STAY AWAY, BUT IT ":PRINT"IS TO LATE NOW, AN ALIEN LIFE FORM HAS GOTTEN ON-BOARD, ALREADY"
1020 PRINT"THREE OUT OF SEVEN CREW MEMBERS ARE DEAD.":PRINT"  THE ALIEN IS HIDING IN THE AIR VENTS OF YOUR SHIP."
1030 PRINT"THOUGHOUT YOUR SHIP THERE ARE A TOTAL OF 20 AIR VENT
1040 PRINT"JUCTIONS. EACH JUCTION LEADS TO THREE OTHER JUCTIONS."
1050 PRINT"THE AIR VENTS FORM A DODECAHEDRON."
1060 IFINKEY$=""THENPRINT@960,"(PRESS ANY BUTTON TO CONTINUE ALL FRAMES)";:GOTO1060ELSECLS:PRINT:PRINT:PRINT:PRINT
1070 PRINT:PRINT"  HAZARDS:"
1080 PRINT"VACUM CHAMBERS - TWO JUCTIONS LEAD TWO SPACE"
1090 PRINT"  IF YOU ENTER THEM YOU WILL BE SUCKED OUT."
1100 PRINT"COMPUTER FALIURE - THE SHIP'S COMPUTER HAS ORDERS TO"
1110 PRINT"  BRING THE ALIEN BACK AT ANY PRICE. IF YOU ENTER CERTAIN"
1120 PRINT"  JUCTIONS THE COMPUTER WILL DIS-OREINT YOU BY SWITCHING"
1125 PRINT"  THE JUCTION'S NUMBERS AROUND."
1130 IFINKEY$=""THEN1130ELSECLS:PRINT:PRINT:PRINT:PRINT
1140 PRINT:PRINT"  ALEIN:"
1150 PRINT"THE ALEIN IS NOT BOTHERED BY THE HAZARDS (HE HAS SUCKER"
1160 PRINT"FEET AND DOES NOT USE THE COMPUTER TO FIND HIS WAY). USUALLY"
1170 PRINT"HE IS HIDING, BUT IS VERY RESTLESS, AND OFTEN MOVES."
1180 PRINT"IF HE IS BOTHERED THE CHANCE OF HIM MOVING IS EVEN GREATER."
1200 PRINT"IF YOU RUN INTO HIM YOU HAVE ONE CHANCE TO FLEE, AFTER THAT,"
1210 PRINT"IF HE IS WHERE YOU ARE HE EATS YOU."
1215 IFINKEY$=""THEN1215ELSECLS:PRINT
1220 PRINT:PRINT"  YOU:"
1230 PRINT"EACH TURN YOU MAY MOVE, CLOSE A JUCTION, OR SPRAY POISON GAS"
1240 PRINT"  MOVING: YOU CAN GO ONE JUCTION (THRU ONE VENT)"
1245 PRINT"  CLOSING A JUCTION: YOU CAN LEAVE THE JUCTION. BUT NIETHER YOU":PRINT"  NOR THE ALIEN CAN ENTER IT.(BE CAREFUL NOT TO TRAP YOURSELF)"
1250 PRINT"  POISON GAS: YOU HAVE ENOUGH GAS FOR 5 SPRAYS. YOU LOSE WHEN"
1260 PRINT"  YOU RUN OUT. EACH SQUIRT CAN GO FROM 1 TO 5 ROOMS. YOU AIM BY"
1270 PRINT"  TELLING THE COMPUTER THE ROOM'S NUMBERS THAT YOU WANT THE GAS"
1280 PRINT"  CARRIED TO.  IF THE GAS CAN'T GO THAT WAY (I.E. NO VENT) IT"
1290 PRINT"  MOVES AT RANDOM TO THE NEXT ROOM."
1300 PRINT"    IF THE GAS POISONS THE ALEIN, YOU WIN."
1310 PRINT"    IF THE GAS POISONS YOU, YOU LOSE."
1320 IFINKEY$=""THEN1320ELSECLS:PRINT:PRINT:PRINT:PRINT:PRINT
1340 PRINT"  WARNINGS:"
1350 PRINT"   WHEN YOU ARE ONE ROOM AWAY FROM ALEIN OR HAZARD,"
1360 PRINT"  THE COMPUTER SAYS:"
1370 PRINT"ALIEN-            'I SMELL AN ALIEN'"
1380 PRINT"VACUME CHAMBER-   'I FEEL A DRAFT'"
1390 PRINT"COMPUTER FALIURE- 'BOOBIE-TRAPPED JUCTION NEAR'"
1400 IFINKEY$=""THEN1400ELSECLS:PRINT"PLEASE WAIT A MOMENT."
1410 RETURN
2000 '              LOCATION & HAZARD WARNINGS
2010 PRINT
2020 FORJ=2TO6
2030 FORK=1TO3
2040 IFS(L(1),K)<>L(J)THEN2110
2050 ON J-1 GOTO 2060,2080,2080,2100,2100
2060 PRINT"I SMELL AN ALIEN"
2070 GOTO2110
2080 PRINT"I FEEL A DRAFT"
2090 GOTO2110
2100 PRINT"BOOBIE-TRAPPED JUCTION NEAR"
2110 NEXTK
2120 NEXTJ
2130 PRINT"YOUR ARE IN JUCTION"N(L(1))
2135 PRINT"VENTS LEAD TO";
2140 FORG=1TO3:IFS(L,G)<>-1THENPRINTN(S(L,G));:DC=1
2145 NEXT
2148 IFDC=0THENPRINT" NO WHERE.":PRINT"YOU ARE TRAPPED, WITH NO WAY OUT. TOO BAD!":F=-1ELSEDC=0
2150 PRINT
2160 PRINT
2170 RETURN
2500 '                  CHOOSE OPTION
2510 PRINT"SPRAY,CLOSE, OR MOVE";
2520 INPUTI$
2530 IFLEFT$(I$,1)<>"S"THEN2560
2540 O=1
2550 RETURN
2560 IFLEFT$(I$,1)<>"M"THEN2590
2570 O=2
2580 RETURN
2590 IFLEFT$(I$,1)<>"C"THEN2510
2600 O=3
2610 RETURN
3000 '                         GAS ROUTINE
3010 F=0
3020 '                  PATH OF GAS
3030 '
3040 PRINT"NO. OF JUCTIONS (1-5)";
3050 INPUTJ9
3060 IFJ9<1ORJ9>5THEN3040
3070 FORK=1TOJ9
3080 PRINT"JUCTION #";
3090 INPUTP(K)
3095 FORG=1TO20:IFN(G)=P(K)THENP(K)=GELSENEXT:P(K)=0
3100 NEXTK
3110 '                  RELEASE GAS
3120 A=A-1
3130 L=L(1)
3140 FORK=1TOJ9
3150 FORK1=1TO3
3160 IFS(L,K1)=P(K)THEN3295
3170 NEXT
3180 '                          NO VENT FOR GAS
3185 FORG=1TO3:IFS(L,G)=-1THENNEXT:GOTO3350
3190 L=S(L,RND(3))
3195 IFL=-1THENL=L(1):GOTO3190
3200 GOTO3300
3210 NEXTK
3220 PRINT"MISSED"
3230 '                          ALIEN MOVES
3240 GOSUB3370
3250 '                          CHECK GAS SUPPLY
3260 IFA>0THEN3280
3270 F=-1
3280 RETURN
3290 '                  IS GAS AT L(1) OR L(2)
3295 L=P(K)
3300 IFL<>L(2)THEN3340
3310 PRINT"AHA! YOU GOT THE ALIEN!"
3320 F=1
3330 RETURN
3340 IFL<>L(1)THEN3210
3350 PRINT"COUGH! COUGH! THE GAS GOT YOU!"
3360 GOTO3270
3370 '                ALIEN MOVEMENT ROUTINE
3380 K=RND(4)
3390 IFK=4THEN3440
3395 FORG=1TO3:IFS(L(2),G)=-1THENNEXT:PRINT"THE ALIEN IS TRAPPED. YOU HAVE WON!":F=1
3398 IFS(L(2),K)=-1THEN3380
3400 L(2)=S(L(2),K)
3410 IFL(2)<>LTHEN3440
3420 PRINT"THE ALIEN HAS REDUCED YOU TO AN OOZING GLOP TO SLIME."
3430 F=-1
3440 RETURN
4000 '                  MOVING
4010 F=0
4020 PRINT"WHERE TO";
4030 INPUTL
4035 FORG=1TO20:IFN(G)=LTHENL=GELSENEXT:L=0
4040 IFL<1ORL>20THEN4020
4050 FORK=1TO3
4060 '                  CHECK FOR LEGAL MOVE
4070 IFS(L(1),K)=LTHEN4130
4080 NEXTK
4090 IFL=L(1)THEN4030
4100 PRINT"NOT POSSIBLE -";
4110 GOTO4020
4120 '                  CHECK FOR HAZARDS
4130 L(1)=L
4140 '                          ALIEN
4150 IFL<>L(2)THEN4220
4160 PRINT"...AHHH!  YOU BUMPED INTO THE ALIEN'S TENICALS"
4170 '                          ALIEN MOVE
4180 F=-1
4190 IFF=0THEN4220
4200 RETURN
4210 '                  VACUME CHAMBER
4220 IFL<>L(3)ANDL<>L(4)THEN4270
4230 PRINT"YYYIIIEEEE . . . SUCKED INTO SPACE"
4240 F=-1
4250 RETURN
4260 '                  COM-FALURE
4270 IFL<>L(5)ANDL<>L(6)THEN4310
4280 PRINT"ZAP! -- YOU HAVE TRIGGERED THE COMPUTER TO SWITCH JUCTIONOS."
4290 L=RND(20)
4300 GOTO4130
4310 RETURN
4320 END
5000 '                  INTRO
5010 READX1:IFX1<0THEN5080ELSEREADY1,X2,Y2,XS,YS
5020 X1=X1+XS:Y1=Y1+YS:SET(X1,Y1):IFINKEY$<>""THEN15
5030 IF(Y1>Y2ANDX1=<X2)OR(X1>X2ANDY1=<Y2)OR(X1>X2ANDY1>Y2)THEN5010ELSE5020
5040 DATA 12,6,12,15,0,.5, 30,6,30,15,0,.5, 56,6,56,15,0,.5,    71,6,71,15,0,.5, 93,6,93,15,0,.5, 103,6,103,15,0,.5, 13,6,13,15,0,.5, 31,6,31,15,0,.5, 57,6,57,15,0,.5,  72,6,72,15,0,.5,        94,6,94,15,0,.5,  104,6,104,15,0,.5
5050 DATA 14,6,24,15,.5,.5, 94,6,103,15,.5,.5,                            15,6,25,15,.5,.5, 95,6,104,15,.5,.5
5060 DATA 12,11,18,11,.5,0, 31,15,45,15,.5,0, 51,6,64,6,.5,0, 51,15,64,15,.5,0, 72,6,84,6,.5,0, 72,15,84,15,.5,0, 72,10,80,10,.5,0
5070 DATA-4
5080 FORG=1TO1500:NEXT:FORQ=1TO25:X=RND(15)+16:Y=RND(128)-1:SET(Y,X):NEXT:FORX=1TO1500:NEXT:SS$=CHR$(140)+CHR$(140)+CHR$(157)+CHR$(157)+CHR$(157):FORP=500TO450STEP-1:PRINT@P,SS$;"            ";:NEXT
5090 PRINT@450,"       ";:FORX=1TO1500:NEXT
5100 S$="IN SPACE NO ONE CAN HEAR YOU SCREAM.":FORX=1TO100:R=RND(LEN(S$)):PRINT@704+32-LEN(S$)/2+R-1,MID$(S$,R,1);:NEXT:PRINT@704+32-LEN(S$)/2,S$
5110 FORX=1TO1500:NEXT:GOTO15
6000 '                        CLOSE JUCTION
6010 FORG=1TO20:FORH=1TO3:IFS(G,H)=LTHENS(G,H)=-1
6012 NEXT:NEXT
6015 PRINT"JUCTION #";N(L)"IS NOW CLOSED":PRINT
6030 GOSUB3380
6040 RETURN
