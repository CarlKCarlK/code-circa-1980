10 CLEAR100:CLS:PRINTSTRING$(64,"*"),,,,"WELCOME TO THE PEORIA TWO MILE RACE":PRINT:INPUT"SKILL LEVEL";HC:PRINT:PRINT"I WILL GIVE YOU A COUNT DOWN":FORX=10TO1STEP-1:FORY=1TO500:NEXT:PRINTX:NEXT:CLS:PRINTCHR$(23):PRINT@400,"GO":FORY=1TO500:NEXT
40 CLS:L=24:CL=32:C$=CHR$(179)+CHR$(190)+CHR$(182)+CHR$(145)
80 FORNL=1TO300:RANDOM:R=RND(12)-6:IFL+R>35ORL+R<0THENR=R*-1
100 L=L+R:PRINTSTRING$(L,191);:PRINTSTRING$(24," ");:PRINTSTRING$(37-L,191)
110 A$=INKEY$:IFA$=","THENC=+1ELSEIFA$="."THENC=I0ELSEIFA$="/"THENC=-1
120 CL=CL+C:PRINT@CL,C$;:IFRND(100)<HCTHENPRINT@RND(21)+L+896,C$;
125 PRINT@960,"";
130 IFPOINT(2*CL,3)=-1ORPOINT(2*CL+6,3)=-1THEN350ELSEPRINT@960,"";
140 IFNL/15=INT(NL/15)THENG=G+.1:PRINT@896,G;:PRINT@960,"";
150 NEXT:PRINT"THE RACE OVER  ":FORY=1TO600:NEXT:CLS:PRINT"CONGRATULATIONS, YOUR SPEED WAS"300/(M+1)" MILES PER HOUR":END
350 PRINT@CL,"BANG";:M=M+1:FORU=1TO500:NEXT:PRINT@960,"";:GOTO140
1000 FORX=123TO191:PRINTX;CHR$(X),:IFINT(X/4)=X/4THENPRINT
1010 NEXT
