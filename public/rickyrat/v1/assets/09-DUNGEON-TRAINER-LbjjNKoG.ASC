5 CLEAR1000
10 'DUNGEON TRAINER  - FIGHTING MAN
20 CLS
30 PRINT"WELCOME, THE IS THE FIRST DUNGEON TRAINER
40 PRINT">>>>>----------->   FIGHTING MAN   <------------<<<<<<<"
50 FORX=1TO500:NEXT
60 CLS
70 HP=RND(6)+RND(6)
80 MN=RND(6)+RND(6)
90 R=RND(4):IFR=1THEN A$="NOTHING"ELSEIFR=2THENA$="LEATHER"ELSEIFR=3THENA$="CHAIN MAIL"ELSEIFR=4 THEN A$="PLATE MAIL"
100 T=RND(2):IF T=1THEN S$="A SHEILD"ELSES$="NO SHEILD"
110 AC=(5-R)*2+T-1
130 MA=RND(8)+1
140 P=RND(2):IFP=2THENT$="FIGHTING MAN"ELSET$="NON FIGHTING MAN"
160 CLS
170 PRINT"YOU ARE A ";T$", WEARING "A$" AS ARMOR,":PRINT" AND CARRING "S$"."
180 PRINT"YOUR WEAPON IS A ";:W=RND(7):IF W=1THENW$="DAGGER"ELSEIFW=2THENW$="HAND AXE"ELSEIFW=3THENW$="SWORD"ELSEIFW=4THENW$="BATTLE AXE"ELSEIFW=5THENW$="MORNING STAR"ELSEIFW=6 THENW$="FLAIL"ELSE IF W=7 THEN W$="TWO-HANDED SWORD"
185 GOSUB4000
190 PRINTW$"."
200 PRINT"YOUR HIT POINT IS "HP
205 GOSUB4000
210 PRINT:PRINT"YOU COME ACROSS A MONSTER IN THE CAVES. HE IS NOT FRIENDLY.
220 IF RND(2)=1 THENPRINT"HE ATTACKS FIRST."ELSEPRINT"YOU ATTACK FIRST":GOTO 500
225 GOSUB4000
245 GOSUB4000
265 GOSUB4000
285 GOSUB4000
300 P$="":INPUT"DO YOU WISH IS PARRY HIS ATTACK (ENTER FOR NO, 'Y' FOR YES)";P$
310 RT=RND(20):IF P$="Y"THEN RT=RT-2
315 GOSUB4000
320 IF RT<M(MN,AC) OR RT=M(MN,AC) AND P$=""THEN PRINT"THE MONSTER MISSES!":GOTO 350
330 IF RT=M(MN,AC) AND P$="Y"THEN PRINT"THE BEAST MISSES, BUT BRAKES YOUR "W$:W$="NOTHING":GOTO350
335 GOSUB4000
340 PRINT"HE HITS YOU LEAVING YOU WITH ";:HP=HP-RND(6):IF HP<=0THEN1000 ELSEPRINTHP" HIT POINTS."
350 '
355 GOSUB4000
375 GOSUB4000
500 IFTC$="W"THEN PRINT"YOU HAVE WITHDRAW ALIVE":ENDELSEINPUT"DO YOU WISH TO (F)IGHT OR (W)ITHDRAW";TC$
505 IF T=2 AND TC$="W"THEN AC=AC-1
510 IF TC$="W"THEN700
515 IF P$="Y"THENPRINT"SORRY, HE HIT YOU AGAIN AFTER YOU PARRY.":GOTO 300
520 PRINT"YOU RAISE YOUR "W$" IN THE AIR ,"
525 GOSUB4000
530 TT=RND(20):IF TT>= P(P,MA) THEN PRINT"AND HIT HIM, YOU DID ";:DM=RND(6):PRINTDM" DAMAGE,":GOTO 600
535 GOSUB4000
540 PRINT"BUT MISS HIM."
545 GOSUB4000
550 GOTO 300
555 GOSUB4000
600 MN=MN-DM:IF MN<=0 THEN PRINT" AND KILLED HIM !!!!!":ENDELSEPRINT" BUT HE LIVES ON .":GOTO  300
700 PRINT"YOU RUN, BUT HE GETS ONE LAST HIT.":PT$="":GOTO 310
1000 PRINT: PRINT" NOTHING, NOT EVEN YOU LIFE. HE HAS WON.":END
3000 DIM P(2,9):FOR X=2TO9:P(1,X)=20-X:P(2,X)=19-X:NEXTX
3010 DIM M(12,9):FOR X=1TO12:READ M(X,9):NEXT:FORX=8TO2STEP-1:FORY=1TO12:M(Y,X)=M(Y,X+1)+1:NEXTY,X
3020 DATA 10,9,8,6,5,5,4,4,2,2,0,0
3030 RETURN
4000 FORU=1TO1000:NEXT:RETURN
