GEN5	JP NZ,GEN6
	CALL PLOT2
	JP ECASE
GEN6	CP 4
	JP P,GEN7
	SCF
	CALL PLOT2
	JP ECASE
GEN7	SCF
	CCF
	CALL PLOT2
ECASE	INC H
	BIT 6,H
	JP Z,GEN1
	LD H,0
	INC L
	LD A,L
	CP 48
