BGN	NOP
SCR	EQU	15360
BLANK	EQU	128
LIFE	LD IX,DIV3
	LD B,48
LIFE1	RES 5,(IX+0)
	RES 4,(IX+0)
	INC IX
	DEC B
	JP NZ,LIFE1
	CALL INIT
MAIN	LD A,(14400)
	CP 4
	JP Z,DONE
	CALL GEN
	JP MAIN
