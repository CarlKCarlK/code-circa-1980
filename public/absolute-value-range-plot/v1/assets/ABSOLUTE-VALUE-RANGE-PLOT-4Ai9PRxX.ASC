100 INPUT"RANGE";R1
105 CLS:X=0
110 FORR=-(R1)TOR1STEP R1/63
120 IF ABS(R) < 2 THEN 200 ELSE 300
130 SET(X,0):SET(X,4):IFABS(R)<.02THENPRINT@128+X/2,0;
140 NEXT
150 PRINT@384,"";:GOTO100
200 X=X+1:SET(X,2):IFT=-1THENPRINT@128+X/2,R;
210 T=1:GOTO130
300 X=X+1:IFT=1THENPRINT@128+X/2,R;
310 T=-1:GOTO130
