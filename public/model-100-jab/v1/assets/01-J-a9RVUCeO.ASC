10 DEFINT A-Z
15 SOUND ON
20 INPUT"layout";T:FOR I=1TOT:J=RND(1):NEXT I
80 WL=10:DP=5
90  NR=20:NP=3:CC!=.5
100 DIM NX(NR-1,NP-1),RS(NR-1)
110 FOR I=0TO NR-1
115 S=I*RND(1):FORJ=0TO2:NX(I,J)=NX(S,J):NEXT J
120 T=RND(1)*3
130 FOR J=0TO2: IF J=T THEN NX(S,1)= (I+1) MOD NR :ELSE NX(S,J)=RND(1)*NR
140 NEXTJ:NEXT I
150 HP=RND(1)*NR
160 JP=RND(1)*NR:IF JP=HP THEN 160
170 HA=-1:HC=-1:JM=0
180 TM=TM+1:SOUND 10000,1:IF HA AND HC THEN GOSUB 200:IF INKEY$<>"" THEN GOSUB 1200 :ELSE 185
185 GOSUB 1000:GOTO 180
190 PRINT"Game Over":END
200 'human cycle
210 IF HS*RND(1) <= GD*RND(1) THEN 225 :ELSE F$=HD$:OPEN "myspec.do" FOR INPUT AS 1
220 IF F$="s" THEN GOSUB 230 :ELSE IF F$="m" THEN GOSUB 260 :ELSE  IF F$="c" THEN GOSUB 400 :ELSE STOP:'assert
223 HS=0:CLOSE 1
225 RETURN
230 'spray
235 INPUT #1,T:'"In how many minutes"
237 WL=WL-T
240 IF (TM+T < RS(HP)) OR RS(HP)=0 THEN RS(HP)=TM+T
250 RETURN 
260 INPUT#1,T:'"Which door"
280 HP=NX(HP,T)
285 PRINT"you are in room";HP;"."
288 T=RND(1)*3:IF T<>0 THEN WL=WL+T:PRINT"you have";WL;"minutes worth of wick"
290 RETURN
400 'check
410 INPUT #1,T:'"which passage"
440 IF RS(NX(HP,T))<>0 AND RS(NX(HP,T))<=TM  THEN PRINT"I smell gas through passage";T;"." :ELSE PRINT"No gas there"
450 IF NX(HP,T)=JP THEN PRINT"I smell a Jab through passage";T;"." :ELSE PRINT"No Jabs there"
460 RETURN
500 'human status
515 IF RS(HP)<>0 AND RS(HP)<=TM THEN PRINT "GAS!!!":HC = 0:GOTO 600
517 IF JP=HP THEN PRINT "JAB IN THE ROOM!!!":GOTO 600
520 GD=0:JD=0:FOR J=0TO NP-1
540 IF RS(NX(HP,J))<>0 AND RS(NX(HP,J))<=TM  THEN GD=-1
550 IF NX(HP,J)=JP THEN JD=-1
560 NEXT J
563 IF GD THEN  PRINT"I smell gas"
566 IF JD THEN  PRINT"I smell a Jab"
570 IF RS(HP) <> 0 THEN PRINT"There is a gas bomb here"
600 RETURN
1000 'moves
1005 IF JP=HP AND JM THEN PRINT"Got You":HA=0 :ELSE IF JP=HP THEN PRINT"Jab is Mad"
1007 JM=(JP=HP)
1009 IF JM THEN PRINT
1010 B1=-1:FOR J=0TO2:P1=0
1020 IF NX(JP,J)=HP THEN P1=P1+100
1030 IF RS(NX(JP,J))<>0 AND RS(NX(JP,J))<= TM THEN P1=P1-200
1040 IF RS(JP)<>0 THEN P1=P1+RND(1)*400-200
1050 P1=P1+RND(1)*10-5
1060 IF B1<0 OR P1>R1 THEN R1=P1:B1=J
1070 NEXT J
1080 IF RND(1) <.2 THEN JP=NX(JP,B1):PRINT"the jabs moves to room";JP
1090 RETURN
1200 'human orders
1210 OPEN "myspec.do" FOR OUTPUT AS 1
1215 INPUT"What do you wish do to? (move,spray,check,halt (m/s/c/h))";F$
1220 IF F$="s" THEN GOSUB 1230 :ELSE IF F$="m" THEN GOSUB 1260 :ELSE  IF F$="c" THEN GOSUB 1400 :ELSE IF F$="h" THEN GOSUB 1350 :ELSE PRINT"What?":GOTO 1215
1225 HD$=F$:CLOSE 1
1227 RETURN
1230 'spray
1235 INPUT"In how many minutes";T
1237 IF T<0 OR T>WL THEN PRINT"What":GOTO 1235
1240 PRINT #1,T
1245 HS=1:GD=2
1250 RETURN 
1260 INPUT"Which door";T
1270 IF T<0 OR T>=NP THEN PRINT"What":GOTO 1260
1280 PRINT #1,T
1285 HS=1:GD=5
1290 RETURN
1350 'halt
1360 HS=0
1380 RETURN
1400 'check
1410 INPUT "which passage";T
1420 IF T<0 OR T>=NP THEN PRINT"What?":GOTO 1410
1430 PRINT #1,T
1440 HS=1:GD=3
1460 RETURN
