2 GOSUB 5000
5 CLS
10 FOR X=0 TO127:SET(X,3):SET(X,47):NEXTX:FORY=3TO47:SET(0,Y):SET(127,Y):NEXTY
25 DEFINT A-Y
26 GOTO 190
30 LL=.0001
50 P=0
60 X=5:Y=10
70 M=PEEK(14400):IF MAND128THENP=0ELSEIF MAND1THENP=1ELSEIFMAND2THENP=2ELSE IF PEEK(14464) THEN 400
80 IF MAND8THENY=Y-1ELSEIFMAND16THENY=Y+1
90 IF MAND32THENX=X-1ELSEIFMAND64THENX=X+1
94 IF X=127 THEN X=0
95 X=XAND127:IFY<0THENY=0ELSEIFY>47THENY=47
96 N=PEEK(14352):IFN=30THENRUNELSEIFNAND2THEN RESET(X(0),Y(0)):X(0)=X:Y(0)=Y:GOTO 200 ELSE IF NAND4THENRESET(X(1),Y(1)):X(1)=X:Y(1)=Y:GOTO200
100 R=POINT(X,Y):FORJ=1TO3:SET(X,Y):PI=3.14:RESET(X,Y):IF R THEN SET(X,Y)
110  IF P=1THEN SET(X,Y):SET(X+1,Y) ELSE IF P=2 THEN RESET(X,Y):RESET(X+1,Y)
120 GOTO 70
190 X(0)=10:X(1)=15:Y(0)=40:Y(1)=40
200 SET(X(0),Y(0)):SET (X(1),Y(1)):VX(0)=0:VY(0)=0:VX(1)=0:VY(1)=0:AA(0)=X(0):AA(1)=X(1):BB(0)=Y(0):BB(1)=Y(1)
210 GOTO 30
400 ON ERROR GOTO 1000
410 PRINT@20,"GENTLEMEN START YOUR ENGINES";
420  FOR II=1TO500:NEXTII:PRINT@20,"            GO !              ";
430 FOR II=1TO300:NEXTII
500 M=PEEK(14352):IF M AND 2THEN VY(0)=VY(0)-1ELSEIFMAND4THENVY(0)=VY(0)+1
510 IFMAND8THENVX(0)=VX(0)-2ELSEIFMAND16THENVX(0)=VX(0)+2
520 N=PEEK(14368):IFMAND128THENVY(1)=VY(1)-1ELSEIFNAND1THENVY(1)=VY(1)+1
530 IFNAND2THENVX(1)=VX(1)-2ELSEIFMAND1THENVX(1)=VX(1)+2
532 IF N+M=318 THEN 1100ELSE T=T+1:IF T(0)=0ANDT(1)=0THEN535ELSE IF T(0)>1 THEN T(0)=T(0)-1:VX(0)=0:VY(0)=0
533 IF T(1)>0 THEN T(1)=T(1)-1:VX(1)=0:VY(1)=0
535 X0=ABS(VX(0)):X1=ABS(VX(1)):Y0=ABS(VY(0)):Y1=ABS(VY(1))
540 IF X0<Y0 THEN M=Y0 ELSE M=X0
550 IF X1<Y1 THEN N=Y1 ELSE N=X1
560 IF M<N THEN M=N
561 PRINT@0,VX(0);VY(0),,T,VX(1);VY(1);
562 IF M<6 THENM=6
565 IF M=0 THEN 500
570 AA(0)=X(0):AA(1)=X(1):BB(0)=Y(0):BB(1)=Y(1):FOR I=1TOM:Z=I/M+LL:FORP=0TO1:A(P)=X(P)+VX(P)*Z:B(P)=Y(P)+VY(P)*Z:IFA(P)=AA(P)ANDB(P)=BB(P)THENNEXTP,IELSEIFPOINT(A(P),B(P))THEN700ELSESET(A(P),B(P)):RESET(AA(P),BB(P)):AA(P)=A(P):BB(P)=B(P):NEXTP,I
580 X(0)=AA(0):Y(0)=BB(0):X(1)=AA(1):Y(1)=BB(1):GOTO500
700 FOR II=1TO20:OUT255,1:OUT255,2:OUT255,1:OUT255,0:PR=INT(A(P)/2)+INT(B(P)/3)*64:PRINT@PR,CHR$(41+RND(2));:NEXTII:PRINT@PR,CHR$(191);
705 T(P)=ABS(VX(P))+ABS(VY(P))
710 VX(P)=0:VY(P)=0
720 NEXTP,I:GOTO580
800 GOTO 1100
1000  PRINT@P*50,"WINNER";
1005 RESUME 1010
1010 FOR I=1TO 1000:NEXTI:GOTO 1100
1100 RESET(AA(0),BB(0)):RESET(AA(1),BB(1)):T=0:GOTO25
5000 CLS
5010 PRINT "         RACE"
5030 PRINT "THERE ARE TO PHASES   1) MAKING THE TRACK 2) RACING
5040 PRINT "PHASE 1 - MAKING THE TRACK"
5050 PRINT "ARROWS MOVE CURSER     ENTER -PEN DOWN"
5060 PRINT "CLEAR -PEN ERASE    SPACE-PEN UP   SHIFT-START RACE"
5070 PRINT "1- TO THE 1ST RACER TO CURSER POSITION   2-SAME FOR 2ND
5080 PRINT "1-2-3-4 (AT THE SAME TIME)  CLEAR AND START OVER"
5085 PRINT"MAKE SURE YOU CREATE SOME WAY FOR THE CARS TO LEAVE"
5086 PRINT"THE SCREEN."
5090 PRINT
5100 PRINT"PHASE 2  - RACING       1,2,3,4  OR 7,8,9,0 WILL CHANGE"
5110 PRINT"THE VELOCITY BY ONE   UP,DOWN,LEFT,RIGHT  (RESPECTIVELY)":PRINT"  THEN 1-2-3-4-7-8-9-0 ALL THE SAME TIME WILL END THE RACE
5120 PRINT"THE WINNER IS THE FIRST TO DRIVE OFF THE SCREEN"
