5 CLEAR 10000
10 DIM L$(50,1),D(6)
20 CLS
100 INPUT"ORDERS ";O$
110 IF O$<>"HELP"THEN 200
120 PRINT"YOUR OPTIONS ARE :"
130 PRINT"   HELP - INFORMATION"
140 PRINT"   DESCRIBE - YOU TELL ME ABOUT A LOCATION."
150 PRINT"   LIST - I LIST ALL THE ROOMS AND LOCATIONS"
160  PRINT"   DOOR - YOU CREATE A PASSAGE BETEEN TWO LOCATIONS"
170 PRINT"TRAVEL - TYPE N(ORTH), S(OUTH), W(EST), E(AST), U(P),OR D(OWN)"
190 GOTO 100
200 IF O$<>"DESCRIBE" THEN 300
210 CLS
215 P=P+1
220 INPUT"WHAT IS THE NAME IS OF THIS LOCATION";L$(P,0)
230 PRINT:PRINT"TELL ME ABOUT ";L$(P,0)
240 INPUT L$(P,1)
250 CLS:GOTO 100
300 IF O$<>"LIST" THEN 400ELSECLS
310 FOR YY=1TO P:PRINT L$(P,0):IF YY/14<>INT(YY/14) THEN 330
320 PRINT"(PRESS ANY BUTTON TO CONTINUE)";
325 A$=INKEY$:IFA$="" THEN 325ELSE CLS
330 NEXT YY
340 GOTO 320
