10 DIMA#(20)
20 FORX=1TO20
25 B1=-1:RANDOM
30 A#(X)=RND(20)*10000+RND(20)*100+RND(20)
40 NEXT
50 L=RND(20):G=RND(20):IFG=LTHEN50
60 T=T+1:PRINT:PRINT:PRINT"TURN #"T:PRINT"YOU ARE IN CAVE #"L"THE BEAST WAS IN CAVE #"G",BUT JUST MOVED"
70 R=A#(G):GOSUB1000:S=RND(3):IFC(S)=LORC(S)=0THEN70ELSEG=C(S)
90 R=A#(L):GOSUB1000:
100 PRINT"FROM CAVE#"L"YOU CAN MOVE TO CAVES"C(1);","C(2);",""OR";C(3)"."
110 INPUT"WHICH ONE SHALL IT BE";C:IFC=0THENB1=1+B1:B(B1)=L:C=LELSEIFC=C(1)ORC=C(2)ORC=C(3)THEN120ELSE100
120 L=C:IFC=GTHEN500ELSE60
500 PRINT"YOU DID YOU FOULD THE BEAST. AND IN ONLY"T"TURNS!.":INPUT"WOULD YOU LIKE TO TRY AGAIN WITH THE SAME MAP";A$:T=0:IFA$="NO"THENENDELSEGOTO50
1000 C(1)=INT(R/10000):R=R-C(1)*10000:C(2)=INT(R/100):R=R-C(2)*100:C(3)=R:FORA=1TO3:FORB=0TO4:IFC(A)=B(B)THENC(A)=0
1010 NEXT:NEXT:IFC(1)=0ANDC(2)=0ANDC(3)=0THENPRINT"SOMEONE IN THE CAVERNS IS TRAPPED":ENDELSERETURN
10000 END
