10 CLS:DEFINT A-Z
15 DIM XX(12),YY(12)
20 PRINT"WORM ONE"
25 PO=6
30 PRINT"SEE: SCIENTIFIC AMERICAN, NOVEMBER 1973"
40 PRINT:PRINT"PROGRAMED FOR THE TRS-80 BY "
50 PRINT"CARL KADIE  
55 FOR J=1TO6:READ XX(J),YY(J):XX(J+6)=XX(J):YY(J+6)=YY(J):NEXTJ
56 DATA -1,-1,-2,0,-1,1,1,1,2,0,1,-1
60 PRINT"27 JULY 1980
65 P$= "1B 2D 3CCC 4B"
70 PRINT:PRINT"WHICH PATTERN (LIKE 1B 2D 3CCC 4B )"
80 INPUT P$
85 X=64:Y=24:GOTO 100
90 INPUT"(X,Y) OF STARTING LOCATION  ( 0-127,0-47)";X,Y
100 CLS:PRINTP$
105 XB=X:YB=Y:OX=X:OY=Y
110 FOR I=1TOLEN(P$):M$=MID$(P$,I,1)
120 IF M$="1"THEN R$(1)=MID$(P$,I+1,1)
125 IF M$="2"THEN R$(2)=MID$(P$,I+1,1)
130 IF M$="3"THEN FOR J=1TO4:R$(J+4)=MID$(P$,I+J,1):NEXTJ
140 IF M$="4"THEN R$(4)=MID$(P$,I+1,1)
150 NEXT I
160 SET(X,Y):SET(XB,YB):IFY=YB THEN SET((X+XB)/2,Y):SET((XB+OX)/2,YB)
165 OX=X:OY=Y
170 GOSUB1000:'OPTIONS
171 IF OP=0 THEN STOP 
172 FOR PP=1TO5:IF MID$(H$,PP,1)="1"THEN X=X(PP):Y=Y(PP):XB=XB(PP):YB=YB(PP):PO=3+(PP+PO):GOTO160ELSE NEXT PP
180 ON OP+1 GOTO 190,200,210,300,400,500,600
190 PRINT@0,"D";
195 IF INKEY$=""THEN195 ELSE RUN
200 PO=1:GOSUB 700
700 X=X(PO):Y=Y(PO)
1000 'OPTIONS
1010 OP=0:H$="":IFPO>6 THEN PO=PO-6:GOTO1010
1020 FOR J=1TO5:JJ=J+PO:IFNOT(POINT(XX(JJ)+X,YY(JJ)+Y)) THEN H$=H$+"1":OP=OP+1 ELSE H$=H$+"0"
1030 X(J)=XX(JJ)*2+X:Y(J)=YY(JJ)*2+Y:XB(J)=XX(JJ)+X:YB(J)=YY(JJ)+Y:NEXTJ
1035 PRINT@0,H$;
1037 'FOR J=1TO5:SET(XB(J),YB(J)):NEXTJ:FORJ=1TO500:NEXTJ:FORJ=1TO5:RESET(XB(J),YB(J)):NEXTJ
1040 RETURN
