5 CLS:PRINT:PRINT
10 PRINT"                           WHO DONNT ?"
20 PRINT:PRINT:PRINT:PRINT:INPUT"WOULD YOU LIKE INSTRUCTION";Q$:IFQ$="NO"THEN1000
1000 FORX=1TO6:READR$(X):NEXT:FORX=1TO6:READS$(X):NEXT
1010 DATA"KITCHEN","DEN","LIVING ROOM","PARLAR","BALLROOM","DINING ROOM","PROF. EINS","MISS ZWIN","DR. DWEI","MRS. VEIR","CAPT. FOUF","MR. SECHS"
1100 R=RND(6)
1110 FORX=1TO6
1120 Y=RND(7)
1130 IFY=7THENY=R
1140 SR(X)=Y
1150 NEXT
1180 MW=RND(6)
1190 FORX=1TO6
1200 IFX<>MWTHENY=RND(6):IFY=MWTHEN1200
1210 IFX=MWTHENY=MW
1220 WR(X)=Y
1230 NEXT
1270 FORX=1TO6
1280 AR(X)=SR(X)
1290 NEXT
1330 FORX=1TO6
1350 IFSR(X)=RTHEN1450
1360 SO(X)=X
1370 FORXX=1TO6
1380 IFSR(XX)=SR(X)THENSO(X)=SO(X)*10+XX
1390 NEXT
1400 GOTO1550
1450 AR(X)=RND(6):IFAR(X)=RTHEN1450
1460 SO(X)=X
1470 CC=RND(6)
1480 FORC=1TOCC
1490 XX=RND(6)
1500 IFSR(XX)=AR(X)THENSO(X)=SO(X)*10+XX
1510 NEXT
1550 NEXT
1580 FORX=1TO6
1585 SW(X)=1
1590 IFSR(X)=RTHEN1700
1600 FORXX=1TO6
1610 IFSR(X)=WR(XX)THENSW(X)=SW(X)*10+XX
1620 NEXT
1630 GOTO1770
1700 CC=RND(6)
1710 FORC=1TOCC
1720 XX=RND(6)
1730 IFAR(X)=WR(XX)THENSW(X)=SW(X)*10+XX
1740 NEXT
1770 NEXT
2000 FORX=1TO6:PRINTS$(X)" "R$(SR(X))" "R$(AR(X)),:NEXT
