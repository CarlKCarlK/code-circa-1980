145 DIM T$(P,1)
150 CLS
160 PRINT@448,"NOW I WILL GO THOUGH ALL THE TEAMS PLEASE TELL ME THE SCHOOL    NAME AND COACHES NAME (MAKE'EM  UP IF YOU WISH!)"
165 FORX=1TO3000:NEXT
170 FOR I=1TO P
180 CLS
190 PRINT@448,"COACH #"I", WHAT IS YOUR NAME";
200 INPUT T$(I,0)
210 CLS:PRINT@448,"COACH "T$(I,0)", WHAT IS THE NAME OF YOUR SCHOOL";
220 INPUT T$(I,1)
230 NEXT I
240 CLS
250 FOR X=1 TO 3
255 EV$(X)=""
