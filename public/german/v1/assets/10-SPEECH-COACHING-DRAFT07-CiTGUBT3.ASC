290 L=RND(3)
300 FORY=1TOL
310 RESTORE
320 R=RND(9)
330 FOR K=1TOR:READ TM$:NEXTK
340 EV$(X)=EV$(X)+" "+TM$
350 NEXT Y
360 RESTORE:R=RND(3):FORY=1TO9+R:READTM$:NEXTY
370 EV$(X)=EV$(X)+" "+TM$
380 NEXT X
