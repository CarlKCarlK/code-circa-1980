1320 FOR T=1TO3:PRINTN$(X-1,T)" IN "EV$(T):NEXT T
1330 PRINT
1340 FORD=1TO5
1350 FOR T=1TO3:FORQ=1TO4:TG(X-1,T,Q)=TG(X-1,T,Q)*(1-.06*RND(0)*(1-TG(X-1,T,5))):NEXTQ,T
1360 PRINT@704,"WHICH ONE (# FROM TOP) WILL YOU PRACTICE WITH ON DAY #";D;:INPUTN
1370 IFN<0ORN>3THEN1360
