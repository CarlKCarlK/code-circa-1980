10 CLS
200 PRINT"WHAT IS YOUR WISH   (HELP FOR CHOICES)";:INPUT A$:C3=VAL( MID$(A$,2)):A$=LEFT$(A$+" ",1)
210 IF A$="H"THEN GOSUB 300:GOTO 200
220 IF A$="L" AND C3=0THEN GOSUB 400 ELSE IF A$="L"AND C3<>0THEN I=C3:A$="SHORT":GOSUB 410
230 IF A$="C" THEN GOSUB 500
240 IF A$="W" THEN GOSUB 600
250 IF A$="U" THEN GOSUB 800
260 IF A$="S" THEN GOSUB 900
270 IF A$="P" THEN GOSUB 1000
280 IF A$="G" THEN 1200
299 GOTO 200
300 PRINT"--HELP--"
310 PRINT"YOUR CHOICES ARE:  LIST, LISTN (N IS A NUMBER), CREATE,WIRE,UNWIRE,SETN,RESETN,LOOK,LOOKN,PLUG,START OVER"
320 RETURN
400 FOR I=1 TO T
410 IF I>T THEN PRINT"THERE ARE ONLY "T" DEVICE(S)":RETURN
420 PRINTI;TAB(4);T$(I):FOR J=1TO4:IF S$(I,J)<>"NULL" THEN PRINTTAB(10);J;TAB(15);LEFT$(S$(I,J),1);"  ";MID$(S$(I,J),2);:PRINTTAB(30);P(I,J,0);TAB(35);P(I,J,1)
425 NEXTJ
430 IF A$="SHORT"THEN RETURN ELSE PRINT:NEXTI:RETURN
500 T=T+1:INPUT"WHAT DO YOU WISH TO CREATE
LIGHT   SWITCH   NAND  NOR  XOR  JOINT BRANCH ";B$
510  RESTORE:FORJ=1TO7:READ T$(T),S$(T,1),S$(T,2),S$(T,3),S$(T,4):IF T$(T)<>B$THEN NEXT J:PRINT"NO SUCH DEVICE":T=T-1:RETURN
520 DATA LIGHT,IWAIT,NULL,NULL,NULL,
         SWITCH,ONO,OYES,NULL,NULL,
          NAND,IWAIT,IWAIT,IWAIT,OWAIT
530 DATA NOR,IWAIT,IWAIT,OWAIT,NULL,
          XOR,IWAIT,IWAIT,OWAIT,NULL,
          JOINT,IWAIT,IWAIT,OWAIT,NULL,
          BRANCH,IWAIT,OWAIT,OWAIT,NULL
535 PRINT"THIS "B$" IS DEVICE #"T"."
540 RETURN
600 INPUT "#DEVICEA,#CA,  #DEVICEB,#CB";D1,C1,D2,C2
610 B$="GOOD"
620 IF D1>T OR D1<1 OR D2>T OR D2<1 THEN PRINT"WIRE REJECTED! THERE ARE"T" DEVICES.":RETURN
630 IF C1>4 OR C1<1 OR C2>4 OR C2<0 THEN PRINT"WIRE REJECTED! THERE MAY NEVER BE MORE THAN 4 CONECTIONS":RETURN
635 IF LEFT$( S$(D1,C1),1)<>"O"THEN PRINT"POINT #"C1" OF A "T$(D1)" (DEVICE #"D1" ) CAN'T BE INPUT":B$="BAD"
640 IF LEFT$( S$(D2,C2),1)<>"I" THEN PRINT"POINT #"C2" OF A "T$(D2)" (DEVICE #"D2" ) CAN'T BE INPUT":B$="BAD"
650 IF P(D1,C1,0)<>0 THEN PRINT "POINT #"C1" OF A "T$(D1)" (DEVICE #"D1") HAS ALREADY BEEN CONNECTED TO A "T$(P(D1,C1,0))" (#"P(D1,C1,0)","P(D1,C1,1)")":B$="BAD"
660 IF S$(D2,C2)="IWAIT2"THEN PRINT"POINT #"C2" OF THE "T$(D2)" (DEVICE #"D2") ALREADY HAS AN INPUT.":B$="BAD"
670 IF B$="BAD"THEN RETURN
680 P(D1,C1,0)=D2:P(D1,C1,1)=C2:S$(D2,C2)="IWAIT2":P(D2,C2,00)=D1:P(D2,C2,1)=C1
690 RETURN
800 INPUT" DEVICE,POINT";D1,C1
810 IF D1<0 OR D1>T OR C1<0 OR C1>4 THEN PRINT"FAIL.  THERE ARE"T" DEVICES EACH WITH A MAXIMUM OF FOUR POINTS":RETURN
820 IF P(D1,C1,0)=0 THEN PRINT"THERE IS NO WIRE FROM THAT POINT":RETURN
822 IF LEFT$(S$(D1,C1),1)="I"THEN D2=D1:C2=C1:D1=P(D2,C2,0):C1=P(D2,C2,1)ELSE D2=P(D1,C1,0):C2=P(D1,C1,1)
824 IF D1=-1 THEN D1=0:C1=0:T$(0)="PLUG"
830 PRINT"IS THIS WHAT YOU WHAT?
UNWIRE FROM A "T$(D1)"  (DEVICE,POINT #s "D1","C1" ) TO":PRINT"A "T$(D2)"  (DEVICE,POINT #s "D2","C2" )."
840 INPUT"(Y)ES OR (N)O ";B$:IFB$<>"Y"ANDB$<>"N"THEN840ELSE IF B$="NO"THEN PRINT"NO ACTION TAKEN":RETURN
850 P(D1,C1,0)=0:P(D1,C1,1)=0:S$(D2,C2)="IWAIT":P(D2,C2,0)=0:P(D2,C2,1)=0:PRINT"UNWIRED":RETURN
900 PRINT"SETTING SWITCHS"
910 INPUT"ENTER    SWITCH#,YES/NO/FLIP";D1,B$
920 IF T$(D1)<>"SWITCH"THENPRINT"THAT DEVICE IS A "T$(D1)" NOT A SWITCH":RETURN
930 IF B$="YES" THEN S$(D1,1)="OYES":S$(D1,2)="ONO" ELSE
     IF B$="NO"THEN   S$(D1,1)="ONO":S$(D1,2)="OYES" ELSE
     IF B$="FLIP" THEN B$=MID$( S$(D1,2),2):GOTO 930
940 PRINT"THE SWITCH IS "MID$( S$(D1,1),2)".":RETURN
1000 INPUT"GIVE ME  DEVICE#,POINT# YOU WANT TO PLUG. ( 0,0 LIST ALL)";D1,C1
1010 IF D1=0 AND C1=0 THEN 1100
1020 IF D1<1 OR D1>T OR C1<1 OR C1>4 THEN PRINT"REJECTED.  THERE ARE "T"DEVICES AND UP TO FOUR POINTS":RETURN
1030 IF S$(D1,C1)<>"IWAIT"THEN THEN PRINT"THIS POINT MAY NOT BE PLUGGED":RETURN
1040 S$(D1,C1)="INO":P(D1,C1,0)=-1:P(D1,C1,1)=-1:RETURN
1100 PRINT:PRINT"POINTS LABELED  I  WAIT  MAY BE PLUGGED":PRINT:FOR I=1TOT:FOR JJ=1TO4:IF S$(I,JJ)="IWAIT" THEN A$="SHORT":GOSUB 410 ELSE NEXT JJ
1110 NEXT I
1120 INPUT "DO YOU WISH TO PLUG ALL THESE INPUTS (Y)ES OR (N)O";A$:IFA$<>"Y"ANDA$<>"N"THEN 1120 ELSE IF A$="N"THEN RETURN
1130 FOR I=1TOT:FORJ=1TO4:IF S$(I,J)="IWAIT" THEN S$(I,J)="INO":P(I,J,0)=-1:P(I,J,1)=-1
1140 NEXT J,I:PRINT"PLUGGED":RETURN
1200 PRINT:PRINT"GOING":PRINT
1210 FOR I=1TOT:FORJ=1TO4:IF S$(I,J)="IWAIT"THEN PRINT"NOT EVERYTHING IS PLUGGED.":RETURN:NEXTJ,I
1220 FL=0
1230 FOR I=1TOT
1240 IF W(I)=1 THEN 1390
1250 FH=0:FOR J=1TO 4
1260 B$=LEFT$(S$(I,J),1):C$=T$(I):IF B$="I" AND C$="WAIT2" THEN FH=1
1270 IF B$<>"O" OR FH=1  THEN 1350
1280 IF C$="NAND" THEN S$(I,J)="OYES":IF S$(I,1)="IYES" AND S$(I,2)="IYES" AND S$(I,3)="IYES" THEN S$(I,J)="ONO"
1290 IF C$="NOR" THEN S$(I,J)="OYES":IF S$(I,1)="IYES" OR S$(I,2)="IYES" THEN S$(I,J)="ONO"
1300 IF C$="XOR" THEN  IF S$(I,1)=S$(I,2) THEN S$(I,J)="ONO" ELSE S$(I,J)="OYES"
1310 IF C$="JOINT" THEN IF S$(I,1)="IYES" OR S$(I,2)="IYES" THEN S$(I,J)="OYES" ELSE S$(I,J)="ONO"
1320 IF C$="BRANCH" THEN IF S$(I,J)=S$(I,1)
1330 S$( P(I,J,0),P(I,J,1))="I"+MID$( S$(I,J),2):FL=1
1350 NEXT J
1390 NEXT I
1400 IF FL=1 THEN 1220
1410  REM REPORT LIGHTS
