10 'SKINNER BOX
15 CLS
20 PRINT"WELCOME  RAT!"
30 PRINT"LOOK AROUND YOU.  YOU ARE IN A TINY BOX WITH BLUE WALLS."
40 PRINT"YOUR MISSION IS TO GET FOOD WITH AS LITTLE EFFORT AS            POSSIBLE. ANY BUTTON WITH SIGNAL YOUR WISH."
45 PRINT"WHEN YOU THINK YOU KNOW WHAT DR. SKINNER IS UP TO PRESSA NUMBER BUTTON."
50 PRINT
60 PRINT
70 PRINT"PRESS ANY BUTTON -(THIS IS NOT THE TEST)"
80 IF INKEY$=""THEN80
90 GOSUB 2000
100 LT=TM
110 CLS
120 PRINT@0,"TIME SINCE LAST SUCCESSFUL TRIAL -"
130 PRINT@64,"TRIALS SINCE LAST SUCCESSFUL TRIAL -"
150 GOSUB 2000
155 BT=TM-LT
160 PRINT@40,BT;
170 PRINT@104,BH;
180 AA$=INKEY$:IF AA$=""THEN150ELSE IF VAL(AA$)<>0 THEN 3000
200 GOSUB 1000
210 IF NOT PY THEN BH=BH+1:GOTO150
220 FOR I=1TO50:OUT255,1:OUT255,2:NEXTI
225 PRINT@768,"IT TOOK YOU"BH+1" HITS AND"BT" SECONDS TO HIT.";
230 HH=HH+BH+1:TT=TT+BT:GH=GH+1
240 PRINT@832,"AVERAGE HITS TO GOAL IS"HH/GH", AND AVERAGE TIME IS"TT/GH".";
250 BH=0:GOSUB 2000:LT=TM
260 GOTO 150
1000 'DR. SKINNER
1010  IF GH>0  THEN 1100
1020 PY=-1
1030 MT=-LOG(RND(0))*7
1040 CC=RND(4)
1050 FORI=1TOCC:READA$:NEXTI:A$=A$+STR$(MT)
1060   DATA VI,FI,VR,FR
1090 RETURN
1100  ON CC GOTO  1110,1170,1200,1250
1110 'VT
1120 IF BH=0 THEN  NT=-LOG(RND(0))*MT
1130 PY= BT>NT
1140 RETURN
1170 'FI
1180 PY= BT>MT
1190 RETURN
1200  'VR
1210 PY = RND(0)<  1/MT
1220 RETURN
1250 'FR
1270 PY  =(BH+1)>MT
1280 RETURN
2000 TM = VAL(MID$(TIME$,10,2))*3600+VAL(MID$(TIME$,13,2))*60+VAL(RIGHT$(TIME$,2)):RETURN
3000 'DONE
3010 T$=TIME$:'FREEZE TIME
3020 PRINT@320,"WHICH SCHEDULE DO YOU THINK (VI,FI,VR,FR)";:INPUTAN$
3030 INPUT"WHAT AVERAGE OR MINIMUM WAS USED";AN
3040 IF AN$=LEFT$(A$,2) THEN PRINT"YOU WERE RIGHT ABOUT THE SCHEDULE!"
3050 PRINT"THE SCHEUDLE USED WAS ";A$
3060 RUN 70
