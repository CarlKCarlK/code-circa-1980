5 CLS
10 PRINT"THS PROGRAM MULTIPLYS 2 VARIABLES"
20 PRINT"POLYNOMIALS."
30 PRINT
40 INPUT"IN THE FIRST POLYNOMIAL WHAT IS THE HIGHEST POWER OF X";FX
50 INPUT"IN THE FIRST POLYNOMIAL WHAT IS THE HIGHEST POWER OF H";FH
60 PRINT
70 INPUT"IN THE SECOND POLYNOMIAL WHAT IS THE HIGHEST POWERR OF X";SX
80 INPUT"IN THE SECOND POLYNOMIAL WHAT IS THE HIGHEST POWER OF H";SH
90 DIM F(FX,FH),S(SX,SH),A(SX+FX,FH+SH)
95 PRINT
100 FOR PX=FXTO0 STEP-1
110 FOR PH=0 TO FH
120 PRINT"WHAT IS THE COEFFICENT ON THE X["PX" * H["PH" TERM";
130 INPUT F(PX,PH)
140 NEXT PH,PX
145 PRINT:PRINT"NOW THE SECOND NUMBER":PRINT
150 FOR PX=SXTO0STEP-1
160 FOR PH=0TOSH
170 PRINT"WHAT IS THE COEFFICENT ON THE X["PX" * H["PH" TERM";
180 INPUT S(PX,PH)
190 NEXT PH,PX
200 FOR XF=0 TO FX:FORHF=0 TO FH
210 FOR XS=0 TO SX: FOR HS=0 TO SH
220 A(XF+XS,HF+HS)=A(XF+XS,HF+HS) + F(XF,HF) * S(XS,HS)
230 NEXT HS,XS,HF,XF
235 PRINT
240 PRINT"ALL DONE"
245 PRINT
250 FOR XP=SX+FXTO 0 STEP -1:FORHP=00 TO FH+SH
260 IF A(XP,HP) = 0 THEN 270ELSEPRINT" "A(XP,HP)" (";:IF XP<>0 THEN PRINT"X["XP;
265 IF HP<>0 THEN PRINT" H["HP")  +";ELSEPRINT") +";
267 IF XP=0 AND HP=0 THEN PRINTSTRING$(4,CHR$(24));" +  ";STRING$(2,CHR$(24));
270 NEXT HP,XP
280 PRINTCHR$(24);" "
