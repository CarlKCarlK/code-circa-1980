10 CLS
20 PRINT"WELCOME TO STATS"
30 PRINT"ANALISIS OF DATA"
40 INPUT"HOW MANY PIECES OF DATA DO YOU HAVE (IF NOT SURE THEN OVER GUESS";NE
50 DIMX(NE)
60 PRINT"WHEN FINISHED ANSWER 'D'."
70 FOR C=1TONE
80 PRINT"WHAT IS ENTERY NO.";C;:INPUTA$
90 IFA$="D"THEN120  ELSEX(C)=VAL(A$)
100 NEXT C
110 PRINT:PRINT"THE DATA I HAVE RECORDED IS THIS:":PRINT
120 N=C-1
130 DIM F(N)
140 FORC=1TON:PRINT "("C")";X(C),:NEXT:PRINT
150 INPUT"IS ANY OF THIS DATA INCORRECT";A$
160 IFA$="NO"THEN210  
170 INPUT"GIVE NO. OF DATA,DATA  (TYPE 0,0 WHEN FINISHED)";C,X
180 IFC=0ANDX=0THEN210  
190 X(C)=X
200 GOTO 170  
210 CLS
220 PRINT"CASE NUMBER=",,N
230 FORC=1TON:T=T+X(C)
240 NEXT
250 PRINT"MEAN=",,T/N:MN=T/N
260 PRINT"MEDIAN=",,
270 G1=N
280 IF G1<=1THEN340  
290 G1=INT(G1/2):M1=N-G1
300 F1=0:FORI1=1TOM1:P1=I1+G1:C1=C1+1:IFX(I1)=<X(P1)THEN320  
310 S1=S1+1:T1=X(I1):X(I1)=X(P1):X(P1)=T1:F1=1
320 NEXTI1
330 IFF1>0THEN300  ELSE280  
340 IF N/2<>INT(N/2)THEN360  
350 MD=(X(INT(N/2))+X(INT(N/2)+1))/2:GOTO370  
360 MD=X(N/2+1)
370 PRINTMD
380 FORC=1TON
390 FORB=CTO1 STEP -1
400 IF X(B)=X(C) THEN F(C)=F(C)+1:NEXTB
410 NEXT C
420 R=0:FORC=1TON:IFF(C)>RTHENR=F(C)
430 NEXT
440 MO=R:PRINT"MODE=",,:IFMO=1THENPRINT" NONE"ELSEPRINTMO
450 RN=X(N)-X(1):PRINT"RANGE=",,RN
460 PRINT"AVERAGE DEVIATION=",
470 FORC=1TON:AD=AD+ABS(MN-X(C))/N
480 VR=VR+(MN-X(C))[2/N:NEXT
490 PRINTAD
500 PRINT"VARIANCE=",,VR
510 SD=SQR(VR)
520 PRINT"STANDARD DEVIATION=",SD
