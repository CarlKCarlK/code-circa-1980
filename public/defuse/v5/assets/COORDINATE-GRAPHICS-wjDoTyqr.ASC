10 DEFFNO(M,Y)=SGN(M/2-ABS(M/2-Y))
20 DEFFNX(S,Y,L)=Y/S-L/2/S+L/2
30 DEF FNY(S,X,Y)=S*X-S*Y/2+Y/2
40 DEFFNS(X1,Y1,X2,Y2)=(Y1-Y2)/(X1-X2)
50 CLS
60 YY=24:XX=20
70 YL=45
80 XR=2
90 FORC=1TO4:READF,H:X(C)=YL*F:Y(C)=YL*H:NEXT
100 DATA1,0,0,0,0,1,1,1
110 A$=INKEY$:IFA$="Z"THENAA=-1ELSEIFA$="X"THENAA=0ELSEIFA$="C"THENAA=1ELSEIFA$=","THENBB=-1ELSEIFA$="."THENBB=0ELSEIFA$="/"THENBB=1
120 XX=XX+AA/100*YL:YY=YY+BB/100*YL
130 FORC=1TO4
140 S=FNS(X(C),Y(C),XX,YY)
150 XG(C)=X(C):YG(C)=FNY(S,XG(C),YL)
160 IF FNO(YL,YG(C))=-1THENYG(C)=Y(C):XG(C)=FNX(S,YG(C),YL)
170 X1=YL/2*XR:Y1=YL/2:X2=XG(C)*XR:Y2=YG(C):GOSUB180  :NEXT:GOTO110  
180 LINE(X1,Y1)-(A(C),B(C)),RESET:LINE(X1,Y1)-(X2,Y2),SET:A(C)=X2:B(C)=Y2:RETURN
