1 CLS
2 CLEAR 200
5 REM TUTAC COMPUTER
6 M=1500
7 DEFDBL T,D,A,R,Z,Y,S:DIM T(M):DEFINT P,B,W
10 PRINT"COMPUTER LIKE IN TUTOR TEXT     "
20 PRINT" (CLEAR) BUTTON CLEARS MEMORY"
30 PRINT" PUT CARD IN DATA STATMENTS"
40 PRINT" R - RUNS THE READER"
50 A$=INKEY$:IFA$=""THEN50
60 IF A$=CHR$(31) THEN FOR X=1TOM:T(X)=0:NEXTX:PRINT"MEMORY CLEARED"
70 IF A$=CHR$(82) THEN 100ELSE50
100 REM CARD READER
110 READ D
115 IF D=0 THEN200
120 D$=STRING$(15," ")+STR$(D):T(VAL (MID$(D$,LEN(D$)-14,4)))=VAL(MID$(D$,LEN(D$)-10,11))
130 GOTO 110
200 REM POINTER STARTS AT -1
205 PRINT"RUNNING"
210 P=-1
220 P=P+1
230 S=T(P):B=10:W=2:GOSUB700:C=S:S=T(P):B=8:W=4:GOSUB700:L=S
300 IF C=50 THEN A= T(L): 'STORE
310 IF C<>60 THEN 320ELSEY=A:Z=T(L):GOSUB 800:Y=Y+Z:IF Y>=1E10OR Y=<-1E10 THEN 600ELSEGOSUB 900:A=Y:'ADD
320 IF C=15 THEN T(L)=A: 'TO MEM FROM ACCULATOR
330 IF C=25 THEN PRINT USING "###########";T(L):'PRINT MEM
340 IF C=00 THEN PRINT"FINISHED":END:'END
350 IF C<>61 THEN 360 ELSEY=A:Z=T(L):GOSUB800:Y=Y-Z:IF Y>=1E10 OR Y<=-1E10 THEN 600ELSE GOSUB900:A=Y:'SUBTRACT
360 IF C<>62 THEN 400
370 Y=A:Z=T(L):STOP:GOSUB800:H=INT(Z/1E5)*1E5:R=(Z-H)*Y:A=INT(R/1E10)+H/1E5*Y:STOP:R=R-INT(R/1E10)*1E10:STOP
380 IF A>=1E10ORA<=-1E10 THEN 600 ELSE Y=A:Z=ABS(R):GOSUB900:A=Y:R=Z:'MULTIPLY
400 '
500 GOTO 220
600 REM OVERFLOW ERROR
610 PRINT"OVERFLOW ERROR  AT "L:END
700 REM S = MID( S,LEN(S)-B,W)
710 S$=STRING$(15," ")+STR$(S):S=VAL(MID$(S$,LEN(S$)-B+1,W)):RETURN
720 RETURN
800 REM  SUB FOR NUMBER TO SIGN
810 IF Y>= 1E+10 THEN Y=- (Y-1E+10)
820 IF Z>= 1E+10THEN Z=- (Z-1E+10)
830 RETURN
900 REM SUB FOR SIGN TO NUMBER
910 IF Y<0 THEN Y=ABS(Y)+10000000000
920 IF Z<0 THEN Z=ABS(Z)+10000000000
930 RETURN
9999 'DATA AAAAS0123456789
10000 DATA 050010000200400
10005 DATA 050100800250000
10010 DATA 000005005000000
10020 DATA 000106205010000
10030 DATA 000200000000000
20000 DATA 0
