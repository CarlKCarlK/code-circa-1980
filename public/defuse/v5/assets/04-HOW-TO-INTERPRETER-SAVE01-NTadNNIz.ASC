5 CLEAR 5000:CLS
10 IN=0:RN=0:CN=0:LN=0:MN=0:VN=0
15 TC$="PLEASE CONTINUE EXPLAINING "
20 DIM P$(70),MT$(20),VT$(40)
100 PRINT"WHAT ARE YOU GOING TO TELL ME HOW TO DO?":PRINT"HOW TO ";:GOSUB 950:T=0:MT$(0)="NULL1"+T$:PRINT:T1=1:T$(0)=T$:GOTO 220
150 PRINT CHR$(94);:GOSUB 950
160 IF T$="THAT'S ALL"OR T$="THATS ALL" OR T$="THAT IS ALL"THEN 200 ELSE IF LEFT$(T$,4)="MAKE"THEN 300 ELSE IF LEFT$(T$,7)="COMPUTE" THEN 400 ELSE IF LEFT$(T$,3)="NOW"THEN500 ELSE IF LEFT$(T$,5)="FIRST"THEN 600 ELSE IF LEFT$(T$,5)="WHILE" THEN 700
170 IF LEFT$(T$,4)="LIST"THEN 800
180 PRINT:PRINT"I DON'T UNDERSTAND, PLEASE SAY 'THAT'S ALL' OR 'LIST', OR WRITE A STATMENT WITH 'MAKE','NOW','COMPUTE','FIRST - WHILE - THEN',  OR 'IF - THEN - ELSE'":PRINT:GOTO 150
200 PRINT:PRINT"OK":PRINT
210 FOR T=MN TO 0 STEP -1:IF LEFT$(MT$(T),4)<>"NULL"THEN NEXT T:GOTO 1100 ELSE T1=VAL( MID$(MT$(T),5,1)):T$(0)=MID$(MT$(T),6)
220 T$(1)="HOW TO ":T$(2)=T$(1)+"FIND ":T$(3)=T$(2)+" WHEN "
225 P$(LN)=T$(T1)+T$(0):MT$(T)=MID$( STR$(LN)+"    ",2,4)+MID$(MT$(T),5,255):LN=LN+1
230 PRINT"PLEASE EXPLAIN ";T$(T1);T$(0);"."
240 GOTO 150
300 T$=MID$(T$,5):GOSUB 1000:TF=0:TV$="":TM$="":FORT=1TOLEN(T$):TT$=MID$(T$,T,1):IF TF=0 THEN IF(TT$=" "ORTT$=";") THEN TF=1 ELSE TV$=TV$+TT$ ELSE IF TT$=";"THEN TV$=TV$+" "+TM$:TM$=""ELSE TM$=TM$+TT$
310 NEXT T:T1$=T$:T$=TM$:GOSUB 1000:TM$=T$:T$=TV$:GOSUB 1000:TV$=T$:T$=T1$
320 IF TV$="" OR TM$="" THEN340 ELSE P$(LN)="MAKE "+TV$+", "+TM$:LN=LN+1:GOSUB 1100:MC=2:GOSUB 1200:PRINTTC$;T$(T1);T$(0);".":GOTO 150
340 PRINT"HOLD ON!, YOU GAVE ME A MAKE COMMAND, BUT ";:IF TV$=""THEN PRINT"NO VARIABLE OR MODULE."ELSEPRINT"NO MODULE."
350 PRINT"REMEMBER THE FORM IS:    MAKE <VARIABLE>;<MODULE>":PRINT"YOU CAN LEAVE THE ; OUT IF THE VARIABLE IS ONLY 1 WORD LONG.":PRINTTC$;T$(T1);T$(0);".":GOTO 150
400 P$(LN)=T$:LN=LN+1:T$=MID$(T$,8):BF=1:PF=0:T4$="":FOR T=1TOLEN(T$):T4=ASC(MID$(T$,T,1)):IF PF=1 AND T4=41 THEN PF=0 ELSE IF PF=0 AND T4=40 THEN PF=1
410 IFPF=1ORT4=33OR(T4>=40ANDT4<=47)ORT4=59ORT4=60ORT4=61ORT4=62ORT4=91THENIFBF<>1THENBF=1:T4$=T4$+CHR$(191)ELSEELSET4$=T4$+CHR$(T4):BF=0
420 NEXT T:TV$="":FOR T6=1 TO LEN(T4$):T5$=MID$(T4$,T6,1):IF T5$<>CHR$(191) THEN TV$=TV$+T5$ ELSE GOSUB 1100
430 NEXT T6
800 PRINT"
VARIABLES":FOR T3=0TO VN:PRINTVT$(T3):NEXTT3:PRINT"
MOD":FOR T3=0TOMN:PRINTMT$(T3):NEXTT3:PRINT"
PROGRAM":FOR T3=0 TO LN:GOSUB 810:PRINTP$(T3):NEXT T3:PRINTTC$;T$(T1);T$(0);".":GOTO150
810 IF LEFT$(P$(T3),3)="HOW" THEN PRINT:RETURNELSE IF LEFT$(P$(T3),4)="THEN"OR LEFT$(P$(T3),4)="ELSE"OR LEFT$(P$(T3),4)="WHILE" THEN PRINT"       ";:RETURNELSEPRINT"   ";:RETURN
949 PRINT TV$,TM$,T$:STOP
950 INPUT T$
1000 TB$=" ":TT$=T$:T$="":FORT=1TOLEN(TT$):TN$=MID$(TT$,T,1):IF(TN$<>TB$AND TB$=" ")ORTB$<>" "THEN T$=T$+TN$
1010 TB$=TN$:NEXTT
1020 IF RIGHT$(T$,1)<>" "THEN RETURN ELSE T$=LEFT$(T$,LEN(T$)-1):IF T$=""THEN RETURN ELSE 1020
1100 FOR T=0TOVN:IF MID$(VT$(T),3)=TV$THEN RETURN ELSE NEXTT
1110 DT$(1)="CHARACTER":DT$(2)="OUTPUT":DT$(3)="INPUT":DT$(4)="REAL":DT$(5)="INTEGER"
1120 PRINT"
WHAT TYPE IS ";TV$;:GOSUB 950:FOR TI=1TO5:IF T$=MID$( DT$(TI),1,LEN(T$)) THEN P$(LN)="DECLARE AS "+DT$(TI)+": "+TV$:LN=LN+1:VT$(NM)=LEFT$(DT$(TI),1)+" "+TV$:VN=VN+1:RETURNELSE NEXT TI
1130 PRINT:PRINT"THE LEGAL TYPES ARE:":FOR TI=1TO5:PRINTDT$(TI),:NEXT TI:PRINT"PLEASE ANSWER WITH THESE OR THEIR ABBEVIATION.":GOTO1120
1200 FOR T=0 TOMN:IF MID$(MT$(T),6)=TM$THENRETURNELSENEXT
1210 MT$(T)="NULL"+RIGHT$(STR$(MC),1)+TM$:MN=MN+1:RETURN
10000 INPUT T$
10010 GOSUB 400:PRINTT4$:GOTO 10000
