10 'GROUP CHART
20 DIM M(50):CLS
30 PRINT"PUSH SPACE UNTILL YOU SEE: 2000 X3=X1      ,THEN PUSH"
40 PRINT"THE 'I' KEY, NOW PUSH IN THE OPERATION YOU WISH AND"
50 PRINT"PRESS THE ENTER KEY. THEN FINAL STEP IS TO TYPE IN"
60 PRINT"'GOTO 90' AND PRESS ENTER."
70 EDIT2000
90 '
100 INPUT"HOW MANY NUMBERS";N
110 FORC=1TON:PRINT"WHAT IS NUMBER";C;:INPUTM(C):NEXTC
115 CLS:PRINT"   ";:FORC=1TON:PRINTM(C);" ";:NEXTC:PRINT:PRINT"   ---";:FORC=1TON:PRINT"---";:NEXTC:PRINT
120 FORC=1TON
125 PRINTM(C);":";:FORC2=1TON
130 X1=M(C):X2=M(C2):GOSUB2000:A=X3
140 PRINTA;" ";:NEXTC2:PRINT:NEXTC
150 PRINT"PRESS 'ENTER' TO CONTINUE":PRINT
160 A$=INKEY$:IFA$=""THEN160
170 PRINT"CLOSURE TEST":FORC=1TON:FORC2=1TON:X1=M(C):X2=M(C2):GOSUB2000:FORT=1TON:IFM(T)=X3THENCC=1
180 NEXTT:IFCC<>1THENPRINT"WHEN X1 & X2= ";M(C);M(C2);"THEN CLOSURE DOES NOT WORK, FOR X3= ";X3 ELSECC=0:NEXTC2:NEXTC
190 PRINT"PUSH 'ENTER' TO CONTINUE":PRINT
200 A$=INKEY$:IFA$=""THEN200
210 PRINT"IDENITY":FORC=1TON:FORC2=1TON:X1=M(C):X2=M(C2):GOSUB2000:IFX2=X3THENCC=1
220 X1=M(C2):X2=M(C):GOSUB2000:IFCC=1 ANDX1=X3 THEN CS=CS+1:NEXTC2
230 IFCS=N THENPRINTM(C);"IS THE IDENITY ELEMENT":ID=M(C):GOTO260 ELSE CC=0:CS=0:NEXT:PRINT"THERE IS NO IDENITY ELEMENT":GOTO260
260 PRINT"PUSH 'ENTER' TO CONTINUE":PRINT
270 A$=INKEY$:IFA$=""THEN270
280 PRINT"INVERSE":FORC=1TON:FORC2=1TON:X1=M(C):X2=M(C2):GOSUB2000:IF X3=ID THENCC=CC+1:NEXTC2:IFCC<>NTHENPRINTM(C);" DOES NOT HAVE AN INVERSE IN THE SET" ELSE NEXT C:PRINT"ALL MEMBERS HAVE INVERSES"
290 STOP
2000 X3=X1+X2:RETURN
