10 CLS
20 INPUT"DO YOU WHAT   1) EQUATION BALANCE
              2) ORDERED PAIRS
              ";C
30 CLS
40 IF C=2 THEN 5000 ELSEIFC=1THEN90 ELSE PRINT"TYPE EITHER   1   OR  2 ":GOTO20
80  REM EQUATION BALANCE
90 NC=-1
100 FOR X=1TO40:SET(X+10,24):SET(X+80,24):NEXTX
110 FORX=30TO100:SET(X,32):SET(X,31):NEXTX
120 FOR Y=25TO30:SET(30,Y):SET(100,Y):NEXTY
130 FOR X=62TO68:FORY=33TO35:SET(X,Y):NEXTY,X
140 FOR Y=35 TO 45:SET(45,Y):SET(85,Y):NEXTY
150 FOR X=45 TO85:SET(X,35):SET(X,45):NEXTX
160 PRINT@32+832-64,"=";
170 PRINT@26+768+64,">";
180 PRINT@38+832,"<";
190 A$="EQUATION SCALE":PRINT@32-LEN(A$)/2,A$;
300 PRINT@128,"HOW MANY N'S ";:INPUT C
310 PRINT@128,"WHAT SHOULD I ADD TO THE LEFT SIDE ";:INPUTL
320 PRINT@128,"WHAT SHOULD i ADD TO THE RIGHT SIDE ";:INPUTR
330 PRINT@128,"                                              ";
340 PRINT@128,"WHAT IS THE SYMBOL ";:INPUTS$
350 PRINT@128,"                            "
400 IF C+L>20 OR R>20 THEN PRINT@128,"IT WOULDN'T ALL FIT ON THE SCALE":FORX=1TO1500:NEXTX:PRINT@128,"                                                         ";:GOTO 300
410 Z= (R-L)/C
500 FOR I=1TO20
510 IF I<=C THEN PRINT@I+5+448,"X ";
520 IF I>C+1 AND I<=L+C+1 THEN PRINT@I+5+448,CHR$(132);
530 IF I>L+C+1 THEN PRINT@I+5+448," ";
540 IF I<=R THEN PRINT@I+40+448,CHR$(132);
550 IF I>R THENPRINT@I+40+448," ";
555 NEXTI
557 PRINT@110,C"X+"L;S$;R;
560 IFS$=">"THENPRINT@863,CHR$(93);"--";ELSEIFS$="<"THENPRINT@863,"--"CHR$(94);ELSEPRINT@863," [ ";
570 PRINT@128,"?        ";:PRINT@130,"";
580 A$=INKEY$:IFA$=""THEN580ELSEPRINTA$;
585 IF A$=CHR$(8) THEN 570
590 B$=INKEY$:IFB$=""THEN590ELSEPRINTB$;
595 IF B$=CHR$(8) THEN 570
600 C$=INKEY$:IFC$=""THEN600ELSEPRINTC$;
605 IF C$=CHR$(8) THEN 570
610 IFA$=" "ORB$=" "ORC$=" "THEN A$=INKEY$:GOTO 570
700 IF A$="L"THEN800
710 IF B$="-"THEN NR=R-VAL(C$)
720 IF B$="+"THEN NR=R+VAL(C$)
730 IF B$="/"THEN NR=R/VAL(C$)
740 IF B$="*"THEN NR=R*VAL(C$)
750 IF NR>20 THEN PRINT@192,"SORRY WE ONLY HAVE ROOM FOR 20":GOSUB2000:GOTO 900
760 IF NR<0 THEN PRINT@192,"SORRY WE ONLY HAVE "R" TO START WITH":GOSUB2000:GOTO 900
770 R=NR
790 GOTO 900
800 REM
810 IF B$="-"THENNL=L-VAL(C$)
820 IF B$="+"THEN NL=L+VAL(C$)
830 IF B$="/"THEN NL=L/VAL(C$):NC=C/VAL(C$)
840 IF B$="*"THEN NL=L*VAL(C$):NC=C*VAL(C$)
850 IF NL+NC>20 THENPRINT@192,"SORRY WE ONLY HAVE ROOM FOR 20":GOSUB2000:GOTO900
860 IF NL<0 THEN PRINT@192,"SORRY WE ONLY HAVE "L" TO TAKE AWAY FROM":GOSUB2000:GOTO 900
870 L=NL::IF NC<>-1 THEN C=NC:NC=-1
900 SS=SGN(C*Z+L-R)
910 IF SS=-1 THEN S$="<"ELSEIFSS=0THENS$="="ELSES$=">"
920 GOTO 500
999 GOTO 999
2000 FORX=1TO1000:NEXTX:PRINT@192,"                                                        ";
2010 RETURN
4000  A$=INKEY$:IFA$=""THEN4000ELSEPRINTASC(A$):GOTO4000
5000 REM ORDER PAIRS AND GRAPHING
5010 REM GAME TO GET USED TO GRAPHING SYSTEM
5020 DIM B$(10,10)
5030 CLS
5040 C=11:FOR Y=0TO10*64STEP64:C=C-1:PRINT@Y,C;:NEXTY
5050 C=-1:FORX=10*64TO10*64+40STEP4:C=C+1:PRINT@X,C;:NEXTX
5060 FOR Y=0TO9*64STEP64:FORX=5TO10*4+1STEP4:PRINT@X+Y,".";:NEXTX,Y
5070 RX=RND(10):RY=RND(10)
5080 PRINT@11*64,"WHAT IS YOUR GUESS   LIKE: (3,10)        ";:INPUTX$,Y$
5090 X=VAL(RIGHT$(X$,LEN(X$)-1)):Y=VAL(Y$)
5110 IF X<1 OR Y<1  OR X>10  OR Y>10 THEN PRINT" YOUR NUMBERS MUST BE ON THE GRAPH  (1 TO 10)  ";:FORI=1TO1000:NEXTI:PRINT@12*64,"			                                              ":GOTO5080
5120 IF X=RX AND Y=RY THEN 5200
5130 IF X=RX THEN X$="+"ELSEIFX<RX THEN X$=CHR$(94)ELSEX$=CHR$(93)
5140 IF Y=RY THEN Y$="+"ELSEIFY<RY THEN Y$="["ELSEY$=CHR$(92)
5150 PRINT@ (64*10-Y*64)+X*4+1,X$;Y$;
5160 GOTO5080
5200 PRINT@(64*10-Y*64)+X*4,"**";:FORI=1TO500:NEXTI
5210 FORX=1TO255:PRINTTAB(X)"RIGHT":NEXT
5220 CLS:PRINT"AGAIN";:INPUTA$:IFA$="YES"THENRUNELSEEND
