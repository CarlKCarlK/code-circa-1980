    1 "="USING : INPUT ">>>";Z$: GOTO Z$
    2 END 
   10 "BOOL"CLEAR : INPUT "NO.INPUTS?",Z: USING "####"
   20 GOSUB 100: FOR W=1 TO Z: PAUSE "INPUT#";W;"=";A(W): NEXT W
   30 X=0<X: PRINT "X=";X:Y=Z+1
   40 Y=Y-1: IF Y=0 GOTO 1
   50 A(Y)=0=A(Y): IF A(Y) GOTO 20
   60 GOTO 40
  100 D=0=A:E=0=B:F=0=C
  110 X=DEC+DBF+AEF+ABC: RETURN 
  210 "CO"INPUT Y,X:C=Y: IF Y-X>X LET X=Y-X
  220 FOR Z=1 TO X:C=C/Z: IF Y-Z>Y-X LET C=CY-CZ
  230 NEXT Z: PRINT C: GOTO 1
  310 "FRAC"INPUT X:A=INT X:B=1:C=X-A:D=0:E=1:F=1:G=0
  320 H=AF+D:I=AG+E:Y=H/I-X: PRINT H;"/";I: PRINT "ERR=";Y
  330 A=INT (B/C):J=C:C=B-AC:B=J:D=F:F=H:E=G:G=I: GOTO 320
  410 "DICE"GOSUB "R":A=1+INT 6R: GOSUB "R": PRINT 1+INT 6R;A: GOTO 410
  420 "R"R=[PI]+983R:R=R-INT R: RETURN 
  450 "SHIT"GOSUB "R": IF R<1/6 BEEP 8
  460 GOTO 1
  510 "FACT"INPUT X:Y=1: FOR Z=1 TO X:Y=YZ: NEXT Z: PRINT "Y=";Y: GOTO 1
  610 "FS": INPUT X:Y=1
  620 Y=Y+1: IF Y>[SQR]X THEN 650
  630 Z=X/Y: IF INT Z=Z PRINT Y:X=Z:Y=1
  640 GOTO 620
  650 PRINT X: GOTO 1
  710 "FUN"INPUT "X?",X: GOSUB "FX": PRINT X,Y: GOTO 710
  720 INPUT "A?",A,"B?",B,"INC?",C: FOR D=0 TO (B-A)/C:X=A+CD: GOSUB "FX": PRINT X,Y: NEXT D: GOTO 710
  730 GOTO 1
  750 "PERM"INPUT Y,X:P=1: FOR Z=Y-X+1 TO Y:P=PZ: NEXT Z: PRINT "PERM=";P: GOTO 1
  810 "GCD"INPUT X,Y
  820 Z=X-Y*INT (X/Y):X=Y:Y=Z: IF Z THEN 820
  830 PRINT "GCD=";X: GOTO 1
  850 "BASE"INPUT "FROM BS?",G: IF G=10 THEN 873
  855 INPUT "NUM?",A:B=1:D=0:C=A:F=10^((G>10)+1)
  860 E=A/F:A=INT E:D=D+FB*(E-A):B=GB: IF A THEN 860
  870 PRINT "<";G;">";C;"=";D: GOTO 855
  873 INPUT "TO?",G
  875 INPUT "NUM?",D:B=0:A=D:C=1:H=10^((G>10)+1)
  880 E=D/G:D=INT E:F=E-D:B=B+GFC:C=HC: IF D THEN 880
  890 PRINT A;"=<";G;">";B: GOTO 875
  900 "FX"Y=3XX-2X+7: RETURN 
  910 "LOG"INPUT "X?",X,"BASE?",B: PRINT LN X/LN B: GOTO 1
  920 "HELP": PRINT "BOOL:PUT FUNC AT 100..": PRINT "MAKES T.TABLE"
  921 PRINT "CO:COMB(X,Y)": PRINT "FRAC:[PI]=3/1": PRINT "DICE": PRINT "FACT:ORIAL"
  923 PRINT "FS:FACTORS OF X": PRINT "FUN:TION EVAL..": PRINT "AT 900 FX"
  925 PRINT "PERM:UTATION(X,Y)": PRINT "GCD": PRINT "BASE:CONVERTS": PRINT "LOG: TO ANY BASE"
