10 CLS
20 DIMA%(250):IY=-1:QF=20
30 LINE(3,1)-(10,5),SET,B:LINE(2,2)-(11,2),SET:LINE(1,3)-(12,3),SET:RESET(4,2):RESET(5,2):RESET(8,2):RESET(9,2)
40 DIM F%(200):GET@(0,0)-(6,5),F%
50 CLS:FORX=1TO63STEP9:PUT@(X,0)-(X+6,5),F%:NEXTX
60 GET@(0,0)-(63,5),F%
70 CLS
80 LINE(1,3)-(22,5),SET,BF:LINE(3,2)-(20,2),SET:LINE(5,1)-(18,1),SET
90 DIMB%(80):GET@(0,0)-(11,1),B%
100 CLS
110 LINE(3,5)-(16,5),SET:LINE(3,4)-(16,4),SET:LINE(9,3)-(11,4),SET,BF
120 DIM H%(40):GET@(0,0)-(9,1),H%
130 CLS
140 DIMK%(25):FORY=0TO7STEP3:LINE(5,3)-(0,Y),SET:LINE(4,4)-(9,Y),SET:NEXTY:LINE(4,0)-(5,7),SET:GET@(0,0)-(8,6),G,K%:CLS
150 DIM E%(40):FORX=0TO15STEP3.5:LINE(9,5)-(X,1),SET:NEXTX:GET@(0,0)-(9,1),E%:CLS
160 PRINT@896,"    ALIEN STAR INVADERS";:PRINT@960,"DEPOSIT COIN IN PENCIL BOX  AND PRESS 'ENTER'";
170 A$=INKEY$:IFA$<>""THENCLS:GOTO190  
180 Y=RND(9):PUT@(0,Y)-(63,4+Y),F%:X=RND(120):Y=RND(30):PUT@(X,Y)-(X+8,Y+6),SET,K%:GOTO170  
190 FORY=0TO9STEP2:PUT@(0,Y)-(63,5+Y),F%:NEXT
200 FORX=7TO60STEP 12+7:PUT@(X,12)-(X+11,13),B%:NEXT
210 PI=3.14158
220 A=-PI/2
230 HX=28
240 PUT@(HX,14)-(HX+9,15),H%
250 LINE(HX*2+10,47)-(COS(A)*7+(HX*2+10),SIN(A)*4+47),SET
260 A$=INKEY$:IFA$=""THEN270  ELSEIFA$=","THENAN=-1ELSEIFA$="."THENAN=0ELSEIFA$="/"THENAN=1ELSEIFA$="Z"THENCX=-1ELSEIFA$="X"THENCX=0ELSEIFA$="C"THENCX=1ELSEIFA$=" "ANDS=0THENS=1:SA=A:SX=COS(A)*9+(HX*2+10):SY=SIN(A)*5+47
270 A=A+AN/10:IFABS(PI/2+A)>PI/2THENAN=-AN
280 HX=HX+CX:IFHX<1ORHX>54THENCX=-CX
290 PUT@(HX,14)-(HX+9,15),H%:LINE(HX*2+10,47)-(COS(A)*7+(HX*2+10),SIN(A)*4+47),SET
300 Q=Q+1:IFQ/QF<>INT(Q/QF)THEN320  ELSEIY=IY+1:IFIY>5THENIY=0:PUT@(0,0)-(63,1),F%:LINE(0,10)-(63,11)," ",BF
310 GET@(0,IY)-(127,IY+29),G,A%:      PUT@(0,IY+1 )-(127,IY+30),SET,A%
320 IFS=0THEN350  ELSESX=SX+COS(A)*4:SY=SY+SIN(A)*2:IFPOINT(SX,SY)THEN340  ELSESET(SX,SY):RESET(OX,OY):OX=SX:OY=SY:IFSY<2THENS=0ELSEIFSX<2THENS=0ELSEIFSX>125THENS=0
330 GOTO350  
340 PUT@(SX-4,SY-3)-(SX+4,SY+3),SET,K%:FORX=1TO500:NEXT:LINE(SX-4,SY-3)-(SX+4,SY+3),RESET,BF:S=0:IFSY>=36THENP=P-1ELSEP=P+INT((36-SY)/5.5+.5)
350 IFRND(5)=1ANDM=0THENM=1:MX=HX*2+10+RND(21)-10:MY=IY+30
360 IFM=0THEN410  
370 MY=MY+2:IFMY>47THENM=0:RESET(NX,NY):ELSEIFPOINT(MX,MY)THEN390  ELSESET(MX,MY):RESET(NX,NY):NX=MX:NY=MY
380 GOTO410  
390 LINE(MX,MY)-(MX+RND(11)-6,MY+RND(9)-5),RESET,BF:M=0:RESET(NX,NY):IFMY>41THENKN=KN+1:PUT@(HX,14)-(HX+9,15),E%:FORX=1TO500:NEXT:PUT@(HX,14)-(HX+9,15),H%
400 IF KN=3THEN420  
410 GOTO260  
420 PRINT@50,"GAME OVER";:FORX=1TO1000:NEXT
430 CLS
440 PRINT"YOU HAVE"P"POINTS"
450 CLS:PRINT@960,"YOU EARNED"P*1000"POINTS";:FORL=1TO125:Y=RND(9):PUT@(0,Y)-(63,4+Y),F%:X=RND(120):Y=RND(30):PUT@(X,Y)-(X+8,Y+6),SET,K%:NEXTL:RUN
