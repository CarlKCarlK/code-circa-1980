80  A(5)=123
90  GOSUB4000
100  INPUT"SPEED (FT/SEC)";S
105  F=123
107  GOSUB4000
110  INPUT"ANGLE";A
115  M=0
120  A=A/90
125  IF A>1 THEN 3000
130  U=A*S
1015  I=.01
1020  IF F=1 THEN I=A(3)
1040  L=S-U
1060  GOSUB2000
1065  T=0:R=0
1070  IF F=1 THEN R=A(1)
1075  IF F=1 THEN T=A(2)
1080  P=R+(T*U)-32*T*T
1081  B=1:IF F=1 THEN B=A(4)
1082  P=P/B
1083  IF P>M THEN M=P
1085  IF(T>0)*(P<=0) THENPRINT@0,"TIME";T,"DISTANCE";X*B,"MAX ALT";M*B
1088 B$=INKEY$:IFP<0 AND B$<>""THEN15000
1090  X=L*T
1100  Y=48-P
1110  IF Y<0 THEN Y=Y+48
1111  IF Y<0 THEN GOTO1110
1120  B=1
1130  IF F=1 THEN B=A(4)
1200 IFY>=48THENY=Y-48
1210 IFX*2/B>127THENX=X-128*B/2
1211 SET(X*2/B,Y): IF((X*2/B>99)*(X*2/B<111))*(Y=10) THEN A(5)=1
1215  I=.05
1220  IF F=1 THEN I=A(3)
1225  T=T+I
1230  GOTO1080 
2000  FOR J=0 TO 127 STEP 10
2005  IF J<48 THEN SET(64,J)
2010  SET(J,47)
2020  NEXTJ
2040  RETURN
3000  INPUT"WHAT IS INTINAL ALT.";A(1)
3005  GOSUB4000
3010  INPUT"WHEN SHOULD WE START";A(2)
3015  GOSUB4000
3020  INPUT"HOW MUCH TIME BEWEEN PLOTS";A(3)
3025  INPUT"WHAT SCALE";A(4)
3030  F=1
3040  PRINT@0,"":GOTO110
4000  PRINT@0,""
4010  RETURN
15000 B$=INKEY$:IFB$=""THEN15000
15010 IFB$="C"THENCLS
15020 GOTO100
