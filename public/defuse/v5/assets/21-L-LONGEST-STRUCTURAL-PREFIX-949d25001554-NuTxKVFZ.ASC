10 REM life backwards april 27, 1985
90 DEFINT A-Z
100 DX=20:DY=20
110 DIM T6(4,4)
280 PRINT"Setting up"
290 DIM CN(380,1)
300 FOR I = 0 TO 511:IZ=I:TZ=0:			FOR J=0 TO 8:				  CZ(J)=IZ MOD 2:TZ=TZ+CZ(J):		  IZ= IZ/2:				  NEXT J
310 MZ= -((CZ(4)=1 AND (TZ=3 OR TZ=4)) OR(CZ(4)=0 AND TZ=3)):CN(TZ(MZ),MZ)=I:TZ(MZ)=TZ(MZ)+1:NEXTI
320 FOR MZ=0TO1:CN(TZ(M\x08),MZ)=-1:NEXTMZ
330 CLS
500 'main program
510 GOSUB 1000:'begin
520 GOSUB 2000:'reset
530 GOSUB 3000:'first_post
550 GOSUB 5000:IF C5=-1 THEN			OD(PS(0),PS(1))= -1:			GOSUB 4000:				IF PS(0)<0 THEN PRINT"trapped":STOP   :ELSE GOTO 540
570 GOSUB 6000:IF NOT(C6) THEN 540
580 GOSUB 7000:'pos=next pos
590 IF PS(0) <0  THEN 540
600 GOSUB 9000:'new=next_con(old)
610 GOTO 530
1000 'begin - read in life board
1005 GOSUB 1105
1010 READ P1(0),P1(1):				IF P1(0)<0 THEN RETURN
1020 NW(P1(0),P1(1)( =1
1100 'set-up new fields
1110 FOR I1=0TO1:FD(0,I1)=0:FD(1,I1)=0:	NEXTI1:RETURN
1130 GOSUB 1200:GOTO 1010
1200 :GOSUB\xFFajust field
1230 FOR I1 =0TO 1:				IF FD(1,I1)=0				 THEN FD(0,I1)=P1(I1):				FD(1,I1)=1			:ELSE IF P1(I1)<FD(0,I1)				THEN FD(1,I1)=FD(1,I1)+			(FD(0,I1)-P1(I1):			FD(0,I1)=P1(I1)			:ELSE IF P1(I1)> FD(0,I1)+			FD(1,I1) THEN FD(1,I1)=			P1(I1)-FD(0,I1)+1
1240 NEXT I1
1250 RETURN
2000 'reset
2010 FOR I1=0TO DX:FORJ1=0TODY:OD(I1,J1)=-1:NEXTJ1,I1
2020 RETURN
3000 'first position
3010 S3= 1-(FD(1,0)<FD(1,1))
3020 W3=FD(1,S3)/2
3030 FOR I3=0TO1:PS(I3)=FD(0,I3)+W3-1:		NEXTI3
3040 C3(S3)=0
3050 C3(1-S3)=FD(1,1-S3)-FD(1,S3)
3060 D3(0)=1:D3(1)=0
3065 M3=-1
3070 RETURN
4000 'previous position
4010 FORI4=0TO1:F4(I4)=PS(I4)-FD(0,I4)+1:		NEXT I4
4015 PRINT@0,"f4";F4(0);F4(1)
4020 IF F4(0)=W3 AND F4(1)=W3  THEN PS(0)=-1:RETURN
4030 IF F4(0)=F4(1) AND F4(0)<=W3 THEN 		PS(0)=PS(0)+1:PS(1)=PS(1)+1:		M3=0
4040 FOR I4=0 TO 1:				T4!(I4)=INT(C3(I4)/2)+W3+.5:		G4(I4)=T4!(I4)-ABS(T4!(I4)-F4(I4)):		NEXTI4
4045 PRINT@40,"g4";G4(0);G4(1)
4050 IF G4(0)=G4(1) AND G4(0)<=W3 		THEN :ELSE 4070
4060        FORI4=0TO1:IF D3(I4)<>0			THEN D3(I4)=0 :ELSE			D3(I4)=SGN(F4(0)-T4!(0))
4065 		NEXT I4
4070 FOR I4=0TO1:PS(I4)=PS(I4)-D3(I4):		NEXT I4
4075 PRINT@80,"d3";D3(0);D3(1)
4080 RETURN
5000 'increment config return c5
5010 OD(PS(0),PS(1))=1+OD(PS(0),PS(1))
5020 C5 = CN(OD(PS(0),PS(1)),NW(PS(0),PS(1)))
5030 RETURN
6000 'check compatibility return c6
6010 FOR I6(0)=0TO4:FORI6(1)=0TO4:		T6(I6(0),I6(1))=-1:			NEXT I6(1),I6(0)
6020 FOR I6(0)=-1TO1:FORI6(1)=-1TO1
6030 	H6=OD(I6(0)+PS(0),I6(1)+PS(1))
6040 	IF H6=-1 THEN 6110
6050 	H6=CN(H6,NW(I6(0)+PS(0),			I6(1(PPS(1)))
6060 	FOR J6(0)=-1TO1:FORJ6(1)=-1TO1
6070 	  K6=0TO1:B6(K6)=3+I6(K6)+J6(K6)		:NEXTK6
6080 	  N6=H6 MOD 2:H6=H6/2
6090 	  Y6=T6(B6(0),B6(1)):			  IF I\x12 = -1 					THEN T6(B6(0),B6(1))=N6			:ELSE IF Y6<>N6				THEN C6=0:RETURN
6100 NEXT J6(0),J6(1)
6110 NEXT I6(0),I6(1)
6120 C6=-1:RETURN
7000 'next position
7005 FOR I7=0TO1:PS(I7)=PS(I7)+D3(I7):		NEXT I7
7007 PRINT@80,"d3";D3(0);D3(1)
7010 FORI7=0TO1:F7(I7)=PS(I7)-FD(0,I7)+1:		NEXT I7
7015 PRINT@0,"f7";F7(0);F7(1)
7030 FOR I7=0 TO 1:				T7!(I7)=INT(C3(I7)/2)+W3+.5:		G7(I7)=T7!(I7)-ABS(T7!(I7)-F7(I7)):		NEXTI7
7040 IF F7(0)=F7(1) AND F7(0)<=W3 THEN 		IF M3 AND G7(0)<1 AND G7(1)<1		THEN PS(0)=-1:RETURN			:ELSE PS(0)=PS(0)-1:PS(1)=PS(1)-1	:M3=-1
7045 PRINT@40,"g7";G7(0);G7(1)
7050 IF G7(0)=G7(1) AND G7(0)<=W3 		THEN :ELSE 7070
7060        FORI7=0TO1:IF D3(I7)<>0			THEN D3(I7)=0 :ELSE			D3(I7)=-SGN(F7(1)-T7!(1))
7065 		NEXT I7
7070 RETURN
9000 'back up a generation
9010 GOSUB 1100 :'set up new fields
9020 FOR PS(0)=0TODX:FOR PS(1)=0TODY
9030    H9=CN(OD(PS(0),PS(1)),			NW(PS(0),PS(1)))
9040 	IF H9=-1 THEN H9=0			:ELSE H9 = INT(H9/32) MOD 2
9050    NW(PS(0),PS(1)) =H9
9060 	IF H9 THEN GOSUB 1200
9070 	OD(PS(0),PS(1))=-1
9080 	NEXT PS(1),PS(0)
9090 RETURN
