5 CLS:P=500:O=345:POKE16553,255
10 A$=INKEY$:IFA$=","THEND=D-1
20 IFA$="."THEND=D+1
25 IFA$="C"THENCLS
30 IFD>8THEND=1
40 IFD<1THEND=8
50 FORQ=1TOD:READC:NEXT:P=P+C
60 DATA -64,-62,2,66,64,62,-2,-66
65 IFP<0THENP=P+1024
70 IFP>1023THENP=P-1024 ELSEPRINT @ O,":";:PRINT  @ P,"#";:O=P
80 RESTORE:FORQ=1TO100:NEXT:Y=INT(P/64):X=(P/64-Y)*64:IFPOINT(X,Y)THEN750 ELSEGOTO10
500 FORZ=1TO100:SET(RND(128)-1,RND(48)-1):NEXTZ:RETURN
750 STOP
