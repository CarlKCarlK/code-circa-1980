10 CLS:PRINTTAB(20);"STOCK MARKET"
20 PRINTTAB(5)"CREATIVE COMPUTING MORRISTOWN, NEW JERSEY"
30 PRINT:PRINT:PRINT
110 DIMS(5),P(5),Z(5),C(5)
115 X=0:A=INT((RND(X)/10)*100+.5)/10:T5=0:X9=0:N1=0:N2=0:E1=0:E2=0
120 INPUT"DO YOU WANT INSTRUCTIONS";A$:IFA$="YES"THEN200
125 PRINT:PRINT:PRINT"    THIS PROGRAM PLAYS THE STOCK MARKET.  YOU WILL BE GIVEN"
128 PRINT"$10,000 AND MAY BUY OR SELL STOCKS.  HTE STOCK PRICES WILL"
130 PRINT"BE GENERATER RANDOMLY AND THEREEFORE THIS MODEL DOES NOT"
132 PRINT"REPRESENT EXACTLY WHAT HAPPENS ON THE EXCHANGE.  A TABLE
134 PRINT"OF AVAILABLE STOCKS, THEIR PRICES, AND THE NUMBER OF SHARES"
136 PRINT"IN YOUR PORTFOLIO WILL BE PRINTED.  FOLLOWING THIS, THE
138 PRINT"INITIALS OF EACH STOCK WILL BE PRINTED WITH A QUESTION"
140 PRINT"MARK. HERE YOUR INDICATE A TRANSACTION.  TO BUY A STOCK"
142 PRINT"TYPE +NNN TO SELL A STOCK TYPE -NNN, WHERE NNN IS THE "
144 PRINT"NUMBER OF SHARES.  A BROKERAGE FEE OF 1% WILL BE CHARGED"
146 PRINT"ON ALL TRANSACTIONS. NOT THAT IS A STOCK'S VALUE DROPS"
148 PRINT"TO ZERO IT MAY REBOUND TO A POSITIVE VALUE AGAIN.  YOU HAVE"
150 PRINT"$10,000 TO INVEST.  USE INTERGES FOR ALL YOUR INPUTS."
220 FORXX=1TO5:READS(X):NEXT
230 DATA100,85,150,140,110
266 T8=INT(4.99*RND(X)+1)
268 IFRND(X)>.5THEN270
269 A=-A
280 GOSUB830
290 FORI=1TO5
300 P(I)=0
305 Z(I)=0
310 NEXTII
320 PRINT
330 PRINT
335 C=10000
340 PRINT"STOCK",,"INITIALS","PRICE/SHARE"
350 PRINT"INT. BALISTIC MISSILES","  IBS",S(1)
355 PRINT"RED CROSS OF AMERICA","  RCA",S(2)
360 PRINT"LICHTENSTEIN, BUMRAP, & JOKE","  LBJ",S(3)
365 PRINT"AMERICAN BANKPUPT CO.","  ABC",S(4)
370 PRINT"CENSURED BOOKS STORE","  CBS",S(5)
