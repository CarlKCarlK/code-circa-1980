5 S=1
10 INPUT"HOW MANY SOUCES";N
20 FORI=1TON
30 INPUT"X OF SOUCE";X(I)
40 INPUT"RELITIVE MASS OF SAME";M(I)
50 NEXT
60 CLS
70 X=X+S:IFX>127THEN500
75 A=0
80 FORI=1TON
85 IFX=X(I)THENA=2:GOTO100
90 A=A+(M(I)/(X-X(I))[2)*SGN(X-X(I))
100 NEXT
105 Y=ABS(A)*500:IFABS(OY-Y)>1ANDY<=47THENS=S/2ELSEIFABS(OY-Y)<.5ANDS<1THENS=S*2
106 IFOY>47ANDY<=47THENS=SO
107 IFOY<=47ANDY>47THENSO=S:S=1
110 IFY<=47THENSET(X,Y)
120 OY=Y:GOTO70
500 GOTO500
