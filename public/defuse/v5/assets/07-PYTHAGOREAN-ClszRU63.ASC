2 AT=100000
5 CLS:G(1)=2:G(2)=1
7 GOSUB 20000
10 READ X1,Y1,X2,Y2:IFX1=-1 THEN X1=OX:Y1=OY
15 IF X1=-999 THEN 100
30 OX=X2:OY=Y2
40 GOSUB1000
50 GOTO 10
100 PRINT@448+25+128+64,"PYTHAGOREAN";
110 IF INKEY$=""THEN110
120 CLS
130  S(1)=RND(10):S(2)=RND(10):M=RND(3):S(3)=RND(15-S(G(M)))+S(G(M)):IFM=3THENX=S(1)[2+S(2)[2ELSEX=S(3)[2-S(G(M))[2
140 FOR HI=1TO3:IF HI<>M THEN PRINT"SIDE "CHR$(ASC("A")-1+HI)" ="S(HI)".";
141 NEXTHI:PRINT"WHAT DOES SIDE "CHR$(ASC("A")-1+M)" EQUAL ":T=0:Q$=""
145 A$=INKEY$:PRINT@50,STRING$(LEN(Q$),"");A$;:T=T+1:PRINT@55,INT(AT-T+1);:IFT>AT THEN 200  ELSEIFA$=""THEN145ELSEIFA$=CHR$(13)THEN147ELSEQ$=Q$+A$:GOTO145
147 IFLEFT$(Q$,1)<>"S"THEN Q$=STR$( VAL(Q$)[2)ELSE Q$=RIGHT$(Q$,LEN(Q$)-1)
150 PRINT:IF ABS(VAL(Q$)-X )<.01THEN PRINT"RIGHT" ELSE PRINT "NOPE. IT IS SQR( "INT(X+.5)")"
152 IF C=0 THEN C=1:AT=T:GOTO156
155 C=C+1:AT=(AT*(C-1)+T)/C
156 PRINT "TIME = "T,"AVERAGE TIME = "AT
160 GOTO110
200 FORX=1TO16:PRINT"TIME !","TIME!","tIME!","TIME!":NEXTX
205 T=2*AT
210 FORX=1TO300:NEXTX:CLS:GOTO150
1000 REM
1010 D=SQR((Y1-Y2)[2+(X1-X2)[2)
1020 SY=Y2/D-Y1/D
1030 SX=X2/D-X1/D
1040 FOR DD=0TOD
1050 SET(X1+SX*DD+.5,Y1+SY*DD+.5)
1060 NEXT DD
1070 RETURN
20000 READ A$:IFA$="DONE"THENRETURNELSEPRINTA$:PRINT:FORX=1TO500:NEXTX:GOTO20000
