3 DEF FNY(X)=INT(X/120*40)
4 DEF FNS(R,W,T)= ((W/T)*(R/W)*(1-(W/T))+(R/W)*(W/T)+ATN((W+W)*(W+W)/1E4)/10)*100
5 CLS
7 T=50
8 AV=86
10 FOR X= 0 TO 127
20 Y=INT(X/120*40)
30 FOR Y1=Y-3 TO Y
35 IF Y1>0 THEN SET(X,47-Y1)
40 NEXT Y1,X
50 A$=INKEY$:IF A$=""THEN 50 ELSE IF A$="Z"THEN R=R+1:W=W+1ELSE W=W+1
55 IF W=T THEN PRINT @ 0,"DONE":GOTO 1000
65 FOR Y1=0 TO 3:RESET(TS,46-(Y+Y1)):NEXT Y1:SET(TS,PA)
70 TS=FNS(R,W,T):Y=FNY(TS):FOR Y1=0 TO 3:SET(TS,46-(Y+Y1)):NEXT Y1:PA=FNS(AV*W,W,T):RESET(PA,47-FNY(PA))
80 GOTO 50
1000 GOTO 1000
