10 REM GO
20 GOSUB 200:'PRINT INTRO
30 GOSUB 300:'ASK ABOUT INITIAL STUFF
40 GOSUB 400:'PRINT BOARD
50 GOSUB 1700:IF T$="COMPUTER" THEN GOSUB 500 ELSE GOSUB 1000:'
    LOOK AT BOARD       COMUPUTERS TURN AND USERS TURN
60 IF G$="OVER" THEN 80
65 GOSUB 400
70 IF T$="COMPUTER"THEN T$="USER"ELSET$="COMPUTER"
75 GOTO 50
80 GOSUB 1300:'DECIDE POINTS
90 GOSUB 1400:'CONCLUSION
99 END
200 REM INTRO
210 CLS
220 PRINT"

WELCOME TO GO."
230 PRINT"WE WILL PLAY ON A 9 BY 9 BOARD.
THE DOTS (.) MARK THE INTERSECTIONS.
YOUR MARK IS  O, MY MARK IS ";:PRINTCHR$(143)"."
290 GOSUB 1500:'ANY BUTTON
299 RETURN
300 REM INITAL STUFF
310 CLS:INPUT"HOW MANY STONES WILL YOU SPOT ME";HC
320 REM THE BOARD IS      (0,0)      (8,0)
                           (8,0)      (8,8)
330 DATA  2,2,  6,6,  2,6,  6,2,    4,4,  4,2,  2,4,  6,4, 4,6
340 IF HC>9 THEN HC=9
350 DEFINT B,P,N: DIM B(8,8),P(82),N(82)
360 G$="PLAYING":T$="USER":DIM C$(2):C$(1)=".":C$(2)="O":C$(0)=CHR$(143)
370 IF HC<=0 THEN 399
375 FOR I=1TO HC
380  READ T1,T2
385  B(T1,T2)=-I
390 NEXT I:N=HC
399 RETURN
400 REM PRINT BOARD
410 'CLS
420 FOR I=0 TO 8:PRINT@I*4+3,I;:PRINT@(I*64)+64,I;:PRINT@I*4+3+10*64,I;:PRINT@(I*64)+64+10*4-1,I;:NEXT I
430 FOR XI=0TO 8:FOR YI=0 TO 8:X1=XI:Y1=YI:GOSUB 1600:NEXTYI,XI
440                                     REM PRINT POSITION
499 RETURN
500 REM COMP TURN
510 XS=RND(9)-1:YS=RND(9)-1:IF B(XS,YS)<>0 THEN 510 ELSE N=N+1:B(XS,YS)=-N:RETURN
1000 REM PERSONS TURN
1010 PRINT@12*64,"MOVE";:INPUT XS,YS:IF B(XS,YS)<>0 THEN 1010 ELSE P=P+1:B(XS,YS)=P:RETURN
1300 REM DECIDE POINTS
1400 REM CONCLUSION
1500 REM PAUSE TO TOUCH
1510 A$=INKEY$+INKEY$
1520 PRINT@975,"PRESS ANY BUTTON TO CONTINUE";
1530 IF INKEY$=""THEN1530 ELSE RETURN
1600 REM PRINT AT X1,Y1
1620 IF B(X1,Y1)=0 THEN PRINT@X1*4+4+(Y1*64)+64,". ";ELSEPRINT@  X1*4+4+(Y1*64)+64-1,B(X1,Y1);:RETURN:'C$(  SGN(B(X1,Y1))+1);:RETURN
1630 RETURN
1700 REM LOOK AT BOARD
1710 FOR I = 0 TO 80:N(I)=0:P(I)=0:NEXT I
1720 FOR XI= 0 TO 8:FORYI=0 TO 8:T=B(XI,YI) :IF T=0THEN 1810
1730 FOR XD = XI-1 TO XI+1:FOR YD =YI-1TOYI+1
1740 IF XD<0 OR XD>8 OR YD<0 OR YD>8 OR (XD=XI AND YD=YI) THEN 1800
1750 IF B(XD,YD)<>0 THEN 1760ELSEIF T<0 THEN N( -B(XI,YI))=N( -B(XI,YI))+1 ELSE D( B(XI,YI))=D(B(XI,YI))+1
1755 GOTO 1800
1760 IF SGN(T) <> SGN( B(XI,YI)) THEN 1790ELSE IF T=B(XD,YD) THEN 1800 ELSE HT=T:LT=B(XI,YI):IF ABS(HT)<ABS(LT) THEN TT=HT:HT=LT:LT=TT
1770 FOR XA=0TO8:FORYA=0TO8:IF B(XA,YA)=HT THEN B(XA,YA)=LT ELSE IF B(XA,YA)=N OR B(XA,YA)=P THEN B(XA,YA)=HT
1772 NEXT YA,XA:GOSUB 400:IF T<0 THEN N(-LT)=N(-LT)+N(-HT):N(-HT)=0:N(-HT)=N(N):N=N-1ELSE P(LT)=P(LT)+P(HT):P(PT)=0:P(PT)=P(P):P=P-1
1790 REM
1800 NEXT YD,XD
1810 NEXT YI,XI
1820 RETURN
