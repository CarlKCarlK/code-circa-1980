1010 INPUT"DO YOU WANT INSTRUCTIONS";A$:IFA$="YES"THEN1030
1030 PRINT:PRINT"GOOD LUCK":PRINT:PRINT"SEC     MI + FT     MPH     LB FUEL     BURN RATE, TIME":A=120:V=1:M=33000:N=16500:G=.001:Z=1.8:L=0:OL=1000
1260 SET(L/2,48-A*.39668):PRINTL"    ";INT(A);INT(5280*(A-INT(A)))"    "3600*V"  "M-N"      ";:INPUTK,T
1270 IFK>300THEN1260
1290 IFM-N<.001THEN1400ELSEIFT<.001THEN1260ELSES=T:IFM>=N+S*KTHEN1340ELSES=(M-N)/K
1340 GOSUB1790:IFI<=0THEN1650ELSEIFV<=0THEN1380ELSEIFJ<0THEN1710
1380 GOSUB1590:GOTO1290
1400 PRINT"OUT OF FUEL AT"L"SEC":S=(-V+SQR(V*V+2*A*G))/G:V=V+G*S:L=L+S
1440 W=3600*V:PRINT"ON THE MOON AT"L"SEC - INPACT VELOCITY"W"MPH":IFW>1.2THEN1490ELSEPRINT"GREAT LANDING !!!       (LUCKY)":GOTO2000
1490 IFW>10THEN1520ELSEPRINT"GOOD LANDING":GOTO2000
1520 IFW>60THEN1560ELSEPRINT"CRAFT DAMAGE. YOU ARE STRANDED UNTIL A RESCUE MISSION":PRINT"ARRIVES.  HOPE YOUR OXYGEN HOLDS OUT.":GOTO2000
1560 PRINT"YOU CRASHED - NO SURVIVORS.":PRINT"YOU BLASTED A NEW LUNAR CRATER"W*.2777"FEET DEEP":GOTO2000
1590 L=L+S:T=T-S:M=M-S*K:A=I:V=J:RETURN
1650 IFS<.005THEN1440ELSED=V+SQR(V*V+2*A*(G-Z*K/M)):S=2*A/D:GOSUB1790:GOSUB1590:GOTO1650
1710 W=(1-M*G/(Z*K))/2:S=M*V/(Z*K*(W+SQR(W*W+V/Z)))+.05:GOSUB1590:IFI<=0THEN1650ELSEGOSUB1590:IFJ>0THEN1290ELSEIFV>0THEN1710ELSEGOTO1290
1790 Q=S*K/M:IFQ>.000001THEN1800ELSEQ=0
1800 J=V+G*S-Z*Q*(1+Q*(.5+Q*(1/3+Q*(.25+Q/5)))):I=A-G*S*S/2-V*S+Z*S*Q*(.5+Q*(1/6+Q*(1/12+Q/20))):RETURN
2000 END
