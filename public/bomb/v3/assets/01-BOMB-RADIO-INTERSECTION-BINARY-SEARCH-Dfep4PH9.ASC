0 CLS
1 PRINT"TAKE YOUR CHOICE : ":PRINT"      (NEGITIVE FOR LISTING)"
2 PRINT:PRINT"1) BOMB":PRINT:PRINT"2) RADIO INTERSECTION":PRINT:PRINT"3) BINARY SEARCH":PRINT
3 INPUT IT
4 IF IT>0 THEN ON IT GOTO 10000,10,2000 ELSE IF IT=-1 THEN LIST10000- ELSE IF IT=-2 THEN LIST10-1999 ELSE IF IT=-3 THEN LIST2000-9999
10 REM   PROGRAM TO TEST THEORIES OF THE RELAY PROBLEM
20 CLS
21 PRINT@960,"IT IS RNDLY PICKING TWO STATIONS AND COMPUTING INTERSECT.";
22 PRINT@960-64,"                PRESS ANYTHING FOR MENU";
25 PI = 3.14159
30 FOR I=1TO2
40 X(I)= RND(0)*5:  REM   MAKE X A RND VALUE 0-1
50 Y(I) = RND(0):  REM     MAKE Y A RND VALUE 0-1
60 NEXT I
65 D=SQR( (X(1)-X(2))[2 + (Y(1)-Y(2))[2 )/2:REM 1/2 CEN. DIS.
67 IF D>1 THEN GOTO 140:  REM  SKIP ALL THAT STUFF NO EFFECT
70 A=ATN( (Y(1)-Y(2))/(X(1)-X(2)))
80 TH=-ATN(D/SQR(-D*D+1))+PI/2  :  REM  TH=ACOS(D)
84 'PRINTTH*180/PI
90 FOR I=1TO2
100  F(I) = A-TH
110  S(I) = A+TH
115 NEXTI
120 IF X(1)>X(2) THEN I=1 ELSE I=2:'F(I)=F(I)+PI :S(I)=S(I)+PI
130 F(I)=F(I)+PI:S(I)=S(I)+PI
140 REM DRAW PICTURE
150 FOR I=1TO2
160 FOR AN=0TO 2*PI STEP PI/8
170 FF=9:GOSUB 1000
180 NEXT AN
182 FF=9:FORAN=F(I)TOS(I) STEP PI/45:GOSUB1000:NEXTAN
190 NEXT I
210 IFINKEY$=""THENCLEAR 150:GOTO 10 ELSE RUN
1000 SET( COS(AN)*FF*2+X(I)*FF*2+FF*2,SIN(AN)*FF+Y(I)*FF+FF):RETURN
2000 REM BINARY SEARCH RESEARCH.
2010 CLS:PRINT"BINARY SEARCH RESEARCH"
2020 DIM S(10)
2025 DEFINT A-Z
2030 S(1)=RND(5)
2040 FOR I=2 TO 10
2050 S(I)=S(I-1)+RND(5)
2060 PRINT "S("I-1")  =",S(I-1)
2070 NEXT I
2080 PRINT "S("I-1")  =",S(I-1)
2090 PRINT
2100 INPUT"WHAT SHALL i SEARCH FOR ";IT
2110 N=10:I=0:LO=1:HI=N
2120 FOR LP=1TO10000 :' LOOP FOREVER
2130 IF NOT( LO <=HI AND I=0 ) THEN 2170
2140    MID=(LO+HI)/2+.5
2150    IF S(MID)=IT
                THEN I=MID
                 ELSE IF S(MID)<IT
                        THEN LO=MID+1
                        ELSE HI=MID-1
2160 NEXT LP
2170 IF I<>0 THEN ELSE I=-(HIGH+1)
2200 PRINT" I","LOW","HIGH","MID":PRINTI,LO,HI,MID
2210 PRINT"              ('M' FOR MENU, ANYOTHER FOR BINARY)";
2220 A$=INKEY$:IFA$=""THEN2220 ELSE IFA$="M"THEN RUN ELSE CLEAR150:GOTO 2000
10000 CLEAR100:DIM W$(35):GOSUB45000:HS=38:IN$="CMK":CLS:SP=500:PRINT"       W E L C O M E   T O   <<<  B O M B  >>>"
10010 'PRINT:PRINT"     YOU ARE A PRO ON THE BOMB SQUAD.  TODAY, YOU WERE HANDED   A PARTICULARY NASTY JOB.  A LETHAL, SUB-ATOMIC, MARK IV, MX57JZ QUASI BOMB IS BEFORE YOU.  BEING THE EXPERT THAT YOU ARE, YOU"
10015 PRINT:PRINT"YOU ARE AN EXPERT ON THE BOMB SQUAD. YOUR CHIEF ENEMY IS MR. XX,A VERY NASTY BOMB-MAKER.  HE HAS DESIGNED A TOUGH JOB FOR YOU.  IT'S A CYBERNETIC, SUB-ATOMIC, MARK IV, MX-73JZ, QUASI BOMB-----    THE WORST KIND KNOWN TO MAN."
10020 'PRINT"IMMEDIATELY GET THROUGH THE OUTER CASING AND INTO THE MASS OF   WIRES THAT CONFRONT YOU."
10025 PRINT:PRINT"     BEING THE EXPERT THAT YOU ARE, YOU QUICKLY DISMANTLE THE   CASING AND GET TO THE INSIDE OF THE BOMB.  oUT OF THE MANY,MANY,WIRES THAT CONFRONT YOU, YOU NOTICE THIRTY-FIVE THAT DEAL WITH  BOMB DETONATION. THREE TO FIVE OF THESE WIRES";
10030 'PRINT:PRINT:PRINT"    OUT OF THE MANY, MANY WIRES, YOU SEE THAT TEN DEAL WITH     SETTING OFF THE BOMB.  CERTAIN OF THESE WIRES MUST BE CUT AND   IN THE PROPER ORDER  FOR THE BOMB TO BE DISMANTLED.  YOU WILL   BE GIVEN THE WIRES AND";
10035 PRINT" MUST BE CUT, AND  IN THE PROPER ORDER; OTHERWISE,  B O O M!"
10040 'PRINT" THE ORDER IN WHICH THEY MUST BE CUT."
10050 PRINT@980,"PRESS <ENTER>";
10055 IF INKEY$=""THEN10055 ELSE GOTO 10060
10060 CLS:PRINT"     THE NUMBER OF WIRES, THEIR ORDER, AND THEIR COLOR ARE GIVENTO YOU ON THE SCREEN.  THE RATE AT WHICH THEY ARE SHOWN         INCREASES AS YOU SUCCESSFULLY DISMANTLE BOMBS, AND IS SET BACK  TO ITS ORIGINAL VALUE IF YOU SHOULD GET BLOWN UP."
10065 PRINT"     ONE WORD OF CAUTION:  DO NOT MISSPELL THE WIRE COLORS; THATIS LIKE CUTTING THE WRONG WIRE.  aLSO, DO NOT TAKE FOREVER TO   DECIDE WHAT WIRE TO CUT--THE BOMB IS TICKING AWAY, YOU KNOW."
10070 PRINT:PRINT:PRINT:PRINT:PRINT"                   G O O D   L U C K !!"
10080 PRINT@916,"PRESS <ENTER>"
10085 IF INKEY$="" THEN 10085 ELSE 11000
11000 'THE START OF THE BOMB PROGRAM
11005 NW=INT(SQR(RND(11)))+2
11007 CLS
11010 PRINT"THIS TIME, YOU MUST CUT (IN THEIR PROPER ORDER!)"; NW;"WIRES."
11020 GOSUB 40000
11023 FOR CO=1 TO 450:NEXT CO
11025 PRINT"HERE ARE THE WIRES IN THE CORRECT ORDER.             ";SP
11030 FOR X=32 TO 97:SET(X,20):SET(X,30):NEXT X
11040 FOR Y=20 TO 30:SET(32,Y):SET(97,Y):NEXT Y
11060 UL=500+RND(500):FOR CO=1 TO UL:NEXT CO
11065 FOR I=1 TO NW
11070 PRINT@540," ";W$(I);"         ";:FOR W1=1TOSP:NEXT W1
11075 NEXT I
11080 CLS
11100      PRINT"STEADY NOW---THE FIRST WIRE IS ? ";:GOSUB 30000:A$=M$:GOSUB 31000
11110      IF A$<>W$(1) THEN 20000
11120      PRINT:PRINT:PRINT"THE BOMB HAS NOW STOPPED TICKING.  (THIS DOES NOT MEAN THAT YOU CAN TAKE AS MUCH TIME AS YOU WANT) VERY GOOD, SO FAR.   NOW------";
11130      PRINT"DON'T BE NERVOUS---THE SECOND WIRE IS? ";:GOSUB 30000:B$=M$:GOSUB31000
11135      IF B$<>W$(2) THEN 20000
11140      PRINT:PRINT:PRINT"TREMENDOUS!   i'M REAL PROUD OF YOU.  KEEP UP THE GOOD WORK AND DON'T GET YOUR HEAD BLOWN OFF."
11150       PRINT"AND THE THIRD WIRE IS? ";:GOSUB 30000:C$=M$:GOSUB 31000
11155      IF C$<>W$(3) THEN 20000
11157 IF NW=3 THEN 25000
11160      PRINT:PRINT:PRINT" YOU'RE  S O  CLOSE--DON'T BLOW IT NOW!"
11170      PRINT"YOU'RE ON THE FOURTH WIRE---AND STILL LIVING. EXCELLENT!!  WHAT WIRE IS NEXT? ";:GOSUB 30000:D$=M$:GOSUB 31000
11175      IF D$<>W$(4) THEN 20000
11177 IF NW=4 THEN 25000
11180     PRINT:PRINT:PRINT"YOU'RE DOING GREAT!!  BUT IF YOU BLOW YOURSELF UP ON THIS LAST WIRE, I'LL NEVER SPEAK TO YOU AGAIN."
11190     PRINT"CAREFUL!  THE FINAL WIRE IS? ";:GOSUB 30000:E$=M$:GOSUB 31000
11195     IF E$<>W$(5) THEN 20000
12000     GOTO 25000
20000 PRINT:PRINT:PRINT"                 B  O  O  M  ! ! ! ! ! ! ! !":FOR X=1 TO 80:PRINTCHR$(23);:PRINTCHR$(28);:NEXT X
20010 FOR SS=1 TO 200:NEXTSS:CLS
20020 PRINT:PRINT"NEEDLESS TO SAY, YOU BLEW IT.":PRINT:PRINT"           THE PROPER SEQUENCE WAS":FOR C=1TONW:PRINTW$(C):NEXT C
20023 PRINT:PRINT"YOUR SCORE ---   ";TN:IF TN>HS THEN PRINT"YOU HAVE SET A NEW RECORD!":GOSUB 32000:PRINT ELSE PRINT"HIGH SCORE IS";HS;" BY ";IN$:TN=0:PRINT
20025 PRINT"     YOU HAVE BLOWN YOURSELF UP SO GOOD IT'S A MIRACLE THAT I   COULD FIND THIS MANY PIECES OF YOU. IF YOU LIKE, I CAN BRING    YOU BACK TO LIFE SO YOU MAY TRY AGAIN.";
20030 INPUT"   SHALL I DO THIS";R$
20040 IF R$="NO" THEN RUN 
20050 SP=500:GOTO 11005
25000 CLS:PRINT:PRINT:PRINT"CONGRATULATIONS!!": PRINT:PRINT"  YOU HAVE SUCCESSFULLY DISMANTLED THE BOMB.  yOU ARE TO BE     PRAISED-- A VERY GOOD JOB, INDEED.  hOWEVER, THE BOMB-MAKER     SAYS,  'JUST WAIT TILL NEXT TIME!'"
25005 PRINT:PRINT"              SCORE (WIRES CUT SO FAR)"
25007 TN=NW+TN:PRINT:PRINT,"       "TN
25010 PRINT@960,"";:INPUT"SPEAKING OF NEXT TIME, WOULD YOU LIKE TO PLAY AGAIN";H$
25020 IF H$="NO" THEN CLS:END
25030 SP=INT(.75*SP+.5)
25040 GOTO 11005
29000 END
29999 'INPUT N
30000 T=0:M$=""
30010 A$=INKEY$:PRINTA$;:T=T+1:IFT>SP+25 THEN 20000 ELSEIF A$=""THEN 30010ELSEIFA$=CHR$(13)THENPRINTT:RETURN ELSEM$=M$+A$:GOTO 30010
31000 UL=RND(750)+250:FORF=1TOUL:NEXTF:RETURN
