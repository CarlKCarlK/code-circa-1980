10 A=1
20 DIMF%(20)
30 DIMA%(30)
40 MX=64:MY=13
50 LINE(0,6)-(12,11),SET,BF:LINE(3,11)-(9,14),SET,BF:LINE(2,0)-(10,4),SET,BF:LINE(10,8)-(10,11),RESET:LINE(2,8)-(2,11),RESET:LINE(6,11)-(6,14),RESET:LINE(3,5)-(9,5),SET
60 RESET(11,11):RESET(1,11):LINE(0,1)-(12,1),SET
70 GET@(0,0)-(13,13),G,A%
80 GET@(0,0)-(13,6),G,F%
90 CLS
100 PUT@(MX,MY)-(13+MX,MY+13),SET,A%
110 PUT@(MX,MY)-(13+MX,MY+6),SET,F%
120 LINE(5+FX+MX,4+FY+MY)-(7+FX+MX,4+FY+MY),RESET:RESET(4+FX+MX,2+FY+MY):RESET(8+FX+MX,2+FY+MY)
130 IFA=-1THENLINE(MX,6+MY)-(MX,11+MY),RESET:LINE(1+MX,6+MY)-(MX+1,10+MY),RESET:LINE(MX-8,MY+6)-(MX+1,MY+6),SET
140 A$=INKEY$:IFA$=","THENFX=FX-1ELSEIFA$="."THENFX=FX+1ELSEIFA$="A"THENFY=FY+1ELSEIFA$="Q"THENFY=FY-1ELSEIFA$=" "THENA=-A:LINE(MX-8,MY+6)-(MX+1,MY+6),RESET:PUT@(MX,MY)-(13+MX,13+MY),SET,A%ELSE 140  
150 GOTO110  
160 GOTO150  
170 PRINT@400,""
180 GOTO180  
190 CLS
200 PRINT@512,"PRESS A NUMBER TO ROLL";
210 A$=INKEY$:IFA$=""THEN210  ELSEN=VAL(A$)
220 CLS
230 N=VAL(N$)
240 FORI=1TO2
250 RANDOM
260 R(I)=RND(6)+N
270 IFR(I)>6THENR(I)=R(I)-6:GOTO270  
280 NEXT
290 FORI=1TO2
300 IFI=1THENX=0:Y=0ELSEX=25:Y=0
310 LINE(X,Y)-(X+21,Y+9),SET,B
320 READN
330 IFN<>-R(I)THEN320  
340 FORK=1TOR(I)
350 READXX,YY
360 GOSUB410  
370 NEXT
380 RESTORE
390 NEXT
