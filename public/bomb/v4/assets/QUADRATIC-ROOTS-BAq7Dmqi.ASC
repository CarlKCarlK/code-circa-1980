0 GOTO 1990 
10 FOR G=-100TO100 STEP 10
30 X=G:GOSUB1000
40 IF Y1=0 THEN CLS:GOTO100 ELSE G=OG-Y/Y1
50 IF OG=G THEN PRINT:PRINT"****** " G"*******":GOTO 100
60 OG=G:PRINTG;:GOTO30
100 NEXT G:PRINT "DONE":END
500 CLS
505 FOR X=1 TO 125:NEXT X
510 PRINT:PRINT:PRINT:PRINT "                 *******************":PRINT:PRINT:PRINT"             I DID IT, CARL------RICH L.":PRINT:PRINT:PRINT:PRINT"                ********************"
515 FOR X=1 TO 500:NEXT X
520 GOTO 500
998 '
999 '
1000 Y=X[2+3*X+2
1010 Y1=2*X+3
1020 RETURN
1990 CLS
1995 PRINT "     THIS PROGRAM WILL TELL YOU THE ROOTS OF ANY"
1996 PRINT"STANDARD QUADRATIC EQUATION (AX[2+BX+C). YOU TYPE IN "
1997 PRINT"A,B,C.  THANK YOU FOR GIVING ME SOMETHING TO DO!"" 
2000 INPUT A,B,C
2005 IF A=0 THEN PRINT "A CANNOT EQUAL ZERO IN A QUADRATIC EQUATION. PLEASE RE-ENTER": GOTO 2000
2010 UR=B[2-4*A*C
2020 IF UR<0 GOSUB 7000:GOTO2000
2030 IF INT(UR)=0 GOTO 2075
2050 R=(-B+SQR(B[2-4*A*C))/(2*A)
2060 R2=(-B-SQR(B[2-4*A*C))/(2*A)
2065 PRINT"THESE ARE THE ROOTS":PRINT:GOSUB 5000
2070 GOTO 2000
2075 PRINT"THERE IS ONLY ONE ROOT.  IT IS ";
2077 R=-B/(2*A)
2080 IF ABS(R-INT(R))>.005 THEN PRINT R ELSE PRINT INT(R+.5)
2086 GOTO 2000
5000 IF ABS(R-INT(R))>.005 THEN PRINT R, ELSE PRINT INT(R+.5),
5010 IF ABS(R2-INT(R2))>.005 THEN PRINT R2 ELSE PRINT INT (R2+.5)
5020 RETURN
7000 PRINT"     THE QUADRATIC THAT YOU GAVE ME HAS NO REAL ROOTS."
7010 PRINT"IT DOES, HOWEVER, HAVE";
7015 IF B<>0 THEN 7100
7020 PRINT" ONE IMAGINARY ROOT AND IT IS  ";
7030 A=SQR(4*A*C)/(2*A):PRINT A;"I"
7040 RETURN
7100 PRINT" TWO IMAGINARY ROOTS AND THEY ARE":PRINT
7110 IP=SQR(-B[2+4*A*C)
7120 PRINT-B/(2*A)"+"IP/2/A"i",-B/2/A"-"IP/2/A"i"
7130 RETURN
