1 POKE16553,255
2 F=-1
5 RESTORE
10 DIM I(2,40)
90 B$=INKEY$:IFB$=""THEN90
100 A$=INKEY$:IFA$=""THEN100
130 IFA$="1"THENC=0:IFB$="."THENC=C+100
140 IFA$="2"THENC=10:IFB$="."THENC=C+100
150 IFA$="3"THENC=11:IFB$="."THENC=111
160 IFA$="4"THENC=1:IFB$="."THENC=101
170 F=F+1:IFF>2THENF=0:S=S+1
175 IFB$="D"ANDA$<>"A"THEN300
180 IFF=2AND(C=0ORC>50)THEN170
190 I(F,S)=C
195 PRINTF;S;" "C
200 GOTO90
300 S=-1
310 S=S+1
320 T$=STR$(I(2,S)*100+INT(I(1,S)/10))
330 S$=STR$(VAL(RIGHT$(STR$(I(1,S)),1))*1000+I(0,S))
336 RESTORE
340 READG:READG$:IFVAL(T$)=GTHENPRINTG$;ELSE340
345 RESTORE
350 READG:READG$:IFVAL(S$)=GTHENPRINTG$,:RESTORE ELSE350
370 RESTORE
380 IFVAL(T$)=0ANDVAL(S$)=0THENZ=Z+1ELSEZ=0
390 IFZ>5THENSTOP
400 GOTO310
