5 CLS
6 G=100:H=50
10 PI=3.14159
20 A=0
30 A$=INKEY$
40 IF A$=""THEN41ELSEIFA$="1"THENAF=-1ELSE IF A$="3"THEN AF=1ELSEAF=0
41 '
50 A=A+AF/4
58 LINE(X1+64,Y1+24)-(64-X1,24-Y1),RESET
60 X=COS(A)*G:Y=SIN(A)*H:LINE(X+64,Y+24)-(64-X,24-Y),SET
62 X1=X:Y1=Y:LINE(X2+64,Y2+24)-(64-X2,24-Y2),RESET
65 X=COS(A+PI/2)*G:Y=SIN(A+PI/2)*H:LINE(X+64,Y+24)-(64-X,24-Y),SET
67 X2=X:Y2=Y
70 GOTO30
