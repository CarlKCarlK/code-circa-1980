1 '
10 CLS
100 INPUT"WHAT ORDER (N,M)";N,D
110 DIMA(N,D+1)
120 FORX=1TON:FORY=1TOD
130 PRINT"WHAT IS A("X","Y")    ('F' TO FIX MISTAKE)";:INPUTA$:IFA$="H"THEN4000ELSEA(X,Y)=VAL(A$)
140 NEXT
160 NEXT
170 FORR=1TOD
180 GOSUB3000:PRINT
200  INPUT"YOUR COMMAND  (  R1<>R2 ,  R2=3R1-2R2, R3=3R3)
";C$
210 IF MID$(C$,3,1)<> "<" THEN 300
220 FR= VAL(MID$(C$,2 )):LR=VAL(RIGHT$(C$,1))
230 FOR I=1TOM:T=A(FR,I):A(FR,I)=A(LR,I):A(LR,I)=T:NEXTI
240 GOSUB 3000:PRINT:GOTO200
300 FR=VAL(MID$(C$,3,1)):C$=MID$(C$,4):C1=VAL(C$):IFC1=0THENC1=1
310 IF LEN(C$)=0 THEN LR=MR:LC=0:GOTO 400 ELSE IF LEFT$(C$,1)<>"+" AND LEFT$(C$,1)<>"-"THENC$=MID$(C$,2):GOTO310
320 LC=VAL(C$)
330 'REDUCE PAST R
700 RUN1
800 PRINT"ERROR":GOTO 200
1000 FORB=1TOD+1:A(RX,B)=A(RX,B)*F:NEXT:RETURN
2000 FORB=1TOD+1:A(W,B)=A(W,B)+A(R,B):NEXT:RETURN
3000 FORX=1TON:FORY=1TOD:PRINTA(X,Y);:NEXT:PRINT:NEXT:RETURN
4000 INPUT"LOC. I,J AND CORRECT VALUE 'A'";G,H,J:A(G,H)=J:GOTO130
