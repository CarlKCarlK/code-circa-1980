0 GOTO 10
1 S(1)=S(1)+2D-16
2 PRINTS(1),
3 GOTO 1
10 DEFDBL A-H,J-Z
20 FOR I=1TO2:READ C(I),CM(I),CP(I):NEXTI
30 FOR I=1TO2
40 M(I)=CM(I)-C(I)
50 S(I)=CP(I)-CM(I)
60 SW=32.06
70 SM(I)=S(I)/SW
80 MG(I)=M(I)/SM(I)
90 NEXT I
100 PRINTM(1);M(2):PRINTS(1);S(2):PRINTMG(1);MG(2)
105 PRINT:PRINT
110 FOR I=1TO5
120 PRINTI/2*MG(1);I/2*MG(2),"+";I
130 NEXTI
998 '
999 'DATA 19.4011,21.1320,20.3313,20.2821,21.0454,21.2685
1000 DATA 20.2392,21.5864,21.8866,21.5958,23.3098,23.6743
