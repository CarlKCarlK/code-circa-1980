10 'TRIGECTIOR           BY CARL KADIE   OCT. 24, 1978 A.D.
100 CLS:INPUT"SPEED (METERS/SECOND)";V
110 INPUT"ANGLE (DEG. FROM HORIZON)";A
120 CLS:A=A*.0174533:T=0
130 T=T+.025
150 HS=T*V
160 XS=COS(A)*HS
170 YS=SIN(A)*HS
180 Y=YS-4.9*T*T
190 X=XS
200 IFY<0THEN200
202 IFY>=48THENY=Y-48
204 IFX=>64THENX=X-64
210 IFX<=63 AND 47-Y>=0 AND 47-Y<=47SET(X*2,47-Y):IFX<63THENSET(X*2+1,47-Y)
220 GOTO130
