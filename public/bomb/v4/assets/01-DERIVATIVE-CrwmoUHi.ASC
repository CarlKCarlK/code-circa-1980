10 CLEAR 150:CLS
20 PRINT:PRINT"THIS FINDS THE DERIVATIVE OF A FUNCTION OF THE FORM : "
25 PRINT
30 PRINT"        3X[4+ 0X[3 +2X[2+ -6X[1 +5X[0
40 PRINT"F(X)=  -------------------------------------"
50 PRINT"      6X[3+ -8X[2 + 0X[2+ 1X[1 +4X[0
60 PRINT
70 INPUT"WHAT IS THE HIGHEST POWER OF THE VARIABLE IN THE TOP";NP
80 INPUT"WHAT IS THE HIGHEST POWER OF THE VARIABLE IN THE BOTTON";DP
90 PRINT
100 PRINT@448,STRING$(128," ")
110 PRINT@448,"FIRST THE TOP....":FORXX=1TO400:NEXTXX
120 FOR P=NPTO0 STEP -1
125 PRINT@512,STRING$(64," ")
130 PRINT@512,"WHAT IS THE COEFFICENT ON THE X["P" TERM ";
140 INPUT N(P)
150 NEXT P
160 PRINT@448,"NOW THE BOTTON....":FORXX=1TO400:NEXTXX
170 FOR P=DP TO 0 STEP -1
180 PRINT@512,STRING$(64," ")
190 PRINT@512,"WHAT IS THE COEFFCENT ON THE X["P" TERM";
200 INPUT D(P)
210 NEXTP
220 CLS:PRINT
230 PRINT"     ";
240 FOR P=NPTO0 STEP-1
245 IF P=0 AND N(P)=0 THEN PRINTSTRING$(3,CHR$(24));"   ":GOTO280
250 IF N(P)=0 THEN 280
255 IF P=0 THEN PRINTN(P):GOTO280
260 PRINTN(P)"X["P" + ";
280 NEXT P
290 PRINT"F(X)= ";STRING$((NP+1)*11,"-")
300 PRINT"     ";
310 FOR P=DP TO 0 STEP -1
320 IF P=0 AND N(P)=0 THEN PRINTSTRING$(3,CHR$(24));"   ":GOTO 350
330 IF D(P)=0 THEN 250
335 IF P=0 THEN PRINTD(P):GOTO 350
340 PRINTD(P)"X["P" + ";
350 NEXT P
360 PRINT
365 A$="-"+CHR$(94)
370  PRINT"              F(X+H) + F(X)"
380 PRINT"F'(X)=  LIM  ---------------"
390 PRINT"       X"A$"0        H"
400 PRINT
