5 S=1
10 INPUT"HOW MANY SOUCES";N
20 FORI=1TON
30 INPUT"X OF SOUCE";X(I)
40 INPUT"RELITIVE MASS OF SAME";M(I)
50 NEXT
60 CLS
70 X=X+1:IFX>127THEN500
75 A=0
80 FORI=1TON
85 IFX=X(I)THENA=2:GOTO100
90 A=A+(M(I)/(X-X(I))[2)*SGN(X-X(I))
100 NEXT
105 Y=ABS(A)*500
106 IFY>47THEN120
110 FORYY=YTO47:SET(X,YY):NEXT
120 GOTO70
500 GOTO500
