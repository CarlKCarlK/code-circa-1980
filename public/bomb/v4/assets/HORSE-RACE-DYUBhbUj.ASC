10 CLEAR1000:'                    HORSE RACE i
20 CLS
30 H$(1)=CHR$(156)+CHR$(173)+CHR$(131)
40 H$(2)=CHR$(152)+CHR$(142)+CHR$(158)+CHR$(131)
60 H$(3)=CHR$(131)+CHR$(158)+CHR$(172)
70 H$(4)=CHR$(131)+CHR$(173)+CHR$(141)+CHR$(164)
160 PRINT"WELCOME TO INTERRUPT DOWNS, THE TRACK WHERE"
170 PRINT"YOU CAN WIN BIG MONEY"
180 PRINT:PRINT"HOW MANY HORSES ARE IN THE RACE";:INPUTN
190 IFN>7THENPRINT"SORRY TRACK ONLY HOLDS SEVEN (7)":GOTO180
200 IFN<3THENPRINT"SORRY MUST HAVE AT LEAST THREE (3)":GOTO180
210 PRINT"TYPE THE HORSES NAMES"
220 FORI=1TON:INPUTA$(I):S(I)=1:T(I)=0:D(I)=5:O(I)=35:NEXT
230 PRINT:PRINT"YOUR ENTRIES HAVE BEEN EVALUATED.  HERE ARE THE ODDS"
240 A=2*N
250 FORI=1TON:Q(I)=INT(A*RND(0))+2
260 PRINTA$(I);TAB(10)"--------";TAB(25) Q(I);" TO 1"
270 NEXT:PRINT
280 PRINT"HOW MANY BETS DO YOU WISH TO PLACE";:INPUTM:PRINT
285 IFABS(M-(N+1)/2)>(N-1)/2THEN280
289 GOTO300
290 GOSUB750
300 CLS
310 FORI=1TON:PRINT@I*64*2-64,A$(I);:NEXT
360 PRINT@0,"                     AND THEY'RE OFF!!!";
365 FORI=0TO15:PRINT@I*64+4,CHR$(149);:NEXT
370 FORI=1TON:D(I)=D(I)+S(I)*(3+3/Q(I)-1.5*RND(0))
380 IFD(I)>55THENS(I)=-1:T(I)=2
390 IFD(I)<3THEN800
400 PRINT@O(I)+64*I*2,"     ";:PRINT@64*2*I+D(I),H$(RND(2)+T(I));:O(I)=D(I):NEXT
410 GOTO370
430 FORI=1TON
435 IFA(I)=1THENW1$=A$(I):W1=2*Q(I):P1=1.1*Q(1):S1=.75
440 IFA(I)=2THENW2$=A$(I):P2=1.1*Q(I):S2=.75*Q(I)
445 IFA(I)=3THENW3$=A$(I):S3=.75*Q(I)
450 NEXTI
460 PRINT@0,"                       PRESS 'ENTER' FOR RESULTS";
465 IFINKEY$=""THEN465ELSECLS:PRINT:PRINT:PRINT"                            HERE ARE THE RESULTS"
470 PRINT:PRINT:PRINT"HORSE";TAB(20)"WIN";TAB(30)"PLACE";TAB(40)"SHOW"
475 PRINTW1$;TAB(20)W1;TAB(30)P1;TAB(40)S1
480 PRINTW2$;TAB(30)P2;TAB(40)S2
485 PRINTW3$;TAB(40)S3:PRINT
800 FORI=1TON:D(I)=64-D(I):NEXT
810 FORI=1TON
825 P=1
830 FORK=1TON
835 IFD(I)<D(K)THENP=P+1
850 NEXTK
852 A(I)=P
860 NEXTI
870 GOTO430
20000 FORX=121TO191:PRINTX;CHR$(X),,,:NEXT:GOTO20000
