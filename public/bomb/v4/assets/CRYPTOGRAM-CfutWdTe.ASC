5 CLEAR 5000:CLS:J9=9
7 DIM E(26),F(26):READ C$:FORI=1TO26:E(I)=ASC( MID$(C$,I,1) )-64 :F(I)=E(I):NEXT I
10 READ C$
15 DIM C(26),D(26)
20 FOR T=ASC("A") TO ASC("Z")
25 Z$=" "+CHR$(T)+" "
30 FOR I=1TOLEN(C$)
40 IF MID$(C$,I,1)=CHR$(T) THEN C(T-64)=C(T-64)+1
45 PRINT@I,MID$(C$,I,1);Z$;
50 NEXT I
65 D(T-64)=T-64:PRINTC(T-64);
70 NEXT T
80 CLS
90 PRINT"SORTING"
100 FOR I=1TO 26
110 FOR P=ITO26
120 IF C(I)< C(P) THEN H=C(P):C(P)=C(I):C(I)=H:H=D(P):D(P)=D(I):D(I)=H
130 NEXT P,I
140 FOR I=1TO26:C(I)=0:NEXTI
150 D$="":FOR I=1 TOLEN(C$)
160 CLS:FOR P=1TO26:IF MID$(C$,I,1) <> CHR$( D(P) +64) THEN NEXT P:D$=D$+MID$(C$,I,1):GOTO 200
170 IF C(P) >99 THEN D$=D$+CHR$( C(P)/100+64 ):GOTO200
180 D$=D$+ CHR$(  E(P + C(P) )+64 )
200 PRINT@0,D$;:NEXTI
210 IF J9=9 THEN C$=D$:J9=0:FORI=1TO26:D(I)=E(I):NEXTI
300 PRINT:INPUT "COMMAND ";H$
310 IF H$="HELP"THEN CLS:PRINT"YOU MAY  'FIX', 'UNFIX', 'LIST', 'LPRINT'  OR 'HELP'":PRINT:PRINT:INPUT"PRESS ENTER";H$:GOTO150
320 IF H$<>"FIX" THEN 400
330 PRINT:INPUT" TURN ALL THE A'S INTO B'S. GIVE ME A & B ";A$,B$
340 FOR I = 1 TO 26: IF C(I)>99 THEN E$=CHR$( C(I)/100+64) ELSE E$=CHR$(E(I+C(I))+64)
350 IF E$<>A$ THEN NEXT I:GOTO 300
360 C(I)=(ASC(B$)-64)*100
370 C=0:FOR J=1TO26:IF J=I THEN C=C-1
380 IF C(J)<99 THEN C(J)=C(J)+C: IF CHR$( E(J+C(J))+64) = B$ THEN C=C+1
385 NEXT J
390 GOTO 150
400 IF H$="LPRINT"THEN LPRINT D$:GOTO 300
410 IF H$<>"UNFIX"THEN 500
420 PRINT:PRINT:INPUT"WHAT DO YOU WHAT UNFIXED ";B$
430 FOR I=1TO26:IF C(I)=(ASC(B$)-64)/100 THEN NEXT I
440 FOR J=1TO26 :IF B$<>CHR$( D(J) +64 ) THEN
990 DATA "EAOIDHNRSTUYCFGLMWBKPQXZJV"
994 DATA"TESTER"
995 DATA"CARL RAN AS FAST AS HE COULD BUT IT WAS NO USE!"
1000 DATA "KP UPRK ULW, LFXLYDLWAL DR QDVL KML RKLYW QDBMKR PT J RMDX, EMDAM DQQGUDWL PWQC KML KYJAVR DK MJR XJRRLN"
10000 FOR I=1TO26:PRINTD(I),E(I),C(I)
10010 IF I/5=INT(1/5) THENPRINT"D","E","C"
10020 NEXTI
