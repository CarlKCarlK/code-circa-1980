10 'TEACH III            BY      CARL KADIE    OCT. 21,1978
110 DIMM(36):POKE16553,255:FORX=1TO33:M(X)=X:NEXT:CLS
200 Q=Q+1:RESTORE:PRINT:PRINT:FORX=1TOM(Q)*2-1:READQ$:IFQ$="@"ORM(Q=0)THEN1000ELSENEXT:PRINT"QUESTION #";Q:PRINTQ$;:INPUTAH$:READAC$:IFAH$=AC$THENPRINT"VERY GOOD, THAT WAS CORRECT":C=C+1:GOTO230
210 PRINT"I'M SORRY, THAT IS NOT THE CORRECT ANSWER, THE RIGHT ANSWER IS : ":PRINTAC$:I=I+1:M(I)=Q
230 C$=INKEY$:IFC$=""THEN230ELSECLS:GOTO200
1000 PE=C*100/(Q-1):PRINT"THAT'S ALL OF THIS QUIZ, BUT OUT OF"Q-1"QUESTIONS YOU GOT"C"RIGHT OR ";:PRINTUSING"##";PE;:PRINT"% CORRECT OF THE TOTAL. IF YOU WERE TAKING THIS AT SCHOOL, YOUR GRADE WOULD BE: ";
1010 IFPE>92THENPRINT"A";ELSEIFPE>84THENPRINT"B";ELSEIFPE>72THENPRINT"C";ELSEIFPE>69THENPRINT"D";ELSEPRINT"F";
1020 PRINT:INPUT"DO YOU WANT TO TRY AGIAN";G$:IFG$<>"NO"THEN M(I+1)=0:I=0:Q=0:C=0:CLS:GOTO200
10000 'PLACE DATA HERE
