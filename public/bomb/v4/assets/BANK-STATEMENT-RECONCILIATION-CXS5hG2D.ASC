2 INPUT"CODE";C$:IF C$<>"558"THENNEW:'RUN			RUNMAKE SURE
5 CLS
7 CLEAR 400
10 REM CHECK THAT DATES INCREASE AND THAT ALL SYMBOLS ARE LEGAL        AND THAT -X SYMBOLS ONLY HAVE - IN NUMBER AND THAT EBS
        RECONCILE
20 DATA   "+I",-I,+P,-M,-R,+S,-C,EB
30 DATA INTEREST,BANK CHARGES,PAY,MISC. WITHDRAW,RENT,STARTING DEPOSIT,CASH WITHDRAW,ENDING BALANCE
32 DIM M(12):M(8)=31:M(9)=30:M(10)=31:M(11)=30:M(12)=31
34 FOR M=1TO12:M(M)=M(M)+M(M-1):NEXTM
40 FOR I=1TO8:READ C1IST$(I):NEXTI:FORI=1TO8:READ C2IST$(I):NEXTI
50 PRINT"WHAT DO YOU WANT:  STMT   CHRT  NONE
60 INPUT A$
90  PDATE=0:PAMOUNT=0
100 READ DATE,CODE$,AMOUNT
110 IF DATE = 0 AND CODE$ ="0" AND AMOUNT =0 THEN 500
120 IF DATE<PDATE THEN E$="DATES OUT OF ORDER":GOSUB 300
125 IF LEN(CODE$)<>2 THEN E$="CODE IS WRONG LENGTH":GOSUB 300
130 FOR CODE=1TO 8:IF CODE$<>C1IST$(CODE)THENNEXT CODE:E$="ILLEGAL CODE":GOSUB 300
140 IF LEFT$(CODE$,1)="-" AND AMOUNT>0 THEN E$="NEGITIVE CODE, POSITIVE AMOUNT":GOSUB 300 ELSE IF AMOUNT<0 THEN E$="NON-NEGITIVE CODE,NEGITIVE BALANCE"
150 IF CODE$<>"EB"THEN B=B+AMOUNT ELSE IF ABS(AMOUNT-B )>.005THEN E$="RECONCILE "+STR$(AMOUNT)+" <> "+STR$(B):GOSUB 300
170 IFA$="STMT"THENPRINTDATE; TAB(7);CODE$" "C2IST$(CODE);TAB(30);AMOUNT,B
180 IF A$<>"CHRT"THEN 280
185 DATE$=STR$(DATE)
190 X= M( VAL(LEFT$(RIGHT$(DATE$,4),2)))+VAL(RIGHT$(DATE$,2))
200 Y=47-(B-750)/40
205 IF OY<>0 AND OY<>Y THEN FOR YI=OY TO Y STEP SGN(Y-OY):SET(OX*.666,YI):NEXT YI
210 IF PDATE<DATE THEN FOR XI=OXTOX:SET(XI*.666,Y):NEXTXIELSESET(X*.666,Y)
220 OX=X:OY=Y
280 READ DATE,CODE$,AMOUNT
290 GOTO 110
300 PRINT"######### ERROR ------"E$
310 PRINTDATE,CODE$,AMOUNT
320 RETURN
500 PRINT"DONE";
510 IF A$="CHRT"THEN 510 ELSE STOP
