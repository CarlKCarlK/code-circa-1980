2 CLEAR 1000
10 CLS
20 U1$="  BEST TEAM ???  ":U2$="  SPEECH TEAM !!!"
30 PRINT CHR$(23);
35 FORY=1TO3
40 FOR X=1TOLEN(U1$):FORK=1TO100:NEXT:PRINT MID$(U1$,X,1),MID$(U2$,X,1):NEXTX
45 NEXTY
50 CLS:FORK=1TO100:R=RND(LEN(U1$)):PRINT@R+10,MID$(U1$,R,1);:NEXTK:PRINT@11,U1$
60 FORK=1TO100:R=RND(LEN(U1$)):PRINT@R+74,MID$(U2$,R,1);:NEXTK:PRINT@75,U2$
70 FORX=1TO500:NEXT
75 CLS
80 FOR XX=0TO15 STEP.2
85 K=K+1:IFK>LEN(U1$)THEN K=1
90 Y=SIN(XX)*20+32
100 PRINT STRING$(Y,MID$(U1$,K,1));" ";STRING$(62-Y,MID$(U2$,K,1))
110 NEXT XX
111 CLS
114 PRINT:PRINT"WELCOME, I'M SO GLAD YOU COULD RETURN!"
116 FORX=1TO1000:NEXT:PRINT"YOU REPRESENT THE GREATEST ENGLISH SPEECH MINDS IN THE WORLD."
118 FORX=1TO1500:NEXT:PRINT"NOW WE WILL AGAIN FIND WHO IS BEST COACH OF THE PLANET EARTH !!"
120 FORX=1TO2000:NEXT
130 PRINT@448,"HOW MANY COACHES (PLAYERS) WILL PARTICAPATE";
140 INPUT P
145 DIM T$(P,1),S(P,3),W(P,3)
150 CLS
160 PRINT@448,"NOW I WILL GO THOUGH ALL THE TEAMS PLEASE TELL ME THE SCHOOL    NAME AND COACHES NAME (MAKE'EM  UP IF YOU WISH!)"
165 FORX=1TO3000:NEXT
170 FOR I=1TO P
180 CLS
190 PRINT@448,"COACH #"I", WHAT IS YOUR NAME";
200 INPUT T$(I,0)
210 CLS:PRINT@448,"COACH "T$(I,0)", WHAT IS THE NAME OF YOUR SCHOOL";
220 INPUT T$(I,1)
230 NEXT I
240 CLS
250 FOR X=1 TO 3
255 EV$(X)=""
260 RESTORE
270 DATA"EXTEMPORANCE","DUET","HUMOROUS","DRAMATIC","RADIO",   "ORGINAL","VERSE","PROSE","ORITORICAL"
280 DATA"SPEAKING","ACTING","READING"
290 L=RND(3)
300 FORY=1TOL
310 RESTORE
320 R=RND(9)
330 FOR K=1TOR:READ TM$:NEXTK
340 EV$(X)=EV$(X)+" "+TM$
350 NEXT Y
360 RESTORE:R=RND(3):FORY=1TO9+R:READTM$:NEXTY
370 EV$(X)=EV$(X)+" "+TM$
380 NEXTX
385 IF EV$(1)=EV$(2) OR EV$(2)=EV$(3) OR EV$(3)=EV$(1) THEN 250
390 PRINT:PRINT:PRINT:PRINT:PRINT:PRINT"THE EVENTS ARE :"
400 FORX=1TO3:PRINT"  "EV$(X):NEXTX
410 PRINT:PRINT:PRINT
420 FORX=1TO3000:NEXTX
425 DIM Q(3,5)
430 FORX=1TO3
440 FORY=1TO5
450 Q(X,Y)=RND(0)
460 NEXT Y,X
470 CLS:PRINT:PRINT:PRINT:PRINT:PRINT:PRINT"NOW WILL GO THOUGH THE EVENTS ONE AT A TIME."
480 FORX=1TO1000:NEXT
490 FORX=1TO3
500 CLS:PRINT:PRINT:PRINT"EVENT:  "EV$(X)"      ":PRINT:PRINT
502 PRINT"QUILITY",,"IMPORTANCE"
504 PRINT"-------",,"-----------"
510 PRINT"EMPATHY           ",
520 Q=Q(X,1):GOSUB800
530 PRINT"VOCAL QUAILITY     ",
540 Q=Q(X,2):GOSUB800
550 PRINT"INTELLIGENCE       ",
560 Q=Q(X,3):GOSUB800
570 PRINT"LACK OF INHIBITION ",
580 Q=Q(X,4):GOSUB800
590 PRINT:PRINT"LUCK OF EVENT        ",
595 Q=Q(X,5):GOSUB800
605 A$=INKEY$:A$=INKEY$:A$=""
610 IFINKEY$=""THEN610
700 NEXT X:GOTO900
800 'REM 
810 IF Q>.9THENPRINT"NOTHING IS OF MORE IMPORTANCE":GOTO890
820 IF Q>.8THENPRINT"SUPER IMPORTANT":GOTO890
830 IF Q>.7THENPRINT"VERY IMPORTANT":GOTO890
840 IFQ>.6THENPRINT"IMPORTANT":GOTO890
850 IFQ>.5THENPRINT"OF SOME IMPORTANCE":GOTO890
860 IFQ>.4THENPRINT"MODERATLY NEEDED":GOTO890
870 IF Q>.3THENPRINT"ONLY A LITTLE HELPFUL":GOTO890
880 IF Q>.2THENPRINT"OF ALL MOST NO HELP":GOTO890
882 IF Q>.1THENPRINT"NO NEED":GOTO890
884 PRINT"NOTHING COULD BE MORE WORTHLESS"
890 RETURN
900 CLS:PRINT:PRINT:PRINT:PRINT"NOW EACH COACH IN TURN WILL HAVE TRYOUTS"
915 DIM TG(P,6,5),N$(P,6)
920 FORX=1TOP
925 S=0
930 FOR T=1TO6
940 FOR Q=1TO5
950 TG(X,T,Q)=RND(0)
960 S=S+TG(X,T,Q)
970 NEXTQ,T
980 F=12/S
990 FORT=1TO6:FORQ=1TO4
1000 TG(X,T,Q)=TG(X,T,Q)*F
1010 NEXT Q
1020 R=RND(13)+12:RESTORE:FORQ=1TOR:READN$:NEXTQ
1025 DATAKAREN,ERIC,PEGGY,JOHN,MARY,CARL,STEVE,DAN,JIM,JEAN,KEITH,KENTH,JULIE
1030 N$(X,T)=N$
1040 DATA"HUDDLE",STEWARD,PATTEN,GERKIN,WHITE,JORGANSEN,KADIE,ALLAR,LOAR,FINNEY,HEDGES,FREEBURN,BROSART
1050 R=RND(13)+25:RESTORE:FORQ=1TOR:READN$:NEXTQ
1060 N$(X,T)=N$(X,T)+" "+N$
1070 NEXTT,X
1075 FORX=1TOP
1080 CLS:LPRINT"COACH ";T$(X,0)" OF "T$(X,1)
1090 LPRINT:LPRINT"EMPATH VOC. SMART BOLD POTENCIAL"
1100 FORT=1TO6
1110 LPRINT N$(X,T)
1120 FORQ=1TO5:P(Q)=INT(TG(X,T,Q)*5+1)*5:NEXT
1130 FOR MN=1TO5:LPRINT P(MN);"  ";:NEXT MN:LPRINT
1140 NEXT T
1145 LPRINT"-----------------------------"
1150 NEXTX
1160 FORX=1TOP
1170 GOSUB3000
1200 NEXT X
1210 CLS
1220 PRINT:PRINT:PRINT:PRINT"THERE WILL BE THREE TOUNOMENTS, THEN THE DISTICT/STATE MEET."
1230 PRINT"YOU MUST DECIDE YOUR PRACTICE SCHEDULE EVERY WEEK BEFORE THE"
1240 PRINT"TOUNOMENT. YOU HAVE FIVE PRICTICE TIMES A WEEK."
1250 FORX=1TO8000:NEXT
1260 FOR W=1TO4
1270 FORX=1TOP
1280 CLS:PRINT
1290 PRINT"WEEKLY SCHEDULE FOR "T$(X,0)" OF "T$(X,1)"."
1292 INPUT"DO YOU WANT TO REARRANGE YOUR TEAM";A$:IFA$="NO"THEN1300ELSEGOSUB3000
1300 PRINT
1310 PRINT:PRINT"YOUR THREE STUDENTS ARE :"
1320 FOR T=1TO3:PRINTN$(X,Z(X,T))" IN "EV$(T):NEXT T
1330 PRINT
1340 FORD=1TO5
1350 FOR T=1TO3:FORQ=1TO4:TG(X,Z(X,T),Q)=TG(X,Z(X,T),Q)*(1-.06*RND(0)*(1-TG(X,Z(X,T),5))):NEXTQ,T
1360 PRINT@704,"WHICH ONE (# FROM TOP) WILL YOU PRACTICE WITH ON DAY #";D;:INPUTN
1370 IFN<0ORN>3THEN1360
1380 NEXT D,X
1390 CLS:PRINT:PRINT:PRINT"TOURNAMENT #"W" AT ";T$(RND(P),1)"."
1395 PRINT:PRINT:PRINT
1400 IFW=1THENPRINT"THIS IS THE FIRST TOURNAMENT, AND FIRST TEST OF YOUR TEAMS!"
1410 IFW=2THENPRINT"THIS IS THE SECOND WEEK OF CONTEST, IT'S NOT TO LATE FOR LAST   WEEKS LOSERS TO PROVE THEMSELVES WINNERS. GOOD LUCK!"
1420 IFW=3THENPRINT"THIS IS THIRD WEEK, AND THE LAST WEEK BEFORE DISTRICT/STATE."
1430 IF W=4THENPRINT"THE CLIMAX OF THE SEASON IS HERE.  THIS IS DISTRICT/STATE !!!"
1440 PRINT@960,"(PRESS ENTER TO START CONTEST)";
1450 IFINKEY$=""THEN1450
1460 FORE=1TO3
1470 CLS:PRINT:PRINTEV$(E):PRINT
1480 PRINT"ROOM"RND(499)
1490 PRINT:PRINT"THE JUDGE IS ";
1500 DATA"JOHN","BETTY","PALUA",DONNA,JERRY,CHUCK,ALLEN
1510 DATA"DAVIDSON",MCGLASSON,FREEBURN,KLEIN,ROLLENSKY,SHEPARD
1520 RESTORE:R=RND(7)+38:FORC=1TOR:READN$:NEXTC:PRINTN$;" ";
1530 RESTORE:R=RND(6)+45:FORC=1TOR:READN$:NEXTC:PRINTN$
1540 PRINT
1550 FORX=1TOP
1560 PRINTCHR$(X+64);") "N$(X,Z(X,E))
1570 S(X,E)=0
1580 FORQ=1TO4
1590 S(X,E)=S(X,E)+Q(E,Q)*(1+SGN(RND(2)-1.5)*.5*RND(0)*Q(E,5))*TG(X,Z(X,E),Q)
1600 NEXTQ,X
1610 PRINT@960,"PRESS 'ENTER' WHEN READY";
1620 IFINKEY$=""THEN1620
1630 NEXT E
1640 CLS:PRINT:PRINT:PRINT:PRINT"PLEASE GO TO AUDUTORIUM WILL WE TABLUATE THE RESULTS."
1650 FORE=1TO3
1660 FORPL=1TOP
1665 R=0
1670 FORX=1TOP
1680 IF S(X,E)>RTHEN R=S(X,E):S=X
1690 NEXT X
1700 W(PL,E)=S:S(S,E)=0
1710 NEXT PL
1712 NEXT E
1720 CLS:PRINT:PRINT:PRINT:PRINT"IF YOU WILL ALL BE SEATED I THINK WE'RE ALMOST READY START."
1730 FORI=1TO1000:NEXT
1735 FORX=1TOP:SS(X)=0:NEXTX
1740 FOR E=3TO1STEP-1
1745 RESTORE:FORI=1TO(4-E)+51:READN$:NEXT I
1750 CLS:PRINT:PRINT:PRINT"THE "N$" EVENT IS "EV$(E)"."
1752 PRINT
1755 FOR X=1TO2000:NEXT
1760 CD=INT(P/2+.5):IFCD>6THENCD=6
1770 FOR WN=CD TO 1STEP-1
1780 RESTORE:FORI=1TOWN+51:READN$:NEXTI
1790 PRINT"IN "N$" PLACE IS ...."
1800 DATA"FIRST",SECOND,THIRD,FORTH,FIFTH,SIXTH
1810  FORI=1TO1000:NEXT I
1820 PRINTN$( W(WN,E),Z(W(WN,E),E)) " FROM "T$( W(WN,E),1)" !!!!!"
1825 SS(W(WN,E))=SS(W(WN,E))+7-WN
1830 FOR I=1TO2000:NEXT I
1840 PRINT:PRINT:NEXT WN
1850 NEXT E
1860 FORI=1TO1500:NEXTI
1870 CLS:PRINT:PRINT:PRINT"AND NOW IT'S TIME THE SWEEPSTAKES."
1880 PRINT:PRINT
1900 FOR PL=1TO INT(P/2+.5)
1910 R=0
1920 FORX=1TOP
1930 IF SS(X)>RTHENR=SS(X):S=X
1940 NEXT X
1950 W(PL,0)=S:W(PL,1)=SS(S):SS(S)=0
1960 NEXT PL
1970 FOR PL=INT(P/2+.5) TO1STEP-1
1980 RESTORE:FORI=1TO PL+51:READ N$:NEXT I
1990 PRINT"IN "N$" PLACE WITH "W(PL,1)" POINTS ..."
2000 FORX=1TO1000:NEXTX
2010 PRINT"IS "T$(W(PL,0),1)" COACHED BY "T$(W(PL,0),0)"."
2020 PRINT
2025 FORX=1TO2000:NEXTX
2030 NEXT PL
2040 FORX=1TO500:NEXT
2050 NEXT W
2060 CLS:PRINT:PRINT:PRINT"WELL, THAT DOES IT!"
2070 FORX=1TO1000:NEXT
2080 PRINT:PRINT:PRINT"THE SEASONS OVER ...."
2090 FORX=1TO1000:NEXT
2100 PRINT:PRINT"NOW WE CAN TAKE A LONG REST."
2110 FORX=1TO2500:NEXT
2120 PRINT:PRINT:PRINT"OH, BY THE WAY,"
2130 FORX=1TO1000:NEXT
2150 PRINT"CONTEST PLAY REHERSAL STARTS TOMORROW !!!!"
2160 PRINT:FORX=1TO500:NEXT:PRINT"BYE-BYE":PRINT:END
3000 CLS:PRINT"COACH ";T$(X,0)" OF "T$(X,1):FORT=1TO3
3010 PRINT@832,"EVENT : ";EV$(T)"              "
3020 INPUT"WHO DO YOU WANT IN THIS EVENT (# FROM TOP OF 1ST LIST)";N
3030 IF N>6 OR N<1 THEN  3010
3040 Z(X,T)=N
3050 NEXT T
3055 CLS
3060 RETURN
