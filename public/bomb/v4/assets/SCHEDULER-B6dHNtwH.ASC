5 DEFINT  A-Z
10 CLS
20 PRINT"SCHEDULER"
30 N=0
40 DIM PT(40,40),L(40)
100  IF N<>0 THEN INPUT"SAME JOBS";A$:IFA$="N"  OR A$="NO"THEN200
110  JB=RND(20):JB=10
111  FOR JJ=1TOJB:FORII=1TOJB:PT(JJ,II)=0:NEXTII:PT(JJ,JJ)=1:NEXTJJ
120  FOR J=1TOJB:L(J)=1+RND(5)*(-LOG(RND(0))):NEXTJ
130  CN=RND(JB):CN=20
140  FOR C=1TOCN
150    LO=RND(JB):HI=RND(JB)
160  IF PT(HI,LO)=0 AND PT(LO,HI)=0 THEN ELSE 190
165 PT(LO,HI)=2:FORII=1TOJB:IFII=HI OR PT(II,LO)=0THEN 182
170  FOR JJ=1TOJB: IF PT(HI,JJ)<>0 AND PT(II,JJ)<=PT(HI,JJ) THEN PT(II,JJ)=PT(HI,JJ)+1
180 NEXT JJ
182 NEXT II
190 NEXT C
200 INPUT"NUMBER OF COMPUTERS (ENTER FOR SAME)";CM
210 GOSUB 1000
220 PRINT:INPUT"COMMAND (HELP AVAILABLE)";C$
230 IFC$="PERT" THEN GOSUB 1000ELSE  IFLEFT$(C$,3)="MAT" THEN GOSUB2000ELSEIF C$="RUN" THEN GOTO 100
260 GOTO220
1000 '  PERT CART
1005 PRINT:PRINT"PERT CHART":PRINT:PRINT"JOB/LENGTH","NEEDS (SIMPLE)":PRINT
1010 FOR LO=1TOJB:PRINT:IF L(LO)=0 THEN 1030ELSEPRINTLO"/"L(LO),:FORHI=1TOJB:IF PT(LO,HI)=2 AND L(HI)<>0 THEN PRINT"  "HI;
1020 NEXTHI
1030 NEXT LO
1040 RETURN
2000 PRINT"MATRIX":PRINT:FOR LO=1TOJB:PRINT:FORHI=1TOJB:PRINT  PT(LO,HI);"  ";:NEXTHI,LO
2010 RETURN
