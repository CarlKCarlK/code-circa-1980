1 CLS:INPUT"SPEED";S:S=S+1:S=S*10:FOR PO =1TO PP:S=S-1:CLS
2 CLS:FORE=0TO127:SET(E,0):SET(E,47):NEXT:FORE=0TO47:SET(0,E):SET(127,E):NEXT
4 Z2=1
5 A1=20:A2=30:B1=50:B2=60
6 GOTO18
7 POKE16553,255
10 FORC=1TOS:NEXT:A$=INKEY$:IFA$=""THEN25
18 IF(VAL(A$)>5)AND(VAL(A$)<10)THEN750
20 FORX=1TOVAL(A$):READZ,Y:NEXTX
25 A=A1:B=B1:GOSUB110
26 B1=B:A1=A:GOSUB150
28 GOTO10
30 IFPOINT(B1,A1)ORPOINT(B2,A2)THEN200 ELSESET(B1,A1):SET(B1+1,A1):SET(B2,A2):SET(B2+1,A2):RESTORE:RETURN
40 DATA0,-1,0,1,-1,0,1,0
100 REM
110 IFB>126 THEN B=0
120 IFB<0THENB=B+128
130 IFA>47THENA=A-48
140 IFA<0THENA=A+48
145 RETURN
150 B1=B1+Z*2:A1=A1+Y:A2=A2+Y2:B2=B2+Z2*2:GOTO30
200 PRINTCHR$(23):IFPOINT(B2,A2)THENPRINT"PLAYER ON THE RIGHT CHASHED":RS=RS+1ELSEPRINT"PLAYER ON THE LEFT CHASHED":LS=LS+1
205 PRINT"         SCORE":PRINTRS,LS
210 PRINT"DO YOU WANT PLAY AGIAN";:INPUTS$:IFS$="NO"THEN END 
220 CLS:RESTORE:GOTO 2
750 FORX=1TOVAL(A$)-5:READZ2,Y2:NEXTX
770 A=A2:B=B2:GOSUB110
780 B2=B:A2=A:GOSUB150
790 GOTO10
