10 PRINT "WHAT IS YOUR EARTH WEIGHT ?"
20 INPUT WE
25 GE=980
30 READ P$,G2
40 IF P$="DONE" THEN 200
50 W2=G2/GE*WE
55 W2=INT(W2+.5)
60 PRINT "YOUR WEIGHT ON " P$ " IS " W2 "."
70 GOTO 30
200 PRINT:PRINT "ALL DONE"
980 DATA EIDAK,-9999999
990 DATA NIZBOT,56987
1000 DATA SUN,27372,  MERCURY,358,  MOON,162,  PLUTO,221,       PSYCHE,13.6, DONE,0
