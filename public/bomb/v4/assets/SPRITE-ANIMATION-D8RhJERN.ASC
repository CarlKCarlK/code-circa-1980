170 IFA$=","THENFX=FX-1ELSEIFA$="."THENFX=FX+1ELSEIFA$="A"THENFY=FY+1ELSEIFA$="Q"THENFY=FY-1ELSEIFA$=" "THENA=-A:LINE(MX-8,MY+11)-(MX+1,MY+11),RESET:PUT@(MX,MY)-(13+MX,18+MY),SET,A%ELSE 160  
