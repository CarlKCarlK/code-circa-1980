10 A=1
20 DIMF%(20)
30 DIMA%(30)
40 MX=64:MY=13
50 LINE(0, 11)-(12,16),SET,BF:LINE(3,16)-(9,18),SET,BF:LINE(2,5)-(10,9),SET,BF:LINE(10,13)-(10,16),RESET:LINE(2,13)-(2,16),RESET:LINE(6,16)-(6,19),RESET:LINE(3,10)-(9,10),SET
