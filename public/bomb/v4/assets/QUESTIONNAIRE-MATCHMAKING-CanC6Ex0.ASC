1 DEFINT A-Z
2 CLS: PRINTCHR$(23);"THIS IS NOT-SCIENTIFIC!!!!!!!!!"
3 PRINT"

THIS IS FOR FUN ONLY.


10 CLEAR 2000
20 PRINT"RUNNING
DATA SHOULD BE OF FORM....
#QUESTIONS,#MALES,#FEMALES,A1M1,A2M2,...A1MM,A2MM..ANMM,A1F1...
25 READ QU,ML,FM:N=ML:IF FM>NTHEN N=FM
30 DIM P(N,N,1),PP(N),RJ(N),A(N,QU,1),B(N),BB(N),N$(N,1)
35 PRINT
40 'PRINT"NOW SOMEONE MUST (SECRETLY) TELL ME WHO EVERYONE IS"
50 FORI=1TOFM:N$(I,1)="FEMALE #"+STR$(I):NEXTI
60 FORI=1TOML:N$(I,0)="MALE #"+STR$(I):NEXTI
70 ' INPUT"HOW MANY CORRECTIONS (0 FOR NONE)";C
80 IF C<>0 THENFOR C1=1TOC:INPUT"SEX (0=MALE,1=FEMALE),NUMBER,CORRECT NAME";S,I,N$(I,S):NEXTC1:GOTO70
82 IF N>FM THEN FORI=FM+1TON:N$(I,1)=".....":NEXTI
84 IF N>ML THEN FORI=ML+1TON:N$(I,0)=".....":NEXTI
90 'READ IN
100 S=0:FORI=1TOML+FM:IFI=ML+1 THENS=1
110 FOR Q=1TOQU:READ A(I-ML*S,Q,S):NEXTQ,I
120 NM(0)=ML:NM(1)=FM
150 PRINT"COMPARING ANSWERS"
160 S=0:FORI=1TONM(S):FORJ=1TONM(1-S):FORQ=1TOQU:T=(A(I,Q,S)-A(J,Q,1-S))[2+1:P(I,J,S)=P(I,J,S)+T:P(J,I,1-S)=P(J,I,1-S)+T:NEXTQ,J,I
165 FOR S=0TO1:IF NM(S)<N THEN FORI=NM(S)+1TON:N$(I,S)="....":FORJ=1TO NM(1-S):P(I,J,S)=RND(1000):NEXTJ,I,S:NEXTS
168 'GOSUB500
170 PRINT"RANKING ANSWERS"
180 FOR S=0TO1:FORI=1TO N:FORJ=1TON:RJ(J)=J:NEXTJ
190 FOR PS=1TON-1:FOR PL=N-1TO PSSTEP-1:IF P(I,PL,S)>P(I,PL+1,S) AND P(I,PL+1,S)<>0THEN T=P(I,PL,S):P(I,PL,S)=P(I,PL+1,S):P(I,PL+1,S)=T:T=RJ(PL):RJ(PL)=RJ(PL+1):RJ(PL+1)=T
200 NEXT PL,PS:FORJ=1TON:P(I,RJ(J),S)=J:NEXTJ,I,S
268 'GOSUB500
390 GOTO10000
500 FOR SS=0TO1:PRINT:PRINT"SEX"SS:PRINT:FORII=1TON:FORJJ=1TON:PRINTP(II,JJ,SS);"  ";:NEXTJJ:PRINT:NEXTII,SS:RETURN
10000 '     PROPOSING
10003  PRINT"  WORKING ON THE STABLE MATCHUP"
10090 FOR S=0 TO 1:FORI=1TON:RJ(I)=0:B(I)=N+1:BB(I)=0:NEXTI
10100 FOR I=1TON
10110 FOR J=1TON:IF RJ(I)+1<>P(I,J,S) THEN NEXT J
10120 PP(I)=J:FORJ=1TO1:NEXTJ:J=PP(I)
10140 IF BB(J)=I THEN ELSEIF P(J,I,1-S)<B(J) THEN RJ(BB(J))=RJ(BB(J))+1:B(J)=P(J,I,1-S):BB(J)=I ELSE RJ(I)=RJ(I)+1 
10145 		     NEXT I
10160 FORK=1TON:IFB(K)=N+1 THENFORK=1TO1:NEXTK:GOTO10100ELSENEXTK
10180 GOSUB 10500:'  PRINT OUT 
10195 NEXT S
10499 CLEAR:END
10500 '    PRINT OUT STUFF
10520 CLS:PRINT"            THE STABLE MATCHES ARE AS FOLLOWS:"
10530 FOR I=1 TO N
10540 PRINT TAB(20); N$(I,S);" AND ";N$(PP(I),1-S)
10542 IF I/14=INT(I/14)THENGOSUB10555
10550 NEXT I
10552 GOSUB10555
10553 'IF S=1THENCLEAR2000
10554 RETURN
10555 PRINT@960+14,"  <TYPE ANY KEY TO CONTINUE>";
10556 X$=INKEY$+INKEY$
10557 IF INKEY$="" THEN 10557
10560 RETURN
20000 DATA 10,4,3,   4,5,4,1,2,1,5,2,5,5, 3,4,2,2,2,1,5,1,5,5,  2,4,4,5,2,2,4,3,4,5,  3,3,3,4,2,2,4,5,2,5,   1,1,5,3,5,2,4,5,1,5, 3,3,5,3,3,3,1,5,4,5,   1,4,2,1,4,5,3,3,2,5, 3,1,5,5,3,3,2,5,2,5 
20010 DATA 5¬4,2,3,4,3,5,3,3,5,  4,4,5,4,4,2,2,4,3,5, 
5,4,3,3,4,5,4,3,5, 1,4,5,5,3,3,4,4,3,5
