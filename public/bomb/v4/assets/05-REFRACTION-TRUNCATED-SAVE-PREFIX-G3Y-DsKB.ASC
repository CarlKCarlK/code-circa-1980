10 CLS
20 'REFRACTION
30 PRINT:PRINT:PRINT:PRINT
40 PRINT"WELCOME, THIS IS A SIMULATION OF LIGHT THOUGH TWO MEDIUMS."
50 PRINT"THEN 'N' TO THE RIGHT OF EACH MEDIUM IS IT'S INDEX OF"
60 PRINT"REFRACTION. USING THESE NUMBERS YOU SHOULD BE ABLE HIT THE"
70 PRINT"TARGET.  THE BLANK SPOT ON THE BOTTOM IS WHERE YOUR LIGHT"
80 PRINT"BEAM WILL START, THE BLANK SPOT ON TOP IS THE TARGET."
90 PRINT"THE MEDIUM WITH THE INDEX OF 1.00029 IS AIR. THE OTHER"
100 PRINT"VARIES FROM ONE TO THREE (SPACE HAS INDEX OF ONE, DIAMONDS HAVE AN INDEX OF 2.4195).  YOU SHOULD BE ABLE TO GET ANY TARGET"
110 PRINT"IN THREE TRIES. GOOD LUCK. (PRESS ANY BUTTON)
120 IFINKEY$=""THEN120  ELSECLS
130 DEF FNA(A)=ATN(A/SQR(-A*A+1))
140 PI=3.14159
150 CLS
160 LINE(0,0)-(100,40),SET,B:LINE(0,20)-(100,20),SET
170 PRINT@212,"MEDIUM #2";
180 PRINT@660,"MEDIUM #1";
190 N1=1.00029:N2=RND(0)*2+1:IFRND(2)=1THENH=N1:N1=N2:N2=H:H=0
200 PRINT@192+52,"N="N2;:PRINT@640+52,"N="N1;
210 TX=50:LINE(TX-1,40)-(TX+1,40),RESET
220 AA=RND(0)*PI/2-PI/4
230 IF N1<=N2THEN250  
240 IF FNA(N2/N1)< ABS(AA) THEN 190  
250 AR=FNA(SIN(AA)*N1/N2)
260 MX=TX-TAN(AA)*40
270 FX=MX-TAN(AR)*40
280 IFFX<0ORFX>100THEN190  
290 LINE(FX-1,0)-(FX+1,0),RESET
