10 CLS:M$=CHR$(160)+CHR$(156)+CHR$(140)+CHR$(181)
20 INPUT"ANGLE OF RAMP";A:INPUT"DISTANCE";D
21 '
25 A=A/180*3.14159
30 LR$=CHR$(176)+CHR$(188)+CHR$(191):RR$=CHR$(191)+CHR$(188)+CHR$(176)
40 CLS:FORX=0TO127:SET(X,9):SET(X,18):NEXT
45 PRINT@857,D"FEET";
49 Y=12:X=0
50 FORX=0TO14:FORY=12TO14:PRINT@X+Y*64,CHR$(191);:PRINT@X+49+Y*64,CHR$(191);:NEXTY:NEXTX
60 PRINT@704+12,LR$;:PRINT@704+12+37,RR$;
65 GOTO80
70 FORX=1000TO0STEP-1:PRINT@0,INT(X/100);:NEXT
80 PRINT@0,"GO!"
85 X=0
88 FORY=1TO3
90 X=X+S/50:IFX>58THENX=0:NEXTY
100 IFY=1THENYY=128+XELSEIFY=2THENYY=320+XELSEIFY=3ANDX<8THENYY=705+XELSE200
110 A$=INKEY$:PRINT@OX,"    ";:PRINT@YY,M$;:OX=YY:IFA$=","THENSS=-1ELSEIFA$="."THENSS=0ELSEIFA$="/"THENSS=1
115 S=S+SS*2
120 IFS<0THENS=0
130 PRINT@0,"SPEED"S"   "
140 GOTO90
200 XS=COS(A)*S:YS=SIN(A)*S
205 S=0
210 S=S+.05
220 X=XS*S:Y=YS*S-32*S[2
230 XG=X/D*70
240 YG=Y/D*35/3
245 YA=10-YG
250 YG=INT(10-YG+.5)
255 IFYG<0THENPRINT@OX,"      ";:GOTO270
260 YY=XG+10+YG*64:PRINT@OX,"     ";:PRINT@YY,M$;:OX=YY
270 IF(YA<11ORXG<37)ANDYG<15ANDXG<49THEN210
290 IFNOTYG<15ORNOTXG<49THENPRINT@852,"YOUR DEAD       "ELSEPRINT@852,"VERY GOOD        "
300 PRINTTAB(18),"SAME CONDITIONS";:INPUTA$:IFA$="NO"THENRUN10ELSEX=Y=0:GOTO21
999 GOTO999
2000 FORX=121TO191:PRINTX;CHR$(X),,,:NEXT:GOTO2000
