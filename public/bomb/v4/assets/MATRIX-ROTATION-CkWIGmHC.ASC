10 CLS
20 GOSUB 4000
30 CLS
40 GOSUB 5000
50 INPUTC$
60 IF C$="R"THENINPUT R:GOSUB 3000:GOTO100
70 IF C$="X" THEN GOSUB1000:GOTO100
80 IF C$="Y"THEN GOSUB2000:GOTO100
90 GOTO50
100 GOTO40
1000 'FLIP ON X-AXIS
1010 FOR A=1TO3
1020 H=B(A,3):B(A,3)=B(A,1):B(A,1)=H
1030 NEXT A
1040 RETURN
2000 'FLIP ON Y-AXIS
2010 FOR A=1TO3
2020 H=B(3,A):B(3,A)=B(1,A):B(1,A)=H
2030 NEXT A
2040 RETURN
3000 ' ROTATE TO C-W 45 DEG. FOR EACH R
3010 FOR B=1TOR
3020 FOR N=1TO3
3030 FOR M=1TO3
3040 H(M,N)=B(M,N)
3050 NEXTM,N
3060 FOR N=1TO3
3070 FOR M=1TO3
3080 B(N,4-M)=H(M,N)
3090 NEXTM,N,B
3100 RETURN
4000 FORN=1TO3
4010 FORM=1TO3
4020 PRINTM;N;:INPUTB(M,N)
4025 IF B(1,1)=-2THEN  FORN=1TO3:FORM=1TO3:B(N,M)=RND(3)-1:NEXT:NEXT:RETURN
4030 NEXT M,N
4040 RETURN
5000 FORN=1TO3:FORM=1TO3
5010 PRINTB(M,N);
5020 NEXT M
5030 PRINT:NEXTN
5040 RETURN
