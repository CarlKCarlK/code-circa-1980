1 CLEAR 200
2 F=1
5 CLS
10 ' BLACKJACK ANAISLYS
15 DIMC(52)
20 FORX=1TO13:C(X)=X:C(X+13)=X:C(X+26)=X:C(X+39)=X:NEXT
25 FORX=1TO52:IFC(X)>10 THENC(X)=10 ELSE IF C(X)=1THENC(X)=11
26 NEXT
30 FORX=1TO52:R1=RND(52):R2=RND(52):H=C(R1):C(R1)=C(R2):C(R2)=H:NEXT
35 GH=GH+1:IFGH<6THEN30
40 P=1
50 IFP>45THENP=1:GOTO30
55 P=P+2
60 S(1)=C(P-2):S(2)=C(P-1)
65 SC=2
70 P=P+2
80 H(1)=C(P-2):H(2)=C(P-1)
90 PRINT@0,"";
91 PRINT"BOOK HAS WON"BW,"BOOK HAS LOST",BL:PRINT
100 PRINTS(1);S(2),,H(1);H(2)
110 S=0:FORX=1TOSC:S=S+S(X):NEXT
120 FORX=1TOSC:IF S(X)=11 THEN A=1 ELSE NEXT:A=0
125 IF S<18 AND A=1 THEN 300
130 IF S>18 THEN 350
135 IF S<>18 THEN150
140 IFA=1 AND H(1)>8 AND H(1)<11 THEN 300 ELSE 350
150 IF S<>17 THEN 170
160 IF A=1 THEN 300 ELSE 350
170 IF S<13 THEN 190
180 IF H(1)<7 THEN 350 ELSE 300
190 IF S<>12 THEN210
200 IF H(1)>3 AND H(1)<7 THEN 350 ELSE 300
210 GOTO 300
300 SC=SC+1:S(SC)=C(P):P=P+1:PRINTS(SC);:GOTO110
350 PRINT:PRINT"STAND"
390 HC=2
400 H=0:FOR X=1 TO HC:H=H+H(X):NEXT
410 IF H<17 THEN HC=HC+1:H(HC)=C(P):P=P+1:PRINT,,H(HC):GOTO400
420 PRINT,,"STAND"
500 IFS<22THEN550
510 FORX=1TOSC
520 IF S(X)=11 THEN S=S-10
525 IFS<22 THEN 550
530 NEXT
540 PRINT"BUST":GOTO1000
550 IF H<22 THEN610
560 FORX=1 TO HC
570 IF H(X)=11 THEN H=H-10
580 IF H<22 THEN 610
590 NEXT
600 PRINT,,"BUST":GOTO1010
610 IFS<H THEN 1000 ELSE IF S>H THEN 1010 ELSEPRINT,"TIE":GOTO2000
1000 PRINT,"BOOK LOST":BL=BL+1:GOTO2000
1010 PRINT,"BOOK WINS":BW=BW+1:GOTO 2000
2000 GOTO50
