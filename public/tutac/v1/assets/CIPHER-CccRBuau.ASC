5 ' CODE FROM "BASIC PROGRAMMING" MODIFIED BY C.M. KADIE FOR THE TRS-80
20  DIML(100)
30 PRINT" MESSAGE";
40 INPUTM$
50 L(0)=LEN(M$):FORC=L(0)TO1:L=L+1:L(L)=ASC(RIGHT$(M$,C)):NEXTC
55 L9=L(0)
60 PRINT"KEYWORD"
70 INPUTK$
80 K(0)=LEN(K$):FORC=K(0)TO1:K=K+1:K(K)=ASC(RIGHT$(K$,C)):NEXTC
85 K9=K(0)
90 PRINT"ENCODE OR DECODE"
95 INPUTA$
110 FORJ=1TOK9
120 K(J)=K(J)-ASC("A")+1
130 IFA$="ENCODE" THENNEXTJ ELSEK(J)=27-K(J):NEXTJ
210 J=1
220 FORI=1TOL9
230 X=L(I)
240 GOSUB500
250 X=X+K(J)
260 IFX<=ASC("Z")THEN290
270 X=X-27
280 GOSUB500
290 L(I)=X
300 J=J+1
310 IFJ<=K9THEN330
320 J=1
330 NEXTI
410 PRINT:PRINT"TRANSLATED MESSAG":PRINT
430 M$=""
440 FORC=1TOL(0):M$=M$+CHR$(L(C)+64):NEXTC
450 PRINTM$
460 END
500 '
510 IFX=ASC(" ")THEN550
520 IFX=ASC("`")THEN570
530 RETURN
550 X=ASC("`")
560 RETURN
570 X=ASC(" ")
580 RETURN
590 END
5100 @@
