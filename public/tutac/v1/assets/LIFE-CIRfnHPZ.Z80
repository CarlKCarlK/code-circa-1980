MEMLOC	LD IX,DIV3
	RES 7,B
	RES 6,B
	BIT 7,C
	JP Z,POS
	LD A,48
	ADD A,C
	LD C,A
	JP START
POS	LD A,C
	CP 48
	JP M,START
	LD A,C
	SUB 48
	LD C,A
START	LD D,0
	LD E,C
	ADD IX,DE
	LD E,(IX+0)
	LD A,C
	SUB E
	SUB E
	SUB E
	ADD A,A
	LD H,A
	LD D,B
	SRL D
	JP NC,SKIP
	INC H
SKIP	LD A,D
	LD D,0
	PUSH DE
	POP IX
	LD E,A
	ADD IX,IX
	ADD IX,IX
	ADD IX,IX
	ADD IX,IX
	ADD IX,IX
	ADD IX,IX
	PUSH BC
	LD BC,(SCR)
	ADD IX,BC
	POP BC
	ADD IX,DE
	LD L,(IX+0)
	RET
TEST	CALL MEMLOC
TEST1	SRL L
	DEC H
	JP P,TEST1
	RET
PLOT	PUSH AF
	CALL MEMLOC
	POP AF
	PUSH AF
	LD D,H
PLOT1	RR L
	DEC H
	JP P,PLOT1
	POP AF
	PUSH AF
LOOP7	RL L
	DEC D
	JP P,LOOP7
	LD (IX+0),L
	POP AF
	RET
	LD (IX+0),L
PLOT2	LD B,H
	LD C,L
	PUSH HL
	PUSH DE
	LD DE,15392
	LD (SCR),DE
	CALL PLOT
	LD DE,15360
	LD (SCR),DE
	POP DE
	POP HL
	RET
GEN	LD HL,0
GEN1	LD D,0
	DEC H
	DEC L
	CALL SUBR
	INC L
	CALL SUBR
	INC L
	CALL SUBR
	INC H
	CALL SUBR
	INC H
	CALL SUBR
	DEC L
	CALL SUBR
	DEC L
	CALL SUBR
	DEC H
	CALL SUBR
	INC L
	LD B,H
	LD C,L
	PUSH DE
	PUSH HL
	CALL TEST
	POP HL
	POP DE
	PUSH AF
	LD A,D
	CP 2
