10 CLS:PRINT"THESE THREE PROGRAMS TEST YOUR REFLEXS"
20 PRINT:PRINT:PRINT:PRINT"WHICH WOULD YOU LIKE TO PLAY":PRINT:PRINT"1) HAND-EYE":PRINT"2) TIMER":PRINT"3) GUN FIGHT"
30 PRINT:INPUT"WHAT IS YOUR PLEASURE";C
40 ONCGOTO1000,2000,3000
1000 'HAND-EYE
1010 CLS:PRINT:PRINT"WHEN I SAY GO, YOU HIT THE SPACE BAR, I WILL TELL YOU YOUR TIME"
1020 PRINT:INPUT"(PRESS ENTER WHEN READY)";C$
1030 :L=RND(10000):CLS:PRINTCHR$(23)
1040 FORX=1TOL:NEXT:PRINT@400,"GO !":FORX=1TO1000:A$=INKEY$:IFA$=""THENNEXTELSECLS:PRINT:PRINT:PRINT"YOUR TIME WAS"X/120"SEC":GOTO5000
1050 PRINT"YOU TOOK TOO LONG":GOTO5000
2000 'TIMER
2010 CLS:PRINT:PRINT:PRINT:PRINT"IN THIS GAME, YOU WILL BE GIVEN A RANDOM TIME, THEN WHEN READY":PRINT"YOU START THE CLOCK AND STOP IT, TRYING TO GET THE SAME TIME"
2020 L=RND(2000):INPUT"PUSH (ENTER) TO GET THE TIME";C$:CLS
2030 X=X+1:IFX>=LTHEN2050ELSEA$=INKEY$:IFA$=""THEN2030ELSE2040
2040 PRINT"YOU'RE NOT TOO PUSH ANYTHING UNTIL YOU KNOW HOW LONG TO WAIT.":GOTO2020
2050 PRINT"DONE, NOW IT YOUR TURN. PUSH (ENTER) TO START, AND (BAR) T0 STOP":INPUTC$:CLS
2060 X=X+1:IFX<=-1234THEN2050ELSEA$=INKEY$:IFA$=""THEN2060ELSE2070
2070 PRINT:PRINT:PRINT:PRINT"YOUR TIME WAS"100*(ABS(L-X))/L"%, CORRECT.":GOTO5000
3000 'GUN FIGHT
3010 CLS:PRINT"THIS IS GUN-FIGHT":PRINT:PRINT"YOU WIN IF YOU SHOT, THE GUNFIGHTER, BEFORE HE SHOTS YOU.":PRINT"YOU LOSE IF YOU SHOOT HIM BEFORE HE DRAWS HIS GUN"
3020 PRINT"IF YOU MISS YOUR GUNS (D & K BUTTOMS)":PRINT"HE SHOOT YOU FRIST"
3030 PRINT:INPUT"PRESS (ENTER) TO FIGHT";C$
3040 L=RND(60):FORX=1TOL:PRINT@X+576,CHR$(191):A$=INKEY$:IFA$=""THEN NEXT ELSE3100
3050 IFL<55THENCLS:GOTO3040ELSEA$="F":GOTO3100
3100 IF(A$="D"ORA$="K")ANDX>55THENPRINT"YOU GOT ME"ELSEPRINT"HA, HA, I GOT YOU."
3200 INPUT"TRY AGAIN COWBOY (JUST HIT (ENTER) TO CONTINUE)";C$:IFC$="NO"THEN5000ELSE3040
5000 PRINT:PRINT:PRINT:PRINT"DONE":PRINT:INPUT"PRESS (ENTER) TO GET CATALOGUE";C$:GOTO10
