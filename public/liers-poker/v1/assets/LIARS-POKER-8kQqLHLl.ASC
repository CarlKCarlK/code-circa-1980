5 CLS:DC=20:DH=20
10 PRINT "LIAR'S POKER"
15 I=INT((RND(0)[3)*10000+1):Q=RND(0):IFRND(2)=1THENQ=1/Q
17 R=0:QQ=RND(0)/Q*10000
20 PRINT:PRINT:PRINT
30 CN=RND(10000):HN=RND(10000)
40 PRINT"YOUR NUMBER IS :"HN
50 IF RND(2)=1THEN200
100 PRINT:PRINT"TYPE  'CALL' OR YOUR RAISE"
110 INPUT H$
120 IF H$<>"CALL"THEN 160
130 PRINT:PRINT:PRINT"MY NUMBER IS: "CN
140 PRINT"THE POT STANDS AT "R
150 IF INT(CN+.5)<=INT(R+.5)  PRINT"YOU WIN !!!!!!!":DC=DC-1:DH=DH+1ELSEPRINT"I WIN !!!!!!":DH=DH-1:DC=DC+1
155 GOTO 230
160 IFVAL(H$)=0 THEN 110ELSEIF VAL(H$)<R THEN PRINT"YOU DIDN'T RAISE. THE CURRENT VALUE IS "R"." :GOTO 100ELSE R=VAL(H$)
200 IF  R<CN THEN GOSUB400:GOTO 300
210 IF QQ> RTHENGOSUB400:GOTO 300
220 PRINT"I CALL":FORT=1TO500:NEXT:PRINT:PRINT"YOUR NUMBER IS: "HN:PRINT"THE POT STANDS AT "R:IF INT(HN+.5)<=INT(R+.1) THEN PRINT"I WIN !!!!!":DC=DC+1:DH=DH-1ELSEPRINT"YOU WIN !!!!!":DC=DC-1:DH=DH+1
230 PRINT"NOW YOU HAVE :"DH".  AND I HAVE "DC".":GOTO17
300 '
301 PRINT"I RAISE IT TO ";R:GOTO 100
400 W=R+RND(I):IF W>10000 THEN R=R+RND(10000-R) ELSE R=W
410 RETURN
