10 'COMPUTER CHESS
14 PM=120
15 DIM RN(PM),CN(PM),CO(PM),RO(PM),D(PM)
20 CLS
25 PRINT@400," C H E S S !  !  !  !";
30 FOR R=1TO2:FORC=1TO8:READ B(R,C):NEXTC,R
35 TI=.5
40 RESTORE
50 FOR R=8TO7STEP-1:FORC=1TO8:READ B(R,C):B(R,C)=-B(R,C):NEXTC,R
55 DATA5,4,3,2,1,3,4,5,6,6,6,6,6,6,6,6
56 FOR P=1TO6:READ P$(P):NEXTP:C$(1)=CHR$(143):C$(3)=" ":P$(0)=" -"
57 DATA K,Q,B,N,R,P
60 GOSUB10000
70 INPUT"DO I GO FIRST";A$:IFA$="YES"THEN200
80 GOTO81:INPUT"WHAT IS YOUR MOVE (ROW,COLUMB,NEW ROW,COULMB)";RO,CO,RN,CN
81 FORR9=1TO4:FORC9=1TO8:IFR9<4 OR C9<=4 THENJ5=B(R9,C9):B(R9,C9)=-B(9-R9,9-C9):B(9-R9,9-C9)=-J5:NEXTC9,R9ELSETI=TI+.5:IFINT(TI)=TITHENC$(1)=" ":C$(3)=CHR$(143)ELSEC$(1)=CHR$(143):C$(3)=" "
82 GOSUB10000:GOTO200
90 IF B(RO,CO)<=0 THEN PRINT"ILLEGAL MOVE !":GOTO 80
100 IF B(RN,CN)=-1 THEN PRINT"YOU WIN!!!!!!":END
105 C1=CN:C=CO:R1=RO:R2=RN :GOSUB20000
110 B(RN,CN)=B(RO,CO):B(RO,CO)=0
200 PRINT"NOW IT IS MY TURN   "
279 PM=0
280 FOR R=1TO8:FORC=1TO8
290 IF B(R,C)>=0 THEN 1000
300 IF B(R,C)<>-6 THEN 400:' PAWN JUMP
310 IF B(R-1,C-1)>0 AND C-1>=1THEN PM=PM+1:RN(PM)=R-1:CN(PM)=C-1:RO(PM)=R:CO(PM)=C:D(PM)=-B(R-1,C-1)
320 IF B(R-1,C+1)>0 AND C+1<=8THEN PM=PM+1:D(PM)=-B(R-1,C+1):RN(PM)=R-1:CN(PM)=C+1:CO(PM)=C:RO(PM)=R:IF R=2 THEN D(PM)=-1.5
330 IF B(R-1,C)=0 THEN PM=PM+1:RO(PM)=R:CO(PM)=C:RN(PM)=R-1:CN(PM)=C:D(PM)=-10:IF R=2 THEN D(PM)=-1.5
400 PI=3.14159
410 IF B(R,C)=-  5THENSP=PI/2:SI=0 ELSE IF B(R,C)=-3 THENSP=PI/2:SI=PI/4ELSEIF B(R,C)=-2 THEN SP=PI/4:SI=0ELSE550
415 FOR A=SITO2*PI-.01 STEP SP
420 FOR M=1TO8
430 RN=INT(COS(A)*M+.5)+R:CN=INT(.5+SIN(A)*M)+C:IF RN<1 OR CN<1 OR CN>8ORRN>8 THEN 500
440 IF B(RN,CN)>0 THEN PM=PM+1:CO(PM)=C:RO(PM)=R:CN(PM)=CN:RN(PM)=RN:D(PM)=-B(RN,CN):GOTO 500
450 IF B(RN,CN)=0 THEN PM=PM+1:CO(PM)=C:RO(PM)=R:CN(PM)=CN:RN(PM)=RN:D(PM)=-10
460 IF B(RN,CN)<0 THEN 500
490 NEXTM
500 NEXT A
550 IF B(R,C)<>-4 THEN 700
560 FOR A=PI/2 TO 2*PISTEP PI/2
570 FOR AF=-1TO1STEP2
580 RN=R+INT(.5+COS(A)*2+AF*SIN(A)):CN=C+INT(.5+SIN(A)*2+AF*COS(A))
586 IF RN<1 OR CN<1 OR RN>8 OR CN>8 THEN 650
590 IF B(RN,CN)<0 THEN 650
595 PM=PM+1
600 IF B(RN,CN)=0 THEN D(PM)=-10 ELSE D(PM)=-B(RN,CN)
610 CO(PM)=C:RO(PM)=R:CN(PM)=CN:RN(PM)=RN
650 NEXT AF,A
700 IF B(R,C)<>-1 THEN 900
710 FOR CN=C-1TOC+1:FORRN=R-1TOR+1
715 IF( CN=CAND RN=R ) OR CN<1 OR RN<1 OR CN>8 OR RN>8 THEN 800
720 IF B(RN,CN)<0 THEN 800
730 PM=PM+1:IFB(RN,CN)=0THEND(PM)=-10ELSED(PM)=-B(RN,CN)
740 CO(PM)=C:RO(PM)=R:CN(PM)=CN:RN(PM)=RN
800 NEXT RN,CN
900 '
1000 NEXT C,R
1005 R=-100
1007 IF PM=0 THEN PRINT"I CAN'T MOVE.  STALE MATE":END
1010 FOR I=1TO PM:IF D(I)>R THEN R=D(I):H=I:B=0
1013 IF D(I)=R THEN B=B+1:D(B)=I
1015 NEXT I
1020 H= INT(D(RND(B)))
1025 IF R=-1.5 THEN B( RO(H),CO(H) )=-2
1028 R1=RO(H):R2=RN(H):C=CO(H):C1=CN(H):GOSUB20000
1030 B( RN(H), CN(H) ) = B( RO(H),CO(H) ):  B(RO(H),CO(H))=0
1042 PRINT
1045 IFABS( R+1 )<.1THEN PRINT"CHECK MATE I WIN":END
1050 GOTO 80
10000 FORR1=1TO8:FORC=1TO8:PRINT@(R1-1)*64+C*6,P$(ABS(B(R1,C)))" "C$(SGN(B(R1,C))+2);"    ";:NEXTC,R1:PRINT
10020 PRINT@576,"";:RETURN
20000 FOR FL=1TO10:PRINT@(R1-1)*64+C*6,P$(ABS(B(R1,C)));" "C$(SGN(B(R1,C))+2);:J3=3[.344:PRINT@(R1-1)*64+C*6," - ";:NEXTFL:FORFL=1TO20:PRINT@(R2-1)*64+C1*6,"   ";:Y3=3[.344:PRINT@(R2-1)*64+C1*6,P$(ABS(B(R1,C)));" ";C$(SGN(B(R1,C))+2);:NEXTFL
20010 PRINT@576,"";:RETURN
