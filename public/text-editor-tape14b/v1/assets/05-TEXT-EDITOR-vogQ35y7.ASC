1 CLS
2 DIM T(100,1)
3 CLEAR6000
5 X=0:Y=0:DEFSTRT
10 A$=INKEY$:IFA$="@"THEN200ELSEPRINTA$;:GOSUB100:GOTO10
100 IF(LEN(T(X,Y))>56ANDA$=" ")ORA$=CHR$(13)THEN150ELSET(X,Y)=T(X,Y)+A$
110 IFLEN(T(X,Y))>61THENT(X,Y)=T(X,Y)+"-":GOTO150
130 GOTO160
150 X=X+1
160 RETURN
200 PRINT:PRINT"YOU MAY (PRINT) OR (RELINE) OR (CRUISE)"
210 INPUT"WHICH SHALL IT BE (FIRST LETTER)";A$
220 IFA$="P"THEN500ELSEIFA$="R"THEN1000ELSEIFA$="C"THEN1500
500 CLS:PRINT"PRINTING":PRINT:INPUT"WHAT LINE SHOULD I START WITH AND WHAT LINE SHOULD I END WITH";S,E:IFS=0THENS=1:E=X
510 FORH=S-1TOE
520 PRINTT(H,Y)
530 NEXT
540 PRINT:GOTO10
1000 XX=X:YO=Y:IFY=1THENY=0ELSEY=1
1010 FORH=0TOXX:FORG=1TOLEN(T(H,YO)):A$=MID$(T(H,YO),G,1)
1020 GOSUB100:NEXT:NEXT:PRINT:GOTO10
1500 PRINT
1510 INPUT"WHICH LINE DO YOU WISH TO REPLACE";LL
1515 INPUT"HOW SHOULD IT READ";T(LL+1,Y)
1520 PRINT:GOTO10
