5 MAXFILES=2
10 DEFINT A-Z
15 DIM M(400)
20 CLS
25 FILES
30 INPUT "Lesson (.do assumed)";F$
35 CLS
40 INPUT "How many to skip ";R:IF R>0 THEN FOR I=1TOR:M(I)=-1:NEXTI
50 Q=1:A=0:NA=0
60 OPEN F$+".do" FOR INPUT AS 1
65 OPEN "note.do" FOR APPEND AS 2
70 IF EOF(1) THEN L$="q:" :ELSE LINEINPUT#1,L$
75 IF LEFT$(L$,2)="q:" THEN L$=MID$(L$,3):NA=0 :ELSE IF LEFT$(L$,2)="c:" THEN NA=0 :ELSE IF LEFT$(L$,2)="a:" THEN NA=-1 : L$=MID$(L$,3)
80 IF NA THEN IF A THEN IF M(Q) THEN :ELSE PRINT "";L$ :ELSE A=1:IF M(Q) THEN :ELSE GOSUB 300 :ELSE IF A THEN A=0:Q=Q+1:IF M(Q) THEN :ELSE GOSUB 400 :ELSE IF M(Q) THEN :ELSE PRINT "";L$
90 IF NOT EOF(1) THEN 70
99 '100 eof
100 CLS:CLOSE:PRINT:PRINT:PRINT"That's all."
110 PRINT"You got ";R;" of ";Q;" right ";INT(R/Q)*100
120 PRINT
130 PRINT"1) Try mistakes again":PRINT"2) Start over ":PRINT"3) Do another lesson":PRINT"4) Main Menu":A=VAL(INPUT$(1)):PRINT A
140 IF A=4 THEN MENU :ELSE IFA=1 THEN 50 :ELSE FOR I=1 TO 400:M(I)=0:NEXTI:IF A=2 THEN 35 :ELSE IF A=3THEN 20 :ELSE 130
150 PRINT "Try those them all (y/n)? ";:A$=INPUT(1):PRINT A$
160 IF A$="y" OR A$="Y" THEN RUN :ELSE MENU
300 LINE INPUT"   Think,ENTER ";A$
310 PRINT:PRINT "";L$:RETURN
400 PRINT"   Right? (y/n/c)";:A$=INPUT$(1):PRINTA$
402 IF A$<>"c" AND A$<>"C" THEN 410
405 PRINT ">>comments will be appended to note.do<<Enter when done"
406 C$="":INPUT C$:IF C$=""THEN400 :ELSE PRINT#2,C$:GOTO 406
410 IF A$="n" OR A$="N" THEN :ELSEM(Q-1)=-1:R=R+1
420 PRINT:PRINTQ;".":PRINT""; L$:RETURN
