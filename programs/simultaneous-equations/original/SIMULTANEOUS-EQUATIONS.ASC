10 PRINT"SIMULTANEOUS EQUATIONS"
20 PRINT
30 DIM A(20,21)
50 INPUT"NUMBER OF EQUATIONS";R
60 PRINT"COEFFIICIENT MATRIX...."
70 FORJ=1TOR
80 PRINT"EQUATION";J
90   FORI=1TOR+1
100     IF I=R+1 THEN 130
110     PRINT"  COEFFICIENT";I;
120     GOTO 140
130     PRINT" CONSTANT";
140     INPUT A(J,I)
150     NEXTI
160 NEXTJ
161 A$="":INPUT"HOW MANY MISTAKES ('SHOW' TO DISPLAY MATRIX)";A$:IFA$="SHOW"THENGOSUB1000:GOTO161ELSEIFVAL(A$)=0THEN170
162 FORF=1TOVAL(A$):INPUT"EQUATION#,COLUMN#,CORRECT VALUE";J,I,A(J,I)
164 NEXTF
166 GOTO161
170 FORJ=1TOR
180 FORI=JTOR
190 IF A(I,J)=0 THEN          ELSE 230
200 NEXTI
210 PRINT"NO UNIQUE SOLUTION"
220 GOTO 440
230 FOR K=1TOR+1
240 X=A(J,K)
250 A(J,K)=A(I,K)
260 A(I,K)=X
270 NEXTK
280 Y=1/A(J,J)
290 FORK=1TOR+1
300 A(J,K)=Y*A(J,K)
310 NEXTK
320 FORI=1TOR
330 IF I=JTHEN380
340 Y=-A(I,J)
350 FORK=1TOR+1
360 A(I,K)=A(I,K)+Y*A(J,K)
370 NEXTK
380 NEXTI
390 NEXT J
400 PRINT
410 FORI=1TOR
420 PRINT"X";I;"=";A(I,R+1)
430 NEXTI
440 END
1000 FORJJ=1TOR:FORII=1TOR+1:PRINTA(JJ,II);"  ";:NEXTII:PRINT:NEXTJJ
1010 RETURN
