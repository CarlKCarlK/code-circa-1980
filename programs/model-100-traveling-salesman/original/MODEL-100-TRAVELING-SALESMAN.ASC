10 'traveling salesman
14  DEFSNG A
15 DEFINT B-Z
16 FC!=.9
20 INPUT "How many cites";C
30 DIM C(1,C)
40 INPUT"random sequence";R:FORI=1TOR:C(0,0)=RND(1):NEXTI
45 CLS
50 FORJ=0TO1:FORI=1TOC:C(J,I)=RND(1)*63:NEXTI,J
60 DIM N(C),R(C),A(C):FORI=1TOC:N(I)=I+1:NEXT I:N(C)=1
70 GOSUB 1000:AR=C*100
100 IF A(0) < AR THEN AR=A(0):FOR I=1TO C:R(I)=N(I):NEXTI:LINE(0,0)-(63,63),0,BF:II=1:FORI=1TOC:LINE(C(0,II),C(1,II))-(C(0,N(II)),C(1,N(II))),1:II=N(II):NEXTI:PRINT@280,INT(AR);
105 LINE(W1*64*FC!+64,0)-(W1*64*FC!+63*FC!+64,63),0,BF:II=1:FORI=1TOC:LINE(W1*64*FC!+64+FC!*C(0,II),C(1,II))-(W1*64*FC!+64+FC!*C(0,N(II)),C(1,N(II))),1:II=N(II):NEXTI:PRINT@280+20*W1,INT(A(0));: W1=(1+W1) MOD 3
110 GOSUB 200:GOTO 100
200 Y1=Y1+1:IF Y1>1 THEN RETURN :ELSE A(0)=0:N(1)=1:FOR Z1=2 TO C:Q=Z1
210 PRINT@300,Z1;
215 AC=640:II=1:FOR I=1 TO Z1-1:D1=Q:D2=II:GOSUB300:AA=A1:D1=Q:D2=N(II):GOSUB300:AB=A1
220 AD=AA+AB-A(II):IF AD<AC THEN AC=AD:RP=II
230 II=N(II):NEXTI:II=RP:LD=0:GOSUB 1200:A(0)=A(0)+AC:N(Q)=N(RP):A(Q)=AA:N(RP)=Q:A(RP)=AB:LD=1:II=N(II):NEXTZ1:RETURN
300 A1=SQR((C(0,D1)-C(0,D2))^2+(C(1,D1)-C(1,D2))^2):RETURN
1000 A(0)=0:FORI=1TOC:A(0)=A(0)+SQR((C(0,I)-C(0,N(I)))^2+(C(1,I)-C(1,N(I)))^2):NEXTI:RETURN
1100 LINE(W1*64*FC!+64+FC!*LX,LY)-(W1*64*FC!+64+FC!*LW,LZ),LE:RETURN
1200 L1=(C(0,II)+C(0,N(II)))/2:L2=(C(1,II)+C(1,N(II)))/2:IF AD=0 THEN 1230
1205 IF N(N(II))<>II THEN LE=0:LX=C(0,II):LY=C(1,II):LW=C(0,N(II)):LZ=C(1,N(II)):GOSUB 1100
1210 L6=5:FOR L5=1 TO L6 :L3= C(0,Q)*L5/L6+L1*(1-L5/L6):L4= C(1,Q)*L5/L6+L2*(1-L5/L6):FORLE=1TO6:LX=C(0,II):LY=C(1,II):LW=L3:LZ=L4:GOSUB 1100:LX=C(0,N(II)):LY=C(1,N(II)):GOSUB1100:NEXTLE,L5
1220 LE=1:GOSUB 1100:LX=C(0,II):LY=C(1,II):GOSUB 1100
1230 RETURN
2000 PRINT@0,"";:FOR I=1TOC:PRINTN(I);:NEXTI:PRINT@40,"";:FOR I=1TOC:PRINTINT(A(I));:NEXTI:RETURN
