1 CLEAR300:R$="ZZZZZ"
2 READD$:IFD$="DONE"THEN9ELSEIFRIGHT$(D$,1)="@"THEND$=LEFT$(D$,LEN(D$)-1):SK=1ELSESK=0
3 V=VAL(D$):IFV>1900THENY=V:GOTO2ELSEIFLEFT$(D$,1)="*"THENM$=RIGHT$(D$,LEN(D$)-1):GOTO2ELSEIFLEFT$(D$,1)="D"ANDLEN(D$)<4THEND=VAL(RIGHT$(D$,LEN(D$)-1)):GOTO2ELSEIFD$="T"THENMG$="TIME"ELSEIFD$="U"THENMG$="U.S.NEWS"ELSEIFD$="N"THENMG$="NEWSWEEK"ELSE5
4 GOTO2
5 IFV<1000ANDV<>0THENP=V:GOTO2
6 L$=LEFT$(M$,3):IFL$="AUG"THENMK$="T"ELSEIFL$="JUL"THENMK$="U"ELSEIFL$="JUN"THENMK$="Y"ELSEIFL$="MAY"THENMK$="W"ELSEIFL$="APR"THENMK$="X"ELSEIFL$="MAR"THENMK$="Y"ELSEIFL$="FEB"THENMK$="ZA"ELSEIFL$="JAN"THENMK$="zz"ELSEMK$=L$
7 IFSK=0THENREADAD$:SK=1:GOTO7ELSEA1$=D$+STR$(1981-Y)+MK$+CHR$(191-D)+LEFT$(MG$,1)+STR$(191-P):IFA1$<R$ANDA1$>FR$THENR$=A1$:L2$=" "+AD$:L1$=D$:L3$=" "+MG$+"  "+LEFT$(M$,3)+STR$(D)+","+STR$(Y)+"  PAGE"+STR$(P)
8 GOTO2
9 IFR$="ZZZZZ"THENENDELSEFR$=R$:LPRINTCHR$(15);L1$:LPRINTL2$:LPRINTL3$:LPRINT:FR$=R$:R$="ZZZZZ":RESTORE:GOTO2
