0 EN
5 DEFSNG A-Z
10 MP% = 2 :'#define number_of_programs
20 TL% = 100:'#define transaction_limit
21 TT% = 200:'#define timeout
22 HM  = 1000:'#high mean
23 HS  = 500 :'#high std dev
24 IN  = 1E6 :'#infinity
26 DIM 	MN(1),SD(1),VA(1),CN(1,TT%):'		mean,std dev,value,conversation
27 DIM  TM%(MP),BL(MP):'time,balance
28 DIM  NI%(1):'index to program number
30 'main
40 FOR TR% =0 TO TL%:'tr is tranactions
50 	GOSUB 200:'sort return ni%(0..1)
60 	GOSUB 300:'deal input ni%(0..1)
70 	GOSUB 500:'show some results
80 	NEXT TR%
90 GOSUB 600:'show final results
100 END
200 'sort return ni%(0..1)
210 BT%=0:NI%(0)=0:'best=0
220 FOR JJ%=0TO1
230 	FOR II%=1 TO MP%
240 		IF (TM%(II%)+RND(1) > RC 		    OR BT%=0)				AND NI%(0)<>II%				THEN RC=TM%(II)+RND(0):			     BT%=II%
250 		NEXT II%
260 	NI%(JJ%)=BT%:BT%=0
270 	NEXT JJ%
280 RETURN
300 'deal input ni%(0..1)
320 FOR AG%=0TO1
330 	MN(AG%)=RND(1)*2*HM-HM
340 	SD(AG%)=RND(1)*HS
350 	Z1=MN(AG%):Z2=SD(AG%):GOSUB800		VA(AG%)=Z1:'call normal rnd
360 	NEXT AG%
370 AG%=INT(RND(1)*2)
380 CN(AG%,1)=-IN:CN(1-AG%,1)=IN
390 QT%=0:'quit = no
400 TC%=2:'time count 
410 IF TC%>=TT% OR QT% THEN 460
420 	Z1=AG%:Z2=TC%:'conver(ag),time
425 	Z6=-MN(1-AG%):Z7=SD(1-AG%):'		mean and std dev of other
430 	ON NI%(AG%) GOSUB 1000,2000,3000, 	4000,5000
433     'z3=quit,z4=offer,z5$=message
435 	PRINT@40*(AG%+6),Z5$;
440 	CN(AG%,TC%)=Z4:CN(1-AG%,TC%=-Z4
445     GOSUB 700:'info on offer
450 	TC%=TC%+1;AG%=1-AG%:GOTO 410
455 TC%=TC%-1
460 FOR AG%=0TO1:NN%=NI%(AG%)
470 	IF TC%=TT% THEN TM%(NN%)=TT%*2			:ELSE TM%(NN%)=TM%(NN%)			 +TC%:					IF CN(0,TC%)=CN(0,TC%-1)		 THEN  BL(NN%)=BL(NN%)			  +CN(NN%,TC%)-VA(NN%)
480 	NEXT AG%
490 	RETURN
500 'tell results of deal
510 FOR AG%=0TO1:PRINT @40*(AG%+3),N(AG%);" has a balance of";BL(N(AG%));:NEXTAG%:RETURN
600 'final results
610 CLS:FOR II%=1TO MP%:PRINT II%;")";BL(II%),:NEXTII:PRINT:RETURN
700 'play by play
710 PRINT@AG%*20,;INT(VA(AG%));INT(Z4);"  ";:RETURN
800 'return a normal random value		with mean z1 and std dev z2
810 Z3=SQR(LOG(1/RND(1)/RND(0))):Z4=2.515517:Z5=.802853:Z6=.010328:Z7=1.432788:Z8=.189269:Z9=.00138:Z0=Z3-(Z4+Z3*(Z5+Z6*Z3))/(1+Z3*(Z7+Z3*(Z8+Z9*Z3)))
820 Z1=Z1+Z0*Z2:RETURN
1000 'human
1010 PRINT "lo,
