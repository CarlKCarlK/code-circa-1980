1 ON ERROR GOTO 2000
10 CLS:DEFINT A-Z
15 DIM XX(12),YY(12),T(21,4)
20 PRINT"WORM ONE"
25 PO=2
30 PRINT"SEE: SCIENTIFIC AMERICAN, NOVEMBER 1973"
40 PRINT:PRINT"PROGRAMED FOR THE TRS-80 BY "
50 PRINT"CARL KADIE  
55 FOR J=1TO6:READ XX(J),YY(J):XX(J+6)=XX(J):YY(J+6)=YY(J):NEXTJ
56 DATA -1,-1,-2,0,-1,1,1,1,2,0,1,-1
57 FOR J=1TO8:READ K,T(K,0),T(K,1),T(K,2),T(K,3):NEXTJ
58 DATA 0,5,3,2,1, 4,5,1,4,2, 16,6,5,2,1, 7,6,3,4,2, 18,7,5,4,1, 14,7,3,5,1, 21,8,5,4,3, 19,8,5,4,2
60 PRINT"27 JULY 1980
65 P$= "1B 2D 3CCCC 4B"
70 PRINT:PRINT"WHICH PATTERN (LIKE 1B 2D 3CCC 4B )"
80 INPUT P$
85 X=64:Y=24:GOTO 100
90 INPUT"(X,Y) OF STARTING LOCATION  ( 0-127,0-47)";X,Y
100 CLS:PRINTP$
105 XB=X:YB=Y:OX=X:OY=Y
110 FOR I=1TOLEN(P$):M$=MID$(P$,I,1)
120 IF M$="1"THEN R$(1)=MID$(P$,I+1,1)
125 IF M$="2"THEN R$(2)=MID$(P$,I+1,1)
130 IF M$="3"THEN FOR J=1TO4:R$(J+4)=MID$(P$,I+J,1):NEXTJ
140 IF M$="4"THEN R$(4)=MID$(P$,I+1,1)
150 NEXT I
160 SET(X,Y):SET(XB,YB):IFY=YB THEN SET((X+XB)/2,Y):SET((XB+OX)/2,YB)
165 OX=X:OY=Y
170 GOSUB1000:'OPTIONS
175 IF OP=0 THEN PRINT@0,"D";:GOTO 900
180 ON 6-OP GOTO 200,300,400,500,600
200 IF R$(1)="A" THEN CH=2 ELSE CH=1 
210 GOTO 700
300 SN=ASC(R$(2))-ASC("A")
310 FOR PP=5TO1STEP-1:IF MID$(H$,PP,1)="0"THEN 330
320 IF SN<>0 THEN SN=SN-1 ELSE CH=PP:GOTO700
330 NEXT PP
340 STOP
400 BC=0:FORJ=1TO5:IFMID$(H$,J,1)="1"THENBC=BC+2[J
410 NEXT J:BC=BC/2-7
420 CH=T(BC,ASC(R$(T(BC,0)))-64)
430 GOTO 700
500 SN=ASC(R$(4))-ASC("A")
510 FOR PP=5TO1STEP-1:IFMID$(H$,PP,1)="0"THEN530
520 IF SN<>0 THEN SN=SN-1 ELSE CH=PP:GOTO700
530 NEXT PP
540 STOP
600 FOR PP=1TO5:IF MID$(H$,PP,1)="0"THEN NEXT:STOP
610 CH=PP
620 GOTO 700
700 X=X(CH):Y=Y(CH):XB=XB(CH):YB=YB(CH):PO=3+CH+PO:GOTO160
900 IF INKEY$=""THEN900 ELSE RUN
1000 'OPTIONS
1010 OP=0:H$="":IFPO>6 THEN PO=PO-6:GOTO1010
1020 FOR J=1TO5:JJ=J+PO:IFNOT(POINT(XX(JJ)+X,YY(JJ)+Y)) THEN H$=H$+"1":OP=OP+1 ELSE H$=H$+"0"
1030 X(J)=XX(JJ)*2+X:Y(J)=YY(JJ)*2+Y:XB(J)=XX(JJ)+X:YB(J)=YY(JJ)+Y:NEXTJ
1037 'FOR J=1TO5:SET(XB(J),YB(J)):NEXTJ:FORJ=1TO500:NEXTJ:FORJ=1TO5:RESET(XB(J),YB(J)):NEXTJ
1040 RETURN
2000 IF ERR/2+1=5 THEN PRINT@0,"D";:GOTO900 ELSE PRINT@0,"ERROR IN LINE"ERL:END
