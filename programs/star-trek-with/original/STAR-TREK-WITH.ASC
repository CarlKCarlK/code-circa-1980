1 CLS: REM STAR TREK REVISED BY ANTHONY D'AGOSTA FOR THE TRS-80
2 DIMA(14)
4 PRINT@25,"STAR TRAK":PRINT:PRINT:INPUT"ARE YOU STARTING OR CONT";A$:IFA$="CONT"THEN5000
5  PRINT"THE PLAYER, AS CAPTAIN OF THE ENTERPRISE ALTERNATES"
10  PRINT"MOVES WITH THE KLINGON BATTLE CRUISER. AFTER A READOUT"
15  PRINT"OF THE RANGE AND BEARING TO THE ENEMY VESSEL, THE PLAY-"
20  PRINT"ER IS QUIERIED FOR HIS COMMAND.":PRINT" "
25  PRINT"PHASORS HAVE RANGE FROM 0 TO 5 MILLION KILOMETERS"
26  PRINT"(5E+06 KM). PHOTON TORPEDOES MAY BE USED FOR RANGES"
27  PRINT"2E+06 KM AND GREATER.":PRINT" "
30  PRINT"FOWARD PHASORS AND PHOTON TORPEDOES MAY BE USED FOR "
35  PRINT"BEARINGS 0 THRU 90 DEGREES. REAR PHASORS MAY BE USED"
40  PRINT"FOR BEARINGS 90 THRU 180 DEGREES.":PRINT" ":PRINT" "
50  FORI=1TO13:A(I)=1:NEXTI:A(7)=0:A(14)=0:PRINT"ENTER STARDATE"
60  INPUTA:R=1E+07*RND(0):B=RND(180):PRINT"KLINGON APPROACHING"
260  PRINT"RANGE=";TAB(7);R;TAB(20);"KM";TAB(24);"BEARING=";
261  PRINTTAB(33);INT(B);TAB(37);"DEG"
265  PRINT" "
270  PRINT"1=FWD PHASOR. 2=REAR PHASOR. 3=FWD PHOTON TORPEDO."
271  PRINT"4=MANUVER TO ATTACK. 5=BREAK OFF. 6=SUICIDE. 7=SURRENDER. 8=POSTPONE"
275  PRINT"COMMAND":INPUTC:I=0:J=7:H=0
330  ON C GOSUB 790,920,1040,1140,1180,1250,1310,6000
335  GOTO1360
360  I=7:W=A(8)+A(9):J=0:IF (A(10)=1)*(R>3E+06)*(B<100) THEN710
410  IF (W>0)*(R<3E+06) THEN540
415  IF W<>0 THEN480
440  PRINT"KLINGON TRYS TO BREAK CONTACT":C=5:GOSUB1180:GOTO1920
480  PRINT"KLINGON ATTACKS":C=4:GOSUB1140:B=0:H=0:GOTO1920
540  PRINT"KLINGON FIRES PHASOR":C=1:IF B<90 THEN640
570  IF A(9)=0 THEN600
575  GOSUB 920:GOTO1360
600  B=B-90:GOSUB790:B=B+90:GOTO1360
610 FORAA=0TO14:PRINT#-1,A(AA):NEXT
640  IF A(8)=0 THEN670
645  GOSUB 790:GOTO1360
670  B=B+90:GOSUB 920:B=B-90:GOTO1360
710  PRINT"KLINGON FIRES PHOTON TORPEDO":C=3:E=B:B=40:GOSUB 1040
760  B=E:GOTO1360
790  H=0:IF A(I+1)<>0 THEN830
795  PRINT"FWD PHASORS INOP":IF I=0 THEN260
830  F=1-.2*(R/1E+06):G=(90-B)/90:IF (G<0)+(R>5E+06)THEN900
870 IF F<RND(0) THEN900
875  H=1:P=4
900  RETURN
920  IF A (I+2)>0 THEN960
925  PRINT"REAR PHASORS INOP":IF I=0 THEN260
960  H=0:F=1-.2*R*1E-06:IF (R>5E+06)+(B<90)THEN1030
1000  IF F<RND(0) THEN1030
1005  H=1:P=2
1030  RETURN
1040  H=0:IF A(I+3)>0 THEN1080
1045  PRINT"PHOTON TORPEDO INOP"
1070  IF I=0 THEN260
1080  IF (R<2E+06)+(B>90) THEN1130
1090  M=(1-B/90)*(1-2*R/1E+08):IF M<RND(0) THEN1130:H=1:P=8
1095  H=1:P=8
1130  RETURN
1140  R=R*(1-.5*A(I+4)):B=0:H=0:RETURN
1180  R=R*(1+A(I+4)+.05*A(I+6)):IF R>1E+08 THEN1230
1200  PRINT"CONTACT NOT BROKEN":H=0:RETURN
1230  PRINT"CONTACT LOST":GOTO2020
1250  PRINT"SELF DESTRUCT ACTIVATED":FORI=1TO10:FORJ=1TO1000:NEXTJ
1270  PRINT11-I:NEXTI:PRINT"FLASH":GOTO2020
1310  PRINT"MESSAGE FROM KLINGON ** I ACCEPT YOUR SURRENDER"
1320  PRINT"PREPARE TO BE BOARDED":PRINT"MESSAGE FROM STAR FLEET"
1340  PRINT"YOU DIRTY COWARD":GOTO2020
1360  PRINT" ":J=7-I:IF C>3 THEN1920
1370  IF H>0 THEN1440
1380  PRINT"MISS":GOTO1920
1440  PRINT"HIT":D=P*(1-A(J+5)):IF D<=2 THEN1480:D=2
1450  D=2
1480  A(J+7)=A(J+7)+D:A(J+5)=A(J+5)-P/100:Z=10-INT(A(J+7))
1510  IF J=0 THEN1580:PRINT"SCANNER REPORT KLINGON"
1520  PRINT"SCANNER REPORT KLINGON"
1540  IF Z>1 THEN1610
1545  PRINT"KLINGON DESTROYED":GOTO2020
1580  PRINT"ENTERPRISE DAMAGE REPORT":IF Z>0 THEN1610
1590  Z=1
1610  ON Z GOTO1620,1640,1850,1730,1730,1780,1780,1780,1830,1830
1620  PRINT"ENTERPRISE DESTROYED":GOTO2020
1640  PRINT"WEAPON SYSTEM DESTROYED":PRINT"WARP DRIVE DESTROYED"
1660  PRINT"MAJOR STRUCTURAL DAMAGE"
1680  A(J+4)=0
1690  A(J+3)=0
1700  A(J+2)=0
1710  A(J+1)=0:PRINT"SHIELDS WEAKENiNG":GOTO1920
1730  PRINT"PHASORS DESTROYED":PRINT"MINOR DAMAGE AMIDSHIPS":GOTO1700
1780  PRINT"FWD PHASORS DESTROYED":PRINT"MINOR DAMAGE AMIDSHIPS"
1790  GOTO1710
1830  PRINT"SHIELDS HOLDING NO DAMAGE":GOTO1920
1850  PRINT"WEAPON SYSTEMS DEACTIVATED"
1860  PRINT"DILITHIUM CRYSTALS OVERHEATING":GOTO1690
1920  L=.5*(A(4)+A(11)+.05*(A(6)+A(13)))
1930  R=R+L*(RND(0)-.5)*1E+06:R=ABS(R)
1950  B=ABS(B-150+RND(20)):B=INT(B):IF B>180 THEN2000
1990  I=J:J=7-I
1995  IF I=0 THEN260:GOTO360
1996  GOTO360
2000  B=ABS(360-B):GOTO1990
2020  PRINT"TO PLAY AGAIN TYPE RUN AND DEPRESS THE 'ENTER' KEY"
2030 END
5000 INPUT"GET DATA TAPE READ (PRESS ENTER)";A$:INPUT#-1,A,B,C,D,E,F,G,H,I,J,L,M,P,R,W,Z
5010 FORAA=0TO14:INPUT#-1,A(AA):NEXT
5020 CLS:GOTO260
6000 INPUT"GET DATA TAPE READY (PRESS ENTER)";A$:PRINT#-1,A,B,C,D,E,F,G,H,I,J,L,M,P,R,W,Z
6010 FORAA=0TO14:PRINT#-1,A(AA):NEXT
6020 PRINT"DONE":END
