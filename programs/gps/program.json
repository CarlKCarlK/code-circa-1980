      "startupSource": "(PUTPROP (QUOTE GPS) (QUOTE (LAMBDA (CUR GOAL) (PROG (DIF OP MID) (SETQ DIF (MAJOR-D CUR GOAL)) (RETURN (COND ((NULL DIF) (PRINT (QUOTE ****)) (PRINT (LIST (QUOTE (CURRENT STATE IS GOAL STATE IS)) CUR)) NIL) (T (SETQ OP (SELECT-OP DIF)) (SETQ MID (PRECON OP CUR)) (PRINT (QUOTE ****)) (PRINT (LIST (QUOTE (CURRENT STATE)) CUR)) (PRINT (LIST (QUOTE (GOAL STATE)) GOAL)) (PRINT (LIST (QUOTE (MAJOR DIFFERENCE)) DIF)) (PRINT (LIST (QUOTE (OPERATOR)) OP)) (PRINT (LIST (QUOTE (STATE AFTER OPERATION)) MID)) (APPEND (GPS CUR MID) (CONS OP (GPS (APPLY OP (LIST MID) (ALIST)) GOAL))))))))) EXPR)\n[Unrelated leftover bytes after the form, not part of it:]\nST (QUOTE (STATE AFTER OPERATION)) MID)) (APPED (GPS CUR MID) (CONS OP (GPS (APPLY OP (LIST MID) (ALIST)) GOAL))))))))) EXPR)ST (QUOTE (STATE AFTER OPERATION)) MID)) (APPE",
