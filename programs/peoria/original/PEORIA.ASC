2 CLEAR100
5 LM=2:LM$="TWO"           'LAP IN MILE AS NUMBER AND SPELLED:HC=10:PL=2
10 CLS:PRINTSTRING$(64,"*"),,,,"WELCOME TO THE PEORIA GRAND PRIX":PRINT:INPUT"SKILL LEVEL";HC:INPUT"DRIVERS";PL:PRINT"I WILL GIVE YOU A COUNT DOWN":FORX=4TO1STEP-1:FORY=1TO500:NEXT:PRINTX:NEXT:CLS:PRINTCHR$(23):PRINT@400,"GO":FORY=1TO500:NEXT
20 ON ERROR GOTO 150
30 WG=40:WT=WG:'WITH OF TRACK
35 PC=6
40 CLS:CK=29:L=24:CL=34:C$=CHR$(179)+CHR$(190)+CHR$(182)+CHR$(145):LZ=LM*150
50 C2$=C$:C1$=C$
52 FOR T3=1TO5:READ PC(T3),WG(T3),WT(T3),HP(T3),LM(T3),CF(T3):NEXT T3
55 C$(1)=C$:C$(2)=C$:C$(3)=C$:C$(4)=C$:C$(5)=C$
60 FOR T3=1 TO 5:CF=CF(T3):PC=PC(T3):WG=WG(T3):WT=WG*WT(T3):HP=HP(T3):LP=1-HP:LM=LM(T3):LZ=LM*150:TZ=TZ+LZ:C$=C$(T3)
70 FORSC=1TOLM*150
75 WT=WG*(HP+(LZ-SC)/LZ*LP)
76 LM=L-PC:IFLM<1THENLM=1
77 HM=L+PC:IF HM+WT>59 THEN HM=59-WT
80 L=RND(HM-LM+1)+LM-1
100 PRINTSTRING$(L,191);STRING$(WT," ");STRING$(61-WT-L,191):SET(RND(120),42)
110 P1=PEEK(14344):P2=PEEK(14400):C=0:C2=0:IFP1=0ANDP2=0THEN115ELSEIF P1=4THENC2=1ELSEIFP1=1THENC2=-1
112 IF P2=32THENC=1ELSEIFP2=64THENC=-1
115 IFPL=2THENCK=CK+C2:PRINT@CK,C2$;
116 IF PL=2 AND CK>CL THEN PRINT@62,"X";ELSEPRINT@62,CHR$(34);
120 CL=CL+C:PRINT@CL,C1$;:IFRND(100)<HC*CFTHENPRINT@RND(WT-3)+L+896,C$;
125 PRINT@960,"";:IFPL=2AND(POINT(2*CK,3)=-1ORPOINT(2*CK+6,3)ORPOINT(2*CK+3,3)=-1)THENM2=M2+1:TR=1
130 IFPOINT(2*CL,3)=-1ORPOINT(2*CL+6,3)=-1ORPOINT(2*CL+3,3)=-1THENM1=M1+1:TR=-1
135 IFTR<>0THENGOTO350ELSEPRINT@960,"";
140 IFINT(SC/15)=SC/15THENG=G+.1:PRINT@896,G;:PRINT@960,"";
145 'PASS THOUGHIFPOINT(CL*2-1,2) AND POINT(CK*2+7,2)THENCL=CL+2:CK=CK-2
149 NEXT SC,T3
150 PRINT"THE RACE OVER  ":FORY=1TO600:NEXT:CLS:PRINT"CONGRATULATIONS, YOUR SPEED WAS":PRINT@485,TZ/(M1+1):IFPL=2THENPRINT@455,TZ/(M2+1);:GOTO 400 ELSE 400
350 FORU=1TO500:NEXT:PRINT@960,"";:IFTR=-1THENPRINT@CL,"BANG";ELSEIFTR=1THENPRINT@CK,"BANG";
360 TR=0:GOTO135
400 A$="":PRINT:INPUT"AGAIN";A$:IFA$<>"NO"THENRUN
1000 REM    DELTA    WITH   SIZE SIGN  SIZE   LENGTH DENSITY
1010 DATA       6,      40,     1,      .5,	     .5,		     1,
                0,      20 ,    1,      .99,    .2,     2,     
                2,     12,     1,      .99,    .5,     0
1020 DATA       1,      35,     1,      .7,      .5,     5,
                4,      35,     1,      .1,    .5,      .1
