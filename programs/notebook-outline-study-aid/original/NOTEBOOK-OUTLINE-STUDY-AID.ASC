5 POKE16553,255
7 CLEAR300
10 CLS:PRINT:PRINT:PRINT"                                  NOTEBOOK"
20 PRINT:PRINT:    PRINT"                        A  C.A.I.  USING AN OUTLINE":PRINT:PRINT:PRINT:PRINT"PRESS <SPACE>"
30 A$=INKEY$:IFA$=""THEN30ELSECLS
40 INPUT"HOW MANY LEVELS WOULD YOU LIKE TO PENITRATE";L
50 INPUT"WHERE SHOULD I START AND WHERE SHOULD I END (LINE,LINE) TYPE 0,0 IF ALL.";S,E
60 CLS:RESTORE
65 READO$:IFO$="DONE"THEN999ELSEPRINTTAB(25) O$:PRINT
70 READ O$:IFO$="DONE"THEN999
80 IFLEN(STR$(VAL(O$)))<L+3 AND((VAL(O$)<E AND VAL(O$)>=S)ORE=0)THEN90ELSE300
90 PRINTTAB(LEN(STR$(VAL(O$)))*2) O$
300 GOTO70
999 END
