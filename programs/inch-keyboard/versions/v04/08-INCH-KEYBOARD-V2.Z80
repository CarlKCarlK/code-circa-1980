KEYSCN	LD	C,0		;FOR FIRST ROW
	LD	A,(3801H)	;FIRST ROW ADDRESS
	OR	A		;TEST ZERO OR NON-ZERO
	JP	NZ,KEY10	;GO IF KEY PRESSED
	LD	C,8		;REPEAT FOR OTHER ROWS
	LD	A,(3802H)
	OR	A
	JP	NZ,KEY10
	LD	C,16
	LD	A,(3804H)
	OR	A
	JP	NZ,KEY10
	LD	C,24
	LD	A,(3810H)
	OR	A
	JP	NZ,KEY10
	LD	C,32
	LD	A,(3820H)
	OR	A
	JP	NZ,KEY10
	LD	C,40
	LD	A,(3840H)
	OR	A
	JP	NZ,KEY10
	LD	C,48
	LD	A,(3808H)
	OR	A
	JP	Z,KEYSCN	;GO IF NO KEY PRESSED
KEY10	PUSH	AF
	LD	A,(3880H)	; CHECK FOR SHIFT
	OR	A
	JP	Z,KEY15
	LD	A,51  ; 51 IS THE NON SHIFT CHAR SET
	ADD	A,C
	LD	C,A
KEY15	POP	AF
	LD	B,0FFH	; INDEX
KEY20	INC	B	; DECREMENT (?) INDEX
	SRL	A	; SHIFT 'TIL NON-ZERO
	JP	NZ,KEY20	; GO IF NOT ZERO
	LD	A,B	; GET # 0-7
	ADD	A,C	; ADD ROW #
	LD	C,A	; INDEX 0-15 TO C
	LD	B,0	; ZERO B FOR ADDR
	LD	HL,TABLE	; TABLE OF CHARACTERS
	ADD	HL,BC	; COMPUTE DISPLACEMENT
	LD	A,(HL)	; GET CHARACTER
STOP	NOP
	LD	(3C00H+512+32),A	;DISPLAY
	LD	C,10
LOOP	LD	B,0	; DELAY ABOUT 17 MILLISEC
LOOP1	DJNZ	LOOP1
	DEC	C
	JP	NZ,LOOP
	JP	KEYSCN	; GO FOR NEXT KEY
TABLE	DEFM	'@ABCDEFGHIJKLMNOPQRSTUVW0123456789:;,-./'
	DEFB	13
	DEFB	31
	DEFB	03
	DEFB	91
	DEFB	26
	DEFB	08
	DEFB	25
	DEFB	32
	DEFM	'XYZ:ABCDEFGHIJKLMNOPQRSTUVW*!"#$%&'
	DEFB	39
	DEFM	'()*+<=>?'
	DEFB	13
	DEFB	31
	DEFB	03
	DEFB	91
	DEFB	92
	DEFB	29
	DEFB	94
	DEFB	32
	DEFM	'XYZ'
	END
