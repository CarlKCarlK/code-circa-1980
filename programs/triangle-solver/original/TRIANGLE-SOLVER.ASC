100 PI=3.14159
200 INPUT"WHAT ARE SIDES A,B,C (ANSWER -1 IF YOU DON'T KNOW)";A(1),A(2),A(3)
220 INPUT"WHAT ARE ANGLES A,B,C IN DEGREES (ANSWER -1 IF YOU DON'T KNOW) ";A(4),A(5),A(6)
230 FOR C=4TO6:H=INT(A(C))+(A(C)-INT(A(C)))*10/6:A(C)=A(C)/180*PI:NEXTC
240 FOR C=1TO6
250 IF A(C)>0THEN F=F+1
260 NEXT C
270 IF F>=3 THEN F=0:GOTO 300
280 PRINT"SORRY NOT ENOUGH INFORMATION."
290 END
300 FOR C=4TO6
310 IF A(C)>0THEN F=F+1
320 NEXT C
330 IF F<>2 THEN 400
340 IF A(4)=-1THEN A(4)=180-A(5)-A(6)
350 IF A(5)=-1THEN A(5)=180-A(4)-A(6)
360 IF A(6)=-1 THEN A(6)=180-A(5)-A(4)
370 GOTO 450
400 IF F=3 AND A(4)+A(5)+A(6)>180 THEN PRINT"NON-EXISTANT TRIANGLE":END
450 F=0:FORC=1TO3
460 IF A(C)>0THENF=F+1
470 NEXT C
480 IF F<3 THEN 550
490 IF A(1)>A(2)+A(3)OR A(2)>A(1)+A(3) OR A(3)>A(2)+A(1) THEN PRINT "NON-EXISTANT TRIANGLE":END
550 IF A(1)=-1ORA(2)=-1OR A(3)=-1 THEN 800
552 FOR T=1TO3:S=T+1:IFS>=4THENS=S-3
554  R=S+1:IFR>=4THENR=R-3
560 H=(A(T)[2-A(S)[2-A(R)[2)/(-2*A(S)*A(R))
570 GOSUB1000
580 A(T+3)=H
590 NEXT T:GOTO 3000
800 IF (A(4)<>-1ANDA(2)<>-1ANDA(3)<>-1) THEN T=4:R=2:S=3ELSE IF(A(5)<>-1 AND A(1)<>-1 AND A(3)<>-1) THEN T=5:R=1:S=3ELSE IF(A(6)<>-1 AND A(1)<>-1 AND A(2)<>-1) THEN T=6:R=1:S=2 ELSE 900
810 A(T-3)=SQR( A(S)[2+A(R)[2-2*A(S)*A(R)*COS(A(T)))
820 GOTO 552
900 FORC=1TO3
910 IF A(C)<>-1ANDA(C+3)<>-1THENT=(C+3):R=(C)ELSEIFA(C)<>-1THEN S=(C)
920 NEXT
930 H=A(T)
940 GOSUB2000
950 A(S+3)=H:A(S+6)=180-A(S+3):A(R+3)=180-A(S+3)-T:A(R+6)=180-A(S+6)-T
960 IF A(R)>A(S)THEN A(R+6)=0:A(S+6)=0
970 R1=R:S1=S:T1=T
980 GOTO 400
1000 'REM ARCCOS FOR H TO H
1010 H=-ATN(H/SQR(-H*H+1))+1.5708
1020 RETURN
2000 REM SIN H IN H OUT
2010 H=ATN(H/SQR(-H*H+1))
2020 RETURN
3000 FORC=1TO6
3010 RESTORE:READ A$
3015 IF C>=4 THEN A(C)=A(C)/PI*180:A(C)=INT(A(C))+(A(C)-INT(A(C)))*60/100
3020 PRINT A$;A(C),
3030 DATA SIDE A,SIDE B,SIDE C,ANGLE A,ANGLE B,ANGLE C
3040 IF C=3 THEN PRINT
3050 NEXT C
3060 IF A(S1+6)<>0AND S1<>0 THEN A(S1+3)=A(S1+6):A(R1+3)=A(R1+6):A(S1+6)=0:GOTO 400
4000 END
