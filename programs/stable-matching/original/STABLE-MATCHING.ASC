2 P=979
10 CLEAR 2000
50 INPUT "HOW MANY MEN (MUST BE AN EQUAL # OF MEN & WOMEN)";N
80 DIM P(N,N,1),N$(N,1)
100 FOR L=0 TO1:FOR I=1 TO N
105 CLS
110 READ N$(I,L)
115 FOR J=1 TO N
120 PRINT"I WANT ";
125 IF L THEN PRINT"WOMEN #"; ELSE PRINT "MAN #";
130 PRINT I;"'S PREFERENCE FOR ";:IF L THEN PRINT"MAN #"; ELSE PRINT"WOMAN #";
135 PRINT J;":":READ P(I,J,L)
140 NEXT J,I,L
199 '         TO      THE      ALTAR!!!
210 DATA ALFRED,3,2,1,4,5,BARRY,1,2,3,4,5,GERALD,3,2,1,4,5,DARREL,1,2,3,4,5,ROGER,3,1,2,4,5,ALFA,3,5,4,2,1,BEATRICE,5,1,4,3,2,GINNIA,3,5,2,1,4,NOBODY,1,2,3,4,5,NOBODY,1,2,3,4,5
10000 '     PROPOSING
10003  PRINT"    WORKING ON THE PERFECT MATCHUP"
10005 ' INPUT PREFERENCE(SEX, OTHER SEX,M OR F)                        AND NAME$(NUMBER,M OR F)  <M=0  F=1>
10010 DIM PP(N),RJ(N)
10090 FOR S=0 TO 1
10100 FOR I=1TON
10110 FOR J=1TON:IF RJ(I)+1<>P(I,J,S) THEN NEXT J
10115 IF PEEK(14400)=10 THEN CLS:DELETE 200-201
10120 PP(I)=J:FORJ=1TO1:NEXTJ:NEXT I
10130 DO=-1:FOR J=1TON:B=N+1:BB=0
10140     FOR I=1 TO N:IF PP(I)=J THEN IF P(J,I,1-S)<B THEN               RJ(BB)=RJ(BB)+1:B=P(J,I,1-S):BB=I ELSE RJ(I)=RJ(I)+1
10143 IF PEEK(14400)=10 THEN CLS:DELETE 200-201
10145 		     NEXT I
10150 IF B=N+1 THEN DO=0
10160 NEXT J
10165 'FOR C=1 TO N:PRINTN$(PP(C),1-S):NEXT C:GOSUB 10555
10170 IF NOT DO THEN 10100
10175 IF S=1 THEN PRINT@960+14,"<TYPE ANY KEY TO CONTINUE>";:GOSUB 10557
10180 GOSUB 10500:'  PRINT OUT 
10190 FOR I=1TON:RJ(I)=0:NEXTI
10195 NEXT S
10499 END
10500 '    PRINT OUT STUFF
10520 CLS:PRINT"            THE STABLE MATCHES ARE AS FOLLOWS:":PRINT:PRINT:PRINT
10530 FOR I=1 TO N
10535 IF PEEK(14400)=10 THEN CLS:DELETE 200-201
10540 PRINT TAB(20); N$(I,S);" AND ";N$(PP(I),1-S)
10550 NEXT I
10553 RETURN
10555 PRINT@960+14,"  <TYPE ANY KEY TO CONTINUE>";
10557 IF INKEY$="" THEN 10557
10560 RETURN
