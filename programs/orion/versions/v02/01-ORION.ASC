10 REM ORION, TRS-80 VERSION-COPYRIGHT 1979, AUTOMATED SIMULATIONS, REV 1
14 DEFINTI-Y
15 Q=9:C%=15360:T%=0:B$="ENERGY LEFT="
20 DIMX(Q,1),Y(Q,1),SN%(Q,1),H%(Q,1),P%(9),MX%(99),MY%(99),ML%(99),XO(Q,1),YO(Q,1)
21 DIMDR%(Q,1),BM%(Q,1),SH%(Q,1),LN%(Q,1),MS%(Q,1),TP%(Q,1),EN%(Q,1),BQ%(Q,1),AR%(Q,1)
25 DIMNS(1),MA%(Q,1),BN%(Q,1),TN%(Q,1),F%(Q,1),GN%(Q,1),V%(8),W%(8)
30 V%(1)=0:W%(1)=-1:V%(2)=1:W%(2)=-1:V%(3)=1:W%(3)=0:V%(4)=1:W%(4)=1:V%(5)=0:W%(5)=1:V%(6)=-1:W%(6)=1:V%(7)=-1:W%(7)=0:V%(8)=-1:W%(8)=-1
35 CLS:PRINTCHR$(23):PRINT@208,"STARFLEET  ORION":PRINT@658,"COPYRIGHT 1979":PRINT@778,"AUTOMATED  SIMULATIONS":FORI=1TO1500:NEXTI
40 GOSUB5000
45 CLS:PRINTTAB(23);"BATTLE  PROGRAM"
46 RANDOM
47 INPUT"DO YOU WANT SOUND";SD$:INPUT"DO YOU WANT THE PRINTER";PR$
49 REM SCENARIO INITIALIZATION
50 PRINT"ENTER SCENARIO":INPUTN$
52 PRINT"PRESS PLAY"
55 INPUT#-1,M$
56 PRINT"SCENARIO: "M$
60 INPUT#-1,NS(0),NS(1):FORI=0TO1
65 FORJ=0TONS(I)
70 INPUT#-1,DR%(J,I),BM%(J,I),SH%(J,I),LN%(J,I),MS%(J,I),TP%(J,I),EN%(J,I),BQ%(J,I),AR%(J,I),X(J,I),Y(J,I),MA%(J,I)
90 IFX(J,I)=0THENX(J,I)=RND(61)-1
95 IFY(J,I)=0THENY(J,I)=RND(33)-1
100 NEXTJ:NEXTI
110 INPUT#-1,PL,P%(0),P%(1),P%(2),P%(3),P%(4),P%(5),P%(6),P%(7),P%(8),P%(9),B%,M%
115 IFN$=M$GOTO210ELSEGOTO55
128 REM UTILITY SUBROUTINES
130 PRINT@770,"RANGE TO":GOSUB150:IFLEN(A$)>1GOTO130
131 IFJ*IJ=15THENJ=0:ELSEIFJ<0ORJ>Q-1GOTO130
132 XX=XO(J,IJ)-XO(N,II)-XN:YY=YO(N,II)-YO(J,IJ)+YN:RR=SQR(XX[2+YY[2)
134 PRINT@770,"X RANGE:"XX;" Y RANGE:"YY;" DISTANCE:"RR:FORJ=1TO1800:NEXTJ
136 GOSUB190:RETURN
140 IFA>61THENA=61
141 IFA<1THENA=1
142 IFB>34THENB=34
143 IFB<2THENB=2
144 RETURN
150 A$=INKEY$:IFLEN(A$)=0GOTO150ELSEJ=ASC(A$)
170 IJ=0:IFJ>64THENIJ=1:J=J-65ELSEJ=J-49
175 IFJ<0ORJ>QGOTO150
190 FORJJ=770TO898STEP64:PRINT@JJ,"                                                           ";
192 NEXTJJ:PRINTCHR$(25);CHR$(25);" ";:FORTK=0TO127:SET(TK,47):NEXTTK:FORTK=36TO47:SET(0,TK):SET(127,TK):NEXT:RETURN
200 CLS:FOR AB%=1TO25:PRINT@ RND(703),".";:NEXT:FORI=0TO1:FORJ=0TONS(I)
203 A=C%+X(J,I)+64*INT(Y(J,I)/3)+2:B=49+J:IFI=1THENB=65+J
204 IFY(J,I)>=0THENPOKEA,B
205 NEXTJ:NEXTI
206 FORI=0TO1:FORJ=0TONS(I):A=X(J,I)*2:B=Y(J,I):IFB>0THENSET(A+1,B):SET(A,B)
207 IFPL*I*(J+1)=1THENSET(A-1,B):SET(A+2,B):SET(A,B-1):SET(A+1,B-1):SET(A,B+1):SET(A+1,B+1)
208 NEXTJ:NEXTI:FORJ=0TO127:SET(J,35):SET(J,47):NEXTJ:FORTK=36TO47:SET(0,TK):SET(127,TK):NEXTTK
209 RETURN
210 FORI=0TO1:FORJ=0TONS(I):XO(J,I)=X(J,I):YO(J,I)=Y(J,I):NEXTJ:NEXTI:GOSUB200:K=0
223 REM COMMAND LEVEL LOOP
225 A$=INKEY$:IFA$="C"THENGOSUB190:GOTO225
226 FORTK=1TO2:OUT255,TK:NEXTTK
230 IFA$="S"GOTO310
235 IFA$="O"GOTO410
240 IFA$="M"GOTO705
242 IFA$="W"GOTO2000
245 GOTO225
308 REM STATUS DISPLAY
310 GOSUB190:PRINT@770,"ENTER SHIP":GOSUB150:IFJ*IJ=15THENJ=0
312 IFJ<0ORJ>Q-1GOTO225
315 PRINT@770,"ENER"EN%(J,IJ);"DRV"DR%(J,IJ);"BEAM"BM%(J,IJ);"SHLD"SH%(J,IJ)
316 IF PR$="YES"THEN LPRINT"ENERGY"EN%(J,IJ);"DRIVE"DR%(J,IJ);"BEAM"BM%(J,IJ);"SHILD"SH%(J,IJ)
319 IF PR$="YES"THEN LPRINT"LUNCH"LN%(J,IJ);"MISSLE"MS%(J,IJ);"TORPEDO"TP%(J,IJ)
320 PRINT@834,"LNCH"LN%(J,IJ);"MSL"MS%(J,IJ);"TORP"TP%(J,IJ):GOTO225
408 REM ENTER ORDER
410 MN=0:GOSUB190:PRINT@770,"ENTER SHIP";:GOSUB150:N=J:II=IJ:IFJ*IJ=15THENN=0:ELSEIFN>Q-1ORN<0GOTO225
415 XN=0:YN=0:LX%=X(N,II):IFLX%>64THENPRINT@770,"NOT IN PLAY":GOTO225
420 LY%=Y(N,II):IFF%(N,II)>0THENPRINT@770,"ALREADY ENTERED":GOTO225
425 E=EN%(N,II):GN%(N,II)=0:DR=DR%(N,II)
430 F%(N,II)=1:IFPLCINT(N+1)*II=1GOTO490
435 PRINT@770,"X MOVE (-LEFT) MASS="INT(MA%(N,II)/36*100+.5)/100
440 INPUTA$:GOSUB190:IFA$="R"THENGOSUB130:GOTO435:ELSEXN=VAL(A$)
445 PRINT@770,"Y MOVE (-DOWN)":INPUTA$:GOSUB190:IFA$="R"THENGOSUB130:GOTO445:ELSEYN=-VAL(A$)
450 DE=INT(MA%(N,II)*SQR(XN*XN+YN*YN)/36+.99)
455 IFDE>ETHENPRINT@898,"ENERGY SHORT":XN=0:YN=0:GOTO435
460 IFDE>DRTHENPRINT@898,"DRIVE SHORT";:XN=0:YN=0:GOTO435
465 A=LX%+XN:B=LY%+YN
470 IFA>0ANDA<65ANDB>0ANDB<37GOTO485
475 PRINT@770,"ENTER Y FOR ESCAPE":INPUTA$:IFA$<>"Y"THENXN=0:YN=0:GOTO435
480 X(N,II)=65:Y(N,II)=-2:GOTO225
485 X(N,II)=A:Y(N,II)=B:E=E-DE:DR=DR-DE:LX%=A:LY%=B:IFE=0GOTO225
490 IFM%=0ORDR=0GOTO545
493 A=DR:IFE<ATHENA=E
495 PRINT@770,"tRACTOR, MAX="A:INPUTA$:GOSUB190:IFA$="R"THENGOSUB130:GOTO495:ELSEL=VAL(A$):IFL=0GOTO545
500 IFABS(L)>DRTHENPRINT@898,"DRIVE SHORT";:GOTO495
505 IFABS(L)>ETHENPRINTCHR$(25);CHR$(25);"ENERGY SHORT";:GOTO495
510 PRINT@770,"TARGET":GOSUB150:IFJ=15ANDIJ=1THENJ=0
512 IFJ<0ORJ>Q-1GOTO510
515 DR=DR-ABS(L):E=E-ABS(L):A=LX%-X(J,IJ):B=LY%-Y(J,IJ)
520 DE=SQR(A*A+B*B):LL=L/((DE/3+1)*MA%(J,IJ)/36):IFDE=0GOTO490
525 S%=A*LL/DE:LL=B*LL/DE
530 IFL>0THENIFABS(S%)>ABS(A)ORABS(LL)>ABS(B)THENS%=A:LL=B
535 A=X(J,IJ)+S%:B=Y(J,IJ)+LL:GOSUB140:X(J,IJ)=A:Y(J,IJ)=B:IFDR>0GOTO490
545 IFBM%(N,II)<=0GOTO585
550 PRINT@770,B$;E;"BEAM":PRINTCHR$(25);CHR$(25);:INPUTA$:GOSUB190:IFA$="R"THENGOSUB130:GOTO550:ELSEB=VAL(A$)
555 IFB>BM%(N,II)ORB>ETHENPRINT@962,"TOO MUCH";:GOTO550
560 IFB<=0GOTO585
565 BN%(N,II)=B:E=E-B
570 PRINT@770,"TARGET"
575 GOSUB150:IFJ*IJ=15THENJ=0
577 IFJ>(Q-1)GOTO570
580 IFB%=0THENIFII=IJGOTO570
585 TN%(N,II)=J+100*IJ:IFE=0GOTO225
590 IFSH%(N,II)<=0GOTO615
595 PRINT@770,B$;E;"SHIELD":PRINTCHR$(25);CHR$(25);:INPUTA$:GOSUB190:IFA$="R"THENGOSUB130:GOTO595:ELSES%=VAL(A$)
600 IFS%>EORS%>SH%(N,II)THENPRINT@962,"TOO MUCH";:GOTO595
605 IFS%<=0GOTO615
610 E=E-S%:SN%(N,II)=S%:IFE=0GOTO225
615 RS=MS%(N,II):IFLN%(N,II)=0ORRS=0GOTO685
620 PRINT@770,B$;E;"MISSILES":PRINTCHR$(25);CHR$(25);:INPUTA$:GOSUB190
622 IFA$="R"THENGOSUB130:GOTO620
623 MN=VAL(A$)
625 IFMN<=0GOTO685
630 IFMN>ETHENPRINT@962,"ENERGY SHORT";:GOTO620
635 IFMN>LN%(N,II)THENPRINT@962,"LAUNCH TUBES SHORT";:GOTO620
640 IFMN>RSTHENPRINT@962,"MISSILES SHORT";:GOTO620
645 E=E-MN:MS%(N,II)=RS-MN
650 FORJK=1TOMN
655 PRINT@770,"X(-LEFT)":PRINTCHR$(25);CHR$(25);:INPUTA$:GOSUB190:IFA$="R"THENGOSUB130:GOTO655
656 XM=VAL(A$)
657 PRINT@770,"Y(-DOWN)":PRINTCHR$(25);CHR$(25);:INPUTA$:GOSUB190:IFA$="R"THENGOSUB130:GOTO657
658 YM=-VAL(A$)
660 IFSQR(XM*XM+YM*YM)-.01>P%(II+4)THENPRINT@962,"TOO FAR";:GOTO655
665 IFK>=99THENPRINT@962,"TOO MANY MISSILES";:GOTO685
670 A=LX%+XM:B=LY%+YM:GOSUB140
675 K=K+1:MX%(K)=A:MY%(K)=B:ML%(K)=II
680 NEXTJK
685 LL=TP%(N,II):IFE=0ORLN%(N,II)=MNORLL=0GOTO225
690 PRINT@770,"TORPEDO DIRECTION (1 IS UP)":PRINTCHR$(25);CHR$(25);:INPUTA$:GOSUB190:IFA$="R"THENGOSUB130:GOTO690:ELSEL=VAL(A$)
695 IFL<=0ORL>8GOTO225
700 TP%(N,II)=LL-1:GN%(N,II)=L:GOTO225
704 REM MOVEMENT RESOLUTION
705 T%=T%+1:PRINT@770,"TURN"T%;:FORI=1TO800:NEXTI
710 GOSUB200:FORI=0TO1:FORJ=0TONS(I):H%(J,I)=0:F%(J,I)=0:NEXTJ:NEXTI
715 FORII=0TO1:FORN=0TONS(II)
720 IFBN%(N,II)<=0GOTO755
725 J=TN%(N,II):IJ=0:IFJ>99THENIJ=1:J=J-100
727 IFY(J,IJ)<0GOTO755
730 D=SQR((X(N,II)-X(J,IJ))[2+(Y(N,II)-Y(J,IJ))[2)
735 IFD=0GOTO745
740 IFRND(1000)/1000>(MA%(J,IJ)[.67/(D*3.2*.9[BQ%(N,II)+4))GOTO755
745 L=BN%(N,II)*10/(D+5)-AR%(J,IJ)
747 FORM=1TO15:A=2*X(J,IJ):B=Y(J,IJ):RESET(A,B):RESET(A+1,B):M=M*1:SET(A,B):GOSUB6000:SET(A+1,B):NEXTM
750 IFL>0THENH%(J,IJ)=H%(J,IJ)+INT(L+.5)
755 BN%(N,II)=0
756 NEXTN:NEXTII
760 IFK=0GOTO806
765 FORN=1TOK:L=ML%(N):FORIJ=0TO1:FORJ=0TONS(IJ)
770 B=ABS(MX%(N)-X(J,IJ)):LP=ABS(MY%(N)-Y(J,IJ))
775 A=P%(L)-AR%(J,IJ):IFA<0THENA=0
780 IFB=0ANDLP=0THENH%(J,IJ)=H%(J,IJ)+A:GOTO795
785 E=P%(L+2)-AR%(J,IJ):IFE<0GOTO795
790 IFB<=1ANDLP<=1THENH%(J,IJ)=H%(J,IJ)+E
795 NEXTJ:NEXTIJ
800 POKEC%+MX%(N)+64*INT(MY%(N)/3),42:FORTK=1TO30:FOROT=1TO2:OUT255,OT:NEXTOT,TK
805 NEXTN
806 GOSUB1100
810 FORIJ=0TO1:FORJ=0TONS(IJ)
815 H=H%(J,IJ)-SN%(J,IJ):SN%(J,IJ)=0
820 MM=INT(3+DR%(J,IJ)+BM%(J,IJ)+SH%(J,IJ)+LN%(J,IJ)+MS%(J,IJ)/4+TP%(J,IJ)/2+EN%(J,IJ))
825 IFPL*IJ*(J+1)=1ANDMM=3ORH<=0GOTO930
830 R=RND(MM):RS=0:RS=RS+EN%(J,IJ)+3:IFR>RSGOTO840
835 IFEN%(J,IJ)=0GOTO895ELSEH=H-1:EN%(J,IJ)=EN%(J,IJ)-1:GOTO925
840 RS=RS+DR%(J,IJ):IFR>RSGOTO850
845 H=H-1:DR%(J,IJ)=DR%(J,IJ)-1:GOTO925
850 RS=RS+BM%(J,IJ):IFR>RSGOTO853
851 H=H-1:BM%(J,IJ)=BM%(J,IJ)-1:GOTO925
853 RS=RS+SH%(J,IJ):IFR>RSGOTO860
855 H=H-1:SH%(J,IJ)=SH%(J,IJ)-1:GOTO925
860 RS=RS+LN%(J,IJ):IFR>RSGOTO870
865 H=H-1:LN%(J,IJ)=LN%(J,IJ)-1:GOTO925
870 RS=RS+INT(MS%(J,IJ)/4+.75):IFR>RSGOTO883
875 H=H-1:MS%(J,IJ)=MS%(J,IJ)-4:IFMS%(J,IJ)<0THENMS%(J,IJ)=0
880 GOTO925
883 RS=RS+INT(TP%(J,IJ)/2+.5):IFR>RSGOTO830
885 H=H-1:TP%(J,IJ)=TP%(J,IJ)-2:IFTP%(J,IJ)<0THENTP%(J,IJ)=0
890 GOTO925
895 XX=2*X(J,IJ)+1:YY=Y(J,IJ):IFPL*(J+1)*IJ=1GOTO930
900 RESET(XX-1,YY):SET(XX+1,YY-1):SET(XX+1,YY+1):GOSUB6000:SET(XX-1,YY+1):SET(XX-1,YY-1):SET(XX+2,YY):SET(XX-2,YY):FORM=1TO50:NEXTM
905 SET(XX+2,YY-2):SET(XX+2,YY+2):SET(XX-2,YY+2):SET(XX-2,YY-2):SET(XX+4,YY):SET(XX-4,YY)
907 GOSUB6000
910 RESET(XX,YY):BN%(J,IJ)=0
920 X(J,IJ)=65:Y(J,IJ)=-2:GOTO930
925 IFH>0GOTO830
930 NEXTJ:NEXTIJ
935 JK=400+(NS(0)+NS(1))*50:FORJ=1TOJK:J=J*1:NEXTJ:GOTO210
1095 REM TORPEDO RUN SUBROUTINE
1100 FORI=0TO1:FORM=0TONS(I)
1110 L=GN%(M,I):VV=2*V%(L):WW=W%(L)
1120 AJ=0:A=2*X(M,I)+1:B=Y(M,I):IFL=0GOTO1492
1130 AL=SQR((VV/2)[2+WW[2)
1140 XX=A+VV:YY=B+WW:AJ=AJ+AL:IFAJ>P%(I+8)GOTO1492
1150 IFXX>127ORYY>35GOTO1492
1160 IFXX<0ORYY<0GOTO1492
1170 IFVV<>0ANDWW<>0GOTO1250
1180 E=1:GOTO1400
1190 XX=XX+VV:YY=YY+WW:E=7:GOTO1400
1200 DX=2:DY=0:IFWW=0THENDX=0:DY=1
1210 XX=XX+DX-VV:YY=YY+DY-WW:E=2:GOTO1400
1220 XX=XX+DX+VV:YY=YY+DY+WW:E=8:GOTO1400
1230 XX=XX-3*DX-VV:YY=YY-3*DY-WW:E=3:GOTO1400
1240 XX=XX-DX+VV:YY=YY-DY+WW:E=9:GOTO1400
1250 E=4:GOTO1400
1260 XX=XX+VV:YY=YY+WW:E=10:GOTO1400
1270 XX=XX-VV-VV:YY=YY-WW:E=5:GOTO1400
1280 YY=YY+WW:E=11:GOTO1400
1290 XX=XX+VV:YY=YY-WW-WW:E=6:GOTO1400
1300 XX=XX+VV:E=12:GOTO1400
1310 A=A+VV:B=B+WW
1315 JJ=C%+INT(A/2)+64*INT(B/3):AB=PEEK(JJ):SET(A,B):GOSUB6000
1318 FORLQ=1TO3:LQ=LQ*1:NEXTLQ
1320 POKEJJ,AB
1330 GOTO1140
1400 X1=(XX-1)/2:BA=PEEK(C%+X1+INT(YY/3)*64):IFBA<>32AND BA<>46THENIFK>0THENFORNN=1TOK:IFMY(NN)=YYTHENIFMX(NN)=X1GOTO1492ELSENEXTNN:ELSENEXTNN
1402 IFBA=32ORBA=46THENGOTO1440
1410 II=2
1412 II=II-1:JX=(XX-1)/2:FORN=0TONS(II)
1420 IFX(N,II)=JXANDY(N,II)=YYGOTO1450
1430 NEXTN:IFII>0GOTO1412
1440 ONEGOTO1190,1220,1240,1260,1280,1300,1200,1230,1310,1270,1290,1310
1450 JJ=C%+(XX-1)/2+64*INT(YY/3):AB=PEEK(JJ):POKEJJ,64:GOSUB6000
1460 E=P%(I+6)-AR%(N,II):IFE<0THENE=0
1470 H%(N,II)=H%(N,II)+E
1480 POKEJJ,AB
1492 GN%(M,I)=0:NEXTM:NEXTI:K=0:RETURN
