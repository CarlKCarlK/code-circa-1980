10 'PLACE NO. OF QUESTIONS ON THIS LINE AS 'Q'
20 Q=Q*2
30 DIMA$(100)
40 RESTORE
80 CLEAR(1000)
90 POKE16553,255
100 FORI=1TOQ
110 READA$(I)
120 NEXTI
180 C=0:U=0
190 K=-1
200 FORI=1TOQ STEP2
210 PRINT:PRINT A$(I);
215 U=U+1
220 INPUTB$
230 IFB$=A$(I+1)THENPRINT"THAT'S RIGHT!!!":C=C+1 ELSE PRINT"THE CORRECT ANSWER IS ";A$(I+1):K=K+2:A$(K)=A$(I):A$(K+1)=A$(I+1)
240 NEXTI
520 Q=2*(U-C)
590 IFU=OTHEN610
600 PRINT:PRINT:PRINT"OUT OF";U;" QUESTIONS, YOU GOT";C;" RIGHT.  THAT IS";100*C/U;"% RIGHT."
610 IFC/U<>1THENPRINT"WOULD YOU LIKE TO TRY THOSE YOU MISSED";:INPUTZ$:IF Z$="YES"THEN180
620 INPUT"WOULD YOU LIKE TO START ALL OVER AGAIN";Z$:IFZ$="YES"THEN40 ELSE STOP
1000 'DATA OF QUESTONS AND ANSWERS GOES HERE
