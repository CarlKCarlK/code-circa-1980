10 DIM A$(20),V1(20),V2(20),W(20)
20 FOR I=1TO2:READ C(I),CM(I),CP(I):PRINTC(I),CM(I),CP(I):NEXTI
30 FOR I=1TO2
40 M(I)=CM(I)-C(I)
50 S(I)=CP(I)-CM(I)
60 SW=32.06
70 SM(I)=S(I)/SW
80 MG(I)=M(I)/SM(I)
90 NEXT I
100 PRINTM(1);M(2):PRINTS(1);S(2):PRINTMG(1);MG(2)
105 PRINT:PRINT
110 READ A$(E+1),V1(E+1),V2(E+1)
120 IF V1(E+1)<0 THEN V1(E+1)=-V1(E+1):READ W(E+1) ELSE W(E+1)=V2(E+1):V2(E+1)=0
130 IF A$(E+1)="ZZ"THEN 300
135 E=E+1
140 GOTO 110
300 FOR EL=1TO E
310 PW=V1(EL)/2* (MG(1)+MG(2))/2
320 PC=(PW-W(EL))/PW*100
330 PRINTA$(EL);V1(EL),INT(PC+.5);"%"
340 IF V2(EL)<>0 THEN V1(EL)=V2(EL):V2(EL)=0:GOTO 310
350 NEXT EL
990 'DATA 19.4011,20.1320,20.3313,20.2821,21.0454,21.2665
998 '
1000 DATA 20.2392 ,21.5864 ,21.8885 ,21.5958 ,23.3098 ,23.6761
