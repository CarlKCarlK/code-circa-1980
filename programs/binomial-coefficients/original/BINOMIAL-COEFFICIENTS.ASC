1 CLS
2 REM  BINOMAL COEFFECINENTS      CMKADIEADDEC1980
5 DEFDBL A-Z
10 INPUT"WHICH ROW, COLLUM";R,C
20 IF C>R THEN PRINT"TRY AGAIN....":GOTO 10
25 A=1
26 PRINTCHR$(151)"    "R"    "CHR$(171):PRINT CHR$(149) TAB(10+LEN(STR$(R))) CHR$(170 ):PRINT CHR$(181)"    "C TAB(10+LEN(STR$(R)))   CHR$(186)CHR$(27)"  >>>----	"CHR$(94)" ";
30 D=R-C:IF D>C THEN H=C:C=D:D=H
32 Y=D+1
35 X=R-D
40 X=X+1
50 Y=Y-1
60 IF Y>=1 THEN A=A/Y
80 IF X<=R THEN A=A*X
90 IF Y>=1 AND X<=R THEN 40
100 PRINT A CHR$(26) STRING$(LEN(STR$(A)),CHR$(24)) STRING$(LEN(STR$(A))-1,CHR$(131)); :IF LEN(STR$(A))<=6 THENPRINTCHR$(27) "  =  " R CHR$(24)"!  /( "C CHR$(24)"!  * "D CHR$(24)"! )" CHR$(26)ELSEPRINT
110 PRINT
120 RUN2
1000 FORX=121TO191:PRINTX;CHR$(X),,,:NEXT
