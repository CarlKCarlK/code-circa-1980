5 CLS
10 LINE(0,1)-(0,2),CHR$(191)
12 PI=3.14159
15 X=63:Y=16:A=PI*2*RND(0)
20 DIMP%(25)
25 DEF FNR=RND(0)*PI/2-PI/4
30 GET@(0,0)-(1,11),G,P%
40 CLS
50 LINE(0,0)-(127,0),SET:LINE(0,47)-(127,47),SET
60 LINE(32,0)-(32,15),":"
70 Y(1)=RND(12):Y(2)=RND(12):X(1)=0:X(2)=126
100 A$=INKEY$:IFA$="Z"THEN M(1)=-1 ELSEIFA$="X"THENM(1)=0ELSEIFA$="C"THENM(1)=1ELSEIFA$=","THENM(2)=-1ELSEIFA$="."THENM(2)=0ELSEIFA$="/"THENM(2)=1
110 FORC=1TO2:Y(C)=Y(C)+M(C):PUT@(X(C),Y(C))-(1+X(C),11+Y(C)),SET,P%:NEXT
120 IF Y<3 THEN A=A-PI/2+FNR ELSE IF Y>44 THEN A=A-PI*1.5+FNR
130 IF X<=2 AND Y-3-Y(1)<=6 THEN A=PI-A+FNRELSEIFX>=125 AND Y-3-Y(2)<=6THEN A=A-PI+FNR
140 X=X+COS(A)*4:Y=Y+SIN(A)*2:LINE(OX,OY)-(OX+1,OY),RESET:LINE(X,Y)-(X+1,Y),SET:OX=X:OY=Y
150 GOSUB 100
10000 PRINTFNR:GOTO10000
