10 ' FREEWAY
20 CLS
30 DIM A%(25),B%(25)
40 LINE(0,0)-(3,1),CHR$(191),BF:LINE(0,0)-(0,2),RESET:LINE(7,0)-(7,2),RESET:LINE(1,1)-(1,3),RESET:LINE(6,1)-(6,3),RESET:RESET(2,0):RESET(5,0):RESET(2,1):RESET(5,1):RESET(1,3):RESET(6,5):RESET(6,3):RESET(1,5)
50 GET@(0,0)-(3,1),A%
60 LINE(0,0)-(3,1),CHR$(191),BF:LINE(0,5)-(0,3),RESET:LINE(7,5)-(7,3),RESET:LINE(1,4)-(1,2),RESET:LINE(6,4)-(6,2),RESET:RESET(2,5):RESET(5,5):RESET(2,4):RESET(5,4):RESET(1,2):RESET(6,0):RESET(6,2):RESET(1,0)
70 GET@(0,0)-(3,1),B%
75 CLS
80 FOR C=0TO6:LINE(C*7+11,0)-(C*7+11,15),":":NEXT
90 FOR C=0TO2:LINE(C*28+4,0)-(C*28+4,15),CHR$(191):NEXT
100 LINE(11,9)-(11,15),CHR$(191):LINE(53,0)-(53,6),CHR$(191)
110 FORC=3TO5:R=RND(2):IFR=1THEND(C)=1ELSED(C)=-1
120 CY(C)=RND(16)-1:NEXT:ST=13:FT=48:IFD(3)=1THENCX(3)=ST ELSECX(3)=FT
130 IF D(4)=1THEN CX(4)=ST+7ELSECX(4)=FT-7
140 IF D(5)=1THEN CX(5)=ST+14 ELSE CX(5)=FT-14
150 D(1)=1:D(2)=-1:CX(1)=6:CX(2)=55
160 CY(1)=14
170 M=61
200 A$=INKEY$:IFA$="1"THEN DD=1ELSE IF A$="2"THEN DD=.5ELSE IF A$="3"THEN DD=.25 ELSE IFA$="Z"THEN S=-1ELSEIFA$="X"THENS=0ELSEIFA$="C"THENS=1
205 IFA$="8"THENE=1ELSEIFA$="9"THENE=.5ELSEIFA$="0"THENE=.25ELSEIFA$=","THENT=-1ELSEIFA$="."THENT=0ELSEIFA$="/"THENT=1
210 CY(1)=CY(1)-DD*D(1):CY(2)=CY(2)-E*D(2):CX(1)=CX(1)+S:CX(2)=CX(2)+T
215 FORC=3TO5:CY(C)=CY(C)-RND(0)*D(C):NEXT
218 PRINT@0,CY(1);
220 FOR C=1TO5:LINE(OX(C),OY(C))-(OX(C)+3,OY(C)+1)," ",BF:IFD(C)=1THENPUT@(CX(C),CY(C))-(CX(C)+3,CY(C)+1),A% ELSE PUT@(CX(C),CY(C))-(CX(C)+3,CY(C)+1),B%
230 OX(C)=CX(C):OY(C)=CY(C):IFD(C)=1ANDCY(C)<0THEND(C)=-1:CX(C)=M-CX(C)ELSEIFD(C)=-1ANDCY(C)>15THEND(C)=1:CX(C)=M-CX(C)
240 NEXT
300 FORC1=1TO2:FORC2=1TO5:IFC1=C2THEN350
310 IF NOT(ABS(CX(C1)-CX(C2))<=4 AND ABS(CY(C1)-CY(C2))<=2 )THEN 350
320 IFC1=1THENGOSUB500ELSEGOSUB600
350 IF D(C1)=1 AND( (L(C1)<1 AND CX(C1)<=4) OR (L(C1)>=1 AND CX(C1)<=11))THENGOSUB490  ELSE IF D(C1)=1 AND( (L(C1)<1 AND CX(C1)>=60) OR (L(C1)>=1 AND CX(C1)>=53 )) THEN 490
360 NEXT
370 GOTO200
500 GOTO200
