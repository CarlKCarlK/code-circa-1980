5 CLEAR50
10 DIMD(105),C(7,1),S(4,1),M(1),H$(1),H(1),L(1),FP(4,1),R(1),PM(20)
20 PRINT"SETTING UP DECK  ......  WAIT"
30 FOR C=0TO4:FORP=0TO1:S(C,P)=0:F(C,P)=0:NEXT P,C:  FOR H=0TO1:M(H)=0:T(H)=0:R(H)=0:L(H)=0:CO(H)=0:NEXTH
40 FOR X=0TO105
50 S=RND(X+1)-1
60 D(X)=D(S):D(S)=X:NEXTX
80 PC=0
90 FOR X=0 TO 1:H(X)=1:H$(X)="0NEEDS A ROLL":NEXTX
100 FORX=0TO1:C(0,X)=6:NEXTX
105 FOR Y=0 TO 5:FOR X=0 TO 1
110 C(Y+1,X)=D(X+Y*2)
120 NEXT X,Y
130 PC=12:X=0
200 CLS:'* ACTUAL PLAY *
220 PRINT@463,"PRESS <SPACE BAR> TO DRAW OR":PRINT@529,"<C> TO DO A COUP FOURRE'"
230 M$=INKEY$:IF M$=" " THEN C7=0:GOTO 260 ELSE IF M$="C" THEN 1000  ELSE 230
250 IF DA=1 THEN IF X=0 THEN 290 ELSE RETURN
260 DC=D(PC)
270 C(0,X)=C(0,X)+1
280 C(C(0,X),X)=DC
285 IF X=1 THEN RETURN
290 CLS
300 PRINT"THIS IS YOUR HAND------"
310 FOR T1=1TOC(0,X)
320 CN=C(T1,X):GOSUB 500  
330 IF CC$="H" OR CC$="R" THEN CD$=RIGHT$(CD$,LEN(CD$)-1)
340 PRINT T1;"     ";CD$:NEXTT1
400 INPUT"WHAT DO YOU WANT TO DO";OP$
410 IFOP$="P"THEN600
420 IFOP$="D"THEN1300
430 IFOP$="S"THEN1400
440 IFOP$="H"THEN290
450 PRINT"THAT'S NOT AN OPTION---CHOOSE AGAIN":GOTO400  
500 RESTORE:'DISCODING SUB
510 READ N,CC$,CD$:CN=CN-N
550 IF CN>=0 THEN 510 ELSE RETURN
600 '* PLAY *
610 INPUT"WHAT CARD DO YOU WANT TO PLAY (BY NUMBER)";CP
620 IFCP>C(0,X)THENPRINT"WHAT CARD NUMBER WAS THAT?!?!":GOTO400
630 CN=C(CP,X):GOSUB 500  
640 IF CC$="S" THEN 800  
650 IF CC$="R" THEN 900  
660 IF CC$="H" THEN 1200 
700 '* DISTANCE *
710 IF R(X)=0 THEN IF X=0 THEN PRINT"YOU MUST BE ROLLING TO PUT DOWN MILEAGE":GOTO 400 ELSE BF=-1:RETURN
720 IF VAL(CD$)=200 THEN IF T(X)=2 THEN IF X=0 THEN PRINT"YOU MAY ONLY PUT DOWN 2 TWO HUNDRED MILE CARDS":GOTO 400 ELSE BF=-1:RETURN ELSE IF X=0 OR TU=1 THEN T(X)=T(X)+1 ELSE BF=1:RETURN
730 IF L(X)=1 AND VAL(CD$)>50 THEN IF X=0 THEN PRINT"YOU HAVE A SPEED LIMIT ON YOU--ONLY 25 AND 50 MILE CARD ACCEPTED":GOTO 400 ELSE BF=-1:RETURN
740 IF M(X)+VAL(CD$)>1000 THEN IF X=0 PRINT"THAT CARD WILL BRING YOUR TOTAL OVER 1000 MILES: CHOOSE ANOTHER":GOTO 400 ELSE BF=-1:RETURN ELSE IF X=1 AND TU=0 THEN BF=1:RETURN ELSE M(X)=M(X)+VAL(CD$):IF M(X)=1000 THEN 10000 ELSE GOTO 1690
800 '* SAFETY *
810 F(0,X)=F(0,X)+1
820 IF CD$="EXTRA TANK" THEN F(F(0,X),X)=1
830 IF CD$="PUNCTURE PROOF" THEN F(F(0,X),X)=2
840 IF CD$="DRIVING ACE" THEN F(F(0,X),X)=3
850 IF CD$="RIGHT OF WAY" THEN F(F(0,X),X)=9
860 IF VAL(H$(X))=F(F(0,X),X) THEN HP=0
870 IF F(F(0,X),X)=9 THEN L(X)=0:R(X)=1
880 S(0,X)=S(0,X)+1:S(S(0,X),X)=C(CP,X)
890 IF X=1 THEN 895 ELSE PRINT"PLAYING A SAFETY GIVES YOU ANOTHER TURN":FOR T4=1TO 500:NEXT T4:PC=PC+1:GOSUB 10200:IF DA<>1 THENC(CP,X)=D(PC):GOTO 290 ELSE C(CP,X)=C(C(0,X),X):C(0,X)=C(0,X)-1:GOTO 290
895 PC=PC+1:GOSUB 10200:IF DA<>1 THEN C(CP,X)=D(PC):GOTO 1805 ELSE C(CP,X)=C(C(0,X),X):C(0,X)=C(0,X)-1:TU=0:PM(0)=0:GOTO 1805
900 '* REMEDY *
910 IF CD$="9ROLL" OR CD$="9END OF LIMIT" THEN 960  
920 IF H(X)=0 THEN IF X=0 THEN PRINT"YOU DON'T HAVE A HAZARD":GOTO 400 ELSE BF=-1:RETURN
930 IF VAL(CD$)=VAL(H$(X)) THEN IF X=0 OR TU=1 THEN H$(X)="0NEEDS A ROLL"  ELSE BF=1:RETURN ELSE IF X=0 THEN PRINT"THIS CARD WILL NOT TAKE CARE OF YOUR HAZARD, WHICH IS:":PRINTRIGHT$(H$(X),LEN(H$(X))-1):GOTO 400   ELSE BF=-1:RETURN
940 FOR T3=1 TO S(0,X):IF S(T3,X)<>59 THEN NEXT T3 ELSE R(X)=1
950 GOTO 1690 
960 IF L(X)=1 AND CD$="9END OF LIMIT" THEN IF X=0 OR TU=1 THEN L(X)=0:GOTO 1690 ELSE BF=1:RETURN ELSE IF CD$="9END OF LIMIT" THEN IF X=0 THEN PRINT"YOU DON'T HAVE A SPEED LIMIT ON YOU":GOTO 400 ELSE BF=-1:RETURN 
970 IF R(X)=1 THEN IF X=0 THEN PRINT"YOU ARE ALREADY ROLLING":GOTO 400 ELSE BF=-1:RETURN
980 IF H$(X)="0NEEDS A ROLL" THEN IF X=0 OR TU=1 THEN H(X)=0:R(X)=1:GOTO 1690 ELSE BF=1:RETURN
990 IF H$(X)<>"9STOP" THEN IF X=0 THEN PRINT"YOU MUST REMEDY YOUR HAZARD BEFORE YOU CAN PLAY A ROLL CARD":GOTO 400 ELSE BF=-1:RETURN ELSE H(X)=0:R(X)=1:GOTO 1690
1000 '* COUP FOURRE' *
1010 IF H(X)=0 AND L(X)=0 THEN PRINT"THE COMPUTER PUT NOTHING ON YOU":FOR W=1 TO 750:NEXT W:GOTO 260  
1020 IF C7=0 THEN PRINT"YOU MUST COUP FOURRE' IMMEDIATELY AFTER THE HAZARD IS PUT ON YOU":FOR W=1 TO 1000:NEXTW:GOTO 260  
1030 FOR T7=1 TO C(0,X):CN=C(T7,X):GOSUB 500:IF CC$<>"S" THEN 1040  ELSE IF CD$=C7$ THEN 1050
1040 NEXT T7
1045 IF X=0 THEN PRINT"YOU DON'T HAVE ANY SAFETIES TO COUP FOURRE' WITH":GOTO 260  ELSE IF TU=0 THEN BF=-1:RETURN
1050 IF X=1 AND TU=0 THEN BF=0:RETURN  ELSE F(0,X)=F(0,X)+1
1060 IF C7$<>"RIGHT OF WAY" OR H$(X)="9STOP" THEN H(X)=0 ELSE L(X)=0
1070 IF C7$="RIGHT OF WAY" THEN F(F(0,X),X)=9:L(X)=0:R(X)=1
1080 IF C7$="EXTRA TANK" THEN F(F(0,X),X)=1
1090 IF C7$="PUNCTURE PROOF" THEN F(F(0,X),X)=2
1100 IF C7$="DRIVING ACE" THEN F(F(0,X),X)=3
1120 S(0,X)=S(0,X)+1:S(S(0,X),X)=C(T7,X):CO(X)=CO(X)+1
1130 C7=0:PC=PC+1:GOSUB 10200:IF DA<>1 THEN C(T7,X)=D(PC):PC=PC+1:GOSUB 10200
1140 IF X=0 THEN 250 ELSE GOTO 1710
1200 '* HAZARD *
1210 IF F(0,1-X)=0 THEN 1230 
1220 FOR T2=1TOF(0,1-X):IF F(T2,1-X)<>VAL(CD$) THEN NEXT T2 ELSEIF X=0 THEN PRINT"THE COMPUTER HAS A SAFETY FOR THIS HAZARD":GOTO 400 ELSE BF=-1:RETURN
1230 IF H(1-X)=1 AND L(1-X)=1 THEN IF X=0 THEN PRINT"SORRY, IT IS NOT POSSIBLE FOR YOU TO PLAY A HAZARD":GOTO 400  ELSE BF=-1:RETURN
1240 IF L(1-X)=1 AND CD$="9SPEED LIMIT" THEN IF X=0 THEN PRINT"THE COMPUTER ALREADY HAS A SPEED LIMIT ON IT":GOTO 400 ELSE BF=-1:RETURN
1245 IF CD$="9SPEED LIMIT" THEN IF X=0 OR TU=1 THEN L(1-X)=1:C7=1:C7$="RIGHT OF WAY":GOTO 1690 ELSE BF=1:RETURN
1250 IF H(1-X)=1 THEN IF X=0 THEN PRINT"THE COMPUTER ALREADY HAS A HAZARD ON IT: ";RIGHT$(H$(1-X),LEN(H$(1-X))-1):GOTO 400 ELSE BF=-1:RETURN
1260 IF X=0 OR TU=1 THEN H(1-X)=1:R(1-X)=0:H$(1-X)=CD$:C7=1:GOSUB 9900:GOTO 1690 ELSE BF=1:RETURN
1300 '* DISCARD *
1310 INPUT"WHAT CARD (BY NUMBER)";DN
1320 DN=ABS(INT(DN)):IF DN>7 THEN PRINT"WHAT!?!??    WHAT DID YOU WANT TO DO?":GOTO 400  
1330 C(DN,X)=C(C(0,X),X):C(0,X)=C(0,X)-1
1340 PC=PC+1:X=1-X:GOTO 1700 
1400 '* STATUS *
1410 CLS
1420 FOR L=0 TO 1:IF L(L)=1 THEN L$(L)="YES" ELSE L$(L)="NO"
1425 NEXT L
1440 PRINT,"PLAYER","COMPUTER":PRINT:PRINT
1470 PRINT"MILEAGE",M(0),M(1):PRINT:PRINT"SPEED LIMIT",L$(0),L$(1):PRINT:PRINT
1520 PRINT"HAZARD",:IF H(0)=0 THEN PRINT"NONE", ELSE PRINT RIGHT$(H$(0),LEN(H$(0))-1),
1530 IF H(1)=0 THEN PRINT"NONE" ELSE PRINT RIGHT$(H$(1),LEN(H$(1))-1)
1540 PRINT"THE COMPUTER HAS THESE SAFETIES:"
1550 IF S(0,1)=0 THEN PRINT " NONE":GOTO 1570 
1560 FOR L=1 TO S(0,1):CN=S(L,1):GOSUB500  :PRINT CD$,:NEXT L:PRINT
1570 PRINT"THE PERSON HAS THESE SAFETIES:"
1580 IF S(0,0)=0 THEN PRINT" NONE":GOTO 1600 
1590 FOR L=1TOS(0,0):CN=S(L,0):GOSUB500  :PRINTCD$,:NEXTL:PRINT
1600 PRINT@1024-49,"PRESS 'D' WHEN DONE";
1610 IF INKEY$<>"D" THEN 1610 
1620 GOTO 290  
1650 DATA 3,H,1OUT OF GAS, 3,H,2FLAT TIRE, 3,H,3ACCIDENT, 4,H,9SPEED LIMIT, 5,H,9STOP,   6,R,1GASOLINE, 6,R,2SPARE TIRE, 6,R,3REPAIRS,6,R,9END OF LIMIT, 14,R,9ROLL,    1,S,EXTRA TANK, 1,S,PUNCTURE PROOF, 1,S,DRIVING ACE, 1,S,RIGHT OF WAY
1660 DATA 4,D,200, 12,D,100, 10,D,75, 10,D,50, 10,D,25
1690 C(CP,X)=C(C(0,X),X):C(0,X)=C(0,X)-1
1695 X=1-X:PC=PC+1:IF X=0 THEN 200
1700 '* COMPUTER'S TURN *
1710 PM(0)=0:TU=0:PRINT"COMPUTER'S TURN"
1720 IF C7<>1 THEN 1800
1730 GOSUB 1030
1740 IF BF=-1 THEN 1800
1750 PRINT"     C O U P   F O U R R E'":TU=1:GOTO 1030
1800 GOSUB 260
1805 FOR TP=1 TO C(0,X)
1810 CN=C(TP,X):GOSUB 500
1820 IF CC$="S" THEN GOSUB 3000:GOTO 1910
1830 IF CC$="D" THEN GOSUB 700
1840 IF CC$="H" THEN GOSUB 1200
1850 IF CC$="R" THEN GOSUB 900
1900 IF BF=-1 THEN 1910 ELSE IF BF=1 THEN GOSUB 3000:GOTO 1910 ELSE IF BF=0 THEN STOP
1910 NEXT TP:IF PM(0)=0 THEN 6000
1920 Q=RND(PM(0)):TU=1:CP=PM(Q):CN=C(CP,X):GOSUB 500:GOSUB 9000:GOTO 640
3000 '* # PLAYS *
3010 PM(0)=PM(0)+1
3015 PM(PM(0))=TP:RETURN
6000 REM DISCARD SECTION 
6010 PRINT"THE COMPUTER IS DISCARDING"
6020 DN=RND(7):C(C(0,X),X)=C(DN,X):C(0,X)=C(0,X)-1
6030 CN=C(DN,X):GOSUB500:IF CC$="H" OR CC$="R" THEN CD$=RIGHT$(CD$,LEN(CD$)-1)
6040 PRINT:PRINT"THE COMPUTER IS DISCARDING A  ";CD$:FOR W2=1 TO1000:NEXT W2:X=1-X:GOTO 200
9000 REM  SUB TO TELL COMPUTER'S PLAY
9010 PRINT:PRINT"THE COMPUTER IS PLAYING THE FOLLOWING CARD":IFCC$="H" OR CC$="R" THEN PRINT RIGHT$(CD$,LEN(CD$)-1) ELSE PRINT CD$
9020 FOR WA=1 TO 750:NEXTWA:RETURN
9700 GOTO 1690
9900 '* HAZ INTO SAFETY *
9910 IF VAL(H$(1-X))=1 THEN C7$="EXTRA TANK":RETURN
9920 IF VAL(H$(1-X))=2 THEN C7$="PUNCTURE PROOF":RETURN
9930 IF VAL(H$(1-X))=3 THEN C7$="DRIVING ACE":RETURN
9940 IF VAL(H$(1-X))=9 THEN C7$="RIGHT OF WAY":RETURN
10000 '* WINNER *
10010 CLS:PRINTCHR$(23)
10020 PRINT"    WE HAVE A WINNER":PRINT:PRINT
10040 IF M(1)=1000  THEN PRINT"THE COMPUTER WON THIS ONE":GOTO 10047   ELSE IFM(0)=1000 THEN PRINT"CONGRATULATIONS ON BEATING THE            COMUTER!":GOTO 10047
10045 PRINT"GAME IS OVER. NO CARDS LEFT"
10047 PRINT@900,"PRESS <ANYTHING> TO CONTINUE";
10050 IF INKEY$="" THEN 10050
10060 FOR X=0 TO 1
10070 P(X)=M(X)+(100*S(0,X))+(300*CO(X))
10080 IF M(X)=1000 THEN P(X)=P(X)+400
10090 IF S(0,X)=4 THEN P(X)=P(X)+300
10100 IF DA=1 AND M(X)=1000 THEN P(X)=P(X)+300
10110 IF T(X)=0 AND M(X)=1000 THEN P(X)=P(X)+300
10120 IF M(1-X)=0 AND M(X)=1000 THEN P(X)=P(X)+500
10130 TL(X)=TL(X)+P(X):NEXTX
10150 CLS:PRINT:PRINT:PRINT:PRINT,"","PLAYER","COMPUTER"
10160 PRINT:PRINT:PRINT"POINTS THIS GAME",P(0),P(1)
10170 PRINT:PRINT"TOTAL POINTS","",TL(0),TL(1)
10180 PRINT@1024-49,"PRESS  B  TO BEGIN NEW GAME";
10190 B$=INKEY$:IF B$="B" THEN PRINT:GOTO 20   ELSE 10190
10200 IF PC>105 THEN PRINT"OUT OF CARDS -- DELAYED ACTION BEGINS":DA=1:FOR W=1 TO 1000:NEXTW
10210 RETURN
