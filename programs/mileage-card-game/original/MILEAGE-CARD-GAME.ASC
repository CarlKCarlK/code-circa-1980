10 CLEAR50
20 DIMD(105),C(7,1),S(4,1),M(1),H$(1),H(1),L(1),FP(4,1),R(1),PM(20)
30 PRINT"SETTING UP DECK  ......  WAIT"
40 FOR C=0TO4:FORP=0TO1:S(C,P)=0:F(C,P)=0:NEXT P,C:  FOR H=0TO1:M(H)=0:T(H)=0:R(H)=0:L(H)=0:CO(H)=0:NEXTH
50 FOR X=0TO105
60 S=RND(X+1)-1
70 D(X)=D(S):D(S)=X:NEXTX
80 PC=0
90 FOR X=0 TO 1:H(X)=1:H$(X)="0NEEDS A ROLL":NEXTX
100 FORX=0TO1:C(0,X)=6:NEXTX
110 FOR Y=0 TO 5:FOR X=0 TO 1
120 C(Y+1,X)=D(X+Y*2)
130 NEXT X,Y
140 PC=12:X=0
150 CLS:'* ACTUAL PLAY *
160 PRINT@463,"PRESS <SPACE BAR> TO DRAW OR":PRINT@529,"<C> TO DO A COUP FOURRE'"
170 M$=INKEY$:IF M$=" " THEN C7=0:GOTO 190  ELSE IF M$="C" THEN 710   ELSE 170  
180 IF DA=1 THEN IF X=0 THEN 230  ELSE RETURN
190 DC=D(PC)
200 C(0,X)=C(0,X)+1
210 C(C(0,X),X)=DC
220 IF X=1 THEN RETURN
230 CLS
240 PRINT"THIS IS YOUR HAND------"
250 FOR T1=1TOC(0,X)
260 CN=C(T1,X):GOSUB 350  
270 IF CC$="H" OR CC$="R" THEN CD$=RIGHT$(CD$,LEN(CD$)-1)
280 PRINT T1;"     ";CD$:NEXTT1
290 INPUT"WHAT DO YOU WANT TO DO";OP$
300 IFOP$="P"THEN380  
310 IFOP$="D"THEN940  
320 IFOP$="S"THEN990  
330 IFOP$="H"THEN230  
340 PRINT"THAT'S NOT AN OPTION---CHOOSE AGAIN":GOTO290  
350 RESTORE:'DISCODING SUB
360 READ N,CC$,CD$:CN=CN-N
370 IF CN>=0 THEN 360  ELSE RETURN
380 '* PLAY *
390 INPUT"WHAT CARD DO YOU WANT TO PLAY (BY NUMBER)";CP
400 IFCP>C(0,X)THENPRINT"WHAT CARD NUMBER WAS THAT?!?!":GOTO290  
410 CN=C(CP,X):GOSUB 350  
420 IF CC$="S" THEN 500  
430 IF CC$="R" THEN 610  
440 IF CC$="H" THEN 860  
450 '* DISTANCE *
460 IF R(X)=0 THEN IF X=0 THEN PRINT"YOU MUST BE ROLLING TO PUT DOWN MILEAGE":GOTO 290  ELSE BF=-1:RETURN
470 IF VAL(CD$)=200 THEN IF T(X)=2 THEN IF X=0 THEN PRINT"YOU MAY ONLY PUT DOWN 2 TWO HUNDRED MILE CARDS":GOTO 290  ELSE BF=-1:RETURN ELSE IF X=0 OR TU=1 THEN T(X)=T(X)+1 ELSE BF=1:RETURN
480 IF L(X)=1 AND VAL(CD$)>50 THEN IF X=0 THEN PRINT"YOU HAVE A SPEED LIMIT ON YOU--ONLY 25 AND 50 MILE CARD ACCEPTED":GOTO 290  ELSE BF=-1:RETURN
490 IF M(X)+VAL(CD$)>1000 THEN IF X=0 PRINT"THAT CARD WILL BRING YOUR TOTAL OVER 1000 MILES: CHOOSE ANOTHER":GOTO 290  ELSE BF=-1:RETURN ELSE IF X=1 AND TU=0 THEN BF=1:RETURN ELSE M(X)=M(X)+VAL(CD$):IF M(X)=1000 THEN 1530  ELSE GOTO 1180 
500 '* SAFETY *
510 F(0,X)=F(0,X)+1
520 IF CD$="EXTRA TANK" THEN F(F(0,X),X)=1
530 IF CD$="PUNCTURE PROOF" THEN F(F(0,X),X)=2
540 IF CD$="DRIVING ACE" THEN F(F(0,X),X)=3
550 IF CD$="RIGHT OF WAY" THEN F(F(0,X),X)=9
560 IF VAL(H$(X))=F(F(0,X),X) THEN HP=0
570 IF F(F(0,X),X)=9 THEN L(X)=0:R(X)=1
580 S(0,X)=S(0,X)+1:S(S(0,X),X)=C(CP,X)
590 IF X=1 THEN 600  ELSE PRINT"PLAYING A SAFETY GIVES YOU ANOTHER TURN":FOR T4=1TO 500:NEXT T4:PC=PC+1:GOSUB 1730 :IF DA<>1 THENC(CP,X)=D(PC):GOTO 230  ELSE C(CP,X)=C(C(0,X),X):C(0,X)=C(0,X)-1:GOTO 230  
600 PC=PC+1:GOSUB 1730 :IF DA<>1 THEN C(CP,X)=D(PC):GOTO 1270 ELSE C(CP,X)=C(C(0,X),X):C(0,X)=C(0,X)-1:TU=0:PM(0)=0:GOTO 1270 
610 '* REMEDY *
620 IF CD$="9ROLL" OR CD$="9END OF LIMIT" THEN 670  
630 IF H(X)=0 THEN IF X=0 THEN PRINT"YOU DON'T HAVE A HAZARD":GOTO 290  ELSE BF=-1:RETURN
640 IF VAL(CD$)=VAL(H$(X)) THEN IF X=0 OR TU=1 THEN H$(X)="0NEEDS A ROLL"  ELSE BF=1:RETURN ELSE IF X=0 THEN PRINT"THIS CARD WILL NOT TAKE CARE OF YOUR HAZARD, WHICH IS:":PRINTRIGHT$(H$(X),LEN(H$(X))-1):GOTO 290   ELSE BF=-1:RETURN
650 FOR T3=1 TO S(0,X):IF S(T3,X)<>59 THEN NEXT T3 ELSE R(X)=1
660 GOTO 1180 
670 IF L(X)=1 AND CD$="9END OF LIMIT" THEN IF X=0 OR TU=1 THEN L(X)=0:GOTO 1180 ELSE BF=1:RETURN ELSE IF CD$="9END OF LIMIT" THEN IF X=0 THEN PRINT"YOU DON'T HAVE A SPEED LIMIT ON YOU":GOTO 290  ELSE BF=-1:RETURN 
680 IF R(X)=1 THEN IF X=0 THEN PRINT"YOU ARE ALREADY ROLLING":GOTO 290  ELSE BF=-1:RETURN
690 IF H$(X)="0NEEDS A ROLL" THEN IF X=0 OR TU=1 THEN H(X)=0:R(X)=1:GOTO 1180 ELSE BF=1:RETURN
700 IF H$(X)<>"9STOP" THEN IF X=0 THEN PRINT"YOU MUST REMEDY YOUR HAZARD BEFORE YOU CAN PLAY A ROLL CARD":GOTO 290  ELSE BF=-1:RETURN ELSE H(X)=0:R(X)=1:GOTO 1180 
710 '* COUP FOURRE' *
720 IF H(X)=0 AND L(X)=0 THEN PRINT"THE COMPUTER PUT NOTHING ON YOU":FOR W=1 TO 750:NEXT W:GOTO 190  
730 IF C7=0 THEN PRINT"YOU MUST COUP FOURRE' IMMEDIATELY AFTER THE HAZARD IS PUT ON YOU":FOR W=1 TO 1000:NEXTW:GOTO 190  
740 FOR T7=1 TO C(0,X):CN=C(T7,X):GOSUB 350  :IF CC$<>"S" THEN 750   ELSE IF CD$=C7$ THEN 770  
750 NEXT T7
760 IF X=0 THEN PRINT"YOU DON'T HAVE ANY SAFETIES TO COUP FOURRE' WITH":GOTO 190  ELSE IF TU=0 THEN BF=-1:RETURN
770 IF X=1 AND TU=0 THEN BF=0:RETURN  ELSE F(0,X)=F(0,X)+1
780 IF C7$<>"RIGHT OF WAY" OR H$(X)="9STOP" THEN H(X)=0 ELSE L(X)=0
790 IF C7$="RIGHT OF WAY" THEN F(F(0,X),X)=9:L(X)=0:R(X)=1
800 IF C7$="EXTRA TANK" THEN F(F(0,X),X)=1
810 IF C7$="PUNCTURE PROOF" THEN F(F(0,X),X)=2
820 IF C7$="DRIVING ACE" THEN F(F(0,X),X)=3
830 S(0,X)=S(0,X)+1:S(S(0,X),X)=C(T7,X):CO(X)=CO(X)+1
840 C7=0:PC=PC+1:GOSUB 1730 :IF DA<>1 THEN C(T7,X)=D(PC):PC=PC+1:GOSUB 1730 
850 IF X=0 THEN 180  ELSE GOTO 1210 
860 '* HAZARD *
870 IF F(0,1-X)=0 THEN 890  
880 FOR T2=1TOF(0,1-X):IF F(T2,1-X)<>VAL(CD$) THEN NEXT T2 ELSEIF X=0 THEN PRINT"THE COMPUTER HAS A SAFETY FOR THIS HAZARD":GOTO 290  ELSE BF=-1:RETURN
890 IF H(1-X)=1 AND L(1-X)=1 THEN IF X=0 THEN PRINT"SORRY, IT IS NOT POSSIBLE FOR YOU TO PLAY A HAZARD":GOTO 290  ELSE BF=-1:RETURN
900 IF L(1-X)=1 AND CD$="9SPEED LIMIT" THEN IF X=0 THEN PRINT"THE COMPUTER ALREADY HAS A SPEED LIMIT ON IT":GOTO 290  ELSE BF=-1:RETURN
910 IF CD$="9SPEED LIMIT" THEN IF X=0 OR TU=1 THEN L(1-X)=1:C7=1:C7$="RIGHT OF WAY":GOTO 1180 ELSE BF=1:RETURN
920 IF H(1-X)=1 THEN IF X=0 THEN PRINT"THE COMPUTER ALREADY HAS A HAZARD ON IT: ";RIGHT$(H$(1-X),LEN(H$(1-X))-1):GOTO 290  ELSE BF=-1:RETURN
930 IF X=0 OR TU=1 THEN H(1-X)=1:R(1-X)=0:H$(1-X)=CD$:C7=1:GOSUB 1480 :GOTO 1180 ELSE BF=1:RETURN
940 '* DISCARD *
950 INPUT"WHAT CARD (BY NUMBER)";DN
960 DN=ABS(INT(DN)):IF DN>7 THEN PRINT"WHAT!?!??    WHAT DID YOU WANT TO DO?":GOTO 290  
970 C(DN,X)=C(C(0,X),X):C(0,X)=C(0,X)-1
980 PC=PC+1:X=1-X:GOTO 1200 
990 '* STATUS *
1000 CLS
1010 FOR L=0 TO 1:IF L(L)=1 THEN L$(L)="YES" ELSE L$(L)="NO"
1020 NEXT L
1030 PRINT,"PLAYER","COMPUTER":PRINT:PRINT
1040 PRINT"MILEAGE",M(0),M(1):PRINT:PRINT"SPEED LIMIT",L$(0),L$(1):PRINT:PRINT
1050 PRINT"HAZARD",:IF H(0)=0 THEN PRINT"NONE", ELSE PRINT RIGHT$(H$(0),LEN(H$(0))-1),
1060 IF H(1)=0 THEN PRINT"NONE" ELSE PRINT RIGHT$(H$(1),LEN(H$(1))-1)
1070 PRINT"THE COMPUTER HAS THESE SAFETIES:"
1080 IF S(0,1)=0 THEN PRINT " NONE":GOTO 1100 
1090 FOR L=1 TO S(0,1):CN=S(L,1):GOSUB350  :PRINT CD$,:NEXT L:PRINT
1100 PRINT"THE PERSON HAS THESE SAFETIES:"
1110 IF S(0,0)=0 THEN PRINT" NONE":GOTO 1130 
1120 FOR L=1TOS(0,0):CN=S(L,0):GOSUB350  :PRINTCD$,:NEXTL:PRINT
1130 PRINT@1024-49,"PRESS 'D' WHEN DONE";
1140 IF INKEY$<>"D" THEN 1140 
1150 GOTO 230  
1160 DATA 3,H,1OUT OF GAS, 3,H,2FLAT TIRE, 3,H,3ACCIDENT, 4,H,9SPEED LIMIT, 5,H,9STOP,   6,R,1GASOLINE, 6,R,2SPARE TIRE, 6,R,3REPAIRS,6,R,9END OF LIMIT, 14,R,9ROLL,    1,S,EXTRA TANK, 1,S,PUNCTURE PROOF, 1,S,DRIVING ACE, 1,S,RIGHT OF WAY
1170 DATA 4,D,200, 12,D,100, 10,D,75, 10,D,50, 10,D,25
1180 C(CP,X)=C(C(0,X),X):C(0,X)=C(0,X)-1
1190 X=1-X:PC=PC+1:IF X=0 THEN 150  
1200 '* COMPUTER'S TURN *
1210 PM(0)=0:TU=0:PRINT"COMPUTER'S TURN"
1220 IF C7<>1 THEN 1260 
1230 GOSUB 740  
1240 IF BF=-1 THEN 1260 
1250 PRINT"     C O U P   F O U R R E'":TU=1:GOTO 740  
1260 GOSUB 190  
1270 FOR TP=1 TO C(0,X)
1280 CN=C(TP,X):GOSUB 350  
1290 IF CC$="S" THEN GOSUB 1360 :GOTO 1340 
1300 IF CC$="D" THEN GOSUB 450  
1310 IF CC$="H" THEN GOSUB 860  
1320 IF CC$="R" THEN GOSUB 610  
1330 IF BF=-1 THEN 1340 ELSE IF BF=1 THEN GOSUB 1360 :GOTO 1340 ELSE IF BF=0 THEN STOP
1340 NEXT TP:IF PM(0)=0 THEN 1390 
1350 Q=RND(PM(0)):TU=1:CP=PM(Q):CN=C(CP,X):GOSUB 350  :GOSUB 1440 :GOTO 420  
1360 '* # PLAYS *
1370 PM(0)=PM(0)+1
1380 PM(PM(0))=TP:RETURN
1390 REM DISCARD SECTION 
1400 PRINT"THE COMPUTER IS DISCARDING"
1410 DN=RND(7):C(C(0,X),X)=C(DN,X):C(0,X)=C(0,X)-1
1420 CN=C(DN,X):GOSUB350  :IF CC$="H" OR CC$="R" THEN CD$=RIGHT$(CD$,LEN(CD$)-1)
1430 PRINT:PRINT"THE COMPUTER IS DISCARDING A  ";CD$:FOR W2=1 TO1000:NEXT W2:X=1-X:GOTO 150  
1440 REM  SUB TO TELL COMPUTER'S PLAY
1450 PRINT:PRINT"THE COMPUTER IS PLAYING THE FOLLOWING CARD":IFCC$="H" OR CC$="R" THEN PRINT RIGHT$(CD$,LEN(CD$)-1) ELSE PRINT CD$
1460 FOR WA=1 TO 750:NEXTWA:RETURN
1470 GOTO 1180 
1480 '* HAZ INTO SAFETY *
1490 IF VAL(H$(1-X))=1 THEN C7$="EXTRA TANK":RETURN
1500 IF VAL(H$(1-X))=2 THEN C7$="PUNCTURE PROOF":RETURN
1510 IF VAL(H$(1-X))=3 THEN C7$="DRIVING ACE":RETURN
1520 IF VAL(H$(1-X))=9 THEN C7$="RIGHT OF WAY":RETURN
1530 '* WINNER *
1540 CLS:PRINTCHR$(23)
1550 PRINT"    WE HAVE A WINNER":PRINT:PRINT
1560 IF M(1)=1000  THEN PRINT"THE COMPUTER WON THIS ONE":GOTO 1580    ELSE IFM(0)=1000 THEN PRINT"CONGRATULATIONS ON BEATING THE            COMUTER!":GOTO 1580 
1570 PRINT"GAME IS OVER. NO CARDS LEFT"
1580 PRINT@900,"PRESS <ANYTHING> TO CONTINUE";
1590 IF INKEY$="" THEN 1590 
1600 FOR X=0 TO 1
1610 P(X)=M(X)+(100*S(0,X))+(300*CO(X))
1620 IF M(X)=1000 THEN P(X)=P(X)+400
1630 IF S(0,X)=4 THEN P(X)=P(X)+300
1640 IF DA=1 AND M(X)=1000 THEN P(X)=P(X)+300
1650 IF T(X)=0 AND M(X)=1000 THEN P(X)=P(X)+300
1660 IF M(1-X)=0 AND M(X)=1000 THEN P(X)=P(X)+500
1670 TL(X)=TL(X)+P(X):NEXTX
1680 CLS:PRINT:PRINT:PRINT:PRINT,"","PLAYER","COMPUTER"
1690 PRINT:PRINT:PRINT"POINTS THIS GAME",P(0),P(1)
1700 PRINT:PRINT"TOTAL POINTS","",TL(0),TL(1)
1710 PRINT@1024-49,"PRESS  B  TO BEGIN NEW GAME";
1720 B$=INKEY$:IF B$="B" THEN PRINT:GOTO 30   ELSE 1720 
1730 IF PC>105 THEN PRINT"OUT OF CARDS -- DELAYED ACTION BEGINS":DA=1:FOR W=1 TO 1000:NEXTW
1740 RETURN
