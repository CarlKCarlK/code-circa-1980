10 DIMD(105),PH(7),CH(7)
20 PRINT"SETTING UP DECK  ......  WAIT"
30 CS(0)=0:PS(0)=0:FC(0)=0:FP(0)=0:FP(1)=0:PM=0:DA=0:RP=0:P2=0:PL=0:CL=0:
40 FOR X=0TO105
50 S=RND(X+1)-1
60 D(X)=D(S)
70 D(S)=X
80 NEXTX
85 HC=1:CH$="0NEEDS A ROLL":HP=1:PH$="0NEEDS A ROLL"
90 PH(0)=6:CH(0)=6
100 FOR P=0TO5:PH(P+1)=D(P):NEXTP
110 FOR C=6TO11:CH(C-5)=D(C):NEXTC
120 PC=12
130 REM   ***   ACTUAL PLAY  ***
140 CLS
150 PRINT@463,"PRESS <SPACE BAR> TO DRAW OR":PRINT@529,"<C> TO DO A COUP FOURRE'"
155 M$=INKEY$
160 IF M$=" " THEN 170 ELSE IF M$="C" THEN 800 ELSE GOTO 155  
165 IF DA=1 THEN 200
170 DC=D(PC)
180 PH(0)=PH(0)+1
190 PH(PH(0))=DC
200 CLS
210 PRINT"THIS IS YOUR HAND------"
220 FOR T1=1TOPH(0)
230 CN=PH(T1):GOSUB 320  
235 IF CC$="H" OR CC$="R" THEN CD$=RIGHT$(CD$,LEN(CD$)-1)
240 PRINT T1;"     ";CD$
250 NEXT T1
260 INPUT"WHAT DO YOU WANT TO DO";OP$
270 IF OP$="P" THEN 390  
290 IF OP$="D" THEN 1080 
300 IF OP$="S" THEN 1140 
305 IF OP$="H" THEN 200  
310 PRINT"THAT'S NOT AN OPTION---CHOOSE AGAIN":GOTO260  
320 REM SUBROUTINE TO DISCODE CARDS
330 REM CN IS CARD NO., CC$ IS CLASS, CD$ IS CARD DESCRIPTION
340 RESTORE
350 READ N,CC$,CD$
360 CN=CN-N
370 IF CN>=0 THEN 350  
380 RETURN
390 REM  ** PUT DOWN OPTION **
400 INPUT"WHAT CARD DO YOU WANT TO PLAY (BY NUMBER)";CP
405 IF CP>PH(0) THEN PRINT"WHAT CARD NUMBER WAS THAT?!?!":GOTO 260
410 CN=PH(CP):GOSUB 320
430 IF CC$="S" THEN 600
440 IF CC$="R" THEN 700
450 IF CC$="H" THEN 1000
500 REM ** DISTANCE ***
510 IF RP=0 THEN PRINT"YOU MUST BE ROLLING TO PUT DOWN MILEAGE":GOTO 260
520 IF VAL(CD$)=200 THEN IF P2=2 PRINT"YOU MAY ONLY PUT DOWN 2 TWO HUNDRED MILE CARDS":GOTO 260  ELSE P2=P2+1
530 IF PL=1 AND VAL(CD$)>50 THEN PRINT"YOU HAVE A SPEED LIMIT ON YOU--ONLY 25 AND 50 MILE CARD ACCEPTED":GOTO 260
540 IF PM+VAL(CD$)>1000 PRINT"THAT CARD WILL BRING YOUR TOTAL OVER 1000 MILES: CHOOSE ANOTHER":GOTO 260  ELSE PM=PM+VAL(CD$): IFPM=1000 THEN 9000 ELSE GOTO 2900
600 REM ** SAFETY **
610 FP(0)=FP(0)+1
620 IF CD$="EXTRA TANK" THEN FP(FP(0))=1
630 IF CD$="PUNCTURE PROOF" THEN FP(FP(0))=2
640 IF CD$="DRIVING ACE" THEN FP(FP(0))=3
650 IF CD$="RIGHT OF WAY" THEN FP(FP(0))=9
660 IF VAL(PH$)=FP(FP(0)) THEN HP=0
670 IF FP(FP(0))=9 THEN PL=0:RP=1
680 PS(0)=PS(0)+1:PS(PS(0))=PH(CP)
690 PRINT"PLAYING A SAFETY GIVES YOU ANOTHER TURN":FORT4=1TO500:NEXT T4:PC=PC+1:GOSUB 10000:IF DA<>1 THEN PH(CP)=D(PC):GOTO 200 ELSE PH(CP)=PH(PH(0)):PH(0)=PH(0)-1:GOTO 200
700 REM  ** REMEDY SECTION **
710 IF CD$="9ROLL" OR CD$="9END OF LIMIT" THEN 730
715 IF HP=0 PRINT"YOU DON'T HAVE A HAZARD":GOTO 260
720 IF VAL(CD$)=VAL(PH$) THEN HP=0  ELSE PRINT"THIS CARD WILL NOT TAKE CARE OF YOUR HAZARD, WHICH IS:":PRINTRIGHT$(PH$,LEN(PH$)-1):GOTO 260
725 FOR T3=1 TO PS(0):IF PS(T3)<>59 THEN NEXT T3 ELSE RP=1
727 GOTO 2900
730 IF PL=1 AND CD$="9END OF LIMIT" THEN PL=0:GOTO 2900 ELSE IF CD$="9END OF LIMIT" THEN PRINT"YOU DON'T HAVE A SPEED LIMIT ON YOU":GOTO 260
740 IF RP=1 PRINT"YOU ARE ALREADY ROLLING":GOTO 260
745 IF PH$="0NEEDS A ROLL" THEN HP=0:RP=1:GOTO 2900
750 IF PH$<>"9STOP" PRINT"YOU MUST REMEDY YOU HAZARD BEFORE YOU CAN PLAY A ROLL CARD":GOTO 260 ELSE HP=0:RP=1:GOTO 2900
800 REM ** COUP FOURRE'  ***
805 IF HP=0 AND PL=0 THEN PRINT"THE COMPUTER PUT NOTHING ON YOU":FOR W=1 TO 750:NEXT W:GOTO 170
807 IF C7=0 THEN PRINT"YOU MUST COUP FOURRE' IMMEDIATELY AFTER THE HAZARD IS PUT ON YOU":FOR W=1 TO 1000:NEXTW:GOTO 170
810 FOR T7=1 TO PH(PH(0)):CN=PH(T7):GOSUB 320:IF CC$<>"S" THEN NEXT T7:PRINT"YOU DON'T HAVE A SAFETY TO COUP FOURRE' WITH":FOR W=1TO750:NEXTW:GOTO170
813 INPUT"IS ";CD$;" THE RIGHT ONE";A$:IF LEFT$(A$,1)<>"Y" THEN  NEXT T7:PRINT"YOU DON'T HAVE ANY SAFETIES YOU WISH TO COUP FOURRE' WITH":FOR W=1 TO 750: NEXT W:GOTO 170
814 FP(0)=FP(0)+1
815 IF HP=0 AND PL=1 THEN 880
820 IF CD$="EXTRA TANK" AND VAL(PH$)=1 THEN HP=0:FP(FP(0))=1:GOTO 900
830 IF CD$="PUNCTURE PROOF AND VAL(PH$)=2 THEN HP=0:FP(FP(0))=2:GOTO 900
840 IF CD$="DRIVING ACE" AND VAL(PH$)=3 THEN HP=0:FP(FP(0))=3:GOTO 900
850 IF CD$="RIGHT OF WAY" AND VAL(PH$)=9 THEN HP=0:FP(FP(0))=9:GOTO900
880 IF CD$="RIGHT OF WAY" THEN PL=0:RP=1:GOTO 900
900 PS(0)=PS(0)+1:PS(PS(0))=PH(T7)
910 PC=PC+1:GOSUB 10000:IF DA<>1 THEN PH(T7)=D(PC):PC=PC+1:GOSUB  10000:GOTO 165
1000 REM  ** PLAY HAZARD OPTION **
1003 IF FC(0)=0 THEN 1010
1005 FOR T2=1 TO FC(0):IFFC(T2)=LEFT$(CD$,1) THEN NEXT T2 ELSE PRINT"THE COMPUTER HAS A SAFETY FOR THIS HAZARD":GOTO 260
1010 IF HC=1 AND CL=1 THEN PRINT"SORRY, IT IS NOT POSSIBLE FOR YOU TO PLAY A HAZARD":GOTO 260  
1020 IF CL=1 AND CD$="9SPEED LIMIT" THEN PRINT" THE COMPUTER ALREADY HAS A SPEED LIMIT ON IT":GOTO 260  ELSE IF CD$="9SPEED LIMIT" THEN CL=1:GOTO 2900  ELSE IF HC=1 THEN PRINT"THE COMPUTER ALREADY HAS A HAZARD ON IT: ";RIGHT$(CH$,LEN(CH$)-1): GOTO 260
1040 HC=1:CH$=CD$
1050 GOTO 2900
1080 REM  ** DISCARD OPTION  **
1090 INPUT"WHAT CARD (BY NUMBER)";DN
1095 DN=ABS(INT(DN)):IF DN>7 THEN PRINT"WHAT!?!??    TELL ME THE CARD NUMBER AGAIN.":GOTO 260
1100 PH(DN)=PH(PH(0)):PH(0)=PH(0)-1
1110 GOTO 3000
1140 REM  **  A LOOK AT THE HANDS  **
1150 CLS
1160 IF CL=1 THEN CL$="YES" ELSE CL$="NO"
1170 IF PL=1 THEN PL$="YES" ELSE PL$="NO"
1180 PRINT"","COMPUTER","PLAYER"
1190 PRINT
1200 PRINT
1210 PRINT"MILEAGE",CM,PM
1220 PRINT
1230 PRINT"SPEED LIMIT",CL$,PL$
1240 PRINT
1250 PRINT"HAZARD",
1253 IF HC=0 THEN PRINT"NONE", ELSE PRINT RIGHT$(CH$,LEN(CH$)-1),
1255 IF HP=0 THEN PRINT"NONE" ELSE PRINT RIGHT$(PH$,LEN(PH$)-1)
1260 PRINT"THE COMPUTER HAS THESE SAFETIES:"
1270 IF CS(0)=0 THEN PRINT " NONE":GOTO 1290 
1280 FOR X=1 TO CS(0):CN=CS(X):GOSUB320:PRINT CD$,:NEXT X:PRINT
1290 PRINT"THE PERSON HAS THESE SAFETIES:"
1300 IF PS(0)=0 THEN PRINT" NONE":GOTO 1320 
1310 FOR X=1TOPS(0):CN=PS(X):GOSUB320:PRINTCD$,:NEXTX:PRINT
1320 PRINT@1024-49,"PRESS 'D' WHEN DONE";
1330 IF INKEY$<>"D" THEN 1330 
1340 GOTO 200  
1350  REM  ***   FROM HERE ON IS COMPUTER'S TURN    *****
1360 PC=PC+1
1370 FORX=1TO750:NEXTX:PC=PC+1:GOTO 130  
1380 END
1390 DATA 3,H,1OUT OF GAS, 3,H,2FLAT TIRE, 3,H,3ACCIDENT, 4,H,9SPEED LIMIT, 5,H,9STOP,   6,R,1GASOLINE, 6,R,2SPARE TIRE, 6,R,3REPAIRS,6,R,9END OF LIMIT, 14,R,9ROLL,    1,S,EXTRA TANK, 1,S,PUNCTURE PROOF, 1,S,DRIVING ACE, 1,S,RIGHT OF WAY
1400 DATA 4,D,200, 12,D,100, 10,D,75, 10,D,50, 10,D,25
1410 REM  VARIABLES      CH(0-7) IS COMPUTER'S HAND PH(0-7) IS  PLAYER'S HAND. (0) IS # OF CARDS IN HAND.  PC IS CARD POSITION. D(0-105 IS THE DECK.
2900 C7=0:PH(CP)=PH(PH(0)):PH(0)=PH(0)-1
3000 REM ***** COMPUTER'S   TURN  *******
3010 PRINT"COMPUTER'S TURN"
3020 PC=PC+1:GOSUB 10000
3030 FORT=1 TO 900:NEXTT
3040 PC=PC+1:GOSUB 10000:GOTO 130
8999 END
9000 REM ***   WINNER IS FOUND  *****
9010 CLS:PRINTCHR$(23)
9020 PRINT"    WE HAVE A WINNER"
9030 PRINT:PRINT
9040 IF CM=1000  THEN PRINT"THE COMPUTER WON THIS ONE"ELSE PRINT"CONGRATULATIONS ON BEATING THE            COMUTER!"
9050 FOR T5=1 TO 500:NEXT T5
9060 PP=PM+(100*PS(0))+(300*P3)
9065 IF PM=1000 THEN PP=PP+400
9070 IF PS(0)=4 THEN PP=PP+300
9075 IF DA=1 AND PM=1000 THEN PP=PP+300
9080 IF P2=0 AND PM=1000 THEN PP=PP+300
9085 IF CM=0 AND PM=1000 THEN PP=PP+500
9090 PT=PT+PP
9100 MP=CM+(100*CS(0))+(300*C3)
9105 IF CM=1000 THEN MP=MP+400
9110 IF DA=1 AND CM=1000 THEN MP=MP+300
9120 IF C2=0 AND CM=1000 THEN MP=MP+300
9125 IF CM=1000 AND PM=0 THEN MP=MP+500
9130 CT=CT+MP
9140 CLS:PRINT:PRINT:PRINT:PRINT,"","PLAYER","COMPUTER"
9150 PRINT:PRINT:PRINT"POINTS THIS GAME",PP,MP
9160 PRINT:PRINT"TOTAL POINTS","",PT,CT
9170 PRINT@1024-49,"PRESS  B  TO BEGIN NEW GAME";
9180 B$=INKEY$:IF B$="B" THEN PRINT:GOTO 20 ELSE 9180
10000 IF PC>105 THEN PRINT"OUT OF CARDS -- DELAYED ACTION BEGINS":DA=1:FOR W=1 TO 1000:NEXTW
10010 RETURN
