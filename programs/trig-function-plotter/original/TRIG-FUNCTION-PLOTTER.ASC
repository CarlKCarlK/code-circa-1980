1000 FORX=0TO127:SET(X,24):NEXT
1010 FORY=0TO47:SET(63,Y):NEXT
1020 FORX=-3TO2:PRINT@(448+(X+3)*(21.3333)/2),"[";X;"PI";:NEXT:PRINT@59+448,"3PI[";
1025 PRINT@0,"";
