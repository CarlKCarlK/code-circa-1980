2 CLEAR 300
3 DEFDBL A,B,D-Z
4 A=RND(0)
5 CLS
6 S=1:T=1:F=1:GOTO10
7 INPUT"CHANCE OF SMALL CHANGE,CHANGE OF TOTAL CHANGE,CHANGE IN MATCH UP WINDOW,FLEX OF SPEICES, INTIAL MATCH UP WINDOW";S,T,W,F,I:CLS
10 '
17 A=RND(0)
20 E=RND(0)
25 A=.5555555555555555
30 G=G+1
40 '
45 M=1
50 PRINT@0,"GENERATION";G
55 PRINT"ENVORNMENT";E;
60 N$="."
70 FORC=3TO18
80 N=VAL(MID$(STR$(OA),C,1))
90 N=N+RND(2*F+1)-F-1
95 IF N<0 OR N>9THEN N= RND(10)-1 
100 N$=N$+STR$(N)
105 ED=VAL( MID$( STR$(E), C, 1) )
110 M=M*( 10 - ABS(ED-N) )
120 NEXT C
130 A=VAL(N$)
140 PRINT@128,"ANIMAL    ";A
145 CC=M/1D+16*100
150 PRINT"COEFFECINT OF COMPARISON";CC
160 IF CC=>I THEN OA=A:OE=E:PRINT"SURVIED":I=CC
170 IF I>CC THEN PRINT"EXTINT":G=G-1:E=OE
180 IF RND(0)*100<L THEN E=RND(0)
190 GOTO30
