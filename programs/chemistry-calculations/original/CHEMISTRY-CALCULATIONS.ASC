20 FOR I=1TO2:READ C(I),CM(I),CP(I):PRINTC(I),CM(I),CP(I):NEXTI
30 FOR I=1TO2
40 M(I)=CM(I)-C(I)
50 S(I)=CP(I)-CM(I)
60 SW=32.06
70 SM(I)=S(I)/SW
80 MG(I)=M(I)/SM(I)
90 NEXT I
100 PRINTM(1);M(2):PRINTS(1);S(2):PRINTMG(1);MG(2)
105 PRINT:PRINT
110 FOR I=1TO5
120 PRINTI/2*MG(1);I/2*MG(2),"+";I
130 NEXTI
