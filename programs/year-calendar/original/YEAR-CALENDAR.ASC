10 CLEAR1000
100 INPUT"YEAR";Y
110 D=1:M=1
120 M=M+12:Y=Y-1
130 N=D+2*M+INT(.6*(M+1))+Y+INT(Y/4)-INT(Y/100)+INT(Y/400)+2
140 N=INT((N/7-INT(N/7))*7+.5)
150 IFN=0THENN=-6ELSEN=-N+1
210 DIM M(12),M$(12)
230 D=N
240 Y=Y+1
260 FORN=1TO12:READM(N):NEXTN:IFINT(Y/4)=Y/4THENM(2)=29
270 FORN=1TO12:READM$(N):NEXT
275 FORN=1TO12:PRINT:PRINT
280 PRINTSTRING$(24,"*");TAB(32-LEN(M$(N))/2)M$(N);TAB(39)STRING$(24,"*")
290 PRINT"  SUN      MON      TUE      WED      THU      FRI      SAT"
300 PRINTSTRING$(63,"*")
310 PRINT
320 FORL=1TO6:FORP=0TO6
330 IFL<>1ORP+D=>0THENX=X+1:PRINTTAB(P*9+2)X;
340 IFX=M(N)THEN500
350 NEXTP:PRINT:PRINT:NEXTL
500 D=-(P+1):IFD<-6THEND=D+7
510 X=0:IFL<6THENPRINT
520 PRINT:PRINTSTRING$(63,"*")
540 NEXTN
999 END
1000 DATA31,28,31,30,31,30,31,31,30,31,30,31
1010 DATA"JANUARY","FEBRUARY","MARCH","APRIL","MAY","JUNE","JULY","AUGUST","SEPTEMBER","OCTOBER","NOVEMBER","DECEMBER"
2000 IFINKEY$=""THEN2000ELSERETURN
