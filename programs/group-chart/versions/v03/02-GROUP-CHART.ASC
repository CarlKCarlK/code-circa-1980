70 EDIT130
90 F$=CHR$(168):D$=CHR$(140)
100 PRINT:INPUT"HOW MANY NUMBERS";N
105 FORC=1TON
110 PRINT"WHAT IS NUMBER";C;:INPUTA$:IFA$="H"THEN5000ELSEM(C)=VAL(A$):NEXTC
115 CLS:PRINT"     ";:FORC=1TON:PRINTM(C);" ";:NEXTC:PRINT:PRINT"   "F$;D$;D$;:FORC=1TON:PRINTD$;D$;D$;D$;:NEXTC:PRINT
