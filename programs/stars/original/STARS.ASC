120 PRINT"WELCOME TO MY GALAXY. i'M IN CHARGE OF THE STARS HERE."
130 PRINT"PLAY MY GAME *STARS* AND GET SOOME STARS FOR YOURSELF!"
140 PRINT
150 PRINT"WANT TO KNOW HOW TO PLAY";
160 INPUTB$
170 IFB$="Y"THEN280
190 PRINT
200 PRINT"I WILL THINK OF A WHOLE NUMBER FROM 1 TO 100."
210 PRINT"TRY TO GUESS MY NUMBER. ATTER YOU GUESS, I"
220 PRINT"WILL TYPE ONE OR MORE STARS ( * ).  THE CLOSER"
230 PRINT"YOU ARE TO MY NUMBER, THE MORE STARS WILL I TYPE."
240 PRINT"OONE STAR ( * ) MEANS YYOOU ARE FAR AWAY FROOM MY"
250 PRINT"NUMBER. SEVEN STARS (  ******* ) MEANS YOU ARE VERY,"
260 PRINT"VERY, VERY, CLOSE TO MY NUMBER ! ! !"
280 X=RND(100)+1
290 PRINT
300 PRINT"OK, STARSEEKER, I AM THINKING OF A NUMBER. START GUESSING."
320 N=1
330 PRINT
340 PRINT"WHAT IS YOUR GUESS";
350 INPUTG
360 IF G=X THEN 550
370 D=ABS(G-X)
380 IFD>=64THEN500
390 IFD>=32THEN490
400 IFD>=16THEN480
410 IFD>=8THEN470
420 IFD>=4THEN460
430 IFD>=2THEN450
440 PRINT" *";
450 PRINT" *";
460 PRINT" *";
470 PRINT" *";
480 PRINT" *";
490 PRINT" *";
500 PRINT" *";
510 PRINT
520 N=N+1
530 GOTO330
550 FORK=1TO10
560 PRINT"** ";
570 NEXT
580 PRINT"!!!"
590 PRINT"THAT'S IT!!! YOOU GUESSED MY COSMIC NUMBER IN"N"GUESSES"
600 PRINT
610 PRINT"WHAT TO PLAY AGIAN";
