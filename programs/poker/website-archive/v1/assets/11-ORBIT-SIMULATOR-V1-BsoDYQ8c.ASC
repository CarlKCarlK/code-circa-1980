10 PI=3.14159
20 CLS:PRINT:PRINT:PRINT:PRINT
30 TI=1
50 C=100
60 CLS
100 INPUT"HOW MANY OBJECTS";NO
105 DIM P(NO,2)
110 FORX=1TONO
120 INPUT"MASS,X,Y";P(X,0),P(X,1),P(X,2)
130 NEXT X
140 INPUT"MASS SPACE SHIP";MS
150 INPUT"X,Y OF SPACE SHIP";XS,YS
160 INPUT"HEADING (DEG.), AND INITAL VOCLICY OF SHIP";AS,VS
165 AS=AS/180*PI
180 FORI=1TONO:SET ( P(I,1), 47-P(I,2)/2 ) :NEXTI
190 SET(XS,47-YS/2)
200 VY=SIN(AS)*VS:VX=COS(AS)*VS
300 '
310 NB=0
315 YP=0:XP=0
320 FORI=1TO NO
330 A=ATN( (YS-P(I,2))/(XS-P(I,1)) )
332 IF P(I,1) > XS THEN A=A+PI
340 P= -MS*P(I,0)/ (   (  XS-P(I,1)  )[2+    (  YS-P(I,2)  )[2  )
350 YP=YP+P*SIN(A)
360 XP=XP+P*COS(A)
366 IF INT(XS)=INT( P(I,1)) AND INT(YS/2+.5)=INT(P(I,2)) THEN 1000
370 NEXT I
380 X=1/2* XP*TI +VX*TI
390 Y=1/2* YP*TI +VY*TI
400 MM= SQR(X[2+Y[2):IF MM>3 THEN TI=TI/2:NB=1:GOTO 315ELSE IF NB=0 AND MM<1THEN TI=TI*2:GOTO315
405 VX=X/TI:VY=Y/TI
410 XS=XS+X:YS=YS+Y
420 SET(XS,47-YS/2+.5)
430 GOTO 300
1000 A$=INKEY$
1010 A$=INKEY$
1020 IFA$=""THEN1010 ELSE 140
