10 CLS
200 PRINT"WHAT IS YOU WISH   (HELP FOR CHOICES)";:INPUT A$:C3=VAL( MID$(A$,2)):A$=LEFT$(A$+" ",1)
210 IF A$="H"THEN GOSUB 300:GOTO 200
220 IF A$="L" AND C3=0THEN GOSUB 400 ELSE IF A$="L"AND C3<>0THEN I=C3:A$="SHORT":GOSUB 410
230 IF A$="C" THEN GOSUB 500
240 IF A$="W" THEN GOSUB 600
250 IF A$="U" THEN GOSUB 800
260 A$="S" THEN GOSUB 900
299 GOTO 200
300 PRINT"--HELP--"
310 PRINT"YOUR CHOICES ARE:  LIST, LISTN (N IS A NUMBER), CREATE,WIRE,UNWIRE,SETN,RESETN,LOOK,LOOKN,PLUG,START OVER"
320 RETURN
400 FOR I=1 TO T
410 IF I>T THEN PRINT"THERE ARE ONLY "T" DEVICE(S)":RETURN
420 PRINTI;TAB(4);T$(I):FOR J=1TO4:IF S$(I,J)<>"NULL" THEN PRINTTAB(10);J;TAB(15);LEFT$(S$(I,J),1);"  ";MID$(S$(I,J),2);"  ";P(I,J,0);TAB(35);P(I,J,1)
425 NEXTJ
430 IF A$="SHORT"THEN RETURN ELSE PRINT:NEXTI:RETURN
500 T=T+1:INPUT"WHAT DO YOU WISH TO CREATE
LIGHT   SWITCH   NAND  NOR  XOR  JOINT BRANCH ";B$
510  RESTORE:FORJ=1TO7:READ T$(T),S$(T,1),S$(T,2),S$(T,3),S$(T,4):IF T$(T)<>B$THEN NEXT J:PRINT"NO SUCH DEVICE":T=T-1:RETURN
520 DATA LIGHT,IWAIT,NULL,NULL,NULL,
         SWITCH,ONO,OYES,NULL,NULL,
          NAND,IWAIT,IWAIT,IWAIT,OWAIT
530 DATA NOR,IWAIT,IWAIT,OWAIT,NULL,
          XOR,IWAIT,IWAIT,OWAIT,NULL,
          JOINT,IWAIT,IWAIT,OWAIT,NULL,
          BRANCH,IWAIT,OWAIT,OWAIT,NULL
535 PRINT"THIS "B$" IS DEVICE #"T"."
540 RETURN
600 INPUT "#DEVICEA,#CA,  #DEVICEB,#CB";D1,C1,D2,C2
610 B$="GOOD"
620 IF D1>T OR D1<1 OR D2>T OR D2<1 THEN PRINT"WIRE REJECTED! THERE ARE"T" DEVICES.":RETURN
630 IF C1>4 OR C1<1 OR C2>4 OR C2<0 THEN PRINT"WIRE REJECTED! THERE MAY NEVER BE MORE THAN 4 CONECTIONS":RETURN
635 IF LEFT$( S$(D1,C1),1)<>"O"THEN PRINT"POINT #"C1" OF A "T$(D1)" (DEVICE #"D1" ) CAN'T BE INPUT":B$="BAD"
640 IF LEFT$( S$(D2,C2),1)<>"I" THEN PRINT"POINT #"C2" OF A "T$(D2)" (DEVICE #"D2" ) CAN'T BE INPUT":B$="BAD"
650 IF P(D1,C1,0)<>0 THEN PRINT "POINT #"C1" OF A "T$(D1)" (DEVICE #"D1") HAS ALREADY BEEN CONNECTED TO A "T$(P(D1,C1,0))" (#"P(D1,C1,0)","P(D1,C1,1)")":B$="BAD"
660 IF S$(D2,C2)="IWAIT2"THEN PRINT"POINT #"C2" OF THE "T$(D2)" (DEVICE #"D2") ALREADY HAS AN INPUT.":B$="BAD"
670 IF B$="BAD"THEN RETURN
680 P(D1,C1,0)=D2:P(D1,C1,1)=C2:S$(D2,C2)="IWAIT2"
690 RETURN
800 INPUT" DEVICE,POINT";D1,C1
810 IF D1<0 OR D1>T OR C1<0 OR C1>4 THEN PRINT"FAIL.  THERE ARE"T" DEVICES EACH WITH A MAXIMUM OF FOUR POINTS":RETURN
820 IF P(D1,C1,1)=0 THEN PRINT"THERE IS NO WIRE FROM THAT POINT":RETURN
830 PRINT"IS THIS WHAT YOU WHAT?
UNWIRE FROM A "T$(D1)"  (DEVICE,POINT #s "D1","C1" ) TO":D2=P(D1,C1,0):C2=P(D1,C1,1):PRINT"A "T$(D2)"  (DEVICE,POINT #s "D2","C2" )."
840 INPUT"(Y)ES OR (N)O ";B$:IFB$<>"Y"ANDB$<>"N"THEN840ELSE IF B$="NO"THEN PRINT"NO ACTION TAKEN":RETURN
850 P(D1,C1,0)=0:P(D1,C1,1)=0:S$(D2,C2)="IWAIT":PRINT"UNWIRED":RETURN
900 PRINT"SETTING SWITCHS"
910 PRINT"ENTER    SWITCH#,YES/NO/FLIP";D1,B$
920 IF T$(D1)<>"SWITCH"THENPRINT"THAT DEVICE IS A "T$(D1)" NO A SWITCH":RETURN
930 IF B$="YES" THEN S$(D1,1)="OYES":S$(D1,2)="ONO" ELSE
     IF B$="NO"THEN   S$(D1,1)="ONO":S$(D1,2)="YES" ELSE
     IF B$="FLIP" THEN B$=MID$( S$(D1,2):GOTO 930
940 PRINT"THE SWITCH IS "MID$( S$(D1,2)".":RETURN
