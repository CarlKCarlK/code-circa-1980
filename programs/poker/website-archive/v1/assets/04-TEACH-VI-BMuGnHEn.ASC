1 '
5 CLEAR739
10 'TEACH VI                      BY CARL KADIE JAN. 11,1979
20 DIM Q(250)
30 DEFINTX,C,D,S,M
100 READA$:IFA$<>"DONE"THEND=D+1:GOTO100
110 RESTORE
120 FORC=1TOD/2:Q(C)=C:NEXT:C=1
200 FORQ=1TOD/2
210 IF Q(Q)<CTHENRESTORE:C=1:GOTO210
220 FOR S=CTOQ(Q):READA$:READB$:NEXT:C=S
250 CLS:PRINT@27,"TEACH VI":PRINT@320,"QUESTION"Q": "A$
260 INPUTA$
270 IFA$=B$THEN350
280 PRINT"SORRY YOU MISSED IT.  THE CORRECT ANSWER WAS :"
290 PRINTB$:M=M+1:Q(M)=Q(Q):GOTO400
350 PRINT"THAT'S RIGHT!  VERY GOOD."
400 B$="":A$=""
410 A$=INKEY$:IFA$=""THEN410ELSENEXT
500 P=100*((D/2)-M)/(D/2):CLS:PRINT@320,"OUT OF"D/2"QUESTIONS, YOU GOT"D/2-M"RIGHT. THAT'S "P"%"
510 PRINT"IF YOU WERE TAKING THIS IS SCHOOL, THAT WOULD BE ";:IFP>=92.5THENPRINT"AN A."ELSEIFP>=84.5THENPRINT"A B."ELSEIFP>=76.5THENPRINT"A C."ELSEIFP>=68.5THENPRINT"A D."ELSEPRINT"A F."
515 IFM=0THEN550
520 PRINT:INPUT"WOULD YOU LIKE TO TRY THOSE YOU MISSED";A$:IFA$="YES"THEND=M*2:M=0:P=0:GOTO200ELSEIFA$<>"NO"THEN520
550 INPUT"THEN WOULD YOU LIKE TO TRY AGIAN";A$:IFA$="YES"THENRUN1ELSEIFA$="NO"THENPRINT"SO-LONG":PRINT:PRINT:ENDELSEGOTO550
10000 'PLACE DATA IN FORM OF    QUESTION,ANSWER, QUESTION,ANSWER.....AND SO ON  HERE
