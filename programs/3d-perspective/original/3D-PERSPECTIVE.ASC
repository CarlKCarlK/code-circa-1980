20 INPUT"WHERE ARE YOU (X,Y,Z)";XO,YO,ZO:YO=-(YO)
30 INPUT"WHAT IS THE SCALE";TS
50 POKE16553,255
70 CLS
80 FORPP=0TO63:PRINT@PP+448,".";:NEXT
90 READ D:FORDD=1TOD
100 READX1,Y1,Z1,X2,Y2,Z2:Y1=-(Y1):Y2=-(Y2)
110 SY=(Y1-Y2)/100:SX=(X1-X2)/100:SZ=(Z1-Z2)/100
120 FORC=1TO100STEP4
130 Y=SY*C+Y2-YO
140 X=SX*C+X2-XO
150 Z=SZ*C+Z2-ZO
190 IFZ=0THENZ=.0001
200 XG=X/Z
210 YG=Y/Z
300 XG=XG*2*TS+64
310 YG=YG*TS+24
400 PRINT@0,X,Y,Z
500 IFXG<0ORYG<0ORXG>127ORYG>47THEN600
550 SET(XG,YG)
560 PRINT@0,X,Y,Z
600 NEXT:NEXT
610 PRINT@0,"DONE";
620 GOTO620
9999 DATA12
10000 DATA-1,0,1,1,0,1,1,0,1,1,0,-1,1,0,-1,-1,0,-1,-1,0,-1,-1,0,1
10010 DATA-1,0,1,0,2,1,1,0,1,0,2,1,1,0,-1,0,2,1,-1,0,-1,0,2,1
10020 DATA2,1,-6,2,1,-1,2,1,-1,2,0,-1,2,0,-1,2,0,-6,2,0,-6,2,1,-6
