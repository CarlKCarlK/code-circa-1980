10 'TRIGECTIOR           BY CARL KADIE A.D.  OCT. 24, 1978
100 CLS:INPUT"SPEED (METERS/SECOND)";V
110 INPUT"ANGLE (DEG. FROM HORIZON)";A
115 INPUT"HOW MANY METERS HIGH IS THE SCREEN";S
120 CLS:A=A*.0174533:T=0
130 T=T+.025
150 HS=T*V
160 XS=COS(A)*HS
170 YS=SIN(A)*HS
180 Y=YS-4.9*T*T
190 X=XS
200 YG=Y*48/S
205 XG=X*48/S
210 IFYG>47THENYG=YG-47:GOTO210
220 IFY<0THENPRINT"<DONE>":GOTO1000
230 IFXG*2>127THENXG=XG-63.5:GOTO230
260 SET(XG*2,47-YG)
270 GOTO130
1000 IFINKEY$=""THEN1000ELSEPRINT@0,"CONTACT WITH GROUND AT"2*V*SIN(A)/9.8"SECS."
1010 PRINT"TIME TO HIGHEST POINT WAS "V*SIN(A)/9.8"SECS."
1020 PRINT"PROJECTILE REACHED A MAXIMUM HEIGHT OF"V*V*(SIN(A))[2/19.6"METERS"
1030 PRINT"THE RANGE WAS"V*V*SIN(2*A)/9.8"METERS
