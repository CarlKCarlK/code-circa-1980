10     ' QUEST           A TINY ADVENTURE FROM BYTE JULY 1979 
20 '                    VOL 4   #7
100 REM
110 REM
120 PRINTTAB(20),"QUEST"
130 PRINT
140 PRINT"YOU WERE WALKING THROUGH THE"
150 PRINT"WOODS, AND YOU CAME ACROSS THE ENTRANCE"
160 PRINT"OF A CAVE, COVERED WITH BRUSH."
170 PRINT
180 PRINT"PEOPLE SAT THAT MANY YEARS AGO A"
190 PRINT"PIRATE HID HIS TREASURE IN THESE"
200 PRINTWOODS, BUT NO ONE HAS EVER FOUND IT."
210 PRINT"IT MAY STILL BE HERE, FOR ALL I KNOW."
400 READ M9,T1,T2
490 REM
500 DIM W(42),M(6,42)
510 REM
520     FORI=1TO9
530     READ N
540     IF I=N THEN 570
550     PRINT"DATA BASE PROBLEM"I,M
560     STOP
570     FOR J=1 TO 6
580     READ M(J,I)
590     NEXTJ
600     NEXTI
900 PRINT
905 PRINT"WHEN YOU ANSWER A QUESTION, I LOOK AT"
906 PRINT"ONLY THE FIRST LETTER, ALTHOUGH YOU CAN"
907 PRINT"TYPE THE WHOLE WORD IF YOU LIKE."
1000 REM
1010 N=5
1020 M0=0
1030 M6=0
1040 T=T1
1050 P=0
1060 P1=0
1070 FOR J=1 TOM9
1080    W(J)=0
1090 NEXT J
1100 PRINT
1110 REM
1120    GOSUB8000
1400 REM
1405 REM
1410 REM
1420  M0=M0+1
1430 REM
1440    GOSUB 6000
1450 REM
1460    GOSUB 2000
1470 REM
1480    GOSUB4000
1490 REM
1500    IF T>0 THEN 1400
1510    IF N<>5 THEN 1400
1700 REM
1710    GOSUB 3000
1720 PRINT
1730 PRINT"CONGRATULATIONS! YOU GOT THE TREASURE"
1740 PRINT"OUT IN";M0;
1750 PRINT"MOVES AND YOUR GOT""S+10"POINTS!"
1760 PRINT"WANT TO HUNT AGAIN ?";
1770 A$="YN"
1771 A2=2
1780 GOSUB5000
1790 ON A1 GOTO 1000,9999,1760
2000 REM
2010 REM
2100 IF T<>N THEN RETURN
2110 IF T<0 THEN RETURN
2120  IF M6+5>M0 THEN RETURN
2200 PRINT"DO YOU WANT TO TAKE IT WITH YOU ?";
2210 A$="YN"
2220 A2=2
2230 GOSUB 5000
2240 ON A1 GOTO 2300,2400
2250 PRINT"WELL?...."
2260 GOTO 2210
2300 T=-1
2310 PRINT
2320 PRINT"OK, LETS GET OUT OF HERE!"
2330 RETURN
2400 PRINTPRINT
2410 PRINT"WE'LL LEAVE IT HERE AND YOU CAN EXPLORE"
2420 PRINT"SOME MORE."
2430 M6=M0
2440 RETURN
3000 REM
3010 REM
3020 S=0
3030 IF T=-1 THEN S=S+5
3040 IF P=1 THEN S=S+10
3050 FOR J=2 TO M9
3060    S=S+W(J)
3070 NEXTJ
3080 RETURN
4000 REM
4010 REM
4020 IF N=T2 THEN RETURN
4030 IF P=1 THEN RETURN
4040 IF T1=T2 THEN RETURN
4050 IF T<>-1 THEN RETURN
4060 REM
4070 IF N=16 THEN P=160
4080 REM
4090 IFP1>0 THE P1=P1+1
4100 IF N=3 THEN P1=P1+1
4110 REM
4120 IF P1<15 THEN RETURN
4130 PRINT
4140 PRINT"SUDDENLY THE PIRATE LEAPS OUT OF THE"
4150 PRINT"GLOOM AND GRABS TTHE TREASURE FROM YOU!"
4160 PRINT"'HAH', HE SHOUTS, 'YOU FOUND MY"
4170 PRINT"TREASURE, DID YOU?!  WELL, I'LL HIDE"
4180 PRINT"IT BETTER THIS TIME! '"
4190 PRINT"AND HE DISAPPEARS INTO THE DARKNESS"
4200 PRINT"WITH THE TREASURE."
4210 P=1
4220 T=T2
4230 RETURN
5000 REM
5010 REM
5020 REM
5030 REM
5040 REM
5050 REM
5060 REM
5070 INPUT Q$
5080 REM
5090 Q$=LEFT$(Q$,1)
5100 REM
5110 REM
