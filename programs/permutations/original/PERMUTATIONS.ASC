5 CLEAR 5000:DIM O$(100)
10 INPUT "HOW MANY OBJECTS";FF
15 F!=1
20 PRINT"THE LIST WILL BE ";:FOR I=2TOFF:F!=F!*I:NEXTI
30 PRINTF!;" LONG."
40 FOR I=1TOFF
50 PRINT"WHAT IS OBJECT #"I;:INPUT O$(I)
60 NEXTI
70 PRINT
89 A$="NO"
90  INPUT"WOULD YOU LIKE TO FIX OR CHANGE ANY OBJECTS";A$
100 IF A$="N" ORA$="NO"THEN 140
110 PRINT
120 INPUT"WHAT IS THE NUMBER AND NEW VALUE OF THE OBJECT";I,O$(I)
130 GOTO  90
140 SS=1:GOSUB 500
142 FC=1:DV=1:FOR  T=2 TO FF:IF O$(T)=O$(T-1) THEN FC=FC+1 ELSE FA=1:FOR J=1TOFC:FA=FA*J:NEXTJ:DV=DV*FA:FC=1
145 NEXT T:IF DV<>1 THENPRINT"DUPLICATES ARE PRESENT. NUMBER OF PERMUTATIONS IS";F!/DV"."
150 PRINT,:PRINT"*";:FORI=1TOFF:PRINTO$(I);" ";:NEXTI
160 P=FF-1:LB=FF
170 IF P=0 THEN 300
180 IF O$(P)>= O$(P+1)  THEN P=P-1:GOTO170
190 LB=FF:IFP=FF-1 THEN 220 ELSE  FOR T=P+1TOFF-1:IF O$(T)>O$(P) AND (O$(T)<O$(LB) OR O$(LB)<=O$(P))THEN  LB=T
200 NEXT T
220 A$=O$(P):O$(P)=O$(LB):O$(LB)=A$
230 SS=P+1:GOSUB500
240 GOTO 150
300 PRINT:PRINT"DONE   (ANY BUTTON TO RUN AGAIN)"
310 IF INKEY$=""THEN310 ELSE RUN
500 'BUBBLE SORT FOR SS TO FF OF O$(N)
505 IF SS=FF THEN RETURN
510  FOR SP=SS TO FF-1
520     SF=0:FOR LS=FF-1TO SP STEP-1
530         IF O$(LS+1)<=O$(LS) THEN SF=1:A$=O$(LS+1):O$(LS+1)=O$(LS):O$(LS)=A$
540         NEXT LS:IF SF  THEN NEXT SP
550  RETURN
