1 CLS
2 CLEAR 999
10 T=0
100 PRINT@64,"";:IF T=0 THEN 200 ELSE FOR A=1 TO T
110 IF TIME$>= T$(A) THEN PRINT @ 960,T$(A), ELSE 130
115 PRINT*"TIME TIME TIME TIME TIME"
120 PRINT*P$(A);
121 PRINT P$(A);
125 T$(A)=T$(T):P$(A)=P$(T):T=T-1
130 PRINT T$(A),P$(A):IF T$(A)<T$(A-1) THEN T$=T$(A):T$(A)=T$(A-1):T$(A-1)=T$:T$=P$(A):P$(A)=P$(A-1):P$(A-1)=T$NEXT A
145 NEXT A
200 PRINT @0,TIME$
205 IF INKEY$="" THEN 100
210 T$=TIME$
215 T=T+1
220 INPUT"ITEM: ";P$(T)
230 INPUT"TIME FROM NOW: ";D$
232 IF LEN(D$)=1 THEN D$=" "+D$
235 IF LEN(D$)<7 THEN D$="00:"+D$
237 D$=LEFT$(T$,9)+D$
240 H=VAL(MID$(T$,10,2)):M=VAL(MID$(T$,13,2)):S=VAL(MID$(T$,16,2))
241 ST=60
250 H=H+VAL(MID$(D$,10,2)):M=M+VAL(MID$(D$,13,2)):S=S+VAL(MID$(D$,16,2))
251 M=M+INT(S/ST):S=S-INT(S/ST)*ST
252 H=H+INT(M/ST):M=M-INT(M/ST)*ST
260 MID$(T$,10,2)=MID$(STR$(H),2):MID$(T$,13,2)=MID$(STR$(M),2):MID$(T$,16,2)=MID$(STR$(S),2)
271 T$(T)=T$
281 GOTO 100
