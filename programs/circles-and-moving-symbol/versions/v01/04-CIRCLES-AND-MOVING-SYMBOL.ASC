5 POKE16553,255
10 CLS:FORR=2TO44STEP4:FORA=-RTOR:Y=SQR(R*R-A*A):Y=Y/2:SET(A+60,23+Y):SET(A+60,23-Y):SET(A+61,23+Y):SET(A+61,23-Y):NEXTA:NEXTR
20 S$=CHR$(93)+CHR$(94)
30 L$=INKEY$:IFL$=""THENL$=O$
35 GOTO100
40 PRINT @ W,"  ";
45 IF(L<0)OR(L>1020)THENL=O
50 PRINT @ L,S$;:W=L
70 GOTO30
100 IFL$="1"THENL=L-64
110 IFL$="2"THENL=L+64
120 IFL$="3"THENL=L-1
130 IFL$="4"THENL=L+1
135 IF(L$="1")OR(L$="2")THENS=4ELSES=1
140 FORP=1TO10*S:NEXTP:O$=L$:GOTO40
