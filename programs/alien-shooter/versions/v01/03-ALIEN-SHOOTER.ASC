5 RANDOM
7 DIMA(64),B(64)
10 CLS:A=5:S=3:P=10:Y=60
12 A$=STRING$(5,143)
20 FOR X=1TOA
30 A(X)=((INT((116/A)-INT(116/(A*2)))*X)-1)*2-2
35 IFA(X)>122THENA(X)=122ELSEIFA(X)<6THENA(X)=6
40 B(X)=0:NEXTX
50 PRINT"KEYS USED ARE ";CHR$(93);CHR$(94);"TO MOVE,CLEAR TO MAKE A NEW SHIELD,AND ENTER TO FIRE"
60 INPUT"PRESS ENTER TO START GAME";B$
70 CLS
80 '*SET UP GRAPHICS*
90 FOR X=60TO69
100 ON X-59GOTO130,130,120,120,110,110,120,120,130,130
110 SET(X,45)
120 SET(X,46)
130 SET(X,47)
140 NEXTX
150 PRINT@INT(Y/2)+896,A$;
160 FORX=1TOA
170 SET(A(X),B(X)):SET(A(X)+1,B(X))
180 NEXTX
190 FOR X=1TOA
195 IFA(X)=-1THEN300
200 FORZ=1TOS:GOSUB350:NEXTZ
210 IFA(X)=-1THEN300
220 IF RND(P)=1THEN310
230 C=RND(4)-2:D=RND(3)-2
240 IF B(X)+C<0THENC=0
250 IFB(X)+C>41 THEN510
260 IFA(X)+D<6OR A(X)+D>122THEN D=0
270 RESET(A(X),B(X)):RESET(A(X)+1,B(X))
280 A(X)=A(X)+D:B(X)=B(X)+C
290 SET(A(X),B(X)):SET(A(X)+1,B(X))
300 NEXTX:GOTO190
310 IF POINT(A(X),42)=-1THEN RESET(A(X),42):GOTO300
320 IF POINT(A(X),43)=-1THEN RESET(A(X),43):GOTO300
330 IF POINT(A(X),47)=-1THEN510
340 GOTO300
350 PRINT@0,"";:C=PEEK(14400):IF C=0THENRETURN
360 C=INT(LOG(C)/LOG(2))+1
370 ON C GOTO380,410,440,440,440,420,450,440
380 FORC=1TOA
390 IF Y+4=A(C)THEN RESET(A(C),B(C)):RESET(A(C)+1,B(C)):A(C)=-1:K=K+1:IF K=ATHEN490ELSE RETURN
400 NEXTC:RETURN
410 PRINT@INT(Y/2)+896,A$;:RETURN
420 IF Y<1THENRETURN
425 RESET(Y+9,47):RESET(Y+7,46):RESET(Y+5,45)
430 Y=Y-1:SET(Y,47):SET(Y+2,46):SET(Y+4,45)
440 RETURN
450 IF Y>117THENRETURN
460 RESET(Y,47):RESET(Y+2,46):RESET(Y+4,45)
470 Y=Y+1:SET(Y+9,47):SET(Y+7,46):SET(Y+5,45)
480 RETURN
490 CLS:PRINT"YOU MADE IT THROUGH THIS SET SO I'LL MAKE THE NEXT ONE HARDER.  PRESS ANY KEY TO CONTINUE"
495 A$=INKEY$:IF A$=""THEN495
500 E=E+1:K=0:Y=60:IF A=32THEN12 ELSE A=A+1:GOTO12
510 CLS:PRINT"HA!HA!HA!YOU GOT KILLED YOU DUMB MOTHER FUCKER!":FORX=1TO200:NEXT:CLS:PRINT"OPPS! OOPS? WELL ANYWAY YOU KILL "E" SETS OF ALLIENS BEFORE THEY KILLED YOU":PRINT"HEY STUPID! YOU WANNA GET KILLED AGAIN":INPUTA$:IF A$="NO" THENNEW
520 FORX=1TO100:NEXT:RUN
