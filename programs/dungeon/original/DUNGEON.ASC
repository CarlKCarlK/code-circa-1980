10 CLEAR1000
20 'DUNGEON TRAINER  - FIGHTING MAN
30 CLS
40 PRINT"WELCOME, THE IS THE FIRST DUNGEON TRAINER
50 PRINT">>>>>----------->   FIGHTING MAN   <------------<<<<<<<"
55 HX=30:MX=100:RR=8:PI=3.14159:SA=PI*2/5:EA=-PI*2/5
60 FORX=1TO500:NEXT
70 CLS
80 GOSUB 550  
90 HP=RND(8)
100 MN=RND(8)
110 R=RND(4):IFR=1THEN A$="NOTHING"ELSEIFR=2THENA$="LEATHER"ELSEIFR=3THENA$="CHAIN MAIL"ELSEIFR=4 THEN A$="PLATE MAIL"
120 T=RND(2):IF T=1THEN S$="A SHEILD"ELSES$="NO SHEILD"
130 AC=(5-R)*2+T-1
140 MA=RND(8)+1
150 P=2:IFP=2THENT$="FIGHTING MAN"ELSET$="NON FIGHTING MAN"
151 CLS
152 LINE(0,18)-(127,18),SET:PUT@(HX,8)-(HX+2,17),SET,H%:PUT@(MX,8)-(MX+4,17),SET,M%
170 PRINT@448,"";
180 PRINTA$" AND "S$". ";
190 W=RND(7):IF W=1THENW$="DAGGER"ELSEIFW=2THENW$="HAND AXE"ELSEIFW=3THENW$="SWORD"ELSEIFW=4THENW$="BATTLE AXE"ELSEIFW=5THENW$="MORNING STAR"ELSEIFW=6 THENW$="FLAIL"ELSE IF W=7 THEN W$="TWO-HANDED SWORD"
200 GOSUB610  
210 PRINTW$"."
220 PRINT"YOUR HIT POINT IS "HP
225 TC$="F":GOTO 405
230 GOSUB610  
240 PRINT:PRINT"YOU COME ACROSS A MONSTER IN THE CAVES. HE IS NOT FRIENDLY.
250 IF RND(2)=1 THENPRINT"HE ATTACKS FIRST."ELSEPRINT"YOU ATTACK FIRST":GOTO 400  
260 GOSUB610  
270 GOSUB610  
280 GOSUB610  
290 GOSUB610  
300 P$="":INPUT"DO YOU WISH IS PARRY HIS ATTACK (ENTER FOR NO, 'Y' FOR YES)";P$
310 RT=RND(20):IF P$="Y"THEN RT=RT-2
320 GOSUB610  
330 IF RT<M(MN,AC) OR RT=M(MN,AC) AND P$=""THEN PRINT"THE MONSTER MISSES!":GOTO 370  
340 IF RT=M(MN,AC) AND P$="Y"THEN PRINT"THE BEAST MISSES, BUT BRAKES YOUR "W$:W$="NOTHING":GOTO370  
350 GOSUB610  
360 PRINT"HE HITS YOU LEAVING YOU WITH ";:HP=HP-RND(6):IF HP<=0THEN540  ELSEPRINTHP" HIT POINTS."
370 '
380 GOSUB610  
390 GOSUB610  
400 IFTC$="W"THEN PRINT"YOU HAVE WITHDRAW ALIVE":ENDELSEINPUT"DO YOU WISH TO (F)IGHT OR (W)ITHDRAW";TC$
405 IF TC$="F"THENGOSUB5000:GOSUB6000:GOSUB5100:GOSUB6100:GOTO405
410 IF T=2 AND TC$="W"THEN AC=AC-1
420 IF TC$="W"THEN530  
430 IF P$="Y"THENPRINT"SORRY, HE HIT YOU AGAIN AFTER YOU PARRY.":GOTO 300  
440 PRINT"YOU RAISE YOUR "W$" IN THE AIR ,"
450 GOSUB610  
460 TT=RND(20):IF TT>= P(P,MA) THEN PRINT"AND HIT HIM, YOU DID ";:DM=RND(6):PRINTDM" DAMAGE,":GOTO 520  
470 GOSUB610  
480 PRINT"BUT MISS HIM."
490 GOSUB610  
510 GOSUB610  
520 MN=MN-DM:IF MN<=0 THEN PRINT" AND KILLED HIM !!!!!":GOTO 620  ELSEPRINT" BUT HE LIVES ON .":GOTO  300  
530 PRINT"YOU RUN, BUT HE GETS ONE LAST HIT.":PT$="":GOTO 310  
540 PRINT: PRINT" NOTHING, NOT EVEN YOU LIFE. HE HAS WON.":GOTO620  
550 DIM P(2,9):FOR X=2TO9:P(1,X)=20-X:P(2,X)=19-X:NEXTX
560 DIM M(12,9):FOR X=1TO12:READ M(X,9):NEXT:FORX=8TO2STEP-1:FORY=1TO12:M(Y,X)=M(Y,X+1)+1:NEXTY,X
570 DATA 10,9,8,6,5,5,4,4,2,2,0,0
580 LINE(0,0)-(2,9),SET,BF:RESET(0,2):RESET(2,2):RESET(2,7):RESET(2,8):DIM H%(20):GET@(0,0)-(2,9),G,H%
590 CLS:LINE(0,0)-(4,9),SET,BF:LINE(0,0)-(2,0),RESET:LINE(4,0)-(4,3),RESET:RESET(0,3):RESET(1,3):LINE(0,5)-(0,8),RESET:RESET(1,8):RESET(2,8):RESET(4,9):RESET(4,8):DIMM%(30):GET@(0,0)-(4,9),G,M%:CLS
600 RETURN
610 FORU=1TO1000:NEXT:RETURN
620 GOSUB 610  :RUN
5000 FOR A=SA TO EA STEP -.3:X1=COS(A)*6+HX+3:Y2=SIN(A)*3+11:LINE(3+HX,4)-(HX+9,16),RESET,BF:LINE(HX+3,11)-(X1,Y2),SET:LINE(X1,Y2)-(X1,Y2-4),SET:NEXTA:RETURN:'H RAISES SWORD
5100 FOR A =PI+EA TO PI+SA STEP .3:X1=COS(A)*6+MX+1:Y2=SIN(A)*3+12:LINE(MX-1,4)-(MX-6,16),RESET,BF:LINE(MX,12)-(X1,Y2),SET:LINE(X1,Y2)-(X1,Y2-4),SET:NEXTA:RETURN:' M LIFTS SWORD
6000 RESET(HX+4,9):X3=HX+5.48:Y3=3:X4=X3:Y4=14:FOR A=EA TO SASTEP .5:X1=COS(A)*6+HX+3:Y2=SIN(A)*3+11:X2=X1+COS(A-.4)*RR:Y1=Y2+SIN(A-.4)*4
6010 LINE(HX+3,11)-(X3,Y3),RESET:LINE(X3,Y3)-(X4,Y4),RESET:LINE(HX+3,11)-(X1,Y2),SET:LINE(X1,Y2)-(X2,Y1),SET:X3=X1:Y3=Y2:X4=X2:Y4=Y1:NEXTA:RESET(HX+10,16):RETURN
6100 X3=MX-2:Y3=3:X4=X3:Y4=14:FORA=  PI+SATO PI+EA STEP -.5:X1=COS(A)*6+MX-2:Y2=SIN(A)*3+12:X2=X1+COS(A+.4)*RR:Y1=Y2+SIN(A+.4)*4
6110 LINE(MX,12)-(X3,Y3),RESET:LINE(X3,Y3)-(X4,Y4),RESET:LINE(MX-2,12)-(X1,Y2),SET:LINE(X1,Y2)-(X2,Y1),SET:X3=X1:Y3=Y2:X4=X2:Y4=Y1:NEXTA:RETURN
