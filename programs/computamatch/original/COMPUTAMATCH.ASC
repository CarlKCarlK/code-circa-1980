5 CLEAR 1000
10 REMARK    TITLE: COMPUTER MATCH-UP
20 REMARK    PROGRAMED: CARL KADIE  SENATOR, WOODRUFF HIGH
30 REMARK               SCHOOL COMPUTER CLUB
40 REMARK    FOR: WOODRUFF HIGH SCHOOL STUDENT COUNSIL
50 REMARK    DATE: JANUARY 6TH, 1980 
60 REMARK
70 REMARK NQ IS THE NUMBER OF QUESTIONS
80 LET NQ = 10
90 REMARK SS IS THE SCALE SIZE
100 LET SS = 4
110 REMARK NM IS THE NUMBER OF MATCHES FOR EACH PERSOM
120 LET NM = 1
130 REMARK SF: AIDS COUNTER , FC: FEMALE COUNT, MC: MALE COUNT
140 READ D$:IFD$="F"THEN SC=1:GOTO 140
145 IF D$="DONE"THEN 300
150 IF SC=1THEN FC=FC+1
160 IF SC=0THEN MC=MC+1
170 IF MID$(D$,LEN(D$)-5,1)=" "AND MID$(D$,LEN(D$)-11,1)=" " AND MID$(D$,LEN(D$)-15,1)=" " AND MID$(D$,LEN(D$)-17,1)=" " THEN 200
180 PRINT"THERE IS AN ERROR IN THEN DATA LINE : ";D$
190 IF SC=1THENPRINT"THE ERROR IS THE "FC" GIRL LISTED."
195 IF SC=0 THENPRINT"THE ERROR IS THE "MC" BOY LISTED."
198 STOP
200 GOTO 140
300  SC=MC:IF FC>MC THEN SC=FC
310 DIM M%(SC,NQ,1) , D$(MC+FC), D%(SC)
315 RESTORE
320 FOR SX= 0 TO 1
330 SC=MC:IFSX=1THENSC=FC
340 FOR PS= 1 TO SC
345 READ D$
350 D$(PS+SX*MC) = LEFT$(D$,LEN(D$)-25)
355 RX = 0
360 FOR QU=0TO NQ-1
365 IF QU=5 OR QU=10 THEN RX=RX+1
370 M%(PS,QU+1,SX)= VAL( MID$(D$,LEN(D$)-QU-RX,1))
380 NEXT QU,PS:READ D$:NEXT SX
500 FOR SX=0TO1
510 SC=MC:CS=FC:IFSX=1THEN SC=FC:CS=MC
520 FOR PS=1TO SC
530 FOR OS=1TOCS
540 D%(OS)=0
550 FOR QU=1TONQ
560 D%(OS)=D%(OS)+(M%(PS,QU,SX)-M%(OS,QU,ABS(SX-1)))[2
570 NEXT QU,OS
580 FOR FL=1TO NM
590 RC=32000:RH=0
600 FOR PL=1TO CS
610 IF D%(PL)<RC THEN RC=D%(PL):RH=PL
620 NEXT PL
630 D%(RH)=32000:PRINTD$( RH+ABS(SX-1)*MC)
640 NEXT FL
650 NEXT PS
660 NEXT SX
1000 DATA"CARL KADIE6859324 4 123 12112 12431",JOHN JORGENSEN6843453 3 123 12343 13412,F,PEGGY GERKIN6881234 2 344 21234 34212,TUNJA TUSOR6763453 1 243 16532 12321,SUZIE CHAPSTICK6678543 2 134 12112 12431
9999 DATA "DONE"
