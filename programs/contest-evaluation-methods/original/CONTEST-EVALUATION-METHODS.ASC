5 DEFINT A-Z
10 CLS
20 PRINT"TESTING OF VARIOUS METHODS OF EVALUATION"
30 INPUT"HOW MANY CONTESTANTS";NC
40 INPUT"HOW MANY SECTIONS   ";NS
50 INPUT"HOW MANY ROUNDS     ";NR
60 INPUT"HOW MANY IN FINAL ROUND";NF
70 DIM R(NC), S(NS,-INT(-NC/NS)),F(NC),P(6)
80 '
90 FOR RD=1TO NR
95 C=0
100 FOR M=1TO -INT(-NC/NS)
110 FOR S=1TO NS
120 C=C+1:IF C>NC THEN 140
130 RS=RND(S):RM=RND(M):S(S,M)=S(RS,RM):S(RS,RM)=C
140 NEXT S,M
145 '
150 FOR SS=1TO NS
160 FOR P=1 TO -INT(-NC/NS)
165 R=0
170 FOR M=1TO -INT(-NC/NS)
180 IF (S(SS,M)<R AND S(SS,M)<>0 ) OR R=0 THEN R=S(SS,M):L=M
185 NEXT M
190 R(R)=P+R(R):S(SS,L)=0
191 NEXT P
192 NEXT SS
193 NEXT RD
200 F=0
210 S=0
220 S=S+1
230 FORC=1TONC
240 IF R(C)=S THEN F=F+1:F(F)=C
250 NEXT C
260 IF F<NF THEN 220
265 FORFF=1TOF:PRINTF(FF);:NEXTFF
270 FOR P=1TO6
280 FOR FF=1TOF 
290 IF F(FF)<>P THEN NEXT FF:GOTO 320
300 P(P)=P(P)+1
305 PRINTP"FOUND    ";
310 NEXT P
320 IF INKEY$=""THEN90
330 LPRINT"PERCENTAGE OF TIME THAT ORDER   IS CORRECT TO THE N TH PLACE "
340 LPRINT"AFTER"P(1)"CONTESTS"
350 FOR P=1TO6:LPRINTP(P)/P(1)*100"%",P:NEXTP:LPRINT
360 GOTO 90
