1 '
5 CLEAR739
10 'TEACH VI                      BY CARL KADIE JAN. 11,1979
20 DIM Q(250)
30 DEFINTX,D,S,M
40 CLS:PRINT"TEACH VI"
100 READA$:IFA$<>"DONE"THEND=D+1:GOTO100
110 RESTORE
120 FORC=1TO100:Q(C)=C:NEXT
200 FORQ=1TO100
220 READB$,A$
250 P=100*(Q-M)/Q:CLS:PRINT@27,"TEACH VI     ";P:PRINT@320,"QUESTION"Q": "A$
260 IFINKEY$=""THEN260
270 PRINTB$
280 C$=INKEY$:IFC$="Z"THEN350ELSEIFC$=""THEN280
290 PRINTB$:M=M+1:Q(M)=Q(Q):GOTO400
350 PRINT"THAT'S RIGHT!  VERY GOOD."
400 B$="":A$=""
410 NEXT
500 P=100*((D/2)-M)/(D/2):CLS:PRINT@320,"OUT OF"D/2"QUESTIONS, YOU GOT"D/2-M"RIGHT. THAT'S "P"%"
510 PRINT"IF YOU WERE TAKING THIS IS SCHOOL, THAT WOULD BE ";:IFP>=92.5THENPRINT"AN A."ELSEIFP>=84.5THENPRINT"A B."ELSEIFP>=76.5THENPRINT"A C."ELSEIFP>=68.5THENPRINT"A D."ELSEPRINT"A F."
515 IFM=0THEN550
520 PRINT:INPUT"WOULD YOU LIKE TO TRY THOSE YOU MISSED";A$:IFA$="YES"THEND=M*2:M=0:P=0:GOTO200ELSEIFA$<>"NO"THEN520
550 INPUT"THEN WOULD YOU LIKE TO TRY AGIAN";A$:IFA$="YES"THENRUN1ELSEIFA$="NO"THENPRINT"SO-LONG":PRINT:PRINT:ENDELSEGOTO550
10000 'PLACE DATA IN FORM OF    QUESTION,ANSWER, QUESTION,ANSWER.....AND SO ON  HERE
10010 DATA"EVENING","DER ABEND","EVERYBODY","ALLES","ON","AUF","EXSAMPLE","DAS BEISPIEL","LETTER","DER BRIEF","THICK","DICK","SPUPID","DUMM","PARENTS","DIE ELTERN (PL.)","YOUR","EUER","BOTTLE","DIE FLASCHE","EARLY","FRU:H","FOOT","DER FUSS"
10020 DATA"VEEGETABLE","DAS GEMU:SE","GRANDPARENT","DIE GROSSEELTERN","TO HAVE","HABEN","HEAVEN","DER HIMMEL","INTERESTING","INTERESSANT","NOW","JETZT","CHILD","DAS KIND","HEAD","DER KOPF","TO LIVE","LEBEN","TO LOVE","LIEBEN"
10030 DATA"LUNCH","DAS MITTTAGSSEN","MOUTH","DER MUND","NO","NEIN","SALT","DAS SALZ","PUPIL","DER SCHU:LER","FOSIL","SITZEN","CITY","DIE STADT","CUP","DIE TASSE","TO DRINK","TRINKEN","AND","UND","MUCH","VIEL","WALL","DIE WAND","WHERE","WO"
10040 DATA"HOWEVER","ABER","ANSWER","DIE ANTWORT","BATH","DAS BAD","BEER","DAS BIER","TO THANK","DANKEN","THIS - THAT","DIESER","EGG","DAS EI","END","DAS ENDE","COLOR","DIE FARBE","BOY FRIEND","DER FREUND"
10050 DATA"BREAKFAST","DAS FRU:HSTU:CK","TO GIVE","GEBEN","GLADLY","GERN","GREEN","GRU:N","NOTEBOOK","DAS HEFT","HAT","DER HUT","YES","JA","YOUNG","JUNG","CLASS","DIE KLASSE","SICK","KRANK","TEACHER","DER LEHRER","THEY, YOU, PEOPLE"
10060 DATA"MAN","MONTH","DER MONAT","NONE","NEUN","RAIN","REGEN","SLEEP","DER SCHLAF","HIS, ITS, ONE","SEIN (ADJ.)","TO PLAY","SPEILEN","HOUR, LESSON","DIE STUNDE","THEATER","DAS THEATER","EXERSISE","DIE U:BUNG","OUR","UNSER","FOUR","VIER","WHITE","WEISS"
10070 DATA"ROOM","DAS ZIMMER","ADDRESS","DIE ADRESSE","WORK","DIE ARBEIT","SOON","BALD","WIDE","BREIT","YOUR","DEIN","THERE","DOORT","A, ONE, AN","EIN","TO EAT","ESSEN","FEATHER","DIE FEDER","GLAD","FROH","FIFTY"
10080 DATA"FU:NFZIG","MONEY","DAS GELD","GREY","GRAU","HAIR","DAS HAAR","GENTLEMAN","DER HERR","YOUR (FORMAL)","IHR","JANUARY","DER JANUAR","COLD","KALT","SHORT","KLEIN","LAMP","DIE LAMPE"
10090 DATA"TO READ","LESEN","KNIFE","DAS MESSER","MORNING","DER MORGEN","ONLY","NUR","REACH","REICH","BEUITIFUL","SCHO:N","TO SING","SINGEN","TO SPEAK","SPRECHEN","CHALKBOARD","DIE TAFEL","DAUGHTER","DIE TOCHTER"
20000 FORX=1TO10000:READA$,B$:PRINTB$,A$:NEXT
32000 DATA"DONE"
