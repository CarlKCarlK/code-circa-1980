10 REM            SUPERPOWER INVESTING
20 REM            BOOK: ROBERT LICHELLO
30 REM            PROGRAM: CARL KADIE
40 REM            COPYRIGHT (C) 1974
50 '
60 REM            CLEAR MEMORY FOR WORDS
70         CLEAR 200
80 '
90 REM            SET UP CONTITIONS
100 '
110 REM            PLANNED INVESTMENT (PI)   P. 43
120        PI= 
130 REM            BASE INVESTMENT (BI)     P. 44
140        BI= PI * .75
150 REM            TOTAL SHARES (TS)
160 REM            INTEREST FROM BANK
170        IR=.0
180 REM            TOTAL INVESTMENT (TI)
190 REM            PRICE PER SHARE (PS)
200 REM            COST  PER SHARE (CS)
210 REM            TABLE OF RECORDS T(M,C) M=MONTH C=COLUMN
220        DIM T(60,8)
230 REM            TABLE HEADING  (TT$) & (TB$) TOP AND BOTTOM
240        TB$="DATE  PRICE INVESTMENT BOUGHT SHARES"+                     "  INVESTMENT SHARE  BALANCE"
250        TT$="                       SHARES  TOTAL  "+                   "   TOTAL   COST/   CREDIT"
260 '
270 '
280 '
290 REM            MAIN PROGRAM
300 '
310        T(1,3)=T(M,4)*T(M,2)
320 REM            PUT DATA IN TABLE ARRAY
330        FOR M= 1 TO 60                       'LOOP MONTHS
340               READ T(M,2)
350               IF T(M,2) < 0 THEN M=M-1:GOTO380  
360               T(M,1)=INT(M/12)+(M/12-INT(M/12))*12/100
370        NEXT M
380 '
390 REM            SET UP FIRST MONTHS TABLE
400        T(1,3)=PI
410        T(1,4)=PI/T(1,2)
420        T(1,4)=INT(T(1,4)*10+.5)/10
430        T(1,5)= T(1,4)
440        T(1,6)= PI
450        T(1,7)= T(1,2)
460        T(1,8)= 0
470 '
480 REM            DO REST OF MONTHS
490        NM = M  -1           :' NUMBER OF MONTHS =OLD MONTH
500        FOR M= 2 TO NM
510             PC = T(M-1,7)/T(M,2)
520             T(M,3)=BI*PC
530             IF PC>1 THEN T(M,3) = T(M,3) + (PC-1)*T(M-1,8)
540             T(M,4) = T(M,3) / T(M,2)
550             T(M,4)=INT(T(M,4)*10+.5)/10
560             T(M,3)=T(M,4)*T(M,2)
570             T(M,8)= T(M-1,8)*(1+IR/365.25)[(365 *.0328542)
580             T(M,8)= INT(T(M,8)*100+.5)/100 + PI-T(M,3)
590             T(M,5) = T(M-1,5) + T(M,4)
600             T(M,6) = T(M-1,6) + T(M,3)
610             T(M,7) = T(M,6) / T(M,5)
620        NEXT M
630 '
640 REM            PRINT RESULTS
650        PRINT TT$
660        PRINT TB$
670        FORM=1TO NM
680        PRINTT(M,1);TAB(6) T(M,2) TAB(12) T(M,3);
690       PRINT TAB(23) T(M,4) TAB(30) T(M,5) TAB(38) T(M,6);
700       PRINT TAB(48) INT(T(M,7)+.5) TAB(54) T(M,8)
710       IF INT(M/12)=M/12 AND M<>NM THEN PRINTTT$:PRINTTB$
720       NEXT
730       PRINT
740       PRINT"REAL PROFIT (WITHOUT BANK INTEREST) =";
750       PRINTT(NM,5)*(T(NM,2)-T(NM,7))
760       END
1000 '
1010 '
1020 REM            PRICES
1030 REM            EACH MOUTH PLACE THE PRICE IN DATA
1040 REM            LIKE THIS : "1030 DATA 54"
1050 REM            BE SURE THAT THE DATES ARE IN ORDER
9998 '
9999 '
10000 REM            THIS TELLS COMPUTER THERE'S NO MORE DATA
10010       DATA -1
