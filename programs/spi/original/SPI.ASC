10 REM            SUPERPOWER INVESTING
20 REM            BOOK: ROBERT LICHELLO
30 REM            PROGRAM: CARL KADIE
40 REM            COPYRIGHT (C) 1974
50 '
60 REM            CLEAR MEMORY FOR WORDS
70         CLEAR 200                            :'TRS-80
80 '
90 REM            SET UP CONTITIONS
100 '
110 REM            PLANNED INVESTMENT (PI)   P. 43
120        PI= 300
130 REM            BASE INVESTMENT (BI)     P. 44
140        BI= PI * .75
150 REM            TOTAL SHARES (TS)
160 REM            INTEREST FROM BANK
170        IR=.0525
180 REM            TOTAL INVESTMENT (TI)
190 REM            PRICE PER SHARE (PS)
200 REM            COST  PER SHARE (CS)
210 REM            TABLE OF RECORDS T(M,C) M=MONTH C=COLUMN
220        DIM T(60,8)
230 REM            TABLE HEADING  (TT$) & (TB$) TOP AND BOTTOM
240        TB$="DATE  PRICE INVESTMENT BOUGHT SHARES"+                     "  INVESTMENT SHARE  BALANCE"
250        TT$="                       SHARES  TOTAL  "+                   "   TOTAL   COST/   CREDIT"
260 '
270 '
280 '
290 REM            MAIN PROGRAM
300 '
310        T(1,3)=T(M,4)*T(M,2)
320 REM            PUT DATA IN TABLE ARRAY
330        FOR M= 1 TO 60                       'LOOP MONTHS
340               READ T(M,2)
350               IF T(M,2) < 0 THEN M=M-1:GOTO390  
360               IF INT(M/12)=M/12 THEN T(M,1)=(M/12-1)+.12 :                    GOTO380  
370               T(M,1)=INT(M/12)+(M/12-INT(M/12))*12/100
380        NEXT M
390 '
400 REM            SET UP FIRST MONTHS TABLE
410        T(1,3)=PI
420        T(1,4)=PI/T(1,2)
430        T(1,4)=INT(T(1,4)*10+.5)/10
440        T(1,5)= T(1,4)
450        T(1,6)= PI
460        T(1,7)= T(1,2)
470        T(1,8)= 0
480 '
490 REM            DO REST OF MONTHS
500        NM = M  -1           :' NUMBER OF MONTHS =OLD MONTH
510        FOR M= 2 TO NM
520             PC = T(M-1,7)/T(M,2)
530             T(M,3)=BI*PC
540             IF PC>1 THEN T(M,3) = T(M,3) + (PC-1)*T(M-1,8)
550             T(M,4) = T(M,3) / T(M,2)
560             T(M,4)=INT(T(M,4)*10+.5)/10
570             T(M,3)=T(M,4)*T(M,2)
580             T(M,8)= T(M-1,8)*(1+IR/365.25)[(365 *.0328542)
590             T(M,8)= INT(T(M,8)*100+.5)/100 + PI-T(M,3)
600             T(M,5) = T(M-1,5) + T(M,4)
610             T(M,6) = T(M-1,6) + T(M,3)
620             T(M,7) = T(M,6) / T(M,5)
630        NEXT M
640 '
650 REM            PRINT RESULTS
660        PRINT TT$
670        PRINT TB$
680        FORM=1TO NM
690        PRINTT(M,1);TAB(6) T(M,2) TAB(12) T(M,3);
700       PRINT TAB(23) T(M,4) TAB(30) T(M,5) TAB(38) T(M,6);
710       PRINT TAB(48) INT(T(M,7)+.5) TAB(54) T(M,8)
720       IF INT(M/4)=M/4 THEN PRINT
730       IF INT(M/12)=M/12 AND M<>NM THEN PRINT TT$:PRINT TB$
740       NEXT M
750       PRINT
760       PRINT"REAL PROFIT (WITHOUT BANK INTEREST) =";
770       PRINTT(NM,5)*(T(NM,2)-T(NM,7))
780       GOTO 940  
790 '
800 '
810 REM            PRICES
820 REM            EACH MOUTH PLACE THE PRICE IN DATA
830 REM            LIKE THIS : "1030 DATA 54"
840 REM            BE SURE THAT THE DATES ARE IN ORDER
850 DATA 47,48,50,52,49,50,53,52,54,52,52,54
860 DATA 52,50,50,54,56,56,55,55,58,58,61,59
870 DATA 58,55,57,58,58,54,51,53,52,54,52,52
880 DATA 49,50,50,45,42,40,42,44,46,45,47,50
890 DATA 53,53,55,57,55,55,53,55,54,52,52,56
900 '
910 '
920 REM            THIS TELLS COMPUTER THERE'S NO MORE DATA
930       DATA -1
940 END
