10 'LANGUAGE
20 CLEAR1000
30 DEFINT W
40 DEFSTR I,L,G,M,A,Q,E
50 READ INFO
60 IF INFO <> "DONE" THEN NUMBER = NUMBER+1 : GOTO 50   
70 RESTORE:CLS
80 PRINT "I KNOW "; NUMBER ;"GERMAN WORDS."
90 PRINT "WHICH ONE WOULD YOU LIKE TO START WITH (1 -"; NUMBER ;")";:INPUT START
100 IF START<1 OR START>NUMBER THEN 90   
110 PRINT "AND WHICH WORD WOULD YOU LIKE TO END WITH ("; START ;"-"; NUMBER ;")";:INPUT FINAL
120 IF FINAL<START OR FINAL>NUMBER THEN 110  
130 PRINT"WOULD YOU LIKE A TIME LIMIT ON YOUR ANSWERS";:INPUT LIMIT
140 IF LIMIT = "YES" THEN QICK="NO": INPUT"HOW MANY SECONDS (1-8000)";TIME  ELSE IF LIMIT = "NO" THEN TIME=1000 ELSE PRINT"PLEASE ANSWER 'YES' OR 'NO'.":GOTO130  
150 IFTIME<0 OR TIME>8000 THEN 140  
160 INPUT"DO YOU WISH TO TRANSLATE GERMAN TO ENGLISH";GERMAN
170 IF GERMAN <> "NO"   AND GERMAN <>"YES"  THEN 160  
180 INPUT"DO YOU WISH FOR A CONSTANT PERCENTAGE SCORE";ERCENT
190 IF ERCENT<>"NO" AND ERCENT<>"YES"THEN180  
200 INPUT"DO YOU WISH FOR A CONSTANT LETTER GRADE"; GRADE
210 IF GRADE<>"NO"   AND GRADE<>"YES"  THEN200  
220 INPUT"DO YOU WANT THE WORD ORDER RANDOM";MIXED
230 IF MIXED<>"YES" AND  MIXED <>"NO" THEN 220  
240 INPUT"WOULD YOU LIKE THOSE YOU MISSED ON PAPER";PT$
250 IF PT$<>"YES"AND PT$<>"NO"THEN240  
260 IFLIMIT="NO"THENINPUT"WOULD YOU LIKE TO USE THE QUICK OPTION";QICK
270 IF QICK="YES"THENPRINT"THEN PRESS <BAR> IN ANSWER TO THE QUESTION, AND TO ADVANCE":PRINT"PRESS 'X' IF YOU WERE WRONG AND '/' IF YOU WERE WRONG."ELSEIFQICK<>"NO"THEN260  
280 PRINT"                 (PRESS THE <BAR> )";
290 IFINKEY$=""THEN290  
300 DIM WO(FINAL-START+1)
310 FOR COUNT=1TO FINAL-START+1
320 WO(COUNT)=START+COUNT-1
330 NEXT COUNT:COUNT=COUNT-1
340 IF MIXED="YES"THEN GOSUB 710  
350 FOR TURN=1TO COUNT
360 CLS
370 IF WO(TURN)>PO+1THEN PRESENT = PO:FOR PO=PRESENT TO WO(TURN)-2:READ INFO:NEXT PO
380 IF WO(TURN)<=PO THEN RESTORE:PO=0:GOTO370  
390 READ INFO :    PO=PO+1
400 QUESTI=LEFT$(INFO,INSTR(INFO,"*")-1):ANSWER=RIGHT$(INFO,LEN(INFO)-INSTR(INFO,"*"))
410 IF GERMAN="NO"THEN INFO=ANSWER:ANSWER=QUESTI:QUEST=INFO
420 IF QICK="NO"THEN470  
430 IF QICK="YES"THENPRINT@385,QUEST;" : ";
440 IF QICK="YES" AND INKEY$=""THEN430  ELSEPRINT:PRINT"DAS RICHTIG ANWART IST":PRINTANSWER:PRINT:PRINT"(PRESS 'X' IF WRONG.... '/' IF RIGHT)
450 IFQICK="YES" THEN A$=INKEY$:IFA$<>"X"ANDA$<>"/"THEN450  ELSEIFA$="X"THENPRINT"DAS TUT MEIR LEIT.":WR=WR+1:WO(WR)=WO(TURN)ELSEPRINT"GUT!":RI=RI+1
460 GOTO520  
470 PRINT@385,QUEST;" : ";:LINE INPUT#LEN TIME,490  ;GUESS
480 GOTO 500  
490 PRINT:PRINT"I'M SORRY YOU HAVE RUN OUT OF TIME":GUESS="":GOTO510  
500 IF ANSWER=GUESS THEN PRINT "DAS IST RICHTIG!":RIGHT=RIGHT+1 ELSE PRINT"DAS IST FALSCH."
510 IFANSWER<>GUESSPRINT"DAS RICHTIG ANTWORT IST :":PRINTANSWER:WR=WR+1:WO(WR)=WO(TURN):IF PT$="YES"THEN LPRINT QU;" "; ANSWER
520 IF ERCENT = "YES" THEN PRINT@10,"PERCENTAGE=";100*RIGHT/TURN;
530 IFGRADE="NO"THEN550  ELSE PRINT@46,"GRADE = ";:IFRI/TU=>.925THENPRINT"A";ELSEIFRI/TU=>.865THENPRINT"B";ELSEIFRI/TU=>.765THENPRINT"C";ELSEIFRI/TU=>.685THENPRINT"D";ELSEPRINT"F";
540 IFQICK="YES"THEN 570  
550 PRINT@960+21,"(PRESS ANY BUTTON)";
560 IF INKEY$=""THEN560  
570 NEXT TURN
580 CLS
590 PRINT"YOU HAVE NOW COMPLETED THE LIST."
600 PRINT"WOULD YOU LIKE TO KNOW YOUR PERCENTAGE";:INPUT INFO
610 IF INFO="YES" THEN PRINT:PRINT"PERCENTAGE RIGHT =";RIGHT/COUNT*100:PRINT
620 INPUT"WOULD YOU LIKE TO KNOW YOUR LETTER GRADE";INFO
630 IF INFO<>"YES"THEN650  ELSE PRINT:PRINT"LETTER GRADE = ";:IF RI/CO>=.925THENPRINT"A"ELSEIFRI/CO=>.865THENPRINT"B"ELSEIFRI/CO=>.765THENPRINT"C"ELSEIFRI/CO=>.685 THEN PRINT"D"ELSEPRINT"F"
640 IFWRG =0THEN670  
650 PRINT:INPUT"YOU WOULD YOU LIKE TO TRY THOSE YOU MISSED";INFO
660 IFINFO="YES"THEN COUNT=WRG  :RIGHT=0:WRNG=0: GOTO 340  
670 INPUT"WOULD YOU LIKE TO START OVER";INFO
680 IF INFO="YES"THEN RUN
690 PRINT:PRINT:PRINT"GUTEN TAG!"
700 END
710 FOR CIRCLE=1 TO COUNT
720 R1=RND(COUNT):R2=RND(COUNT)
730 HOLD=WO(R1):WO(R1)=WO(R2):WO(R2)=HOLD
740 NEXT CIRCLE
750 RETURN
760 DATA ES HAT GEBRACHT*IT HAS BROUGHT,ER HAT GEGEBEN*HE HAS GIVEN,SIE HAT GEHABT*SHE HAS HAD,WIR SIND GEKOMMEN*WE HAVE COME,S[IE HABEN GELIEBT*YOU(F) HAVE LOVED,ICH HABE GESAGT*I HAVE SAID,WIR HABEN GESCHRIEBEN*WE HAVE WRITTEN
770 DATA ICH HABE GESUNGEN*I HAVE SUNG,IHR HABT GESPROCHEN*YOU(P) HAVE SPOKEN,SIE HABEN STUDIERT*THEY HAVE STUDIED
780 DATA"SIE HABEN GEFRAGT*THEY HAVE ASKED",ES IST GEGANGEN*IT HAS GONE,ER HAT GEKAUFT*HE HAS BOUGHT,SIE HABEN GELESEN*THEY HAVE READ,ER HAT GEMACHT*HE HAS MADE(DONE),SIE HABEN GESCHLAFEN*THEY HAVE SLEPT,WIR SIND GEWESEN*WE HAVE BEEN
790 DATA"ES HAT GESPIELT*IT HAS PLAYED",ICH HABE GESTANDEN*I HAVE STOOD,S[IE HABEN VERSTANDEN*YOU(F) HAVE UNDERSTOOD
800 DATA "DONE"
810 READ A$:LPRINTA$:GOTO810  
