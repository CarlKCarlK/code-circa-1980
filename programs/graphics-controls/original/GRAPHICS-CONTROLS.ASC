10 CLS
15 Y=1:X=50
20 YL=47
25 DIM O(100,2,4)
30 XR=2
40 FORC=1TO4:READF,H:X(C)=YL*F:Y(C)=YL*H:NEXT
50 DATA1,0,0,0,0,1,1,1
60 A$=INKEY$:IFA$="Z"THENAA=-1ELSEIFA$="X"THENAA=0ELSEIFA$="C"THENAA=1ELSEIFA$=","THENBB=-1ELSEIFA$="."THENBB=0ELSEIFA$="/"THENBB=1
65 X=X+AA*5:Y=Y+BB*5
100 XX=X/100*YL:YY=Y/100*YL
110 FORC=1TO5
120 S=(Y(C)-YY)/(X(C)-XX)
125 S(C)=S
130 XG(C)=X(C):YG(C)=S*(XG(C)-YL/2)+YL/2
140 IFYG(C)<0ORYG(C)>YLTHENYG(C)=Y(C):XG(C)=(YG(C)-YL/2)/S+YL/2
150 NEXT
160 FORC=1TO4:X1=YL/2*XR:Y1=YL/2:X2=XG(C)*XR:Y2=YG(C):GOSUB1000:NEXT:GOTO60
1000 S=(Y1-Y2)/(X1-X2)
1010 FORX3=0TOX2-X1STEPSGN(X2-X1)
1020 Y3=X3*S
1033 RESET(O(ABS(X3),1,C),O(ABS(X3),2,C))
1035 O(ABS(X3),1,C)=X3+X1:O(ABS(X3),2,C)=YL-Y3-Y1
1038 SET(X3+X1,YL-Y3-Y1)
1040 NEXTX3
1050 RETURN
