10 CLS
20 TILT= .5
30 XSCALE=1
40 YSCALE=1
50 SWITCH=1
60 L=7
70 PRINT"3-D PLOT   (C) 1979   CARL KADIE"
80 PRINT:PRINT"PLEASE ANSWER.  ":PRINT"IF YOU WISH FOR STANDARD PERIMETERS ANSWER BY PRESSING  (ENTER) "
90 PRINT:INPUT"TILT";TILT
100 INPUT"X SCALE";XSCALE
110 INPUT"Y SCALE";YSCALE
120 INPUT"SWITCH ON";A$:IFA$="YES"THEN SWITCH=-1 ELSE SWITCH=1
130 INPUT"HOW MANY LINES";L:S=1/((L-1)/2 )
140 CLS
150 XX=127:YY=47:Z1=67:Z2=75:Z3=65:Z4=68:Z5=73:Z6=69
160 P=1
170 DX=XS*30:DY=YS*15:DZ=TI
180 PI=ATN(1)*4:E=EXP(1)
190 FOR A=1TO 2:IFA=1THEN FOR Z=1TO-1STEP -S:FORX=1TO-1STEP -S
             ELSE     FOR X=1TO-1STEP -S:FORZ=1TO-1STEP -S
200 IF X<>0 OR Z<>0 THEN Y=-1/SQR(X[2*18+Z[2*18)+1 ELSE Y=-1
210 IF NO=1 THEN NO=0:P=1
220 GX=XX/2+X*DX-Z*DX*DZ
230 GY=YY/2-Y*DY+Z*DY*DZ
240 IF GX<0 OR GX>XX OR GY<0 OR GY>YY THEN 290  
250 IF P=1 THEN OX=GX:OY=GY
260 GOSUB 360  
270 OX=GX:OY=GY
280 P=0:GOTO300  
290 P=1
300 IF A=1THEN NEXTX:P=1:NEXTZ
310 IF A=2THEN NEXTZ:P=1:NEXTX
320 NEXTA
330 IF SW=-1 THEN SW=1:GOTO 150  
340 PRINT@0,"D";
350 GOTO 350  
360 D=SQR( (GX-OX)[2+(GY-OY)[2)
370 IF D=0 THEN SET(GX,GY):GOTO420  
380 SX=(GX-OX)/D:SY=(GY-OY)/D
390 FOR DD=1TOD
400 SET(  DD*SX+OX+.5,DD*SY+OY+.5)
410 NEXTDD
420 RETURN
