5 DEFDBL L:DEFINT A-K,M-Z
10 SZ=31
20 DIM L(100,2),TB(3,SZ)
30 G=0
40 P=20
45 BL=P
50 READ LS
51 MF=2
60 IF LS=-999 THEN 100 :ELSE IF LS<0 THEN P=P+(-LS)+1 :ELSE P=P+1:L(P,G)=LS:BH=P
70 GOTO 50
100 NL=BH+2:NH=BL-2
110 FOR P=BL-1 TO BH+1
120 GOSUB 1000
125 IF L(P,1-G)= L(P,G) THEN 130
127  IF P<NL THEN NL=P
128  IF P>NH THEN NH=P
130 NEXTP
140 BL=NL:BH=NH:G=1-G
150 IF BL>BH THEN PRINT"empty":END
160 GOTO 100
1000 '
1120 L(P,1-G)=0
1130 LO = L(P-1,G) + L(P,G) + L(P+1,G): IF LO=0 THEN LINE(P*MF,0*MF)-(P*MF+MF-1,(SZ-1)*MF+MF-1),0,BF:GOTO 1300
1140 FOR I=-1 TO 1:LT=L(P+I,G):FORJ=0TO(SZ-1): TB(I+1,J)= -(LT MOD 2=1):LT=INT(LT/2):NEXT J,I
1150 LT=0:FOR J=(SZ-1) TO 0 STEP-1
1155 TT=0
1160  FOR II=-1 TO 1:FOR JJ=-1 TO 1
1170   TT=TT+ TB(1+II,(J+JJ+SZ) MOD SZ)
1180     NEXT JJ,II
1185 IF TB(1,J) THEN LINE(P*MF,J*MF)-(P*MF+MF-1,J*MF+MF-1),1,BF :ELSE LINE(P*MF,J*MF)-(P*MF+MF-1,J*MF+MF-1),0,BF
1190 IF TB(1,J) THEN LT=LT*2+(-(TT=3 OR TT=4)) :ELSE LT=LT*2+(-(TT=3))
1200 NEXT J
1210 L(P,1-G)=LT
1300 RETURN
2988 DATA 2,10,6,-3,3,5,1,-999
2998 DATA 1 ,3,-999
2999 DATA 48,48,0,0,32,80,80,32,0,0,396,396,-9,6,6,0,0,0,1073741841,1073741870,5,56,0,65542,393241,196610,34,16,0,0,24,24
3000 DATA 48,48,-9,112,136,260,136,112,112,-4,28,566,3126,1598,99,-4,48,-3,24,16,-999
