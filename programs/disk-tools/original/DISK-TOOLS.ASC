10 CLS:CLEAR20000:DIM R$(500):R=0
20 INPUT "FILE";F$
30 OPEN "I",1,F$
40 IF EOF(1) THEN 50 ELSE R=R+1:LINE INPUT #1,R$(R):GOTO40
50 PRINT "CONVERTING"
60 FOR I=1TOR:FORL=1TOLEN(R$(I)):L$=MID$(R$(I),L,1):IF L$>="a" AND L$<="z" THEN MID$(R$(I),L,1)=CHR$(ASC(L$)-32)
70 NEXT L,I
80 CLOSE:OPEN"O",1,F$
90 FORI=1TOR:PRINT#1,R$(I):NEXTI:CLOSE
