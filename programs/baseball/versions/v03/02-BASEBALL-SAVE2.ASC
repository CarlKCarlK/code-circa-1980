10 'BASEBALL
15 PI=-3.14159
16 IN=1:QW=1
17 TT=1
18 BA=PI+PI/2
20 CLS
25 R=-7
26 RX=64:RY=31:RO=64:RN=31
30 LINE(3,1)-(5,4),SET,BF:LINE(1,2)-(7,3),SET,BF:RESET(2,3):RESET(6,3):RESET(4,4)
40 DIMP%(20)
42 GET@(0,0)-(8,5),G,P%
45 RESET(7,3):SET(7,1):DIMO%(15):GET@(0,0)-(8,5),G,O%
60 CLS
61 DIMB%(10)
62 GET@(0,0)-(2,3),G,B%
65 L$="="
70 LINE(30,14)-(55,8),L$:LINE(55,8)-(33,5),L$:LINE(33,5)-(10,9),L$:LINE(10,9)-(30,14),L$
80 LINE(0,0)-(127,1),SET,BF:LINE(0,0)-(3,47),SET,BF:LINE(123,0)-(127,47),SET,BF:FORQ=1TO6:READ X:RESET(X,0):NEXT
81 DATA 22,103,39,86,55,71
90 FORC=1TO5:READ X,Y:Y=Y+3:PUT@(X,Y)-(X+8,Y+5),SET,P%:NEXT C
100 DATA 50,39, 111,23, 52,23, 9,23, 71,9
110 PRINT@927,"<#>";
200 A$=INKEY$
205 H(0)=1
210 IFA$=""THEN220ELSEIFA$=" "THENB=1ELSEIFA$="@"THENO=-1ELSEIFA$=CHR$(8)THENO=0ELSEIFA$=CHR$(9)THENO=1ELSEIFA$=","THENR=-1ELSE IFA$="."THENR=0ELSEIFA$="/"THENR=1
220 IFO<>0THEN OL=OL+O/2:PUT@(32+OL,3)-(40+OL,8),SET,O%:PUT@(64+OL,3)-(72+OL,8),SET,O%:PUT@(96+OL,3)-(104+OL,8),SET,O%
230 IFB=1THENBA=BA+PI/6:IFABS(BA+8.37)<.1THEN3000ELSELINE(60,44)-(COS(BA-PI/6)*8+60,SIN(BA-PI/6)*4+44),RESET:LINE(60,44)-(COS(BA)*8+60,SIN(BA)*4+44),SET
240 IF R<>-7 THEN RX=RX+R:RY=RY+1:RESET(RO,RY-1):RESET(RO+1,RY-1):SET(RX,RY):SET(RX+1,RY):RO=RX
250 IF RY=44 AND RX>59 AND RX<69 THEN I=1ELSEIF RY=47 THEN 500
260 IF (POINT(RX,RY+1) OR POINT(RX+1,RY+1) OR POINT(RX+2,RY) OR POINT(RX-1,RY))ANDRX>59 AND RX<69THEN2000
499 GOTO200
500 ' BALL REACHES BOTTOM OF SCREEN
510 IF I=1 THEN 3000 ELSE 3200
2000 'BALL IS HIT
2005 BA=BA+PI/2+RND(0)*PI/4-PI/8
2010 RX=RX+COS(BA)*4:RY=RY+SIN(BA)*2:RESET(RO,RN):RESET(RO+1,RN):IFPOINT(RX,RY)ORPOINT(RX,RY-1 )THEN 2050ELSESET(RX,RY):SET(RX+1,RY):RO=RX:RN=RY
2015 A$=INKEY$:IFA$=""THEN2020ELSEIFA$="@"THENO=-1ELSEIFA$=CHR$(8)THENO=0ELSEIFA$=CHR$(9)THENO=1
2020 IFO=0THEN2040ELSE OL=OL+O/2:PUT@(32+OL,3)-(40+OL,8),SET,O%:PUT@(64+OL,3)-(72+OL,8),SET,O%:PUT@(96+OL,3)-(104+OL,8),SET,O%
2040 GOTO2010
2050 '
2100 IF RY<3 THEN2200
2105 IF RX>5 AND RX<121 THEN 3100
2110 IF RY>22 THEN 3100 ELSE 3300
2200 IF RX<22 OR RX>103 THEN 3300ELSEIFRX<39 OR RX>86 THEN 3400 ELSE IF RX<55 OR RX>71THEN 3500 ELSE 3600
3000 ST=ST+1:LINE(64,31)-(65,38),RESET,BF:C$="STRIKE"+STR$(ST):IF ST=3THEN3100ELSE4003
3020 GOTO 4000
3070 IN=IN+.5:IFIN>9.5THEN6000ELSEC$="SWITCH SIDES":QW=-QW:TT=(QW+1)/2:OU=0:ST=0:BL=0:H(0)=0:AV=3:SD=-2:GOTO4000
3100 OU=OU+1:BL=0:ST=0:C$=C$+" YOU'RE OUT !!":IF OU=3 THEN 3070
3120 GOTO 4000
3200  BL=BL+1:C$="BALL"+STR$(BL):LINE(5,47)-(100,47),RESET:IF BL>=4 THEN3300
3220 GOTO 4003
3300  C$=C$+" * SINGLE *":AV=1
3320 GOTO4000
3400  C$=C$+" ** DOUBLE **":AV=2
3420  GOTO4000
3500  C$=C$+" *** TRIPLE ***":AV=3
3520 GOTO 4000
3600  C$=C$+" ***** H O M E  R U N ******":AV=4
3620  GOTO4000
4000 ST=0:BL=0
4003 PRINT@992,C$;STRING$(28-LEN(C$)," ");
4010 IFAV=0THEN4500
4060 FOR C=1TOAV
4100 BX=26:BY=28:IFH(3)=1 THEN FOR Q=1TO20:BY=BY+1:BX=BX+1:PUT@(BX,BY)-(BX+8,BY+5),SET,P%:NEXT:H(3)=0:IFSD<>-2THENSC(TT)=SC(TT)+1:H(3)=0
4200 BX=47:BY=11:IF H(2)=1 THEN LINE(54,11)-(54,16),RESET:FORQ=1TO20:BY=BY+(28-11)/20:BX=BX-(47-26)/20:PUT@(BX,BY)-(BX+8,BY+5),SET,P%:NEXT:H(2)=0:H(3)=1:
4210 BX=91:BY=28:IF H(1)=1THEN FOR Q=1TO20:BY=BY-(28-11)/20:BX=BX-(91-47)/20:PUT@(BX+9,BY+1)-(BX+11,BY+4),SET,B%:PUT@(BX,BY)-(BX+8,BY+5),SET,P%:NEXT:H(1)=0:H(2)=1
4220 BX=50:BY=42:IFH(0)=1THEN FOR Q=1TO20:BY=BY-(42-28)/20:BX=BX+(91-50)/20:PUT@(BX-3,BY+1)-(BX-1,BY+4),SET,B%:PUT@(BX,BY)-(BX+8,BY+5),SET,P%:NEXTQ:H(0)=0:H(1)=1
4300 NEXT
4500 AV=0
4510 H(0)=1:RESTORE:FORC=1TO6:READX:NEXT:FORC=1TO5:READX,Y:Y=Y+3:PUT@(X,Y)-(X+8,Y+5),SET,P%:NEXT
4520 L$="=":LINE(30,14)-(55,8),L$:LINE(55,8)-(33,5),L$:LINE(33,5)-(10,9),L$:LINE(10,9)-(30,14),L$
4530 FORC=3TO1STEP-1:READX,Y:IFH(C)=1THENPUT@(X,Y)-(X+8,Y+5),SET,P%
4535 NEXT
4540 DATA 26,28,47,11,91,28
4545 PRINT@927,"<#>";
4550 I=0
4555 C$="":B=0:O=0:R=-7:BA=1.5*PI
4560 SD=0:RX=64:RY=31:RO=64:RN=31
4570 PRINT@835,IN"INNING  ";:PRINT@899,"TEAM #1 :";SC(1);:PRINT@963,"TEAM #2 :";SC(0);
4575 PRINT@818,OU"OUTS  ";:PRINT@882,ST"STRIKES";:PRINT@946,BL"BALLS ";
4580 GOTO200
6000 CLS:PRINTCHR$(23);"AND THAT ENDS THE GAME":PRINT"THE TEAM #1 HAD"SC(1)"POINTS":PRINT"AND TEAM #2 HAD"SC(0)"POINTS"
