5 DEFINT A-Z
10 P=4:DIM C$(13),P$(P),H$(P,4),R(P),L(P)
20 FOR I=1TO13:C$(I)=STR$(I):NEXTI
30 C$(11)="10":C$(12)="10":C$(13)="NN":C$(4)="SM":C$(9)="RV":C$(10)="MT"
50 P$(1)="NN OT RV SM MT BLIZTKREIG"
60 P$(2)="OT MT NN SM RV NICE GUY"
70 P$(3)="OT NN SM RV MT SAMES BEFORE REV."
80 P$(4)="OT NN RV SM MT REV.S BEFORE SAME"
90 'P$(5)="MT RV SM RO NN DUMB S"
200 CLS
210 FOR I=1TOP:PRINT@I*64,"PLAYER #"I" - "RIGHT$(P$(I),LEN(P$(I))-15);": ";LEFT$(P$(I),15);
220 NEXT I
230 PRINT@55,"LOSES";
250 FOR C=1TO4:FORI=1TOP:H$(I,C)=C$(RND(13)):NEXTI,C
260 FORI=1TOP:R=RND(I):R(I)=R(R):R(R)=I:NEXTI
300 T=0:PT=0:TT=1
310 T=T+TT:IF T>PTHENT=1 ELSE IF T=0 THEN T=P
320 PU=R(T)
400 FOR I=1TO13 STEP 3:ST$=MID$(P$(PU),I,2)
410 IF ST$<>"OT"THEN500
420 BC=VAL( H$(PU,1) ):PC=1:FORCD=2TO4:IF VAL(H$(PU,CD) )>BC AND VAL(H$(PU,CD))+PT<=99THEN BC=VAL(H$(PU,CD)):PC=CD
430 NEXT CD
440 IF BC=0  OR BC+PT>99 THEN2000
450 PT=PT+BC:H$(PU,PC)=C$(RND(13)):K$="ADD "+STR$(BC):GOTO 3000
500 IF ST$<>"RV"THEN 550
510 FOR CD=1TO4:IF H$(PU,CD)="RV" THEN TT=-TT:H$(PU,CD)=C$(RND(13)):K$="REVERSE":GOTO 3000 ELSE NEXT CD:GOTO 2000
550 IF ST$<>"SM"THEN600
560 FOR CD=1TO4:IF H$(PU,CD)="SM"THEN H$(PU,CD)=C$(RND(13)):K$="SAME":GOTO3000 ELSE NEXTCD:GOTO 2000
600 IF ST$<>"RO"THEN700
610 BC=VAL( H$(PU,1)):PC=1:FORCD=2TO4:IF VAL(H$(PU,CD))<BC AND VAL(H$(PU,CD))+PT<=99THEN BC=VAL( H$(PU,CD)):PC=CD
620 NEXTCD
630 IF BC=0 OR BC+PT>99 THEN 2000
640 PT=PT+BC:H$(PU,PC)=C$(RND(13)):K$="ADDING "+STR$(BC):GOTO3000
700 IF ST$<>"NN"THEN790
710 FORCD=1TO4:IF H$(PU,CD)="NN" AND PT<>99 THEN PT=99:H$(PU,CD)=C$(RND(13)):K$="NINTY-NINE":GOTO3000ELSE NEXTCD:GOTO2000
790 IF ST$<>"MT"THEN PRINT"ERROR IN PROGRAMING":STOP
800 FOR CD=1TO4:IF H$(PU,CD)="MT" THEN PT=PT-10:H$(PU,CD)=C$(RND(13)):K$="MINIUS TEN":GOTO3000 ELSE NEXT CD:GOTO 2000
1000 GOTO1000
2000 NEXT I
2010 L(PU)=L(PU)+1:PRINT@PU*64+55,L(PU);
2020 GOTO 250
3000 PRINT@960-128,K$"            ";:PRINT@960-64,"PLAYER "PU"  TOTAL NOW  "PT
3005 'GOSUB 4000
3010 GOTO 310
4000 PRINT@64*(P+2),"";:FOR QW=1TOP:PRINTR(QW);") ";:FORCD=1TO4:PRINTH$(R(QW),CD);" ";:NEXTCD:PRINT:NEXTQW:RETURN
