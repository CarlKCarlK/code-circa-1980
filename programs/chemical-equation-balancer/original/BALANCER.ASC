5 CLS
10 REM CHEMISTRY BANENCER II   COPYRIGHT 1981 C. KADIE
90 CLEAR 1000:DEFINT A-Z
100 PRINT:PRINT:PRINT"WHAT IS THE EQUATION":INPUT EQ$
200 ' REM  DECIPHER EQUATION
210 T$=EQ$:EQ$="":FORI=1TOLEN(T$):TT$=MID$(T$,I,1):IFTT$>=CHR$(96)ANDTT$<=CHR$(127)THENTT$=CHR$(ASC(TT$)-32)ELSE IFNOT(TT$=" "ORTT$="("ORTT$=")"ORTT$="+"ORTT$="."OR(TT$>="0"ANDTT$<="9")ORTT$="="OR(TT$>="A"ANDTT$<="Z"))THENER=8:GOTO2000
212 IFTT$=")"ORTT$="(" THEN P8=1
215 EQ$=EQ$+TT$:NEXTI:T$="":TT$=""
220  E1$=EQ$:M1=1:EL$="  "
225 GOSUB 1000:R1$=LEFT$(R1$,2):IFM1=7 THEN240 ELSER1$=LEFT$(R1$+" ",2)
230 FOR I=1TO LEN(EL$)STEP2:IFMID$(EL$,I,2)<>R1$THENNEXTI:EN=EN+1:EL$=EL$+R1$
235 GOTO 225
240 IFEN=0 THEN ER=4:GOTO2000ELSECN=1:FOR I=1TO LEN (EQ$):TT$=MID$(EQ$,I,1):IFTT$="+"ORTT$="="THEN CN=CN+1
245 IF TT$="="THEN ES=CN
250 NEXT I
255 PL=9
260 DIM N(EN,CN),D(EN,CN),PR(PL),T(1)
300 CT=1
310 IF P8=1 THENE1$=EQ$:I=0ELSE 5000:'COUNTS NUMBER OF CHEMICALS
320 I=I+1
330 T$=E1$:CF=CT:N(0,I)=I
340 FOR J=1TO EN:E1$=T$
350 M1=3:GOSUB 1000
360 IF M1=5 OR M1=6 OR M1=7 THEN 430 ELSE IF M1=2 OR (M1=1 AND LEFT$(R1$+" ",2)<>MID$(EL$,J*2+1,2)) THEN 350
370 T=M1:M1=4:IFT<>4 THEN GOSUB1000
380 IF T=1 THEN PR(PN)=PR(PN)+M1
390 IF T<>4 THEN 400 ELSE PN=PN+1:IF PN>PL THEN ER=1:GOTO2000
400 IF T<>3 THEN 420
410 IF PN<1 THEN ER=2:GOTO2000 ELSEPR(PN-1)=PR(PN-1)+PR(PN)*M1:PR(PN)=0:PN=PN-1
420 GOTO 350
430 IF PN<>0 THEN ER=2:GOTO2000ELSEIFCF=-1ANDM1=6THENER=3:GOTO2000
440 N(J,I)=PR(0)*CF:PR(0)=0
450 IF M1=6 THEN CT=-1
470 NEXTJ:IF M1<>7 THEN 320
480 FOR J=1TOEN:T(0)=0:T(1)=0:FORI=1TOCN:IF N(J,I)<>0 THEN T=SGN(SGN(ES-.5-I)+1):T(T)=T(T)+1
490 NEXTI:IFT(0)*T(1)=0 THEN ER=5:GOTO2000
500 PRINT@61,J+1;:NEXTJ
505 I=0
510 IF I+1<=EN-1 THEN I=I+1 :PRINT@61,I;:ELSE580
520 FOR J=1TOCN:IF N(I,J)=0 THEN NEXTJ ELSE T(0)=N(I,J):T(1)=J
525 II=I
530 IF II+1<=EN THEN II=II+1 ELSE 570
540 FORJ=1TOCN:IFN(II,J)*T(0)=N(I,J)*N(II,T(1))THENNEXTJELSE560
550 FORJ=1TOCN:N(II,J)=N(EN,J):NEXTJ:EN=EN-1:II=II-1:GOTO530
560 GOTO 530
570 GOTO 510
580 FOR J=1TO1:NEXTJ
585 PN=1:N(1,0)=PN
590 IFEN>=2 THEN FOR I=2TOEN ELSE 655
600 FOR II=1TOI-1
610 FORJ=1TOCN:T(0)= ABS(SGN(N(I,J))):T(1)=ABS(SGN(N(II,J))): IFNOT(T(0)=1ANDT(1)=1)THENNEXTJ:GOTO640ELSEIFN(I,0)=0THENN(I,0)=N(II,0):GOTO640
620 T=N(II,0):FORJJ=1TOEN:IFN(JJ,0)=T THEN N(JJ,0)=N(I,0)
630 NEXT JJ
640 NEXTII:IFN(I,0)=0THENPN=PN+1:N(I,0)=PN
650 NEXTI
655 IF PN=1 THEN660 ELSE FORJJ=1TOEN:IFN(JJ,0)=N(1,0) THEN NEXTJJ ELSE PRINT@64*7,"WARNING: MIXED EQUATIONS":FORJJ=1TO1:NEXTJJ
660 I=EN:II=1
670 IF NOT( I>=2 AND II<>0) THEN 750
680 J=1:II=0
690 IF NOT( J<=I-1) THEN 730
700 IF N(J,0)>N(J+1,0)THENFORJJ=0TOCN:T=N(J,JJ):N(J,JJ)=N(J+1,JJ):N(J+1,JJ)=T:NEXTJJ:II=1
710 J=J+1
720 GOTO 690
730 I=I-1
740 GOTO 670
750 FORI=1TOEN:T=N(I,0):FORJ=1TOCN:IFN(I,J)<>0 THEN D(0,J)=T
760 NEXTJ,I
770 I=CN:II=1
780 IF NOT(I>=2 AND II<>0) THEN 860
790 J=1:II=0
800 IF NOT( J<=I-1) THEN 840
810 IF D(0,J)>D(0,J+1)THENFORJJ=0TOEN:T=N(JJ,J):N(JJ,J)=N(JJ,J+1):N(JJ,J+1)=T:NEXTJJ:T=D(0,J):D(0,J)=D(0,J+1):D(0,J+1)=T:II=1
820 J=J+1
830 GOTO 800
840 I=I-1
850 GOTO 780
860 EB=1:CB=1
865 ES=EB:CS=CB
870 CB=CB+1:IF CB>CN THEN 880 ELSE IF D(0,CS)<>D(0,CB) THEN880 ELSE IF CB=CN THEN CB=CB+1:GOTO880 ELSE870
880 EB=EB+1:IF EB>EN THEN 890 ELSE IF N(ES,0)<>N(EB,0) THEN890 ELSE IF EB=EN THEN EB=EB+1:GOTO890 ELSE880
890 EM=EB-ES:CM=CB-CS
900 GOSUB 3000
910 IF CB<=CN THEN 865
990 PRINT:FORI=1TOEN:FOR J=1TOCN:PRINTD(I,J)"/"N(I,J)" ";:NEXTJ:PRINT:NEXTI:RETURN
999 END
1000 'SUBROUTINE
1005 PRINT@62,LEFT$(E1$,1);
1030 IF M1<>4 THEN 1200
1040 IF LEFT$(E1$,1)=" " THEN E1$=RIGHT$(E1$,LEN(E1$)-1):GOTO1040
1100 T1$=LEFT$(E1$,1):IFVAL(T1$)<>0 OR T1$="0" THEN M1=VAL(T1$):R1$=T1$:E1$=RIGHT$(E1$,LEN(E1$)-1)ELSEM1=1:R1$="1":RETURN
1110 T1$=LEFT$(E1$,1):IFVAL(T1$)<>0 OR T1$="0" THEN M1=M1*10+VAL(T1$):R1$=R1$+T1$:E1$=RIGHT$(E1$,LEN(E1$)-1):GOTO1110 ELSE RETURN
1200 IF M1=1 THEN M1=3:GOSUB1000:IFM1<>1 AND M1<>7 THENM1=1:GOTO1200 ELSE RETURN
1220 T1$=LEFT$(E1$,1):IFT1$=" "ORT1$="."THENE1$=RIGHT$(E1$,LEN(E1$)-1):GOTO1220
1230 IF E1$=""THENR1$="":M1=7:RETURN
1240 R1$=LEFT$(E1$,1):E1$=RIGHT$(E1$,LEN(E1$)-1):IFR1$=")"THENM1=3ELSEIFR1$="("THENM1=4ELSEIFR1$="+"THENM1=5ELSEIFR1$="="THENM1=6ELSE1260
1250 RETURN
1260 IF VAL(T1$)<>0 OR T1$="0"THEN M1=4:E1$=T1$+E1$:GOSUB 1000:M1=2:RETURN
1270 T1$=LEFT$(E1$,1):IFT1$>="A" AND T1$<="Z" THEN R1$=R1$+T1$:E1$=RIGHT$(E1$,LEN(E1$)-1)
1280 M1=1:RETURN
2000 REM SUM
2005 PRINT@64*8,"FATAL ERROR: ";
2010 IF ER=1 THEN PRINT"TOO MANY ('S"
2020 IF ER=2 THEN PRINT"MISMATCHED ('S"
2030 IF ER=3 THEN PRINT"TOO MANY ='S"
2040 IF ER=4 THEN PRINT"NO ELEMENTS GIVEN"
2060 IF ER=5 THENPRINT"ALCHEMY !!!!!"
2070 IF ER=6 THEN PRINT"CAN NOT BE BALANCED"
2080 IF ER=7 THEN PRINT:PRINT"MULTIPLE REPLACEMENT REACTION CAN NOT BE BALENCED"
2090 IF ER=8 THEN PRINT"ILLEGAL CHARACTER"
2190 END
3000 'REM
3001 GOSUB 990
3005 G2=EM:IFEM>=CM THEN G2=CM-1
3010 FOR I2=1TOG2:D(I2,0)=0:NEXTI2:D(1,0)=ES
3020 P2=1
3040 GOSUB 3600:IF NOT(F3) THEN3050 ELSE P2=P2+1:IFP2>G2 THEN 3065  ELSED(P2,0)=ES:GOTO3040
3050 IF D(P2,0)+1<=EM+ES-1 THEN D(P2,0)=D(P2,0)+1:GOTO3040 ELSE P2=P2-1:IF P2<1 THEN 3060 ELSE D(P2,0)=D(P2,0)+1:GOTO3040
3060 ER=6:GOTO2000
3065 GOSUB 3650:IF NOT(F6) THEN P2=P2-1:GOTO3050
3070 FOR I2=1TOG2:FORJ2=CS TO CS+CM-1:D(I2+ES-1,J2)=N( D(I2,0),J2):N( D(I2,0),J2)=1:NEXTJ2,I2
3080 IF G2=>EM THEN 3110 ELSE I2=G2
3090 FORJ2=0TOEM-1:FORI4=1TOG2:IFJ2+ES<>D(I4,0)THENNEXTI4:I2=I2+1:FORI4=CSTOCS+CM-1:D(I2,I4)=N(J2+ES,I4):N(J2+ES,I4)=1:NEXTI4
3100 IF G2<EM THEN NEXT J2
3110 I2=CS+CM-1:FORJ2=ESTOES+EM-1:D(J2,I2)=-D(J2,I2):NEXTJ2
3115 FOR J5=1TO G2
3120 YD=N(J5+ES-1,J5+CS-1):YN=D(J5+ES-1,J5+CS-1):D8=YD:N8=YN:GOSUB4000:YD=D8:YN=N8
3130 FORK5=1TOCM
3140 N8=YD*D(J5+ES-1,K5+CS-1):D8=YN*N(J5+ES-1,K5+CS-1):GOSUB4000:D(J5+ES-1,K5+CS-1)=N8:N(J5+ES-1,K5+CS-1)=D8
3150 NEXT K5
3160  FOR I5=1TOG2
3170 IF I5=J5 THEN 3220 
3180 YD=-D(I5+ES-1,J5+CS-1):YN=N(I5+ES-1,J5+CS-1):N8=YD:D8=YN:GOSUB4000:YD=N8:YN=D8
3190 FORK5=1TOCM
3200 A5=D(I5+ES-1,K5+CS-1):B5=N(I5+ES-1,K5+CS-1):N8=A5:D8=B5:GOSUB4000:A5=N8:B5=D8:C5=D(J5+ES-1,K5+CS-1):D5=N(J5+ES-1,K5+CS-1):N8=C5:D8=D5:GOSUB4000:C5=N8:D5=D8:N8=YN*D5*A5+YD*C5*B5:D8=B5*YN*D5:GOSUB4000:D(I5+ES-1,K5+CS-1)=N8:N(I5+ES-1,K5+CS-1)=D8
3210 NEXTK5
3220 NEXTI5
3230 NEXTJ5
3240 I2=EM
3250 IF G2>=I2 THEN 3290
3260 YD=0:YN=1
3270 FOR J2=1TOG2:A5=D(ES+J2-1,CS+CM-1):B5=N(ES+J2-1,CS+CM-1):C5=D(ES+I2-1,CS+J2-1):D5=N(ES+I2-1,CS+J2-1):E5=YD:F5=YN
3280 YD=B5*D5*E5+A5*C5*F5:YN=F5*B5*D5:NEXTJ2:IF YD*N(I2+ES-1,CS+CM-1)=YN*D(I2+ES-1,CS+CM-1) THEN I2=I2-1:GOTO3250 ELSE ER=7:GOTO2000
3290 '
3599 RETURN
3600 'SUB
3605 IF D(P2,0)>EM+ES-1 THEN F3=0:RETURN
3610 IF N( D(P2,0),P2+CS-1)=0 THEN F3=0:RETURN
3620 IF P2=1 THEN F3=-1:RETURN
3630 FOR I3=1TO P2-1:IF D(P2,0)<>D(I3,0) THEN NEXT:F3=-1:RETURN ELSE FORI3=1TO1:NEXT:F3=0:RETURN
3650 T7=0:FOR I7=ES TO ES+G2-1:T7=T7+ABS(N( D(I7-ES+1,0),CS+CM-1)):NEXTI7:IFT7=0 THEN F6=0:RETURN
3700 'REM
3705 FORI7=1TOEN:N(I7,0)=0:NEXTI7
3710 P6=1:N(D(1,0),0)=P6
3720 IF G2>=2 THEN FOR I6 =ES+1TO G2+ES-1 ELSE 3790
3730 FOR I7=ES TO I6-1
3740 F6=0:FOR J6=CS TO CS+CM-1:T6(0)=ABS(SGN(N(D(I6-ES+1,0),J6))):T6(1)=ABS(SGN(N(D(I7-ES+1,0),J6))):IFNOT (T6(0)=1ANDT6(1)=1) THEN NEXT J6:GOTO3770 ELSE IF N(D(I6-ES+1,0),0)=0 THEN N(D(I6-ES+1,0),0)=N(D(I7-ES+1,0),0):GOTO3770
3750 T6=N(D(I7-ES+1,0),0):FORJ7=ESTOES+G2-1:IFN(D(J7-ES+1,0),0)=T6 THEN N(D(J7-ES+1,0),0)=N(D(I6-ES+1,0),0)
3760 NEXTJ7
3770 NEXTI7:IFN(D(I6-ES+1,0),0)=0THEN P6=P6+1:N(D(I6-ES+1,0),0)=P6
3780 NEXTI6:IFP6=1 THEN3790ELSEFORJ7=1TOG2:IFN(D(J7,0),0)=N(D(1,0),0) THENNEXTJ7 ELSE F6=0:RETURN
3790 F6=-1:RETURN
4000 REM
4010 IF N8=0 AND D8=0 THEN RETURN
4020 A8=N8:B8=D8
4030 A8=ABS(A8):B8=ABS(B8)
4040 R8=A8-B8*INT(A8/B8)
4050 IF R8<>0 THEN A8=B8:B8=R8:GOTO4040
4070 N8=N8/B8:D8=D8/B8
4090 RETURN
5000 REM
5010 E1$=EQ$:I=1
5020 M1=3:GOSUB1000:IFM1=5THENI=I+1:GOTO5020ELSEIFM1=6THENCF=-1:I=I+1
