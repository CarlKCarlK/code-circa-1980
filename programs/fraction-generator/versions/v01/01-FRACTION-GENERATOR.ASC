100 D=RND(RND(100))
110 N=RND(RND(100))
130 R=RND(RND(13))
140 D=D*R:IFD>100THEN100
150 N=N*R
160 N1=RND(N)
170 N2=N-N1
175 D1=D:D2=D
177 IFN1>=D1ORN2>=D2ORN1=0ORN2=0THEN100
180 H=N1:IFN2>N1THENH=N2
190 FORC=1TOH
200 IFN1/C=INT(N1/C)ANDD1/C=INT(D1/C)THENN1=N1/C:D1=D1/C
210 IFN2/C=INT(N2/C)ANDD2/C=INT(D2/C)THENN2=N2/C:D2=D2/C
220 NEXTC
230 IFRND(2)=1THENR=RND(RND(13)):N1=N1*R:D1=D1*R
240 IFRND(2)=1THENR=RND(RND(13)):N2=N2*R:D2=D2*R
260 IFD1>100ORD2>100ORD1=D2THEN100
300 PRINTN1;D1,N2;D2
310 GOTO100
