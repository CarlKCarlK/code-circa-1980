(LOGGING)                                                       (  PROCEDURE PRINT - INPUT CHAR ;                                    ADD TO BOTTOM OF SCREEN                                         IF LF OR CR                                                       THEN                                                              HOLD LINE                                                       REPLACE HOLD                                                    ADD LINE TO LOG                                               END    END )                                             :PRINT EMIT                                                          END'SCREEN  C@ 0 = NOT IF                                          SCREEN'LOC 896 + HOLD'LINE 1+ 64 CMOVE                          END'SCREEN 0 C!                                                 REPLACE'HOLD                                                    ADD'LINE'TO'LOG                                              THEN ;                                                     (ADD'TO'LOG                                                         NEXT LINE                                                       ADD HELD LINE )                                             :ADD'LINE'TO'LOG                                                  LOG'BLOCK @ LOG'POS @ NEXT'LINE                                 LOG'POS ! LOG'BLOCK !                                           HOLD'LINE 1+ LOG'BLOCK @ BLOCK LOG'POS @ + 64 CMOVE ;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         (PROC NEXT LINE  <BLOCK #,POS/  RETURNS <BLOCK #, POS/            INC ONE'LINE                                                    IF nGTn 1023 THEN                                                 BLOCK = BLOCK + 1                                               PLACE'IN'BLOCK = 0                                              IF BLOCK nGTn LAST'BLOCK THEN                                     BLOCK = FIRST BLOCK                                             ENDIF ENDIF )                                             :NEXT'LINE                                                        64 +                                                            DUP 1023 <= NOT IF                                                DROP 0 SWAP 1+                                                  DUP LAST'LOG'BLOCK <= IF                                          SWAP ELSE                                                       DROP FIRST'LOG'BLOCK SWAP THEN THEN ;                                                                                     (MAINTAIN HOLD)                                                 (PROC                                                            IF HOLD'SIZE nNEn 0 THEN                                          CHARCOPY  HOLDBLOCK,SCREEN, FOR HOLD SIZE                       END IF                                                        PRINT AT HOLD'SIZE SEPERATE BAR)                                                                                               : MAINTAIN'HOLD                                                   HOLD'SIZE @ IF                                                    HOLD'BLOCK BLOCK SCREEN'POS HOLD'SIZE @ CMOVE THEN            SEPARATE'BAR 1+ HOLD'SIZE `@ 64 CMOVE ;                                                                                                                                                                                                                                                                                                                                                       