1 CLS
2 PRINT:PRINT
90 CLEAR1000
100 GOTO5000
105 '               *** DATA ANALYZES ***
170 FORR=1TOD
185 IFR(R,R)<>0THEN200ELSEPQ=R
190 IFA(R,R)=0ANDR<DTHENFORKK=1TOD+1:HH=A(R,KK):A(R,KK)=A(R+Q,KK):A(R+Q,KK)=HH:NEXT:Q=Q+1:GOTO190ELSEIFA(R,R)=0THENPRINT"IT CAN NOT BE BALANCED.":RUN2
200 F=1/A(R,R):RX=R:GOSUB1000
210 FORB=1TOD+1:P(B)=A(R,B):NEXT
220 FORW=1TOD
240 F=-A(W,R)/A(R,R):RX=R:GOSUB1000
250 GOSUB2000
260 FORB=1TOD+1:A(R,B)=P(B):NEXT
270 NEXT
500 NEXT
600 RETURN
1000 FORB=1TOD+1:A(RX,B)=A(RX,B)*F:NEXT:RETURN
2000 FORB=1TOD+1:A(W,B)=A(W,B)+A(R,B):NEXT:RETURN
4000 INPUT"LOC. X,Y AND CORRECT VALUE 'A'";G,H,J:A(G,H)=J:GOTO130
5000 '              *** DATA COLLECTION ***
5010 SS=1
5020 IFPE<>3THENDIMP$(100),C$(50)
5030 CF=1
5040 MM=1
5050 NN=0:GH=1:V=0:OO=0
5070 IFPE=3THENFORER=1TO100:P$(ER)="":C$(INT(ER/2))="":NEXT:GOTO5110
5100 PRINT"WHAT IS THE EQUATION":INPUTA$
5110 CC=0:K=0:FORXX=1TOLEN(A$)
5120 V=ASC(MID$(A$,XX,1))
5130 IFV>47ANDV<58THENNN=1ELSEIFV=43THENNN=2ELSEIFV=61THENNN=3ELSEIFV=46THENNN=4ELSEIFV=32THEN5200ELSEIFV=40THENNN=7ELSEIFV=41THENNN=6ELSENN=5
5140 IFNN=OOTHEN5150ELSEK=K+1:IFOO<>5THEN OO=NN ELSE FORJJ=1TOCC:IFP$(K-1)=C$(JJ)THENOO=NNELSENEXT:CC=CC+1:C$(CC)=P$(K-1):OO=NN
5150 P$(K)=P$(K)+CHR$(V)
5200 NEXTXX
5205 ZX=0:FORLO=1TOK:IFP$(LO)<>")"THENNEXT:ZX=0ELSEZX=ZX+1:IFVAL(P$(LO+1))=0THENCL(ZX)=1:NEXTELSECL(ZX)=VAL(P$(LO+1)):NEXT
5210 ZN=0:IFPE<>3THENDIMA(20,20+1),B(20+1)
5212 IFPE=3THENFORX=1TOCC:FORY=1TOCC+1:A(X,Y)=0:NEXT:B(X)=0:NEXT
5220 FORJJ=1TOCC:ZX=0:FORC=1TOK
5225 IFP$(C)="("THENZX=ZX+1:CF=CL(ZX)ELSEIFP$(C)=")"THENCF=1
5230 IFC$(JJ)<>P$(C)THEN5240ELSEIFVAL(P$(C+1))<>0THEN A(JJ,MM)=A(JJ,MM)+VAL(P$(C+1))*SS*CFELSEA(JJ,MM)=A(JJ,MM)+SS*CF
5235 IFCN<MMTHENCN=MM
5240 IFP$(C)="+"THENMM=MM+1ELSEIFP$(C)="="THENMM=MM+1:SS=-1
5250 NEXT:MM=1:SS=1:NEXT:MM=CN
5260 FORJJ=1TOCC:A(JJ,MM)=-A(JJ,MM):NEXT
5265 D=CC:GOSUB8000:GOSUB105:GOTO5270
5268 '
5270 FORX=1TOCC:B(X)=A(X,CC+1):IFABS(B(X))<.001THENB(X)=0:NEXTELSENEXT
5280 B(CC+1)=1
5290 FORX=1TOCC+1
5300 IFB(X)-INT(B(X))<.001THENB(X)=INT(B(X)+.5):GOTO5500
5310 F=1/(B(X)-INT(B(X)))
5420 FORY=1TOCC+1
5430 B(Y)=B(Y)*F
5440 NEXTY:GOTO5290
5500 NEXT
5510 CC=0:FORX=1TOCC+1:B(X)=INT(B(X)+.5):NEXT:PRINT
5512 WX=1:GH=1
5515 IFPE<>3ANDB(GH)=1THENPRINT"(";ELSEIFPE=3ANDB(GH)<>0THENPRINT"THIS EQUATION CAN'T OCCUR, IT IS IMPOSSIBLE.":RUN2ELSEIFPE=3THENWX=3:GH=2:PE=0:GOTO5515ELSEPRINTB(GH);"(";
5520 FORX=WXTOK
5530 IFP$(X)<>"+"ANDP$(X)<>"="THEN5600ELSEPRINT")";:IFP$(X)="="THENPRINT" -";CHR$(94);ELSEPRINT"+";
5532 IF(P$(X)="="ANDPOS(0)>40)OR(P$(X)="+"ANDPOS(0)>50)THENPRINT:PRINT"    ";
5535 GH=GH+1:IFINT(B(GH)+.5)=1THENPRINT" (";ELSEPRINTINT(B(GH)+.5);"(";
5540 GOTO5610
5600 IFP$(X)="("THENPRINT"<";ELSEIFP$(X)=")"THENPRINT">";ELSEPRINTP$(X);
5610 NEXT:PRINT")"
5620 RUN2
6000 PRINT"IT WILL TAKE A MOMENT MORE.":FORX=1TOCC-1
6010 FORY=1TOCC
6020 IFX=YTHEN6110
6030 FORZ=1TOMM
6040 IFA(X,Z)<>0ANDA(Y,Z)<>0THENPG=A(X,Z)/A(Y,Z)
6050 NEXTZ
6060 FORZ=1TOMM
6070 IFA(Y,Z)*PG<>A(X,Z)THEN6110ELSENEXT
6080 FORZ=1TOMM
6090 A(X,Z)=A(CC,Z):A(CC,Z)=0:NEXT
6100 CC=CC-1
6110 NEXTY
6120 NEXTX
6130 GOTO5268
8000 FOR AQ=1TOCC:FORQW=1TOMM:PRINTA(AQ,QW);:NEXTQW:PRINT:NEXTAQ:PRINT:RETURN
