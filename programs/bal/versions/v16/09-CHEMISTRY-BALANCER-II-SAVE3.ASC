5 GOSUB 10000
10 REM CHEMISTRY BALANCER II   COPYRIGHT 1981 C. KADIE
90 CLEAR 1000:DEFINT C,E-L,O-Q,S,U-X,Z:DEFDBL A,B,D,M,N,R,T,Y
100 PRINT:PRINT:PRINT"WHAT IS THE RAW EQUATION?":INPUT EZ$
105 CLS:PRINT:PRINT:PRINT"THE RAW EQUATION IS ":PRINTEZ$
110 EQ$=EZ$:Q5=0
200 ' REM  DECIPHER EQUATION
205 EN=0:CN=0:P8=0:CT=0:PN=0:ES=0:CS=0:EM=0:CM=0:P2=0:F3=0:U0=0:U1=0:U2=0
207 T$=EQ$:EQ$=""
210 FORI=1TOLEN(T$):TT$=MID$(T$,I,1):IFTT$>=CHR$(96)ANDTT$<=CHR$(127)THENTT$=CHR$(ASC(TT$)-32)ELSEIFNOT(TT$=" "ORTT$="("ORTT$=")"ORTT$="+"OR(TT$="-"ANDR1$="@")ORTT$="."ORTT$="@"OR(TT$>="0"ANDTT$<="9")ORTT$="="OR(TT$>="A"ANDTT$<="Z"))THENER=8:GOTO2000
212 IFTT$=")"ORTT$="(" THEN P8=1
215 EQ$=EQ$+TT$:R1$=TT$:NEXTI:T$="":TT$=""
220  E1$=EQ$:M1=1:EL$="  "
225 GOSUB 1000:R1$=LEFT$(R1$,2):IFM1=7 THEN240 ELSER1$=LEFT$(R1$+" ",2)
230 FOR I=1TO LEN(EL$)STEP2:IFMID$(EL$,I,2)<>R1$THENNEXTI:GOSUB6500
235 GOTO 225
240 EM$=EL$:IFEN=0 THEN ER=4:GOTO2000ELSECN=1:FOR I=1TO LEN (EQ$):TT$=MID$(EQ$,I,1):IFTT$="+"ORTT$="="THEN CN=CN+1
245 IF TT$="="THEN ES=CN
250 NEXT I
255 PL=9
260 IF Q5 =0 AND RX=0 AND X0=0THEN  DIM N(EN,CN+1),D(EN,CN),PR(PL)
265 IF Q5=0 AND ABS(RX)=1 AND X0=0THEN DIM N(EN+1,CN+3),D(EN+1,CN+2),PR(PL)
270 IF Q5<>0 OR ABS(RX)<>1 THEN 300
280 FOR I=1TOEN*2+1STEP2:T$=MID$(EL$,I,2):IFT$="H "THENU0=1ELSEIFT$="O "THENU1=1ELSEIFT$="@ "THENU2=1
285 NEXTI:IFU1=1 AND U2=1 THEN T$="@H + H2O + ":GOSUB9000:RX=RX*3 :CN=CN+2ELSE IF U1=1 AND U0=1THEN T$="H2O + ":GOSUB9000:RX=RX*2:CN=CN+1 ELSEIFU2=1 AND U0=1THENT$="H@ + ":GOSUB9000:RX=RX*4 :CN=CN+1ELSE RX=0
290 IF U2=1 AND U1=1 AND U0=0 THEN EL$="  H "+RIGHT$(EL$,LEN(EL$)-2):CN=CN+1
300 CT=1:FORI=1TOCN:N(0,I)=I:NEXTI
310 IF P8=1 THENE1$=EQ$:I=0 ELSE 5000:'COUNTS NUMBER OF CHEMICALS
320 I=I+1
330 T$=E1$:CF=CT:N(0,I)=I
340 FOR J=1TO EN:E1$=T$
350 M1=3:GOSUB 1000
360 IF M1=5 OR M1=6 OR M1=7 THEN 430 ELSE IF M1=2 OR (M1=1 AND LEFT$(R1$+" ",2)<>MID$(EL$,J*2+1,2)) THEN 350
370 T=M1:M1=4:IFT<>4 THEN GOSUB1000
380 IF T=1 THEN PR(PN)=PR(PN)+M1
390 IF T<>4 THEN 400 ELSE PN=PN+1:IF PN>PL THEN ER=1:GOTO2000
400 IF T<>3 THEN 420
410 IF PN<1 THEN ER=2:GOTO2000 ELSEPR(PN-1)=PR(PN-1)+PR(PN)*M1:PR(PN)=0:PN=PN-1
420 GOTO 350
430 IF PN<>0 THEN ER=2:GOTO2000ELSEIFCF=-1ANDM1=6THENER=3:GOTO2000
440 N(J,I)=PR(0)*CF:PR(0)=0
450 IF M1=6 THEN CT=-1
470 NEXTJ:IF M1<>7 THEN 320
475 REM SHORT-CUT RETURNS HERE
480 FOR J=1TOEN:T(0)=0:T(1)=0:FORI=1TOCN:IF N(J,I)<>0 THEN T=SGN(SGN(N(J,I))+1):T(T)=T(T)+1
490 NEXTI:GOSUB7500
500 PRINT@59,J+1;:NEXTJ
505 I=0
510 IF I+1<=EN-1 THEN I=I+1 :PRINT@59,I;:ELSE580
520 FOR J=1TOCN:IF N(I,J)=0 THEN NEXTJ ELSE T(0)=N(I,J):T(1)=J
525 II=I
530 IF II+1<=EN THEN II=II+1 ELSE 570
540 FORJ=1TOCN:IFN(II,J)*T(0)=N(I,J)*N(II,T(1))THENNEXTJELSE560
550 FORJ=1TOCN:N(II,J)=N(EN,J):NEXTJ:GOSUB6000:EN=EN-1:II=II-1:GOTO530
560 GOTO 530
570 GOTO 510
580 FOR J=1TO1:NEXTJ
585 PN=1:N(1,0)=PN
590 IFEN>=2 THEN FOR I=2TOEN ELSE 655
600 FOR II=1TOI-1
610 PRINT@59,II;:FORJ=1TOCN:T(0)= ABS(SGN(N(I,J))):T(1)=ABS(SGN(N(II,J))): IFNOT(T(0)=1ANDT(1)=1)THENNEXTJ:GOTO640ELSEIFN(I,0)=0THENN(I,0)=N(II,0):GOTO640
620 T=N(I,0):FORJJ=1TOEN:IFN(JJ,0)=T THEN N(JJ,0)=N(II,0)
630 NEXT JJ
640 NEXTII:IFN(I,0)=0THENPN=PN+1:N(I,0)=PN
650 NEXTI
655 IF PN=1 THEN660 ELSE FORJJ=1TOEN:IFN(JJ,0)=N(1,0) THEN NEXTJJ ELSE FORJJ=1TO1:NEXTJJ:IFQ5=0ANDRX=0THENPRINT@64*7,"WARNING: MIXED EQUATIONS"ELSEIFQ5=0 AND RX<>0 THEN ER=13:GOTO2000
660 I=EN:II=1
670 IF NOT( I>=2 AND II<>0) THEN 750
680 J=1:II=0
690 IF NOT( J<=I-1) THEN 730
700 IF N(J,0)>N(J+1,0)THENFORJJ=0TOCN:T=N(J,JJ):N(J,JJ)=N(J+1,JJ):N(J+1,JJ)=T:NEXTJJ:II=1:EL$=LEFT$(EL$,J*2)+MID$(EL$,J*2+3,2)+MID$(EL$,J*2+1,2)+RIGHT$(EL$,LEN(EL$)-J*2-4)
710 J=J+1
720 GOTO 690
730 I=I-1
740 GOTO 670
750 FORI=1TOEN:T=N(I,0):FORJ=1TOCN:IFN(I,J)<>0 THEN D(0,J)=T
760 NEXTJ:PRINT@59,I;:NEXTI
770 I=CN:II=1
780 IF NOT(I>=2 AND II<>0) THEN 860
790 J=1:II=0
800 IF NOT( J<=I-1) THEN 840
810 IF D(0,J)>D(0,J+1)THENFORJJ=0TOEN:T=N(JJ,J):N(JJ,J)=N(JJ,J+1):N(JJ,J+1)=T:NEXTJJ:T=D(0,J):D(0,J)=D(0,J+1):D(0,J+1)=T:II=1
820 J=J+1
830 GOTO 800
840 I=I-1
850 GOTO 780
860 EB=1:CB=1:FORI5=1TOEN:N(I5,CN+1)=N(I5,0):NEXTI5:I5=0
865 ES=EB:CS=CB
870 CB=CB+1:IF CB>CN THEN 880 ELSE IF D(0,CS)<>D(0,CB) THEN880 ELSE IF CB=CN THEN CB=CB+1:GOTO880 ELSE870
880 EB=EB+1:IF EB>EN THEN 890 ELSE IF N(ES,CN+1)<>N(EB,CN+1) THEN890 ELSE IF EB=EN THEN EB=EB+1:GOTO890 ELSE880
890 EM=EB-ES:CM=CB-CS
900 GOSUB 3000
910 IF CB<=CN THEN 865
920 FORI=1TOCN-1:T=0:FORJ=CNTOI+1STEP-1:IFN(0,J)<N(0,J-1) THENT=1:TT=N(0,J):N(0,J)=N(0,J-1):N(0,J-1)=TT:TT=D(0,J):D(0,J)=D(0,J-1):D(0,J-1)=TT
930 NEXTJ:IFT=1THENNEXTI
940 GOSUB8500:FORI=1TOCN:IF(D(0,I)>0 OR I<=XX)AND D(0,I)<=1E16 AND INT(D(0,I))=D(0,I)THEN NEXTI ELSE IF D(0,I)<=0 ANDI>XXTHEN ER=13:GOTO2000ELSE IF D(0,I)>1E16 THEN ER=9:GOTO2000 ELSE ER=11:GOTO2000
950 GOTO 7000
1000 'SUBROUTINE
1005 PRINT@60,LEFT$(E1$,1);
1030 IF M1<>4 THEN 1200
1040 IF LEFT$(E1$,1)=" " THEN E1$=RIGHT$(E1$,LEN(E1$)-1):GOTO1040
1050 IF LEFT$(E1$,1)="-"THENT1$="-":E1$=RIGHT$(E1$,LEN(E1$)-1):ELSET1$=""
1100 T1$=T1$+LEFT$(E1$,1):IFVAL(T1$)<>0 OR T1$="0" THEN M1=VAL(T1$):R1$=T1$:E1$=RIGHT$(E1$,LEN(E1$)-1)ELSEIFLEFT$(T1$,1)<>"-"THENM1=1:R1$="1":RETURN ELSE M1=-1:R1$="-1":RETURN
1110 T1$=LEFT$(E1$,1):IFVAL(T1$)<>0 OR T1$="0" THEN M1=M1*10+VAL(T1$):R1$=R1$+T1$:E1$=RIGHT$(E1$,LEN(E1$)-1):GOTO1110 ELSE RETURN
1200 IFM1=1THENM1=3:GOSUB1000:IFM1<>1AND M1<>7 THENM1=1:GOTO1200 ELSE RETURN
1220 T1$=LEFT$(E1$,1):IFT1$=" "ORT1$="."THENE1$=RIGHT$(E1$,LEN(E1$)-1):GOTO1220
1230 IF E1$=""THENR1$="":M1=7:RETURN
1240 R1$=LEFT$(E1$,1):E1$=RIGHT$(E1$,LEN(E1$)-1):IFR1$=")"THENM1=3ELSEIFR1$="("THENM1=4ELSEIFR1$="+"THENM1=5ELSEIFR1$="="THENM1=6ELSEIFR1$="@"THENM1=1ELSE1260
1250 RETURN
1260 IF VAL(T1$)<>0 OR T1$="0"ORT1$="-"THEN M1=4:E1$=T1$+E1$:GOSUB 1000:M1=2:RETURN
1270 T1$=LEFT$(E1$,1):IFT1$>="A" AND T1$<="Z" THEN R1$=R1$+T1$:E1$=RIGHT$(E1$,LEN(E1$)-1)
1280 M1=1:RETURN
2000 REM SUM
2002 IF X0=2 THEN EZ$=RIGHT$(EZ$,LEN(EZ$)-6):EQ$=RIGHT$(EQ$,LEN(EQ$)-6):GOTO205
2005 PRINT@64*8,"FATAL ERROR: ";
2010 IF ER=1 THEN PRINT"TOO MANY ('S"
2020 IF ER=2 THEN PRINT"MISMATCHED ('S"
2030 IF ER=3 THEN PRINT"TOO MANY ='S"
2040 IF ER=4 THEN PRINT"NO ELEMENTS GIVEN"
2060 IF ER=5 THENPRINT"ALCHEMY !!!!!"
2070 IF ER=6 THEN PRINT"CANNOT BE BALANCED"
2080 IF ER=7 THEN PRINT:PRINT"MULTIPLE REPLACEMENT REACTION, CANNOT BE BALANCED"
2090 IF ER=8 THEN PRINT"ILLEGAL CHARACTER"
2095 IF ER=9 THEN PRINT"OVERFLOW"
2100 IF ER=10 THEN PRINT"AMBIGUOUS EQUATION"
2110 IF ER=11 THEN PRINT"UNDERFLOW"
2120 IF ER=12 THEN PRINT"SUBSCRIPT IN INCORRECT POSITION"
2130 IF ER= 13 THEN PRINT:PRINT"CANNOT BE BALANCED: NEGATIVE SOLUTION"
2190 GOTO 8000
3000 'REM
3001 IF CM>EM+1 AND RX=0 THEN ER=10:GOTO2000 ELSE IF CM>EM+1 THEN GOSUB9500
3005 G2=EM:IFEM>=CM THEN G2=CM-1
3010 FOR I2=1TOG2:D(I2,0)=0:NEXTI2:D(1,0)=ES
3020 P2=1
3040 GOSUB 3600:IF NOT(F3) THEN3050 ELSE P2=P2+1:IFP2>G2 THEN 3065  ELSED(P2,0)=ES:GOTO3040
3050 IF D(P2,0)+1<=EM+ES-1 THEN D(P2,0)=D(P2,0)+1:GOTO3040 ELSE P2=P2-1:IF P2<1 THEN 3060 ELSE D(P2,0)=D(P2,0)+1:GOTO3040
3060 ER=6:GOTO2000
3065 GOSUB 3650:IF NOT(F6) THEN P2=P2-1:GOTO3050
3070 FOR I2=1TOG2:FORJ2=CSTOCS+CM-1:D(I2+ES-1,J2)=N( D(I2,0),J2): N( D(I2,0),J2)=1:NEXTJ2:EM$=LEFT$(EM$,(I2+ES-1)*2)+MID$(EL$,D(I2,0)*2+1,2)+RIGHT$(EM$,LEN(EM$)-(I2+ES-1)*2-2):NEXTI2:EL$=EM$
3080 IF G2=>EM THEN 3110 ELSE I2=G2
3090 FORJ2=0TOEM-1:FORI4=1TOG2:IFJ2+ES<>D(I4,0)THENNEXTI4:I2=I2+1:FORI4=CSTOCS+CM-1:D(I2,I4)=N(J2+ES,I4):N(J2+ES,I4)=1:NEXTI4
3100 IF G2<EM THEN NEXT J2
3110 I2=CS+CM-1:FORJ2=ESTOES+EM-1:D(J2,I2)=-D(J2,I2):NEXTJ2
3115 FOR J5=1TO G2
3120 YD=N(J5+ES-1,J5+CS-1):YN=D(J5+ES-1,J5+CS-1):D8=YD:N8=YN:GOSUB4000:YD=D8:YN=N8
3125 IF YN=0 THEN EM$=MID$(EM$,(J5+ES-1)*2+1,2):GOTO5500
3130 FORK5=1TOCM
3140 N8=YD*D(J5+ES-1,K5+CS-1):D8=YN*N(J5+ES-1,K5+CS-1):GOSUB4000:D(J5+ES-1,K5+CS-1)=N8:N(J5+ES-1,K5+CS-1)=D8
3150 NEXT K5
3160  FOR I5=1TOG2
3170 IF I5=J5 THEN 3220 
3180 YD=-D(I5+ES-1,J5+CS-1):YN=N(I5+ES-1,J5+CS-1):N8=YD:D8=YN:GOSUB4000:YD=N8:YN=D8
3190 FORK5=1TOCM
3200 A5=D(I5+ES-1,K5+CS-1):B5=N(I5+ES-1,K5+CS-1):N8=A5:D8=B5:GOSUB4000:A5=N8:B5=D8:C5=D(J5+ES-1,K5+CS-1):D5=N(J5+ES-1,K5+CS-1):N8=C5:D8=D5:GOSUB4000:C5=N8:D5=D8:N8=YN*D5*A5+YD*C5*B5:D8=B5*YN*D5:GOSUB4000:D(I5+ES-1,K5+CS-1)=N8:N(I5+ES-1,K5+CS-1)=D8
3210 NEXTK5
3220 NEXTI5
3230 NEXTJ5
3240 I2=EM
3250 IF G2>=I2 THEN 3290
3260 YD=0:YN=1
3270 FOR J2=1TOG2:A5=D(ES+J2-1,CS+CM-1):B5=N(ES+J2-1,CS+CM-1):C5=D(ES+I2-1,CS+J2-1):D5=N(ES+I2-1,CS+J2-1):E5#=YD:F5#=YN
3280 YD=B5*D5*E5#+A5*C5*F5#:YN=F5#*B5*D5:NEXTJ2:IF YD*N(I2+ES-1,CS+CM-1)=YN*D(I2+ES-1,CS+CM-1) THEN I2=I2-1:GOTO3250 ELSE ER=7:GOTO2000
3290 '
3300 NZ=1:DZ=1
3310 FORI5=ESTOES+CM-2:D5=N(I5,CS+CM-1):DZ=DZ*D5:FORJ5=ESTOES+EM-1:D8=D(J5,CS+CM-1)*D5:N8=N(J5,CS+CM-1):GOSUB4000:D(J5,CS+CM-1)=D8:N(J5,CS+CM-1)=N8:NEXTJ5,I5
3320 FOR I5=1TOCM-1:D(0,I5+CS-1)=D(ES+I5-1,CS+CM-1):NEXTI5:D(0,CS+CM-1)=DZ
3599 RETURN
3600 'SUB
3602 PRINT@60,CHR$(94);:IFRND(2)=1 THENPRINT"-"ELSEPRINT" "
3605 IF D(P2,0)>EM+ES-1 THEN F3=0:RETURN
3610 IF N( D(P2,0),P2+CS-1)=0 THEN F3=0:RETURN
3620 IF P2=1 THEN F3=-1:RETURN
3630 FOR I3=1TO P2-1:IF D(P2,0)<>D(I3,0) THEN NEXT:F3=-1:RETURN ELSE FORI3=1TO1:NEXT:F3=0:RETURN
3650 T7=0:FOR I7=ES TO ES+G2-1:T7=T7+ABS(N( D(I7-ES+1,0),CS+CM-1)):NEXTI7:IFT7=0 THEN F6=0:RETURN
3700 'REM
3705 FORI7=1TOEN:N(I7,0)=0:NEXTI7
3710 P6=1:N(D(1,0),0)=P6
3720 IF G2>=2 THEN FOR I6 =ES+1TO G2+ES-1 ELSE 3790
3730 FOR I7=ES TO I6-1
3740 F6=0:FOR J6=CS TO CS+CM-1:T6(0)=ABS(SGN(N(D(I6-ES+1,0),J6))):T6(1)=ABS(SGN(N(D(I7-ES+1,0),J6))):IFNOT (T6(0)=1ANDT6(1)=1) THEN NEXT J6:GOTO3770 ELSE IF N(D(I6-ES+1,0),0)=0 THEN N(D(I6-ES+1,0),0)=N(D(I7-ES+1,0),0):GOTO3770
3750 T6=N(D(I7-ES+1,0),0):FORJ7=ESTOES+G2-1:IFN(D(J7-ES+1,0),0)=T6 THEN N(D(J7-ES+1,0),0)=N(D(I6-ES+1,0),0)
3760 NEXTJ7:PRINT@59,I7;
3770 NEXTI7:IFN(D(I6-ES+1,0),0)=0THEN P6=P6+1:N(D(I6-ES+1,0),0)=P6
3780 NEXTI6:IFP6=1 THEN3790ELSEFORJ7=1TOG2:IFN(D(J7,0),0)=N(D(1,0),0) THENNEXTJ7 ELSE F6=0:RETURN
3790 F6=-1:RETURN
4000 REM
4005 PRINT@60,"-";:IFRND(2)=1THENPRINTCHR$(94)ELSEPRINT" "
4010 IF N8=0 AND D8=0 THEN RETURN ELSE IF N8=0 THEN D8=1:RETURN ELSE IF D8=0 THEN N8=1:RETURN
4020 A8=N8:B8=D8
4030 A8=ABS(A8):B8=ABS(B8)
4040 R8=A8-B8*INT(A8/B8)
4050 IF R8<>0 THEN A8=B8:B8=R8:GOTO4040
4070 N8=N8/B8:D8=D8/B8
4080 IF (N8<0 AND D8<0) OR N8<0 THEN N8=-N8:D8=-D8
4090 RETURN
5000 REM
5010 E1$=EQ$:J=1:CF=1:T=0
5020 M1=3:GOSUB1000:IFM1=5THENJ=J+1:GOTO5020ELSEIFM1=6THENCF=-1:T=T+1:J=J+1:GOTO5020 ELSEIFM1=7 THEN 5200 ELSE IF M1=2 THEN ER=12:GOTO2000
5030 T$=R1$:M1=4:GOSUB1000:FORI=3TOLEN(EL$)-1STEP2:IFMID$(EL$,I,2)<>LEFT$(T$+" ",2) THEN NEXT:PRINT"ERROR":STOP
5040 N((I-1)/2,J)=M1*CF+N((I-1)/2,J):GOTO5020
5200 FORI=1TO1:NEXTI:IFT>1 THEN ER=3:GOTO2000 ELSE475
5500 REM BRANCH TO GET RID OF WORTHLESS INFO
5505 E1$=EQ$:R2$=""
5510 M1=2:GOSUB1000:IFM1=7 THEN EQ$=R2$:Q5=Q5+1:FORI=0TOEN:FORJ=0TOCN:N(I,J)=0:D(I,J)=0:NEXTJ,I:FORI=1TOPL:PR(I)=0:NEXTI:FORI=1TOEN:N(I,CN+1)=0:NEXTI:GOTO200
5515 IF M1<>1 THEN R2$=R2$+R1$
5520 IF M1=1 AND LEFT$(R1$+" ",2)<>EM$ THEN R2$=R2$+"."+R1$ ELSEM1=4:GOSUB1000
5540 GOTO 5510
6000 REM
6020 IF II=LEN(EL$)/2-1 THEN EL$=LEFT$(EL$,LEN(EL$)-2) ELSE EL$=LEFT$(EL$,II*2)+RIGHT$(EL$,2)+MID$(EL$,II*2+3,LEN(EL$)-II*2-4) 
6030 RETURN
6500 IF RX=0 OR Q5>0 OR (ABS(RX)=1 AND LEFT$(R1$+" ",2)<>"H" AND LEFT$(R1$+" ",2)<>"O" AND LEFT$(R1$+" ",2)<>"@")THEN EL$=EL$+R1$:EN=EN+1
6510 RETURN
7000 REM
7005 IF RX<>0 THEN GOSUB7600
7010 EQ$="-"+CHR$(94):PRINT@64*8,"";
7020 EL$="":II=0:S=1:FOR I=1 TOLEN(EZ$):T$=MID$(EZ$,I,1)
7025 IF T$="(" THEN T$="<"ELSE IF T$=")"THENT$=">" ELSE IF T$="="THENT$=EQ$
7030 IF S=2 THEN 7080
7040 IF T$=" "THENEL$=EL$+" " ELSE II=II+1:S=2:TT$="":IFD(0,II)<>1 THEN EL$=EL$+STR$(D(0,II))+"( "+T$ ELSE EL$=EL$+"( "+T$
7050 GOTO 7200
7080 IFT$=" "THENTT$=TT$+" " ELSE IF T$="+"ORT$=EQ$ THEN EL$=EL$+" )"+TT$:GOSUB7210:EL$=T$:S=1:GOTO7200 ELSE EL$=EL$+TT$+T$:TT$=""
7200 NEXT I:EL$=EL$+" )":GOSUB7210:GOTO8000
7210 IF LEN(EL$)+POS(0)>62 THEN PRINT
7220 PRINTEL$;:RETURN
7500 IF T(0)*T(1)=0 AND RX=0 THEN ER=5:GOTO2000
7510 IF T(0)*T(1)<>0 THEN RETURN
7520 T$=MID$(EL$,J*2+1,2):IF T$<>"H " AND T$<>"O " AND T$<>"@ " THEN ER=5:GOTO2000 ELSE RETURN
7600 REM
7605 RETURN
7610 IF RX=-1 THEN EQ$="O.H@- "
8000 PRINT:PRINT:INPUT"DO YOU HAVE ANOTHER EQUATION TO BALANCE";T$:IFT$="Y"ORT$="YES"THEN RUN ELSE END
8500 IF RX=0 THEN XX=0 :RETURN
8510 IF ABS(RX)=2 OR ABS(RX)=4 THEN XX=1 ELSE XX=2
8520 RETURN
9000 EQ$=T$+EQ$:EZ$=T$+EZ$
9010 RETURN
9500 IF ABS(RX)=4 OR ABS(RX)=2 THEN IF CM>EM+2 THEN ER=10:GOTO2000 ELSE IF ABS(RX)=4 THEN EZ$=RIGHT$(EZ$,LEN(EZ$)-5):EQ$=RIGHT$(EQ$,LEN(EQ$)-5):RX=0:GOTO205ELSEEQ$=RIGHT$(EQ$,LEN(EQ$)-6):EZ$=RIGHT$(EZ$,LEN(EZ$)-6):RX=0:GOTO205
9510 IF CM>EM+3 THEN ER=10:GOTO2000 ELSE IF CM=EM+3 THEN EZ$=RIGHT$(EZ$,LEN(EZ$)-11):EQ$=RIGHT$(EQ$,LEN(EQ$)-11) :RX=0:GOTO205
9520 IF U0=0 THEN ER=10:GOTO2000 ELSE X0=1:EZ$=RIGHT$(EZ$,LEN(EZ$)-5):RX=0:GOTO205
9999 FORI=0TOEN:FORJ=0TOCN:PRINTD(I,J)"/"N(I,J)" ";:NEXTJ:PRINT:NEXTI:RETURN
10000 CLS:PRINT@3*64,"CHEMISTRY EQUATION BALANCER II":PRINT"KADIE SOFTWARE":PRINT"COPYRIGHT 1981 CARL KADIE ":RETURN
