1 '
5 PI=3.14159
6 R=VAL(RIGHT$(TIME$,2)):FORI=1TOR:I=I+RND(1)*0:NEXTI
10 'start
11 C$(0)="Germany":C$(1)="Russia":N(0)=0:N(1)=0:CLS:PRINT" The Secret War ":PRINT
12 KEY1,"ASSERT ":KEY2,"INVEST ":KEY3,"SPY ":KEY4,"DEFEND ":KEY5,"CALL"+CHR$(13):KEY6,"HELP"+CHR$(13)
15 'turn
20 'front
21 IF N(0)>2 OR N(1)>2 THEN 900 :'end
30 PRINT"Front ";N(0)+N(1)+1:M=0
40 'battle
41 IF ABS(M)=2 GOTO  300 :'eof
50 E(0)=INT(RND(1)*1000):E(1)=INT(RND(1)*1000):G=0:P=INT(RND(1)*2)
60 'turn
61 P=1-P:Y(0)=E(0):Y(1)=E(1):PRINTC$(P);" begin."
70 T=M*SGN(P-.5):U=N(P):PRINT"Fronts:  ";T:PRINT"Battles: ";U
80 'invest
81 T=E(P):PRINT"You have ";T:T=0:U=0:INPUT"Investment, Potential Profit";T,U
90 IF T<=0 OR T>E(P) OR U<0 THEN 120:'ei
100 R=RND(1):V=-T:IF R*1.05<T/(U+T) THEN V=U
110 E(P)=E(P)+V:GOTO 80:'invest
120 'ei
121 PRINT"Counter-intell is now";K(P):INPUT "Budget: counter-intell.  ";K(P):T=E(P):E(P)=T-K(P)
130 IF E(P)<0 THEN E(P)=T:GOTO 121
131 INPUT "intelligence  ";I(P):T=E(P):E(P)=T-I(P)
135 IF E(P)<0 THEN E(P)=T:GOTO 131
145 'bid
146 PRINT"Intelligence Report"
150 U=2*ATN(I(P)/(K(1-P)+.5)/20)/PI:V=INT((1-U)*RND(1)*1000+U*Y(1-P)+.5)
170 PRINTC$(1-P);" has";V:PRINT C$(1-P);" asserts ";G:INPUT "assert?";Y(P)
180 IF INT(Y(P))>GTHEN:G=INT(Y(1)):GOTO 145
200 PRINT C$(1-P);" asserts ";G;".":PRINT"It really has ";E(1-P);".":M=M+((1-P)*2-1)*(-(G>E(1-P))*2-1):PRINTC$(-((1-P)=-(G>E(1-P))));" wins the battle!"
210 GOTO 15
300 'eof end of fight
310 N(-( M<0))=N(-(M<0))+1
320 M=0:GOTO 20:'turn
900 'end
910 PRINT"That's all"
920 END
