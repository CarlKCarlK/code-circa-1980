10 L=5
100 N1=RND(L):N2=RND(L)
105 P=P+1
110 CLS:PRINTCHR$(23)
120 PRINT:PRINT"WHAT IS THE ANSWER TO":PRINT:PRINTN1" + ";N2" = ";
130 INPUT A
140 PRINT:PRINT
145 IF N1+N2=A AND N=0 THEN L=L+1
150 IF N1+N2=A THEN N=0:GOSUB 1000
155 IF N1+N2<>A AND N=0 THEN M=M+1:L=L-1
160 IF N1+N2<>A THEN N=1:GOSUB2000:FORX=1TO1000:NEXT:GOTO 110
190 CLS:PRINTCHR$(23)
195 PRINT
200 PRINT"NOW IT'S YOUR TURN"
210 PRINT
220 PRINT
230 INPUT D$
240 N1=VAL(LEFT$(D$,1)):N2=VAL(RIGHT$(D$,LEN(D$)-1))
250 IF RND(0)<M/P THEN A=RND(18)ELSE A=N1+N2
260 PRINT"I THINK THE ANSWER IS":FORX=1TO1000:NEXT
265 PRINTA:FORX=1TO1000:NEXT
270 IF A=N1+N2 THEN GOSUB 1000ELSE GOSUB2000
280 FORX=1TO1000:NEXT
290 GOTO 100
999 END
1000 FOR R=1TO64:PRINT"THAT'S RIGHT                   ";:NEXT:RETURN
2000 PRINT"SORRY THAT'S WRONG.":RETURN
