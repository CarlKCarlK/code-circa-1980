2 CLS
5 DIM C$(6,3),V$(4,3)
10 FOR S=1TO6:FOR N=1TO 3:READ C$(S,N):NEXTN,S
20 FOR V=1TO4:FORE=1TO3:READ V$(V,E):NEXTE,V
25 B$="123456789"
27 TI=10
30 GOTO 2000
1000 DATA HYDROGEN OXIDE,WATER,H2O,  HYDROGEN CHLORIDE,HYDROCLORIC ACID,H.CL,  HYRDOGEN SULFATE,SULFURIC ACID,H2(S.O4),        HYDROGEN ACETATE,ACETIC ACID, H(C2H3O2),  HYDROGEN NITRATE, NITRIC ACID,H(N.O3),HYDROGEN PHOSPHATE
1010 DATA PHOSPHORIC ACID,H3(P.O4)
1020 ' OTHER STUFF
1030 DATA NA.BR, K.CL, AG(N.O3)
1040 DATA CA.F2,CU(N.O3)2, BA(S.O4)
1050 DATA AL.CL3, BI(N.O3)3,FE(P.O4)
1060 DATA TI.CL4,C.H4,SI.F4
2000 PRINT"TIME="TI:FOR X=1TO1000:NEXTX:CLS
2010 IF RND(6+12)<=6 THEN A$=C$(RND(6),3) ELSE A$=V$(RND(4),RND(3))
2020 Q$="":FOR I=1TOLEN(A$):IF INSTR( B$,MID$(A$,I,1))=0 THEN Q$=Q$+MID$(A$,I,1)
2030 NEXTI
2035 PRINT"                  ";Q$
2040 LINE INPUT#LEN TI,3000;"ADD THE NUMBERS:  ";G$
2045 PRINT
2050 IF A$=G$ THEN PRINT"RIGHT -- RIGHT -- RIGHT --":TI=TI*.9ELSEPRINT           "NO, NO, NO, NO,  ";A$:TI=TI*1.2
2060 GOTO 2000
3000 PRINT:   PRINT"TIME TIME TIME    ";A$:TI=TI*1.4
3010 GOTO 2000
