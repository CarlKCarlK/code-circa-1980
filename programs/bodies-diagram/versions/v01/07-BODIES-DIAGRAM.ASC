10 INPUT"HOW MANY BODIES ARE THERE";BN
20 FORI=1TOBN
30 PRINT"WHAT IS THE X,Y, AND MASS OF BODY #";I;
40 INPUTB(I,1),B(I,2),B(I,3)
50 B(I,2)=B(I,2)/2
60 NEXT
70 X=64:Y=24
80 CLS
90 FORI=1TOBN
100 LINE@(B(I,1),B(I,2))-(B(I,1)+B(I,3),B(I,2)+B(I,3)/4),SET,BF
110 NEXT
120 FORI=1TOBN
130 F=B(I,3)/((X-B(I,1))[2+(Y-B(I,2))[2)
140 W=TAN((Y-B(I,2))/(X-B(I,1)))
150 XC=XC+F*COS(W)
160 YC=YC+F*SIN(W)
170 NEXT
180 X=X-XC*1000
190 Y=Y-YC*1000
200 SET(X,Y)
210 XC=0:YC=0
220 GOTO120  
