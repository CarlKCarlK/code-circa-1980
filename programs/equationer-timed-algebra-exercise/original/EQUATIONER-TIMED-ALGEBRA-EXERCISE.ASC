2 AT=1000
5 CLS
7 GOSUB 20000
10 READ X1,Y1,X2,Y2:IF X1=-1 THEN X1=OX:Y1=OY
15 IF X1=-999 THEN 100
30 OX=X2:OY=Y2
40 GOSUB1000
50 GOTO 10
100 PRINT@448+34,"SQUARE ROOT";
110 IF INKEY$=""THEN110
120 CLS
130 N=RND(15)
140 PRINT"WHAT IS SQUARE ROOT OF ";N[2" ??? ";:Q$="":T=0
145 A$=INKEY$:PRINTA$;:T=T+1:IFT>AT THEN 200  ELSEIFA$=""THEN145ELSEIFA$=CHR$(13)THEN150ELSEQ$=Q$+A$:GOTO145
150 IF VAL(Q$)=N THEN PRINT"RIGHT" ELSE PRINT "NOPE. IT IS "N
152 IF C=0 THEN C=1:AT=T:GOTO156
155 C=C+1:AT=(AT*(C-1)+T)/C
156 PRINT "TIME = "T,"AVERAGE TIME = "AT
160 GOTO110
200 FORX=1TO16:PRINT"TIME !","TIME!","tIME!","TIME!":NEXTX
205 T=2*AT
210 FORX=1TO300:NEXTX:CLS:GOTO150
1000 REM
1010 D=SQR((Y1-Y2)[2+(X1-X2)[2)
1020 SY=Y2/D-Y1/D
1030 SX=X2/D-X1/D
1040 FOR DD=0TOD
1050 SET(X1+SX*DD+.5,Y1+SY*DD+.5)
1060 NEXT DD
1070 RETURN
20000 READ A$:IFA$="DONE"THENRETURNELSEPRINTA$:PRINT:FORX=1TO500:NEXTX:GOTO20000
20010 DATA "LOOK...","UP IN THE AIR...","IT'S A BIRD","IT'S A PLANE","NO","NO","IT'S ....",DONE
32000 DATA 113,7,59,7,-1,-1,26,41,-1,-1,11,33,-999,1,1,1
