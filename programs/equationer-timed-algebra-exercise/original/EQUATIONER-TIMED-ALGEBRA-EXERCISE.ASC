2 AT=100000
5 CLS
7 GOSUB 20000
10 READ X1,Y1,X2,Y2:IFX1=-1 THEN X1=OX:Y1=OY
15 IF X1=-999 THEN 100
30 OX=X2:OY=Y2
40 GOSUB1000
50 GOTO 10
100 PRINT@448+34+128,"EQUATIONER";
110 IF INKEY$=""THEN110
120 CLS
130 X=RND(15):P1=RND(5):P2=RND(5):A1=RND(6):A2=P1*X+A1-P2*X:IFP1=P2 THEN X=-999
140 PRINT"WHAT DOES X EQUAL IF  "P1"*X +"A1" ="P2"*X +"A2" ???";:Q$="":T=0
145 A$=INKEY$:PRINT@50,STRING$(LEN(Q$),"");A$;:T=T+1:PRINT@55,INT(AT-T+1);:IFT>AT THEN 200  ELSEIFA$=""THEN145ELSEIFA$=CHR$(13)THEN150ELSEQ$=Q$+A$:GOTO145
150 PRINT:IF VAL(Q$)=X OR X=-999THEN PRINT"RIGHT" ELSE PRINT "NOPE. IT IS "X
151 IF X=-999 THEN PRINT"ANY NUMBER MAKES THAT STATEMENT TRUE"
152 IF C=0 THEN C=1:AT=T:GOTO156
155 C=C+1:AT=(AT*(C-1)+T)/C
156 PRINT "TIME = "T,"AVERAGE TIME = "AT
160 GOTO110
200 FORX=1TO16:PRINT"TIME !","TIME!","tIME!","TIME!":NEXTX
205 T=2*AT
210 FORX=1TO300:NEXTX:CLS:GOTO150
1000 REM
1010 D=SQR((Y1-Y2)[2+(X1-X2)[2)
1020 SY=Y2/D-Y1/D
1030 SX=X2/D-X1/D
1040 FOR DD=0TOD
1050 SET(X1+SX*DD+.5,Y1+SY*DD+.5)
1060 NEXT DD
1070 RETURN
20000 READ A$:IFA$="DONE"THENRETURNELSEPRINTA$:PRINT:FORX=1TO500:NEXTX:GOTO20000
20010 DATA "LOOK...","DOWN IN THE WATER...","IT'S A FISH","IT'S A SUB","NO","YES","IT MUST BE ....",DONE
32000 DATA 40,15,60,35,60,15,40,35, 65,22,85,22, 65,26,85,26, 90,15,105,21,-1,-1,113,15, 105,21,105,30,-999,1,1,1
