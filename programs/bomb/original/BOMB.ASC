4 CLEAR200:DIMW$(40)
5 FOR II=1 TO 38:READ W$(II):NEXT II:GOTO 5000
10 CLS:IF SK=1 THEN SP=500:GOTO 200
20 PRINT"              W E L C O M E   T O   B O M B"
30 PRINT:PRINT:PRINT"  WELCOME, BRAVE ADVENTURER.  YOU SHALL BE PITTED AGAINST A MOST":PRINT"FORMIDABLE FOE.  HIS NAME IS THOMAS NICHOLAS TAGGERT---KNOWN TO":PRINT:PRINT"THE POLICE AS 'NEFARIOUS NICK'. HE DELIGHTS IN DREAMING UP DAST-"
40 PRINT"ARDLY BOMBS THAT WILL KILL HUNDREDS OF INNOCENT PEOPLE.":PRINT:PRINT"    YOU, BRAVE SOUL THAT YOU ARE, HAVE VOLUNTEERED TO STOP HIM.":PRINT:PRINT"               DO NOT FAIL US, YE VALIANT ONE!"
45 PRINT@982,"PRESS <ENTER>";
50 IF INKEY$<>CHR$(13) THEN 50
60 CLS:PRINT"     NICK'S BOMBS ARE BASICALLY ALL ALIKE.  THREE TO FIVE WIRES,":PRINT"CUT PROPERLY, WILL DISARM THE BOMB.  yOU WILL BE TOLD WHAT WIRES":PRINT"TO CUT, AND THEN YOU MUST CUT THEM, MAKING NO MISTAKES ( IN      ":PRINT"EITHER COLOR OR ORDER, "; 
70 PRINT" OR ELSE BOOM!!) ":PRINT:PRINT"  AS YOU GET BETTER, THE TIME YOU GET TO MEMORIZE THE WIRE ORDER":PRINT"AND TYPE IN YOUR RESPONSE DECREASES.  (NICK MAKES INCREASINGLY  ":PRINT"DIFFICULT BOMBS)":PRINT
80 PRINT"         THE BOMB IS TICKING-----GOOD LUCK!!!"
90 PRINT@982,"PRESS <ENTER>";
100 IF INKEY$<>CHR$(13) THEN 100
199 SP=500
200 PRINT@55,SP;:NW=INT(SQR(RND(10)))+2
205 GOSUB 700:CLS
210 PRINT:PRINT"      THIS TIME, YOU MUST CUT";NW;" WIRES IN THE PROPER ORDER.":PRINT:PRINT"                        GOOD LUCK!!
220 PRINT"               HERE ARE THE WIRES-----"
230 FOR T=43 TO 84:SET(T,24):SET(T,32):NEXT T
240 FOR S=24 TO 32:SET(43,S):SET(84,S):NEXT S
250 FOR N=1 TO NW
260 PRINT@603-(LEN(W$(N))/2),"   ";W$(N);"   ";:FOR PAU=1 TO SP:NEXT PAU:NEXT N
299 CLS
300 PRINT"WHAT IS THE FIRST WIRE? ";:GOSUB 600
305 FOR PA=1 TO 300+RND(500):NEXT PA
310 IF AN$<>W$(1) THEN 900
320 PRINT"CONGRATULATIONS! FIRST WIRE CUT THROUGH. ":PRINT
330 PRINT"AND NOW, WHAT IS THE SECOND WIRE? ";:GOSUB 600
335 FOR PA=1 TO 300+RND(500):NEXT PA
340 IF AN$<>W$(2) THEN 900
350 PRINT"WAY TO GO!  TWO WIRES HAVE BEEN SUCCESSFULLY CUT.  kEEP A STEADY HAND, AND DON'T FORGET THE ORDER.  NEXT---":PRINT
360 PRINT"WHAT IS THE THIRD WIRE? ";:GOSUB 600
365 FOR PA=1 TO 300+RND(500):NEXT PA
370 IF AN$<>W$(3) THEN 900
375 IF NW=3 THEN 800
380 PRINT"EXCELLENT!--A NICE, CLEAN CUT."
390 PRINT:PRINT:PRINT" STEADY NOW--THE FOURTH WIRE? ";:GOSUB 600
395 FOR PA=1 TO 300+RND(500):NEXT PA
400 IF AN$<>W$(4) THEN 900
405 IF NW=4 THEN 800
410 PRINT"NICE GOING, BUT CAN YOU KEEP YOUR COOL FOR THE FINAL WIRE??      WE'LL SEE--":PRINT
420 PRINT"WHAT WIRE DO YOU CUT NOW? ";:GOSUB 600
425 FOR PA=1 TO 300+RND(500):NEXT PA
430 IF AN$<>W$(5) THEN 900 ELSE 800
600 M$=INKEY$:M$=INKEY$:AN$="":M$="":TM=0
610 PRINTCHR$(14);
620 M$=INKEY$:TM=TM+1:IF TM>SP THEN 900 ELSE IF M$<>CHR$(13) AND M$<>"" THEN AN$=AN$+M$:PRINT M$;:GOTO 620  ELSE IF M$=CHR$(13) THEN PRINT:RETURN  ELSE IF M$="" THEN 620
699 END
700 FOR I=1 TO 38
710 CH=RND(38)
720 A$=W$(I):W$(I)=W$(CH):W$(CH)=A$
730 NEXT I
740 RETURN
799 END
800 CLS:PRINT"  CONGRATULATIONS, BRAVE DECODER!!   yOU HAVE SINGLE-HANDEDLY   DISMANTLED THIS BOMB.  mR. TNT IS VERY ANGRY."
810 TN=TN+NW
820 PRINT:PRINT"WELL DONE; SO FAR YOU HAVE CUT";TN;" WIRES."
830 IF TN<=RN(9) THEN PL=0:GOTO 860
840 IF TN>RN(0) THEN PL=1:GOTO 860
850 FOR CH=9TO0 STEP -1:IF TN>RN(CH) AND TN<=RN(CH-1) THEN PL=CH+1 ELSE NEXT CH
860 IF PL=0 THEN PRINT"YOU ARE NOT YET RANKED.  YOU NEED A SCORE OF";RN(9)+1;" TO PLACE."  ELSE PRINT "YOU ARE CURRENTLY RANKED NUMBER";PL
870 PRINT:INPUT"DO YOU WANT TO RETIRE";A$
875 IF A$<>"YES" THEN SP=.75*SP:GOTO 200 ELSE IF TN>RN(9) PRINT"YOU WILL RETIRE WITH A HANDSOME PENSION, BECAUSE YOU ARE ";:GOSUB 3000     ELSE 880
880 FOR WA=1 TO 1000:NEXT WA
890 GOTO 5000
900 PRINTCHR$(15):PRINT:PRINT:PRINT"B O O M !!!"
910 FOR X=1 TO 200:PRINTCHR$(23);:PRINTCHR$(28);:NEXTX:CLS:PRINT"TOO BAD--YOU JUST KILLED YOURSELF"
920 PRINT"            THE CORRECT ORDER WAS---"
930 FOR LI=1 TO NW:PRINT"                 ";W$(LI):NEXT LI
940 IF TN>RN(9) THEN PR=1:PRINT:PRINT"YOUR DEPENDENTS WILL RECEIVE A CONSIDERABLE INCOME, FOR YOU ARE":PRINT"POSTHUMOUSLY ";:GOSUB 3000
945 FOR WA=1 TO 1000:NEXT WA
950 GOTO 5000
1000 DATA WHITE,BLACK,GREY,GRAY,YELLOW,GREEN,ORANGE,RED,PINK,BLUE,PURPLE,VIOLET,INDIGO,EBONY,COBALT,AQUA,SAPPHIRE,TURQUOISE
1010 DATA SILVER,GOLD,EMERALD,SCARLET,CINNAMON,CRIMSON,LEMON,CHROME,AZURE,BAY,TAN,AUBURN,COPPER,KHAKI,OLIVE,MAROON,IVORY,AMBER,BEIGE,BROWN
3000 PRINT"RANKED IN THE TOP TEN"
3005 PRINT
3010 INPUT"WHAT ARE YOUR INITIALS";IN$
3015 IN$=MID$(IN$+"   ",1,3):IF PR=1 THEN IN$=IN$+"     P"
3020 FOR CH=9 TO 0 STEP -1
3030 IF TN>RN(CH) THEN RN(CH+1)=RN(CH):RN(CH)=TN:I$(CH+1)=I$(CH):I$(CH)=IN$
3040 NEXT CH
3050 CLS:PRINTCHR$(23):PRINT"       R A N K I N G S":PRINT"   (P = POSTHUMOUS RATING)":PRINT:FOR CH=0 TO 9:IF RN(CH)>0 THEN PRINTCH+1;TAB(6);RN(CH),I$(CH)
3060 NEXT CH
3070 RETURN
5000 CLS:PRINT@960,"      TO PLAY DEPOSIT $.25 IN BOX, THEN PRESS ANY BUTTON";
5010 FORX=0TO127:IFINKEY$<>""THEN5090 ELSE SET(X,0):SET(X,44):NEXTX:FORY=1TO43:IFINKEY$<>""THEN5090 ELSE SET(0,Y):SET(127,Y):NEXTY
5020 PRINT@90,"B O M B !!!!";:PRINT@698,"TNT";:FORX=114TO123:SET(X,29):SET(X,33):NEXTX:FORY=29TO33:SET(114,Y):SET(123,Y):NEXTY:PRINT@708,STRING$(53,"-");:PRINT@642,CHR$(190)+CHR$(148);:PRINT@578,CHR$(172)+CHR$(132);:PRINT@706,CHR$(143)+CHR$(133);
5030 FORX=1TO500:IFINKEY$<>""THEN5090 ELSE NEXTX:PRINT@578,CHR$(176)+CHR$(144);:FORX=1TO500:IFINKEY$<>""THEN5090 ELSENEXTX:FORX=708 TO 759:PRINT@X," ";:FORY=1TO30:IFINKEY$<>""THEN5090 ELSEPRINT@X+1,CHR$(41+RND(2));:NEXTY,X:PRINT@760," ";
5040 FORX=1TO50:IFINKEY$<>""THEN5090 ELSENEXTX:FORX=1TO50:IFINKEY$<>""THEN5090 ELSE PRINT@RND(950),CHR$(23);" BOMB ":FORY=1TO10:NEXTY:PRINT@RND(1000),CHR$(28)+" BOMB ":NEXTX:CLS
5050 PRINTCHR$(23):B$="BOMB":FORY=1TO4:FORX=1TO300:IFINKEY$<>""THEN5090 ELSE NEXTX:PRINT@528+Y*4,MID$(B$,Y,1);:NEXTY:FORX=1TO50:IFINKEY$<>""THEN5090ELSEY=RND(8)*2+528+((RND(3)-2)*64):PRINT@Y,CHR$(192-RND(64));:NEXTX:FORX=1TO500:NEXTX
5070 GOSUB 3050:PRINT@960,"   $.25 TO PLAY, PRESS <BAR>";:FORX=1TO2000:IFINKEY$<>""THEN5090ELSENEXT:GOTO5000
5080 GOTO5080
5090 TN=0:PR=0:GOTO10
