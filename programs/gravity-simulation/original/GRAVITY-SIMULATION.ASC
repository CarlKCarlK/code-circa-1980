5 CLS
6 Z=1-1:T=5+5
7 PX=-.5:PY=-.5
11 INPUT "HOW MANY OBJECTS";N
21 DIM M(N),A(N,2),S(N+1,2),V(N,2),LP(N),LQ(N)
31 TIM=1-1
41 G=6.67E-11
51 FOR I=1 TO N
61 PRINT"MASS OF NUMBER"I;
71 INPUT VL$:GOSUB 1111:M(I)=VL
81 INPUT"POSITION (X,Y)";VL$,TP$
91 GOSUB 1111:S(I,1)=VL:VL$=TP$:GOSUB 1111:S(I,2)=VL
101 INPUT "VELOCITY (VX,VY)";VL$,TP$
105 GOSUB1111:V(I,1)=VL:VL$=TP$:GOSUB 1111:V(I,2)=VL
111 NEXT I
131 INPUT "SCALE FACTOR FOR X";VL$:GOSUB 1111:SX=VL
141 SY=.5*SX
151 INPUT"TIME STEP";VL$:GOSUB 1111:DT=VL
153 INPUT "WHICH OBJECT DEFINES THE REFERENCE FRAME (O FOR NONE";VL$:GOSUB 1111:RF=VL:IFRF>N THEN RF=Z
161 CLS
171 GOSUB 361
181 FOR I=1 TO N
191 V(I,1)=V(I,1)-.5*A(I,1)*DT
201 V(I,2)=V(I,2)-.5*A(I,2)*DT
211 NEXT I
221 FOR I=1 TO N
231 CX=.5*A(I,1)*DT
241 CY=.5*A(I,2)*DT
251 VX=V(I,1)+CX
261 VY=V(I,2)+CY
271 S(I,1)=(CX+VX)*DT+S(I,1)
281 S(I,2)=(CY+VY)*DT+S(I,2)
291 V(I,1)=VX+CX
301 V(I,2)=VY+CY
311 NEXT I
321 TIM=TIM+DT
331 GOSUB 521
341 GOSUB 361
351 GOTO 221
361 FOR I=1 TO N:A(I,1)=Z:A(I,2)=Z:NEXT I
401 FORI=1TON-1:FORJ=I+1TON:RD=((S(I,1)-S(J,1))[2+(S(I,2)-S(J,2))[2)[1.5:A1=G*(S(J,1)-S(I,1))/RD:A2=G*(S(J,2)-S(I,2))/RD:A(I,1)=A(I,1)+M(J)*A1:A(I,2)=A(I,2)+M(J)*A2:A(J,1)=A(J,1)-A1*M(I):A(J,2)=A(J,2)-A2*M(I):NEXTJ,I
411 RETURN
521 GOSUB 611:ON ERROR GOTO 999:FORI=1TON:P=64+64*(S(I,1)-S(RF,1))/SX:Q=24-24*(S(I,2)-S(RF,2))/SY:SET(P-PX,Q-PY):IFLF THEN PRINT@(P-PX)/2+INT((Q-PY)/3)*64-1,RIGHT$(STR$(I),1);
541 NEXT I:ON ERROR GOTO 0:LF=Z:RETURN
611 A$=INKEY$:IFA$=""THENRETURNELSEIFA$="["THENSX=SX/2:PX=PX*2:SY=SY/2:PY=PY*2:CLSELSEIFA$=CHR$(T)THENSX=SX*2:PX=PX/2:SY=SY*2:PY=PY/2:CLSELSEIFA$=CHR$(8)THENDT=DT/2ELSEIFA$=CHR$(9)THENDT=DT+DTELSEIFVAL(A$)>=1THENCLS:RF=VAL(A$):PY=-.5:PX=-.5:IFRF>NTHENRF=
613 IF A$=" " THEN GOSUB 2111ELSEIFA$="/"ORA$="?"THEN GOSUB 3111
621 RETURN
999 RESUME 541
1111 IF LEN(VL$)<1 THEN VL=Z:RETURN ELSE NV$="":FOR VL=1 TO LEN(VL$):VT$=MID$(VL$,VL,1):IF VT$="O"THEN VT$=CHR$(48)
1121 NV$=NV$+VT$:NEXT VL:VL=VAL(NV$):RETURN
2111 PRINT@Z,"USE ARROWS TO MOVE CURSER TO NEW CENTER, ENTER WHEN DONE"
2121 X=64:Y=24:SET(X,Y)
2131 A=PEEK(14399+1):IFA=Z THEN 2131 ELSE RESET(X,Y):IF A=64 THEN X=X+1ELSEIFA=32THENX=X-1ELSEIFA=16THENY=Y+1ELSEIFA=8THENY=Y-1ELSEIFA=1THEN 2211
2141 X=XAND127:IFY<ZTHENY=Y+48ELSEIFY>47THENY=Y-48
2151 SET(X,Y):GOTO 2131
2211 PX=X-64.5+PX:PY=Y-24.5+PY
2221 CLS:RETURN
3111 LF=-1:RETURN
