10 P=1:PI=3.14159:ODD=.228571:CLS:FORA=0TO290:GOSUB110:SET(X,36-Y/2):NEXTA:SET(75,36)
20 SR=1000000
30 FORT=1TO10:READ C(T),B(T):NEXTT
40 DATA 27.5,57,  47.5,57, 37.5,45, 10,40, 65,40, 25,23, 50,23, 7,7, 37.5,7, 68,7
100 PRINT@960-64,"CHAIR";P;:C=PEEK(14400):IFC=2[7THEN A(P)=A:P=P+1:A=A(P)+A(P-4)ELSEIFC=2[5THENA=A-1ELSEIFC=2[6THENA=A+1ELSEIFC=1 THEN 190ELSEIFC=2[3THENA=A-4ELSEIFC=2[4THENA=A+4
101 IF P>4THENP=1:GOTO101ELSEIFA<0THENA=290+A
102 GOSUB110:SET(X(P),36-Y(P)/2):RESET(X,36-Y/2):X(P)=X:Y(P)=Y:GOTO100
105 Y=SIN(A/290*PI*2)*35+30:X=COS(A/290*PI*2)*35+40:RETURN
110 IF A<40 THEN Y=70:X=17.5+A ELSE IFA<65 THENX=57.5:Y=110-A ELSE IF A<82.5THENY=45:X=A-7.5ELSEIFA<127.5THENY=127.5-A:X=75ELSEIFA<202.5THENY=0:X=202.5-AELSEIFA<247.5THENX=0:Y=A-202.5ELSEIFA<265THENY=45:X=A-247.5ELSEX=17.5:Y=A-220
120 RETURN
190 TT=10
200 AD=0:FOR T=1TOTT
210 X=C(T):Y=B(T):'IF RND(0)< ODD THEN X=17.5+RND(0)*40:Y=45+RND(0)*25ELSEX=RND(0)*75:Y=RND(0)*45
215 SET(X,36-Y/2)
220 RD=1111110:FORI=1TO4:DD=SQR( ( X(I)-X)[2+(Y(I)-Y)[2):IFDD<RDTHENRD=DD
230 NEXTI:AD=AD+RD:NEXT T:AD=AD/TT
240 IF AD<SRTHEN SR=AD:PRINT@960,SR;:FORI=1TO4:SET(XX(I),36-YY(I)/2):RESET( X(I),36-Y(I)/2):XX(I)=X(I):YY(I)=Y(I):NEXTI
250 GOTO100
