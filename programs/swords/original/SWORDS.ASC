10 CLS:CLEAR 100
20 PRINT"SWORDS"
30 PRINT:PRINT
40 INPUT"HOW MANY SWORDS";NS
45 PRINT:PRINT"ANSWER 1ST QUESTION:  A-AUTOMATIC   L-LEFT KEYS    R-RIGHT KEYS"
46 PRINT"ANSWER 2ND QUESTION:  0 TO 1, HIGH SLOWS PLAYER DOWN ":PRINT"(MAKE AT LEAST ONE HANDICAP 0)":PRINT
47 DIM T(NS),H(NS),C$(NS),X(NS),Y(NS):LF=0:RF=0
50 FOR I=1 TO NS
60 PRINT"SWORDS ";I;")  ";
70 INPUT T$
80 IF T$="A"THEN ELSE IF T$="L" AND LF=0THEN LF=I ELSE IF T$="R" AND RF=0 THEN RF=I ELSE PRINT:PRINT"TRY AGAIN":GOTO60
85 H(I)=0:INPUT"HANDICAP";H(I)
90 NEXT I
100 IF LF<>0 THEN INPUT"CHARACTER FOR LEFT PLAYER";L$:L$=LEFT$(L$+"L",1)
110 IF RF<>0 THEN INPUT"CHARACTER FOR RIGHT PLAYER";R$:R$=LEFT$(R$+"R",1):IF R$=L$ THEN PRINT:GOTO100
125 CT=ASC("A")-1
130 FOR I=1 TO NS
140 CT=CT+1:C$=CHR$(CT):IF C$=R$ OR C$=L$THEN 140
150 C$(I)=C$
160 NEXT I
170 C$(LF)=L$:C$(RF)=R$
200 CLS:FOR I=1TONS:X(I)=RND(30)*2:Y(I)=RND(14):PRINT@X(I)+Y(I)*64,C$(I);:C$(I)=" ":NEXT I
210 FOR J=1TO4:P(J)=RND(4):READ DX(J),DY(J):NEXTJ
220 DATA -2,-1,  2,-1, -2,1, 2,1
230 IF LF<>0 THENFOR J=1 TO 2: PRINT@ X( LF)+DX(P(J))+(Y(LF)+DY(P(J)))*64,"*";:NEXTJ
240 IF RF<>0 THEN FOR J=3TO4: PRINT@ X(RF)+DX(P(J))+(Y(RF)+DY(P(J)))*64,"*";:NEXTJ
300 C=RND(NS):IF H(C)>RND(0) THEN 300ELSEIFC=LFTHEN GOSUB1000ELSEIFC=RFTHENGOSUB2000 ELSE GOSUB 310
305 GOTO 300
310 IF T(C)<>0 AND RND(20)<>1 THEN 340
320 IF LF<>0 AND RF<>0 THEN IF RND(2)=1 THEN T(C)=RFELSE T(C)=LF ELSE IF LF<>0 THEN T(C)=LF ELSE IF RF<>0 THEN T(C)=RF ELSE 900 ELSE 900
340 DX= SGN( X(T(C))-X(C)+RND(3)-2)*2:DY=SGN( Y(T(C))-Y(C)+RND(3)-1):IF DX[2+DY[2=0 THEN RETURNELSET$=C$(C):NP =X(C)+DX+( Y(C)+DY)*64:OP=X(C)+Y(C)*64:C$(C)=CHR$(PEEK(15360+NP)):PRINT@NP,CHR$(PEEK(OP+15360));:PRINT@OP,T$;:X(C)=X(C)+DX:Y(C)=Y(C)+DY
350 IF C$(C)=" "OR C$(C)="*"THEN RETURN ELSE FOR I=1TO NS
360 IF I<>C AND X(C)=X(I) AND Y(C)=Y(I) THEN C$(C)=" ":T(C)=0:H(I)=1:IF I=LF THEN 500 ELSE I=RF THEN 600 ELSERETURN 
370 NEXT I:RETURN
500 'LEFTOUT
600 'RIGHT OUT
900 'MONSTERS WIN
10000 GOTO 10000
