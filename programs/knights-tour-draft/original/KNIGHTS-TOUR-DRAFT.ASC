5 DEFINT A-Z
10 'KNIGHT'S TOUR
20 DIM  M(65,2)
30 M=1
40 FOR P=1TO8:READ X(P),Y(P):NEXT P
50    DATA -2,+1,  -2,-1,  -1,+2, +1,+2, +2,+1, +2,-1
60    DATA  -1,-2,  +1,-2
70 CLS
100 IF M=1 THEN   ELSE 200
110  M(1,2)=M(1,2)+1:T=M(1,2):IF T>1 THEN PRINT"NO SOULTION":STOP
120  X=2:Y=8
130       B(X,Y)=-1:M(1,0)=X:M(1,1)=Y:PRINT@X+X+X+Y*64-1,M;
135 M=M+1
140 GOTO 100
200 'ELSE
205 PRINT@960,M,T;
210   T=M(M,2):IF T>0 THEN X=M(M,0):Y=M(M,1) ELSE X=0:Y=0:T=0
215 T=T+1:M(M,2)=T
220   IF  T>8 THEN B(X,Y)=0:PRINT@X+X+X+Y*64,". ";:M(M,2)=0:M=M-1:GOTO 100
230  B(X,Y)=0:PRINT@X+X+X+Y*64,". ";:X=X(T)+M(M-1,0):Y=Y(T)+M(M-1,1)
240 IF 1<=X AND X<=8 AND 1<=Y AND Y<=8 AND NOT(B((X-1AND7)+1,(Y-1AND7)+1))THEN B(X,Y)=-1:M(M,0)=X:M(M,1)=Y:PRINT@X+X+X+Y*64-1,M;:M=M+1:M(M,2)=0:
       IF M>64 THEN 1000 ELSE 200
     ELSE X=0:Y=0:M(M,0)=X:M(M,1)=Y:M(M,2)=T:GOTO 200
1000 CLS:PRINT@64,"SOLUTION";:
1010 GOTO 1010
