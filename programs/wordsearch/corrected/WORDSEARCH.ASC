0 GOTO 1000
1 T=T*S:PRINTS"!  ="T:S=S+1:GOTO1
5 CLS:PRINT"LOSER"
10 DIM T$(15,15)
20 FOR R=1TO15
24 FOR C=1TO15
25 T$(R,C)="."
30 NEXT C,R
50 RR=1:CC=1
60 CLS
70 FORR=1TO15:FORC=1TO15:PRINT@((R-1)*64+C*4),T$(R,C);
80 NEXTC,R
90 A$=INKEY$:IFA$=""THEN100 ELSEIF ASC(A$)=13 THEN 500 ELSE IF A$=CHR$(31) THEN T$(RR,CC)=".":GOSUB900ELSE IFA$="1"THENRR=RR-1ELSEIFA$="2"THENRR=RR+1ELSEIFA$="3"THENCC=CC-1ELSEIFA$="4"THENCC=CC+1ELSET$(RR,CC)=A$:GOSUB900
95 IF RR<1 THEN RR=1ELSEIFRR>15THENRR=15ELSEIFCC<1THENCC=1ELSEIFCC>15THENCC=15
100 T$=T$(RR,CC):T$(RR,CC)=CHR$(143):GOSUB900:T$(RR,CC)=T$:GOSUB900:GOTO90
500 R=RR:C=CC:FORRR=1TO15:FORCC=1TO15
510 IF T$(RR,CC)="." THEN T$(RR,CC)=MID$(L$,RND(LEN(L$)),1):GOSUB900
520 NEXTCC,RR
530 CC=C:RR=C:GOTO90
900 PRINT@(RR-1)*64+CC*4,T$(RR,CC);:RETURN
1000 CLEAR 2000: CLS
1010 DIM T$(15,15),P(225,1),X(8),Y(8),D$(100)
1015 MAT=0:FORX=-1TO1:FORY=-1TO1:IFX<>0 ORY<>0 THEN MAT=MAT+1:X(MAT)=X:Y(MAT)=Y
1016 NEXTY,X
1020 FORR=0TO14:FORC=1TO15:T$(R+1,C)=".":P(R*15+C,0)=R+1:P(R*15+C,1)=C:NEXTC,R
1030 FOR P=1TO225:RN=RND(225):FORI=0TO1:XR=P(P,I):P(P,I)=P(RN,I):P(RN,I)=XR:NEXTI,P
1040 FOR P=1TO225:RR=P(P,0):CC=P(P,1):GOSUB900:NEXTP
1050 ' LET'S DO IT!!!!
1060  READ D$:IFD$="DONE" THEN 1300
1065 PRINT@960,LEFT$(D$+STRING$(40,32),40);
1070 MAT=-1:REC=-1:FORI=1TO8:RN=RND(8):XH=X(RN):X(RN)=X(I):X(I)=XH:XH=Y(RN):Y(RN)=Y(I):Y(I)=XH:NEXTI
1080 FOR P=1 TO 225:PRINT@1000,P;
1090 R=P(P,00):C=P(P,1)
1100 FOR I=1TO8:X=X(I):Y=Y(I):IF R+X*(LEN(D$)-1)<1 OR R+X*(LEN(D$)-1)>15 OR Y*(LEN(D$)-1)+C<1 OR Y*(LEN(D$)-1)+C>15 THEN 1170
1110 MAT=0:FOR L=0TO LEN(D$)-1
1120 DD$=MID$(D$,L+1,1):T$=T$( R+X*L,C+Y*L)
1130 IF T$<>"." AND T$<>DD$ THEN MAT=-1:GOTO 1170
1140 IF T$=DD$THEN MAT=MAT+1
1150 NEXT L
1160 IF MAT>REC THEN REC=MAT:P=P:XR=X:YR=Y:RS=R:CR=C
1170 NEXTI,P
1180 IF REC<>-1 THEN FOR LL=0TOLEN(D$)-1:RR=RS+XR*LL:CC=CR+YR*LL:T$(RR,CC)=MID$(D$,LL+1,1):GOSUB900:NEXTLL:DD=DD+1:D$(DD)=D$
1190 GOTO 1060
1300 FOR RR=1TO15:FORCC=1TO15:IF T$(RR,CC)="."THEN RN=RND(DD):T$(RR,CC)=MID$( D$(RN),RND(LEN(D$(RN))),1):GOSUB900
1303 NEXTCC,RR
1305 PRINT@960,"DONE.  PRESS (SPACE BAR) FOR LIST OF INCLUDED WORDS";
1310 A$=INKEY$:IFA$<>" "THEN1310
1320 CLS:FORD=1TODD:PRINTD$(D),:NEXTD
1330 PRINT:PRINT"PRESS (SPACE BAR) TO REPRINT THE PUZZLE"
1340 A$=INKEY$:IFA$<>" "THEN1340
1350 CLS:FOR RR=1TO15:FORCC=1TO15:GOSUB900:NEXTCC,RR:GOTO1305
2000 DATA UNITONE,HOWIE,WORKSHOP,ARTIST,WAFR,DISCUSSION,SKILLS,INTERESTS,TEACHER,STUDENT,LECTURE,PARTICIPATE,EDUCATION,PALMER,DELONG,BANKS,CERAMICS,MITCHELL,INTERN,PATTON,THEORY,ANDERSON,GOLDEN,OTTO,BAER,POETS,EPPLE,FILM,SULLIVAN,MUSIC
2010 DATA MYTH,SCIENCE,RELIGION,PHOTOS,SHORR,TUTORIAL,WOODYALLEN,DRAWING,VIDEO,VERNON,MANDEER,BAYE,EWART,HESS,LUCAS,BRUN,CLARK,EPPLE,HOCKMAN,HURST,KAUFMAN,BRIDGES,COOK,LALIANI,MCCASKILL,MANUEL,OHAGEN,PIERCE,ROSNER,SUSSMAN,CARL,KADIE,RICH
2020 DATA LOSEY,DONE
3000 DATA GENERAL,CHEMISTRY,PROBLEM,SOLVING,RUSSEL,DRAGO,SOLUTIONS,OBJECTIVES,FOLLOWING,YOU,THE,DEFINITIONS,SOLUTE,SOLVENT,SOLUTION,ISAAC,ASIMOV,RADIOSHACK,CARL,KADIE,RICHARD,LOSEY,TAPE,VIDEO
3010 DATA DISPLAY,MICRO,SYSTEM,PENCIL,PEN,ONE,TWO,THREE,FOUR,FIVE,SIX,SEVEN,EIGHT,NINE,TEN,ELEVEN,TWELVE,AYE,BEE,SEA,GEE,JAY,KAY,EL,EM,EN,OH,PEA,ARE,TEA,YOU,WHY,ZOO,DONE
