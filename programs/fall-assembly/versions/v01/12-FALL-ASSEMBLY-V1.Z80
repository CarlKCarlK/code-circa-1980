	ORG	7EFFH
PRCES	LD	A,(TST)
	LD	E,127
	LD	D,A
LUP	CALL	FALL
	DEC	E
	JP	P,LUP
	DEC	D
	LD	E,127
	JP	P,LUP
	RET		; ALL DONE -- BACK TO BASIC
FALL	PUSH	DE
	CALL	TEST ; SEE IF THERE'S A BLOCK
	JP	Z,RTN ; NO -- RETURN
	POP	DE ; 'TEST' DESTROYED DE REG.
	PUSH	DE ; RESAVE IT
	LD	A,0
	LD	(CHK),A
LUP2	LD	A,D ;SEE IF IT'S AT GROUND
	CP	46
	JP	Z,RTN ; YES -- RETURN
	CALL	FIRM ; RETURNS WITH 'C' HOLDING INFO.
	LD	A,C ; C=0 MEANS FIRM
	OR	C
	JP	Z,RTN ; BLOCK IS STABLE 
	LD	A,0FFH
	LD	(CHK),A
	PUSH	DE ; RESET PRESENT LOCATION
	CALL	RESET
	POP	DE
	INC	D
	AND	1
	JP	NZ,PEN ; FALL TO CENTER
	AND	2 ; CHECK FOR FALL LEFT
	JP	NZ,LEFT
	INC	E ; MUST THEN FALL TO RIGHT
	CP	128 ; MAKE SURE NOT OFF BOUNDARY
	JP	Z,RTN
	JP	PEN
LEFT	DEC	E
	JP	M,RTN ; IF NEG. OFF SCREEN
	JP	PEN ; "SET" AT NEW POINT
PEN	PUSH	DE
	CALL	SET
	POP	DE
	JP	LUP2
RTN	POP	DE
	RET
FIRM	PUSH	DE ; SAVE DE'S VALUE
	LD	C,0
	INC	D
	PUSH	DE ; SEE IF THERE'S A BRICK BELOW
	CALL	TEST
	POP	DE
	JP	Z,NXT1
	INC	C
NXT1	PUSH	DE ; CHECK LOWER BLOCK
	INC	E
	CALL	TEST
	POP	DE
	JP	Z,NXT2
	LD	A,2
	ADD	A,C
	LD	C,A
NXT2	DEC	E
	PUSH	DE
	CALL	TEST ; TRY LOWER LEFT
	POP	DE
	JP	Z,RTRN
	LD	A,4
	ADD	A,C
	LD	C,A
RTRN	LD	A,(CHK)
	SUB	C
	JP	Z,RTRN2
	JP	M,RTRN1
	CPL
	LD	C,A
	POP	DE
	RET
RTRN1	ADD	A,6
	JP	P,RTRN2
	LD	C,1
	POP	DE
	RET
RTRN2	LD	C,0
	POP	DE
	RET
SET	LD	A,0C6H ; SET B,(HL) INSTRUCTION
	JR	TEST10 ; GOTO STORE
RESET	LD	A,86H  ; RESET B,(HL) INSTR.
	JR	TEST10 ; GOTO STORE
TEST	LD	A,46H	; BIT B,(HL) INSTR.
TEST10	LD	(INST+1),A ; STORE 2ND BYTE
ADDRES	LD	A,D	; GET Y
	LD	B,0FFH	; -1
LOOP	INC	B	; SUCCESSIVE SUBS FOR DIV
	SUB	3	; BY THREE
	JP	P,LOOP
	ADD	A,3
	SLA	A
	LD	C,A
	LD	L,B
	LD	H,0
	LD	B,6
LOOP1	ADD	HL,HL
	DJNZ	LOOP1
	LD	D,0
	SRL	E
	JR	NC,CONT
	INC	C
CONT	ADD	HL,DE
	LD	DE,3C00H
	ADD	HL,DE
	SLA	C
	SLA	C
	SLA	C
	LD	A,(INST+1)
	ADD	A,C
	LD	(INST+1),A
INST	DEFB	0CBH
	DEFB	0
	SET	7,(HL)
	RET
CHK	DEFB	1
TST	DEFB	1
	END
