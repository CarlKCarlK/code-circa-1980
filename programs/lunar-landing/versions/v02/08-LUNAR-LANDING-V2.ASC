30 DIM I%(45):CLS:LINE(8,10)-(12,11),SET,BF:SET(7,12):SET(7,13):SET(13,12):SET(13,13):SET(8,12):SET(12,12):GET@(7,10)-(13,13),G,I%
70 DIM A(127)
80 DEF FNX(X,HS,A,T)=X+HS+COS(A)*T*.1:DEF FNY(Y,VS,A,T)=Y+VS+SIN(A)*T*.1+.05:DEF FNA(X,SS)=(X-SS)*2:DEF FNB(Y)=47-((47-Y)*2)
90 PI=3.14159:TL=-2.0:XZ=-7:YZ=-6
100 CLS:LINE(4,3)-(6,3),SET:SET(3,4):SET(7,4)
110 DIM M%(26):GET@(0,0)-(10,7),G,M%
120 GOSUB1000:'DRAW MOONSCAPE
130 X=1:OX=0:HV=-1:Y=0:OY=0:A=PI/2
200 C=PEEK(14400):IFC=16THENT=0ELSEIFC=>128 THEN T=T-.2:F=F-T:C=C-128:IFT<TLTHENT=TL
205 IFC=32THENA=A+.2ELSEIFC=64THENA=A-.2ELSEIFC=1THENA=PI/2
210 X=FNX(X,HS,A,T):Y=FNY(Y,VS,A,T):HS=X-OX:VS=Y-OY:A1=X+5:B1=Y+5:C1=A1-COS(A)*(T*2):D1=B1+SIN(A+PI)*(T):IFI=0THENPUT@(X,Y)-(X+10,Y+7),SET,M%:LINE(A1,B1)-(C1,D1),SET:OX=X:OY=YELSE3000
219 PRINT@0,T;"  ";
220 IF X<=120 AND X>=0 AND Y>=0 AND Y<=25THEN200 ELSEIFY>25ANDX>=0 AND X<=127THEN2000ELSE IFY<0 AND X>=0 ANDX<=127THEN Y=0:OY=VSELSEX1=X:X2=OX:Y1=Y:Y2=OY:GOSUB1000:IF X1>120 THEN OX=0:X=HV:Y=Y1:OY=Y2 ELSE IFX1<0THENX=120:X=HV+120:Y=Y1:OY=Y2
230 GOTO 200
999 GOTO 999
1000 CLS:FORO=1TO35:PRINT@RND(1020),".";:NEXTO:REM LUNER SURFACE
1010 R=0:SP=127/(RND(20)+10)
1020 X=0:OX=0:OY=43
1040 IF RND(6)=1AND X<120 THENX=X+7:Y=OY:LS=LS+1:GOTO 1080
1050 X=X+SP:IFX>127THENX=127:IFOX=127 THEN RETURN
1060 Y=OY+RND(10)-5:IFY>47 OR Y<27 THEN 1060
1070 IF Y>RTHENR=Y
1080 FOR XX=OXTOX:A(XX)=INT(OY+(Y-OY)/(X-OX)*(XX-OX)):LINE(XX,A(XX))-(XX,47),SET:NEXTXX:OX=X:OY=Y
1100 GOTO 1040
2000 IF I=1THEN4000:REM INLARGE LUNAR SURFACE
2005 CLS:FORO=1TO35:PRINT@RND(1020),".";:NEXTO
2010 IF X<40 THEN SS=0:EE=63ELSEIFX>85 THEN SS=64:EE=127ELSESS=64-32:EE=64+31
2020 FORXX=0TO63:LINE(XX*2,FNB(A(XX+SS)))-(XX*2+1,47),SET,B:NEXTXX
2030 I=1:GOTO220
3000 IFY<25ORX<0ORX>120THENI=0:GOTO5000ELSEIFX<SSORX>EETHEN2005ELSELINE(FNA(A2,SS)+XZ,FNB(B2)+YZ)-(FNA(C2,SS)+XZ,FNB(D2)+YZ),RESET:LINE(FNA(OX,SS),FNB(OY))-(FNA(OX,SS)+6,FNB(OY)+3),RESET,BF:PUT@(FNA(X,SS),FNB(Y))-(FNA(X,SS)+6,FNB(Y)+3),XOR,I%
3005 RESET(FNA(C1,SS),FNB(A(C1)))
3010 LINE(FNA(A1,SS)+XZ,FNB(B1)+YZ)-(FNA(C1,SS)+XZ,FNB(D1)+YZ),SET:OX=X:OY=Y:A2=A1:B2=B1:C2=C1:D2=D1:GOTO200
4000 GOTO 3000
5000 CLS:FORO=1TO35:PRINT@RND(1020),".";:NEXTO:FORXX=0TO126:LINE(XX,A(XX))-(XX,47),SET:NEXTXX:GOTO200
