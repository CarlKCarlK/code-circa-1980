5 CLS:PRINT:PRINT
10 PRINT"                           WHO DONNT ?"
20 PRINT:PRINT:PRINT:PRINT:INPUT"WOULD YOU LIKE INSTRUCTION";Q$:IFQ$="NO"THEN1000
1000 FORX=1TO6:READR$(X):NEXT:FORX=1TO6:READS$(X):NEXT:FORX=1TO6:READW$(X):NEXT
1010 DATA"KITCHEN","DEN","LIVING ROOM","PARLAR","BALLROOM","DINING ROOM","PROF. EINS","MISS ZWIN","DR. DWEI","MRS. VEIR","CAPT. FOUF","MR. SECHS"
1020 DATA"REVOLVER","POSION","DAGGER","CANTLESTICK","ROPE","BOW & ARROW"
1100 R=RND(6)
1110 FORX=1TO6
1120 Y=RND(7)
1130 IFY=7THENY=R
1140 SR(X)=Y
1150 NEXT
1180 MW=RND(6)
1190 FORX=1TO6
1200 IFX<>MWTHENY=RND(6):IFY=MWTHEN1200
1210 IFX=MWTHENY=MW
1220 WR(X)=Y
1230 NEXT
1270 FORX=1TO6
1280 AR(X)=SR(X)
1290 NEXT
1330 FORX=1TO6
1350 IFSR(X)=RTHEN1450
1360 SO(X)=X
1370 FORXX=1TO6
1380 IFSR(XX)=SR(X)THENSO(X)=SO(X)*10+XX
1390 NEXT
1400 GOTO1550
1450 AR(X)=RND(6):IFAR(X)=RTHEN1450
1460 SO(X)=X
1470 CC=RND(6)
1480 FORC=1TOCC
1490 XX=RND(6)
1500 IFSR(XX)=AR(X)THENSO(X)=SO(X)*10+XX
1510 NEXT
1550 NEXT
1580 FORX=1TO6
1585 SW(X)=0
1590 IFSR(X)=RTHEN1700
1600 FORXX=1TO6
1610 IFSR(X)=WR(XX)THENSW(X)=SW(X)*10+XX
1620 NEXT
1630 GOTO1770
1700 CC=RND(6)
1710 FORC=1TOCC
1720 XX=RND(6)
1730 IFAR(X)=WR(XX)THENSW(X)=SW(X)*10+XX
1740 NEXT
1770 NEXT
2000 INPUT"P.C. ANDERSON HERE SIR,DO YOU HAVE ANY QUESTIONS OR ORDERS";S$
2020 IFS$="WHO ARE THE SUSPECTS?"THENPRINT:PRINT"*** THE SUSPECTS ***":FORX=1TO6:PRINTS$(X):NEXT:GOTO2000
2030 IFS$="BRING ME THE JUDGE"THEN5000
2040 IFS$="WHAT ARE THE WEAPONS?"THENPRINT:PRINT"*** THE WEAPONS ***":FORX=1TO6:PRINTW$(X):NEXT
2050 IFLEFT$(S$,8)<>"BRING ME"THEN2060ELSE LET S$=RIGHT$(S$,LEN(S$)-9):FORX=1TO6:IFS$=S$(X)THEN3000ELSENEXT:PRINT"THAT PERSON ISN'T A SUSPECT":PRINT:GOTO2000
2060 IFS$="YES"THENINPUT"WHAT IS YOUR QUESTION OR ORDER";S$:GOTO2020
2070 IFS$="NO"THENPRINT:GOTO2000
2990 PRINT"I'M SORRY SIR, BUT I DON'T UNDERSTANT YOUR QUESTION.":PRINT:GOTO2000
3000 PRINT"I AM "S$(X);" WHAT ";:GOTO3020
3010 PRINT"WHAT ELSE ";
3020 INPUT"WOULD YOU LIKE TO KNOW";S$
3030 IFS$="WHAT ROOM WHERE YOU IN?"THENPRINT"I WAS IN THE ";R$(AR(X)):GOTO3220
3040 IFLEFT$(S$,3)<>"WAS"THEN3060ELSEFORXX=1TO6:IFMID$(S$,5,LEN(S$(XX)))<>S$(XX)THENNEXT:PRINT"NO SIR, I DON'T EVEN KNOW THAT PERSON.":GOTO3060
3050 FORYY=1TOLEN(STR$(SO(X))):IFS$(XX)<>S$(VAL(MID$(STR$(SO(X)),YY,1)))THENNEXT:PRINT"NO SIR, "S$(XX)" WASN'T WITH ME":GOTO3220ELSEPRINT"YES, SIR WE WERE TOGETHER.":GOTO3220
3060 IFLEFT$(S$,13)<>"DID YOU SEE A"THEN3200ELSEFORXW=1TO6:IFMID$(S$,15,LEN(W$(XW)))=W$(XW)THEN3080ELSENEXT:PRINT"I DON'T THINK THAT WAS EVEN IN THE HOUSE, SIR.":GOTO3200
3080 FORYY=1TOLEN(STR$(SW(X))):IFW$(XW)<>W$(VAL(MID$(STR$(SW(X)),YY,1)))THENNEXT:PRINT"NO SIR, I DIDN'T SEE A "W$(SW)" IN THE ROOM.":GOTO3220ELSEPRINT"YES, IT WAS IN THE SAME ROOM AS I.":GOTO3220
3200 IFS$="NOTHING MORE"THEN2000
3210 PRINT"I'M SORRY SIR, BUT I DON'T UNDERSTAND YOUR QUESTION."
3220 GOTO3010
