  200 "N"INPUT "ARE YOU SURE(Y/N)";T$
  210 IF T$="Y"LET A(27)=28
  220 END 
  300 "C"INPUT "SIZE(R,C)";N,M
  310 A=A(27):A(A)=M+N/10:A(27)=A+N*M+1
  320 I=1:J=1
  330 PRINT "CALLED ";A
  340 END 
  400 "V"FOR I=1 TO (A(A)-INT (A(A)))*10+.5
  410 PAUSE "ROW ";I
  420 FOR J=1 TO INT (A(A))
  430 INPUT A(A+(I-1)*INT (A(A))+J)
  440 NEXT J: NEXT I
  450 I=1:J=1: END 
  500 "D"FOR I=1 TO (A(A)-INT (A(A)))*10+.5
  510 FOR J=1 TO INT (A(A))
  520 PRINT A(A+(I-1)*INT A(A)+J);"(";I;J;")"
  530 NEXT J: NEXT I
  540 I=1:J=1: END 
  600 "="INPUT "A<--B";A,B
  610 T=INT (A(A))*(A(A)-INT (A(A))
  620 S=INT (A(B))*(A(B)-INT (A(B)))
  630 IF S>T LET T=S
  640 FOR I=1 TO T*10+.5
  650 A(A+I)=A(B+I)
  660 NEXT I:I=1:J=1: END 
  700 "S"AREAD A
  710 I=1:J=1: END 
  800 "H"I=I-1: GOTO 840
  810 "J"I=I+1: GOTO 840
  820 "K"J=J-1: GOTO 840
  830 "L"J=J+1
  840 " "T=A+(I-1)*INT (A(A))+J
  850 PRINT A;"(";I;J;")=";A(T)
  870 INPUT A(T)
  880 END 
  900 "M"INPUT "A<--B*C";A,B,C
  910 S=INT (A(B)):M=(A(B)-S)*10
  920 N=INT (A(C)):T=(A(C)-N)*10
  930 IF (S<>T)+(M<>(A(A)-INT A(A))*10)+(N<>INT A(A)) PRINT "SIZE ERR": END 
  940 FOR I=1 TO M: FOR J=1 TO N
  950 T=A+J+(I-1)*N
  960 A(T)=0: FOR K=1 TO S
  970 A(T)=A(T)+A(B+K+(I-1)*S)*A(C+J+(K-1)*N)
  980 NEXT K: NEXT J: NEXT I
  990 END 
