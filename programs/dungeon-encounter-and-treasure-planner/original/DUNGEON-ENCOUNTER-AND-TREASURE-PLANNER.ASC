2 CLEAR 300
3 DIM R(30)
5 DIM D$(2,60)
10 READ D$
20 IF D$="TREASURES"THEN 100
30 C=C+1:D$(1,C)=STR$(C):D$(2,C)=D$
40 GOTO 10
100 B=ASC("A")-1
110 READ D$:IFD$="DONE"THEN 200
120 C=C+1:B=B+1:IF B>ASC("A")+25 THEN H=-3:GOTO 100
130 D$(1,C)=CHR$(B):IFH=-3THEN D$(1,C)=D$(1,C)+CHR$(B)
140 D$(2,C)=D$
150 GOTO 110
200 FOR R=1TO56
210 IF RND(56)<=18 THEN G=G+1:R(G)=R
220 NEXT R
230 PRINTG:IF G<16 OR G>20 THEN G=0:GOTO 200
235 FOR X=1TO G
240 LPRINT"ROOM #";R(X)
250 LPRINT"MONSTER : ";D$(1,X);D$(2,X)
260 PRINT"SELETE THE TREASURE"
270 FOR J=26 TO 26+34:PRINTD$(1,J);D$(2,J),
275 NEXT
280 INPUT "CHOOSE";A$
290 FOR J=26 TO 26+34:IF A$=D$(1,J) THEN LPRINT"T=";D$(1,J);D$(2,J):D$(1,J)="":D$(2,J)="":GOTO 350ELSENEXT:PRINT"ERROR":GOTO280
350 NEXTX
360 END
1000 DATA ORCS,TROGLODYTES,KOBOLDS,GHOULS,GIANT CENTIPEDES,CARRION CRAWLER,ORCS,LAGE SPPIDERS,TROGLODYTES, GIANT TICK,STRIGES,GNOLLS,SHRIEKERS,SKELETONS,HOBGOBLINS
1010 DATAGOBLINS,GIANT RATS,ZOMBIES,KOBOLDS,BANDITS,OCHRE JELLY,GNOMES,ORCS,HUGE SPIDER,GOBLINS
1020 DATA TREASURES
1030 DATA POUCH 10 E,15 G,28 G, BOX 35GP,DAGGER 100 G,200S,80 GEMS,+1 MACE,FALSE MAP,+2 SPEAR,120G, MEDAL 500,100 G GEM,2450 C,STATUE 200 GP,820 SP,400 GEMS,620 GP IN CHEST
1040 DATA SCROLL OF CLERIC SPELLS,FALSE WAND,BAG OF DEVOURING,500 GP GEM,+1 SHEILD,BRONZE STATUETT 115 GP,MIRROR G 90
1045 DATA RING 10 G
1050 DATA +1 CHAINMAIL,GOLD RING 10 G,SCROLL 1 MAGIC USER SLEEP,BRACELTE 80 GP,840 C 290S 120E 25G IN LOCKER CHEST,RING OF PROTECTION +1
1060 DATA 120 GP RODS,15 G  GOBLET,aPOTION OF INVISIBILLY
1070 DATA "DONE"
