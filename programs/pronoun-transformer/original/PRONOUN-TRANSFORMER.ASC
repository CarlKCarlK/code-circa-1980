10 CLEAR 500:CLS
20 INPUT A$
25 A$=A$+".":B$="":C$="":C=0:OC=0:WN=0:WC=0:E$="***":D$="***":SC=0
30 
                    REM GET RID OF PUNUATIONI

40 B$=A$:A$="":FORI=1TOLEN(B$):C=ASC(MID$(B$,I,1)):IFC<64 THEN C$=" ":IF OC=1 THEN C$=""ELSEOC=1ELSEIF C>95 THEN OC=0:C$=CHR$(C-32)ELSEOC=0:C$=CHR$(C)
45 IF C$=" "THEN WN=WN+1
50 A$=A$+C$:NEXTI:C$="":OC=0
60                       REM GO THOUGH WORD BY WORD

70 WC=WC+1:GOSUB 990:IF B$="***"THEN 200
80 IFB$="MYSELF" OR B$="YOURSELF" ORB$="WAS"OR B$="WERE" OR B$="I"ORB$="ARE"OR(B$="AM"ORB$="ME")ORB$="YOU"THEN90ELSEC$=C$+B$+" ":GOTO70
90 IF B$="I"THEN C$=C$+"YOU ":GOTO70
100 IF B$="ARE"THENC$=C$+"AM ":OC=1:GOTO70
102 IF B$="MYSELF"THENC$=C$+"YOURSELF ":GOTO70
104 IF B$="YOURSELF"THENC$=C$+"MYSELF ":GOTO70
110 IF B$="AM"THEN C$=C$+"ARE ":OC=1:GOTO70
112 IF B$="WAS" THEN C$=C$+"WERE ":OC=1:GOTO70
114 IF B$="WERE"THEN C$=C$+"WAS ":OC=1:GOTO70
120 IF B$="ME"THENC$=C$+"YOU ":GOTO70
130 IF B$<>"YOU" THEN PRINT"ERROR":STOP
140 D$=LEFT$(D$,LEN(D$)-1):IF D$="WITH" ORD$="AFTER" OR D$="TO"OR D$="BY"OR D$="TO" OR D$="FOR" ORD$="FROM" THEN C$=C$+"ME ":GOTO70
150 IF OC=1 OR WC<WN/2THEN C$=C$+"I ":GOTO70
160 C$=C$+"mE ":SC=1:GOTO70
200 A$=C$+"   ":IF OC=0 OR SC=0 THEN 230
210 FOR I=1TOLEN(A$)-2:IF MID$(A$,I,3)="mE "THEN A$=LEFT$(A$,I-1)+"I "+RIGHT$(A$,LEN(A$)-I-2)+" "
220 NEXTI
230 IF RIGHT$(A$,1)=" "THENA$=LEFT$(A$,LEN(A$)-1):GOTO230ELSEA$=A$+"."
240 PRINTA$:PRINT:PRINT
250 GOTO 20
990 D$=E$:E$="":B$=""
1000 IF LEN(A$)=0 THEN B$="***":E$="***":RETURNELSEIFLEN(A$)=1THEN A$="" :RETURNELSE B$=B$+LEFT$(A$,1):E$=B$:A$=RIGHT$(A$,LEN(A$)-1):IF RIGHT$(B$,1)=" "THENB$=LEFT$(B$,LEN(B$)-1):RETURNELSE1000
