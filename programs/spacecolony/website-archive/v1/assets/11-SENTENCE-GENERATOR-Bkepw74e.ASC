10 CLS
15 CLEAR 1000:DIM PN$(40),CN$(40),AR$(40),AJ$(40),V$(40),CL$(40)
20 PN=0:CN=0:V=0:AJ=0:CL=0
30 READ T$:IF T$="$PNOUN" THEN 30 ELSE IF T$="$CNOUN" THEN 40
35 PN=PN+1:PN$(PN)=T$:GOTO 30
40 READ T$:IF T$="$CLAS" THEN 50 ELSE READ  TT$:CN=CN+1:CN$(CN)=TT$:AR=AR+1:AR$(AR)=T$:GOTO 40
50 READ T$:IFT$="$VERB" THEN 60 ELSE CL=CL+1:CL$(CL)=T$:GOTO 50
60 READ T$:IF T$="$ADJ" THEN 80
70 V=V+1:V$(V)=T$:GOTO 60
80 READ T$:IF T$="$END" THEN 100
90 AJ=AJ+1:AJ$(AJ)=T$:GOTO 80
95 IF RND(100)<10 THEN GOSUB 800:F=1:GOSUB 100
100 REM                       SENTENCE
120 GOSUB 200:'    OF SUBJECT
130 GOSUB 300:'    OF PREDICATE
140 IF F=0  THEN PRINT "." ELSE PRINT", ";
145 IF F=0 THEN FOR I=1TO1000:NEXTI
190 IF F=0 THEN 95 ELSE F=0:RETURN
200 REM            SUBJECT
210 GOSUB 400:'      OF NOUN PHRASE
290 RETURN
300 REM            PREDICATE
310 GOSUB 600:'        OF VERB PHRASE
320 GOSUB 700:'        OF OBJECT
390 RETURN
400 REM           NOUN PHRASE
405  CF=RND(2)-2: 'COMMON FLAG -1 IF COMMON 0 IF PROPER
407  IF CF THEN T=RND(CN):PRINT" ";AR$(T);
410 IF RND(100)<50 THEN GOSUB 500:GOTO 410:'   ADJECTIVE CONSTRUCTION
420   IF CF THEN PRINT" ";CN$(T); ELSEPRINT" ";PN$(RND(PN));
490 RETURN
500 REM             ADJECTIVE MODIFIERS
510 PRINT " ";AJ$(RND(AJ));
590 RETURN
600 REM                 VERB PHRASE
610 PRINT " ";V$(RND(V));
690 RETURN
700 REM              OBJECT
710 GOSUB 400
790 RETURN
800 REM               CLAUSE
810 PRINT " ";CL$(RND(CL));
890 RETURN
1000 DATA $PNOUN,BILL,CATHY,CARL,RICH,JIM,DOUG,DALE, $CNOUN,THE,FRISBEE,THE,PICNIC,THE,QUAD,A,INNOCENT,A,SANDWICH, $CLAS,BECAUSE,WHILE,AFTER,BEFORE, $VERB,HIT,ATE,THREW,SAT ON,TOOK,VISITED,SAW,THREW UP, $ADJ,BIG,SWEATY,ORANGE,RAT-INFESTED
1010 DATA SILLY,DELICIOUS,BLUE,TIRED,RED,BORING,AWFUL,EXCITING,HORRENDOUS,$END
