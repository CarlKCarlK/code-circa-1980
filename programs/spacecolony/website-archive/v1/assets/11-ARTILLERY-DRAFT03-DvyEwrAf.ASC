10 CLS
20 FOR X=0TO127:SET(X,47):NEXTX:'THE GROUND
40 FOR I=1 TO 10 :PRINT@RND(800),".";:NEXTI
45 GOTO 500
46 CLEAR 50
50 G(1)=20+RND(15):G(2)=127-(RND(15)+20):RESET( G(1),47):RESET(G(2),47)
60 A=.01:PI=3.14159
70 FOR T=1 TO 2
71 A$=INKEY$:IF A$<"0"THEN 80 ELSE IF A$<":"THEN VS=VAL(A$)/10ELSE IF A$<="Z"THEN AS=(ASC(A$)-ASC("A"))/26
80 V=RND(0)/10+(VS+.5):AN=(RND(0)/26+AS)*PI/2:VX=V*COS(AN):VY=V*SIN(AN):IFT=2THENVX=-VX
90 X=SGN(VX)
100 Y=VY*X/VX-.5*A*X*X/VX/VX
110 NX=G(T)+X:NY=46-Y:IF  NX>=0 AND NY>=0 AND NX<=127 AND NY<=46 THEN IF POINT(NX,NY)THEN 180ELSERESET(OX,OY):SET(NX,NY):OX=NX:OY=NY ELSE 200
120 X=X+SGN(VX):GOTO 100
180 RESET(NX,NY):RESET(OX,OY):FORCC=1TO9:X4=RND(3)-2+NX:Y4=RND(3)-2+NY:X5=RND(3)-2+NX:Y5=RND(3)-2+NY:IF (POINT(X4,Y4) AND POINT(X5,Y5)) OR (NOT POINT(X4,Y4) AND NOT POINT(X5,Y5)) THEN NEXT CC:GOTO 195
190 IF POINT(X4,Y4) THEN RESET(X4,Y4):SET(X5,Y5):X1=X5:Y1=Y5:GOSUB 980:NEXTCC ELSE RESET(X5,Y5):SET(X4,Y4):X1=X4:Y1=Y4:GOSUB 980:NEXT CC
195 GOSUB 750
200 '
210 NEXT T:GOTO 70
500 X=64:Y=46:DX=0:DY=0:A=0:P$="UP":L$="LONG"
510 IFINKEY$="Q"THEN 46 ELSEOA=A:A=PEEK(14352)+256*PEEK(14368)+1024*PEEK(14464):IFA=OA THEN 550
515 DX=0:DY=0:INC=1+PEEK(14464)*4
520 IF (A AND 2)<>0 THEN DY=-INC ELSE IF (A AND 4)<>0 THEN DY=INC
522 IF (A AND 128)<>0 THEN P$="UP" ELSE IF (A AND 256)<>0 THEN P$="DRAW"ELSE IF (A AND 512)<>0 THEN P$="ERASE"
524 IF (A AND 8)<>0 THEN DX=-INC ELSEIF (A AND 16)<>0 THEN DX=INC
528 IF (A AND 1)<>0 THEN L$="SHORT":P$="UP"
550 X=X+DX:Y=Y+DY:IF X<1 OR X>126 OR Y<2 OR Y>46 THEN X=X-DX:Y=Y-DY
560 IF POINT(X,Y) THEN RESET(X,Y):PI=3.14159:SET(X,Y)ELSE SET(X,Y):PI=3.14158:RESET(X,Y)
570 IF P$="UP" AND L$="LONG" THEN 650 ELSE IF P$="UP" AND L$="SHORT"THEN P$="DRAW"
580 IF P$="DRAW"THEN IF POINT(X-1,Y+1) OR POINT(X,Y+1) OR POINT(X+1,Y+1) THEN SET(X,Y)ELSE DX=0:DY=0
590 IF P$="ERASE"THEN IF POINT(X-1,Y-1) OR POINT(X,Y-1) OR POINT(X+1,Y-1) THEN DX=0:DY=0 ELSE RESET(X,Y)
600 IF L$="SHORT" THEN L$="LONG":P$="UP"
650 GOTO 510
750 XL=NX-3:XR=NX+3:Y1=NY+1:YT=NY-4:IF Y1>47 THEN Y1=47
760 X1=XL:NL=120:NR=0
770 IF POINT(X1,Y1) THEN 800 ELSE IF(X1<>XL AND X1<>XR) OR (ABS( NX-X1)<1.5) THEN 850 ELSE IF X1=XL THEN XL=XL+1:IF XL>127THENXL=127ELSE ELSE IF X1=XR THEN XR=XR-1:IFXR<0THENXR=0
780 GOTO 850
800 IF POINT(X1-1,Y1+1) OR POINT(X1,Y1+1) OR POINT(X1+1,Y1+1) THEN 850ELSE GOSUB 1000:IFX1-1<NL THEN NL=X1-1
810 IF X1+1>NR THEN NR=X1+1
850 IF X1<XR THEN X1=X1+1:GOTO770
860 IF Y1<YT AND NR<NL THEN RETURN ELSE IF Y1<YT THEN YT=YT-1:IFYT<0 THEN YT=0:GOTO900ELSE900 ELSE IF NR<NX+3 THEN NR=NX+3
870 IF NL>NX-3 THEN NL=NX-3
900 XR=NR:XL=NL:Y1 =Y1-1:GOTO 760
980 IF RND(2)=1 THEN RETURN :'ELSE SUB 1000
1000 OX=G(1):OY=47:X2=X1:Y2=Y1+1:X3=X1:Y3=Y1:IF Y2>47 THEN RETURN
1010 IF NOT(POINT(X2,Y2)) THEN RESET(X3,Y3):SET(X2,Y2):X3=X2:Y3=Y2:Y2=Y2+1:IFY2>47 THEN RETURN ELSE IF X3<2 OR X3>125 THEN RESET(X3,Y3):GOTO1010ELSE1010 
1020 IF (POINT(X2-1,Y2)OR POINT(X2-1,Y2-1)) AND (POINT(X2+1,Y2)OR POINT(X2+1,Y2-1)) THEN RETURN
1030 RESET(X3,Y3):IF( POINT(X2-1,Y2)OR POINT(X2-1,Y2-1)) THEN X2=X2+1 ELSE X2=X2-1
1040 GOTO 1010
2000 CLS:PRINT:PRINT"KEY MAPPING":S=14352
2010 SS=S:PRINT@(SS-S)*4,PEEK(SS)+256*PEEK(14368);:GOTO2010
