2 CLEAR300:CLS:FORI=1TO30:PRINT@RND(1020),".";:NEXTI:FORA=0TO3.15*10STEP.21:R=A/6:IFINKEY$<>""THEN1010ELSEX7=.5+64+COS(A)*R*2:Y7=.5+24+SIN(A)*R:SET(X7,Y7):SET(X7,Y7):NEXTA:FORI=1TO200:NEXTI:GOSUB1000
5 G=0:FORI=1TO50:B$=B$+CHR$(23)+CHR$(28):PRINTB$;:NEXTI:CLS:FORI=1TO50:PRINTB$;:X=RND(60)-1:Y=RND(8)-1:IFY/16>X/60 OR Y/16>(60-X)/60THEN NEXTIELSEPRINT@X+Y*64,".";:NEXTI
7 T=200:FOR Y1=0TO5:SET(110,Y1):SET(127,Y1):PRINTB$;:NEXTY1:FORX1=110TO127:SET(X1,6):PRINTB$;:NEXTX1:X1=126:Y1=0:FORY2=8TO15:PRINTB$;:X2=(Y2-7)*3.5:PRINT@29-X2+Y2*64,STRING$(X2*2,"-");:PRINTB$;:NEXTY2
10 JN=3:D$=CHR$(93)+CHR$(94):FORX2=28TO56STEP4:Y2=INT((X2-28)/4+.5):FORY3=7-Y2TO7+Y2:PRINT@X2+Y3*64,CHR$(170);:PRINT@56-X2+Y3*64,CHR$(149);:PRINTB$;:NEXTY3,X2:PRINT@56," ";:PRINT@64+56," ";
20 JN=JN+1:DIM X(JN),Y(JN),NX(JN),NY(JN),O$(JN):JN=JN-1:DIM DX(20),DY(20):FORI=1TO8:PRINTB$;:READ II,DX,DY:DX(II)=-DX:DY(II)=-DY:NEXTI:DX=0:DY=0
