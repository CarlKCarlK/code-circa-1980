1 CLS:PRINT:PRINT:PRINT:PRINTTAB(27);"SPACE COLONY"
2 PRINT:PRINT"              AN AREA AND RESOURCE MANAGEMENT GAME ":PRINT
3 PRINT:PRINT:PRINT
5 INPUT"DO YOU WANT INSTRUCTIONS";Z$
6 N5=8
10 IFLEFT$(Z$,1)="N"THEN46
15 CLS:PRINT:PRINT
20 PRINT:PRINT"CONGRATULATIONS! YOU'VE JUST BEEN APPOINTED ICOMANDER OF"
21 PRINT"                     ** COLONEY 5 **"
22 PRINT" A SMALL SOLAR POWER STATION WITH AN AREA OF 2100 SQ. KM.
24 PRINT"JOB IS TOO DECIED UPON THE PLANT'S BUDGET AND DISTRUBUTE"
26 PRINT"MONEY TO YOUR WORKERS FROM THE COLONEY TREASURY."
28 PRINT"THE MONEY SYSTEM IS PETRO-DOLLARS, AND EACH PERSON NEEDS 100"
30 PRINT"PETRO-DOLLARS PER YEAR TO SURVIVE.  YOUR COLONEY'S INCOME COMES"
32 PRINT"FROM SOLOR ENERGY AND SCIENTIST VISITING YOUR MAGNIFICENT"
34 PRINT"LABS AND EQUIMENT. HALF OF YOUR AREA IS SOLAR COLLECTERS":PRINT:PRINT"   		         <PRESS ANY BUTTON TO CONTINUE>"
35 IFINKEY$=""THEN35ELSECLS:PRINT:PRINT:PRINT:PRINT
36 PRINT"WHICH ALSO HAS AN EXCELLENT MILITARY USE AND MAY BE SOLD"
38 PRINT"TO THE NATIONS OF EARTH, WHO INPORT AND SUPPORT"
40 PRINT"THEIR OWN SOLDIERS.  ENERGY COLLECTORS COST BETWEEN
41 PRINT"TEN AND FIFTEEN PETRO-DOLLOR PER SQUARE 
42 PRINT"KILOMETER (KM.) TO RE-ENERGIZE THE COLLECTERS EVERY YEAR."
44 PRINT"YOUR GOAL IS TO COMPLETE YOUR"N5"YEAR TERM OF OFFICE."
46 PRINT:PRINT:PRINTTAB(22)"GOOD LUCK." 
50 A=INT(60000+(1000*RND(0))-(1000*RND(0)))
60 B=INT(500+(10*RND(0))-(10*RND(0)))
65 D=2000
100 W=INT(10*RND(0)+95)
102 PRINT:PRINT:PRINTTAB(12)"<PRESS ANY BUTTON TO CONTINUE>"
105 A$=INKEY$:IFA$=""THEN105ELSECLS:PRINT"YEAR"X5+1:PRINT:PRINT"YOU NOW HAVE"A"PETRO-DOLLARS IN THE TREASURY."
110 PRINTMID$(STR$(INT(B)),2,100);" WORKERS, ";
115 V9=INT(((RND(0)/2)*10+10))
120 IFC=0THEN140
130 PRINTINT(C)"SOLDIERS FROM EARTH, ";
140 PRINT"AND"INT(D)"SQ. KM. OF AREA."
150 PRINT"THIS YEAR MILITARY WILL BUY AREA FOR"W;
152 PRINT"PETROS PER SQ. KM."
155 PRINT"RE-ENERGIZING CURRENTLY COST"V9"PETRO-DOLLARS PER SQ. KM.""
162 PRINT
200 PRINT"HOW MANY SQ. KM. DO YOU WISH TO SELL TO THE MILITARY";
210 INPUTH
215 IF H<0THEN200
220 IFH<=D-1000THEN300
230 PRINT"THINK AGAIN, YOU'VE ONLY"D-1000"SQ. KM. OF COLLECTERS TO SELL."
240 IFX<>0THEN200
250 PRINT"(THE MILATARY WILL ONLY BUY THE AREA USED FOR SOLAR COLECTORS"
266 PRINT"BECAUSE IT HAS THE UNDER-FRAMEWORK NEEDED TO SUPPORT ROCKETS.)
280 X=1
299 GOTO200
300 D=INT(D-H)
310 A=INT(A+(H*W))
320 PRINT"HOW MANY PETROS  WILL YOU DISTRIBUTE TO YOUR WORKERS";
340 INPUTI
342 IFI<0THEN320
350 IFI<ATHEN400
360 IFI=ATHEN380
370 PRINT"     THINK AGAIN, YOU'VE ONLY"A"PETROS IN THE TREASURY"
375 GOTO320
380 J=0
390 K=0
395 A=0
399 GOTO1000
400 A=INT(A-I)
410 PRINT"HOW MANY SQ. KILOMETERS DO YOU WISH TO RE-ENERGIZE";
420 INPUTJ
421 IFJ<0THEN410
422 IFJ<=B*2THEN426
423 PRINT"SORRY, BUT EACH WORKER CAN ONLY RE-ENERGIZE 2 SQ. KILOMETERS"
424 GOTO410
426 IFJ<=D-1000THEN430
427 PRINT"    SORRY, BUT YOU'VE ONLY"D-1000"SQ. KILOMETERS OF COLLECTORS"
428 GOTO410
430 U1=INT(J*V9)
435 IFU1<ATHEN500
440 IFU1=ATHEN490
450 PRINT"    THINK AGAIN, YOU'VE ONLY"A"PETROS LEFT IN THE TREASURY"
460 GOTO410
490 K=0
495 A=0
499 GOTO1000
500 A=A-U1
510 PRINT"HOW MANY RALLODS DO YOU WISH TO CONTROL NUCLAR":PRINT"POLLUTION FORM MILATARY TESTING (RADITION DAMAGES COLLECTORS.)"
520 INPUTK
522 IFK<0THEN510
530 IFK<=A THEN1000
540 PRINT"   THINK AGAIN, YOU'VE ONLY"A"PETROS REMAINING"
550 GOTO510
600 IFH<>0THEN1002
602 IFI<>0THEN1002
604 IFJ<>0THEN1002
606 IFK<>0THEN1002
609 PRINT
612 PRINT"GOODBYE."
618 END
1000 CLS:GOTO600
1002 PRINT
1003 PRINT
1008 PRINTTAB(12)"<PRESS ANY BUTTON TO CONTINUE>"
1009 IFINKEY$=""THEN1009
1010 A=INT(A-K)
1020 A4=A
1100 IFINT(I/100-B)>=0THEN1120
1105 IFI/100<50THEN1700
1110 PRINTINT(B-(I/100))"WORKERS DIED OF STARVATION"
1120 F1=INT(RND(0)*(2000-D))
1122 IFK<25THEN1130
1125 F1=INT(F1/(K/25))
1130 IFF1<=0THEN1150
1140 PRINTF1"WORKERS DIED OF RADITION BURNS AND CANCER."
1150 IFINT((I/100)-B)<0THEN1170
1160 IFF1>0THEN1180
1165 GOTO1200
1170 PRINT"YOU WERE FORCED TO SPEND"INT((F1+(B-(I/100)))*9);
1172 PRINT"PETRO-DOLLARS ON FUNERAL EXPENSES"
1174 B5=INT(F1+(B-(I/100)))
1175 A=INT(A-((F1+(B-(I/100)))*9))
1176 GOTO1185
1180 PRINT"   YOU WERE FORCED TO PAY"INT(F1*9)"RALLODS ON ";
1181 PRINT"FUNERAL EXPENSES"
1182 B5=F1
1183 A=INT(A-(F1*9))
1185 IFA>=0THEN1194
1187 PRINT"    INSUFFICIENT RESERVES TO COVER COST - AREA WAS SOLD"
1189 D=INT(D+(A/W))
1190 A=0
1194 B=INT(B-B5)
1200 IFH=0THEN1250
1220 C1=INT(H+(RND(0)*10)-(RND(0)*20))
1224 IFC>0THEN1230
1226 C1=C1+20
1230 PRINTC1"SOLDIERS CAME TO THE COLONEY AND"
1250 P1=INT(((I/100-B)/10)+(K/25)-((2000-D)/50)-(F1/2))
1255 PRINTABS(P1)"WORKERS ";
1260 IFP1<0THEN1275
1265 PRINT"CAME TO";
1270 GOTO1280
1275 PRINT"LEFT";
1280 PRINT" THE PLANT."
1290 B=INT(B+P1)
1292 C=INT(C+C1)
1305 U2=INT(((2000-D)*((RND(0)+1.5)/2)))
1310 IFC=0THEN1324
1320 PRINT"OF"INT(J)"SQ. KM. ENERGIZED,";
1324 IFJ>U2THEN1330
1326 U2=J
1330 PRINT"YOU COLLECTED"INT(J-U2)"SQ. KM. OF ENERGY."
1340 IFU2=0THEN1370
1344 IFT1>=2THEN1370
1350 PRINT"  (DUE TO ";
1355 IFT1=0THEN1365
1360 PRINT"INCREASED ";
1365 PRINT"NUCLEAR POLLUTION FROM THE MILITARY.)"
1370 Q=INT((J-U2)*(W/2))
1380 PRINT" MAKING";INT(Q)"PETROS."
1390 A=INT(Q+A)
1400 V1=INT(((B-P1)*22)+(RND(0)*500))
1405 V2=INT((2000-D)*15)
