10 REM            AUTOMATIC INVESTMENT MANAGEMENT
20 REM            BOOK: ROBERT LICHELLO
30 REM            PROGRAM: CARL KADIE
40 REM            COPYRIGHT (C) 1977
50 '
60 REM            CLEAR MEMORY FOR WORDS
70         CLEAR 200   :'TRS-80
80 '
90 REM            SET UP CONTITIONS
100 '
110 REM            INTITAL INVESTMENT (II)   
120        II= ##### :'RETYPE THIS LINE WITH INTIAL INVESTMENT
130 REM            TOTAL SHARES (TS)
140 REM            INTEREST FROM BANK (APP. BY MONTHLY COMPOUNDING)
150        IR=.0###: 'RETYPE THIS LINE WITH INTEREST IN DECIMAL
160 REM            TOTAL INVESTMENT (TI)
170 REM            PRICE PER SHARE (PS)
180 REM            COST  PER SHARE (CS)
190 REM            TABLE OF RECORDS T(M,C) M=MONTH C=COLUMN
200        DIM T(60,8)
210 REM            TABLE HEADING  (TT$) & (TB$) TOP AND BOTTOM
220        TB$="DATE  VALUE  SAFE     CASH  CONTROL   ADVICE"+              "   ORDER    VALUE"
230                IF T(M,2)=-999 THEN 410  
240        TT$="      STOCK               PORTFOLIO BUY/-SELL"+            "  MARKET PORTFOLIO"
250 '
260 '
270 '
280 REM            MAIN PROGRAM
290 '
300        T(1,3)=T(M,4)*T(M,2)
310 REM            PUT DATA IN TABLE ARRAY
320        FOR M= 1 TO 60                       :'LOOP MONTHS
330               READ T(M,2)
340               IF T(M,2) <0 AND T(M,2)<>-999 THEN T(M,4)=                      -T(M,2):GOTO330  
350             IF T(M,2)=-999 THEN 410  
360              IFINT(M/12)=M/12 THEN T(M,1)=(M/12-1)+1.12:                    GOTO 380  
370               T(M,1)=INT(M/12)+(M/12-INT(M/12))*12/100+1
380        NEXT M
390 '
400 REM            SET UP FIRST MONTHS TABLE
410        T(1,3)=II/20
420        T(1,4)=II/2
430        T(1,5)= II/2
440        T(1,6)= 0
450        T(1,7)= 0
460        T(1,8)= II
470 '
480 REM            DO REST OF MONTHS
490        NM = M  -1           :' NUMBER OF MONTHS =OLD MONTH
500        FOR M= 2 TO NM
510             T(M,3)=INT(T(M,2)/10+.5)
520             T(M,4)=T(M-1,4)+ T(M-1,4)*IR/12
530             T(M,4)=T(M,4)-T(M-1,7)
540             T(M,6) = T(M-1,5)-T(M,2)
550             T(M,7) = 0
560             IF ABS(T(M,6)) >= 100 + T(M,3)  THEN T(M,7) =                   T(M,6)-T(M,3)*SGN(T(M,6))
570             T(M,5) = T(M-1,5)
580             IF T(M,7) > 0 THEN T(M,5)=T(M,5)+T(M,7)/2
590             T(M,8) = T(M,2)+T(M,4)
600        NEXT M
610        '
620 REM            PRINT RESULTS
630        PRINT TT$
640        PRINT TB$
650        FORM=1TO NM
660        PRINTT(M,1);TAB(5) T(M,2) TAB(13) T(M,3);
670       PRINT TAB(21) T(M,4) TAB(30) T(M,5) TAB(38) T(M,6);
680       PRINT TAB(48) INT(T(M,7)+.5) TAB(54) T(M,8)
690       IF INT(M/4)=M/4 THEN PRINT
700       IF INT(M/12)=M/12 AND M<>NM THEN PRINTTT$:PRINTTB$
710       NEXT M
720       PRINT
730       PRINT"PROFIT =";
740       PRINTT(NM,8)-II
750       GOTO 1040 :'END
760 '
770 '
780 REM            PRICES
790 REM            EACH MOUTH PLACE THE PRICE IN DATA
800 REM            LIKE THIS : "820 DATA 5400"
810 REM            BE SURE THAT THE DATES ARE IN ORDER
820 DATA #### :'RETYPE THIS AND FOLLOWING LINES WITH DATA
1000 '
1010 '
1020 REM            THIS TELLS COMPUTER THERE'S NO MORE DATA
1030       DATA -999
1040 END
