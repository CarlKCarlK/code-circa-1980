1 ' RELITIVITY                A QUICKY PROGAM BY CARL KADIE         WRITTEN ON A.D. MAY NINTH NINETEEN SEVENTY-NINE (5-9-79)
2 CLS
3 GOTO3000
5 INPUT"WHAT OPTION TO YOU WANT";O:ONOGOTO10,1000,2000
10 CLS
20 PRINT:PRINT:PRINT:INPUT"HOW LONG IS ROD";LO
30 INPUT"WHAT PER CENT OF THE SPEED OF LIGHT IS IT MOVING";V:V=V/100
40 CLS
50 T=64-LO/2
60 FORX=TTOT+LO:SET(X,32):NEXT
70 H=1-V[2
80 IFH<0THENPRINT"IMIGINARY":GOTO200
90 L1=SQR(H)*LO
100 IFL1=0THEN120
110 FORX=TTOT+L1:SET(X,29):NEXT
120 PRINT@8*64,"MOVING ROD";:PRINT@11*64,"YOUR ROD"
130 PRINT@64,V*100"% OF THE SPEED OF LIGHT"
200 IFINKEY$=""THEN200ELSE5
1000 CLS:FORS=0TO100
1010 L=SQR(1-(S/100)[2)*40
1020 FORY=1TOL
1030 SET(S+.5,41-Y+.5)
1040 NEXT
1050 IFS/10=INT(S/10)THENPRINT@958+S/2,S"%";:NEXTELSENEXT
1060 GOTO200
2000 CLS
2005 P$="###.#"
2010 INPUT"AT WHAT PERCENTAGE OF THE SPEED OF LIGHT ARE YOU TRAVELING";V
2015 CLS:PRINT"PERCENTAGE="V"%"
2020 FORX=42TO57:SET(X,11):SET(X,15):SET(X+30,11):SET(X+30,15):NEXT:FORY=11TO15:SET(42,Y):SET(57,Y):SET(72,Y):SET(87,Y):NEXT
2030 PRINT@403,"SHIP'S TIME";:PRINT@421,"EARTH'S TIME";
2100 T=T+.1
2110 T1=SQR(1-(V/100)[2)*T
2120 PRINT@278,"";:PRINTUSINGP$;T;:PRINT@294,"";:PRINTUSING P$;T1;
2130 GOTO2100
3000 '
3010 PRINT:PRINT:PRINT
3020 PRINT"                        RELIVTITY";
3030 PRINT
3040 PRINT"THIS PROGRAM HAS THREE OPTIONS"
3050 PRINT"
3060 PRINT"1) LENGTH DISTORTION"
3070 PRINT"2) LENGTH DISTORTION GRAPH"
3080 PRINT"3) TIME DIFFERENCE"
3090 PRINT
3100 PRINT"PRESS ENTER TO START"
3110 GOTO200
