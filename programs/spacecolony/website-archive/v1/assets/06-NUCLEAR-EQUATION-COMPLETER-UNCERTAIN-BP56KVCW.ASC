1 CLEAR1000:DIMP$(100):CLS:GOTO90
3 '
9 PRINT"PRESS ENTER"
10 IFINKEY$=""THEN10ELSECLS
90 S=1:M=1
95 PRINT"TYPE PROBLEM (H! FOR HELP)":INPUTP$
96 IFP$="H!"THENGOSUB2000:GOTO95
98 GOSUB4000
100 K=K+1:A$=P$(K)
105 IFA$="H!"THEN2000
120 IFA$<>"?"THEN130ELSEIFTN>105THENTN=106:GOTO300ELSE300
130 V=VAL(A$):IF(V>0ORA$="0")ANDET$=""THENM=V:GOTO100ELSEIFV>0ORA$="0"THENEM=V:GOTO100
140 IFNOT(A$="+"ORA$="=")THEN150ELSEGOSUB500:TM=TM+EM*S*M:TN=TN+EN*S*M:M=1:ET$="":IFA$="+"THEN100ELSES=-1:GOTO100GOTO100
150 ET$=A$:GOTO100
300 IFTM=0ANDTN=0THENE$="ENERGY"ELSEIFTM=0ANDTN>0THENE$=STR$(TN)+"E*":TN=1ELSEIFTM=0ANDTN<0 THENE$=STR$(TN)+"E":TN=-1ELSEIFTN=0THENE$=STR$(TM)+"N*":TM=1ELSERESTORE:FORX=0TOTN:READE$:NEXT
310 PRINTP$;"    "TN":"E$":"TM:RUN3
500 RESTORE:FORX=0TO105:READE$:IFE$=ET$THENEN=X:RETURN:ELSENEXT:GOSUB1000
1000 IFET$="E"THEN EN=-1: EM=0
1010 IFET$="E*"THENEN=1:  EM=0
1020 RETURN
2000 PRINT"THIS IS A PROGRAM THAT COMPLETES NUCLEAR EQUATIONS."
2010 PRINT"IF YOU WISH TO FIND THE OTHER RESULTANT OF 2 POSITRONS AND 1 HE ATOM"
2020 PRINT"ISOTOP #4 AND IF YOU KNOW THE FIRST RESULTANT IS LI (A.M. 7)"
2025 PRINT"                   THEN DO THE FOLLOWING"
2030 PRINT"2 E*0 + HE4= LI6 +"
2040 PRINT"REMEMBER NUMBER OF PARTICALS (UNLESS ONE) GOES FIRST"
2060 PRINT"THEN THE  SYMBLE , THEN THE ATOMIC MASS, THEN EITHER '+' OR '='
2070 PRINT"WHEN THE WHOLE PROBLEM IS TYPED IN PRESS ENTER"
2080 PRINT:PRINT"THE FOLLOWING ARE SPECIAL SYSMBLES :"
2090 PRINT"POSITRON E*, ELECTRON E, NEUTORN N* (PROTON IS H ISITOPE #1)":PRINT:RETURN
4000 K=0:FORQ=1TOLEN(P$)
4010 Y=ASC(MID$(P$,Q,1))
