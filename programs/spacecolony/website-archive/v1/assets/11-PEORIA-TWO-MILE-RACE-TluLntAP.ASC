2 CLEAR100
5 LM=2:LM$="TWO"           'LAP IN MILE AS NUMBER AND SPELLED:HC=10:PL=2
10 CLS:PRINTSTRING$(64,"*"),,,,"WELCOME TO THE PEORIA "LM$" MILE RACE":PRINT:INPUT"SKILL LEVEL";HC:INPUT"PLAYERS";PL:PRINT"I WILL GIVE YOU A COUNT DOWN":FORX=10TO1STEP-1:FORY=1TO500:NEXT:PRINTX:NEXT:CLS:PRINTCHR$(23):PRINT@400,"GO":FORY=1TO500:NEXT
30 WG=40:WT=WG:'WITH OF TRACK
35 PC=1
40 CLS:CK=29:L=24:CL=34:C$=CHR$(179)+CHR$(190)+CHR$(182)+CHR$(145):LZ=LM*150-SC
50 C2$=C$:C1$=C$
70 FORSC=1TOLM*150
75 WT=WG*(.5+(LZ-SC)/LZ*.5)
80 RANDOM:R=RND(PC*2)-PC:IFL+R>59-WT OR L+R<0 THEN80
100 L=L+R:PRINTSTRING$(L,191);:PRINTSTRING$(WT," ");:PRINTSTRING$(61-WT-L,191)
110 P1=PEEK(14344):P2=PEEK(14400):C=0:C2=0:IFP1=0ANDP2=0THEN115ELSEIF P1=4THENC2=1ELSEIFP1=1THENC2=-1
112 IF P2=32THENC=1ELSEIFP2=64THENC=-1
115 IFPL=2THENCK=CK+C2:PRINT@CK,C2$;
120 CL=CL+C:PRINT@CL,C1$;:IFRND(100)<HCTHENPRINT@RND(WT-3)+L+896,C$;
125 PRINT@960,"";:IFPL=2AND(POINT(2*CK,3)=-1ORPOINT(2*CK+6,3)ORPOINT(2*CK+3,3)=-1)THENM2=M2+1:TR=1
130 IFPOINT(2*CL,3)=-1ORPOINT(2*CL+6,3)=-1ORPOINT(2*CL+3,3)=-1THENM1=M1+1:TR=-1
135 IFTR<>0THENGOTO350ELSEPRINT@960,"";
140 IFINT(SC/15)=SC/15THENG=G+.1:PRINT@896,G;:PRINT@960,"";
145 IFPOINT(CL*2-1,2) AND POINT(CK*2+7,2)THENCL=CL+2:CK=CK-2
150 NEXTSC:PRINT"THE RACE OVER  ":FORY=1TO600:NEXT:CLS:PRINT"CONGRATULATIONS, YOUR SPEED WAS":PRINT@485,LM*150/(M1+1):IFPL=2THENPRINT@455,LM*150/(M2+1);:GOTO 400 ELSE 400
350 FORU=1TO500:NEXT:PRINT@960,"";:IFTR=-1THENPRINT@CL,"BANG";ELSEIFTR=1THENPRINT@CK,"BANG";
360 TR=0:GOTO135
400 A$="":PRINT:INPUT"AGAIN";A$:IFA$<>"NO"THENRUN
