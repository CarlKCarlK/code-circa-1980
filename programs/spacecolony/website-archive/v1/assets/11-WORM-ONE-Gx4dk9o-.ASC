10 CLS:DEFINT A-Z
20 PRINT"WORM ONE"
30 PRINT"SEE: SCIENTIFIC AMERICAN, NOVEMBER 1973"
40 PRINT:PRINT"PROGRAMED FOR THE TRS-80 BY "
50 PRINT"CARL KADIE  
60 PRINT"27 JULY 1980
65 P$= "1B 2D 3CCC 4B"
70 PRINT:PRINT"WHICH PATTERN (LIKE 1B 2D 3CCC 4B )"
80 INPUT P$
85 X=64:Y=24:GOTO 100
90 INPUT"(X,Y) OF STARTING LOCATION  ( 0-127,0-47)";X,Y
100 CLS:PRINTP$
110 FOR I=1TOLEN(P$):M$=MID$(P$,I,1)
120 IF M$="1"THEN R$(1)=MID$(P$,I+1,1)
125 IF M$="2"THEN R$(2)=MID$(P$,I+1,1)
130 IF M$="3"THEN FOR J=1TO4:R$(J+4)=MID$(P$,I+J,1):NEXTJ
140 IF M$="4"THEN R$(4)=MID$(P$,I+1,1)
150 NEXT I
160 SET(X,Y):SET(X+1,Y)
165 OX=X:OY=Y
170 GOSUB1000:'OPTIONS
180 ON OP+1 GOTO 190,200,210,300,400,500,600
190 PRINT@0,"D";
195 IF INKEY$=""THEN195 ELSE RUN
200 PO=1:GOSUB 700
700 X=X(PO):Y=Y(PO)
1000 'OPTIONS
1010 OP=0
1020 FOR XX=-1TO1 STEP 2:FOR YY=-1TO1:IF YY=0THEN XR=XX*2 ELSE XR=XX
1025 IF XX=1 THEN YR=-YY ELSE YR=YY
1030 IF NOT(POINT(XR+X+.5,YR+Y+.5)) THEN OP=OP+1:X(OP)=XR+X+.5:Y(OP)=YR+Y+.5
1040 NEXT YY,XX
1050 RETURN
