5 CLS
10 INPUT"MOD";M
15 INPUT "+ OR * ";F$
18 CLS:PRINT"CHART FOR MOD"M"AND THE OPERATION OF";:IFF$="+"THENPRINT" ADDITION.";ELSEPRINT" MULTIPLCATION.";
20 FORX=0TOM-1
30 FORY=0TOM-1
40 IF F$="+"THENA=X+YELSE A=X*Y
50 B=INT(((A/M)-INT(A/M))*M+.5)
60 PRINT@Y*4+X*64+64,B;
70 NEXTY
80 PRINT
90 NEXTX
100 IFINKEY$<>""THENENDELSE100
