80 REM 3-D PLOT CHANGE LINE#1000 TO FUNTION IN FORM OF FA=A SOMTING
90 CLS
100 PRINT
110 FOR X=-30TO30STEP1.5
120 L=0
130 Y1=5*INT(SQR(900-X*X)/5)
140 FORY=Y1TO-Y1STEP-5
145 A=SQR(X*X+Y*Y):GOSUB1000
150 Z=INT(25+FA-.7*Y)
160 IFZ<LTHEN190
170 L=Z
180 SET(XG*2,47-Z/1.3)
190 NEXTY
200 XG=XG+1
210 NEXTX
300 PRINT@490,"DONE";:GOTO300
1000 FA=30*SIN(A/10)-10
10010 RETURN
