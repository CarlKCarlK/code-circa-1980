10 ' LIBRARY DIRECTIORY
20 FORLV=0TO10
100 READ A$
105 IF A$="DONE"THEN500
110 IF A$="D"THEN L=L+1:GOTO 100:ELSEIFA$="U"THEN L=L-1:GOTO100
120 IF L=LVTHENPRINTA$
200 GOTO100
500 PRINT:L=0:RESTORE:NEXTLV
1000 DATA"FICTION",D,SOFTBOUND,D,A-CLEVELAND(1.8),COCTEAU-HAILEY(1.7),HAMILTON-KYLE(1.6),LAGERKVIST-RUBIN(1.5),RUSSIAN-WEST(1.4)
1010 DATA"U",HARDBOUND,D,ADAMS-MICHENER(1.3),MORGEN-YERBY(1.2)
1020 DATA"U","U",NON-FICTION,D,SCIENCE,D,PHYSICAL,D,PHYSICS(4.1.R),CHEMISTRY(4.1.L),U,NATURAL(4.2),GENERAL(4.1.L),MATHMATICS(4.3.R)
1033 DATACOMPUTER(4.4)(4.5),SOCIAL,D,HISTORY(3.2.L),ECONOMICS(3.2.R),POLICAL(4.8)(4.7)(4.6)
1040 DATAU,U,BIOGRAPHY(2.9.L),ARTS,D,THEATRE,D,SINGLE PLAYS(2.4.L)(2.5.R),EUGENE O'NEILL(2.4.R),COLLECTIONS(2.3.L)(2.5.R),SPEECH(2.3.R),U,CRAFTS(2.1),POETRY(2.5),U,GENERAL,D,REFERENCE(2.7)(2.1.R),RECREATION,D,GOLF(1.1.R)(2.5.R),GAMES(2.7.L),FISHING(1.1)
1050 DATAU,FORIEGN LANGUAGE(2.9.L),HEALTH(2.8),OCCULT(2.6.R),ANCEINT CIVILATIONS(2.3.R)(2.5.L),HOME REPAIR(1.1.L),NATIONAL GEOGRAPHIC BOOKS(2.1.L)(2.2.L),COMPLETE WORKS OF A. LINCOLN(2.2),OVERSIZE BOOKS(2.1)(3.1),PHOTOS(4.1)
1060 DATA"ANTIQUE BOOKS(1.9)",U,U,U,U
1100 DATA"DONE"
