90 CLEAR1500:POKE16553,255
100 CLS:PRINT:PRINT:INPUT"HOW IS IT SPELLED";S$:L=LEN(S$)
110 READM$:IFM$="DONE"THEN500ELSEN=N+1:FORX%=1TOL:IFLEFT$(S$,X%)<>LEFT$(M$,X%)THENGOTO110ELSEIFX%>RTHENR=X%:R$=M$
