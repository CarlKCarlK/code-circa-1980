1 CLS
5 DIM D(52)
10 C$(1)=CHR$(140)+CHR$(191)+CHR$(157)+CHR$(132):C$(5)=" "+CHR$(138)+"  "
20 C$(2)=CHR$(160)+CHR$(190)+CHR$(180):C$(6)=" "+CHR$(139)+CHR$(129)
30 C$(3)=CHR$(191)+CHR$(190)+CHR$(149):C$(7)=CHR$(130)+CHR$(135)+" "
40 C$(4)=C$(2):C$(8)=CHR$(130)+CHR$(138)+CHR$(130)
1000 S=INT(D/13)+1:V=D-(S-1)*13+1:IFV=1THENP$="ACE"ELSEIFV<11THENP$=STR$(V)ELSEIFV=11THENP$="JACK"ELSEIFV=12THENP$="QUEEN"ELSEIFV=13THENP$="KING"
1005 PRINT@400,D;
1010 PRINT@L,CHR$(156);STRING$(1+LEN(C$(S))+LEN(P$),CHR$(140));CHR$(172);:PRINT@L+64,CHR$(149);P$;" "C$(S);CHR$(170);:PRINT@L+128,CHR$(149);P$;" "C$(S+4);CHR$(170);:PRINT@L+192,STRING$(3+LEN(C$(S))+LEN(P$),CHR$(131));
2000 RETURN
10000 FORX=121TO191:PRINTX;CHR$(X),,,:NEXT
