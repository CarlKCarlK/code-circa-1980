{
  "name": "code-circa-1980",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite --config config/vite.config.js --host 127.0.0.1",
    "build": "npm run typecheck && vite build --config config/vite.config.js",
    "preview": "vite --config config/vite.config.js preview --host 127.0.0.1",
    "test": "node --test app/tests/archive.test.mjs app/tests/castles-parity.test.mjs app/tests/castles-timing.test.mjs app/tests/castles-pointer.test.mjs app/tests/castles-bricks.test.mjs app/tests/castles-patterns.test.mjs app/tests/web-versions.test.mjs",
    "release:web": "node app/scripts/release-web.mjs",
    "verify:web-versions": "node app/scripts/web-versions.mjs",
    "test:browser": "playwright test --config config/playwright.config.js",
    "build:fall": "node app/scripts/build-fall.mjs",
    "typecheck": "tsc --noEmit --project config/tsconfig.json",
    "calibrate:castles": "node app/scripts/calibrate-castles.mjs",
    "test:dev-route": "node app/scripts/check-dev-route.mjs"
  },
  "dependencies": {
    "trs80-base": "2.3.1",
    "trs80-emulator": "2.3.1",
    "trs80-emulator-web": "2.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "z80-asm": "2.3.0"
  }
}
